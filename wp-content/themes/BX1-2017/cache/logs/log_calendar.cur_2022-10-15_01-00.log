s":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T01:35:11+02:00","published_at":"2022-07-12T16:42:07+02:00","backoffice_id":258310,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.22111561970705},{"id":540503,"date_start":"2022-09-14","date_end":"2022-12-15","date_next":"2022-10-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"EXPO 2 BIS x Brussels Design September","shortdescr":"Dans le cadre de Brussels Design September, les Ateliers J&J vous pr\u00e9sentent l\u2019EXPO 2 BIS, dans la continuit\u00e9 de l\u2019expo avec Karla Sutra, Daphn\u00e9 Keraudren, Tommy Lhomme et Marine Juli\u00e9.","longdescr":"Toujours avec une vision de collaboration et de partage, Ateliers J&J a \u00e0 coeur de mettre en avant le travail de ces diff\u00e9rents artistes, en soutenant leur recherches et le d\u00e9veloppement de leurs oeuvres.\r\nPour l\u2019extension de l\u2019exposition au 110, Ateliers J&J vous propose de nouvelles collaborations riches en couleurs et volumes avec Atelier Thomas Serruys, Eleonore Joulin, Fanny Lopez, Quentin Caillaud, Diego Faivre et Studio Biskt.","performers":"Studio Biskt, Diego Faivre, Fanny Lopez, El\u00e9onore Joulin, Quentin Caillaud, Atelier Thomas Serruys, Karla Sutra, Marine Juli\u00e9, Tommy Lhomme, Daphn\u00e9 Keraudren","boxoffice_url":null,"website":"http:\/\/www.ateliersjetj.com","email":"contact@ateliersjetj.com","phone_contact":"+32 485 18 19 63","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540503"},"nl":{"name":"EXPO 2 BIS x Brussels Design September","shortdescr":"In het kader van Brussels Design September presenteren Ateliers J&J de EXPO 2 BIS, in het verlengde van de tentoonstelling met Karla Sutra, Daphn\u00e9 Keraudren, Tommy Lhomme en Marine Juli\u00e9.","longdescr":"Altijd met een visie van samenwerking en delen, heeft Ateliers J&J als doel het werk van deze verschillende kunstenaars naar voren te brengen, door hun onderzoek en de ontwikkeling van hun werken te ondersteunen.\r\nVoor de uitbreiding van de tentoonstelling op 110 stelt Ateliers J&J nieuwe samenwerkingen voor die rijk zijn aan kleuren en volumes met Atelier Thomas Serruys, Eleonore Joulin, Fanny Lopez, Quentin Caillaud, Diego Faivre en Studio Biskt.","performers":"Studio Biskt, Diego Faivre, Fanny Lopez, El\u00e9onore Joulin, Quentin Caillaud, Atelier Thomas Serruys, Karla Sutra, Marine Juli\u00e9, Tommy Lhomme, Daphn\u00e9 Keraudren","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540503"},"en":{"name":"EXPO 2 BIS x Brussels Design September","shortdescr":"As part of Brussels Design September, Ateliers J&J present the EXPO 2 BIS, in the continuity of the exhibition with Karla Sutra, Daphn\u00e9 Keraudren, Tommy Lhomme and Marine Juli\u00e9.","longdescr":"Always with a vision of collaboration and sharing, Ateliers J&J has at heart to highlight the work of these different artists, supporting their research and development of their works.\r\nFor the extension of the exhibition at 110, Ateliers J&J offers you new collaborations rich in colors and volumes with Atelier Thomas Serruys, Eleonore Joulin, Fanny Lopez, Quentin Caillaud, Diego Faivre and Studio Biskt.",