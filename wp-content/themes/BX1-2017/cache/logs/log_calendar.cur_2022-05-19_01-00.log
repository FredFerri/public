17:00 to 20:30"}},{"day":"thursday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"17:00:00","time_end":"20:30:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier jeudis du mois de 17:00 \u00e0 20:30","nl":"Open op de eerste, tweede, derde, vierde en laatste donderdags van de maand van 17:00 tot 20:30","en":"Open the first, second, third, fourth and last thursdays of the month from 17:00 to 20:30"}}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[15],"translations":{"fr":["Sourd\/malentendant"],"nl":["Doof\/slechthorend"],"en":["Deaf\/hard of hearing"]}},"tags":[],"accessibilities":{"list":[257],"translations":{"fr":["Am\u00e9nagements pour personnes sourdes et malentendantes"],"nl":["Voorzieningen voor dove en slechthorende personen"],"en":["Facilities for deaf and hearing-impaired people"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T01:06:36+02:00","published_at":"2020-10-13T12:49:04+02:00","backoffice_id":225632,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.13527147064909},{"id":532152,"date_start":"2022-05-19","date_end":"2022-07-16","date_next":"2022-05-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,28],"translations":{"fr":["Galeries d'art","Arts graphiques"],"nl":["Galeries","Grafische kunst, vormgeving"],"en":["Art Galleries","Graphic art"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":"Pour cette exposition \u00ab C\u2019est pas mon genre \u00bb, la galerie Ali\u00e9nor Prouvost pr\u00e9sente les \u0153uvres de Ramuntcho Matta, un artiste pluridisciplinaire de grand talent. \u00c0 travers plus d\u2019une centaine d\u2019\u0153uvres sur papier, il nous entraine dans son quotidien par sa pratique du dessin","longdescr":"Ramuntcho Matta est n\u00e9 \u00e0 Paris en 1960, il vit et travaille \u00e0 Paris et \u00e0 Epaux-B\u00e9zu.\r\n\u00c0 la fin des ann\u00e9es 70, Ramuntcho Matta d\u00e9bute sa carri\u00e8re artistique dans la musique, il utilise\r\nd\u00e9j\u00e0 les arts plastiques par-del\u00e0 son travail de compositeur afin de donner forme \u00e0 des\r\nquestionnements, des sujets de cr\u00e9ation plus singuliers et complexes utilisant parfois le son, le\r\ndessin, la vid\u00e9o, l'espace, les mots ou des combinatoires.\r\nChris Marker en tentant de d\u00e9finir son travail trouva l\u2019adjectif : \"multimedium\".\r\nPrivil\u00e9giant souvent le collaboratif, il a travaill\u00e9 avec de nombreux artistes comme Don Cherry,\r\nBrion Gysin, John Cage ou Chris Marker.\r\nIl a r\u00e9alis\u00e9 une vingtaine de disques en solo, et autant en collectif.\r\nIl a jou\u00e9 et expos\u00e9 \u00e0 Paris, New-York, Londres, Madrid, Barcelone, Tokyo, Rome... Il a \u00e9galement\r\nparticip\u00e9 \u00e0 de nombreuses expositions collectives comme \u00e0 l\u2019espace Louis Vuitton de Paris, \u00e0 la\r\nArt Library de Milan, au Mus\u00e9e des Beaux-Arts de Valenciennes, au mus\u00e9e des Beaux- Arts de San\r\nDiego, au Palais de Tokyo \u00e0 Paris, \u00e0 La Piscine de Roubaix.","performers":null,"boxoffice_url":null,"website":"https:\/\/alienorprouvost.com\/","email":"ap@alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532152.html"},"nl":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"ap@alieno