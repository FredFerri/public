t":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":"SAM 29\/10\r\nReconnaissable par sa voix claire, Carlou D est un artiste qui combine la musique mystique et spirituelle Zikr des Baye Fall, une communaut\u00e9 soufie du S\u00e9n\u00e9gal, avec les grooves du funk, des \u00e9l\u00e9ments du mbalax s\u00e9n\u00e9galais et de l\u2019afro-pop pour cr\u00e9er un style authentique.","longdescr":"Carlou D, de son vrai nom Ibrahima Loucard, est n\u00e9 dans la banlieue de Dakar, la capitale du S\u00e9n\u00e9gal. Il a commenc\u00e9 sa carri\u00e8re musicale en tant que membre du Positive Black Soul : l\u2019un des groupes de hip-hop les plus c\u00e9l\u00e8bres du pays, et il a \u00e9t\u00e9 soutenu par le l\u00e9gendaire Youssou N\u2019Dour avant de collaborer avec lui. Aujourd\u2019hui il a peut-\u00eatre laiss\u00e9 le hip-hop un peu derri\u00e8re lui, mais il n\u2019en a pas perdu l\u2019esprit : \u00ab La part de hip-hop que j\u2019ai gard\u00e9e dans ma musique, c\u2019est le courage d\u2019\u00eatre direct \u00bb, confie le guitariste, chanteur et danseur d\u2019exception. Profond\u00e9ment enracin\u00e9 dans les rythmes africains, le chanteur et interpr\u00e8te s\u00e9n\u00e9galais \u00e0 succ\u00e8s porte des paroles engag\u00e9es avec une dimension et une extase mystique. Carlou D est ind\u00e9niablement l\u2019un des grands noms du S\u00e9n\u00e9gal contemporain.","performers":"Carlou D: voix, guitare\r\nMouhamadou Doumbouya: percussions\r\nIbrahima Ndir: calebasse\r\nDjiby Diabate: balafon\r\nFabrice Devienne: clavier\r\nVieux Kante Magassa : percussions","boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20221029-carlou-d-senegal\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542078"},"nl":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542078"},"en":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542078"},"de":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542078"},"it":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542078"},"sp":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542078"},"pt":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Z