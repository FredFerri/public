0:00"},{"day":"2022-07-01","doors":null,"start":"13:00:00","end":"17:00:00"},{"day":"2022-07-02","doors":null,"start":"13:00:00","end":"17:00:00"},{"day":"2022-07-03","doors":null,"start":"13:00:00","end":"17:00:00"},{"day":"2022-07-06","doors":null,"start":"13:00:00","end":"17:00:00"},{"day":"2022-07-07","doors":null,"start":"13:00:00","end":"17:00:00"},{"day":"2022-07-08","doors":null,"start":"13:00:00","end":"17:00:00"},{"day":"2022-07-09","doors":null,"start":"13:00:00","end":"17:00:00"},{"day":"2022-07-10","doors":null,"start":"13:00:00","end":"17:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":true,"hours":[{"start":"13:00:00","end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"13:00:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"13:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"13:00:00","end":"17:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"13:00:00","end":"17:00:00"}]}},"translations":{"fr":["lundi et mardi: ferm\u00e9","mercredi, jeudi, vendredi, samedi et dimanche: de 13:00 \u00e0 17:00"],"nl":["maandag en dinsdag: gesloten","woensdag, donderdag, vrijdag, zaterdag en zondag: van 13:00 tot 17:00"],"en":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 13:00 to 17:00"]},"date_start":"2022-06-18","date_end":"2022-07-10","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[532743],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[320],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classic"]}},"visit_content":{"list":[428],"values":["brussels-renaissance-festival"]},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-12T10:05:07+02:00","published_at":"2022-04-28T14:35:52+02:00","backoffice_id":252744,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.44303093598303},{"id":533918,"date_start":"2022-06-18","date_end":"2022-06-18","date_next":"2022-06-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Musica Baltica","shortdescr":"Musica Baltica\r\noeuvres de Rihards Dubra, \u0112riks E\u0161envalds, Arvo P\u00e4rt et P\u0113teris Vasks","longdescr":"Les compositeurs des \u00c9tats baltes ont fortement influenc\u00e9 la musique classique contemporaine au cours des trois derni\u00e8res d\u00e9cennies en cr\u00e9ant des \u0153uvres accessibles et m\u00e9lodieuses qui ont suscit\u00e9 des r\u00e9actions spirituelles et \u00e9motionnelles de la part des publics du monde entier. Cela est particuli\u00e8rement vrai dans le domaine de la musique chorale sacr\u00e9e, absolument interdite dans ces r\u00e9gions pendant la p\u00e9riode sovi\u00e9tique.\r\nNotre programme comprend des \u0153uvres de trois des compositeurs baltes les plus jou\u00e9s. L\u2019Estonien Arvo P\u00e4rt est devenu le compositeur classique le plus interpr\u00e9t\u00e9 de ce si\u00e8cle. Ses \u0153uvres chorales et instrumentales aust\u00e8res, mais tout \u00e0 fait accessibles, qui t\u00e9moignent souvent de sa foi orthodoxe, sont maintenant entr\u00e9es au r\u00e9pertoire. \u0112riks E\u0161envalds, compositeur letton, a fait forte impression aupr\u00e8s des soci\u00e9t\u00e9s chorales\u2009; ses \u0153uvres sont connues des publics du monde entier. P\u0113teris Vasks, \u00e9galement originaire de Lettonie, a acquis une r\u00e9putation mondiale avec ses \u0153uvres chorales, instrumentales et orchestrales. Notre quatri\u00e8me compositeur, le Letton Rihards Dubra, moins connu, mais tout aussi talentueux, compose exclusivement de la musique chorale sacr\u00e9e qui, de par sa s\u00e9r\u00e9nit\u00e9 et son ampleur, est particuli\u00e8rement adapt\u00e9e aux \u00e9glises de grandes dimensions.","performers":"Brussels Choral Society\r\nEnsemble Orchestral de Bruxelles\r\nDirection \u2013 Eric Delson","boxoffice_url":null,"website":"http:\/\/www.brusselschoralsociety.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533918.html"},"nl":{"name":"Musica Baltica","shortdescr":"Musica Baltica\r\nwerken van Rihards Dubra, \u0112riks E\u0161envalds, Arvo P\u00e4rt en P\u0113teris Vasks","longdescr":"Componisten uit de Baltische Staten hebben een grote invloed uitgeoefend op de hedendaagse klassieke muziek in de laatste drie decennia, met hun toegankelijke en melodieuze werken die een sterke spirituele en emotionele reactie hebben teweeggebracht bij luisteraars over de hele wereld. Dit geldt in bijzondere mate voor hun religieuze koorrepertoire, dat in hun eigen landen effectief van uitvoering uitgesloten, was toen daar het Sovjetbewind nog heerste.\r\n\r\nOns programma brengt werken van drie van de meest regelmatig uitgevoerde Baltische componisten. De Est Arvo P\u00e4rt is uitgegroeid tot de meest gespeelde klassieke componist van deze eeuw. Zijn sobere maar volledig toegankelijke koor- en instrumentale werken, die vaak ge\u00efnspireerd zijn door zijn orthodoxe geloofsovertuiging, zijn gaan behoren tot het standaardrepertoire. \u0112riks E\u0161envalds uit Letland heeft veel indruk gemaakt op koormusici; zijn werken vinden inmiddels een publiek over de hele wereld. P\u0113teris Vasks, ook uit Letland, heeft een wereldwijde reputatie opgebouwd met zijn composities, zowel voor koor als voor instrumentaal ensemble of orkest. Onze vierde componist, de eveneens Letse Rihards Dubra, is minder bekend maar zeker zo getalenteerd. Hij schrijft uitsluitend gewijde koormuziek in een sereen en klankrijk idioom dat zich uitstekend leent voor uitvoering in grote kerkgebouwen.","performers":"Brussels Choral Society\r\nEnsemble Orchestral de Bruxelles\r\nDirigent \u2013 Eric Delson","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533918.html"},"en":{"name":"Musica Baltica","shortdescr":"Musica Baltica\r\nworks by Rihards Dubra, \u0112riks E\u0161envalds, Arvo P\u00e4rt and P\u0113teris Vasks","longdescr":"Composers from the Baltic States have strongly influenced contemporary classical music over the past three decades by creating accessible, tuneful works that have stimulated spiritual and emotional responses from audiences around the world. This is particularly true in the field of sacred choral music that was effectively banned from the region during the Soviet period.\r\n\r\nOur programme features works by three of the most frequently performed Baltic composers.  Estonian Arvo P\u00e4rt has become this century\u2019s most performed classical composer. His austere but entirely approachable choral and instrumental works, often reflecting his Orthodox religion, have become standard repertoire. \u0112riks E\u0161envalds from Latvia has made a strong impression with choral groups; his works have reached a global audience. P\u0113teris Vasks, also from Latvia, has achieved a worldwide reputation with his choral, instrumental and orchestral scores. Our fourth composer, Rihards Dubra, a less well-known but similarly gifted Latvian, composes exclusively sacred choral music that has a serene and resonant quality suited to large churches.","performers":"Brussels Choral Society\r\nEnsemble Orchestral de Bruxelles\r\nConductor \u2013 Eric Delson","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533918.html"},"de":{"name":"Musica Baltica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533918.html"},"it":{"name":"Musica Baltica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533918.html"},"sp":{"name":"Musica Baltica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533918.html"},"pt":{"name":"Musica Baltica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533918.html"},"cn":{"name":"Musica Baltica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533918.html"}},"place":{"id":220880,"translations":{"fr":{"name":"Eglise Notre-Dame des Gr\u00e2ces","address_street_name":"Avenue du Chant d'Oiseau","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 770 42 15","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Avenue du Chant d'Oiseau","address_line2":"1150 Woluwe-Saint-Pierre","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"O.L.V. van Genadekerk","address_street_name":"Vogelzanglaan","address_street_number":null,"address