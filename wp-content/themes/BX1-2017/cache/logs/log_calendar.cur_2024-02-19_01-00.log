idays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-18T01:02:44+01:00","published_at":"2024-01-08T12:43:20+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292103,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.38157141418444396,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Dakota - 'Aparte'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.superdakota.com\/","email":"contact@superdakota.comm","phone_contact":"+32 2 649 17 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005869"},"pt":{"name":"Dakota - 'Aparte'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.superdakota.com\/","email":"contact@superdakota.comm","phone_contact":"+32 2 649 17 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005869"},"en":{"name":"Adrian Geller - \"APARTE\"","shortdescr":"APARTE explores the concept of an \"apart\u00e9,\" a conversation held within a subset of a group, or the private discourse an actor shares on stage solely with the audience. The artworks in the show depict intimate moments as the characters in the paintings engage in apart\u00e9s within their surroundings, whether with animals or in specific places. ","longdescr":"When earthly silence invades the stage, lights bright on vain actors\u2019 game,\nthey burn out whites of rosy skin when they look up and out on sinking tides.\nAnd falling leaves of yellowed vines stare out of comfort and beauty\u2019s eyes.\nIn deeply troubled and unsettled time, a filling thought invades one\u2019s mind.\nThe thought of speaking, nonetheless, to living, rotten tenderness.\nThe leaves decaying under silvery frost, smell of remorse and loss of trust.\nAs the scream of jays in oaks, hollow sounds and revolting thoughts\nThus makes us think of helpless cries, of children, untamed and wild,\nbattling nature\u2019s cruel affray, different kinds, like a wave of sine, dead and alive,\npopulations of angels and devils decline. A speech, quiet in volume but loud in thought,\nspills over the edge of a sweet little cup, and burns over the spectators\u2019 row\nof the makeshift marionette show.\n\nApart from all that, you and I, eye to eye, under water and over ice\nRely on flickering bursts of links in the night,\nThe bird, to speak in heavenly rhymes,\nThe cat, to talk in mystery lines,\nThe fish, to never talk at all\nAnd the river, to swash us over,\nOnce and for all.\u201d\n\nAdrian Geller","performers":null,"boxoffice_url":null,"website":"https:\/\/www.superdakota.com\/","email":"contact@superdakota.comm","phone_contact":"+32 2 649 17 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005869"},"it":{"name":"Dakota - 'Aparte'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.superdakota.com\/","email":"contact@superdakota.comm","phone_contact":"+32 2 649 17 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005869"},"cn":{"name":"Dakota - 'Aparte'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.superdakota.com\/","email":"contact@superdakota.comm","phone_contact":"+32 2 649 17 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005869"},"fr":{"name":"Adrian Geller - \"APARTE\"","shortdescr":"APARTE explore le concept d'\"apart\u00e9\", une conversation tenue au sein d'un sous-ensemble d'un groupe, ou le discours priv\u00e9 qu'un acteur partage sur sc\u00e8ne uniquement avec le public. Les \u0153uvres d'art de l'exposition d\u00e9peignent des moments intimes o\u00f9 les personnages des peintures s'engagent dans des apart\u00e9s au sein de leur environnement, que ce soit avec des animaux ou dans des lieux sp\u00e9cifiques. ","longdescr":null,"performers":"Adrian Geller (artiste)","boxoffice_url":null,"website":"https:\/\/www.superdakota.com\/","email":"contact@superdakota.comm","phone_contact":"+32 2 649 17 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005869"},"sp":{"name":"Dakota - 'Aparte'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.superdakota.com\/","email":"contact@superdakota.comm","phone_contact":"+32 2 649 17 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005869"},"nl":{"name":"Adrian Geller - \"APARTE\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.superdakota.com\/","email":"contact@superdakota.comm","phone_contact":"+32 2 649 17 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005869"}},"place":{"id":252573,"translations":{"de":{"name":"Super Dakota","address_street_name":"Rue Stanley","address_street_number":"87","address_street_box":null,"email":"contact@superdakota.com","website":"http:\/\/www.superdakota.com","phone_contact":"+ 31 (0)2-649.17.72","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Rue Stanley, 87","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Super Dakota","address_street_name":"Rue Stanley","address_street_number":"87","address_street_box":null,"email":"contact@superdakota.com","website":"http:\/\/www.superdakota.com","phone_contact":"+ 31 (0)2-649.17.72","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Rue Stanley, 87","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Super Dakota","address_street_name":"Stanleystraat","address_street_number":"87","address_street_box":null,"email":"contact@superdakota.com","website":"http:\/\/www.superdakota.com","phone_contact":"+ 31 (0)2-649.17.72","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Stanleystraat, 87","address_line2":"1180 Uccle","description_web":"Founded in 2012, Galerie Dakota became the Super Dakota gallery. Continuing the initial reasoning behind Dakota - to discover and promote up-and-coming young artists - Super Dakota is renewing this ambition and confirming its determination to be more open to international art. This decision is consistent with the perspective of contemporary art as a demanding discipline whose roots lie deep in the history of art and with the search for a dialogue between generations in order to produce creative synergy.","description_print":null,"booking_url":null,"sort_order":"SUPER DAKOTA","virtual_visit":null,"visit_url":null},"it":{"name":"Super Dakota","address_street_name":"Rue Stanley","address_street_number":"87","address_street_box":null,"email":"contact@supe