tudenti"},"sp":{"name":"Estudiantes"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":10},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"},"de":{"name":"Vorverkauf"},"it":{"name":"Prevendita"},"sp":{"name":"Preventa"},"pt":{"name":"Pr\u00e9vente"},"cn":{"name":"Pr\u00e9vente"}},"value":13}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,259,263],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-17T22:35:57+01:00","published_at":"2022-08-23T15:30:37+02:00","backoffice_id":260190,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.19920634085785},{"id":549240,"date_start":"2023-03-17","date_end":"2023-03-19","date_next":"2023-03-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":57,"translations":{"fr":"Clubbing","nl":"Clubbing","en":"Clubbing","de":"Clubbing","it":"Locali notturni","sp":"Ir de discoteca","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","es","en"],"subtitles":[]},"translations":{"fr":{"name":"Fiesta Latina : \u00e9dition Carnaval","shortdescr":"Une \u00e9dition hivernale du plus grand \u00e9v\u00e9nement latino de Belgique","longdescr":"Pour la toute premi\u00e8re fois, la Fiesta Latina vous pr\u00e9sente son \u00e9dition Carnaval le 17, 18 et 19 mars 2023 \u00e0 Tour & Taxis, pour un voyage au c\u0153ur des traditions carnavalesques les plus c\u00e9l\u00e8bres d\u2019Am\u00e9rique latine!\r\n\r\nCette ann\u00e9e, l\u2019embl\u00e9matique Fiesta Latina se d\u00e9cline et vous propose une \u00e9dition hivernale o\u00f9 folklore et traditions carnavalesques d\u2019Am\u00e9rique latine seront mis \u00e0 l\u2019honneur : La Fiesta Latina \u00e9dition Carnaval! De quoi se r\u00e9chauffer dans le froid de l\u2019hiver avec l\u2019\u00e9v\u00e9nement le plus caliente de l\u2019ann\u00e9e!\r\nPour cette nouvelle \u00e9dition, ce sera \u00e0 l\u2019int\u00e9rieur des fameux sheds de Tour & Taxis que seront accueillis les plus embl\u00e9matiques carnavals latinos au monde, avec ses danseurs de folie, ses costumes extravagants, ses musiques entrainantes et ses activit\u00e9s folkloriques.\r\n\r\nAu programme:\r\n- 40 stands th\u00e9matiques, bars et food trucks aux saveurs sud-am\u00e9ricaines qui vous donneront le go\u00fbt de l'Am\u00e9rique latine\r\n- Des concerts et spectacles ambulants qui vous plongerons dans une ambiance latino et festive tout au long du festival\r\n- Des cours de danse tels que des initiations au Bachata, Salsa, Zumba ou encore au Reggaeton\r\n- Des after parties muy caliente\r\n- Et plus encore !\r\n\r\nLa nouveaut\u00e9?\r\nDes parades de folie hautes en couleurs, pour vous immerger dans le monde carnavalesque et le folklore des pays d'Am\u00e9rique latine \u00e0 travers des danses endiabl\u00e9es, des costumes extravagants et bien d'autres encore!\r\n\r\nHoraires:\r\n- Vendredi 17\/03 : 17:00 - 03:00\r\n- Samedi 18\/03 : 14:00 - 03:00\r\n- Dimanche 19\/03 : 12:00 - 00:00\r\n\r\nInformations pratiques :\r\n- Dates : 17, 18 et 19 mars 2023\r\n- Lieu : Shed 1, Av. du Port 86C, 1000 Bruxelles (Tour & Taxis)\r\n- Age requis : Ouvert \u00e0 tous\r\n- Accessible aux PMR\r\n- Un parking (payant) est disponible \u00e0 cette m\u00eame adresse\r\n\r\nTickets : \r\nLien vers la billetterie bient\u00f4t disponible\r\nGratuit pour les enfants de -12 ans\r\n\r\nR\u00e9seaux sociaux : \r\n- Site web : http:\/\/www.fiesta-latina.be\r\n- Facebook : http:\/\/www.facebook.com\/Fiestalatinabrussels\r\n- Instagram : @fiesta.latina","performers":null,"boxoffice_url":null,"website":"https:\/\/fiesta-latina.be\/","email":"info@beegroupe.be","phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549240"},"nl":{"name":"Fiesta Latina : Carnival Edition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fiesta-latina.be\/","email":"info@beegroupe.be","phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549240"},"en":{"name":"Fiesta Latina : Carnival Edition","shortdescr":"A winter edition of Belgium's biggest latino event","longdescr":"For the very first time, the Fiesta Latina presents its Carnival edition on 17, 18 and 19 March 2023 in Tour & Taxis, for a journey to the heart of the most famous carnival traditions of Latin America!\r\n\r\nThis year and for the very first time, the emblematic Fiesta Latina is taking on a winter edition where Latin American folklore and carnival traditions will be honored: The Fiesta Latina : Carnival Edition! A great way to warm up in the cold of winter with the most caliente event of the year!\r\nFor this new edition, the famous sheds of Tour & Taxis will host the most emblematic Latin carnivals in the world, with its amazing dancers, extravagant costumes, lively music and folkloric activities.\r\n\r\nOn the programme:\r\n- 40 thematic stands, bars and food trucks with South American flavors that will give you a taste of Latin America\r\n- Concerts and amazing shows that will immerse you in a Latin and festive atmosphere throughout the festival\r\n- Dance initiation such as Bachata, Salsa, Zumba or Reggaeton\r\n- Muy caliente After Parties\r\n- And many more !\r\n\r\nWhat's new?\r\nColorful parades of madness, to immerse you in the carnival world and the folklore of Latin American countries through wild dances, extravagant costumes and much more!\r\n\r\nSchedule:\r\n- Friday 17\/03 : 6pm - 3am\r\n- Saturday 18\/03 : 2pm - 3 am\r\n- Sunday 19\/03 : 12pm - 12am\r\n\r\nPractical information :\r\n- Dates: 17, 18 and 19 March 2023\r\n- Location: Shed 1, Av. du Port 86C, 1000 Brussels (Tour & Taxis)\r\n- Required age: Open to all\r\n- Accessible to PRM\r\n- A parking (with fee) is available at the same address\r\n\r\nTickets : \r\nLink to ticketing soon available\r\nFree for children under 12 years old\r\n\r\n\r\nSocial Media : \r\n- Website : http:\/\/www.fiesta-latina.be\r\n- Facebook : http:\/\/www.facebook.com\/Fiestalatinabrussels\r\n- Instagram : @fiesta.latina","performers":null,"boxoffice_url":null,"website":"https:\/\/fiesta-latina.be\/","email":"info@beegroupe.be","phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549240"},"de":{"name":"Fiesta Latina : \u00e9dition Carnaval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fiesta-latina.be\/","email":"info@beegroupe.be","phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.549240"},"it":{"name":"Fiesta Latina : \u00e9dition Carnaval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fiesta-latina.be\/","email":"info@beegroupe.be","phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.549240"},"sp":{"name":"Fiesta Latina : \u00e9dition Carnaval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fiesta-latina.be\/","email":"info@beegroupe.be","phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.549240"},"pt":{"name":"Fiesta Latina : \u00e9dition Carnaval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fiesta-latina.be\/","email":"info@beegroupe.be","phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.549240"},"cn":{"name":"Fiesta Latina : \u00e9dition Carnaval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fiesta-latina.be\/","email":"info@beegroupe.be","phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.549240"}},"place":{"id":222762,"translations":{"fr":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"L\u2019ancienne plateforme logistique de Tour & Taxis datant du d\u00e9but du 20\u00e8me si\u00e8cle offre des immeubles d\u2019envergure et d\u2019une haute qualit\u00e9 architecturale : l\u2019Entrep\u00f4t Royal, les Sheds, l\u2019H\u00f4tel des Douanes, l\u2019H\u00f4tel de la Poste et la Gare Maritime. Tout en respectant leur authenticit\u00e9 et leur valeur historique, une r\u00e9interpr\u00e9tation contemporaine est donn\u00e9e \u00e0 ces immeubles h\u00e9rit\u00e9s du si\u00e8cle pass\u00e9. Ils connaissent d\u00e9sormais des affectations multiples : expositions, \u00e9v\u00e9nements, espaces de travail, espaces commerciaux, services...\r\nLe site est id\u00e9alement situ\u00e9 sur le parcours touristique bruxellois, entre la vieille ville (Grand-Place, Manneken Pis \u2026) et d\u2019autres attractions touristiques telles que l\u2019Atomium.\r\nLes espaces verts et le parc \u00e9volutif sont des \u00e9l\u00e9ments centraux et inh\u00e9rents \u00e0 la philosophie de d\u00e9veloppement. Ils offrent des lieux de d\u00e9tente et de divertissement.\r\nTour & Taxis devient donc un quartier multifonctionnel r\u00e9invent\u00e9 avec des logements, de la culture, des espaces de travail, cr\u00e9ant une alternative positive pour les visiteurs \u00e0 la recherche de nouvelles exp\u00e9riences.\r\nDans un cadre inspirant, les Sheds accueillent des \u00e9v\u00e9nements incontournables et attirent de nombreux visiteurs.\r\nGr\u00e2ce aux diff\u00e9rents restaurants, bars et activit\u00e9s sur le site, il y a toujours une exp\u00e9rience \u00e0 vivre.\r\n\r\nT&T vous propose de d\u00e9couvrir l\u2019h\u00e9ritage industriel du site \u00e0 l\u2019aide de l\u2019App avec audio-guide, plan et photos. T\u00e9l\u00e9chargez l\u2019App gratuitement via le lien suivant : www.tt-app.be\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Tour & Taxis","address_street_name":"Havenlaan","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Havenlaan, 86c","address_line2":"1000 Brussel","description_web":"Het voormalige logistieke platform van Tour & Taxis uit de vroege jaren van de 20e eeuw  bestaat uit gebouwen met hoge architectonische kwaliteit: het Koninklijk Pakhuis, de Sheds, het H\u00f4tel des Douanes, het H\u00f4tel de la Poste en de Gare Maritime zijn stuk voor stuk erfgoedparels.  Dit patrimonium kreeg met respect  voor historische waarde en oog voor authenticiteit een nieuwe eigentijdse invulling met  tentoonstellingen, evenementen, kantoren, coworking, retail, services ...\r\nDe site sluit nauw aan bij het toeristisch parcours tussen het historische stadscentrum (Grote Markt, Manneken Pis ...) en andere bezienswaardigheden zoals het Atomium. Het bevindt zich ook op wandelafstand van het toekomstige nieuwe museum voor moderne en hedendaagse kunst.\r\nDe groene ruimtes en het moderne park bieden ruimte aan ontspanning en vrijetijdsactiviteiten.\r\nTour & Taxis wordt een vooruitstrevende participatieve wijk met woningen, cultuur, workspaces, food hall \u2026 die een uitvalsbasis vormt voor de bezoekers op zoek naar nieuwe ervaringen. Zo vinden er in de Sheds uiteenlopende topbeurzen plaats. Dankzij die grote diversiteit aan activiteiten, restaurants, bars en talloze andere activiteiten op de site valt er steeds iets te beleven.\r\n\r\nTour&Taxis biedt u de mogelijkheid om het industrieel patrimonium van de site te ontdekken aan de hand van een App met audio-guide en foto\u2019s. U kunt de App gratis downloaden op: www.tt-app.be\r\n \r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86c","address_line2":"1000 Brussels","description_web":"The historical logistics platform of Tour & Taxis presents a number of buildings of exceptional size and architectural value: the Royal Depot, the Sheds, the H\u00f4tel des Douanes, the H\u00f4tel de la Poste and the Gare Maritime. A modern interpretation is given to the historic buildings on the Tour & Taxis site, with great respect for their authenticity and heritage value.\r\nThe site is ideally located on the tourist routes, between the Brussels old city centre and other tourist attactions such as the Atomium.\r\nThe green areas and the evolutionary park are central features and an inherent part of the philosophy behind the Tour & Taxis development.\r\nTour & Taxis is becoming a reinvented neighbourhood with residences, culture, offices and public services all in one, creating a positive alternative for people looking for new experiences. The Sheds welcome different major events including antique and art fairs.\r\nWith eateries, bars and activities on the site, there\u2019s something to suit everyone\u2019s taste.\r\n\r\nTour & Taxis offers you the chance to discover the industrial heritage of this unique site using our App, which comprises of an audio guide working together with historic photos. You can download our App for free at: www.tt-app.be","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"Die ehemalige Logistikplattform mit Zolldepot Tour & Taxis, die Anfang des 20. Jahrhunderts erbaut und intensiv genutzt wurde, bietet eine ganze Reihe eindrucksvoller Geb\u00e4ude von hoher architektonischer Qualit\u00e4t: Entrep\u00f4t Royal, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste und Gare Maritime. Unter Ber\u00fccksichtigungen der urspr\u00fcnglichen Architektur und des besonderen historischen Wertes erhielt das Geb\u00e4ude nun eine zeitgem\u00e4\u00dfe Neuinterpretation und erf\u00fcllt inzwischen mehrere Aufgaben: Ausstellungen, Veranstaltungen, Arbeitsbereiche, Gesch\u00e4ftsr\u00e4ume, Dienstleistungen...\r\n\r\nDie Gr\u00fcnfl\u00e4chen und der sich entwickelnde Park als Orte der Entspannung und Unterhaltung sind zentrale Elemente des neuen Konzepts.\r\n\r\nDas industrielle Erbe von Tour & Taxis k\u00f6nnen Sie auch \u00fcber die App mit Audio-Guide, Karte und Fotos entdecken. Laden Sie die kostenlose App \u00fcber den folgenden Link herunter: www.tt-app.be\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"La hist\u00f3rica plataforma log\u00edstica de Tour & Taxis presenta un n\u00famero de edificios de gran envergadura y valor arquitect\u00f3nico: Royal Depot, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste y Gare Maritime. Se le da una interpretaci\u00f3n moderna a los edifcios hist\u00f3ricos de Tour & Taxis, respetando su autenticidad y valor patrimonial.\r\nEl lugar est\u00e1 idealmente localizado en las rutas tur\u00edsticas, entre la parte antigua de la ciudad y otros lugares de inter\u00e9s tur\u00edstico tales como el Atomium.\r\nLas zonas verdes y el parque, que est\u00e1 en constante evoluci\u00f3n, son las principales caracter\u00edsticas y una parte inherente de la filosof\u00eda que hay detr\u00e1s del desarrollo de Tour & Taxis.\r\nTour & Taxis se est\u00e1 convirtiendo en un nuevo vecindario con residencias, cultura, oficinas y servicios p\u00fablicos todo en uno, creando una alternativa positiva para aquella gente que busca nuevas experiencias. El edificio Sheds acoge diferentes eventos de gran envergadura, incluyendo ferias de arte y antig\u00fcedades.\r\n\u00a1En los restaurantes, bares y actividades que hay en el lugar encontrar\u00e1s cosas para todos los gustos!\r\n\r\nTour & Taxis te ofrece la oportunidad de descubrir el patrimonio industrial de este lugar \u00fanico usando nuestra aplicaci\u00f3n, que incluye una audiogu\u00eda junto con fotos hist\u00f3ricas. Puedes descargar la aplicaci\u00f3n de manera gratuita aqu\u00ed: www.tt-app.be\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[8],"translations":{"fr":["Canal"],"nl":["Kanaalwijk"],"en":["Canal"],"de":["Kanal-Viertel"],"it":["Canal"],"sp":["Canal"],"pt":[null],"cn":[null]}},"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"],"de":["Norden"],"it":["Nord"],"sp":["Norte"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":658,"location":{"lat":50.86573978,"lon":4.3509828},"region":"brussels","last_updated