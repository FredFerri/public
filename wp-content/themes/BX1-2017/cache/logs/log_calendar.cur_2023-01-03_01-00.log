ame":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normal"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":32},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Seniors"},"sp":{"name":"Seniors"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":30},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"},"de":{"name":"Arbeitsuchende"},"it":{"name":"Demandeurs d'emploi"},"sp":{"name":"Demandeurs d'emploi"},"pt":{"name":"Demandeurs d'emploi"},"cn":{"name":"Demandeurs d'emploi"}},"value":22},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"},"de":{"name":"Jugendliche"},"it":{"name":"Jeunes"},"sp":{"name":"Jeunes"},"pt":{"name":"Jeunes"},"cn":{"name":"Jeunes"}},"value":22}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,258,263,265],"translations":{"fr":["Accessible","Appareils d'amplification du son","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Geluidsversterkende apparatuur","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Sound-amplifying equipment","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","H\u00f6rverst\u00e4rker","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":[null,null,null,null],"sp":[null,null,null,null],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:54:01+01:00","published_at":"2022-09-19T16:20:52+02:00","backoffice_id":262196,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":545966,"date_start":"2023-01-18","date_end":"2023-01-18","date_next":"2023-01-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes","it":null,"sp":null,"pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Yasuni - En qu\u00eate de l\u2019esprit de la for\u00eat\u2026","shortdescr":"Yasuni est un spectacle immersif au sein duquel les enfants sont sensibilis\u00e9s \u00e0 la destruction progressive de la for\u00eat amazonienne et de tout l\u2019\u00e9cosyst\u00e8me dont fait partie le genre humain. Conscientis\u00e9s \u00e0 l\u2019importance de prendre soin de la nature, ils repartiront chacun avec un objet symbolique ritualis\u00e9 au cours d\u2019une chanson.","longdescr":"Un soir de pleine lune dans la for\u00eat de Yasuni, un rituel se pr\u00e9pare\u2026 Autour d\u2019un feu, une chamane murmure une incantation en posant sur la terre des pierres, des bougies, des plumes et un tambour. Dona Soledad fait office de passeuse entre le monde visible et le monde invisible. Port\u00e9e par le th\u00e9\u00e2tre d\u2019ombre, son r\u00e9cit et ses chansons nous livrent sa vision animiste de la nature, des animaux et du monde des esprits.\r\nYasuni est un spectacle immersif au sein duquel les enfants sont sensibilis\u00e9s \u00e0 la destruction progressive de la for\u00eat amazonienne et de tout l\u2019\u00e9cosyst\u00e8me dont fait partie le genre humain. Conscientis\u00e9s \u00e0 l\u2019importance de prendre soin de la nature, ils repartiront chacun avec un objet symbolique ritualis\u00e9 au cours d\u2019une chanson.\r\nNora a une formation de com\u00e9dienne, clown et Comedia Dell Arte. Elle d\u00e9couvre le chant jazz et les musiques du monde. Elle est sophrologue.\r\nEric, form\u00e9 en Jazz au Conservatoire royal de Bruxelles est actif sur la sc\u00e8ne musicale belge et internationale.\r\nJulie, historienne de l\u2019art et sc\u00e9nographe, a suivi une formation d\u2019actrice-marionnettiste et de th\u00e9\u00e2tre d\u2019ombre.\r\nAvec le soutien du Bourgmestre, de l\u2019Echevin de la Culture, du Coll\u00e8ge des Bourgmestre et Echevins et du Service Culture de la Commune d\u2019Ixelles.","performers":"Nora Helali : chanteuse, conteuse ; Julie Michaud : chant, projection d\u2019ombres ; Eric Bribosia : claviers","boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/mercelis-yasuni\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545966"},"nl":{"name":"Yasuni - Op zoek naar de bosgeest...","shortdescr":"Yasuni is een meeslepende voorstelling waarin kinderen bewust worden gemaakt van de voortschrijdende vernietiging van het Amazonewoud en van het hele ecosysteem waarvan de mens deel uitmaakt. Zich bewust van het belang van zorg voor de natuur, zullen zij elk vertrekken met een symbolisch voorwerp dat tijdens een lied wordt geritualiseerd.","longdescr":"Op een avond met volle maan in het Yasuni-woud wordt een ritueel voorbereid... Rond een vuur fluistert een sjamaan een bezwering terwijl zij stenen, kaarsen, veren en een trommel op de grond legt. Dona Soledad fungeert als een brug tussen de zichtbare en onzichtbare wereld. Gedragen door schaduwtheater geven haar verhaal en haar liederen ons haar animistische visie op de natuur, de dieren en de wereld van de geesten.\r\nYasuni is een meeslepende voorstelling waarin kinderen bewust worden gemaakt van de voortschrijdende vernietiging van het Amazonewoud en van het hele ecosysteem waarvan de mens deel uitmaakt. Zij worden bewust gemaakt van het belang van zorg voor de natuur en zullen elk vertrekken met een symbolisch voorwerp dat tijdens een lied wordt geritualiseerd.\r\nNora heeft een achtergrond in acteren, clownerie en Comedia Dell Arte. Ze ontdekte jazz zang en wereldmuziek. Ze is een sofiste.\r\nEric, opgeleid in Jazz aan het Koninklijk Conservatorium van Brussel, is actief op de Belgische en internationale muzieksc\u00e8ne.\r\nJulie, kunsthistorica en scenografe, is opgeleid als poppenspeler en in schaduwtheater.\r\n\r\nMet de steun van de burgemeester, de schepen van Cultuur, het college van burgemeester en schepenen en de dienst Cultuur van de gemeente Elsene.","performers":"Nora Helali: zangeres, vertelster; Julie Michaud: zang, schaduwprojectie; Eric Bribosia: keyboards.","boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/mercelis-yasuni\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545966"},"en":{"name":"Yasuni - In search of the forest spirit...","shortdescr":"Yasuni is an immersive show in which children are made aware of the progressive destruction of the Amazonian forest and of the entire ecosystem of which mankind is a part. Aware of the importance of taking care of nature, they will each leave with a symbolic object ritualized during a song.","longdescr":"One full moon evening in the forest of Yasuni, a ritual is being prepared... Around a fire, a shaman whispers an incantation by placing stones, candles, feathers and a drum on the ground. Dona Soledad acts as a bridge between the visible and invisible worlds. Carried by the shadow theater, her story and her songs give us her animist vision of nature, animals and the world of the spirits.\r\nYasuni is an immersive show in which children are made aware of the progressive destruction of the Amazonian forest and of the whole ecosystem of which the human race is a part. Conscious of the importance of taking care of nature, they will each leave with a symbolic object ritualized during a song.\r\nNora has a background in acting, clowning and Comedia Dell Arte. She discovered jazz singing and world music. She is a sophrologist.\r\nEric, trained in Jazz at the Royal Conservatory of Brussels is active on the Belgian and international music scene.\r\nJulie, an art historian and scenographer, trained as a puppet-actress and in shadow theater.\r\n\r\nWith the support of the Mayor, the Alderman of Culture, the College of Burgomasters and Aldermen and the Cultural Service of the Commune of Ixelles.","performers":"Nora Helali: singer, storyteller; Julie Michaud: singing, shadow projection; Eric Bribosia: keyboards","boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/mercelis-yasuni\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545966"},"de":{"name":"Yasuni - Op zoek naar de bosgeest...","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545966"},"it":{"name":"Yasuni - Op zoek naar de bosgeest...","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545966"},"sp":{"name":"Yasuni - Op zoek naar de bosgeest...","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545966"},"pt":{"name":"Yasuni - Op zoek naar de bosgeest...","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking"