e},"thursday":{"is_open":false},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"de":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"it":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"sp":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"pt":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"cn":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"]},"date_start":"2022-11-29","date_end":"2023-12-31","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"],"de":["Jugendstil & Art d\u00e9co"],"it":["Art Nouveau e Art D\u00e9co"],"sp":["Art nouveau y art d\u00e9co"],"pt":[null],"cn":[null]}},"tags":["exterior","annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":{"list":[263,266],"translations":{"fr":["Accessible aux pi\u00e9tons appareill\u00e9s","Brussels Health Safety Label"],"nl":["Toegankelijk voor voetgangers met hulpmiddelen","Brussels Health Safety Label"],"en":["Accessible to pedestrians with mobility aids","Brussels Health Safety Label"],"de":["Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Brussels Health Safety Label"],"it":["Accessibile ai pedoni con supporti","Brussels Health Safety Label"],"sp":["Habilitado para peatones con aud\u00edfonos","Brussels Health Safety Label"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-25T02:09:00+02:00","published_at":"2022-11-28T12:33:13+01:00","backoffice_id":266251,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.2718956784944},{"id":550940,"date_start":"2023-03-31","date_end":"2023-07-23","date_next":"2023-04-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Johan Van Mullem - 'For Love\u2019s(n)ake'","shortdescr":"T\u00e9moignant toujours activement de son soutien \u00e0 la cr\u00e9ation contemporaine, le mus\u00e9e invite en r\u00e9sidence un artiste made in Belgium: Johan Van Mullem. La s\u00e9lection, qui pr\u00e9sentera un ensemble contrast\u00e9 d\u2019une cinquantaine d\u2019\u0153uvres, peintures, sculptures, dessins pour la plupart in\u00e9dits, au c\u0153ur du Mus\u00e9e Old Masters, s\u2019inscrit comme le troisi\u00e8me volet du cycle d\u2019exposition Remedies.","longdescr":"Pour la troisi\u00e8me \u00e9dition du cycle d\u2019expositions Remedies entam\u00e9 \u00e0 l\u2019automne 2021, les Mus\u00e9es royaux des Beaux-Arts invitent, en contrepoint de leur collection, l\u2019artiste belge multidisciplinaire Johan Van Mullem. D\u2019origine brugeoise et bruxellois d\u2019adoption, n\u00e9 au Congo en 1959, le dessinateur, peintre et sculpteur incarne l\u2019un des visages, riches et pluriels, de notre territoire.\r\n\r\nArchitecte de formation, Van Mullem a toujours dessin\u00e9. Il consid\u00e8re d\u2019ailleurs que le dessin est \u00e0 l\u2019origine de la peinture. Connu et reconnu pour ses visages fantastiques, tout en int\u00e9riorit\u00e9, c\u2019est la crise sanitaire qui lui fait d\u00e9couvrir un nouvel horizon dans son jardin (int\u00e9rieur), offrant d\u00e9sormais des univers davantage tourn\u00e9s vers l\u2019ext\u00e9rieur. L\u2019apparition du v\u00e9g\u00e9tal d\u00e9clenche un sentiment de libert\u00e9 et de s\u00e9r\u00e9nit\u00e9. Les paysages fantasm\u00e9s t\u00e9moignent aussi de l\u2019\u00e9closion de sa palette de couleurs. Soutenu par l\u2019utilisation d\u2019encres de gravure et d\u2019imprimerie, le r\u00e9sultat conf\u00e8re \u00e0 son \u0153uvre une luminescence toute particuli\u00e8re.\r\n\r\nLe travail de Johan Van Mullem semble na\u00eetre de r\u00e9miniscences enfouies de l\u2019histoire de l\u2019art : th\u00e8mes profanes, portraits et paysages alternent dans son \u0153uvre et irradient d\u2019une pr\u00e9sence \u00e0 la fois \u00e9blouissante et insaisissable, la dotant d\u2019une aura religieuse, voire initiatique. Au c\u0153ur-m\u00eame du Mus\u00e9e Old Masters, dessins, peintures et sculptures viennent s\u2019articuler dans une dualit\u00e9 qui tend \u00e0 r\u00e9concilier notre part sombre \u00e0 l\u2019espoir qui nous anime immanquablement.\r\n \r\nEntre \u00e9motions et m\u00e9moire, entre mouvement et lumi\u00e8re, une cinquantaine d\u2019\u0153uvres in\u00e9dites, au format parfois impressionnant, ouvrent un espace-temps loin de toute urgence et proposent au public un nouveau regard, inscrivant la cr\u00e9ation contemporaine dans ses racines historiques.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550940"},"nl":{"name":"Johan Van Mullem - 'For Love\u2019s(n)ake'","shortdescr":"In het kader van zijn actieve steun aan de hedendaagse kunst nodigt het museum de Belgische kunstenaar Johan Van Mullem uit in residentie. Er zullen ongeveer vijftig werken getoond worden. De selectie bestaat uit schilderijen, beeldhouwwerken en tekeningen, waarvan de meeste nooit eerder zijn getoond.","longdescr":"Voor de derde editie van de tentoonstellingscyclus Remedies, die in het najaar van 2021 voor het eerst plaatsvond, nodigen de Koninklijke Musea voor Schone Kunsten de multidisciplinaire Belgische kunstenaar Johan Van Mullem uit in dialoog te gaan met de permanente verzameling. Deze tekenaar, schilder en beeldhouwer is afkomstig uit Brugge, in 1959 geboren te Congo, maar woont en werkt in Brussel waardoor hij meteen de veelzijdigheid van ons land belichaamt.\r\n\r\nVan opleiding architect is Van Mullem iemand die voortdurend tekent. Hij is van mening dat tekenen aan de oorsprong ligt van de schilderkunst. Tot heel recent was hij vooral bekend om zijn imaginaire gezichten die de intimiteit van de persoon reflecteren. De lockdown leidde tot het verkennen van nieuwe horizonten met name zijn (innerlijke) tuin, als een ruimte die de verbinding maakt met wat zich buiten ons afspeelt. Dit vegetale universum roept een gevoel van vrijheid en sereniteit op. De fantasierijke landschappen doen zijn kleurenpalet openbloeien wat culmineert in een bijzondere luminescentie, nog versterkt door het gebruik van ets- en drukinkten.\r\n\r\nHet werk van Johan Van Mullem lijkt te ontstaan uit onderliggende kunsthistorische herinneringen: in zijn werk wisselen profane thema's, portretten en landschappen elkaar af. Ze bevatten een enorme aanwezigheid, maar zijn tegelijkertijd ongrijpbaar wat hen een bijna religieus-initi\u00ebrende uitstraling geeft. Te midden van het Old Masters Museum confronteren zijn tekeningen, schilderijen en sculpturen ons met een dualiteit waarin onze duistere zijde zich verzoent met de hoop die ons onvermijdelijk drijft.\r\n\r\nEen vijftigtal nieuwe werken, in soms indrukwekkende formaten, laveren tussen emotie en herinnering, beweging en licht. Ze openen een tijdframe wars van elke urgentie. Ze bieden het publiek een nieuw perspectief op de manier waarop een hedendaagse creatie zich verhoudt tot haar historische wortels.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550940"},"en":{"name":"Johan Van Mullem - 'For Love\u2019s(n)ake'","shortdescr":"As part of its ongoing support for contemporary art, the museum invites Belgian artist Johan Van Mullem in residence. The various selection of 50 works comprises paintings, sculptures and drawings, most of which have never been shown before. The exhibition will be presented in the heart of the Old Masters Museum, and is the third part of the Remedies exhibition cycle.","longdescr":"For the third edition of the Remedies exhibitions\u2019 cycle, the Royal Museums of Fine Arts invite the Belgian multidisciplinary artist Johan Van Mullem to dialogue with their collection. Born in Congo in 1959 and originally from Bruges, the draughtsman, painter and sculptor lives in Brussels today. Resolutely rooted in Belgium, Van Mullem characterizes the richness and plurality of our national land.\r\n\r\nHis training as an architect might explain why Van Mullem has always been drawing. He claims that drawing lies at the origin of painting. Until recently, he has mostly been known and renowned for his depictions of phantasmagoric faces, reflecting on what lies within. Lockdown made him embark on a new horizon, that of his (inner) garden, now offering perspective on the outside world. The vegetal dimension calls for serendipity and the artist\u2019s colour palette blooms through the dreamy landscapes. The overall effect culminates in a peculiar luminescence enhanced by the use of printing and etching inks.\r\n\r\nJohan Van Mullem\u2019s work seems to emerge from art history\u2019s underlying memoirs : the secular themes, portraits and landscapes each take place in his \u0153uvre and radiate with a dazzling yet elusive presence, endowing it with a religious, even initiatory aura. At the very heart of the Old Masters Museum, his drawings, paintings and sculptures come together in a duality that tends to reconcile our dark side with the hope that inevitably drives us.\r\n\r\nBetween emotions and memory, between movement and light, some fifty new works, sometimes of an impressive format, open up a timeframe far from any urgency, and offer the public a new perspective, inscribing contemporary creation in its historical roots.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550940"},"de":{"name":"Johan Van Mullem - 'For Love\u2019s(n)ake'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550940"},"it":{"name":"Johan Van Mullem - 'For Love\u2019s(n)ake'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550940"},"sp":{"name":"Johan Van Mullem - 'For Love\u2019s(n)ake'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.550940"},"pt":{"name":"Johan Van Mullem - 'For Love\u2019s(n)ake'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.550940"},"cn":{"name":"Johan Van Mullem - 'For Love\u2019s(n)ake'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.550940"}},"place":{"id":488,"translations":{"fr":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Les Mus\u00e9es Royaux des Beaux-Arts de Belgique sont constitu\u00e9s de six mus\u00e9es bruxellois: le Mus\u00e9e Oldmasters Museum, le Mus\u00e9e Modern Museum, le Mus\u00e9e Meunier Museum, le Mus\u00e9e Wiertz Museum, le Magritte Museum et le Mus\u00e9e fin-de-si\u00e8cle Museum.","description_print":"","booking_url":null,"sort_order":"Royal Museums of Fine Arts of Belgium","virtual_visit":null},"nl":{"name":"Koninklijke Musea voor Schone Kunsten van Belgi\u00eb","address_street_name":"Regentschapsstraat","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Regentschapsstraat, 3","address_line2":"1000 Brussel","description_web":"Onder de hoede van de Koninklijke Musea voor Schone Kunsten van Belgi\u00eb staan zes afzonderlijke musea: het Mus\u00e9e Oldmasters Museum, het Mus\u00e9e Modern Museum, het Mus\u00e9e Meunier Museum, het Mus\u00e9e Wiertz Museum, het Magritte Museum en het Mus\u00e9e fin-de-si\u00e8cle Museum.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Royal Museums of Fine Arts of Belgium","address_street_name":"rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de la R\u00e9gence, 3","address_line2":"1000 Brussels","description_web":"The Royal Museums of Fine Arts of Belgium assemble six different museums: the Oldmasters Museum, Modern Museum, Meunier Museum, Wiertz Museum, Magritte Museum and the Fin-de-Si\u00e8cle Museum.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Die Mus\u00e9es Royaux des Beaux-Arts de Belgique \u2013 6 Museen, 7 Jahrhunderte der sch\u00f6nen K\u00fcnste, 20 000 Kunstwerke und Kunstgenuss vom Feinsten:\r\n\r\n\u2022\tIm Mus\u00e9e Magritte gibt es die weltweit gr\u00f6\u00dfte Sammlung von Werken des gro\u00dfen belgischen Surrealisten Ren\u00e9 Magritte zu entdecken\r\n\r\n\u2022\tIm Mus\u00e9e Fin-de-Si\u00e8cle erwartet den Besucher mit K\u00fcnstlern wie Khnopff, Spilliaert, Horta, Rodin, Gauguin, Mucha und Bonnard das besondere Fin-de-Si\u00e8cle-Ambiente, das um 1900 in Br\u00fcssel herrschte. Mehr als 30 K\u00fcnstler \u2013 vom Impressionismus \u00fcber den Jugendstil, von den sch\u00f6nen K\u00fcnsten bis zur Oper.\r\n\r\n\u2022\tIm Mus\u00e9e Old Master gibt es Meisterwerke aus der Epoche des 15. Jahrhunderts bis hin zum 18. Jahrhundert zu sehen, unter anderem mit der weltweit gr\u00f6\u00dften Bruegel-Sammlung, verschiedenen Werken von Rubens, van der Weyden und Jordaens. \r\n\r\n\u2022\tDas Mus\u00e9e Modern Art zeigt eine Auswahl von Meisterwerken des 20. Jahrhunderts, darunter Broodthaers, Fabre, David, Panamarenko, Alechinsky.\r\n\r\n\u2022\tDie beiden Kunstatelier-Museen Mus\u00e9e Wiertz und Meunier in Ixelles geben einen faszinierenden Einblick in die Welt dieser beiden K\u00fcnstler.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo Reale delle Belle Arti del Belgio","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"I Musei Reali delle Belle Arti del Belgio sono sei musei di Bruxelles: l'Oldmasters Museum, il Mus\u00e9e Modern, il Meunier Museum, il Wiertz Museum, il Magritte Museum ed il Fin-de-si\u00e8cle Museum.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museos Reales de Bellas Artes de B\u00e9lgica","address_street_name":"rue de la R\u00e9gence","address_street_number":"3","address_str