meter; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Visite Bruxelles, Grand-Place, maison de l'Etoile ... myst\u00e9rieuse !"},"nl":{"title":"Visite Bruxelles, Grand-Place, maison de l'Etoile ... myst\u00e9rieuse !"},"en":{"title":"Visite Bruxelles, Grand-Place, maison de l'Etoile ... myst\u00e9rieuse !"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/6d39e798e353449b6b14367d8cf2692f0955ee96.jpg","width":1441,"height":1080,"ratio":1.33,"translations":{"fr":{"title":"Les Myst\u00e8res de la Grand-Place de Bruxelles","copyright":null},"nl":{"title":"Les Myst\u00e8res de la Grand-Place de Bruxelles","copyright":null},"en":{"title":"Les Myst\u00e8res de la Grand-Place de Bruxelles","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/74dabccd249e0896fcdfd8ef70baa19acd3a1730.jpg","width":1080,"height":1920,"ratio":0.56,"translations":{"fr":{"title":"Les Myst\u00e8res de la Grand-Place de Bruxelles","copyright":null},"nl":{"title":"Les Myst\u00e8res de la Grand-Place de Bruxelles","copyright":null},"en":{"title":"Les Myst\u00e8res de la Grand-Place de Bruxelles","copyright":null}}}],"dates":[{"day":"2022-04-10","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-06-12","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-07-31","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-11","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-01T01:07:34+02:00","published_at":"2022-03-03T11:51:55+01:00","backoffice_id":248890,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":528899,"date_start":"2022-04-10","date_end":"2022-09-18","date_next":"2022-09-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La Grand-Place de Bruxelles sous la loupe","shortdescr":"Prendre le temps.\r\nLe temps d'observer, fa\u00e7ade par fa\u00e7ade, maison par maison.\r\nSe laisser prendre par \"la plus belle place du monde \" !\r\nS'offrir un moment de contemplation intelligent, ludique et interactif.\r\nLa Grand-Place, comme vous n'aviez jamais pris le temps de la regarder.","longdescr":"Vite-vite. Un peu d'Histoire, un zeste d'anecdotes, un propos vite-fait sur l'architecture, quelques anecdotes distill\u00e9es et le tour est jou\u00e9. Le groupe de touristes peut passer au manneken pis et aller boire un lambic.\r\nNon !\r\nCe n'est pas \u00e0 ce genre de public que la visite guid\u00e9e de la Grand-Place sous la loupe s'adresse.\r\nDans le cadre de cette visite guid\u00e9e, Visite-Bruxelles vous propose de prendre le temps. Temps de voir, observer, appr\u00e9cier, d\u00e9guster.\r\nUn peu d'Histoire ? oui ! \r\nUn zeste d'anecdotes ? bien s\u00fbr ! \r\nUne analyse de l'architecture et des interpr\u00e9tations de la statuaire ? \u00e9videmment  !\r\n... et pour chaque b\u00e2timent, l'un apr\u00e8s l'autre.\r\nJusqu'\u00e0 ce que nous ayons fait le tour de la quarantaine d'\u00e9difices ... quelques maisons annexes et adjacentes en plus.\r\nLe tout agr\u00e9ment\u00e9 d'illustrations pr\u00e9sent\u00e9es sur smartphone ou tablette, afin de confronter pass\u00e9 et pr\u00e9sent ou b\u00e9n\u00e9ficier du zoom pour mieux profiter des petits secrets lov\u00e9s l\u00e0-haut, tout l\u00e0-haut, au sommet des \u00e9difices.\r\nDe quoi vraiment appr\u00e9cier en profondeur la richesse patrimoniale de ce joyau, estampill\u00e9 Unesco !\r\nVisite de la Grand-Place de Bruxelles sous la loupe : le tourisme. Autrement.","performers":"Vincent Beckers, guide touristique et r\u00e9gional","boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528899.html"},"nl":{"name":"La Grand-Place de Bruxelles sous la loupe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528899.html"},"en":{"name":"La Grand-Place de Bruxelles sous la loupe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528899.html"},"de":{"name":"La Grand-Place de Bruxelles sous la loupe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528899.html"},"it":{"name":"La Grand-Place de Bruxelles sous la loupe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528899.html"},"sp":{"name":"La Grand-Place de Bruxelles sous la loupe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528899.html"},"pt":{"name":"La Grand-Place de Bruxelles sous la loupe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528899.html"},"cn":{"name":"La Grand-Place de Bruxelles sous la loupe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528899.html"}},"place":{"id":475,"translations":{"fr":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Parmi tous, l'H\u00f4tel de Ville de Bruxelles est sans conteste l'un des plus majestueux du pays\u202f! Cet \u00e9difice, b\u00e2ti au 15e si\u00e8cle en style gothique, est sublim\u00e9 par le d\u00e9cor qu\u2019offre la Grand-Place, souvent qualifi\u00e9e de plus belle au monde... Vous admirerez la justesse de ses proportions, les innombrables sculptures qui ornent ses fa\u00e7ades, ou encore l\u2019\u00e9clat incomparable de sa tour, dont la fl\u00e8che supporte l'archange saint Michel, protecteur de la ville. Bruxelles posa la premi\u00e8re pierre du somptueux \u00e9difice en 1401. En 1695, lors du bombardement de la ville par les troupes de Louis XIV, l'H\u00f4tel de Ville fut incendi\u00e9, mais les murs et la tour resteront debout. Ses salles de r\u00e9ceptions et cabinets \u00e9chevinaux renferment de belles tapisseries bruxelloises des XVI\u00e8me, XVII\u00e8me et XVIII\u00e8me si\u00e8cles, de somptueuses boiseries gothiques, \u00e9cussons des anciennes corporations et tableaux des collections du mus\u00e9e de la ville. \r\n ","description_print":"18\/07\/2022\r\n\u00c9l\u00e9gant b\u00e2timent datant du 15\u00e8me si\u00e8cle, l\u2019H\u00f4tel de Ville de Bruxelles se situe au c\u0153ur du centre historique, sur la somptueuse Grand-Place.\r\nSouvent consid\u00e9r\u00e9 comme la pi\u00e8ce ma\u00eetresse de la plus belle place du monde, il est probablement l\u2019un des plus beaux \u00e9difices du pays et \u00e9videmment l\u2019un des monuments \u00e0 ne pas manquer lors de votre s\u00e9jour \u00e0 Bruxelles. Sa splendide tour se dresse tel un rep\u00e8re aussi bien pour les curieux d\u2019un jour que les belges de passage dans le centre de la capitale.\r\nUn r\u00e9gal pour les yeux\r\nParticuli\u00e8rement imposant par ses dimensions, ses remarquables d\u00e9cors sculpt\u00e9s et sa fa\u00e7ade asym\u00e9trique, il attire rapidement les regards. En vous promenant devant ce prestigieux b\u00e2timent, peut-\u00eatre que vous apercevrez aux balcons de jeunes mari\u00e9s c\u00e9l\u00e9brer leur union.\r\nL\u2019int\u00e9rieur de l\u2019H\u00f4tel de Ville vaut \u00e9galement le d\u00e9tour. Il attise la curiosit\u00e9 de ceux qui souhaitent d\u00e9couvrir la disposition et l\u2019am\u00e9nagement des diff\u00e9rentes salles de ce chef-d\u2019\u0153uvre architectural. Des visites guid\u00e9es de l\u2019H\u00f4tel de Ville de Bruxelles sont r\u00e9guli\u00e8rement organis\u00e9es afin de d\u00e9couvrir la richesse de cet int\u00e9rieur qui ne cesse d\u2019\u00e9blouir les visiteurs.\r\nL\u2019\u00e9volution d\u2019un b\u00e2timent singulier\r\nSa construction s'\u00e9tale sur une longue p\u00e9riode et voit d\u00e9filer plusieurs architectes. \u00c0 l\u2019origine, l\u2019\u00e9difice ne comptait qu\u2019un beffroi et la partie gauche qui elle est rest\u00e9e identique jusqu\u2019\u00e0 aujourd\u2019hui. Le beffroi, quant \u00e0 lui, est par contre rapidement remplac\u00e9 par la tour actuelle lorsque les maisons des diff\u00e9rentes corporations de m\u00e9tiers s\u2019installent sur la place. Une aile suppl\u00e9mentaire est \u00e9galement ajout\u00e9e sur la droite pour inclure au mieux ces immeubles dans cet incomparable d\u00e9cor.\r\nAu sommet de la nouvelle tour, haute de plus de 90m, la fl\u00e8che est couronn\u00e9e de l\u2019archange Saint-Michel, grand Patron de la ville de Bruxelles. Cette statue en cuivre dor\u00e9 sert en r\u00e9alit\u00e9 de girouette. Si les vents vous sont favorables, vous aurez l\u2019occasion de pouvoir admirer convenablement la mani\u00e8re dont cet embl\u00e8me vient \u00e0 bout du dragon !\r\nActuellement, ce joyau du patrimoine bruxellois abrite l\u2019office du Tourisme.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stadhuis Brussel","address_street_name":"Grote Markt","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"Als je het ons vraagt, is het stadhuis van Brussel is een van de meest majestueuze van het land! Dit gebouw op de Grote Markt, een van de mooiste pleinen ter wereld, werd ontworpen in de 15e eeuw in gotische stijl. Ontelbare beeldhouwwerken sieren de gevels, en op de toren prijkt de aartsengel Sint-Michiel, de beschermer van de stad. Brussel legde de eerste steen van het weelderige gebouw in 1401. In 1695, tijdens een bombardement door de troepen van Lodewijk XIV, werd het stadhuis in brand gestoken, maar de muren en de toren bleven overeind. In de ontvangstzalen en de schepenkamers bevinden zich prachtige Brusselse wandtapijten uit de 16e, 17e en 18e eeuw, weelderig gotisch houtwerk, wapenschilden van de oude gilden en schilderijen uit de collecties van het stedelijk museum. ","description_print":"18\/07\/2022\r\nHet elegante stadhuis van Brussel dateert uit de 15de eeuw en ligt in het historische hart van de stad, op de prachtige Grote Markt. \r\n\r\nHet wordt vaak beschouwd als het absolute pronkstuk van het mooiste plein ter wereld en is wellicht een van de mooiste gebouwen van het land. Het is dan ook een niet te missen monument tijdens je bezoek aan Brussel. Zijn prachtige toren is een herkenningspunt voor zowel de dagjestoeristen als de Belgen die door het stadscentrum kuieren. \r\nEen lust voor het oog \r\nNiet alleen de indrukwekkende afmetingen van het gebouw, maar ook de opmerkelijke gebeeldhouwde ornamenten en de asymmetrische gevel trekken meteen de aandacht. En terwijl je dit prestigieuze gebouw voorbij wandelt, word je misschien toegewuifd door een pasgetrouwd stel op het balkon ... \r\nHet interieur van het stadhuis is eveneens een omweg waard. Wie wil, kan een blik werpen op de indeling en de inrichting van de verschillende zalen van dit architecturale meesterwerk. Er worden regelmatig rondleidingen in het Brussels stadhuis georganiseerd om de rijkdom van het interieur aan de bezoekers te tonen. \r\nEvolutie van een uniek gebouw \r\nHet gebouw werd over een lange periode ontworpen door verschillende architecten. Oorspronkelijk bestond het enkel uit een belfort en het linkerdeel, dat ongewijzigd is gebleven. Het belfort daarentegen werd al snel vervangen door de huidige toren, toen de huizen van de verschillende gilden zich op de grote markt begonnen te vestigen. Aan de rechterkant werd een extra vleugel bijgebouwd, om deze gebouwen beter in dit unieke decor op te nemen. \r\nBovenaan de meer dan 90 meter hoge, nieuwe toren, werd de torenspits bekroond met aartsengel Micha\u00ebl, de beschermheilige van de stad Brussel. Het standbeeld in verguld koper doet in werkelijkheid dienst als windwijzer. Bij gunstige wind kan je zelfs zien hoe dit embleem de draak velt! \r\nMomenteel is de toeristische dienst ondergebracht in dit pronkstuk van het Brusselse erfgoed. ","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"City of Brussels Town Hall","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"Of all of the town halls in the country, the City of Brussels town hall is undoubtedly one of the most majestic! This Gothic building, built in the 15th century, is enhanced by its setting on the Grand-Place, often described as the most beautiful square in the world... Admire the accuracy of its proportions, the countless sculptures that adorn its facades and the incomparable brilliance of its tower, whose spire supports the archangel Saint Michael, the city's protector. This City of Brussels laid the first stone of the sumptuous building back in 1401. In 1695, during the bombardment of the city by Louis XIV's troops, the town hall was burned down, but the walls and the tower remained standing. Its reception rooms and aldermen's chambers contain beautiful Brussels tapestries from the 16th, 17th and 18th centuries, sumptuous Gothic woodwork, coats of arms of the old guilds and paintings from the City of Brussels museum's collections.","description_print":"18\/07\/2022\r\nAn elegant building dating back to the 15th century, the City of Brussels Town Hall is located in the heart of the historical centre, on the sumptuous Grand-Place.\r\nOften considered to be the centrepiece of the most beautiful square in the world, it is undoubtedly one of the most stunning buildings in Belgium and definitely one of the unmissable highlights of your stay in Brussels. Its splendid tower stands as a landmark both for day-trippers and Belgians passing through the centre of the capital.\r\n\r\nA feast for the eyes\r\nParticularly imposing due to its size, its remarkable sculpted decorations and its asymmetrical facade, it quickly catches the eye. Walking in front of this prestigious building, you might spot newlyweds celebrating their union on the balconies.\r\nThe Town Hall's interior is also well worth a visit. It attracts the curiosity of those who want to know more about the layout and arrangement of the different rooms of this architectural masterpiece. Guided tours of the City of Brussels Town Hall are regularly organised and let you discover the richness of this interior which never fails to dazzle its visitors.\r\n\r\nThe evolution of a unique building\r\nIts construction was spread out over a long period of time and is the work of several architects. Originally, the building had only a belfry and the left part of the building has remained the same until today. The belfry, on the other hand, was quickly replaced by the current tower when the houses of the various trade guilds moved into the square. An additional wing was also added on the right to better incorporate these buildings into this exceptional setting.\r\nAt the top of the new tower, more than 90m high, the spire is crowned with the Archangel Saint-Michel, the patron saint of the City of Brussels. This gilded copper statue is actually used as a weather vane. If the winds blow the right way, you can admire the city's hero as he defeats the dragon!\r\nThis jewel of Brussels' architectural heritage currently houses the Tourist Office.","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Rathaus Br\u00fcssel","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Rathaus ist ein elegantes Bauwerk aus dem 15. Jahrhundert, gelegen auf dem pr\u00e4chtigen Grand-Place im Herzen des historischen Stadtzentrums. \r\n\r\nEs gilt als das architektonische Meisterwerk eines der sch\u00f6nsten Pl\u00e4tze der Welt und z\u00e4hlt dar\u00fcber hinaus zu den wahrscheinlich eindrucksvollsten Bauwerken Belgiens, das Sie bei Ihrem Besuch in Br\u00fcssel unbedingt besichtigen sollten. Zu verfehlen ist es kaum, denn sein majest\u00e4tischer Turm ragt hoch in den Br\u00fcsseler Himmel hinein.  \r\n\r\nEin Augenschmaus \r\n\r\nInsbesondere seine imposanten Dimensionen, seine bemerkenswerten skulpturalen Verzierungen und seine asymmetrische Fassade fallen sofort ins Auge. Und wenn man Gl\u00fcck hat, kann man auf dem majest\u00e4tischen Balkon einen Blick auf ein frischgebackenes Brautpaar erhaschen. \r\n\r\nAuch das Innere des Rathauses ist einen Besuch wert, denn die Aufteilung und die Anordnung der verschiedenen S\u00e4le dieses architektonischen Meisterwerks sind absolut sehenswert. Es finden regelm\u00e4\u00dfig F\u00fchrungen durch das Br\u00fcsseler Rathaus statt, die spannende Einblicke in die Reicht\u00fcmer des Interieurs gew\u00e4hren, das die Besucher immer wieder aufs Neue begeistert. \r\n\r\nDie Entstehung eines einzigartigen Geb\u00e4udes \r\n\r\nDer Bau des Rathauses erstreckte sich \u00fcber einen relativ langen Zeitraum und war das Werk mehrerer Architekten. Urspr\u00fcnglich bestand das Geb\u00e4ude nur aus einem Glockenturm und dem bis heute unver\u00e4nderten linken Geb\u00e4udefl\u00fcgel. Der Glockenturm hingegen wurde schon bald durch den heutigen Turm ersetzt, als sich die H\u00e4user der verschiedenen Handwerksz\u00fcnfte am Grand-Place niederlie\u00dfen. Um das Geb\u00e4ude noch harmonischer in das Stadtbild einzuf\u00fcgen, wurde ein zus\u00e4tzlicher Fl\u00fcgel auf der rechten Seite hinzugef\u00fcgt. \r\n\r\nAn der Spitze des neuen, mehr als 90 m hohen Turms  thront der Erzengel Michael, der Schutzpatron der Stadt Br\u00fcssel. Die vergoldete Kupferstatue dient eigentlich als Wetterfigur \u2013 und wenn der Wind g\u00fcnstig steht, k\u00f6nnen Sie beobachten, wie die die Engelsfigur den Drachen besiegt! \r\n\r\nDerzeit beherbergt dieses Kleinod des Br\u00fcsseler Architekturerbes das Tourismusb\u00fcro.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Municipio di Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Elegante edificio risalente al 15\u00b0 secolo, il municipio di Bruxelles si trova nel cuore del centro storico, nella sontuosa Grand-Place. \r\n\r\nSpesso considerato come l\u2019elemento centrale della piazza pi\u00f9 bella del mondo, \u00e8 probabilmente uno degli edifici pi\u00f9 belli del paese e sicuramente uno dei monumenti da non perdere quando si visita Bruxelles. La sua splendida torre funge da punto di riferimento sia per i turisti che per i belgi di passaggio nel centro della capitale. \r\n\r\nUna festa per gli occhi \r\n\r\nParticolarmente imponente per le sue dimensioni, le sue stupende decorazioni scolpite e la sua facciata asimmetrica, cattura rapidamente l\u2019attenzione. Passeggiando davanti a tale edificio prestigioso, \u00e8 possibile scorgere sui balconi gli sposi novelli intenti a festeggiare il loro matrimonio. \r\n\r\nVale la pena visitare anche gli interni del municipio. Suscitano la curiosit\u00e0 di chi desidera scoprire la disposizione e l\u2019arredamento delle varie sale di questo capolavoro architettonico. Vengono periodicamente organizzate visite guidate al municipio di Bruxelles durante le quali \u00e8 possibile ammirare la ricchezza degli interni che non smettono mai di affascinare i visitatori. \r\n\r\nL\u2019evoluzione di un edificio eccezionale \r\n\r\nLa sua costruzione avviene nel corso di un lungo periodo di tempo e vede l\u2019avvicendarsi di vari architetti. In origine, l\u2019edificio comprendeva solo una torre campanaria e la parte sinistra, rimasta identica fino ai nostri giorni. La torre campanaria \u00e8 stata invece sostituita rapidamente dalla torre attuale quando le case delle varie corporazioni sono state trasferite nella piazza. \u00c8 stata peraltro aggiunta un\u2019altra ala sulla destra per accogliere al meglio tali edifici in questa cornice dalla bellezza incomparabile. \r\n\r\nIn cima alla nuova torre, alta pi\u00f9 di 90 m, la guglia \u00e8 coronata da San Michele arcangelo, santo patrono della citt\u00e0 di Bruxelles. Tale raffigurazione in rame dorato funge in realt\u00e0 da segnavento. Se il vento soffia nella direzione giusta, avrete modo di ammirare per bene l\u2019eroe della citt\u00e0 che sconfigge il drago! \r\n\r\nQuesto gioiello del patrimonio di Bruxelles ospita attualmente l\u2019ufficio del Turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Ayuntamiento de Bruselas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"El elegante edificio del siglo XV del ayuntamiento de Bruselas se encuentra en el coraz\u00f3n del centro hist\u00f3rico de la ciudad, en la suntuosa Grand-Place. \r\n\r\nConsiderado a menudo como la pieza clave de la plaza m\u00e1s bella del mundo es probablemente uno de los edificios m\u00e1s hermosos del pa\u00eds y evidentemente uno de los monumentos que no debes perderte en tu visita a Bruselas. Su espl\u00e9ndida torre se alza como punto de referencia, tanto para los visitantes del d\u00eda como para los belgas que pasan por el centro de la capital. \r\n\r\nUn regalo para la vista \r\n\r\nEste monumento, imponente por sus dimensiones, sus adornos esculpidos y su fachada asim\u00e9trica, llama r\u00e1pidamente la atenci\u00f3n de los transe\u00fantes. No es extra\u00f1o que al pasear delante de este prestigioso edificio veas en los balcones a alguna pareja de reci\u00e9n casados celebrando su enlace en los balcones. \r\n\r\nEl interior del ayuntamiento tambi\u00e9n merece una visita. Despierta la curiosidad de quienes desean descubrir la disposici\u00f3n y dise\u00f1o de las salas de esta obra maestra arquitect\u00f3nica. Se organizan con regularidad visitas guiadas al ayuntamiento para descubrir la riqueza de su interior que fascina a los visitantes. \r\n\r\nLa evoluci\u00f3n de un edificio singular \r\n\r\nSu construcci\u00f3n abarc\u00f3 un largo periodo y cont\u00f3 con la direcci\u00f3n de varios arquitectos. En un principio, el edificio \u00fanicamente contaba con un campanario y la parte izquierda que se ha conservado intacta hasta el d\u00eda de hoy. El campanario fue r\u00e1pidamente sustituido por la torre actual, cuando las casas de los diferentes gremios se instalaron en la plaza. Asimismo, se a\u00f1adi\u00f3 un ala adicional en la parte derecha para integrar mejor los nuevos edificios en este incomparable decorado. \r\n\r\nEn la cima de la nueva torre, de m\u00e1s de 90 m de altura, el arc\u00e1ngel San Miguel, patr\u00f3n de la ciudad de Bruselas, corona la aguja. Esta estatua de cobre dorado sirve de veleta. Si el viento sopla a su favor, tendr\u00e1s la ocasi\u00f3n de admirar de la mejor forma \u00a1c\u00f3mo San Miguel vence al drag\u00f3n! \r\n\r\nActualmente, esta joya del patrimonio bruselense alberga la oficina de turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"C\u00e2mara Municipal de Bruxelas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"O edif\u00edcio da C\u00e2mara Municipal de Bruxelas \u00e9 uma obra de arte da arquitetura civil g\u00f3tica do s\u00e9culo XV. No s\u00e9culo XVIII, foi-lhe adicionada uma ala de estilo cl\u00e1ssico. As in\u00fameras salas competem entre si em aparato. S\u00e3o notavelmente ornamentadas por tape\u00e7arias excecionais que evocam epis\u00f3dios locais e nacionais da hist\u00f3ria belga. Exposi\u00e7\u00f5es ocupam pontualmente os espa\u00e7os.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":112,"location":{"lat":50.8466937,"lon":4.35252339},"region":"brussels","last_updated_at":"2022-07-18T17:05:11+02:00","published_at":"2013-10-19T01:13:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":277830,"translations":{"fr":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":37830,"location":{"lat":50.83580932,"lon":4.30313837},"region":"brussels","last_updated_at":"2022-07-18T17:05:11+02:00","published_at":"2022-02-27T07:00:16+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"video","link":"https:\/\/www.youtube.com\/watch?v=NXXsBpBfUY8","oEmbed_title":"Visite Bruxelles, Grand-Place, hotel de ville : le porche","oEmbed_author_name":"Visite Bruxelles","oEmbed_author_url":"https:\/\/www.youtube.com\/c\/VisiteBruxelles","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/NXXsBpBfUY8\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/NXXsBpBfUY8?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : le porche"},"nl":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : le porche"},"en":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : le porche"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/aa1492e09a81656a6aafff3a5c69903469f58d59.jpg","width":1080,"height":1920,"ratio":0.56,"translations":{"fr":{"title":"La Grand-Place de Bruxelles sous la loupe","copyright":null},"nl":{"title":"La Grand-Place de Bruxelles sous la loupe","copyright":null},"en":{"title":"La Grand-Place de Bruxelles sous la loupe","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/c2a736377bbeb1a27a86a2de970e904ace686489.jpg","width":1441,"height":1080,"ratio":1.33,"translations":{"fr":{"title":"La Grand-Place de Bruxelles sous la loupe","copyright":null},"nl":{"title":"La Grand-Place de Bruxelles sous la loupe","copyright":null},"en":{"title":"La Grand-Place de Bruxelles sous la loupe","copyright":null}}}],"dates":[{"day":"2022-05-08","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-06-12","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-07-03","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-11","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-18T17:05:12+02:00","published_at":"2022-03-03T11:54:41+01:00","backoffice_id":248899,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":528905,"date_start":"2022-04-10","date_end":"2022-09-18","date_next":"2022-09-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":"\u200bPourquoi la Grand-Place de Bruxelles fascine-t-elle tant ?\r\n\r\nCar elle est truff\u00e9e de symboles ! Apprenez \u00e0 en d\u00e9couvrir les sens, \u00e0 les interpr\u00e9ter et comprendre.","longdescr":"Que d'or, que de statues, quel foisonnement d'imageries diverses ... mais que se cache-t-il derri\u00e8re tout \u00e7a ? Pourquoi cet \u00e9clectisme, ces allusions \u00e0 la mythologie antique ou la franc-ma\u00e7onnerie, sur une place de march\u00e9 ?\r\nVisite Bruxelles vous propose de poser Un Autre Regard sur la Grand-Place, celui de son interpr\u00e9tation symbolique : pourquoi les constructeurs, et plus tard ses r\u00e9novateurs ont-ils b\u00e2ti \"\u00e7\u00e0-comme \u00e7a-l\u00e0-\u00e0 l'\u00e9poque\" ? Quelle image voulaient-ils v\u00e9hiculer, quels messages voulaient-ils faire passer ? ... une visite s\u00e9rieuse. Sans se prendre au s\u00e9rieux.\r\nLe tourisme. Autrement.\r\nProgramme de la visite : \r\n* observer, voir, regarder : immersion ! Prendre le temps de se plonger dans le lieu\r\n* Symbolisme de la Grand-Place : d'un march\u00e9 \u00e0 un lieu de pouvoirs pluriels, ou l'art de v\u00e9hiculer des messages par les pierres\r\n* analyse de fa\u00e7ades, mill\u00e9simes, cartouches et autres d\u00e9cors sous leur angle symbolique","performers":"Vincent Beckers, guide touristique et r\u00e9gional","boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528905.html"},"nl":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528905.html"},"en":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528905.html"},"de":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528905.html"},"it":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528905.html"},"sp":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528905.html"},"pt":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528905.html"},"cn":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528905.html"}},"place":{"id":475,"translations":{"fr":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Parmi tous, l'H\u00f4tel de Ville de Bruxelles est sans conteste l'un des plus majestueux du pays\u202f! Cet \u00e9difice, b\u00e2ti au 15e si\u00e8cle en style gothique, est sublim\u00e9 par le d\u00e9cor qu\u2019offre la Grand-Place, souvent qualifi\u00e9e de plus belle au monde... Vous admirerez la justesse de ses proportions, les innombrables sculptures qui ornent ses fa\u00e7ades, ou encore l\u2019\u00e9clat incomparable de sa tour, dont la fl\u00e8che supporte l'archange saint Michel, protecteur de la ville. Bruxelles posa la premi\u00e8re pierre du somptueux \u00e9difice en 1401. En 1695, lors du bombardement de la ville par les troupes de Louis XIV, l'H\u00f4tel de Ville fut incendi\u00e9, mais les murs et la tour resteront debout. Ses salles de r\u00e9ceptions et cabinets \u00e9chevinaux renferment de belles tapisseries bruxelloises des XVI\u00e8me, XVII\u00e8me et XVIII\u00e8me si\u00e8cles, de somptueuses boiseries gothiques, \u00e9cussons des anciennes corporations et tableaux des collections du mus\u00e9e de la ville. \r\n ","description_print":"18\/07\/2022\r\n\u00c9l\u00e9gant b\u00e2timent datant du 15\u00e8me si\u00e8cle, l\u2019H\u00f4tel de Ville de Bruxelles se situe au c\u0153ur du centre historique, sur la somptueuse Grand-Place.\r\nSouvent consid\u00e9r\u00e9 comme la pi\u00e8ce ma\u00eetresse de la plus belle place du monde, il est probablement l\u2019un des plus beaux \u00e9difices du pays et \u00e9videmment l\u2019un des monuments \u00e0 ne pas manquer lors de votre s\u00e9jour \u00e0 Bruxelles. Sa splendide tour se dresse tel un rep\u00e8re aussi bien pour les curieux d\u2019un jour que les belges de passage dans le centre de la capitale.\r\nUn r\u00e9gal pour les yeux\r\nParticuli\u00e8rement imposant par ses dimensions, ses remarquables d\u00e9cors sculpt\u00e9s et sa fa\u00e7ade asym\u00e9trique, il attire rapidement les regards. En vous promenant devant ce prestigieux b\u00e2timent, peut-\u00eatre que vous apercevrez aux balcons de jeunes mari\u00e9s c\u00e9l\u00e9brer leur union.\r\nL\u2019int\u00e9rieur de l\u2019H\u00f4tel de Ville vaut \u00e9galement le d\u00e9tour. Il attise la curiosit\u00e9 de ceux qui souhaitent d\u00e9couvrir la disposition et l\u2019am\u00e9nagement des diff\u00e9rentes salles de ce chef-d\u2019\u0153uvre architectural. Des visites guid\u00e9es de l\u2019H\u00f4tel de Ville de Bruxelles sont r\u00e9guli\u00e8rement organis\u00e9es afin de d\u00e9couvrir la richesse de cet int\u00e9rieur qui ne cesse d\u2019\u00e9blouir les visiteurs.\r\nL\u2019\u00e9volution d\u2019un b\u00e2timent singulier\r\nSa construction s'\u00e9tale sur une longue p\u00e9riode et voit d\u00e9filer plusieurs architectes. \u00c0 l\u2019origine, l\u2019\u00e9difice ne comptait qu\u2019un beffroi et la partie gauche qui elle est rest\u00e9e identique jusqu\u2019\u00e0 aujourd\u2019hui. Le beffroi, quant \u00e0 lui, est par contre rapidement remplac\u00e9 par la tour actuelle lorsque les maisons des diff\u00e9rentes corporations de m\u00e9tiers s\u2019installent sur la place. Une aile suppl\u00e9mentaire est \u00e9galement ajout\u00e9e sur la droite pour inclure au mieux ces immeubles dans cet incomparable d\u00e9cor.\r\nAu sommet de la nouvelle tour, haute de plus de 90m, la fl\u00e8che est couronn\u00e9e de l\u2019archange Saint-Michel, grand Patron de la ville de Bruxelles. Cette statue en cuivre dor\u00e9 sert en r\u00e9alit\u00e9 de girouette. Si les vents vous sont favorables, vous aurez l\u2019occasion de pouvoir admirer convenablement la mani\u00e8re dont cet embl\u00e8me vient \u00e0 bout du dragon !\r\nActuellement, ce joyau du patrimoine bruxellois abrite l\u2019office du Tourisme.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stadhuis Brussel","address_street_name":"Grote Markt","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"Als je het ons vraagt, is het stadhuis van Brussel is een van de meest majestueuze van het land! Dit gebouw op de Grote Markt, een van de mooiste pleinen ter wereld, werd ontworpen in de 15e eeuw in gotische stijl. Ontelbare beeldhouwwerken sieren de gevels, en op de toren prijkt de aartsengel Sint-Michiel, de beschermer van de stad. Brussel legde de eerste steen van het weelderige gebouw in 1401. In 1695, tijdens een bombardement door de troepen van Lodewijk XIV, werd het stadhuis in brand gestoken, maar de muren en de toren bleven overeind. In de ontvangstzalen en de schepenkamers bevinden zich prachtige Brusselse wandtapijten uit de 16e, 17e en 18e eeuw, weelderig gotisch houtwerk, wapenschilden van de oude gilden en schilderijen uit de collecties van het stedelijk museum. ","description_print":"18\/07\/2022\r\nHet elegante stadhuis van Brussel dateert uit de 15de eeuw en ligt in het historische hart van de stad, op de prachtige Grote Markt. \r\n\r\nHet wordt vaak beschouwd als het absolute pronkstuk van het mooiste plein ter wereld en is wellicht een van de mooiste gebouwen van het land. Het is dan ook een niet te missen monument tijdens je bezoek aan Brussel. Zijn prachtige toren is een herkenningspunt voor zowel de dagjestoeristen als de Belgen die door het stadscentrum kuieren. \r\nEen lust voor het oog \r\nNiet alleen de indrukwekkende afmetingen van het gebouw, maar ook de opmerkelijke gebeeldhouwde ornamenten en de asymmetrische gevel trekken meteen de aandacht. En terwijl je dit prestigieuze gebouw voorbij wandelt, word je misschien toegewuifd door een pasgetrouwd stel op het balkon ... \r\nHet interieur van het stadhuis is eveneens een omweg waard. Wie wil, kan een blik werpen op de indeling en de inrichting van de verschillende zalen van dit architecturale meesterwerk. Er worden regelmatig rondleidingen in het Brussels stadhuis georganiseerd om de rijkdom van het interieur aan de bezoekers te tonen. \r\nEvolutie van een uniek gebouw \r\nHet gebouw werd over een lange periode ontworpen door verschillende architecten. Oorspronkelijk bestond het enkel uit een belfort en het linkerdeel, dat ongewijzigd is gebleven. Het belfort daarentegen werd al snel vervangen door de huidige toren, toen de huizen van de verschillende gilden zich op de grote markt begonnen te vestigen. Aan de rechterkant werd een extra vleugel bijgebouwd, om deze gebouwen beter in dit unieke decor op te nemen. \r\nBovenaan de meer dan 90 meter hoge, nieuwe toren, werd de torenspits bekroond met aartsengel Micha\u00ebl, de beschermheilige van de stad Brussel. Het standbeeld in verguld koper doet in werkelijkheid dienst als windwijzer. Bij gunstige wind kan je zelfs zien hoe dit embleem de draak velt! \r\nMomenteel is de toeristische dienst ondergebracht in dit pronkstuk van het Brusselse erfgoed. ","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"City of Brussels Town Hall","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"Of all of the town halls in the country, the City of Brussels town hall is undoubtedly one of the most majestic! This Gothic building, built in the 15th century, is enhanced by its setting on the Grand-Place, often described as the most beautiful square in the world... Admire the accuracy of its proportions, the countless sculptures that adorn its facades and the incomparable brilliance of its tower, whose spire supports the archangel Saint Michael, the city's protector. This City of Brussels laid the first stone of the sumptuous building back in 1401. In 1695, during the bombardment of the city by Louis XIV's troops, the town hall was burned down, but the walls and the tower remained standing. Its reception rooms and aldermen's chambers contain beautiful Brussels tapestries from the 16th, 17th and 18th centuries, sumptuous Gothic woodwork, coats of arms of the old guilds and paintings from the City of Brussels museum's collections.","description_print":"18\/07\/2022\r\nAn elegant building dating back to the 15th century, the City of Brussels Town Hall is located in the heart of the historical centre, on the sumptuous Grand-Place.\r\nOften considered to be the centrepiece of the most beautiful square in the world, it is undoubtedly one of the most stunning buildings in Belgium and definitely one of the unmissable highlights of your stay in Brussels. Its splendid tower stands as a landmark both for day-trippers and Belgians passing through the centre of the capital.\r\n\r\nA feast for the eyes\r\nParticularly imposing due to its size, its remarkable sculpted decorations and its asymmetrical facade, it quickly catches the eye. Walking in front of this prestigious building, you might spot newlyweds celebrating their union on the balconies.\r\nThe Town Hall's interior is also well worth a visit. It attracts the curiosity of those who want to know more about the layout and arrangement of the different rooms of this architectural masterpiece. Guided tours of the City of Brussels Town Hall are regularly organised and let you discover the richness of this interior which never fails to dazzle its visitors.\r\n\r\nThe evolution of a unique building\r\nIts construction was spread out over a long period of time and is the work of several architects. Originally, the building had only a belfry and the left part of the building has remained the same until today. The belfry, on the other hand, was quickly replaced by the current tower when the houses of the various trade guilds moved into the square. An additional wing was also added on the right to better incorporate these buildings into this exceptional setting.\r\nAt the top of the new tower, more than 90m high, the spire is crowned with the Archangel Saint-Michel, the patron saint of the City of Brussels. This gilded copper statue is actually used as a weather vane. If the winds blow the right way, you can admire the city's hero as he defeats the dragon!\r\nThis jewel of Brussels' architectural heritage currently houses the Tourist Office.","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Rathaus Br\u00fcssel","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Rathaus ist ein elegantes Bauwerk aus dem 15. Jahrhundert, gelegen auf dem pr\u00e4chtigen Grand-Place im Herzen des historischen Stadtzentrums. \r\n\r\nEs gilt als das architektonische Meisterwerk eines der sch\u00f6nsten Pl\u00e4tze der Welt und z\u00e4hlt dar\u00fcber hinaus zu den wahrscheinlich eindrucksvollsten Bauwerken Belgiens, das Sie bei Ihrem Besuch in Br\u00fcssel unbedingt besichtigen sollten. Zu verfehlen ist es kaum, denn sein majest\u00e4tischer Turm ragt hoch in den Br\u00fcsseler Himmel hinein.  \r\n\r\nEin Augenschmaus \r\n\r\nInsbesondere seine imposanten Dimensionen, seine bemerkenswerten skulpturalen Verzierungen und seine asymmetrische Fassade fallen sofort ins Auge. Und wenn man Gl\u00fcck hat, kann man auf dem majest\u00e4tischen Balkon einen Blick auf ein frischgebackenes Brautpaar erhaschen. \r\n\r\nAuch das Innere des Rathauses ist einen Besuch wert, denn die Aufteilung und die Anordnung der verschiedenen S\u00e4le dieses architektonischen Meisterwerks sind absolut sehenswert. Es finden regelm\u00e4\u00dfig F\u00fchrungen durch das Br\u00fcsseler Rathaus statt, die spannende Einblicke in die Reicht\u00fcmer des Interieurs gew\u00e4hren, das die Besucher immer wieder aufs Neue begeistert. \r\n\r\nDie Entstehung eines einzigartigen Geb\u00e4udes \r\n\r\nDer Bau des Rathauses erstreckte sich \u00fcber einen relativ langen Zeitraum und war das Werk mehrerer Architekten. Urspr\u00fcnglich bestand das Geb\u00e4ude nur aus einem Glockenturm und dem bis heute unver\u00e4nderten linken Geb\u00e4udefl\u00fcgel. Der Glockenturm hingegen wurde schon bald durch den heutigen Turm ersetzt, als sich die H\u00e4user der verschiedenen Handwerksz\u00fcnfte am Grand-Place niederlie\u00dfen. Um das Geb\u00e4ude noch harmonischer in das Stadtbild einzuf\u00fcgen, wurde ein zus\u00e4tzlicher Fl\u00fcgel auf der rechten Seite hinzugef\u00fcgt. \r\n\r\nAn der Spitze des neuen, mehr als 90 m hohen Turms  thront der Erzengel Michael, der Schutzpatron der Stadt Br\u00fcssel. Die vergoldete Kupferstatue dient eigentlich als Wetterfigur \u2013 und wenn der Wind g\u00fcnstig steht, k\u00f6nnen Sie beobachten, wie die die Engelsfigur den Drachen besiegt! \r\n\r\nDerzeit beherbergt dieses Kleinod des Br\u00fcsseler Architekturerbes das Tourismusb\u00fcro.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Municipio di Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Elegante edificio risalente al 15\u00b0 secolo, il municipio di Bruxelles si trova nel cuore del centro storico, nella sontuosa Grand-Place. \r\n\r\nSpesso considerato come l\u2019elemento centrale della piazza pi\u00f9 bella del mondo, \u00e8 probabilmente uno degli edifici pi\u00f9 belli del paese e sicuramente uno dei monumenti da non perdere quando si visita Bruxelles. La sua splendida torre funge da punto di riferimento sia per i turisti che per i belgi di passaggio nel centro della capitale. \r\n\r\nUna festa per gli occhi \r\n\r\nParticolarmente imponente per le sue dimensioni, le sue stupende decorazioni scolpite e la sua facciata asimmetrica, cattura rapidamente l\u2019attenzione. Passeggiando davanti a tale edificio prestigioso, \u00e8 possibile scorgere sui balconi gli sposi novelli intenti a festeggiare il loro matrimonio. \r\n\r\nVale la pena visitare anche gli interni del municipio. Suscitano la curiosit\u00e0 di chi desidera scoprire la disposizione e l\u2019arredamento delle varie sale di questo capolavoro architettonico. Vengono periodicamente organizzate visite guidate al municipio di Bruxelles durante le quali \u00e8 possibile ammirare la ricchezza degli interni che non smettono mai di affascinare i visitatori. \r\n\r\nL\u2019evoluzione di un edificio eccezionale \r\n\r\nLa sua costruzione avviene nel corso di un lungo periodo di tempo e vede l\u2019avvicendarsi di vari architetti. In origine, l\u2019edificio comprendeva solo una torre campanaria e la parte sinistra, rimasta identica fino ai nostri giorni. La torre campanaria \u00e8 stata invece sostituita rapidamente dalla torre attuale quando le case delle varie corporazioni sono state trasferite nella piazza. \u00c8 stata peraltro aggiunta un\u2019altra ala sulla destra per accogliere al meglio tali edifici in questa cornice dalla bellezza incomparabile. \r\n\r\nIn cima alla nuova torre, alta pi\u00f9 di 90 m, la guglia \u00e8 coronata da San Michele arcangelo, santo patrono della citt\u00e0 di Bruxelles. Tale raffigurazione in rame dorato funge in realt\u00e0 da segnavento. Se il vento soffia nella direzione giusta, avrete modo di ammirare per bene l\u2019eroe della citt\u00e0 che sconfigge il drago! \r\n\r\nQuesto gioiello del patrimonio di Bruxelles ospita attualmente l\u2019ufficio del Turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Ayuntamiento de Bruselas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"El elegante edificio del siglo XV del ayuntamiento de Bruselas se encuentra en el coraz\u00f3n del centro hist\u00f3rico de la ciudad, en la suntuosa Grand-Place. \r\n\r\nConsiderado a menudo como la pieza clave de la plaza m\u00e1s bella del mundo es probablemente uno de los edificios m\u00e1s hermosos del pa\u00eds y evidentemente uno de los monumentos que no debes perderte en tu visita a Bruselas. Su espl\u00e9ndida torre se alza como punto de referencia, tanto para los visitantes del d\u00eda como para los belgas que pasan por el centro de la capital. \r\n\r\nUn regalo para la vista \r\n\r\nEste monumento, imponente por sus dimensiones, sus adornos esculpidos y su fachada asim\u00e9trica, llama r\u00e1pidamente la atenci\u00f3n de los transe\u00fantes. No es extra\u00f1o que al pasear delante de este prestigioso edificio veas en los balcones a alguna pareja de reci\u00e9n casados celebrando su enlace en los balcones. \r\n\r\nEl interior del ayuntamiento tambi\u00e9n merece una visita. Despierta la curiosidad de quienes desean descubrir la disposici\u00f3n y dise\u00f1o de las salas de esta obra maestra arquitect\u00f3nica. Se organizan con regularidad visitas guiadas al ayuntamiento para descubrir la riqueza de su interior que fascina a los visitantes. \r\n\r\nLa evoluci\u00f3n de un edificio singular \r\n\r\nSu construcci\u00f3n abarc\u00f3 un largo periodo y cont\u00f3 con la direcci\u00f3n de varios arquitectos. En un principio, el edificio \u00fanicamente contaba con un campanario y la parte izquierda que se ha conservado intacta hasta el d\u00eda de hoy. El campanario fue r\u00e1pidamente sustituido por la torre actual, cuando las casas de los diferentes gremios se instalaron en la plaza. Asimismo, se a\u00f1adi\u00f3 un ala adicional en la parte derecha para integrar mejor los nuevos edificios en este incomparable decorado. \r\n\r\nEn la cima de la nueva torre, de m\u00e1s de 90 m de altura, el arc\u00e1ngel San Miguel, patr\u00f3n de la ciudad de Bruselas, corona la aguja. Esta estatua de cobre dorado sirve de veleta. Si el viento sopla a su favor, tendr\u00e1s la ocasi\u00f3n de admirar de la mejor forma \u00a1c\u00f3mo San Miguel vence al drag\u00f3n! \r\n\r\nActualmente, esta joya del patrimonio bruselense alberga la oficina de turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"C\u00e2mara Municipal de Bruxelas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"O edif\u00edcio da C\u00e2mara Municipal de Bruxelas \u00e9 uma obra de arte da arquitetura civil g\u00f3tica do s\u00e9culo XV. No s\u00e9culo XVIII, foi-lhe adicionada uma ala de estilo cl\u00e1ssico. As in\u00fameras salas competem entre si em aparato. S\u00e3o notavelmente ornamentadas por tape\u00e7arias excecionais que evocam epis\u00f3dios locais e nacionais da hist\u00f3ria belga. Exposi\u00e7\u00f5es ocupam pontualmente os espa\u00e7os.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":112,"location":{"lat":50.8466937,"lon":4.35252339},"region":"brussels","last_updated_at":"2022-07-18T17:05:12+02:00","published_at":"2013-10-19T01:13:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":277830,"translations":{"fr":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address