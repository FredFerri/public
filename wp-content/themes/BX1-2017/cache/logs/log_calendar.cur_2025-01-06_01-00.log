ry","address_street_name":"Waterloosesteenweg","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@micheleschoonjansgallery.be","website":"http:\/\/www.micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Waterloosesteenweg, 690 \/ Rivoli #25","address_line2":"1180 Ukkel","description_web":null,"description_print":null,"booking_url":null,"sort_order":"Schoonjans","virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"gallery","facebook_id":null,"backoffice_id":35036,"location":{"lat":50.8159035,"lon":4.3671602},"region":"brussels","last_updated_at":"2024-12-20T15:59:45+01:00","published_at":"2020-01-19T15:33:19+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":275036,"translations":{"de":{"name":"SchoonjanS&Vandenbussche Gallery","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@msgallery.be","website":"www.micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 690 \/ Rivoli #25","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"SchoonjanS&Vandenbussche Gallery","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@msgallery.be","website":"www.micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 690 \/ Rivoli #25","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Mich\u00e8le Schoonjans Gallery","address_street_name":"Waterloosesteenweg","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@msgallery.be","website":"www.micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Waterloosesteenweg, 690 \/ Rivoli #25","address_line2":"1180 Uccle","description_web":"Since 2021, Mich\u00e8le Schoonjans Gallery has been exhibiting emerging and established artists in its Brussels space, located in an emblematic 70s building in the Uccle district. The gallery presents several generations of Belgian and international artists, whose main mediums are painting, drawing and photography. The emphasis is on sensitive artistic research, rooted in a materiality that encourages contemplation and slowness. The configuration of the gallery space provides an atypical setting for artists to experiment with a certain proximity to the work, while exploring their own limits in the creative process. The gallery tends to specialise in the study of light, exploring the notion of habitats and landscapes, and the narrative character that flows from them.\n\nIn 2024, to improve the exhibition space and have the possibility to better present the artists' work, the gallery expanded. This move is part of a wider plan of Mich\u00e8le Schoonjans and Frans Brouwer to support and promote artists to established cultural institutions in Belgium and abroad, notably through participation in local and international art fairs since 2023.\n\nThe gallery is a member of the BUP ((Belgische Vereniging van Moderne en Hedendaagse Kunstgaleries in Dutch, the association of Belgian modern and contemporary art galleries), which pursues the same objectives as the FEAGA (Federation of European Art Galleries Associations).","description_print":null,"booking_url":null,"sort_order":"Schoonjans","virtual_visit":null,"visit_url":null},"it":{"name":"SchoonjanS&Vandenbussche Gallery","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@msgallery.be","website":"www.micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 690 \/ Rivoli #25","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"SchoonjanS&Vandenbussche Gallery","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@msgallery.be","website":"www.micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 690 \/ Rivoli #25","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mich\u00e8le Schoonjans Gallery","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@msgallery.be","website":"www.micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 690 \/ Rivoli #25","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":"Schoonjans","virtual_visit":null,"visit_url":null},"sp":{"name":"SchoonjanS&Vandenbussche Gallery","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@msgallery.be