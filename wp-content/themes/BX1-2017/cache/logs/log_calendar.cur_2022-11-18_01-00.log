:"16:00:00"}],"recurring":[{"day":"saturday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"14:00:00","time_end":"16:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier samedis du mois de 14:00 \u00e0 16:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zaterdags van de maand van 14:00 tot 16:00","en":"Open the first, second, third, fourth and last saturdays of the month from 14:00 to 16:00"}}],"closing_days":["2022-03-11","2022-03-12","2022-03-13","2022-03-14","2022-03-15"],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[16,5,19,11,7,8,12,10],"translations":{"fr":["Ecoles","Enfants 9-12 ans","Enseignants","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","LGTBQIA","Seniors"],"nl":["Scholen","Kinderen 9-12 j.","Leerkrachten","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","LGTBQIA","Senioren"],"en":["Schools","Children 9-12 yr.","Teachers","Family","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors"]}},"educational_targets":{"list":[3,6,7,8,9],"translations":{"fr":["Secondaire","10 - 12 ans","12 - 14 ans","14 - 16 ans","16 - 18 ans"],"nl":["Secundair onderwijs","10 - 12 jaar","12 - 14 jaar","14 - 16 jaar","16 - 18 jaar"],"en":["Secondary school","10 - 12 years","12 - 14 years","14 - 16 years","16 - 18 years"]}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"],"de":["Jugendstil & Art d\u00e9co"]}},"tags":["kids"],"accessibilities":{"list":[255,261,263],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-13T01:06:02+01:00","published_at":"2021-03-04T11:38:08+01:00","backoffice_id":229506,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.082793841186299},{"id":536673,"date_start":"2022-11-20","date_end":"2022-11-20","date_next":"2022-11-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"],"de":["Pop, Rock, Jazz...","Pop, Rock"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Alexander 23 - Danny Dwyer","shortdescr":"Afterschock Tour","longdescr":"Originaire de Chicago, Alexander Glantz est la force cr\u00e9ative derri\u00e8re Alexander 23. C\u2019est en mars 2019 que le jeune homme fait ses d\u00e9buts avec \u00ab Dirty AF1s \u00bb, un morceau qui conna\u00eet un succ\u00e8s fulgurant et se hisse au sommet des charts DSP. Quelques mois plus tard, il sort son premier EP \u00ab I'm Sorry I Love You \u00bb, salu\u00e9 par la critique, et passe le reste de l'ann\u00e9e 2019 en tourn\u00e9e avec Alec Benjamin et Omar Apollo tout en faisant ses d\u00e9buts \u00e0 Lollapalooza. L\u2019ann\u00e9e 2020 est marqu\u00e9e par la sortie de \u00ab IDK You Yet \u00bb (\u00e9crit et produit par ses soins) qui cumule \u00e0 l\u2019heure actuelle plus de 350 millions d\u2019\u00e9coutes sur Spotify. En 2021, Alexander 23 a fait salle comble pour sa premi\u00e8re tourn\u00e9e en t\u00eate d'affiche et a encha\u00een\u00e9 avec une nomination aux Grammy Awards pour sa coproduction sur \u00ab good 4 u \u00bb d'Olivia Rodrigo. On attend avec impatience son premier album coproduit par Dan Nigro, pr\u00e9vu pour cet \u00e9t\u00e9.\r\n\r\nDANNY DWYER\r\nTout a commenc\u00e9 par un accident de moto-cross \u00e0 l'adolescence. Des jambes br\u00fbl\u00e9es et des os meurtris ont fait d\u00e9vier ses ambitions pour les X-Games, mais les anges gardiens avaient d'autres plans. L'artiste-producteur du Midwest, qui n'\u00e9tait alors qu'un d\u00e9linquant juv\u00e9nile avec un nouveau trou \u00e0 remplir sur sa liste de choses \u00e0 faire, a d\u00e9couvert une guitare poussi\u00e9reuse dans la chambre de son grand fr\u00e8re. Les tablatures de \u00ab The Hell Song \u00bb de Sum 41 sont entr\u00e9es dans la m\u00e9moire musculaire \u00e0 long terme et ont enfonc\u00e9 une porte ouverte. Apr\u00e8s avoir accumul\u00e9 les streams \u00e0 l'\u00e9poque de l'\u00e2ge d'or de SoundCloud, ses oreilles \u00e0 l'aff\u00fbt lui ont valu l'attention de la grande ligue (un gros contrat de pub) et un aller simple pour Hollywood. L\u00e0, il s'est install\u00e9 dans un loft du centre-ville et a mis son esprit de savant fou au service de tous les logiciels et instruments \u00e0 port\u00e9e de main.\r\n\r\nDepuis, chaque chanson est une poup\u00e9e gigogne remplie d'\u0153ufs de P\u00e2ques \u00e0 moiti\u00e9 cach\u00e9s. Tr\u00e8s vite, n'importe quel genre est \u00e0 sa port\u00e9e, mais le talent mall\u00e9able est facilement d\u00e9voy\u00e9. La passion instinctive de Danny s'est \u00e9rod\u00e9e, les costumes de studio ont d\u00e9vi\u00e9 sa boussole cr\u00e9ative. Les superstitions ont sabot\u00e9 la logique. Les interactions sociales sont devenues des preuves dans une toile de conspiration. Pendant tout ce temps, il s'est retrouv\u00e9 coinc\u00e9 dans un tiraillement mental entre son foyer, les sir\u00e8nes de la capitale et les d\u00e9ceptions in\u00e9vitables. La musique, qui a toujours \u00e9t\u00e9 une b\u00e9quille, lui semblait \u00e9trang\u00e8re. Voici Danny Dwyer!","performers":"Alexander 23 - Danny Dwyer","boxoffice_url":null,"website":"http:\/\/www.botanique.be","email":"info@botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536673"},"nl":{"name":"Alexander 23 - Danny Dwyer","shortdescr":"Afterschock Tour","longdescr":"The hardest part is niet bezwijken voor de charmes van Alexander 23, een jonge, opkomende singer-songwriter die zijn hart te grabbel legt in zijn breekbare nummers. De Amerikaan brak door met 'Dirty AF1s' en bleef sindsdien stevig bouwen aan zijn carri\u00e8re. Met zijn eerste ep 'I'm sorry I love you' mocht hij toeren aan de zijde van Alec Benjamin, Omar Apollo en, hier in Botanique, Lolo Zoua\u00ef. In 2020 verscheen Alexanders zelf geschreven en zelf geproduceerde 'IDK you yet', een nummer dat intussen meer dan 350 miljoen streams op Spotify telt. Het was het begin van een volgende stroomversnelling in de carri\u00e8re van de jongeman. Die leidde hem richting een Grammy-nominatie voor zijn werk als co-producer van 'good 4 u', de wereldhit van Olivia Rodrigo. Alexander 23 werkt nu met diens andere producer, Dan Nigro (Conan Gray, Caroline Polachek), aan een debuutalbum, dat deze zomer zal verschijnen. De verwachtingen zijn alvast erg hoog gespannen!","performers":"Alexander 23 - Danny Dwyer","boxoffice_url":null,"website":"http:\/\/www.botanique.be","email":"info@botanique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.536673"},"en":{"name":"Alexander 23 - Danny Dwyer","shortdescr":"Afterschock Tour","longdescr":"Chicago native Alexander Glantz is the creative force behind Alexander 23. In March 2019, he made his debut with \"Dirty AF1s,\" which climbed to the top of the DSP charts. Later in the fall, he shared his debut, critically-acclaimed EP I'm Sorry I Love You and spent the rest of 2019 on tour with Alec Benjamin and Omar Apollo while making his Lollapalooza debut. He kicked off 2020 by selling out his debut two headline shows at The Moroccan Lounge and then releasing his RIAA Gold Certified Track \"IDK You Yet\" (written and produced solely by him) which was featured on Spotify's Today's Top Hits and has been streamed over 300 million times on Spotify alone.In 2021, Alexander 23 sold out his debut headline tour and followed that up with a Grammy Nomination for his co-production on \"good 4 u\" by Olivia Rodrigo. His Dan Nigro co-produced debut album is slated to arrive in the spring of 2022.\r\n\r\nDANNY DWYER\r\nIt  all  started with a dirt bike incident as a teen. Burned legs and bruised bones knocked his X-Games ambitions off course, but guardian angels had other plans. The Midwest artist-producer, then just a juvenile delinquent with anew hole to fill on his bucket list, discovered a dusty guitar in his big brother\u2019s room. The tabs for \u201cThe Hell Song\u201d by Sum 41 entered long-term  muscle  memory  and  blew  the  door  wide  open.  He  proceeded  to  make  Ye  look second-string for only making five beats a day for three summers, trading homework for all nighters with Ableton.After racking up streams during SoundCloud\u2019s golden era, his heat-seeking ears brought him big league attention (a major pub deal) and a one-way ticket to Hollywood. There he holed  up  in  a  downtown  loft  and  threw  his  mad  scientist  mind  at  every  DAW  and instrument  within  striking  distance.  Each  song  since  has  been  a  nesting  doll  filled  with half-hidden easter eggs and something new to holler along to. Soon enough, any given genre was  at  his  beck  and  call,  but  malleable  talent  is  easily  misguided.  Danny\u2019s instinctual  passion  eroded,  studio  suits  deviating  his  creative  compass.  Superstitions sabotaged logic. Social interactions became proof-points in a web of conspiracy. All this while he found himself stuck in a mental tug-of-war between home sweet home, the siren sounds of entertainment\u2019s capital, and the letdowns inevitably encountered after reuniting with either. Music, forever a crutch, felt foreign. This is Danny Dwyer","performers":"Alexander 23 - Danny Dwyer","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.536673"},"de":{"name":"Alexander 23","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.536673"},"it":{"name":"Alexander 23","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.536673"},"sp":{"name":"Alexander 23","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.536673"},"pt":{"name":"Alexander 23","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.536673"},"cn":{"name":"Alexander 23","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.536673"}},"place":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"L\u2019\u00e9l\u00e9gant Centre Culturel de la Communaut\u00e9 fran\u00e7aise est joliment situ\u00e9 dans les anciens jardins botaniques pr\u00e8s de la petite ceinture de Bruxelles. Vous pouvez assister \u00e0 des concerts dans les espaces intimes \u00e0 l\u2019ambiance chaleureuse, dont  les plus connus sont l\u2019Orangerie, la Rotonde, le Mus\u00e9e et le Witloof Bar. \r\n\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"nl":{"name":"Botanique","address_street_name":"Koningsstraat","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Koningsstraat, 236","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"In de voormalige botanische tuinen aan de kleine ring, thans het klassevolle cultuurcentrum van de Franse Gemeenschap, is het goed toeven. Concerten vinden er plaats op een unieke locatie, in sfeervolle en intieme ruimtes. De kwalitatieve eclectische programmatie staat zeer open voor nieuwe trends.","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"en":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The former botanical gardens provide the unique location for the stylish cultural centre of the French community and are a great place to relax. Concerts are held in the intimate surroundings of its eight spaces and multipurpose halls, of which the most famous are the Orangerie, the Rotonde, the Museum, and the Witloof Bar.\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"de":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le Botanique z\u00e4hlt ohne Zweifel zu den sch\u00f6nsten und spektakul\u00e4rsten Veranstaltungsorten Br\u00fcssels. Das von 1826 bis 1829 von der \u201eSoci\u00e9t\u00e9 Royale d'Horticulture\u201c erbaute, ehemalige Gew\u00e4chshaus im neoklassizistischen Stil mit Eisen- und Glasarchitektur beherbergt seit 1984 einen hochkar\u00e4tigen Veranstaltungsort.\r\n\r\nInmitten des botanischen Gartens von Saint-Josse-ten-Noode, einer der 19 Br\u00fcsseler Gemeinden, w\u00e4chst und gedeiht heute ein quicklebendiger Ort der Kultur, der vor allem f\u00fcr Musikveranstaltungen, als Galerie und Caf\u00e9 genutzt wird. H\u00f6hepunkt des Jahres bildet im Fr\u00fchling das Musikfestival \u201eLes Nuits Botaniques\".","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Questo grande edificio, che doveva ospitare le collezioni di un precedente giardino botanico, \u00e8 stato costruito fra il 1826 ed il 1829. L'artista-arredatore Pierre-Fran\u00e7ois Gineste diresse i lavori secondo progetto dell'architetto Tilman-Fran\u00e7ois Suys. Rispettando la struttura tradizionale degli aranceti, ha immaginato un'imponente cupola rotonda centrale, affiancata da due ali ciascuna delle quali terminante in un padiglione leggermente sporgente. Grazie alla sua regolarit\u00e0 e semplicit\u00e0, la costruzione illustra perfettamente i principi dello stile neoclassico. Alle vetrate che riempiono gli spazi tra le colonne della sala circolare e che coprono il portico delimitato dal colonnato stesso, si aggiungono le serre adiacenti alle ali laterali. Inizialmente si era pensato di organizzare feste all'interno di questo ambiente magico, e a questo scopo venne allestita una grande sala fra l'aranceto orientale e la sala rotonda, ma questa diventer\u00e0 poi la sala degli erbari dal 1870. Fino al 1939, l'edificio verr\u00e0 utilizzato per il suo scopo originale. Riacquistato dallo Stato nel 1970, il locale diventer\u00e0 il Centro Culturale della Federazione Vallonia-Bruxelles e verr\u00e0 inaugurato come tale nel 1984. Oggi ospita numerosi eventi culturali dedicati all'arte contemporanea e vi si svolgono festival, tra i quali il famoso Nuits du Botanique, che hanno contribuito ad affermare la sua reputazione. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Este enorme edificio, pensado para albergar las colecciones de un antiguo jard\u00edn bot\u00e1nico, fue construido entre 1826 y 1829. El artista-decorador Pierre-Fran\u00e7ois Gineste dirigi\u00f3 las obras a partir de los planos del arquitecto Tilman-Fran\u00e7ois Suys. Respetando la estructura tradicional de los invernaderos de naranjas, imagin\u00f3 una imponente rotonda central con c\u00fapula flanqueada por dos pasillos que terminaban en un pabell\u00f3n ligeramente en relieve. Gracias a su regularidad y simplicidad, la elevaci\u00f3n ilustra a la perfecci\u00f3n los principios del estilo neocl\u00e1sico. Las vidrieras situadas en los intercolumnios de la rotonda y que cubren el p\u00f3rtico delimitado por esta misma columnata se suman a los invernaderos adosados a los pasillos laterales. Pronto se pens\u00f3 en organizar fiestas en este lugar m\u00e1gico, para lo cual se acondicion\u00f3 una sala entre el invernadero de naranjas oriental y la rotonda, pero a partir de 1870 se convirti\u00f3 en la sala de los herbarios. Hasta 1939 cumpli\u00f3 las funciones teniendo en cuenta su vocaci\u00f3n inicial. Recomprado por el Estado en 1970, el lugar se convirti\u00f3 en el centro cultural de la Federaci\u00f3n Valonia-Bruselas y se inaugur\u00f3 como tal en 1984. A d\u00eda de hoy este lugar alberga numerosas manifestaciones culturales dedicadas a la creaci\u00f3n contempor\u00e1nea y se ha vuelto prestigioso por los festivales que se celebran en \u00e9l, tales como las \u00abNoches del bot\u00e1nico\u00bb. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"addre