on_state":"public","last_updated_at":"2022-04-07T04:35:03+02:00","published_at":"2022-04-07T03:30:14+02:00","backoffice_id":250989,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":0.19842513149602},{"id":532017,"date_start":"2022-05-21","date_end":"2022-05-21","date_next":"2022-05-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{"list":[85],"translations":{"fr":["Portes ouvertes"],"nl":["Opendeurdag"],"en":["Open door"]}}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Weekend festif au Logis-Flor\u00e9al: Inauguration oficielle du 100i\u00e8me anniversaire","shortdescr":"Le Logis-Flor\u00e9al c\u00e9l\u00e8bre ses cent ans ! Un week-end entier d'activit\u00e9s aura lieu dans les cit\u00e9s-jardins.","longdescr":"Le 100e anniversaire du Logis-Flor\u00e9al est l\u2019occasion de mettre \u00e0 l\u2019honneur les richesses et la diversit\u00e9 de nos cit\u00e9s-jardins et de favoriser la rencontre entre les habitants. De Mai 2022 \u00e0 Juin 2023 diff\u00e9rentes activit\u00e9s festives, sportives, conviviales et ludiques auront lieu. Il y en aura pour tous les go\u00fbts parce que 100 ans, \u00e7a se f\u00eate !\r\n\r\nDurant le weekend de l'inauguration vous pouvez participer \u00e0 des nombreuses activit\u00e9s:\r\n- une conf\u00e9rence et des tables rondes\r\n- une parcours des talents\r\n- un court-m\u00e9trage\r\n- La pi\u00e8ce de th\u00e9\u00e2tre 'Julie et Clovis'\r\n\r\nPendant l'inauguration officielle nous allons vous pr\u00e9senter le programme pour l'ann\u00e9e \u00e0 venir et vous laisser d\u00e9guster la bi\u00e8re sp\u00e9ciale 100i\u00e8me!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lelogisfloreal.be\/","email":"100ans@lelogisfloreal.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532017.html"},"nl":{"name":"Feestweekend in Le Logis-Flor\u00e9al: Offici\u00eble inhuldiging van de 100ste verjaardag","shortdescr":"Le Logis-Flor\u00e9al bestaat 100 jaar en dat mag gevierd worden. Een heel weekend lang vinden er in de tuinwijken heel wat activiteiten plaats.","longdescr":"De 100e verjaardag van Logis-Flor\u00e9al is een gelegenheid om de rijkdom en de diversiteit van onze tuinsteden in de verf te zetten en ontmoetingen tussen de inwoners aan te moedigen. Van mei 2022 tot juni 2023 zullen er diverse feestelijke, sportieve, gezellige en ludieke activiteiten plaatsvinden. Er zal voor elk wat wils zijn, want 100 jaar is iets om te vieren!\r\n\r\nTijdens het weekend van de inhuldiging kan je aan tal van activiteiten deelnemen:\r\n- een conferentie en rondetafelgesprekken\r\n- een talententraject\r\n- een kortfilm\r\n- het toneelstuk 'Julie et Clovis'.\r\n\r\nTijdens de offici\u00eble opening presenteren wij het programma voor het komende jaar en laten wij je het speciaalbier -speciaal gebrouwen voor de honderdste verjaardag van onze tuinwijken- proeven!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lelogisfloreal.be\/","email":"100ans@lelogisfloreal.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532017.html"},"en":{"name":"Weekend festif au Logis-Flor\u00e9al: Inauguration oficielle du 100i\u00e8me anniversaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532017.html"},"de":{"name":"Weekend festif au Logis-Flor\u00e9al: Inauguration oficielle du 100i\u00e8me anniversaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_