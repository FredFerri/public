ces de ses occupants ? Pourquoi ce b\u00e2timent imagin\u00e9 par Victor Horta \u00e9tait-il si moderne pour son \u00e9poque ? \r\n\r\nPour r\u00e9pondre \u00e0 toutes ces questions, il suffit de suivre les lignes. Celles qui dessinent au sol le plan de la maison, grimpent les marches, nous invitent \u00e0 franchir une porte, s'accrochent \u00e0 la structure et semblent se poursuivre d'un mat\u00e9riau \u00e0 l'autre.\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.classesdupatrimoine.brussels\/toutes-les-activites\/chez-van-eetvelde\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557122"},"sp":{"name":"Chez Van Eetvelde - \u00c0 la recherche des lignes et de leurs \u00e9chos dans les mat\u00e9riaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.classesdupatrimoine.brussels\/toutes-les-activites\/chez-van-eetvelde\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.557122"},"nl":{"name":"Chez Van Eetvelde - \u00c0 la recherche des lignes et de leurs \u00e9chos dans les mat\u00e9riaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.classesdupatrimoine.brussels\/toutes-les-activites\/chez-van-eetvelde\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557122"}},"place":{"id":265641,"translations":{"de":{"name":"Avenue Palmerston 4","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city"