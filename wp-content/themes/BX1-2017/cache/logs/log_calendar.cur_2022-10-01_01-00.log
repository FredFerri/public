8:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi et dimanche: ferm\u00e9","mardi, mercredi, jeudi, vendredi et samedi: de 11:00 \u00e0 18:00"],"nl":["maandag en zondag: gesloten","dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 11:00 tot 18:00"],"en":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"]},"date_start":"2022-09-30","date_end":"2022-10-29","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-09-29","start":"18:00:00","timestamp":"2022-09-29T18:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-27T17:05:04+02:00","published_at":"2022-09-27T15:57:40+02:00","backoffice_id":262697,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32182979486854},{"id":539394,"date_start":"2022-09-09","date_end":"2022-10-08","date_next":"2022-09-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"]}}},"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Christine Nicaise \" Ataraxia\"","shortdescr":"","longdescr":"Observer le travail de fond  de Christine Nicaise , c'est entrer dans le r\u00e8gne du continu, de l\u2019\u00e9pur\u00e9, de la patience, dans une sorte de temps donn\u00e9 au temps.  Quand l'\u2019artiste y  jette soudain un signe blanc ou noir , nous voyons soudain les extr\u00eames faire alliance. Le fond o\u00f9 tous les temps semblent contenus se confondent avec l\u2019espace alors que survient le trait dans toute sa nettet\u00e9, son \u00e9nergie  comme une sorte de promesse d\u2019un av\u00e8nement. Il est l\u2019imm\u00e9diatet\u00e9 et porte en lui la finitude de l\u2019\u00e9ph\u00e9m\u00e8re. Le signe que jette Christine Nicaise sur sa toile, reste illisible \u00e0 nos yeux. Il ne d\u00e9signe pas, n\u2019\u00e9nonce pas, n\u2019enferme pas. C\u2019est le signe absolu, qui jouit de l\u2019existence avant toute structuration, avant toute grammaire.","performers":"Christine Nicaise","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539394"},"nl":{"name":"Christine Nicaise \" Ataraxia\"","shortdescr":null,"longdescr":"Het werk van Christine Nicaise zou ons kunnen doen denken aan het Japanse concept\r\n\u00ab Wabi\/Sabi \u00bb, zo dierbaar aan Axel Vervoordt, waar kunst op respect voor de natuur en de verandering van de tijd gebaseerd is. Deze kenmerken zijn niet uniek voor Azi\u00eb. De kunstenares zegt dat ze zich nooit heeft laten inspireren door filosofie\u00ebn uit het Verre Oosten.\r\nAtaraxia is de titel van de tentoonstelling. Dit concept dateert uit het begin van onze westerse beschaving en wordt toegeschreven aan de Griekse filosoof Democritus. Hij pleit voor de rust van de ziel en de beheersing ervan door de exacte toe-eigening van de waarde van de dingen. Deze matiging leidt tot de harmonie van het bestaan.\r\nAls je kijk naar het werk van Christine Nicaise ,zie je dat  de achtergrond waar alle tijden ingesloten lijken, versmelt met de ruimte. Aan de andere kant, heeft de lijn in al zijn scherpte niet het geduld van de bodem, het is energie en komt voor als een soort belofte van een komst.\r\nHet bord dat Christine Nicaise op haar doek gooit, blijft voor onze ogen onleesbaar. Het wijst \r\nniet aan, stelt niet, beperkt niet. Het is het absolute teken, dat bestaat v\u00f3\u00f3r enige structurering, v\u00f3\u00f3r enige grammatica.","performers":null,"boxoffice_url":null,"website":null,"email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539394"},"en":{"name":"Christine Nicaise \" Ataraxia\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539394"},"de":{"name":"Christine Nicaise \" Ataraxia\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539394"},"it":{"name":"Christine Nicaise \" Ataraxia\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539394"},"sp":{"name":"Christine Nicaise \" Ataraxia\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539394"},"