,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":1922,"location":{"lat":50.83785217,"lon":4.3630838},"region":"brussels","last_updated_at":"2022-07-28T17:35:06+02:00","published_at":"2013-10-19T01:14:45+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/b1410e497dc28c751a92843415c879f8527ed8fa.jpg","width":1500,"height":1000,"ratio":1.5,"translations":{"fr":{"title":"Hide & Seek 2022: Guided Tour - Un quartier turc truff\u00e9 d\u2019art nouveau","copyright":"Muziekpublique"},"nl":{"title":"Hide & Seek 2022: Guided Tour - Un quartier turc truff\u00e9 d\u2019art nouveau","copyright":"Muziekpublique"},"en":{"title":"Hide & Seek 2022: Guided Tour - Un quartier turc truff\u00e9 d\u2019art nouveau","copyright":"Muziekpublique"}}}],"dates":[{"day":"2022-08-23","doors":null,"start":"16:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[12,10,8,7,19,11,5],"translations":{"fr":["LGTBQIA","Seniors","Jeunes 15-18 ans","Jeunes 12-15 ans","Enseignants","Famille","Enfants 9-12 ans"],"nl":["LGTBQIA","Senioren","Jongeren 15-18 j.","Jongeren 12-15 j.","Leerkrachten","Familie","Kinderen 9-12 j."],"en":["LGTBQIA","Seniors","Youth 15-18  yr.","Youth 12-15  yr.","Teachers","Family","Children 9-12 yr."]}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"]}},"tags":["exterior","kids"],"accessibilities":{"list":[252,256,257,259,263],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to people with intellectual disabilities","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-28T17:35:06+02:00","published_at":"2022-07-08T12:34:00+02:00","backoffice_id":258147,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1.2599210498949},{"id":537832,"date_start":"2022-08-23","date_end":"2022-08-23","date_next":"2022-08-23","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Hide & Seek 2022: Amel Sediri & Moufadhel Adhoum (Tunisia)","shortdescr":"Hide & Seek Festival: Traditional music in unexpected places in Brussels","longdescr":"Hide & Seek Festival, traditional world music in unexpected places in Brussels: https:\/\/miniurl.be\/r-45et\r\n\r\nSession 6.30pm: https:\/\/miniurl.be\/r-45f3\r\nSession 8.30pm: https:\/\/miniurl.be\/r-45f4\r\n\r\nLa maison Autrique est l\u2019une d\u2019est toutes premi\u00e8res maisons con\u00e7ues par l\u2019architecte Victor Horta, command\u00e9e par son ami et fr\u00e8re de loge Eug\u00e8ne Autrique. Apr\u00e8s avoir \u00e9t\u00e9 sur le march\u00e9 pendant des ann\u00e9es, cette petite perle a \u00e9t\u00e9 finalement \u00e9t\u00e9 achet\u00e9e en 1996 et r\u00e9nov\u00e9e par la commune de Schaerbeek sur l\u2019insistance du dessinateur Fran\u00e7ois Schuiten. On y retrouve quelques caract\u00e9ristiques typiques de Horta tels que l\u2019int\u00e9gration avec la rue, le m\u00e9lange de sym\u00e9trie avec des formes asym\u00e9triques, l\u2019utilisation pionni\u00e8re du m\u00e9tal etc. Ajoutez \u00e0 cela une d\u00e9coration mise en sc\u00e8ne par Fran\u00e7ois Schuiten et Beno\u00eet Peeters et vous obtiendrez un bel hommage \u00e0 l\u2019architecture priv\u00e9e bruxelloise.\r\n\r\nNous recevons dans ce cadre \u00e9vocateur les artistes tunisien.nes Amel Sediri et Moufadhel Adhoum. Issu.es du m\u00eame milieu musical, ce duo repr\u00e9sente une symbiose musicale remarquable entre la splendide voix d\u2019Amel Sediri, qui maitrise aussi bien le chant classique lyrique que le chant arabe. Elle ma\u00eetrise \u00e0 merveille la tradition des grandes divas telles que Oum Kalthoum, Fayruz etc. Elle est \u00e9galement une violoniste hors pairs, et marie voix et cordes avec \u00e9norm\u00e9ment d\u2019aisance. Moufadhel Adhoum, ma\u00eetre du oud, est l\u2019un des meilleurs joueurs de sa g\u00e9n\u00e9ration. Il dialogue entre m\u00e9lancolie et entrain, et accroche notre oreille au gr\u00e9 de ses cordes pinc\u00e9es. Ensemble, ils \u00e9voluent dans un univers enchanteur rempli de belles m\u00e9lodies arabo-orientales romantiques ou m\u00e9lancoliques subtilement harmonis\u00e9es et interpr\u00e9t\u00e9es avec gr\u00e2ce. Dans un r\u00e9pertoire arabo-andalou vari\u00e9 allant de l\u2019arabe classique aux chansons populaires, en passant par la musique arabe, turque et m\u00eame balkanique, ils font des \u00e9motions, des improvisations, des harmonies et du rythme leur terrain de jeu.\r\n\r\nTickets en vente \u00e0 partir du mardi 12 juillet \u00e0 10h30!","performers":"Amel Sediri: chant, violon\r\nMoufadhel Adhoum: oud","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537832.html"},"nl":{"name":"Hide & Seek 2022: Amel Sediri & Moufadhel Adhoum (Tunisia)","shortdescr":"Hide & Seek Festival: Traditional music in unexpected places in Brussels","longdescr":"Hide & Seek Festival, traditional world music in unexpected places in Brussels: https:\/\/miniurl.be\/r-45et\r\n\r\nSession 6.30pm: https:\/\/miniurl.be\/r-45f3\r\nSession 8.30pm: https:\/\/miniurl.be\/r-45f4\r\n\r\nHet Autrique huis is \u00e9\u00e9n van de eerste huizen van de hand van de beroemde art nouveau architect Victor Horta, dat hij in 1893 bouwde in opdracht van zijn vriend en logebroeder Eug\u00e8ne Autrique. Na jaren te koop te hebben gestaan wordt dit pareltje van architectuur in 1996 op aandringen van striptekenaar Fran\u00e7ois Schuiten aangekocht door de gemeente Schaarbeek. In het huis vindt men al enkele typische kenmerken van Horta: het begin van de integratie met de straat, muurbekleding van verschillende diktes, het samengaan van  symmetrie met asymmetrische vormen en het baanbrekend gebruik van metaal. Voeg daar een originele enscenering van Fran\u00e7ois Schuiten en Beno\u00eet Peeters aan toe waarbij het huis van de kelder tot de zolder ingericht werd en je krijgt een eerbetoon aan de Brusselse priv\u00e9-architectuur.\r\n\r\nIn deze tot de verbeelding sprekende setting ontvangen we de Tunesische muzikanten Amel Sediri en Moufadhel Adhoum. Met gelijkaardige muzikale achtergrond vertegenwoordigt dit duo een opmerkelijke muzikale symbiose tussen de prachtige stem van Amel Sediri, die zowel klassieke lyrische zang als Arabische zang beheerst in de traditie van de grote diva\u2019s zoals Oum Kalthoum, Fayruz,\u2026 en de pakkende oud van Moufadhel Adhoum, een meester van dit prachtige instrument, en een van de beste oud-spelers van zijn generatie. Sediri\u2019s stem glijdt niet alleen over de tokkelende snaren van de oud, ook op viool is ze een uitstekende sparringpartner van haar landgenoot. Samen bewegen ze in een betoverend universum vol met prachtige romantische of melancholische Arabisch-Oosterse melodie\u00ebn die subtiel geharmoniseerd en sierlijk vertolkt worden. In een gevarieerd Arabisch-Oosters repertoire gaande van klassiek Arabisch tot populaire liederen, Arabische, Turkse en zelfs Balkanmuziek, enz\u2026 spelen ze met emoties, improvisaties, harmonie\u00ebn en ritme.\r\n\r\nTickets te koop vanaf dinsdag 12 juli om 10u30!","performers":"Amel Sediri: zang, viool\r\nMoufadhel Adhoum: oud","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537832.html"},"en":{"name":"Hide & Seek 2022: Amel Sediri & Moufadhel Adhoum (Tunisia)","shortdescr":"Hide & Seek Festival: Traditional music in unexpected places in Brussels","longdescr":"Hide & Seek Festival, traditional world music in unexpected places in Brussels: https:\/\/miniurl.be\/r-45et\r\n\r\nSession 6.30pm: https:\/\/miniurl.be\/r-45f3\r\nSession 8.30pm: https:\/\/miniurl.be\/r-45f4\r\n\r\nOne of the first residences conceived by architect Victor Horta, the Autrique House was commissioned by his friend, and Free Mason brother, Eug\u00e8ne Autrique.  Thanks to the insistence of comic book artist Fran\u00e7ois Schuiten, this small pearl, which had been on the market for many years, was bought and renovated by the Municipality of Schaerbeek.  In it, you can find some of the characteristics typical of Victor Horta, such as its integration with the street, the mixture of symmetrical and asymmetrical forms, the pioneer usage of metal, etc.  With the decoration Fran\u00e7ois Schuiten and Beno\u00eet Peeters added to it, you obtain a beautiful homage to Brussels private architecture.\r\n\r\nIn this evocative setting we will welcome Tunisian artists Amel Sediri and Moufadhel Adhoum. The duo, of the same musical background, forms a remarkable musical symbiosis. Amel Sediri\u2019s splendid voice, which masters both classical and Arab song, abides by the tradition of great divas, such as Oum Kalthoum, Fayruz etc.  An exceptional violinist, she marries her voice and the chords with great ease.  Moufadhel Adhoum is one of his generation\u2019s best oud players.   He dialogues between melancholy and liveliness, enticing us to listen.  Together, both musicians evolve in an enchanted universe full of beautiful romantic or melancholic Arab-Oriental melodies, which they subtly harmonize and interpret with grace.  Their Arab-Andalusian repertoire varies, ranging from the classical Arab to popular songs, including Arab, Turkish and even Balkan pieces.  They create emotions through their improvisations, their harmonies and their rhythm.\r\n\r\nTickets on sale from Tuesday 12 July at 10.30 am!","performers":"Amel Sediri: vocals, violon\r\nMoufadhel Adhoum: oud","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537832.html"},"de":{"name":"Hide & Seek Festival 2022: Amel Sediri & Moufadhel Adhoum (Tunisia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/537832.html"},"it":{"name":"Hide & Seek Festival 2022: Amel Sediri & Moufadhel Adhoum (Tunisia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/537832.html"},"sp":{"name":"Hide & Seek Festival 2022: Amel Sediri & Moufadhel Adhoum (Tunisia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/537832.html"},"pt":{"name":"Hide & Seek Festival 2022: Amel Sediri & Moufadhel Adhoum (Tunisia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/537832.html"},"cn":{"name":"Hide & Seek Festival 2022: Amel Sediri & Moufadhel Adhoum (Tunisia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/537832.html"}},"place":{"id":241931,"translations":{"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaarbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Autrique House","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":null,"facebook_id":null,"backoffice_id":4383,"location":{"lat":50.86325398,"lon":4.37313664},"region":"brussels","last_updated_at":"2022-07-28T17:35:05+02:00","published_at":"2013-10-19T01:17:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique, keeps music and dance traditions alive and kicking in Brussels through an ambitious programme of concerts, courses, and projects. A year-round concert programme, featuring Belgian and international artists, forms the core of the foundation\u2019s activities. From the contemplative to the madly festive concerts take place indoors,  in the small Moli\u00e8re Theatre, in the arcade at the Porte de Namur and outdoors, around the city and throughout the year.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1