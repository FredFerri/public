":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"20 \/ 40 Voyage surr\u00e9aliste au centre de Bruxelles","shortdescr":"A l\u2019occasion des 20 ans du Mus\u00e9e d\u2019Art Fantastique et des 40 ans du Mus\u00e9e du Tram, vous pourrez d\u00e9couvrir l\u2019activit\u00e9 20 \/ 40 Voyage surr\u00e9aliste au centre de Bruxelles.","longdescr":"A l\u2019occasion des 20 ans du Mus\u00e9e d\u2019Art Fantastique et des 40 ans du Mus\u00e9e du Tram, vous pourrez d\u00e9couvrir l\u2019activit\u00e9 20 \/ 40 Voyage surr\u00e9aliste au centre de Bruxelles. Le dimanche 25 septembre, voyagez au sein d\u2019un ancien tramway depuis le Mus\u00e9e d\u2019Art Fantastique jusqu\u2019au Mus\u00e9e du Tram ou inversement et d\u00e9couvrez les collections uniques de ces deux institutions Bruxelloises. Caf\u00e9t\u00e9ria, boutique, exposition et autres surprises vous attendent. Le billet donne acc\u00e8s \u00e0 :\r\n\r\n    L\u2019entr\u00e9e au Mus\u00e9e d\u2019Art Fantastique et \u00e0 sa collection permanente\r\n\r\n    L\u2019entr\u00e9e au Centre d\u2019Art Fantastique et \u00e0 l\u2019exposition r\u00e9trospective Trolls & Bestioles\r\n\r\n    L\u2019entr\u00e9e au Mus\u00e9e du Tram et \u00e0 sa collection permanente\r\n\r\n    Un voyage au sein d\u2019un ancien tramway entre les deux mus\u00e9es\r\n\r\nR\u00e9servation obligatoire ici : https:\/\/www.billetweb.fr\/20-40-voyage-surrealiste-au-centre-de-bruxelles\r\n\r\nATTENTION ! Pour les horaires et conditions d'acc\u00e8s des voyages en tramway merci de vous r\u00e9f\u00e9rer \u00e0 la billetterie de l'\u00e9v\u00e9nement.","performers