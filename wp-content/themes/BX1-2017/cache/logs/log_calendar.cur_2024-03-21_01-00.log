w_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296106,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"foire","ranking":0.6933612743506347,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":70,"translations":{"de":"Messe & Ausstellung","pt":null,"en":"Fairs and shows","it":"Fiere ed esposizioni","cn":null,"fr":"Foire & salon","sp":"Feria y exhibici\u00f3n","nl":"Beurzen & salons"}},"others":{}},"translations":{"de":{"name":"Expo Bike Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"info@bike-brussels.be","phone_contact":"+32 9 241 55 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008199"},"pt":{"name":"Expo Bike Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"info@bike-brussels.be","phone_contact":"+32 9 241 55 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008199"},"en":{"name":"Expo Bike Brussels","shortdescr":"Discover, test & advice ! This is the motto of this 5th edition of Bike Brussels, that will take place in Tour & Taxis from Friday 22 to Sunday 24 March 2023.\n- 20.000 m2 dedicated to the urban bike\n- More than 120 exhibitors, information, advice & entertaining animations\n- Indoor & outdoor Test Tracks","longdescr":"Bike Brussels 2024 is the must-attend event for bicycle enthusiasts. This exhibition showcases urban bikes, travel bikes, and cargo bikes in all their forms. Whether you\u2019re young, not-so-young, or with your family, you\u2019ll find something to enjoy. \n\n* Exhibition Content:\n    * Discover: Explore all types of bicycles, from urban bikes to electric bikes, children\u2019s bikes, folding bikes, cargo bikes, longtails, and trailers.\n    * Try Out: Test these active mobility products on 3 test tracks for an authentic experience.\n    * Get Advice: Seek advice from Brussels cycling associations.\n    * Animations: Enjoy discovery rides, repair workshops, exhibitions, games, and performances.\n* Secure and Monitored Parking: Located at Picardstraat 3, at the entrance of Gare Maritime (No. 4 on the map) 12.\nFor more information, visit the Bike Brussels website. Come in large numbers and celebrate cycling!","performers":"With our partners: BRUXELLES MOBILIT\u00c9, SERVICE PUBLIC R\u00c9GIONAL DE BRUXELLES, GEWESTELIJKE, OVERHEIDSDIENST BRUSSEL, bruxelles environnement, brussel leefmilieu, BXL LA, VILLE DE STAD, visit.brussels, Beci, Brussels Life, VIVA CITE, TIPKIK, LE SOIR, BRUZZ, bx1, 7Dimanche, Vacancesweb, BRULOCALIS, GRACQ, Fietsersbond, Pro Velo, Les Ateliers de la rue Voot vzw \u2013 asbl. Thanks to everyone","boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/en\/","email":"info@bike-brussels.be","phone_contact":"+32 9 241 55 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008199"},"it":{"name":"Expo Bike Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"info@bike-brussels.be","phone_contact":"+32 9 241 55 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008199"},"cn":{"name":"Expo Bike Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"info@bike-brussels.be","phone_contact":"+32 9 241 55 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008199"},"fr":{"name":"Salon Bike Brussels","shortdescr":"D\u00e9couvrir, essayer et conseiller, tels sont les mots d\u2019ordre de cette 6e \u00e9dition du salon Bike Brussels qui aura lieu \u00e0 Tour & Taxis du vendredi 22 au dimanche 24 mars 2023.\n- 20.000 m2 consacr\u00e9s \u00e0 l\u2019urban bike\n- Plus de 120 exposants, informations, conseils & animations\n- Indoor & outdoor Test-Parcours\n","longdescr":"Bike Brussels 2024 est le rendez-vous incontournable pour les passionn\u00e9s de v\u00e9lo. Cette exposition met en avant le v\u00e9lo urbain, le v\u00e9lo de voyage et le v\u00e9lo cargo sous toutes leurs formes. Que vous soyez jeune, moins jeune ou en famille, vous y trouverez votre bonheur. \n\n* Contenu de l\u2019exposition :\n    * D\u00e9couvrir : Explorez tous les types de v\u00e9los, qu\u2019il s\u2019agisse de v\u00e9los urbains, de v\u00e9los \u00e9lectriques, de v\u00e9los pour enfants, pliants, cargos, longtails, ou encore de remorques.\n    * Essayer : Testez ces produits de mobilit\u00e9 active sur 3 pistes d\u2019essai pour une exp\u00e9rience authentique.\n    * Conseiller : Obtenez des conseils aupr\u00e8s des associations cyclistes bruxelloises.\n    * Animations : Amusez-vous avec des man\u00e8ges de d\u00e9couverte, des ateliers de r\u00e9paration, des expositions, des jeux et des spectacles.\n* Parking s\u00e9curis\u00e9 et surveill\u00e9 : Situ\u00e9 rue Picard 3, \u00e0 l\u2019entr\u00e9e de la Gare Maritime (n\u00b0 4 sur le plan) 12.\nPour plus d\u2019informations, visitez le site web de Bike Brussels. Venez nombreux et profitez de cette c\u00e9l\u00e9bration du v\u00e9lo !","performers":"Avec nos partenaires : BRUXELLES MOBILIT\u00c9, SERVICE PUBLIC R\u00c9GIONAL DE BRUXELLES, GEWESTELIJKE, OVERHEIDSDIENST BRUSSEL, bruxelles environnement, brussel leefmilieu, BXL LA, VILLE DE STAD, visit.brussels, Beci, Brussels Life, VIVA CITE, TIPKIK, LE SOIR, BRUZZ, bx1, 7Dimanche, Vacancesweb, BRULOCALIS, GRACQ, Fietsersbond, Pro Velo, Les Ateliers de la rue Voot vzw \u2013 asbl. Merci \u00e0 tous","boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"info@bike-brussels.be","phone_contact":"+32 9 241 55 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008199"},"sp":{"name":"Expo Bike Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"info@bike-brussels.be","phone_contact":"+32 9 241 55 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008199"},"nl":{"name":"Beurs Bike Brussels","shortdescr":"Ontdekken, testen en adviseren ! Dit is het motto van de 5 editie van de beurs Bike Brussels die zal plaatsvinden in Tour & Taxis van vrijdag 22 tot en met zondag 24 maart 2023.\n- 20.000 m2 gewijd aan de urban bike\n- Meer dan 120 exposanten, informatie, advies & animaties\n- Indoor & outdoor Test-Parcours","longdescr":"Bike Brussels 2024 is het niet te missen evenement voor fietsliefhebbers. Deze tentoonstelling zet stadsfietsen, reisfietsen en vrachtfietsen in al hun vormen in de schijnwerpers. Of je nu jong, minder jong of met je gezin bent, hier vind je zeker iets naar je zin. \n\n* Inhoud van de tentoonstelling:\n    * Ontdekken: Verken alle soorten fietsen, van stadsfietsen tot elektrische fietsen, kinderfietsen, vouwfietsen, cargofietsen, longtails en trailers.\n    * Uitproberen: Test deze actieve mobiliteitsproducten op 3 testbanen voor een authentieke ervaring.\n    * Advies krijgen: Haal advies bij Brusselse fietsverenigingen.\n    * Animaties: Geniet van ontdekkingsritten, reparatieworkshops, exposities, spelletjes en shows.\n* Veilige en bewaakte parkeergelegenheid: Gelegen aan de Picardstraat 3, bij de ingang van de Gare Maritime (nr. 4 op de plattegrond) 12.\nVoor meer informatie, bezoek de website van Bike Brussels. Kom in groten getale en geniet van dit fietsfeest! \n","performers":"Met onze partners : BRUXELLES MOBILIT\u00c9, SERVICE PUBLIC R\u00c9GIONAL DE BRUXELLES, GEWESTELIJKE, OVERHEIDSDIENST BRUSSEL, bruxelles environnement, brussel leefmilieu, BXL LA, VILLE DE STAD, visit.brussels, Beci, Brussels Life, VIVA CITE, TIPKIK, LE SOIR, BRUZZ, bx1, 7Dimanche, Vacancesweb, BRULOCALIS, GRACQ, Fietsersbond, Pro Velo, Les Ateliers de la rue Voot vzw \u2013 asbl. Dank aan iedereen","boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/nl\/","email":"info@bike-brussels.be","phone_contact":"+32 9 241 55 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008199"}},"place":{"id":50001290,"translations":{"de":{"name":"BIKE BRUSSELS EXPO","address_street_name":"Rue Picard","address_street_number":"9","address_street_box":null,"email":"info@bike-brussels.be","website":"https:\/\/www.bikebrussels.be\/fr\/","phone_contact":"+32 9 241 55 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 9","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"BIKE BRUSSELS EXPO","address_street_name":"Rue Picard","address_street_number":"9","address_street_box":null,"email":"info@bike-brussels.be","website":"https:\/\/www.bikebrussels.be\/fr\/","phone_contact":"+32 9 241 55 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 9","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"BIKE BRUSSELS EXPO","address_street_name":"Picardstraat","address_street_number":"9","address_street_box":null,"email":"info@bike-brussels.be","website":"https:\/\/www.bikebrussels.be\/fr\/","phone_contact":"+32 9 241 55 08","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Picardstraat, 9","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"BIKE BRUSSELS EXPO","address_street_