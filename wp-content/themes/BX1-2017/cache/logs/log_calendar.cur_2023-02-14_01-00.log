ssible","WC adapt\u00e9"],"nl":["Toegankelijk","Aangepast toilet"],"en":["Accessible","Adapted toilet"],"de":["Barrierefrei","Barrierefreies WC"],"it":["Accessibile","WC idoneo"],"sp":["Habilitado","Ba\u00f1os adaptados"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-13T02:38:01+01:00","published_at":"2023-02-06T08:23:16+01:00","backoffice_id":270986,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.31833136784577},{"id":548849,"date_start":"2023-01-21","date_end":"2023-02-25","date_next":"2023-02-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"],"it":["Gallerie d'arte","Multidisciplinare"],"sp":["Galer\u00edas de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Douce Infinie...","shortdescr":"\"Douce Infinie\", le papier entre minimalisme, et cin\u00e9tisme.","longdescr":"Artiste plasticien franco-allemand n\u00e9 en 1977, Sascha Nordmeyer a \u00e9tudi\u00e9 \u00e0  l'\u00c9cole Sup\u00e9rieure d'Art et de Design de Reims. Son projet \"Communication prosthesis\" a re\u00e7u une couverture m\u00e9diatique internationale et int\u00e9gr\u00e9 une exposition collective au MoMA de New-York en 2011. Il d\u00e9couvre ensuite le travail du papier, pour mieux le d\u00e9cliner sous forme d'infimes pastilles d\u00e9coup\u00e9es. Loin d'\u00eatre innocente, la s\u00e9quence des inclinaisons rythme alors l'espace au gr\u00e9 du reflet et de la couleur. Un clin d\u2019\u0153il, et le tableau est mouvant; un pas de c\u00f4t\u00e9, et l'\u0153uvre devient plurielle. Sascha invente alors un cin\u00e9tisme tr\u00e8s doux, qui s'offre avec pudeur et gourmandise. Poin\u00e7onn\u00e9es une \u00e0 une, ces pastilles (ses expositions peuvent en compter jusqu'\u00e0 455 000) nous renvoie \u00e0 un certain poin\u00e7onneur des Lilas. L\u00e0 o\u00f9 chaque geste \"lib\u00e8re\" le temps, Sascha ponctue l'espace, et construit ainsi sa propre m\u00e9ditation. Chacune de ses \u0153uvres est un d\u00e9dale interactif et subtil, cheminement sans fin de contre-pieds, de ricochets, d'interrogations. On atteint les rives de l'\u00e9pure et du minimalisme. Son \u0153uvre exprime une \u00e9conomie de moyens si aboutie que l'on peut y voir une d\u00e9nonciation de notre opulence.","performers":"Sascha Nordmeyer","boxoffice_url":null,"website":"http:\/\/www.streamart.net","email":"hello@streamart.net","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548849"},"nl":{"name":"Douce Infinie...","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.streamart.net","email":"hello@streamart.net","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548849"},"en":{"name":"Douce Infinie...","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.streamart.net","email":"hello@streamart.net","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548849"},"de":{"name":"Douce Infinie...","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.streamart.net","em