vestrov handpicked the Ukrainian soprano Viktoria Vitrenko, who has the light and shining purity in her voice that this music needs.","oEmbed_author_name":"concerts escapades","oEmbed_author_url":"https:\/\/www.dailymotion.com\/concertsescapades","oEmbed_width":700,"oEmbed_height":393,"oEmbed_html":"<iframe frameborder=\"0\" width=\"700\" height=\"393\" src=\"https:\/\/www.dailymotion.com\/embed\/video\/x8gjgqn?pubtool=oembed\" allowfullscreen allow=\"autoplay\"><\/iframe>","oEmbed_thumbnail_url":"https:\/\/s2.dmcdn.net\/v\/UVGj_1ZhliMKQnbpD\/x240","oEmbed_thumbnail_width":427,"oEmbed_thumbnail_height":240,"translations":{"fr":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"nl":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"en":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"de":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"it":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"sp":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"pt":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"cn":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/afd64e67d1a8189b46bf31da7b9268c9f98540e6.png","width":1000,"height":1000,"ratio":1,"translations":{"fr":{"title":"Nouvelle Saison 2022-2023  Concerts Escapades","copyright":null},"nl":{"title":"Nouvelle Saison 2022-2023  Concerts Escapades","copyright":null},"en":{"title":"Nouvelle Saison 2022-2023  Concerts Escapades","copyright":null},"de":{"title":"Nouvelle Saison 2022-2023  Concerts Escapades","copyright":null},"it":{"title":"Nouvelle Saison 2022-2023  Concerts Escapades","copyright":null},"sp":{"title":"Nouvelle Saison 2022-2023  Concerts Escapades","copyright":null},"pt":{"title":"Nouvelle Saison 2022-2023  Concerts Escapades","copyright":null},"cn":{"title":"Nouvelle Saison 2022-2023  Concerts Escapades","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix