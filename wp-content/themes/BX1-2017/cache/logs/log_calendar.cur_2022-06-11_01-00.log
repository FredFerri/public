00","start":"09:30:00","end":"12:30:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & Durable"],"nl":["Groen"],"en":["Green"]}},"tags":["exterior","kids"],"accessibilities":{"list":[255,261,263],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-23T01:35:31+02:00","published_at":"2022-04-08T12:05:40+02:00","backoffice_id":251209,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.26965590889372},{"id":521565,"date_start":"2021-11-07","date_end":"2022-06-26","date_next":"2022-06-12","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":"Nous avons le plaisir de vous accueillir tous les dimanches, \u00e0 partir de 18h, venez apprendre les danses latines \u00e0 travers des workshops donn\u00e9s par des danseurs professionnels. \u00bfSi o No ?","longdescr":"Nous avons le plaisir de vous accueillir tous les dimanches, \u00e0 partir de 18h, venez apprendre les danses latines \u00e0 travers des workshops donn\u00e9s par des danseurs professionnels. \u00bfSi o No ?\r\n\r\nAu programme, deux heures de cours de danse salsa, bachata, rumba, merengue, cumbia. Les participants sont invit\u00e9s \u00e0 suivre le cours de leurs choix en fonction de leurs niveau (d\u00e9butant ou avanc\u00e9).\r\nEnsuite, une soir\u00e9e dansante anim\u00e9e par les meilleurs DJ Latinos, est pr\u00e9vue apr\u00e8s les cours. Ils vous feront virevolter !\r\nCertains dimanches, des shows et workshops sont organis\u00e9s avec des pointures internationales de la danse.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.sionobrussels.com\/","email":"Sionobrussels@gmail.com","phone_contact":"+32 467 63 61 90","phone_booking":"+32 467 63 61 90","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/521565.html"},"nl":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":"Kom elke zondag, vanaf 18.00 uur in de Plein Publiek BXL om verschillende latino-dansdisciplines te leren met de beste dansers uit Belgi\u00eb! \u00bfSi o No ?","longdescr":"Kom elke zondag, vanaf 18.00 uur in de Plein Publiek BXL om verschillende latino-dansdisciplines te leren met de beste dansers uit Belgi\u00eb! \u00bfSi o No ? \r\nOp het programma, 2uren dansles, salsa, Bachata, merengue, cumbia... Op basis van hun niveau, kunnen de deelnemers de danspassen aanleren (beginners en gevorderden). De danspiste wordt na de workshops geopend voor alle dans-liefhebbers, geanimeerd door de beste latino-DJ's!\r\nOp speciale avonden, kan je er internationale shows en exclusieve workshops beleven!\r\n\r\n*Je hoeft niet op voorhand in te schrijven voor de danslessen\r\n*Je mag ook gewoon naar de dansavond komen zonder de danslessen bij te wonen\r\n*Geen danskennis vereist om de danslessen bij te wonen\r\n*Het is niet nodig om in koppel te komen, danspartners zijn altijd ter plaatse beschikbaar\r\n*Met de lidkaart krijg je het hele jaar door korting op de toegang. De lidkaart kan je aan de ingang aanmaken.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/521565.html"},"en":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/521565.html"},"de":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/521565.html"},"it":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/521565.html"},"sp":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/521565.html"},"pt":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/521565.html"},"cn":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/521565.html"}},"place":{"id":273114,"translations":{"fr":{"name":"Plein Publiek BXL","address_street_name":"Mont Des Arts","address_street_number":"5","address_street_box":null,"email":"bxl@pleinpubliek.be","website":"http:\/\/pleinpubliek.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Mont Des Arts, 5",