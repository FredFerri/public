:"18:00:00"},{"day":"2022-12-01","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-12-02","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-12-03","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-12-04","doors":null,"start":"13:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"13:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"13:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"13:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"13:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi, mardi et mercredi: ferm\u00e9","jeudi, vendredi, samedi et dimanche: de 13:00 \u00e0 18:00"],"nl":["maandag, dinsdag en woensdag: gesloten","donderdag, vrijdag, zaterdag en zondag: van 13:00 tot 18:00"],"en":["monday, tuesday and wednesday: closed","thursday, friday, saturday and sunday: from 13:00 to 18:00"]},"date_start":"2022-09-08","date_end":"2022-12-04","is_also_by_appointment":false}],"date_exceptions":[{"day":"2022-09-08","start":"11:00:00","end":"19:00:00"},{"day":"2022-09-09","start":"10:00:00","end":"19:00:00"},{"day":"2022-09-10","start":"11:00:00","end":"19:00:00"},{"day":"2022-09-11","start":"11:00:00","end":"19:00:00"},{"day":"2022-09-17","start":"10:00:00","end":"18:00:00"},{"day":"2022-09-18","start":"10:00:00","end":"18:00:00"},{"day":"2022-10-22","start":"13:00:00","end":"23:59:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-09-07","start":"16:00:00","timestamp":"2022-09-07T16:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-12T01:08:21+02:00","published_at":"2022-07-12T13:14:37+02:00","backoffice_id":258271,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28325816747135},{"id":538724,"date_start":"2022-09-04","date_end":"2022-10-22","date_next":"2022-09-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Mathieu Meijers - Lux Nigra (artiste peintre)","shortdescr":"Pour le rentr\u00e9e, la Mich\u00e8le Schoonjans Gallery a l\u2019honneur de pr\u00e9senter en solo show le travail de l\u2019artiste Mathieu Meijers. L'exposition, Lux Nigra, pr\u00e9sente des \u0153uvres issues de trois s\u00e9ries : Girls Playground, Shadows et Above the Light. L'artiste analyse l'\u00e9volution de la r\u00e9flexion sur la couleur dans la peinture \u00e0 travers les \u00e2ges.","longdescr":"Pour le rentr\u00e9e, la Mich\u00e8le Schoonjans Gallery a l\u2019honneur de pr\u00e9senter en solo show le travail de l\u2019artiste Mathieu Meijers.\r\n\r\nLUX NIGRA\r\nCelui qui ferme les yeux voit la lumi\u00e8re de l'int\u00e9rieur. C'est la lumi\u00e8re noire ou lux nigra. La lumi\u00e8re noire n'est pas synonyme de peur ou d'absence mais est, au contraire, absorbante et accueillante. Elle enveloppe le spectateur et est une potentialit\u00e9 pure : ici, tout est encore possible et tout peut na\u00eetre. Le noir est donc l'oppos\u00e9 du blanc, r\u00e9fl\u00e9chissant et d\u00e9fensif. Le blanc exclut la vie et l'humanit\u00e9.\r\nL'histoire de la peinture moderne a longtemps \u00e9t\u00e9 domin\u00e9e par le blanc. Il y avait une tendance vers des couleurs de plus en plus claires comme une poursuite de l'\u00e9lev\u00e9, de l'immat\u00e9riel et de l'inhumain. Il s'agit d'une forme d'esth\u00e9tisation qui favorise le d\u00e9tachement et met l'art sur une voie de garage solitaire.\r\nMathieu Meijers a grandi dans ce modernisme, mais s'en est d\u00e9tourn\u00e9 \u00e0 un certain moment. Il a quitt\u00e9 l'impasse du blanc et a embrass\u00e9 la lumi\u00e8re noire et r\u00e9int\u00e9gr\u00e9 ainsi la mat\u00e9rialit\u00e9.\r\nPendant longtemps, il n'a fait que dessiner des repr\u00e9sentations figuratives autour de th\u00e8mes de sa propre vie. En r\u00e9p\u00e9tant sans cesse des formes, il fixe ses actions. Travailler une composition est un appel \u00e0 sa concentration, qui donne un contenu et un sens \u00e0 l'\u0153uvre qu'elle n'avait pas auparavant. Ce n'est que lorsqu'une \u0153uvre se retire de l'histoire et devient quelque chose d'autre, d'ind\u00e9pendant, qu'elle est achev\u00e9e. Cela peut souvent prendre des ann\u00e9es\r\nLorsque Meijers reprend les pinceaux, son travail devient plus abstrait et traite des principes de la peinture. Mais une touche personnelle reste toujours pr\u00e9sente : les bateaux qu'il voyait enfant dans le port, les poires du jardin de son p\u00e8re ou les ampoules \u00e9lectriques produites depuis longtemps, chez Philips, dans sa ville natale d'Eindhoven. Il relie ces motifs \u00e0 l'histoire de l'art, du Trecento, la p\u00e9riode du XIVe si\u00e8cle en Italie entre le gothique et la Renaissance, \u00e0 la culture contemporaine de l'image num\u00e9rique. Il en rend compte dans des m\u00e9langes de couleurs et de m\u00e9taux pr\u00e9cieux. L'or, le platine et le palladium jouent ici un r\u00f4le important. Entre les couleurs, l'or fonctionne comme le noir alors qu'il peut aussi r\u00e9fl\u00e9chir. Le platine et le palladium n'ont pas une histoire de l'art comparable \u00e0 celle de l'or, mais ils peuvent aussi appara\u00eetre comme un blanc implacable ou d'un noir opaque.\r\nCette exposition, Lux Nigra, pr\u00e9sente des \u0153uvres issues de trois s\u00e9ries : Girls Playground, Shadows et Above the Light. Dans Girls Playground, la cl\u00f4ture de l'\u00e9cole primaire de Meijers constitue le point de d\u00e9part d'une exploration de la lumi\u00e8re et de la couleur en tant que mati\u00e8re. Dans Shadows, l'\u00e9cran d'un projecteur de cin\u00e9ma et une ampoule \u00e9lectrique \u00e9teinte repr\u00e9sentent le moment o\u00f9 la lumi\u00e8re se transforme en image, la \"lumi\u00e8re avant la lumi\u00e8re\". Et Above the Light est l'analyse personnelle de Meijers de l'\u00e9volution de la r\u00e9flexion sur la couleur dans la peinture \u00e0 travers les \u00e2ges.\r\n\r\nMathieu Meijers (1951, Stein, Pays-Bas) dessine, peint et compose des livres. Ses \u0153uvres font partie des collections du Van Abbemuseum, d'ING et d'ABN Amro. Il a longtemps enseign\u00e9 la peinture \u00e0 l'Acad\u00e9mie Gerrit Rietveld d'Amsterdam et aux acad\u00e9mies des beaux-arts de Breda et de 's Hertogenbosch. \u00c0 la Design Academy Eindhoven, mondialement reconnue, il a enseign\u00e9 la recherche sur les couleurs. \u00c0 ce titre, il a \u00e9t\u00e9 le commissaire de l'exposition Broken White de 2016 au Van Abbemuseum, dans laquelle son point de vue sur la lumi\u00e8re et la couleur \u00e9tait pr\u00e9pond\u00e9rant.","performers":"Mathieu Meijers - Lux Nigra","boxoffice_url":null,"website":"http:\/\/www.micheleschoonjansgallery.be","email":"info@micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538724"},"nl":{"name":"Mathieu Meijers - Lux Nigra (kunstenaar)","shortdescr":"Voor september-oktober heeft de Mich\u00e8le Schoonjans Galerie de eer om het werk van kunstenaar Mathieu Meijers in een solo show te presenteren.\r\nIn deze tentoonstelling is werk uit drie series te zien: Girls Playgrond, Shadows en Boven het licht, een analyse van de ontwikkeling die het denken over kleur door de eeuwen heen in de schilderkunst heeft doorgemaak.","longdescr":"Voor september-oktober heeft de Mich\u00e8le Schoonjans Galerie de eer om het werk van kunstenaar Mathieu Meijers in een solo show te presenteren.\r\n\r\nLUX NIGRA\r\nWie zijn ogen sluit, ziet licht van binnen. Dit is het zwarte licht of lux nigra. Het zwarte licht staat niet voor angst of absentie maar is juist absorberend en verwelkomend. Het omhult de kijker en is pure potentie: hier is alles nog mogelijk en kan alles ontstaan. Het is daarmee het tegendeel van wit, dat reflecterend en afwerend is. Wit sluit het leven en menselijkheid buiten.\r\nDe geschiedenis van de moderne schilderkunst is lange tijd gedomineerd geweest door wit. Er was een tendens naar steeds lichter als een streven naar het hogere, het immateri\u00eble en het onmenselijke. Het was een vorm van esthetisering die afstandelijkheid in de hand werkte en de kunst op een eenzaam zijspoor zette.\r\nMathieu Meijers groeide op in dit modernisme maar keerde zich er op een gegeven moment van af. Hij heeft de doodlopende weg van het wit verlaten, het zwarte licht omarmd en daarmee de materialiteit weer een plaats gegeven.\r\nLange tijd heeft hij enkel getekend, figuratieve voorstellingen rondom thema\u2019s uit zijn eigen leven. Door vormen eindeloos te herhalen fixeert hij zijn handelingen. Het doorwerken van een compositie is een app\u00e8l aan zijn concentratie, die een inhoud en betekenis geeft aan het werk die het eerst niet had. Pas als een werk zich onttrekt aan de geschiedenis en iets anders, iets zelfstandigs wordt, is het af. Dat kan vaak jaren duren.\r\nToen Meijers de kwasten weer oppakte, werd zijn werk abstracter en ging het over schilderkunstige principes. Maar een persoonlijke laag bleef altijd aanwezig: schepen die hij als kind in de haven zag, peren uit zijn vaders tuin of gloeilampen die lange tijd werden geproduceerd in zijn woonplaats Eindhoven. Deze motieven verbindt hij aan de kunstgeschiedenis, van het Trecento, de 14de-eeuwse periode in Itali\u00eb tussen gotiek en Renaissance, tot de hedendaagse, digitale beeldcultuur. Hij vat dit in schema\u2019s van kleurmengingen en edelmetalen. Goud, platina en palladium spelen daarbij een belangrijke rol. Tussen de kleuren werkt goud als zwart terwijl het ook kan reflecteren. Platina en Palladium hebben geen kunsthistorisch trackrecord vergelijkbaar met goud maar kunnen ook overkomen als meedogenloos wit of bedekkend zwart.\r\nIn deze tentoonstelling is werk uit drie series te zien: Girls Playgrond, Shadows en Boven het licht. In Girls Playground vormt het hekwerk van Meijers\u2019 lagere school het uitgangspunt voor een verkenning van licht en kleur als materie. In Shadows verbeelden een filmprojectorscherm en een niet brandende gloeilamp het moment voordat licht verandert in beeld, het \u2018licht voor het licht\u2019. En Boven het licht is Meijers\u2019 persoonlijke analyse van de ontwikkeling die het denken over kleur door de eeuwen heen in de schilderkunst heeft doorgemaakt.\r\n\r\nMathieu Meijers (1951, Stein, Nederland) tekent, schildert en maakt boeken. Zijn werk bevindt zich in de collecties van het Van Abbemuseum, ING en ABN Amro. Hij was lange tijd als docent schilderkunst verbonden aan de Gerrit Rietveld Academie in Amsterdam en de kunstacademies van Breda en \u2019s Hertogenbosch. Aan de Design Academy Eindhoven was hij docent kleuronderzoek. In die hoedanigheid cureerde hij in 2016 de tentoonstelling Broken White in het Van Abbemuseum, waarin zijn opvattingen over licht en kleur leidend waren.","performers":"Mathieu Meijers - Lux Nigra","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538724"},"en":{"name":"Mathieu Meijers - Lux Nigra (artist painter)","shortdescr":"The Mich\u00e8le Schoonjans Gallery is honoured to present the work of artist Mathieu Meijers in a solo show.\r\nThis exhibition displays works from three series: Girls\u2019 Playground, Shadows and In front, over, under and behind the light, an analysis of the development of thinking about colour in painting over the centuries.","longdescr":"The Mich\u00e8le Schoonjans Gallery is honoured to present the work of artist Mathieu Meijers in a solo show.\r\n\r\nLUX NIGRA\r\nClose your eyes and you can see light on the inside. This is the black light or lux nigra. The black light doesn\u2019t stand for fear or absence, but is absorbent and welcoming. It envelops the viewer and is pure potential: here everything is still possible and anything could develop. This makes it the opposite of white, which is reflective, dismissive. White locks life and humanity out.\r\nModern painting\u2019s history was long dominated by white. A trend existed towards lighter as a means of striving for the higher, the immaterial, the beyond human. It was a form of anesthetising that encouraged aloofness and shunted art onto a lonely siding.\r\nMathieu Meijers grew up in this modernism, yet at a certain point turned his back on it. He left white\u2019s dead end, embraced the black light thereby once again providing space for materiality.\r\nFor the longest time, he did nothing but draw figurative scenes based on themes from his own life. Endlessly repeating shapes allows him to record his actions. Working out a composition is like an apple for his concentration which provides content and meaning to the work it originally did not have. Only once the work removes itself from history and becomes something else, something independent, is it finished. This often takes years.\r\nWhen Meijers took up his brushes again, his work became more abstract, its subject matter: the principles of painting. However, there was always a personal layer present: ships he saw in the harbour as a child, pears from his father\u2019s garden or lightbulbs which, for a long time, where manufactured in his home town, Eindhoven. He connects these motifs to art history from the Trecento, the 14th-century period in Italy between Gothic and the Renaissance, to contemporary digital image culture. He encapsulates this in schematics for colour mixes and precious metals. Gold, platinum and palladium play an important role. Amid the colours, gold works like black, yet can also be reflective. Platinum and palladium do not have an art historical track record like gold does, yet can also be interpreted as merciless white or covering black.\r\nThis exhibition displays works from three series: Girls\u2019 Playground, Shadows and In front, over, under and behind the light. The fence from Meijers\u2019 primary school is the point of departure for Girls\u2019 Playground\u2019s exploration of light and colour as matter. In Shadows, a projector screen and an unlit incandescent bulb depict the moment before the light changed into image, the \u2018light before the light\u2019. Finally, In front, over, under and behind the light is Meijers\u2019 personal analysis of the development of thinking about colour in painting over the centuries.\r\n\r\nMathieu Meijers (1951, Stein, The Nederlands) draws, paints and creates books. His work has been collected by the Van Abbemuseum (NL) and the Dutch ING and ABN Amro banks. He spent an extended period teaching painting at the Gerrit Rietveld Academie in Amsterdam and the art schools of Breda and \u2019s Hertogenbosch. At the Design Academy Eindhoven he taught colour research. It was in that guise that he curated the 2016 exhibition Broken White at the Van Abbemuseum, which was informed by his ideas on light and colour.","performers":"Mathieu Meijers - Lux Nigra","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538724"},"de":{"name":"Mathieu Meijers - Lux Nigra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":n