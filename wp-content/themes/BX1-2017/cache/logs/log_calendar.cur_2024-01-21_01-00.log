"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559324"},"fr":{"name":"Gravure \/ Image imprim\u00e9e","shortdescr":"Gravure \/ Image imprim\u00e9e - 2023\/2024 - 118\r\nAtelier Studio | Rue Lola Bobesco 5, 1er \u00e9tage - 1200 Woluwe Saint Lambert | Voir la carte","longdescr":"Durant cette saison l\u2019atelier proposera de travailler sur les techniques vari\u00e9es de r\u00e9alisation de matrices et sur les possibilit\u00e9s infinies d\u2019impression \u00e0 partir de ces plaques.De s\u00e9ance en s\u00e9ance, les matrices se modifient, se retravaillent, se r\u00e9cup\u00e8rent, se superposent, se chargent d\u2019encre noir ou de couleur ou se donnent en relief sans encre. Au fil de cette saison, les empreintes gardent les traces de modifications, la r\u00e9p\u00e9tition et le multiple donnent naissance \u00e0 l\u2019unique. La gravure en creux (eau-forte et pointe s\u00e8che sur m\u00e9tal, plexi, tetrapak) en relief (bois, lino, carton, gomme) et l\u2019impression \u00e0 plat (monotype, kitchen-litho, mokulitho) seront notre point de d\u00e9part pour l'exp\u00e9rimentation pendant toute l\u2019ann\u00e9e.\r\n\r\nMat\u00e9riel \u00e0 apporter: Tablier, carnet de croquis ou feuilles A4 papier machine, crayon, latte, cutter, gants (Latex), loques.Les mati\u00e8res premi\u00e8res (papier de gravure, lino, zinc, bois, plexi), peuvent \u00eatre achet\u00e9es sur place au prix co\u00fbtant.\r\n\r\nPar Ludmila Krasnova\r\n\r\nLocal Studio \r\nLes dimanches de 11h \u00e0 17h les 17\/9 ; 1\/10 ; 15\/10 ; 12\/11 ; 26\/11 ; 17\/12 ; 14\/1 ; 28\/1 ; 11\/12 ; 10\/3 ; 24\/3 ; 7\/4 ; 21\/4 ; 19\/5","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/gravure-image-imprimee-2023-2024-118\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559324"},"sp":{"name":"Gravure \/ Image imprim\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/gravure-image-imprimee-2023-2024-118\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559324"},"nl":{"name":"Gravure \/ Image imprim\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/gravure-image-imprimee-2023-2024-118\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559324"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":n