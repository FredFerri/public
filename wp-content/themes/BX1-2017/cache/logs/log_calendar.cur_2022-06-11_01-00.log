23:00"]},"date_start":"2022-04-05","date_end":"2025-10-31","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[528646],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:05:45+02:00","published_at":"2022-03-30T11:40:24+02:00","backoffice_id":250588,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.11526450942995},{"id":520976,"date_start":"2021-10-13","date_end":"2022-08-07","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"T. rex","shortdescr":"T.rex le plus c\u00e9l\u00e8bre des dinosaures\r\nTout ce que vous avez toujours voulu savoir sur le T. rex.","longdescr":"Au-del\u00e0 des images, des films et des mythes, cette expo vous invite \u00e0 une vraie rencontre avec cet animal fascinant.\r\n\r\nD\u00e8s l\u2019entr\u00e9e, vivez un face \u00e0 face spectaculaire avec une femelle T. rex de 67 millions d\u2019ann\u00e9es. Elle s\u2019appelle Trix et vous accueille en position d\u2019attaque. Son squelette, un moulage 3D de haute qualit\u00e9 scientifique, est juste \u00e9poustouflant.\r\n\r\nApprenez maintenant \u00e0 la conna\u00eetre. \r\nLe parcours de l\u2019expo vous propose six premiers interactifs pour comprendre le travail des pal\u00e9ontologues et d\u00e9couvrir l\u2019\u00e9poque \u00e0 laquelle Trix a v\u00e9cu, son \u00e2ge lors de sa mort, son alimentation, l\u2019origine de ses blessures et bien plus encore. Autant de questions auxquelles les scientifiques ont r\u00e9pondu en examinant ses os fossilis\u00e9s et les roches dans lesquelles ils l\u2019ont trouv\u00e9e. \r\n\r\nSix autres interactifs vous permettent d\u2019en apprendre plus sur la pal\u00e9obiologie du T. rex en g\u00e9n\u00e9ral :  naissance, alimentation, d\u00e9placements\u2026 Pr\u00eat \u00e0 relever les d\u00e9fis propos\u00e9s ?\r\nSautez en selle pour d\u00e9fier le T. rex \u00e0 la course.\r\nLaissez votre imagination colorer sa peau.\r\nVivez avec lui le temps des amours au Cr\u00e9tac\u00e9 et s\u00e9duisez-le par une danse\u2026 \r\nGagnerez-vous l\u2019hilarant quizz de la fin du parcours ? \r\n\r\nUne expo \u00e0 vivre avec 12 interactifs-jeux qui jalonnent votre parcours: jeu \u00e9lectro, microscope, vid\u00e9os, quizz, touche -\u00e0 -tout et d\u00e9fis.\r\n\r\nParticuli\u00e8rement destin\u00e9e aux enfants d\u00e8s 5 ans, elle fera le bonheur de tous les mordus de dinos !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.sciencesnaturelles.be","email":"info@sciencesnaturelles.be","phone_contact":null,"phone_booking":"+32 2 627 42 34","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/520976.html"},"nl":{"name":"T. rex","shortdescr":"T.rex de bekendste dinosaurus\r\nAlles wat je altijd al wou weten over Tyrannosaurus rex.","longdescr":"Vergeet beelden, films en mythes! Deze tentoonstelling laat je live kennismaken met dit fascinerende dier.\r\n\r\nZodra je binnenkomt, sta je oog in oog met een vrouwelijke T. rex van 67 miljoen jaar oud. Haar naam is Trix en ze verwelkomt je... in aanvalspositie! Haar skelet (een 3D-print van hoge wetenschappelijke kwaliteit) is absoluut verbluffend.\r\n\r\nPaleontologen groeven haar op in Montana (VS) en onderzochten haar gefossiliseerde botten en de gesteenten waarin ze is gevonden. \r\nOntdek al spelend en al luisterend in welk tijdperk Trix leefde, wat ze at, hoe ze aan haar verwondingen kwam en hoe oud ze was toen ze stierf.\r\n\r\n\r\nMaar daar houdt de expo niet op. Er valt nog\r\nveel meer te ontdekken over het leven van\r\ndeze toproofdieren uit het krijttijdperk: hoe snel konden ze lopen? Hoeveel aten ze? En welke verleidingsmoves gebruikten ze?\r\nDuik dieper in de expo en ga op zoek naar antwoorden! Spring op de fiets en probeer een woeste T. rex voor te blijven, of grijp een spuitbus en kleur er eentje in! Toon je beste dinodans en verleid Trix!\r\nBen je ondertussen een echte \u2018T. rexpert\u2019? \r\nTest je kennis met een hilarische quiz, als afsluiter.\r\n\r\nDeze tentoonstelling met 12 doeactiviteiten \u2013 elektrospel, microscoop, video\u2019s, een quiz en andere uitdagingen \u2013 is een hele belevenis! \r\n\r\nOntworpen voor kinderen vanaf 5 jaar, maar de expo zal \u00e1lle dinofans plezieren!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.natuurwetenschappen.be","email":"info@natuurwetenschappen.be","phone_contact":null,"phone_booking":"+32 2 627 42 52","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/520976.html"},"en":{"name":"T.rex","shortdescr":"The most famous of dinosaurs","longdescr":"As you enter, you will have a spectacular face-to-face encounter with Trix, a 67-million-year-old femaleT. rex. Her skeleton, a 3D cast of high scientific quality, is simply breathtaking.\r\n\r\nIt\u2019s now time to get to know her. The exhibition includes 6 interactive displays to help you understand the work of the palaeontologists. A further 6 interactive displays allow you to learn more about the paleobiology of the T. rex in general. \r\n\r\nEnjoy the exhibition through 12 interactive stages: an electronic game, a microscope, videos, a quiz, and a variety of challenges! \r\nEspecially designed for children aged 5 and above, this is a treat for all dinosaur fans!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.naturalsciences.be","email":"info@naturalsciences.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/520976.html"},"de":{"name":"T. rex","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/520976.html"},"it":{"name":"T. rex","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/520976.html"},"sp":{"name":"T. rex","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/520976.html"},"pt":{"name":"T. rex","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/520976.html"},"cn":{"name":"T. rex","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/520976.html"}},"place":{"id":47,"translations":{"fr":{"name":"Mus\u00e9um des Sciences Naturelles","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@sciencesnaturelles.be","website":"http:\/\/www.sciencesnaturelles.be","phone_contact":"+32 2 627 42 33","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"Explorez l\u2019\u00e9volution de l\u2019Homme et de son corps \u2013 de Sahelanthropus \u00e0 Homo sapiens, de l\u2019embryon \u00e0 l\u2019adulte \u2013 dans la toute nouvelle Galerie de l\u2019Homme - Notre \u00e9volution, notre corps.\r\n\r\nMais ce n\u2019est pas tout ! Vous pouvez aussi parcourir la plus grande Galerie des Dinosaures d\u2019Europe, remonter le temps dans la Galerie de l\u2019\u00c9volution et ses 1000 sp\u00e9cimens, plonger avec les gigantesques l\u00e9zards marins du Cr\u00e9tac\u00e9 dans la Salle des Mosasaures, embarquer pour un safari urbain dans BiodiverCITY et d\u00e9couvrir l\u2019histoire du Mus\u00e9um au travers de 14 \u00ab chapitres \u00bb symboliques dans 250 ans de Sciences naturelles. Pour finir, les salles d\u00e9di\u00e9es aux Min\u00e9raux, aux Insectes (avec un vivarium, o\u00f9 tarentules, phasmes et autres vous feront fr\u00e9mir) et aux Coquillages vous convaincront qu\u2019il y a toujours quelque chose \u00e0 d\u00e9couvrir dans nos collections permanentes.\r\n\r\nSurfez sur le site www.sciencesnaturelles.be pour plus d\u2019informations sur les expositions temporaires\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum voor Natuurwetenschappen","address_street_name":"Vautierstraat","address_street_number":"29","address_street_box":null,"email":"info@natuurwetenschappen.be","website":"http:\/\/www.natuurwetenschappen.be","phone_contact":"+32 2 627 42 27","phone_booking":"+32 2 627 42 52","address_zip":"1000","address_city":"Brussel","address_line1":"Vautierstraat, 29","address_line2":"1000 Brussel","description_web":"Ga de natuur ontdekken in het Museum voor Natuurwetenschappen. Hier kun je er ook de menselijke natuur - onze evolutie en onze biologie - verkennen in de nieuwe Galerij van de Mens. Van Sahelanthropus tot Homo sapiens en van embryo tot volwassene. \r\n\r\nEn dat is nog maar het begin! In het Museum vind je de grootste Dinogalerij van Europa, doorloop je de geschiedenis van het leven in de Galerij van de Evolutie (met meer dan 1000 specimens!), duik je in het tijdperk van de gigantische zeereptielen in de Zaal van de Mosasauri\u00ebrs, ga je op safari door de stad in BiodiverCITY en ontdek je 250 Jaar Natuurwetenschappen aan de hand van 14 natuurwetenschappelijke iconen. En met zalen gewijd aan mineralen, insecten (met een vivarium waar je levende vogelspinnen en wandelende takken kunt bewonderen) en schelpen, valt er altijd wat te ontdekken!\r\n\r\nBezoek de website www.natuurwetenschappen.be voor meer informatie over o.a de tijdelijke tentoonstellingen","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of Natural Sciences","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Brussels","address_line1":"Rue Vautier, 29","address_line2":"1000 Brussels","description_web":"Discover nature at the Museum of Natural Sciences in Brussels, where you can explore human nature, our evolution and biology, in the brand new Gallery of Humankind: from Sahelanthropus to Homo sapiens; from embryo to adult. \r\n\r\nBut that\u2019s not all! In the rest of the Museum you\u2019ll find the largest Dinosaur Gallery in Europe, you'll be able to study the 1000+ specimens in the Gallery of Evolution, to dive with gigantic sea lizards from the Cretateuous period in the Mosasaur Room, to embark on an urban safari in BiodiverCITY and to discover 250 years of the history of Natural Sciences through 14 iconic specimens. With rooms dedicated to subjects as diverse as minerals, insects (with the Vivarium where you can observe amongst others live tarantulas and stick insects) and shells, there\u2019s always something to discover in the permanent collections.\r\n\r\nVisit the website www.naturalsciences.be for more information about the temporary exhibitions\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Museum f\u00fcr Naturwissenschaften","address_street_name":"rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"https:\/\/www.naturalsciences.be\/de","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"Naturwissenschaften und Naturgeschichte hautnah im Br\u00fcsseler Museum f\u00fcr Naturwissenschaften mit der gr\u00f6\u00dften Dinosaurierausstellung Europas\r\n\r\nVon den Dinosauriern bis zum Menschen: Lust, einem Mammut in den R\u00fcssel zu schauen, einem Dinosaurier tief in die Augen zu blicken oder in die Haut eines Neandertalers zu schl\u00fcpfen? Das Museum f\u00fcr Naturwissenschaften steckt voller Leben... und voller \u00dcberraschungen. \r\n\r\nDie gr\u00f6\u00dfte Dinosaurierausstellung Europas: Die Dinosauriergalerie mit mehr als drei\u00dfig vollst\u00e4ndigen Skeletten und zahlreichen Dinosaurierfragmenten ist die gr\u00f6\u00dfte Dinosaurierausstellung Europas. Nebenbei erf\u00e4hrt man interessante Details aus dem Leben - und Sterben - der Dinosaurier...\r\n\r\nNeuheiten: Die \u201eGalerie de l'Homme\": Neuste Attraktion ist die \u201eGalerie de l'Homme\" - die Galerie des Menschen, die einen faszinierenden Einblick in 7 Millionen Jahre Menschheitsgeschichte gibt. Vom Embryo zum Erwachsenen - entdecken Sie die Entwicklung und die Evolution bis zum modernen Menschen oder den menschlichen K\u00f6rper und seine Funktionsweise anhand von Fossiliensammlungen, 3D-Nachbildungen und interaktiven Pr\u00e4sentationen. \r\n\r\nDer Mosasaurier-Saal: Die Mosasaurier waren in der Oberkreide eine weltweit verbreitete Gruppe von Meeresreptilien. In dem neuen Saal, der sich unterhalb der Dinosaurier-Galerie befindet, haben Sie Gelegenheit, diese \u201eurzeitlichen K\u00f6nige der Meere\" zu bewundern.\r\n\r\nLeibliches Wohl:\r\n\r\nDer Magen knurrt, die Zunge ist trocken? G\u00f6nnen Sie sich eine kleine Pause im Dino Caf\u00e9.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo di Scienze Naturali","address_street_name":"rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.sciencesnaturelles.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"Il Museo di Scienze naturali di Bruxelles conserva la pi\u00f9 importante collezione di scheletri di dinosauro d\u2019Europa, ma non solo!\r\n\r\nTroverete molti dinosauri tra cui Tirannosauri Rex, Triceratopi e Diplodochi, potrete ammirare anche la vasta collezione di fossili d\u2019Iguanodonti di inestimabile valore, di cui il Belgio \u00e8 estremamente fiero.     \r\n\r\n\r\nDa non perdere: la Nuova Galleria dell\u2019Uomo \r\n\r\nDal Sahelanthropus all'Homo sapiens, dall'embrione all'adulto: nella nuova galleria del museo potete esplorare l\u2019evoluzione dell\u2019uomo e del corpo umano. Quest\u2019area vi d\u00e0 la possibilit\u00e0 di conoscere i cambiamenti che hanno portato all\u2019uomo moderno e l\u2019evoluzione nel corso di 7 milioni di anni, attraverso fossili, video-ricostruzioni 3D, presentazioni interattive.  \r\n\r\nPer saperne di pi\u00f9 \r\n\r\n\r\n\r\nDa vedere anche:\r\n\r\nLa sala dei Mosasauri\r\nQuesta sala di recente costruzione, situata sopra la Galleria dei Dinosauri vi permetter\u00e0 di ammirare i \"re dei mari antichi\", i Mosasauri, gigantesche lucertole marine equivalente acquatico dei dinosauri. \r\n\r\nLa Galleria dei Dinosauri \r\nLa pi\u00f9 grande esposizione di Dinosauri d'Europa, con pi\u00f9 di 30 scheletri di cui alcuni interamente conservati.\r\n\r\nLa Galleria dell'Evoluzione\r\nUn'esposizione unica nel suo genere in Belgio! Circa 600 fossili e 400 animali imbalsamati a testimoniare la biodiversit\u00e0 delle specie animali di milioni di anni.\r\n\r\n250 anni di Scienze naturali\r\nUn percorso all\u2019insegna di 20 testimonianze storico-scientifiche.\r\n  \r\nBiodiverCITY\r\nQuesta sala, dedicata alla biodiversit\u00e0 cittadina, offre un'avventura urbana a grandi e piccini. Dagli 8 anni in su.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Real Instituto Belga de Ciencias Naturales","address_street_name":"rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.sciencesnaturelles.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"Descubre la naturaleza en el Real Instituto Belga de Ciencias Naturales de Bruselas, donde podr\u00e1s explorar la naturaleza y nuestra evoluci\u00f3n y biolog\u00eda en la nueva Galer\u00eda de Biolog\u00eda Humana: desde el Sahelanthropus hasta el Homo sapiens, y desde el embri\u00f3n hasta el adulto.\r\n\r\n\u00a1Pero eso no es todo! En este museo encontrar\u00e1s la galer\u00eda de dinosaurios m\u00e1s grande de Europa, tendr\u00e1s la oportunidad de estudiar m\u00e1s de 1000 espec\u00edmenes en la Galer\u00eda de la Evoluci\u00f3n, sumergirte con lagartos de mar gigantes del Cret\u00e1cico en la Sala de los Mosasaurios, disfrutar de un safari urbano en BiodiverCITY y descubrir 250 a\u00f1os de historia de las ciencias naturales a trav\u00e9s de 14 extraordinarios espec\u00edmenes. Con salas dedicadas a temas diversos como los minerales, insectos(en el Vivarium podr\u00e1s observar entre otros seres vivos tar\u00e1ntulas e insectos palo) y conchas, siempre hay algo que descubrir en las colecciones permanentes.\r\n\r\nVisita la p\u00e1gina www.naturalsciences.be para m\u00e1s informaci\u00f3n sobre las exhibiciones temporales.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museu das Ci\u00eancias Naturais","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@sciencesnaturelles.be","website":"http:\/\/www.sciencesnaturelles.be","phone_contact":"+32 2 627 42 33","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"Explore a evolu\u00e7\u00e3o do ser humano e do seu corpo \u2013 do Sahelanthropus ao Homo sapiens, do embri\u00e3o ao adulto \u2013 tudo na nova Galeria do Ser Humano \u2013 a nossa evolu\u00e7\u00e3o, o nosso corpo.\r\nMas n\u00e3o \u00e9 tudo! Pode tamb\u00e9m descobrir a maior Galeria de Dinossauros da Europa, voltar no tempo na Galeria da Evolu\u00e7\u00e3o, com os seus 1000 esp\u00e9cimes, mergulhar em conjunto com os gigantescos lagartos marinhos do Cret\u00e1ceo na Sala dos Mosassauros, embarcar num safari urbano em BiodiverCITY e descobrir a hist\u00f3ria do museu atrav\u00e9s de 14 \u201ccap\u00edtulos\u201d simb\u00f3licos de 250 anos de Ci\u00eancias Naturais. Por \u00faltimo, as salas dedicadas aos Minerais, aos Insetos (com um viveiro, onde tar\u00e2ntulas, bichos-pau e outros vos far\u00e3o tremer) e aos Moluscos convencer-vos-\u00e3o que h\u00e1 sempre algo a descobrir nas nossas cole\u00e7\u00f5es permanentes.\r\nNavegue no site www.sciencesnaturelles.be para mais informa\u00e7\u00f5es sobre as exposi\u00e7\u00f5es tempor\u00e1rias","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9um des Sciences Naturelles","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@sciencesnaturelles.be","website":"http:\/\/www.sciencesnaturelles.be","phone_contact":"+32 2 627 42 33","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[9],"translations":{"fr":["Quartier europ\u00e9en"],"nl":["Europese wijk"],"en":["European Quarter"]}},"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"]}},"neca":null,"facebook_id":null,"backoffice_id":8,"location":{"lat":50.83650849,"lon":4.37649387},"region":"brussels","last_updated_at":"2022-06-10T01:08:14+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":47,"translations":{"fr":{"name":"Mus\u00e9um des Sciences Naturelles","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@sciencesnaturelles.be","website":"http:\/\/www.sciencesnaturelles.be","phone_contact":"+32 2 627 42 33","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"Explorez l\u2019\u00e9volution de l\u2019Homme et de son corps \u2013 de Sahelanthropus \u00e0 Homo sapiens, de l\u2019embryon \u00e0 l\u2019adulte \u2013 dans la toute nouvelle Galerie de l\u2019Homme - Notre \u00e9volution, notre corps.\r\n\r\nMais ce n\u2019est pas tout ! Vous pouvez aussi parcourir la plus grande Galerie des Dinosaures d\u2019Europe, remonter le temps dans la Galerie de l\u2019\u00c9volution et ses 1000 sp\u00e9cimens, plonger avec les gigantesques l\u00e9zards marins du Cr\u00e9tac\u00e9 dans la Salle des Mosasaures, embarquer pour un safari urbain dans BiodiverCITY et d\u00e9couvrir l\u2019histoire du Mus\u00e9um au travers de 14 \u00ab chapitres \u00bb symboliques dans 250 ans de Sciences naturelles. Pour finir, les salles d\u00e9di\u00e9es aux Min\u00e9raux, aux Insectes (avec un vivarium, o\u00f9 tarentules, phasmes et autres vous feront fr\u00e9mir) et aux Coquillages vous convaincront qu\u2019il y a toujours quelque chose \u00e0 d\u00e9couvrir dans nos collections permanentes.\r\n\r\nSurfez sur le site www.sciencesnaturelles.be pour plus d\u2019informations sur les expositions temporaires\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum voor Natuurwetenschappen","address_street_name":"Vautierstraat","address_street_number":"29","address_street_box":null,"email":"info@natuurwetenschappen.be","website":"http:\/\/www.natuurwetenschappen.be","phone_contact":"+32 2 627 42 27","phone_booking":"+32 2 627 42 52","address_zip":"1000","address_city":"Brussel","address_line1":"Vautierstraat, 29","address_line2":"1000 Brussel","description_web":"Ga de natuur ontdekken in het Museum voor Natuurwetenschappen. Hier kun je er ook de menselijke natuur - onze evolutie en onze biologie - verkennen in de nieuwe Galerij van de Mens. Van Sahelanthropus tot Homo sapiens en van embryo tot volwassene. \r\n\r\nEn dat is nog maar het begin! In het Museum vind je de grootste Dinogalerij van Europa, doorloop je de geschiedenis van het leven in de Galerij van de Evolutie (met meer dan 1000 specimens!), duik je in het tijdperk van de gigantische zeereptielen in de Zaal van de Mosasauri\u00ebrs, ga je op safari door de stad in BiodiverCITY en ontdek je 250 Jaar Natuurwetenschappen aan de hand van 14 natuurwetenschappelijke iconen. En met zalen gewijd aan mineralen, insecten (met een vivarium waar je levende vogelspinnen en wandelende takken kunt bewonderen) en schelpen, valt er altijd wat te ontdekken!\r\n\r\nBezoek de website www.natuurwetenschappen.be voor meer informatie over o.a de tijdelijke tentoonstellingen","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of Natural Sciences","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Brussels","address_line1":"Rue Vautier, 29","address_line2":"1000 Brussels","description_web":"Discover nature at the Museum of Natural Sciences in Brussels, where you can explore human nature, our evolution and biology, in the brand new Gallery of Humankind: from Sahelanthropus to Homo sapiens; from embryo to adult. \r\n\r\nBut that\u2019s not all! In the rest of the Museum you\u2019ll find the largest Dinosaur Gallery in Europe, you'll be able to study the 1000+ specimens in the Gallery of Evolution, to dive with gigantic sea lizards from the Cretateuous period in the Mosasaur Room, to embark on an urban safari in BiodiverCITY and to discover 250 years of the history of Natural Sciences through 14 iconic specimens. With rooms dedicated to subjects as diverse as minerals, insects (with the Vivarium where you can observe amongst others live tarantulas and stick insects) and shells, there\u2019s always something to discover in the permanent collections.\r\n\r\nVisit the website www.naturalsciences.be for more information about the temporary exhibitions\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Museum f\u00fcr Naturwissenschaften","address_street_name":"rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"https:\/\/www.naturalsciences.be\/de","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"Naturwissenschaften und Naturgeschichte hautnah im Br\u00fcsseler Museum f\u00fcr Naturwissenschaften mit der gr\u00f6\u00dften Dinosaurierausstellung Europas\r\n\r\nVon den Dinosauriern bis zum Menschen: Lust, einem Mammut in den R\u00fcssel zu schauen, einem Dinosaurier tief in die Augen zu blicken oder in die Haut eines Neandertalers zu schl\u00fcpfen? Das Museum f\u00fcr Naturwissenschaften steckt voller Leben... und voller \u00dcberraschungen. \r\n\r\nDie gr\u00f6\u00dfte Dinosaurierausstellung Europas: Die Dinosauriergalerie mit mehr als drei\u00dfig vollst\u00e4ndigen Skeletten und zahlreichen Dinosaurierfragmenten ist die gr\u00f6\u00dfte Dinosaurierausstellung Europas. Nebenbei erf\u00e4hrt man interessante Details aus dem Leben - und Sterben - der Dinosaurier...\r\n\r\nNeuheiten: Die \u201eGalerie de l'Homme\": Neuste Attraktion ist die \u201eGalerie de l'Homme\" - die Galerie des Menschen, die einen faszinierenden Einblick in 7 Millionen Jahre Menschheitsgeschichte gibt. Vom Embryo zum Erwachsenen - entdecken Sie die Entwicklung und die Evolution bis zum modernen Menschen oder den menschlichen K\u00f6rper und seine Funktionsweise anhand von Fossiliensammlungen, 3D-Nachbildungen und interaktiven Pr\u00e4sentationen. \r\n\r\nDer Mosasaurier-Saal: Die Mosasaurier waren in der Oberkreide eine weltweit verbreitete Gruppe von Meeresreptilien. In dem neuen Saal, der sich unterhalb der Dinosaurier-Galerie befindet, haben Sie Gelegenheit, diese \u201eurzeitlichen K\u00f6nige der Meere\" zu bewundern.\r\n\r\nLeibliches Wohl:\r\n\r\nDer Magen knurrt, die Zunge ist trocken? G\u00f6nnen Sie sich eine kleine Pause im Dino Caf\u00e9.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo di Scienze Naturali","address_street_name":"rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.sciencesnaturelles.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"Il Museo di Scienze naturali di Bruxelles conserva la pi\u00f9 importante collezione di scheletri di dinosauro d\u2019Europa, ma non solo!\r\n\r\nTroverete molti dinosauri tra cui Tirannosauri Rex, Triceratopi e Diplodochi, potrete ammirare anche la vasta collezione di fossili d\u2019Iguanodonti di inestimabile valore, di cui il Belgio \u00e8 estremamente fiero.     \r\n\r\n\r\nDa non perdere: la Nuova Galleria dell\u2019Uomo \r\n\r\nDal Sahelanthropus all'Homo sapiens, dall'embrione all'adulto: nella nuova galleria del museo potete esplorare l\u2019evoluzione dell\u2019uomo e del corpo umano. Quest\u2019area vi d\u00e0 la possibilit\u00e0 di conoscere i cambiamenti che hanno portato all\u2019uomo moderno e l\u2019evoluzione nel corso di 7 milioni di anni, attraverso fossili, video-ricostruzioni 3D, presentazioni interattive.  \r\n\r\nPer saperne di pi\u00f9 \r\n\r\n\r\n\r\nDa vedere anche:\r\n\r\nLa sala dei Mosasauri\r\nQuesta sala di recente costruzione, situata sopra la Galleria dei Dinosauri vi permetter\u00e0 di ammirare i \"re dei mari antichi\", i Mosasauri, gigantesche lucertole marine equivalente acquatico dei dinosauri. \r\n\r\nLa Galleria dei Dinosauri \r\nLa pi\u00f9 grande esposizione di Dinosauri d'Europa, con pi\u00f9 di 30 scheletri di cui alcuni interamente conservati.\r\n\r\nLa Galleria dell'Evoluzione\r\nUn'esposizione unica nel suo genere in Belgio! Circa 600 fossili e 400 animali imbalsamati a testimoniare la biodiversit\u00e0 delle specie animali di milioni di anni.\r\n\r\n250 anni di Scienze naturali\r\nUn percorso all\u2019insegna di 20 testimonianze storico-scientifiche.\r\n  \r\nBiodiverCITY\r\nQuesta sala, dedicata alla biodiversit\u00e0 cittadina, offre un'avventura urbana a grandi e piccini. Dagli 8 anni in su.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Real Instituto Belga de Ciencias Naturales","address_street_name":"rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.scie