_start":"2022-09-08","date_end":"2023-03-18","date_next":"2023-03-16","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"M\u00e9moire","shortdescr":"D\u00e9couvrez vos souvenirs autrement","longdescr":"Un spectacle qui s\u2019inspire de vos souvenirs. Un mot rigolo quand vous \u00e9tiez petit, le lieu de votre premier baiser, l\u2019expression favorite de votre grand-p\u00e8re, le nom du chat de votre ex, l\u2019odeur du grenier de votre maison d\u2019enfance\u2026 et c\u2019est parti !\r\nDans son univers tendre, po\u00e9tique et plein d\u2019humour, Marie-Pierre Thomas interpr\u00e8te avec subtilit\u00e9 les diff\u00e9rents personnages et r\u00e9invente les tranches de votre vie. Elle transforme vos souvenirs en histoires dr\u00f4les, \u00e9mouvantes, surprenantes et singuli\u00e8res.\r\n\u00c0 la batterie, Geoffroy Degand cr\u00e9e une v\u00e9ritable atmosph\u00e8re de cin\u00e9ma, tant sonore que musicale, venant colorer et rythmer ces instants uniques.\r\nVos souvenirs vous surprendront.","performers":"Marie-Pierre Thomas, Geoffroy Degand","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Memoire.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539461"},"nl":{"name":"M\u00e9moire","shortdescr":null,"longdescr":null,"perfor