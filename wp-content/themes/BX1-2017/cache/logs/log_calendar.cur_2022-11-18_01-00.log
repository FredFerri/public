0e9riaux et une agilit\u00e9 spatiale \u2014, elle proc\u00e8de sciemment \u00e0 la mat\u00e9rialisation et \u00e0 l'interrogation de la terreur et de la dignit\u00e9 bafou\u00e9e dans et par la soci\u00e9t\u00e9.\"\nphoto : Lucile Bertrand, Survival Route, 2017. D\u00e9tail","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543703"},"nl":{"name":"Atelier de l'artiste Lucile Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543703"},"en":{"name":"Atelier de l'artiste Lucile Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543703"},"de":{"name":"Atelier de l'artiste Lucile Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543703"},"it":{"name":"Atelier de l'artiste Lucile Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543703"},"sp":{"name":"Atelier de l'artiste Lucile Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543703"},"pt":{"name":"Atelier de l'artiste Lucile Bertrand","shortdescr":null,"longdescr":null,"performers"