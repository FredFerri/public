"Toegankelijk"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["exterior"]},{"id":50012292,"date_start":"2024-08-31","date_end":"2024-08-31","date_next":"2024-08-31","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-07-04T17:22:02+02:00","published_at":"2024-07-04T17:20:11+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303660,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Bruxelles VS Bruxellisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012292"},"pt":{"name":"Bruxelles VS Bruxellisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012292"},"en":{"name":"Bruxelles VS Bruxellisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012292"},"it":{"name":"Bruxelles VS Bruxellisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012292"},"cn":{"name":"Bruxelles VS Bruxellisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012292"},"fr":{"name":"Bruxelles VS Bruxellisation","shortdescr":"Faire de Bruxelles une grande ville tertiaire, capitale europ\u00e9enne au croisement des flux internationaux : tel est le projet \u00e9conomique et urbanistique \u00e0 l\u2019\u0153uvre au lendemain de la 2de Guerre Mondiale. Quel h\u00e9ritage donner aujourd'hui \u00e0 la Bruxellisation ?","longdescr":"Faire de Bruxelles une grande ville tertiaire, capitale europ\u00e9enne au croisement des flux internationaux : tel est le projet \u00e9conomique et urbanistique \u00e0 l\u2019\u0153uvre au lendemain de la 2de Guerre Mondiale. Le centre-ville historique, le quartier L\u00e9opold, les boulevards de petite ceinture, les quartiers de gare, toute la ville est concern\u00e9e par ce mouvement de destruction et de modernisation urbanistique. Aujourd\u2019hui, les grands travaux r\u00e9alis\u00e9s durant cette p\u00e9riode sont commun\u00e9ment d\u00e9sign\u00e9s sous le terme de \u00ab Bruxellisation \u00bb, \u00e0 savoir la transformation brutale et la division fonctionnelle de la ville au d\u00e9pend de ses habitants. Cette vision fonctionnaliste, d\u00e9connect\u00e9e du tissu urbain traditionnel, a historiquement \u00e9t\u00e9 d\u00e9nonc\u00e9e par l\u2019ARAU.\n\nPlus d\u2019un demi-si\u00e8cle plus tard, la Bruxellisation est un h\u00e9ritage avec lequel il faut tant bien que mal composer. Les constructions de l\u2019\u00e9poque constituent un patrimoine architectural important pour Bruxelles et sur lequel il faut miser pour r\u00e9investir ces quartiers d\u2019une urbanit\u00e9. Pour autant, les propositions des pouvoirs publics promouvant la mixit\u00e9 fonctionnelle peinent \u00e0 convaincre tant elles reproduisent des m\u00e9thodes et des projets d\u00e9pass\u00e9s.\n\nQuel h\u00e9ritage donner alors \u00e0 la Bruxellisation ? Et quels sont les \u00e9cueils que nous devons confronter aujourd\u2019hui pour l\u2019avenir de ces quartiers ? Ce sont les questions auxquelles nous essaierons de r\u00e9pondre au cours de la visite !\n\nLieu de d\u00e9part : Au centre de la place Rogier (devant l\u2019entr\u00e9e principale du Starbucks), 1000 Bruxelles","performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012292"},"sp":{"name":"Bruxelles VS Bruxellisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012292"},"nl":{"name":"Bruxelles VS Bruxellisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012292"}},"place":{"id":236549,"translations":{"de":{"name":"Place Rogier","address_street_name":"Place Rogier","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","des