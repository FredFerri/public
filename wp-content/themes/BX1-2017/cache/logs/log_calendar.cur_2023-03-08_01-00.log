[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La vie quotidienne \u00e0 L'h\u00f4tel Solvay","shortdescr":"Cette visite vous permettra  de vous imaginer la vie quotidienne des propri\u00e9taires de cet h\u00f4tel de ma\u00eetre mais aussi celle de leurs domestiques, petites mains qui profitaient des innovations techniques mises en place par Horta pour servir leurs ma\u00eetres plus facilement.","longdescr":"De 1894 \u00e0 1898, Victor Horta construit pour Armand Solvay, le fils du c\u00e9l\u00e8bre industriel Ernest Solvay, le plus prestigieux des h\u00f4tels de ma\u00eetre Art nouveau \u00e0 Bruxelles. Construction majeure du ma\u00eetre de l'Art nouveau Victor Horta, il a la chance d'avoir conserv\u00e9 tous ses \u00e9l\u00e9ments d'origine : mobilier, luminaires, tentures et objets d'art de l'\u00e9poque.\r\nCette visite vous permettra de vous imaginer la vie quotidienne des propri\u00e9taires de cet H\u00f4tel de ma\u00eetre mais aussi celle de leurs domestiques, petites mains qui profitaient des innovations techniques mises en place par Horta pour servir leurs ma\u00eetres plus facilement.\r\nClass\u00e9 au patrimoine mondial de l'UNESCO, c'est un \u00e9crin unique, o\u00f9 la notion d'art total prend ici tout son sens.\r\n\r\nLes enfants de -16 ans ne sont pas admis.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-vie-quotidienne-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547519"},"nl":{"name":"La vie quotidienne \u00e0 L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-vie-quotidienne-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547519"},"en":{"name":"La vie quotidienne \u00e0 L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-vie-quotidienne-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547519"},"de":{"name":"La vie quotidienne \u00e0 L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-vie-quotidienne-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547519"},"it":{"name":"La vie quotidienne \u00e0 L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-vie-quotidienne-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547519"},"sp":{"name":"La vie quotidienne \u00e0 L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-vie-quotidienne-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547519"},"pt":{"name":"La vie quotidienne \u00e0 L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-vie-quotidienne-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547519"},"cn":{"name":"La vie quotidienne \u00e0 L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-vie-quotidienne-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547519"}},"place":{"id":261979,"translations":{"fr":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architecte: Victor Horta - 1895\/1898\r\nCette demeure luxueuse fut construite par Victor Horta en 1894 pour le fils de l\u2019industriel Ernest Solvay. L\u2019architecte re\u00e7ut \u201ccarte blanche\u201d et con\u00e7ut l\u2019int\u00e9rieur et le mobilier jusque dans les moindres d\u00e9tails. Sur la fa\u00e7ade, deux bow-windows sym\u00e9triques s\u2019\u00e9l\u00e8vent sur deux \u00e9tages et sont surmont\u00e9s de balcons. A l\u2019int\u00e9rieur, c\u2019est un feu d\u2019artifices visuel. La gamme des tons rouge-orange renforce l\u2019atmosph\u00e8re de luxe et de confort. A voir absolument.\r\n\r\nAttention : Les enfants de -12ans ne sont pas admis aux visites guid\u00e9es\r\n\r\n","description_print":"","booking_url":"https:\/\/shop.utick.be\/?module=ACTIVITYSERIEDETAILS&pos=HOTELSOLVAY&s=FD4F8FAE-82B7-FAE7-6E67-660D3DA1A04B&lg=FR","sort_order":null,"virtual_visit":null},"nl":{"name":"Solvay Herenhuis","address_street_name":"Louizalaan","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Louizalaan, 224","address_line2":"1050 Elsene","description_web":"Architect: Victor Horta - 1895\/1898\r\nVictor Horta bouwde dit luxueuze herenhuis in 1894 voor de zoon van de industrieel Ernest Solvay. De architect kreeg carte blanche voor dit project. Hij ontwierp het interieur en het meubilair tot in de kleinste details. Op de gevel lopen twee symmetrische erkers over twee verdiepingen, met daarboven balkons. Binnen wacht een visueel vuurwerk. Het palet van rood- en oranjetinten zet de sfeer van luxe en comfort nog sterker in de verf. Een bezoek meer dan waard.\r\n\r\nBelangrijke opmerking : Kinderen jonger dan 12 jaar mogen niet deelnemen aan rondleidingen.\r\n","description_print":"","booking_url":"https:\/\/shop.utick.be\/?module=ACTIVITYSERIEDETAILS&pos=HOTELSOLVAY&s=FD4F8FAE-82B7-FAE7-6E67-660D3DA1A04B&lg=NL","sort_order":null,"virtual_visit":null},"en":{"name":"Solvay House","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architect: Victor Horta - 1895\/1898 \r\nThis luxury townhouse was built by Victor Horta in 1894 for the son of captain of industry Ernest Solvay. The architect was given \u201ccarte blanche\u201d and designed the interior and the furniture down to the smallest detail. On the fa\u00e7ade, two symmetric bow windows surmounted by balconies are seen to protrude across two floors. Indoors it is a visual extravaganza, with the sheer range of red-orange hues on offer only acting to underpin the atmosphere of luxury and comfort. A must-see building. \r\n\r\nPlease note : Children under 12 years of age are not admitted to the guided tours.\r\n","description_print":"","booking_url":"https:\/\/shop.utick.be\/?module=ACTIVITYSERIEDETAILS&pos=HOTELSOLVAY&s=FD4F8FAE-82B7-FAE7-6E67-660D3DA1A04B&lg=EN","sort_order":null,"virtual_visit":null},"de":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architekt: Victor Horta - 1895\/1898\r\nDieses luxuri\u00f6se Anwesen wurde 1894 von Victor Horta f\u00fcr den Sohn des Unternehmers Ernest Solvay erbaut. Dem Architekten wurde vollkommen freie Hand gelassen und bei der bis ins kleinste Detail durchdachten Innenausstattung und dem Mobiliar \u00fcberlie\u00df er nichts dem Zufall. Die Fassade wird von zwei symmetrischen Erkern geziert, die sich \u00fcber zwei Etagen erstrecken. Dar\u00fcber befinden sich zwei Balkone. Im Interieur erwartet den Besucher ein optisches Feuerwerk. Die Farbpalette zwischen Rot- und Oranget\u00f6nen verst\u00e4rkt noch den Eindruck von Luxus und Komfort. Ein Besuch lohnt sich! ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architetto Victor Horta \u2013 1895 \/ 1898 \r\nQuesta lussuosa villa \u00e9 stata costruita da Victor Horta nel 1894 per il figlio dell\u2019industriale Ernest Solvay. L\u2019architetto ha ricevuto totale libert\u00e0 e ha concepito l\u2019interno e i mobili nei minimi dettagli. Sulla facciata, due \u201cbow-window\u201d simetriche si elevano su due piani e sono superate da balconi. Al interno, \u00e9 un fuoco d'artificio visivo. La gamma dei toni rossi \u2013 arrancione rinforza l\u2019atmosfera di lusso e di conforto. Da vedere assolutamente. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Arquitecto: Victor Horta - 1895\/1898\r\nEsta lujosa mansi\u00f3n fue construida por Victor Horta en 1894 para el hijo del empresario Ernest Solvay. El arquitecto recibi\u00f3 carta blanca y concibi\u00f3 el interior y el mobiliario hasta el \u00faltimo detalle. En la fachada, dos miradores sim\u00e9tricos se elevan sobre los dos pisos y los balcones. El interior es una maravilla visual. La gama de los tonos rojo-naranja refuerza la atm\u00f3sfera de lujo y de confort. Una visita imprescindible.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translati