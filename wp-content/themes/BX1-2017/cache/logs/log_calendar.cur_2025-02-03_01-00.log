r":["lundi et mardi: ferm\u00e9","mercredi, jeudi et vendredi: de 10:00 \u00e0 18:00","samedi et dimanche: de 11:00 \u00e0 19:00"],"nl":["maandag en dinsdag: gesloten","woensdag, donderdag en vrijdag: van 10:00 tot 18:00","zaterdag en zondag: van 11:00 tot 19:00"]},"date_start":"2024-11-07","date_end":"2025-02-16","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2024-11-06","start":"17:00:00","timestamp":"2024-11-06T17:00:00"}},{"id":5700005106,"date_start":"2025-01-27","date_end":"2025-05-11","date_next":"2025-02-02","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-02T01:02:16+01:00","published_at":"2025-01-10T13:50:24+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":315677,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"other","ranking":0.2670629030097325,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Cin\u00e9mas Art D\u00e9co at  Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005106"},"pt":{"name":"Cin\u00e9mas Art D\u00e9co at  Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005106"},"en":{"name":"Cin\u00e9mas Art D\u00e9co at  Brussels","shortdescr":null,"longdescr":"From the end of the 1920s, cinemas were the meeting point between cinema and architecture, thanks to the advent of Art Deco. The needs of cinema operators in terms of volume, acoustics and decor for sound cinema, as well as the desire for comfort and prestige, were matched by the innovative construction techniques and aesthetics of Art Deco. The result is an architecture of dreams, inside and out.\n\nVisitors will enter this magical world through written and visual evocations of the great \u2018first exclusive\u2019 city-centre cinemas of the period, such as the Plaza, the M\u00e9tropole, the Eldorado, the Vari\u00e9t\u00e9s and the Cin\u00e9ma des Galeries.\n\nPeriod images will resonate with contemporary photographs by Marie-Fran\u00e7oise Plissart taken for the book Cin\u00e9mas de Bruxelles by Isabel Biver & Marie-Fran\u00e7oise Plissart (2020, CFC-Editions) and those by Joan Bracco.\n\nThis period can be seen and experienced through the voices and quotes of spectators, notably through the Cin\u00e9mas de Bruxelles augment\u00e9s installation by Christian Ch\u00e2tel, Christl Lidl and Isabel Biver, where audiences will be able to immerse themselves in an immersive device to see and hear testimonies illustrating nine major Brussels cinemas.","performers":null,"boxoffice_url":null,"website":"https:\/\/en.hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005106"},"it":{"name":"Cin\u00e9mas Art D\u00e9co at  Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005106"},"cn":{"name":"Cin\u00e9mas Art D\u00e9co at  Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005106"},"fr":{"name":"Cin\u00e9mas Art D\u00e9co \u00e0 Bruxelles","shortdescr":null,"longdescr":"D\u00e8s la fin des ann\u00e9es 20, les cin\u00e9mas constituent le point de rencontre entre le cin\u00e9ma et l\u2019architecture gr\u00e2ce \u00e0 l\u2019av\u00e8nement de l\u2019Art D\u00e9co. Les besoins des exploitants de salles, en termes de volume, d\u2019acoustique et de d\u00e9cor pour le cin\u00e9ma sonore, ainsi que l\u2019ambition de confort et de prestige, \u00e9pousent les techniques constructives et l\u2019esth\u00e9tique novatrices de l\u2019Art D\u00e9co. Cette rencontre cr\u00e9e une architecture du r\u00eave, \u00e0 l\u2019int\u00e9rieur comme \u00e0 l\u2019ext\u00e9rieur de la salle.\n\nLes visiteurs.euses entreront dans cet univers magique \u00e0 travers l\u2019\u00e9vocation \u00e9crite et visuelle des grandes salles d'exclusivit\u00e9s du centre-ville de cette \u00e9poque, comme le Plaza, le M\u00e9tropole, l\u2019Eldorado, les Vari\u00e9t\u00e9s, ou encore le Cin\u00e9ma des Galeries.\n\nDes images d\u2019\u00e9poque r\u00e9sonneront avec les photographies contemporaines de Marie-Fran\u00e7oise Plissart r\u00e9alis\u00e9es pour le livre Cin\u00e9mas de Bruxelles d\u2019Isabel Biver & Marie-Fran\u00e7oise Plissart (2020, CFC-Editions) et celles de Joan Bracco.\n\nCette p\u00e9riode sera \u00e0 voir mais aussi \u00e0 vivre, par des voix-citations de spectateurs notamment au moyen de l\u2019installation Cin\u00e9mas de Bruxelles augment\u00e9s de Christian Ch\u00e2tel, Christl Lidl et Isabel Biver o\u00f9 les publics pourront s\u2019installer dans un dispositif immersif pour voir et \u00e9couter des t\u00e9moignages illustrant neuf grands cin\u00e9mas bruxellois.","performers":"\u2022 Commissariat : Isabel Biver\/ Photographies : Marie-Fran\u00e7oise Plissart\/ Sc\u00e9nographie :\nArchitecture particuli\u00e8re, Aur\u00e9lie Ranalli\/ Graphisme : Mix&Match, Juliette de Patoul.\n\u2022 Production : Halles Saint-G\u00e9ry, Sint-Gorikshallen.\n\u2022 Partenaires : urban.brussels, Fibrocit, UGC, Banad, Arkadia, Brussels Art d\u00e9co Society.","boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005106"},"sp":{"name":"Cin\u00e9mas Art D\u00e9co at  Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005106"},"nl":{"name":"Cin\u00e9mas Art D\u00e9co te Brussel","shortdescr":null,"longdescr":"Vanaf het einde van de jaren 1920 waren bioscopen het ontmoetingspunt tussen bioscoop en architectuur, dankzij de opkomst van de art deco. De behoeften van bioscoopexploitanten op het gebied van volume, akoestiek en decor voor geluidsbioscopen, evenals het verlangen naar comfort en prestige, werden gekoppeld aan de innovatieve bouwtechnieken en esthetiek van de art deco. Het resultaat is een droomarchitectuur, van binnen en van buiten.\n\nBezoekers betreden deze magische wereld via schriftelijke en visuele evocaties van de grote 'eerste exclusieve' bioscopen in stadscentra uit die tijd, zoals de Plaza, de M\u00e9tropole, de Eldorado, de Vari\u00e9t\u00e9s en de Cin\u00e9ma des Galeries.\n\nBeelden uit die tijd zullen resoneren met hedendaagse foto's van Marie-Fran\u00e7oise Plissart die gemaakt zijn voor het boek Cin\u00e9mas de Bruxelles by Isabel Biver & Marie-Fran\u00e7oise Plissart (2020, CFC-Editions) en die van Joan Bracco.\n\nDeze periode is te zien en te beleven via de stemmen en citaten van toeschouwers, met name via de installatie Cin\u00e9mas de Bruxelles augment\u00e9s van Christian Ch\u00e2tel, Christl Lidl en Isabel Biver, waar het publiek zich kan onderdompelen in een immersief apparaat om getuigenissen te zien en te horen die negen grote Brusselse bioscopen illustreren.","performers":null,"boxoffice_url":null,"website":"https:\/\/sintgorikshallen.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005106"}},"place":{"id":247371,"translations":{"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Brussels","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi...\r\nLe Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi. Sotto il patrocinio della regione di Bruxelles Capitale.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Remarquable t\u00e9moin de l\u2019architecture des march\u00e9s couverts, les Halles Saint-G\u00e9ry  contribuent \u00e0 valoriser le patrimoine de la R\u00e9gion de Bruxelles-Capitale. Centre d\u2019exposition et de manifestation bas\u00e9 en plein coeur du pentagone, elles ont pour vocation de mettre en valeur les traits de d\u00e9marcation du cadre de vie bruxellois et de son identit\u00e9 urbaine par le biais d'une programmation hybride, allant des expositions, aux conf\u00e9rences, concerts, rencontres et performances \u2026\r\nLe Centre Urbain (guichet d\u2019information r\u00e9gional, pour mieux vous conseiller sur l\u2019habitat durable en R\u00e9gion de Bruxelles-Capitale) est \u00e9galement situ\u00e9 au sein des Halles.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Verdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio...\r\nVerdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio y al marco de vida de los bruselenses.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Sint-Gorikshallen","address_street_name":"Sint-Goriksplein","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sint-Goriksplein","address_line2":"1000 Brussel","description_web":"De Sint-Gorikshallen zijn een prachtig architecturaal staaltje van openbare markthallen in het 19de-eeuwse Brussel. Het gebouw werd een aantal jaren geleden volledig gerestaureerd en doet tegenwoordig dienst als permanente informatie-, tentoonstellings- en evenementenruimte gewijd aan het erfgoed en de levenswijzen in de hoofdstad. Op amper twee minuten stappen van de Beurs vormen de Sint-Gorikshallen een gezellige plek om te ontspannen en nieuwe dingen te ontdekken, zowel overdag als bij het vallen van de nacht.\r\nDe hallen herbergen ook de Stadswinkel, een vereniging die de inwoners van het Brussels Hoofdstedelijk Gewest  wil informeren over het leefmilieu en een kwaliteitsvolle leefomgeving, huisvesting, stadsrenovatie, stedenbouw en ruimtelijke ordening, en rationeel energiegebruik. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":9562,"location":{"lat":50.84801328,"lon":4.34683241},"region":"brussels","last_updated_at":"2024-05-08T15:56:31+02:00","published_at":"2013-10-19T01:26:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231476,"translations":{"de":{"name":"Halles Saint-G\u00e9ry Culture et Patrimoine ASBL","address_street_name":"Place Saint-G\u00e9ry","address_street_number":"23","address_street_box":null,"