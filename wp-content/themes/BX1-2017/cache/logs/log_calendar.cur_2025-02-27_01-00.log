"de":["Grafische K\u00fcnste","Kunstgalerien"],"pt":[null,null],"en":["Graphic art","Art Galleries"],"it":["Arti grafiche","Gallerie d'arte"],"cn":[null,null],"fr":["Arts graphiques","Galeries d'art"],"sp":["Artes gr\u00e1ficas","Galer\u00edas de arte"],"nl":["Grafische kunst, vormgeving","Galeries"]}}},"translations":{"de":{"name":"Vernissage Soir\u00e9es Surr\u00e9alistes - Illustrated poster exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.grafik.brussels","email":"hello@grafik.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006168"},"pt":{"name":"Vernissage Soir\u00e9es Surr\u00e9alistes - Illustrated poster exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.grafik.brussels","email":"hello@grafik.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006168"},"en":{"name":"Vernissage Soir\u00e9es Surr\u00e9alistes - Illustrated poster exhibition","shortdescr":"Join us for the grand opening of the Soir\u00e9es Surr\u00e9alistes exhibition, celebrating 100 years of surrealism in Brussels! Over the past months, eight illustrators have immersed themselves in surrealist salons, discussing, writing and drawing to create socially engaged posters inspired by the city and Brussels citizens. The posters will be exhibited at Grafik, PassaPorta, Luca School of Arts & COOP.","longdescr":"Join us for the grand opening of the Soir\u00e9es Surr\u00e9alistes exhibition, celebrating 100 years of surrealism in Brussels! Over the past months, eight illustrators have immersed themselves in surrealist salons, discussing, writing and drawing to create socially engaged posters inspired by the city and Brussels citizens.\n\nNow, we invite you to discover their final works\u2014unique 50x70cm posters, each reflecting a different urban theme linked to Brussels and surrealism. The posters will be exhibited at Grafik, PassaPorta, Luca School of Arts & COOP and available for purchase.\n\nExhibited illustrators : Sergio Men\u00e9ndez, Morgane Griffoul, Wide Vercnocke ism Vincent van Meenen, No\u00e9mie Fatio, TraMA Print, Gw\u00e9nola Carr\u00e8re, Lukas Verstraete, Paulynka.\n\nOpening Night Programme:\n\nVenue: Grafik\nDate: 20 February 2025\nTime: 19:00 - 22:00\nDrinks & live music\nExhibition of the posters on 8 different topics\nPresentation of the artists & their themes & creative process\n\nStep into the surreal, explore the power of illustration, and celebrate a century of surrealism with us!\n\nHosted by: Grafik.brussels Follow: @Grafik1030 (Insta\/LinkedIn)\nPartners: @passaporta | @comicartmuseumbxl | @pentel_belgium | @cuarenta | @luca.schoolofarts\nWith the support of: VGC Kunsten I La Loterie Nationale","performers":"Exhibited illustrators : Sergio Men\u00e9ndez, Morgane Griffoul, Wide Vercnocke ism Vincent van Meenen, No\u00e9mie Fatio, TraMA Print, Gw\u00e9nola Carr\u00e8re, Lukas Verstraete, Paulynka.","boxoffice_url":null,"website":"https:\/\/www.grafik.brussels","email":"hello@grafik.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006168"},"it":{"name":"Vernissage Soir\u00e9es Surr\u00e9alistes - Illustrated poster exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.grafik.brussels","email":"hello@grafik.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006168"},"cn":{"name":"Vernissage Soir\u00e9es Surr\u00e9alistes - Illustrated poster exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.grafik.brussels","email":"hello@grafik.brussels","phone_contact":null,"phone_booking":null,"age