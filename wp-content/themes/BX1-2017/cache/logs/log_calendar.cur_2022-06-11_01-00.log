ate_end":"2022-07-10","date_next":"2022-07-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Les coulisses de l\u2019Ommegang","shortdescr":null,"longdescr":"Deux heures avant l\u2019Ommegang, vous pourrez admirer et vivre les derniers pr\u00e9paratifs de ce spectacle comm\u00e9moratif. Votre guide d\u00e9chiffrera pour votre plaisir le Grand Serment des Arbal\u00e9triers, les luttes \u00e9questres, les corporations de l\u2019\u00e9poque, les rites de la cour de Charles Quint, etc. Suite \u00e0 cette introduction, nous vous invitons \u00e0 assister \u00e0 la sortie de l\u2019Ommegang dans le centre de la ville.\r\n\r\nMise \u00e0 disposition d'un guide pendant 2h.","performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":"+32 2 541 03 77","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532818.html"},"nl":{"name":"Achter de schermen van de Ommegang","shortdescr":null,"longdescr":"Twee uur voor de start van de Ommegang kan je de laatste voorbereidingen rond dit herdenkingsspektakel bewonderen en beleven. Jouw gids vertelt honderduit over de Grote Eed van de Schuttersgilde, de ruiterstornooien, de gilden uit die tijd, de gebruiken aan het hof van keizer Karel enzovoort . Na die inleiding kan je de Ommegang in het centrum van de stad meemaken. \r\n\r\nTerbeschikkingstelling van een gids gedurende 2 uur.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532818.html"},"en":{"name":"Behind the scenes of the Ommegang","shortdescr":null,"longdescr":"Two hours before the Ommegang, you get to see the final preparations for this commemorative spectacle. Prepare for a first-hand experience, with your guide on hand to explain the background of the Grand Serment (Great Guild) of the crossbowmen, sword fights on horseback, the guilds of the day, the rites of Charles V\u2019s court and more. And after this introduction, we invite you to see the Ommegang pageant set out on its way to the city centre. \r\n\r\n\u20ac160 for a guide for 2 hours.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532818.html"},"de":{"name":"Les coulisses de l\u2019Ommegang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532818.html"},"it":{"name":"Les coulisses de l\u2019Ommegang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532818.html"},"sp":{"name":"Los entresijos del Ommegang","shortdescr":null,"longdescr":"Dos horas antes del Ommegang, podr\u00e1s admirar y experimentar los \u00faltimos preparativos de este espect\u00e1culo conmemorativo. Tu gu\u00eda te descifrar\u00e1 el Gran Juramento de los Ballesteros, las luchas ecuestres, los gremios de la \u00e9poca, los ritos de la corte de Carlos V, etc. Despu\u00e9s de esta introducci\u00f3n, te invitamos a ver el recorrido del Ommegang por el centro de la ciudad.  \r\n\r\nPuesta a disposici\u00f3n de un gu\u00eda durante 2 horas.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"