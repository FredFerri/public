_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Halloween Party","shortdescr":"Soir\u00e9e d\u00e9guis\u00e9e sur le th\u00e8me d'Halloween","longdescr":"Le mus\u00e9e de la M\u00e9decine a besoin de vous ! La cl\u00e9 de sa r\u00e9serve a \u00e9t\u00e9 d\u00e9rob\u00e9e par un fant\u00f4me farceur\u2026 Avec ses amis, il vous met au d\u00e9fi de relever quatre \u00e9preuves pour la retrouver ! Pr\u00e9parez votre d\u00e9guisement, armez-vous de courage et d\u00e9couvrez le mus\u00e9e comme vous ne l\u2019avez jamais vu.  \r\nEv\u00e9nement gratuit accessible aux enfants et grands enfants \u00e0 partir de 6 ans.  N'oubliez pas de r\u00e9server soit par t\u00e9l\u00e9phone au 02\/555.34.31 soit par mail : brigitte.dhossche@erasme.ulb.ac.be","performers":"L'\u00e9quipe du Mus\u00e9e de la M\u00e9decine","boxoffice_url":null,"website":"http:\/\/www.museemedecine.be\/","email":"museemedecine@erasme.ulb.ac.be","phone_contact":"+32 2 555 34 31","phone_booking":"+32 2 555 34 31","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542937"},"nl":{"name":"Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542937"},"en":{"name":"Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542937"},"de":{"name":"\u00a3Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542937"},"it":{"name":"\u00a3Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542937"},"sp":{"name":"\u00a3Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542937"},"pt":{"name":"\u00a3Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542937"},"cn":{"name":"\u00a3Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542937"}},"place":{"id":230242,"translations":{"fr":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"Le Mus\u00e9e de la M\u00e9decine s\u2019adresse \u00e0 tous les passionn\u00e9s, experts ou simples curieux de la m\u00e9decine et de la pens\u00e9e m\u00e9dicale dans l\u2019art, l\u2019histoire et la litt\u00e9rature, de l\u2019Antiquit\u00e9 \u00e0 nos jours.\r\nLa proximit\u00e9 avec l\u2019h\u00f4pital Erasme permet au Mus\u00e9e de restituer ses objets en radiographies fascinantes, r\u00e9v\u00e9lant les secrets de leur composition, comme \u00ab l\u2019Ecorch\u00e9 \u00bb du Dr Auzoux, le nouveau chef-d\u2019\u0153uvre du mus\u00e9e!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Geneeskundemuseum (ULB)","address_street_name":"Lennikse Baan","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Lennikse Baan, 808","address_line2":"1070 Anderlecht","description_web":"Het Geneeskundemuseum is niet alleen een must voor experten, maar voor iedereen die geboeid is door of nieuwsgierig is naar geneeskunde. Het museum biedt een overzicht van de Oudheid tot vandaag en ook de invloed van geneeskunde op de kunsten, geschiedenis en literatuur komt aan bod. Dankzij de nabijheid van het Erasmusziekenhuis kon het museum ro\u0308ntgenfoto\u2019s maken van enkele van zijn voorwerpen, wat unieke beelden geeft van hun samenstelling. Een mooi voorbeeld hiervan is het anatomisch spiermodel van Dr Auzoux, het nieuwe topstuk van het museum!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"The Museum of Medicine is intended for all enthusiasts, experts or simply anyone interested in medicine and medical thinking featured in art, history and literature, from antiquity to the present day.\r\nIts proximity to Erasmus Hospital allows the museum to reconstruct its items in fascinating X-rays, revealing the secrets of their composition, such as the museum\u2019s latest masterpiece, Dr Auzoux\u2019s \"Ecorch\u00e9\"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"Das Medizinmusem richtet sich an alle medizinisch interessierten Besucher. Theamtisch abgedeckt wird nicht nur die Medizin, sondern auch die medizinische Denkweise in Kunst, Geschichte und Literatur - von der Antike bis zur Gegenwart.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo de Medicina (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"El Museo de Medicina est\u00e1 destinado para todos los entusiastas, expertos o simplemente interesados en la medicina y el pensamiento m\u00e9dico representado en el arte, la historia y la literatura, desde la antig\u00fcedad hasta la actualidad.\r\nSu cercan\u00eda con el Hospital Erasmus permite al museo reconstruir sus art\u00edculos en fascinantes rayos X, revelando los secretos de su composici\u00f3n, por ejemplo, la \u00faltima obra maestra del museo, \"Ecorch\u00e9\" de Dr Auzoux.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":842,"location":{"lat":50.81365646,"lon":4.26640357},"region":"brussels","last_updated_at":"2022-10-11T02:06:29+02:00","published_at":"2013-10-19T01:13:50+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":230242,"translations":{"fr":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"Le Mus\u00e9e de la M\u00e9decine s\u2019adresse \u00e0 tous les passionn\u00e9s, experts ou simples curieux de la m\u00e9decine et de la pens\u00e9e m\u00e9dicale dans l\u2019art, l\u2019histoire et la litt\u00e9rature, de l\u2019Antiquit\u00e9 \u00e0 nos jours.\r\nLa proximit\u00e9 avec l\u2019h\u00f4pital Erasme permet au Mus\u00e9e de restituer ses objets en radiographies fascinantes, r\u00e9v\u00e9lant les secrets de leur composition, comme \u00ab l\u2019Ecorch\u00e9 \u00bb du Dr Auzoux, le nouveau chef-d\u2019\u0153uvre du mus\u00e9e!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Geneeskundemuseum (ULB)","address_street_name":"Lennikse Baan","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Lennikse Baan, 808","address_line2":"1070 Anderlecht","description_web":"Het Geneeskundemuseum is niet alleen een must voor experten, maar voor iedereen die geboeid is door of nieuwsgierig is naar geneeskunde. Het museum biedt een overzicht van de Oudheid tot vandaag en ook de invloed van geneeskunde op de kunsten, geschiedenis en literatuur komt aan bod. Dankzij de nabijheid van het Erasmusziekenhuis kon het museum ro\u0308ntgenfoto\u2019s maken van enkele van zijn voorwerpen, wat unieke beelden geeft van hun samenstelling. Een mooi voorbeeld hiervan is het anatomisch spiermodel van Dr Auzoux, het nieuwe topstuk van het museum!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"The Museum of Medicine is intended for all enthusiasts, experts or simply anyone interested in medicine and medical thinking featured in art, history and literature, from antiquity to the present day.\r\nIts proximity to Erasmus Hospital allows the museum to reconstruct its items in fascinating X-rays, revealing the secrets of their composition, such as the museum\u2019s latest masterpiece, Dr Auzoux\u2019s \"Ecorch\u00e9\"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"Das Medizinmusem richtet sich an alle medizinisch interessierten Besucher. Theamtisch abgedeckt wird nicht nur die Medizin, sondern auch die medizinische Denkweise in Kunst, Geschichte und Literatur - von der Antike bis zur Gegenwart.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 