 paniers de basket, ou encore trouver les boutons lumineux cach\u00e9s dans une piscine \u00e0 balle, il y a aussi un m\u00e9mory musical, compos\u00e9 des mots sur un clavier g\u00e9ant au sol... ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002033"},"sp":{"name":"1 heure de Team Game 150% Fun pour 2 Personnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002033"},"nl":{"name":"1 heure de Team Game 150% Fun pour 2 Personnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002033"}},"place":{"id":267946,"translations":{"de":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Galerie Carrefour Shopping Saint Michel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_