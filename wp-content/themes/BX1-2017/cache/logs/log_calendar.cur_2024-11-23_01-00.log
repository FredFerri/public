"date_next":"2024-11-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-08T16:37:01+01:00","published_at":"2024-11-08T16:18:17+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311218,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.29744417462950146,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[112],"translations":{"de":["Ausgefallenes"],"pt":[null],"en":["Unusual"],"it":["Insolito"],"cn":[null],"fr":["Insolite"],"sp":["Ins\u00f3lito"],"nl":["Ongewoon"]}}},"translations":{"de":{"name":"Tour de No\u00ebl Tootbus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bit.ly\/4fFXsBx","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003456"},"pt":{"name":"Tour de No\u00ebl Tootbus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bit.ly\/4fFXsBx","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003456"},"en":{"name":"Christmas Tour TOOTBUS","shortdescr":"Immerse yourself in the magic of Christmas in Brussels with Tootbus aboard one of its 100% electric panoramic buses. Discover the festive city during this magical time and experience the unique holiday spirit while admiring the iconic landmarks of the capital. Let yourself be carried away by the warm atmosphere of Brussels and enjoy an unforgettable experience this season!","longdescr":"Immerse yourself in the enchanting Christmas spirit of Brussels with Tootbus and its 100% electric panoramic buses. Let yourself be carried away by the warm atmosphere of the historic streets, where every corner of the city reveals a unique and authentic charm. A guide in French and English accompanies you, sharing captivating anecdotes, while Christmas music enhances this immersive experience.\n\nThis approximately one-hour non-stop tour allows you to discover the city in a new light and experience the magic of the holiday season, all in optimal comfort and with respect for the environment. This tour is the perfect opportunity to dive into Brussels' festive ambiance and enjoy a unique experience, filled with holiday cheer that will make your festive season an unforgettable memory.\n\nSo, hop on board this unique experience and let yourself be carried away on this adventure! Book now through this link and enjoy a special Christmas discount on your tickets: https:\/\/bit.ly\/4fFXsBx","performers":"Winterwonders, Christmas Market","boxoffice_url":null,"website":"https:\/\/bit.ly\/4fFXsBx","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003456"},"it":{"name":"Tour de No\u00ebl Tootbus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bit.ly\/4fFXsBx","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003456"},"cn":{"name":"Tour de No\u00ebl Tootbus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bit.ly\/4fFXsBx","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003456"},"fr":{"name":"Tour de No\u00ebl TOOTBUS","shortdescr":"Plongez dans la magie de No\u00ebl \u00e0 Bruxelles avec Tootbus \u00e0 bord d'un de ses bus panoramique 100% \u00e9lectrique. D\u00e9couvrez la ville festive en cette p\u00e9riode f\u00e9erique et vivez l\u2019esprit unique des f\u00eates en admirant les sites embl\u00e9matiques de la capitale. Laissez-vous porter par l'atmosph\u00e8re chaleureuse de Bruxelles et profitez d\u2019une exp\u00e9rience inoubliable en cette saison ! ","longdescr":"Plongez dans l\u2019esprit enchanteur de No\u00ebl \u00e0 Bruxelles gr\u00e2ce \u00e0 Tootbus et ses bus panoramiques 100% \u00e9lectriques. Laissez-vous porter par l'atmosph\u00e8re chaleureuse des rues historiques o\u00f9 chaque coin de la ville d\u00e9voile un charme unique et authentique. Un guide en fran\u00e7ais et anglais vous accompagne pour enrichir votre d\u00e9couverte avec des anecdotes captivantes, tandis qu\u2019une ambiance musicale de No\u00ebl compl\u00e8te cette exp\u00e9rience immersive.\n\nCe tour d'environ une heure sans arr\u00eat vous permet de d\u00e9couvrir la ville sous un nouveau jour et de vivre la magie des f\u00eates, le tout dans un confort optimal et dans le respect de l\u2019environnement. Cette visite est l\u2019occasion parfaite pour plonger dans l\u2019ambiance conviviale de Bruxelles et profiter d\u2019une exp\u00e9rience in\u00e9dite, marqu\u00e9e par l\u2019esprit festif qui fera de votre saison des f\u00eates un souvenir imp\u00e9rissable.\n\nAlors, montez \u00e0 bord de cette exp\u00e9rience unique, et laissez-vous emporter dans cette aventure ! R\u00e9servez d\u00e8s maintenant via ce lien et profitez d\u2019un discount sp\u00e9cial No\u00ebl sur vos billets : https:\/\/bit.ly\/4fFXsBx","performers":"Plaisirs d'Hiver, March\u00e9 de No\u00ebl","boxoffice_url":null,"website":"https:\/\/bit.ly\/4fFXsBx","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003456"},"sp":{"name":"Tour de No\u00ebl Tootbus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bit.ly\/4fFXsBx","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003456"},"nl":{"name":"Kersttour TOOTBUS","shortdescr":"Duik in de magie van Kerstmis in Brussel met Tootbus aan boord van een van zijn 100% elektrische panoramische bussen. Ontdek de feestelijke stad in deze magische periode en beleef de unieke kerstsfeer terwijl je de iconische bezienswaardigheden van de hoofdstad bewondert. Laat je meeslepen door de warme sfeer van Brussel en geniet van een onvergetelijke ervaring in dit seizoen!","longdescr":"Duik in de betoverende kerstsfeer van Brussel met Tootbus en zijn 100% elektrische panoramische bussen. Laat je meevoeren door de warme sfeer van de historische straten, waar elke hoek van de stad een unieke en authentieke charme onthult. Een gids in het Frans en Engels begeleidt je en verrijkt je ontdekking met boeiende anekdotes, terwijl kerstmuziek deze meeslepende ervaring compleet maakt.\n\nDeze rondrit van ongeveer een uur zonder stops laat je de stad op een nieuwe manier ontdekken en de magie van de feestdagen beleven, alles in optimaal comfort en met respect voor het milieu. Deze tour is de perfecte gelegenheid om de gezellige sfeer van Brussel te ontdekken en te genieten van een unieke ervaring, doordrenkt van feestvreugde die van jouw feestseizoen een onvergetelijke herinnering maakt.\n\nDus stap aan boord van deze unieke ervaring en laat je meeslepen in dit avontuur! Boek nu via deze link en profiteer van een speciale kerstkorting op je tickets: https:\/\/bit.ly\/4fFXsBx","performers":"Winterpret, Kerstmarkt","boxoffice_url":null,"website":"https:\/\/bit.ly\/4fFXsBx","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-det