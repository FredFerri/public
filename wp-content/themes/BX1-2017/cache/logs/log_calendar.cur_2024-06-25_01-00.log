ue l\u2019ARAU vous propose de d\u00e9couvrir lors de cette visite. Plateau agricole, fermes restaur\u00e9es, chemin creux pav\u00e9, anciennes maisons de campagne et magnifique panorama sur le centre-ville ponctueront votre parcours \u00e0 travers des quartiers m\u00e9connus.\n\nD\u00e9part : \u00e0 l\u2019angle de la chauss\u00e9e de Ninove et de la rue de la Tarentelle, \u00e0 Anderlecht\n\nDur\u00e9e : 2h","performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011397"},"sp":{"name":"Parcs et campagnes dans l'ouest de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011397"},"nl":{"name":"Parcs et campagnes dans l'ouest de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011397"}},"place":{"id":267987,"translations":{"de":{"name":"Chauss\u00e9e de Ninove","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Chauss\u00e9e de Ninove","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Chauss\u00e9e de Ninove","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1"