.brussels\/pt\/visitors\/agenda\/event-detail.5700003900"},"en":{"name":"Maison Devalck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/maison-devalck","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003900"},"it":{"name":"Maison Devalck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/maison-devalck","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003900"},"cn":{"name":"Maison Devalck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/maison-devalck","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003900"},"fr":{"name":"Maison Devalck","shortdescr":"Cette magnifique maison Art nouveau contient un ensemble de vitraux exceptionnels probablement dus au ma\u00eetre-verrier Rapha\u00ebl Evaldre. Vous aurez la chance de faire la visite avec le propri\u00e9taire des lieux qui est aussi expert en vitraux.","longdescr":"En 1900, le jeune architecte Gaspard Devalck ach\u00e8te un grand terrain dans la campagne de Schaerbeek. Il y construit six maisons, dont une pour lui et sa m\u00e8re. La maison de l'architecte est rachet\u00e9e en 2018 dans un \u00e9tat assez d\u00e9labr\u00e9. Les nouveaux propri\u00e9taires ont commenc\u00e9 les travaux par la restauration de l'admirable fa\u00e7ade d\u00e9cor\u00e9e de sgraffites \u00e0 dessin v\u00e9g\u00e9tal de Privat Livemont qui a retrouv\u00e9 toute sa splendeur. Elle contient un ensemble de vitraux exceptionnels probablement dus au ma\u00eetre-verrier Rapha\u00ebl Evaldre. Vous aurez la chance de faire la visite avec le propri\u00e9taire des lieux qui est aussi expert en vitraux. ","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/maison-devalck","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003900"},"sp":{"name":"Maison Devalck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/maison-devalck","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003900"},"nl":{"name":"Maison Devalck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/maison-devalck","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003900"}},"place":{"id":276208,"translations":{"de":{"name":"Maison Devalck","address_street_name":"Rue Andr\u00e9 Van Hasselt","address_street_number":"32-34","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Andr\u00e9 Van Hasselt, 32-34","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Devalck","address_street_name":"Rue Andr\u00e9 Van Hasselt","address_street_number":"32-34","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Andr\u00e9 Van Hasselt, 32-34","address_line2":"1030 S