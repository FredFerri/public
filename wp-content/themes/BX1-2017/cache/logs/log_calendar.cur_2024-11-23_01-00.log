9, de libert\u00e9 et de d\u00e9sir de reconnaissance.\n\n\u00c9LU MEILLEUR SPECTACLE JEUNE PUBLIC PRIX MAETERLINCK DE LA CRITIQUE 2022","performers":"nterpr\u00e9tation Colin Jolet. Mise en sc\u00e8ne Sophie Leso. Collaboration dramaturgique, cr\u00e9ation sonore Nicolas Arnould. Collaboration chor\u00e9graphique V\u00e2nia Doutel Vaz. Costumes, sc\u00e9nographie Claire Farah. Cr\u00e9ation lumi\u00e8re Ludovic Wautier, Joseph Iavicoli. R\u00e9gie Joseph Iavicoli, Sophie Leso, Samuel Vlodaver, Nicolas Arnould (en alternance).","boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/mike","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001958"},"sp":{"name":"Mike","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/mike","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001958"},"nl":{"name":"Mike","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/mike","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001958"}},"place":{"id":231528,"translations":{"de":{"name":"La Roseraie","address_street_name":"Chauss\u00e9e d'Alsemberg","address_street_number":"1299","address_street_box":null,"email":"secretariat@roseraie.org","website":"http:\/\/www.roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e d'Alsemberg, 1299","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Roseraie","