false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Chocol'Art Expo Koekelberg","shortdescr":"Koekelberg Promotion ASBL lance officiellement le partenariat entre le Belgian Chocolate Village et la Basilique du Sacr\u00e9-C\u0153ur de Koekelberg  gr\u00e2ce \u00e0 l\u2019exposition conjointe Chocol\u2019Art Expo entre le 23 avril et le 27 mai 2022.","longdescr":"Chocol\u2019Art Expo est n\u00e9e \u00e0 la suite d\u2019un appel \u00e0 projets artistiques lanc\u00e9 par le BCV ayant pour inspiration le th\u00e8me du chocolat et m\u00e9langeant toutes les disciplines artistiques (peinture, photo, sculpture,\u2026). \r\nUn jury pluraliste issu du monde de l\u2019art et l\u2019artisanat, de la culture et de la fonction publique ont analys\u00e9es et s\u00e9lectionn\u00e9es les \u0153uvres. On y retrouve entre autres, le torr\u00e9facteur-chocolatier Frederic Blondeel ou encore l\u2019artiste et \u00e9chevin de la culture de Koekelberg, Fatmir LIMANI. \r\nLa Basilique abritera les \u0153uvres des plus de 16 ans, artistes confirm\u00e9s ou non. \r\nLa salle Victoria au BCV, accueillera les \u0153uvres des jeunes de \u2013 de 16 ans et du scolaire et met \u00e9galement en place une mini-exposition temporaire sur le th\u00e8me de l\u2019enfance et du chocolat.","performers":"Belgian Chocolate Village, Basilique de koekelberg","boxoffice_url":null,"website":"https:\/\/chocolartexpo.multiscreensite.com\/","email":"edegrave@belgianchocolatevillage.be","phone_contact":null,"phone_booking":"+32 2 420 70 76","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532669.html"},"nl":{"name":"Chocol'Art Expo Koekelberg","sh