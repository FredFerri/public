eater"}},"others":{}},"translations":{"de":{"name":"Andromaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012227"},"pt":{"name":"Andromaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012227"},"en":{"name":"Andromaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012227"},"it":{"name":"Andromaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012227"},"cn":{"name":"Andromaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012227"},"fr":{"name":"Andromaque","shortdescr":null,"longdescr":"L\u2019action se situe apr\u00e8s la guerre de Troie, long conflit qui a vu les Grecs \u00e9craser le peuple troyen dans le sang et les larmes. La paix revenue, le pouvoir est exerc\u00e9 en d\u00e9pit du bon sens. Le roi Pyrrhus cherche \u00e0 imposer son emprise amoureuse sur Andromaque, une captive troyenne dont il a contribu\u00e9 \u00e0 d\u00e9cimer la famille. Oreste, ambassadeur des Grecs, pour plaire \u00e0 Hermione, la femme qu\u2019il aime, est pr\u00eat \u00e0 accomplir le r\u00e9gicide qu\u2019elle lui r\u00e9clame : \u00ab Revenez tout couvert du sang de l\u2019infid\u00e8le \u00bb.\nAu milieu de ce chaos, Andromaque se dresse en r\u00e9sistante pour sauver son jeune fils que les Grecs veulent ex\u00e9cuter pour se prot\u00e9ger d\u2019une hypoth\u00e9tique refondation de Troie.\n\nUne \u0153uvre \u00e9blouissante, intemporelle, \u00e9ternelle dans ses questionnements sur les cons\u00e9quences des guerres, les blessures profondes qu\u2019elles infligent et les besoins de vengeance qui m\u00e8nent immanquablement \u00e0 la trag\u00e9die.\n\nUn spectacle d\u00e9bordant de vitalit\u00e9, mettant en sc\u00e8ne des \u00eatres jeunes, fougueux, aux prises avec des passions impulsives et destructrices, emprisonn\u00e9s dans des situations extr\u00eames qui les d\u00e9passent.\n\nLa langue de Racine pulse, impulse la vie dans la trag\u00e9die, de nature \u00e0 interroger, secouer et bouleverser tous les publics.\n__________\n\nDe Racine \/ Mise en sc\u00e8ne : Michael Delaunoy \/ Avec : Myriem Akheddiou, Anne-Claire , Baptiste Blampain, Cam\u00e9lia Clair, Jeanne Kacenelenbogen, Cl\u00e9ment Manuel, Arthur Moulin et Yvan Rami \/ Assistant \u00e0 la mise en sc\u00e8ne : Jerry Henning \/ Sc\u00e9nographie et costumes : Alain Wathieu \/ Lumi\u00e8re : Laurent Kaye \/ Son : Antoine Plaisant\n__________\n\nUNE COPRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC ET DE L'ENVERS DU TH\u00c9\u00c2TRE \u2013 COMPAGNIE MICHAEL DELAUNOY. AVEC L'AIDE DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES \u2013 DIRECTION DU TH\u00c9\u00c2TRE, ET LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012227"},"sp":{"name":"Andromaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012227"},"nl":{"name":"Andromaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012227"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_