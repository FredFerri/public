issage le vendredi 1er septembre \u00e0 18h00","performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001745"},"sp":{"name":"Exposition Voisins Voisines","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001745"},"nl":{"name":"Voisins Voisines","shortdescr":null,"longdescr":"Neem een straat, de Dekenijstraat. Zaai er pottenbakkers, graveerders, illustrators, schilders, fotografen, ... We noemen ze \"de TIEN\", hoewel ze met elf zijn. Begiet ze met vriendschap en een gezonde dosis humor en laat trekken. Dat is het recept voor een bijzondere tentoonstelling, waar buren en kunstenaars van allerlei disciplines elkaar ontdekken en hun werken samen tentoonstellen. Niet te missen!\n\nKunstenhuis Ukkel - Dekenijstraat 102\nVan zaterdag 2 au zondag 24 september 2023.\nOpen van donderdag tot zondag van 11.00 tot 17.00 uur","performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"cultuur@ukkel.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001745"}},"place":{"id":243015,"translations":{"de":{"name":"Le Doyenn\u00e9, Maison des Arts d\u2019Uccle","address_street_name":"Rue du Doyenn\u00e9","address_street_number":"102","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 345 14 69","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Rue du Doyenn\u00e9, 102","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le 