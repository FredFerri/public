","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2023-12-03","doors":null,"start":"14:00:00","end":"15:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-12-03","doors":null,"start":"15:30:00","end":"16:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"],"de":["Jugendstil & Art d\u00e9co"],"it":["Art Nouveau e Art D\u00e9co"],"sp":["Art nouveau y art d\u00e9co"],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":{"list":[259,263],"translations":{"fr":["Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Cane guida","Accessibile ai pedoni con supporti"],"sp":["Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-03T17:05:05+02:00","published_at":"2023-07-03T11:49:09+02:00","backoffice_id":281045,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23818958080239},{"id":553801,"date_start":"2023-04-09","date_end":"2023-09-10","date_next":"2023-07-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"En route !","shortdescr":"Un road trip qui va changer leurs vies","longdescr":"Une route, une voiture et quelques heures \u00e0 y passer. Une situation si simple et pourtant si particuli\u00e8re. Dans quels autres contextes avons-nous l\u2019occasion de nous enfermer dans une bulle d\u2019intimit\u00e9 de quelques m\u00e8tres cubes, le regard \u00e0 l\u2019horizon et les pens\u00e9es en voyage ? C\u2019est dans ce cadre si banal et pourtant si fort que les 2 personnages vont \u00e9voluer.\r\n\r\nDans ce road trip th\u00e9\u00e2tral improvis\u00e9 entre humour et \u00e9motion, c\u2019est vous qui choisissez le d\u00e9part, la destination et la raison du trajet.\r\nEntre une pompe \u00e0 essence, un jeu de route et un pique-nique aux sandwichs en triangle, les personnages se baladent dans leur relation. Ce qu\u2019ils n\u2019ont jamais os\u00e9 se dire. Ce qui leur reste en travers de la gorge depuis toutes ces ann\u00e9es. Ce qu\u2019ils ont toujours r\u00eav\u00e9 d\u2019assouvir. \r\nAttachez vos ceintures !","performers":"Patrick Spadrille, Gilles Delvaulx, Dominique Pattuelli, J\u00e9sica de Salvador, AGn\u00e8s Calvache","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/En-route","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553801"},"nl":{"name":"En route !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/En-route","email":"info@improviste.be","phone_contact":null,"