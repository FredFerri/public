ll},"pt":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":1922,"location":{"lat":50.83785217,"lon":4.3630838},"region":"brussels","last_updated_at":"2022-05-18T16:05:22+02:00","published_at":"2013-10-19T01:14:45+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/e14a2ad5fa27317cc0967d150502317f34ca67b8.jpg","width":4240,"height":2832,"ratio":1.5,"translations":{"fr":{"title":"End of Season","copyright":"Muziekpublique"},"nl":{"title":"End of Season","copyright":"Muziekpublique"},"en":{"title":"End of Season","copyright":"Muziekpublique"}}}],"dates":[{"day":"2022-06-11","doors":null,"start":"18:00:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-06-12","doors":null,"start":"14:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[16,5,19,11,7,8,12,10],"translations":{"fr":["Ecoles","Enfants 9-12 ans","Enseignants","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","LGTBQIA","Seniors"],"nl":["Scholen","Kinderen 9-12 j.","Leerkrachten","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","LGTBQIA","Senioren"],"en":["Schools","Children 9-12 yr.","Teachers","Family","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T16:05:22+02:00","published_at":"2022-05-18T16:02:02+02:00","backoffice_id":253537,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":339827,"date_start":"2021-09-15","date_end":"2022-07-29","date_next":"2022-06-11","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Des ailes pour grandir","shortdescr":"Venez d\u00e9couvrir l'exposition ludique et interactive du Mus\u00e9e des Enfants : \"Des ailes pour grandir\" et ses cinq ateliers exceptionnelles.","longdescr":"L\u2019exposition est con\u00e7ue comme un parcours en six \u00e9tapes pour aider les enfants \u00e0 grandir et \u00e0 voler de leurs propres ailes. L\u2019objectif : apprendre \u00e0 mieux se conna\u00eetre et \u00e0 mieux conna\u00eetre le monde qui les entoure.\r\n\r\nEntre d'abord dans le grand hall o\u00f9 une impressionnante machine volante t\u2019attend. \r\n\r\nChapitre 1 : Mes super-pouvoirs\r\nD\u00e9couvre ensuite les aventures de Ben et Lili, deux petits personnages qui traversent des moments difficiles. Enfile ta cape de super-h\u00e9ros et les aide-les \u00e0 trouver des solutions !\r\n\r\nChapitre 2  : L'amiti\u00e9\r\n\u00ab Un ami, \u00e7a sert \u00e0 quoi ? \u00bb se demandent le chat et la souris, deux amis ins\u00e9parables que tout semble opposer. Au fil du parcours qui te m\u00e8nera de la maison de la souris \u00e0 celle du chat, viens explorer l\u2019amiti\u00e9, cette relation riche en \u00e9motions et souvent source de questionnements. \r\n\r\nChapitre 3 : les cultures\r\nPars \u00e0 la d\u00e9couverte des cultures de diff\u00e9rents pays et de leurs nombreuses facettes : langues, rituels, fa\u00e7ons de se dire bonjour, v\u00eatements... Tu apprendras des autres ! Ensuite, tu pourras cr\u00e9er un nouveau monde o\u00f9 il fait bon vivre pour tous.\r\n\r\nChapitre 4 : tous cr\u00e9atifs!\r\nEt si Newton avait mang\u00e9 la pomme ? Et si l\u2019on pouvait manipuler un tableau de Fernand L\u00e9ger et le transformer en sculpture ? Et si le petit chaperon rouge avait apprivois\u00e9 le loup ? Et si un tunnel sensoriel bousculait nos rep\u00e8res ? Et si\u2026\r\nNous sommes tous cr\u00e9atifs ! Nous pouvons tous sortir du cadre et trouver des solutions gr\u00e2ce \u00e0 notre imagination, \u00e0 notre intuition ou \u00e0 la logique. \r\n\r\nChapitre 5 : Mes jardins secrets\r\nTes jardins secrets ont pris forme : ils constituent les d\u00e9cors de cette pi\u00e8ce f\u00e9erique\u2026 Installe-toi dans le nid g\u00e9ant, dans la fus\u00e9e ou dans la biblioth\u00e8que enchant\u00e9e et prends le temps de r\u00eaver. A quoi ressemble l\u2019univers auquel tu aimes penser quand tu fl\u00e2nes, r\u00eaves ou te reposes ?\r\n\r\nLe mus\u00e9e des enfants proposent \u00e9galement des activit\u00e9s ax\u00e9es sur cette exposition  : visites guid\u00e9es, anniversaires, stages (P\u00e2ques et grandes vacances)... \r\nPlus d'infos : https:\/\/www.museedesenfants.be\/","performers":null,"boxoffice_url":null,"website":"http:\/\/www.museedesenfants.be","email":"info@childrenmuseum.be","phone_contact":"+32 2 640 01 07","phone_booking":"+32 2 640 01 07","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/339827.html"},"nl":{"name":"Vleugels om te groeien","shortdescr":"Kom met familie en vrienden naar Het Kindermuseum en ontdek samen de interactieve tentoonstelling: \"Vleugels om te groeien\" en zijn vijf leuke workshops.","longdescr":"De tentoonstelling wordt opgevat als een parcours in zes stappen om kinderen te helpen met opgroeien en uitvliegen. Het doel is om zichzelf beter te leren kennen en de wereld die hen omringt.\r\n\r\nKom binnen in de grote hal waar een indrukwekkende vliegende machine op je wacht. \r\n\r\nHoofdstuk 1 : mijn superkrachten\r\nOntdek de avonturen van Ben en Lili, twee personages die soms moeilijke situaties tegenkomen. Trek jouw superhelden cape aan en help hen om oplossingen te vinden!\r\n\r\nHoofdstuk 2 : Vriendschap\r\n \u00ab Een vriend, waarvoor dient dat ? \u00bb vragen de kat en de muis zich af, twee ongewone maar onafscheidelijke vrienden. Volg het parcours van het huis van de muis naar het huis van de kat en ontdek de emoties en vragen die vriendschap oproepen.\r\n\r\nHoofdstuk 3 : Culturen\r\nOntdek de culturen uit verschillende landen en hun vele facetten: talen, rituelen, begroetingen, kledij... Je leert bij van anderen! Daarna is het aan jou om een nieuwe wereld te cre\u00ebren waar iedereen zich goed kan voelen.\r\n\r\nHoofdstuk 4 : Iedereen creatief!\r\nWat als Newton de appel had opgegeten? Wat als we een schilderij van Fernand L\u00e9ger zouden kunnen omtoveren in een beeld? Wat als Roodkapje de wolf kon overmeesteren? Wat als een zintuiglijke tunnel onze visie verandert? Wat als...\r\nWe zijn allemaal creatief! We kunnen allemaal out of the box denken en oplossingen vinden door onze fantasie, intu\u00eftie of logica te gebruiken. \r\n\r\nHoofdstuk 5 : Mijn paradijsjes\r\nIn dit fee\u00ebrieke decor kan je je eigen geheime wereld cre\u00ebren. Installeer jezelf in het reuzenest, in de raket of in de betoverde bibliotheek en droom weg. In welk paradijsje voel jij je goed om te lanterfanten, te fantaseren of tot rust te komen?","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/339827.html"},"en":{"name":"Wings to grow up","shortdescr":"With family or friends, come and take your time to discover the interactive exhibition of the Children's Museum: \"Wings to grow up\" and it's five pleasant workshops.","longdescr":"Fly from one room to another and discover : \r\n\r\n- My super-powers : part of growing up is being confronted with easy and difficult situations. We all have super-powers, talents to help us through. \r\n\r\n- Friendship : Friendship is a great adventure : it is not always easy bit it helps to grow up. \r\n\r\n- Cultures : We all grow up with the help of the world around us. Children live with different cultures that enrich them. By talking the needs of everyone into account, they create a new world, one where it's nice to live in. \r\n\r\n- Everyone creative : Being creative is looking out for solutions. The child solves challenges with flying colours thanks to his ideas. Let these new ideas blossom. \r\n\r\n- My secret garden : To grow up in harmony with others, the child needs to feel good about himself. In his secret garden, he gets to know who he is and creates a positive image of himself.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/339827.html"},"de":{"name":"Des ailes pour grandir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/339827.html"},"it":{"name":"Des ailes pour grandir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/339827.html"},"sp":{"name":"Des ailes pour grandir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/339827.html"},"pt":{"name":"Des ailes pour grandir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/339827.html"},"cn":{"name":"Des ailes pour grandir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/339827.html"}},"place":{"id":207541,"translations":{"fr":{"name":"Mus\u00e9e des Enfants","address_street_name":"Rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"Le Mus\u00e9e des Enfants est pionnier en Europe. \r\nInstall\u00e9 dans une magnifique maison appartenant \u00e0 la commune d\u2019Ixelles, le mus\u00e9e dispose de 600m\u00b2 d\u2019exposition. Dans cet espace d\u2019\u00e9ducation par le jeu, pas d\u2019ordinateur ni de console vid\u00e9o, mais des d\u00e9cors, des jeux en bois et des mises en situation qui permettent \u00e0 l\u2019enfant de d\u00e9couvrir et d\u2019approfondir la connaissance de soi et du monde qui l\u2019entoure. Chaque exposition se veut participative et ludique, avec un accent important mis sur le dialogue parents-enfants. Il s'agit \u00e0 chaque fois d'une cr\u00e9ation et d'une r\u00e9alisation enti\u00e8rement originale de l\u2019\u00e9quipe du Mus\u00e9e des Enfants, conseill\u00e9e par de nombreux sp\u00e9cialistes tel que p\u00e9dopsychiatres et psychologues.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Kindermuseum","address_street_name":"Burgemeestersstraat","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.kindermuseum.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Burgemeestersstraat, 15","address_line2":"1050 Elsene","description_web":"Het Kindermuseum is een ware Europese pionnier. \r\nGevestigd in een prachtig herenhuis met een totale tentoonstellingsoppervlakte van 600 m\u00b2 illustreert het Kindermuseum door middel van haar tentoonstellingen en activiteiten de filosofie dat voor de vorming en ontwikkeling van een goede wereldori\u00ebntatie de participatieve en psychologische dimensie echt wezenlijk is. In deze ruimtes vind je nochtans geen virtuele, noch hoogtechnologische snufjes: het kind wordt in een herkenbare en re\u00eble spelsituatie geplaatst dankzij de decors en de houten spelletjes die de zelfkennis, de kennis van de ander en van de omringende wereld stimuleren. Het Museum biedt ludieke tentoonstellingen aan waarin de deelname en de dialoog volwassene\/ouder-kinderen een zeer belangrijke rol spelen.  Bij het creatieproces van elke tentoonstelling wordt de raad ingewonnen van  externe specialisten zoals kinderartsen, -psychiaters en -psychologen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Children\u2019s Museum","address_street_name":"rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"Pioneer in Europe, The Children\u2019s Museum is located in a beautiful mansion which offers a 600m2 exhibition spaces. In this educational environment, where playing has a key role, you won\u2019t find computers nor video games. Stage settings and scenery, wooden toys, workshops are but some examples of the different means the Museum has put in place to help children in the discovery of the world that surrounds them, as well as themselves. Every exhibition is an exclusive creation that benefits from the guidance of various external specialists in different areas of the educational work fields.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e des Enfants - das Br\u00fcsseler Kindermuseum","address_street_name":"Rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"Das Br\u00fcsseler Kindermuseum pr\u00e4sentiert in seinem stattlichen Herrenhaus in der Gemeinde Ixelles wechselnde thematische Ausstellungen f\u00fcr wissbegierige Kinder. Auf den 600 m\u00b2 Ausstellungsfl\u00e4che gibt es ganz sicher weder Computer noch Spielekonsolen, daf\u00fcr aber Holzspiele und spannende Installationen, die die Neugierde anregen und den Entdeckergeist wecken. Das Konzept, das - in Zusammenarbeit mit Kinderpsychologen - von dem Kindermuseum selbst entwickelt wurde, legt ein besonderes Augenmerk auf den Dialog zwischen Eltern und Kindern.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Il Museo del Bambini di Bruxelles","address_street_name":"rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"El Museo de los Ni\u00f1os de Bruselas","address_street_name":"rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"Pionero en europa, el Museo de los Ni\u00f1os se sit\u00faa en una bella mansi\u00f3n que ofrece unos 600m\u00b2 de espacios de exhibici\u00f3n. En un ambiente educativo, donde jugar tiene un papel clave, no encontramos ni ordenadores ni videojuegos. Escenarios y decorados esc\u00e9nicos, mu\u00f1ecos de madera o talleres son s\u00f3lo algunas de la herramientas que el museo utiliza para ayudar a los ni\u00f1os a descubrir el mundo que les rodea, as\u00ed como a ellos mismos. Cada exhibici\u00f3n es una creaci\u00f3n exclusiva que se beneficia de la orientaci\u00f3n de varios especialistas de diferentes \u00e1reas de los campos del trabajo educativo.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e des Enfants","address_street_name":"Rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","addr