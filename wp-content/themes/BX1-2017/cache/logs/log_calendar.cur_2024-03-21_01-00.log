ite.fr\/e\/billets-exposition-badass-les-heroines-de-bande-dessinee-781334250777?aff=oddtdtcreator","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006023"},"cn":{"name":"Exposition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.fr\/e\/billets-exposition-badass-les-heroines-de-bande-dessinee-781334250777?aff=oddtdtcreator","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006023"},"fr":{"name":"Badass : les h\u00e9ro\u00efnes de BD","shortdescr":"Badass ne se contente pas de c\u00e9l\u00e9brer ces h\u00e9ro\u00efnes, mais aspire \u00e9galement \u00e0 catalyser un changement culturel dans la mani\u00e8re dont les femmes sont repr\u00e9sent\u00e9es dans le monde de la bande dessin\u00e9e. En d\u00e9construisant les st\u00e9r\u00e9otypes et en r\u00e9imaginant les r\u00e9cits, cette exposition offre une perspective nouvelle et inspirante qui incite \u00e0 la r\u00e9flexion sur le r\u00f4le des femmes dans la narration visuelle.","longdescr":"Jusqu'\u00e0 d\u00e9but mai, l'Alliance Fran\u00e7aise de Bruxelles-Europe met \u00e0 l'honneur les nouvelles h\u00e9ro\u00efnes de bande dessin\u00e9e.\nDestin\u00e9e aux petits comme aux grands, l'exposition est totalement gratuite, vous devez juste vous inscrire et vous pr\u00e9senter \u00e0 l'accueil.\nNous vous accueillons du lundi au jeudi de 9h \u00e0 18h et le vendredi de 9h \u00e0 midi.\n\n\nFrom now until May, the Alliance Fran\u00e7aise will be honoring comic book heroines.\nAimed at young and old alike, the exhibition is completely free of charge, and all you need to do is register at reception.\nThis exhibition is open : Monday to Thursday from 9am to 6pm and Friday from 9am to midday.","performers":"Tintin, Lucky Luck, Ast\u00e9rix\u2026 Autant de noms de personnages de bande dessin\u00e9e que nous connaissons. Mais avez-vous remarqu\u00e9 leur point commun ? Ce sont des personnages masculins !\nO\u00f9 est le probl\u00e8me, allez-vous me dire ? Le souci est dans la repr\u00e9sentation du genre !\nQuand on parle de h\u00e9ros de BD, ce sont des personnages masculins qui nous viennent en t\u00eate, et non des h\u00e9ro\u00efnes de BD !","boxoffice_url":null,"website":"https:\/\/www.eventbrite.fr\/e\/billets-exposition-badass-les-heroines-de-bande-dessinee-781334250777?aff=oddtdtcreator","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006023"},"sp":{"name":"Exposition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.fr\/e\/billets-exposition-badass-les-heroines-de-bande-dessinee-781334250777?aff=oddtdtcreator","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006023"},"nl":{"name":"badass","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.fr\/e\/billets-exposition-badass-les-heroines-de-bande-dessinee-781334250777?aff=oddtdtcreator","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006023"}},"place":{"id":247850,"translations":{"de":{"name":"Alliance Fran\u00e7aise Bruxelles-Europe \u2013 Centre Europ\u00e9en de Langue Fran\u00e7aise","address_street_name":"Avenue des Arts","address_street_number":"46","address_street_box":null,"email":"info@alliancefr.be","website":"http:\/\/www.alliancefr.be","phone_contact":"+32 2 788 21 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue des Arts, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":