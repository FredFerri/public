 10 20","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.456203"},"en":{"name":"With Brel in Brussels - Walking Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FONDATIONBREL&module=ACTIVITYSERIEDETAILS&s=7DAAF48D-4C28-ACFE-8E1E-42E33A52D157&lg=EN","website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.456203"},"it":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.456203"},"cn":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.456203"},"fr":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":"Marchez avec Jacques Brel dans les rues de Bruxelles. A chacun de vos pas, la voix de l'artiste, ses chansons, ses commentaires et les anecdotes d'une quinzaine de t\u00e9moins vous accompagnent dans sa ville natale. \r\n","longdescr":"Des interviews, des t\u00e9moignages et des chansons de Jacques Brel pour cadencer vos pas sur les pav\u00e9s bruxellois et d\u00e9couvrir sa ville natale. Une promenade pour \u00e9couter un r\u00e9cit qui danse entre souvenirs et \u00e9motions au rythme des chansons dans les rues du Bruxelles de Brel. \r\n\r\nCette promenade, con\u00e7ue et comment\u00e9e par Miche et France propose une succession de moments de complicit\u00e9 avec Jacques, avec ceux qui l\u2019ont bien connu et qui l\u2019\u00e9voquent avec le coeur. Plus de 16 voix vous parlent, plus de 22 chansons vous transportent, plus de  37 lieux sont \u00e9voqu\u00e9s. \r\n\r\nAu d\u00e9part de la Fondation Brel, vos pas vous m\u00e8neront de la Grand Place \u00e0 la Monnaie, de la Place Sainte Catherine \u00e0 l\u2019Ancienne Belgique, de tavernes en restaurants, de confidences en r\u00eaves partag\u00e9s.\r\n\r\n\r\n- TRAJET COMPLET - Temps pr\u00e9vu : 2h40\r\n- TRAJET COURT - Temps pr\u00e9vu : 2h\r\n- TRAJET EXPRESS - Temps pr\u00e9vu : 1h\r\n","performers":"Jacques Brel","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FONDATIONBREL&module=ACTIVITYSERIEDETAILS&s=7DAAF48D-4C28-ACFE-8E1E-42E33A52D157&lg=FR","website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.456203"},"sp":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.456203"},"nl":{"name":"Met Brel in Brussel - Wandeling","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FONDATIONBREL&module=ACTIVITYSERIEDETAILS&s=7DAAF48D-4C28-ACFE-8E1E-42E33A52D157&lg=NL","website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.456203"}},"place":{"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2018-08-03T13:26:29+02:00","id":271719,"translations":{"de":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"M\u00f6chten Sie Br\u00fcssel mit den Augen des belgischen Nationalbarden Jacques Brel entdecken?\r\n\r\nDie Jacques Brel gewidmete Stiftung Fondation Brel m\u00f6chte das musikalische, kulturelle und geistige Erbe dieses belgischen Ausnahmek\u00fcnstlers lebendig halten und katalogisiert, digitalisiert und archiviert das Werk und das Leben von Jacques Brel. Nur einen Steinwurf vom Grand-Place entfernt, empf\u00e4ngt die Stiftung interessierte Besucher nun auch mit einer digitalen Dauerausstellung, wo die Besucher in den Abteilungen \u201eBrel Chanteur\u201c (der S\u00e4nger Brel) und \u201eBrel Auteur\u201c (der Autor Brel) die vielf\u00e4ltigen Facetten des Menschen und des K\u00fcnstlers entdecken k\u00f6nnen. \r\n\r\nIn dem eigens eingerichteten Kino \u201eCin\u00e9\u0301 Brel\u201c k\u00f6nnen die Besucher den S\u00e4nger und Schauspieler Jacques Brel in verschiedenen Filmen in Aktion bewundern. 5 Vorf\u00fchrungen pro Tag, darunter der 1966 gedrehte mythische Film \u201eLes Adieux \u00e0 l'Olympia\u201c. \r\nProgramm auf: http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nWeiteres Angebot ist ein Spaziergang auf eigene Faust durch die Heimatstadt des S\u00e4ngers. Ein Audioguide dient als Wegweiser durch das Br\u00fcssel von Jacques Brel. \r\n\r\nKleines Extra: Die Stiftung organisiert regelm\u00e4\u00dfig Treffen mit France Brel, einer der T\u00f6chter des ber\u00fchmten S\u00e4ngers.\r\n\r\nTouristen und treue Fans kommen hier gleicherma\u00dfen auf ihre Kosten. \r\n\r\n* Die Brussels Card umfasst nur die Dauerausstellung des Museums, nicht aber das Kino und den Spaziergang, hierbei handelt es sich um Zusatzangebote. \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Funda\u00e7\u00e3o Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"\u00c9 f\u00e3 de Jacques Brel e sempre sonhou observar Bruxelas do seu ponto de vista?\r\n\r\nAnimada por um esp\u00edrito de transmiss\u00e3o para as novas gera\u00e7\u00f5es, a Funda\u00e7\u00e3o Brel encarrega-se da recolha, listagem e digitaliza\u00e7\u00e3o dos arquivos relacionados com a obra e a vida de Jacques Brel. Situada a dois passos da Grand Place, ela prop\u00f5e atualmente ao p\u00fablico uma exposi\u00e7\u00e3o digital permanente em que o visitante descobre as m\u00faltiplas facetas do homem e do talento do artista atrav\u00e9s dos espa\u00e7os Brel Cantor e Brel Autor.\r\n\r\nOs visitantes tamb\u00e9m podem ficar a conhecer o cantor e ator Jacques Brel atrav\u00e9s de filmes na sala de cinema, Cin\u00e9 Brel. 5 proje\u00e7\u00f5es por dia, entre os quais os m\u00edticos \"Adieux \u00e0 L'Olympia\" (adeus no Ol\u00edmpia) filmados em 1966.\r\nPrograma\u00e7\u00e3o em: http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nUm passeio individual na cidade natal do cantor tamb\u00e9m ser\u00e1 organizada, com guia \u00e1udio, para os caminhantes ansiosos por se impregnar da cidade de Bruxelas de Jacques Brel.\r\n\r\nUm pequeno extra: a Funda\u00e7\u00e3o organiza regularmente reuni\u00f5es com France Brel, uma das filhas do c\u00e9lebre cantor.\r\n\r\nTurista de passagem ou grande conhecedor, esperamos que todos e todas se sintam bem-vindos\/as na Funda\u00e7\u00e3o Brel.\r\n\r\n* A Brussels Card inclui apenas a exposi\u00e7\u00e3o permanente do museu, mas n\u00e3o inclui o cinema e o passeio, que constituem atividades suplementares.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Brel Foundation","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Brussels","description_web":"Are you a fan of Jacques Brel who has always wanted to see Brussels from his point of view?\r\n\r\nDriven by a spirit of transmission to the new generations, the Brel Foundation gathers, indexes and digitizes archives related to the work and life of Belgian artist Jacques Brel. Located a stone\u2019s throw from the Grand Place, it offers a permanent digital exhibition where visitors can discover the multiple facets of the man\u2019s talent in the Brel Chanteur and Brel Auteur spaces.  \r\n\r\nVisitors can also discover his career of singer and actor in our movie theater Cin\u00e9 Brel. 5 screenings a day, Including the mythical concert \"Les Adieux \u00e0 l'Olympia\" from 1966. \r\nMovie programmation : http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nAlso, a walking tour with audio guide in the native city of the singer is available for anyone who wants to discover Brussels through one of his most iconic figures. \r\n\r\nA little extra bonus: the Brel Foundation regularly organises film clubs in the presence of France Brel, one of the famous singer's daughters (only in French).\r\n\r\nTourist or great connoisseur, everyone Is welcome! \r\n\r\n* The Brussels Card only gives access to the permanent exhibition of the Museum. The movie theater and the audio guided walking tour are additional activities. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondazione Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"Siete fan di Jacques Brel e avete sempre voluto osservare Bruxelles dal suo punto di vista?\r\n\r\nAnimata da uno spirito di tramandamento alle nuove generazioni, la Fondazione Brel raccoglie, cataloga e digitalizza gli archivi relativi all'opera e alla vita di Jacques Brel. Situata a due passi dalla Grand Place, la Fondazione propone oggi al pubblico una mostra digitale permanente che permette ai visitatori di scoprire le molteplici sfaccettature dell'uomo e del talento dell'artista attraverso gli spazi Brel Cantante e Brel Autore.\r\n\r\nI visitatori possono inoltre fare la conoscenza del cantante e attore Jacques Brel attraverso i film del cinema della Fondazione: il Cin\u00e9\u0301 Brel. Cinque proiezioni al giorno tra cui i mitici Addii all'Olympia girati nel 1966.\r\nProgrammazione su: http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nSi organizza anche una passeggiata individuale nella citt\u00e0 natale del cantautore, con un'audioguida, per i visitatori curiosi di immergersi nella Bruxelles di Brel.\r\n\r\nUn piccolo extra: la Fondazione organizza regolarmente incontri con France Brel, una delle figlie del celebre cantante.\r\n\r\nChe siate turisti di passaggio o grandi intenditori poco importa: tutti sono i benvenuti alla Fondazione Brel.\r\n\r\n*La Brussels Card include solo la mostra permanente del museo, ma non il cinema e la passeggiata, che sono attivit\u00e0 supplementari.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"Vous \u00eates fan de Jacques Brel et vous avez toujours souhait\u00e9 observer Bruxelles de son point de vue ?\r\n\r\nAnim\u00e9e par un esprit de transmission vers les nouvelles g\u00e9n\u00e9rations, la Fondation Brel rassemble, r\u00e9pertorie et num\u00e9rise les archives en lien avec l\u2019\u0153uvre et la vie de Jacques Brel. Situ\u00e9e \u00e0 deux pas de la Grand Place, elle propose aujourd\u2019hui au public, une exposition permanente digitale o\u00f9 le visiteur d\u00e9couvre les multiples facettes de l\u2019homme et du talent de l\u2019artiste \u00e0 travers les espaces Brel Chanteur et Brel Auteur. \r\n\r\nLes visiteurs peuvent \u00e9galement apprendre a\u0300 conna\u00eetre le chanteur et l\u2019acteur Jacques Brel a\u0300 travers des films dans sa salle de cin\u00e9ma, le Cin\u00e9\u0301 Brel. 5 projections par jour dont les mythiques Adieux \u00e0 L\u2019Olympia film\u00e9s en 1966. \r\nProgrammation sur : http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nUne ballade individuelle dans la ville natale du chanteur est \u00e9galement organis\u00e9e, avec un audioguide, pour les promeneurs curieux de s\u2019impr\u00e9gner du Bruxelles de Brel. \r\n\r\nPetit plus : La Fondation organise r\u00e9guli\u00e8rement des rencontres avec France Brel, une des filles du c\u00e9l\u00e8bre chanteur.\r\n\r\nTouriste de passage ou grand connaisseur, que chacune et chacun se sente le bienvenu \u00e0 la Fondation Brel. \r\n\r\n* La Brussels Card inclut uniquement l\u2019exposition permanente du mus\u00e9e, mas pas le cin\u00e9ma et la promenade qui sont des activit\u00e9s suppl\u00e9mentaires. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Fundaci\u00f3n Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"Usted es fan de Jacques Brel y siempre quiso conocer Bruselas desde su punto de vista?  \r\n\r\nCon el deseo de transmitir hacia las nuevas generaciones, la Fundaci\u00f3n Brel re\u00fane, registra y digitaliza archivos relacionados con el trabajo y la vida del artista belga Jacques Brel. Ubicado muy cerca de la Grand Place, la fundaci\u00f3n ofrece una exposici\u00f3n digital permanente donde los visitantes pueden descubrir las m\u00faltiples facetas del artista en los espacios Brel Chanteur y Brel Auteur. \r\n\r\nLos visitantes tambi\u00e9n pueden descubrir acerca de su carrera de cantante y actor en nuestra sala de cine, el Cin\u00e9 Brel. 5 proyecciones al d\u00eda, incluso el m\u00edtico concierto \"Les Adieux \u00e0 l'Olympia\" qui dio en Paris en 1966. \r\nProgramaci\u00f3n:   http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nTambi\u00e9n est\u00e1 disponible un paseo individual con audiogu\u00eda en la ciudad nativa del cantante, para todos los que quieran descubrir Bruselas con uno de sus figuras m\u00e1s importantes.  \r\n\r\nExtra : La Fundacion organisa de vez en cuando encuentros con Fran Brel, una de les hijas del famoso cantante (solo en Frances). \r\n\r\nTurista o gran conocedor, \u00a1todos son bienvenidos! \r\n\r\n* La Brussels Card incluye solo la exposici\u00f3n permanente del museo. La sala de cine y el paseo con audiogu\u00eda son actividades a parte. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brel Stichting","address_street_name":"Oud Korenhuis","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Oud Korenhuis, 11","address_line2":"1000 Brussel","description_web":"Ben je een fan van Jacques Brel die graag eens Brussel wilt zien vanuit zijn perspectief? \r\n\r\nDe Brel Sichting wil nieuwe generaties kennis laten maken met de nalatenschap van Jacques Brel. Daarvoor verzamelt, registreert en digitaliseert het de archieven die verband houden met het leven en werk van deze grote Belgische artiest. Op een steenworp verwijderd van de Grote Markt bevindt zich een permanente tentoonstelling waar bezoekers de vele facetten van het talent van deze man kunnen ontdekken in de Brel Chanteur en Brel Auteur ruimtes. \r\n\r\nBezoekers kunnen ook zijn carri\u00e8re van zanger en acteur ontdekken in onze bioscoop Cin\u00e9\r\nBrel. 5 vertoningen per dag, waaronder het mythische concert \"Les Adieux \u00e0 l'Olympia\" in 1966.\r\nMeer informatie : http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nOok is er een wandeling met audiogids in de geboortestad van de zanger voor iedereen die Brussel wil ontdekken via een van zijn meest iconische figuren.\r\n\r\nEen extraatje: de Jacques Brel Foundation organiseert regelmatig filmclubs waarop France Brel aanwezig is, een van de dochters van de befaamde zanger (in het Frans).\r\n\r\nToerist of echte kenner, iedereen Is welkom ! \r\n\r\n*De Brussels Card omvat enkel de permanente tentoonstelling van het museum. De cinema en de wandeling zijn bijkomende activiteiten.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[17],"translations":{"de":["Saint-Jacques"],"pt":[null],"en":["Saint-Jacques"],"it":["Saint-Jacques"],"cn":[null],"fr":["Saint-Jacques"],"sp":["Saint-Jacques"],"nl":["Sint-Jacob"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":31719,"location":{"lat":50.84424659,"lon":4.35199771},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2018-08-03T13:26:29+02:00","id":271719,"translations":{"de":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"M\u00f6chten Sie Br\u00fcssel mit den Augen des belgischen Nationalbarden Jacques Brel entdecken?\r\n\r\nDie Jacques Brel gewidmete Stiftung Fondation Brel m\u00f6chte das musikalische, kulturelle und geistige Erbe dieses belgischen Ausnahmek\u00fcnstlers lebendig halten und katalogisiert, digitalisiert und archiviert das Werk und das Leben von Jacques Brel. Nur einen Steinwurf vom Grand-Place entfernt, empf\u00e4ngt die Stiftung interessierte Besucher nun auch mit einer digitalen Dauerausstellung, wo die Besucher in den Abteilungen \u201eBrel Chanteur\u201c (der S\u00e4nger Brel) und \u201eBrel Auteur\u201c (der Autor Brel) die vielf\u00e4ltigen Facetten des Menschen und des K\u00fcnstlers entdecken k\u00f6nnen. \r\n\r\nIn dem eigens eingerichteten Kino \u201eCin\u00e9\u0301 Brel\u201c k\u00f6nnen die Besucher den S\u00e4nger und Schauspieler Jacques Brel in verschiedenen Filmen in Aktion bewundern. 5 Vorf\u00fchrungen pro Tag, darunter der 1966 gedrehte mythische Film \u201eLes Adieux \u00e0 l'Olympia\u201c. \r\nProgramm auf: http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nWeiteres Angebot ist ein Spaziergang auf eigene Faust durch die Heimatstadt des S\u00e4ngers. Ein Audioguide dient als Wegweiser durch das Br\u00fcssel von Jacques Brel. \r\n\r\nKleines Extra: Die Stiftung organisiert regelm\u00e4\u00dfig Treffen mit France Brel, einer der T\u00f6chter des ber\u00fchmten S\u00e4ngers.\r\n\r\nTouristen und treue Fans kommen hier gleicherma\u00dfen auf ihre Kosten. \r\n\r\n* Die Brussels Card umfasst nur die Dauerausstellung des Museums, nicht aber das Kino und den Spaziergang, hierbei handelt es sich um Zusatzangebote. \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Funda\u00e7\u00e3o Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"\u00c9 f\u00e3 de Jacques Brel e sempre sonhou observar Bruxelas do seu ponto de vista?\r\n\r\nAnimada por um esp\u00edrito de transmiss\u00e3o para as novas gera\u00e7\u00f5es, a Funda\u00e7\u00e3o Brel encarrega-se da recolha, listagem e digitaliza\u00e7\u00e3o dos arquivos relacionados com a obra e a vida de Jacques Brel. Situada a dois passos da Grand Place, ela prop\u00f5e atualmente ao p\u00fablico uma exposi\u00e7\u00e3o digital permanente em que o visitante descobre as m\u00faltiplas facetas do homem e do talento do artista atrav\u00e9s dos espa\u00e7os Brel Cantor e Brel Autor.\r\n\r\nOs visitantes tamb\u00e9m podem ficar a conhecer o cantor e ator Jacques Brel atrav\u00e9s de filmes na sala de cinema, Cin\u00e9 Brel. 5 proje\u00e7\u00f5es por dia, entre os quais os m\u00edticos \"Adieux \u00e0 L'Olympia\" (adeus no Ol\u00edmpia) filmados em 1966.\r\nPrograma\u00e7\u00e3o em: http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nUm passeio individual na cidade natal do cantor tamb\u00e9m ser\u00e1 organizada, com guia \u00e1udio, para os caminhantes ansiosos por se impregnar da cidade de Bruxelas de Jacques Brel.\r\n\r\nUm pequeno extra: a Funda\u00e7\u00e3o organiza regularmente reuni\u00f5es com France Brel, uma das filhas do c\u00e9lebre cantor.\r\n\r\nTurista de passagem ou grande conhecedor, esperamos que todos e todas se sintam bem-vindos\/as na Funda\u00e7\u00e3o Brel.\r\n\r\n* A Brussels Card inclui apenas a exposi\u00e7\u00e3o permanente do museu, mas n\u00e3o inclui o cinema e o passeio, que constituem atividades suplementares.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Brel Foundation","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Brussels","description_web":"Are you a fan of Jacques Brel who has always wanted to see Brussels from his point of view?\r\n\r\nDriven by a spirit of transmission to the new generations, the Brel Foundation gathers, indexes and digitizes archives related to the work and life of Belgian artist Jacques Brel. Located a stone\u2019s throw from the Grand Place, it offers a permanent digital exhibition where visitors can discover the multiple facets of the man\u2019s talent in the Brel Chanteur and Brel Auteur spaces.  \r\n\r\nVisitors can also discover his career of singer and actor in our movie theater Cin\u00e9 Brel. 5 screenings a day, Including the mythical concert \"Les Adieux \u00e0 l'Olympia\" from 1966. \r\nMovie programmation : http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nAlso, a walking tour with audio guide in the native city of the singer is available for anyone who wants to discover Brussels through one of his most iconic figures. \r\n\r\nA little extra bonus: the Brel Foundation regularly organises film clubs in the presence of France Brel, one of the famous singer's daughters (only in French).\r\n\r\nTourist or great connoisseur, everyone Is welcome! \r\n\r\n* The Brussels Card only gives access to the permanent exhibition of the Museum. The movie theater and the audio guided walking tour are additional activities. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondazione Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"Siete fan di Jacques Brel e avete sempre voluto osservare Bruxelles dal suo punto di vista?\r\n\r\nAnimata da uno spirito di tramandamento alle nuove generazioni, la Fondazione Brel raccoglie, cataloga e digitalizza gli archivi relativi all'opera e alla vita di Jacques Brel. Situata a due passi dalla Grand Place, la Fondazione propone oggi al pubblico una mostra digitale permanente che permette ai visitatori di scoprire le molteplici sfaccettature dell'uomo e del talento dell'artista attraverso gli spazi Brel Cantante e Brel Autore.\r\n\r\nI visitatori possono inoltre fare la conoscenza del cantante e attore Jacques Brel attraverso i film del cinema della Fondazione: il Cin\u00e9\u0301 Brel. Cinque proiezioni al giorno tra cui i mitici Addii all'Olympia girati nel 1966.\r\nProgrammazione su: http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nSi organizza anche una passeggiata individuale nella citt\u00e0 natale del cantautore, con un'audioguida, per i visitatori curiosi di immergersi nella Bruxelles di Brel.\r\n\r\nUn piccolo extra: la Fondazione organizza regolarmente incontri con France Brel, una delle figlie del celebre cantante.\r\n\r\nChe siate turisti di passaggio o grandi intenditori poco importa: tutti sono i benvenuti alla Fondazione Brel.\r\n\r\n*La Brussels Card include solo la mostra permanente del museo, ma non il cinema e la passeggiata, che sono attivit\u00e0 supplementari.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"Vous \u00eates fan de Jacques Brel et vous avez toujours souhait\u00e9 observer Bruxelles de son point de vue ?\r\n\r\nAnim\u00e9e par un esprit de transmission vers les nouvelles g\u00e9n\u00e9rations, la Fondation Brel rassemble, r\u00e9pertorie et num\u00e9rise les archives en lien avec l\u2019\u0153uvre et la vie de Jacques Brel. Situ\u00e9e \u00e0 deux pas de la Grand Place, elle propose aujourd\u2019hui au public, une exposition permanente digitale o\u00f9 le visiteur d\u00e9couvre les multiples facettes de l\u2019homme et du talent de l\u2019artiste \u00e0 travers les espaces Brel Chanteur et Brel Auteur. \r\n\r\nLes visiteurs peuvent \u00e9galement apprendre a\u0300 conna\u00eetre le chanteur et l\u2019acteur Jacques Brel a\u0300 travers des films dans sa salle de cin\u00e9ma, le Cin\u00e9\u0301 Brel. 5 projections par jour dont les mythiques Adieux \u00e0 L\u2019Olympia film\u00e9s en 1966. \r\nProgrammation sur : http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nUne ballade individuelle dans la ville natale du chanteur est \u00e9galement organis\u00e9e, avec un audioguide, pour les promeneurs curieux de s\u2019impr\u00e9gner du Bruxelles de Brel. \r\n\r\nPetit plus : La Fondation organise r\u00e9guli\u00e8rement des rencontres avec France Brel, une des filles du c\u00e9l\u00e8bre chanteur.\r\n\r\nTouriste de passage ou grand connaisseur, que chacune et chacun se sente le bienvenu \u00e0 la Fondation Brel. \r\n\r\n* La Brussels Card inclut uniquement l\u2019exposition permanente du mus\u00e9e, mas pas le cin\u00e9ma et la promenade qui sont des activit\u00e9s suppl\u00e9mentaires. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Fundaci\u00f3n Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"Usted es fan de Jacques Brel y siempre quiso conocer Bruselas desde su punto de vista?  \r\n\r\nCon el deseo de transmitir hacia las nuevas generaciones, la Fundaci\u00f3n Brel re\u00fane, registra y digitaliza archivos relacionados con el trabajo y la vida del artista belga Jacques Brel. Ubicado muy cerca de la Grand Place, la fundaci\u00f3n ofrece una exposici\u00f3n digital permanente donde los visitantes pueden descubrir las m\u00faltiples facetas del artista en los espacios Brel Chanteur y Brel Auteur. \r\n\r\nLos visitantes tambi\u00e9n pueden descubrir acerca de su carrera de cantante y actor en nuestra sala de cine, el Cin\u00e9 Brel. 5 proyecciones al d\u00eda, incluso el m\u00edtico concierto \"Les Adieux \u00e0 l'Olympia\" qui dio en Paris en 1966. \r\nProgramaci\u00f3n:   http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nTambi\u00e9n est\u00e1 disponible un paseo individual con audiogu\u00eda en la ciudad nativa del cantante, para todos los que quieran descubrir Bruselas con uno de sus figuras m\u00e1s importantes.  \r\n\r\nExtra : La Fundacion organisa de vez en cuando encuentros con Fran Brel, una de les hijas del famoso cantante (solo en Frances). \r\n\r\nTurista o gran conocedor, \u00a1todos son bienvenidos! \r\n\r\n* La Brussels Card incluye solo la exposici\u00f3n permanente del museo. La sala de cine y el paseo con audiogu\u00eda son actividades a parte. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brel Stichting","address_street_name":"Oud Korenhuis","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Oud Korenhuis, 11","address_line2":"1000 Brussel","description_web":"Ben je een fan van Jacques Brel die graag eens Brussel wilt zien vanuit zijn perspectief? \r\n\r\nDe Brel Sichting wil nieuwe generaties kennis laten maken met de nalatenschap van Jacques Brel. Daarvoor verzamelt, registreert en digitaliseert het de archieven die verband houden met het leven en werk van deze grote Belgische artiest. Op een steenworp verwijderd van de Grote Markt bevindt zich een permanente tentoonstelling waar bezoekers de vele facetten van het talent van deze man kunnen ontdekken in de Brel Chanteur en Brel Auteur ruimtes. \r\n\r\nBezoekers kunnen ook zijn carri\u00e8re van zanger en acteur ontdekken in onze bioscoop Cin\u00e9\r\nBrel. 5 vertoningen per dag, waaronder het mythische concert \"Les Adieux \u00e0 l'Olympia\" in 1966.\r\nMeer informatie : http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nOok is er een wandeling met audiogids in de geboortestad van de zanger voor iedereen die Brussel wil ontdekken via een van zijn meest iconische figuren.\r\n\r\nEen extraatje: de Jacques Brel Foundation organiseert regelmatig filmclubs waarop France Brel aanwezig is, een van de dochters van de befaamde zanger (in het Frans).\r\n\r\nToerist of echte kenner, iedereen Is welkom ! \r\n\r\n*De Brussels Card omvat enkel de permanente tentoonstelling van het museum. De cinema en de wandeling zijn bijkomende activiteiten.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":31719,"location":{"lat":50.84424659,"lon":4.35199771},"is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"video","link":"https:\/\/www.youtube.com\/watch?v=qZaIvCILP_o","width":356,"height":200,"ratio":null,"oEmbed_title":"Promenade JACQUES BREL Wandeling","oEmbed_author_name":"Fondation Jacques Brel","oEmbed_author_url":"https:\/\/www.youtube.com\/channel\/UC0xiQcIGFesHuDl3LRgHm7g","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/qZaIvCILP_o\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/qZaIvCILP_o?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"de":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":null},"pt":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":null},"en":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":null},"it":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":null},"cn":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":null},"fr":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":null},"sp":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":null},"nl":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/bbf50eb07