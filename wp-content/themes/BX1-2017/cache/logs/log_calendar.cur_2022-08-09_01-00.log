on_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":15457,"location":{"lat":50.85146796,"lon":4.35662342},"region":"brussels","last_updated_at":"2022-07-29T03:35:40+02:00","published_at":"2013-11-12T18:27:11+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/5eec4f98a4eb92de4c2396ab6f306467f5847dd9.jpg","width":879,"height":595,"ratio":1.48,"translations":{"fr":{"title":"Panorama sur la ville : Quand une promenade mondaine se termine par un point de vue remarquable","copyright":null},"nl":{"title":"Panorama sur la ville : Quand une promenade mondaine se termine par un point de vue remarquable","copyright":null},"en":{"title":"Panorama sur la ville : Quand une promenade mondaine se termine par un point de vue remarquable","copyright":null}}}],"dates":[{"day":"2022-08-27","doors":null,"start":"11:00:00","end":"13:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-29T03:35:40+02:00","published_at":"2022-07-28T16:29:03+02:00","backoffice_id":259038,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":538151,"date_start":"2022-08-27","date_end":"2022-08-27","date_next":"2022-08-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Hide & Seek 2022: Guided Tour- Nouveau march\u00e9 au grain, un quartier entre c\u00e9r\u00e9ales, basket et mode","shortdescr":null,"longdescr":"Le quartier du nouveau march\u00e9 au grain f\u00fbt entre le 15i\u00e8me et le 18i\u00e8me si\u00e8cle le c\u0153ur d\u2019un immense domaine et monast\u00e8re j\u00e9suite. Lors de sa suppression en 1783, la ville ordonna la transformation du site en une place spacieuse de style classique. Cette place devait constituer une alternative au march\u00e9 aux c\u00e9r\u00e9ales, qui n\u2019avait pas suffisamment d\u2019espace sur l\u2019actuel \u00ab Vieux march\u00e9 au grain \u00bb. Aujourd\u2019hui, la place avec ses platanes et ses anneaux de basket est l\u2019un des endroits les plus anim\u00e9s du centre-ville. Le quartier de la mode s\u2019est d\u00e9velopp\u00e9 \u00e0 proximit\u00e9, ainsi que plusieurs \u00e9coles, des caf\u00e9s branch\u00e9s et des tours r\u00e9sidentielles sociales qui sont sur le point d\u2019\u00eatre d\u00e9molies. Venez d\u00e9couvrir toutes les diff\u00e9rentes facettes de ce quartier en perp\u00e9tuelle \u00e9volution.\r\n\r\nPRATIQUE: Ces visites guid\u00e9es sont organis\u00e9es par Brukselbinnenstebuiten. Les visites guid\u00e9es sont organis\u00e9es \u00e0 l\u2019ext\u00e9rieur, se concentrent sur le quartier alentour d\u2019un lieu du programme et sont donn\u00e9es fran\u00e7ais ou en n\u00e9erlandais\/anglais. Elles d\u00e9marrent \u00e0 16h30, et se terminent \u00e0 18h. Ceci veut dire qu\u2019elles sont facilement combinables avec la premi\u00e8re s\u00e9ance du concert du m\u00eame endroit. Par facilit\u00e9 d\u2019organisation, nous vendons les places pour ces deux \u00e9v\u00e9nements s\u00e9par\u00e9ment\r\n\r\nREMARQUE: Cette visite guid\u00e9e est organis\u00e9e juste avant le concert d\u2019Alostmen \u00e0 la maison Autrique. Cliquez ici pour acheter les tickets pour ce concert afin d\u2019encha\u00eener les deux activit\u00e9s:\r\n-Session 7pm: https:\/\/miniurl.be\/r-45go\r\n-Session 9pm: https:\/\/miniurl.be\/r-45gp\r\n\r\ndans le cadre de Hide & Seek Festival 2022","performers":"organis\u00e9es par Brukselbinnenstebuiten","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538151.html"},"nl":{"name":"Hide & Seek 2022: Guided Tour- Nieuwe Graanmarkt, een wijk in opmars tussen de granen, basket en mode.","shortdescr":null,"longdescr":"Wat nu de Nieuwe Graanmarkt is, was tussen de 15de en de 18de eeuw het hart van het immense domein van het Jerichoklooster. Toen het in 1783 werd afgeschaft, gaf de stad de opdracht de plek om te vormen tot een ruim plein in classicistische stijl. Dat plein moest een alternatief vormen voor de graanmarkt die onvoldoende plaats had op wat nu de Oude Graanmarkt heet. Tegenwoordig is het plein, met zijn platanen en basketringen, bij uitstek d\u00e9 \u2018hangplek\u2019 van het bruisende stadscentrum. Vlakbij ligt de modewijk, zijn er meerdere scholen, hippe caf\u00e9s \u00e9n op afbraak staande sociale woontorens.\r\n\r\nPRAKTISCH: De rondleidingen worden buiten georganiseerd en richten zich op de buurt rond een programmalocatie. Je kan de rondleiding in het Frans of Nederlands en Engels volgen. Ze beginnen om 16.30 uur en eindigen om 18.00 uur. Zo kunnen ze dus gemakkelijk gecombineerd worden met de eerste sessie van het concert op dezelfde plaats. Om organisatorische redenen verkopen wij de tickets voor deze twee evenementen afzonderlijk.\r\n\r\nOPMERKING: Deze rondleiding wordt vlak voor het concert van Alostmen in de Brasserie Surr\u00e9aliste georganiseerd. Klik hier om tickets voor dit concert te kopen en zo de twee activiteiten te combineren:\r\n-Session 7pm: https:\/\/miniurl.be\/r-45go\r\n-Session 9pm: https:\/\/miniurl.be\/r-45gp\r\n\r\nin het kader van Hide & Seek Festival 2022","performers":"organis\u00e9es par Brukselbinnenstebuiten","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538151.html"},"en":{"name":"Hide & Seek 2022: Guided Tour- Nouveau march\u00e9 au grain, un quartier entre c\u00e9r\u00e9ales, basket et mode","shortdescr":null,"longdescr":"This guided tour is just before a concert organized by Muziekpublique for the Hide & Seek Festival at the Brasserie Surrealiste. If you want to combine the visit & the concert: \r\n-Session 7pm: https:\/\/miniurl.be\/r-45go\r\n-Session 9pm: https:\/\/miniurl.be\/r-45gp","performers":"organized by Brukselbinnenstebuiten","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538151.html"},"de":{"name":"Visite guid\u00e9e: Nouveau march\u00e9 au grain, un quartier entre c\u00e9r\u00e9ales, basket et mode","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538151.html"},"it":{"name":"Visite guid\u00e9e: Nouveau march\u00e9 au grain, un quartier entre c\u00e9r\u00e9ales, basket et mode","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/538151.html"},"sp":{"name":"Visite guid\u00e9e: Nouveau march\u00e9 au grain, un quartier entre c\u00e9r\u00e9ales, basket et mode","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking