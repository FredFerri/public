e Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":"gallery","facebook_id":null,"backoffice_id":1917,"location":{"lat":50.83305444,"lon":4.36110166},"region":"brussels","last_updated_at":"2023-02-12T03:08:22+01:00","published_at":"2013-10-19T01:14:44+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[],"dates":[{"day":"2023-01-12","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-13","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-14","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-17","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-18","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-19","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-20","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-21","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-24","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-25","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-26","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-27","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-28","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-31","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-02-01","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-02-02","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-02-03","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-02-04","doors":null,"start":"11:00:00","end":