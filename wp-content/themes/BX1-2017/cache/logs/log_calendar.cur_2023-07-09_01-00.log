tegories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le Manoir de Silver Lake","shortdescr":"Une histoire \u00e0 frissonner de rire\r\nAmbiance entre \"La Famille Addams\" et \"Dracula\"\u2026\r\n\r\nLe Manoir de Silver Lake du Magic Land Theatre? Un manoir o\u00f9 il ne fait pas bon chercher secours\u2026","longdescr":"Apr\u00e8s \u00eatre myst\u00e9rieusement tomb\u00e9s en panne de voiture, Alan et Natacha croient trouver refuge dans une vieille b\u00e2tisse toute proche, le manoir de Silver Lake.\r\nIgnorant tout de l\u2019\u00e9trange propri\u00e9taire des lieux, ils poussent innocemment la vielle porte de bois et le pi\u00e8ge se referme.\r\nLes voil\u00e0 prisonniers comme deux marionnettes entre les mains du Comte de Silver Lake, un noble d\u00e9cadent f\u00e9ru de sorcellerie.\r\nUne nouvelle aventure dans laquelle nous entraine le Magic Land. Entre la famille Adams et le comte Dracula.","performers":"Auteur et metteur en sc\u00e8ne: Patrick Chaboud\r\nAvec: Elsa Erroyaux, Evelyne Demaude, Sophie D\u2019hondt, Guillaume Jacobs, Lionel Li\u00e9geois, Michael Manconi","boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.556041"},"nl":{"name":"Le Manoir de Silver Lake","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/a