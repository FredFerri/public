-edff2f6bf3a83d12b546736e8fef33b4a8e10701.jpg","width":906,"height":509,"ratio":1.78,"translations":{"fr":{"title":"De la place des Martyrs \u00e0 l'ancienne imprimerie Le Peuple","copyright":null},"nl":{"title":"De la place des Martyrs \u00e0 l'ancienne imprimerie Le Peuple","copyright":null},"en":{"title":"De la place des Martyrs \u00e0 l'ancienne imprimerie Le Peuple","copyright":null}}}],"dates":[{"day":"2022-10-16","doors":null,"start":"14:00:00","end":"15:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":12}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T05:05:56+02:00","published_at":"2022-09-10T03:30:30+02:00","backoffice_id":261429,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":539257,"date_start":"2022-10-09","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"],"de":["Musiktheater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Histoire \u00e9ph\u00e9m\u00e8re","shortdescr":"\"L\u2019imagination est plus importante que le savoir.\" Albert Einstein","longdescr":"Chaque spectacle r\u00e9serve son lot de surprise aux spectateurs... Mais lorsque l\u2019on vient \u00e9couter et voir une Histoire \u00e9ph\u00e9m\u00e8re, on s\u2019appr\u00eate \u00e0 vivre une exp\u00e9rience tout \u00e0 fait originale. Non seulement le public ne sait pas ce qu\u2019il vient voir et \u00e9couter, mais les artistes ne savent pas non plus ce qu\u2019ils vont jouer...\r\n\r\nLe com\u00e9dien et le musicien vont relever le d\u00e9fi de cr\u00e9er une histoire en direct \u00e0 partir d\u2019\u00e9l\u00e9ments que les enfants vont leur donner ! Comme par magie, les personnages, les animaux, les lieux et les objets, prennent vie sous les traits d\u2019un com\u00e9dien aux multiples facettes, color\u00e9s des sons et notes d\u2019un musicien paysagiste.\r\n\r\n\u00ab L\u2019Imagination est plus importante que le Savoir \u00bb a dit Albert Einstein.\r\nThierry Bilisko en a fait son adage et accompagn\u00e9 par un musicien, il cr\u00e9e et interpr\u00e8te une incroyable histoire totalement improvis\u00e9e, interpr\u00e9tant tous les personnages qui la composent... Embarquez pour une vraie exp\u00e9rience th\u00e9\u00e2trale !","performers":"Thierry Bilisko, Antoine Lefort","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Histoire-ephemere.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539257"},"nl":{"name":"Histoire \u00e9ph\u00e9m\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539257"},"en":{"name":"Histoire \u00e9ph\u00e9m\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539257"},"de":{"name":"Histoire \u00e9ph\u00e9m\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"