end":"18:00:00"},{"day":"2022-08-13","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-14","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-15","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-16","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-17","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-18","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-19","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-20","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-21","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-22","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-23","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-24","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-25","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-26","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-27","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-28","doors":null,"start":"10:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 18:00"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 18:00"]},"date_start":"2022-06-28","date_end":"2022-08-28","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[11,10,12,7,15],"translations":{"fr":["Famille","Seniors","LGTBQIA","Jeunes 12-15 ans","Sourd\/malentendant"],"nl":["Familie","Senioren","LGTBQIA","Jongeren 12-15 j.","Doof\/slechthorend"],"en":["Family","Seniors","LGTBQIA","Youth 12-15  yr.","Deaf\/hard of hearing"]}},"tags":["kids"],"accessibilities":{"list":[252,255,257,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T01:35:09+02:00","published_at":"2022-06-28T16:11:06+02:00","backoffice_id":257217,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.31833136784577},{"id":538416,"date_start":"2022-07-01","date_end":"2022-08-31","date_next":"2022-08-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Schatten van Vlieg : BNBienvenue \u00e0 la ferme","shortdescr":null,"longdescr":"Grouik grouik ! \r\n\r\nBNBienvenue \u00e0 la ferme ! Fais la connaissance de Victor le cochon-tirelire ! Victor a un grand r\u00eave : r\u00e9nover compl\u00e8tement son ancienne ferme afin que tous les animaux, petits et grands, puissent y trouver leur place. Pour y parvenir, Victor le cochon-tirelire a besoin de beaucoup d\u2019aide. Heureusement, il peut compter sur ses amis les animaux du Mus\u00e9e de la Banque nationale. Aideras-tu Billie l\u2019abeille et Fid\u00e8le le Castor \u00e0 r\u00e9parer la ferme ? Enfile tes sabots, attrape ta fourche et retrousse tes manches ! Chacune des missions te permettra d\u2019embellir la ferme pas \u00e0 pas. Participe \u00e0 la sauvegarde de la ferme et, qui sait, une belle r\u00e9colte t\u2019attendra peut-\u00eatre \u00e0 la fin de cette qu\u00eate! \r\n\r\nUne mission accomplie est toujours r\u00e9compens\u00e9e ! Victor le cochon-tirelire donnera non seulement une partie de sa r\u00e9colte aux h\u00e9ros et h\u00e9ro\u00efnes, mais aussi un cadeau tr\u00e8s sp\u00e9cial ! Alors, n\u2019oublie pas ton plus beau sourire pour venir au mus\u00e9e car, apr\u00e8s ton aventure, tu pourras imprimer un billet avec... ton visage ! \r\n\r\nD\u00e9couvrez le mus\u00e9e \u00e0 l\u2019aide de carnets de jeux adapt\u00e9s \u00e0 l\u2019\u00e2ge de vos enfants (4-6 ans ou 7-12 ans). Ces derniers sont disponibles en fran\u00e7ais et en n\u00e9erlandais. Les diverses activit\u00e9s sont supervis\u00e9es par les parents, ou par d\u2019autres adultes accompagnants, et constituent une excellente sortie pour toute la famille. \r\n\r\nPlus d\u2019informations sur le site internet du mus\u00e9e ! https:\/\/www.nbbmuseum.be\/fr\/agenda\/schatten-van-vlieg-bnbienvenue-la-ferme\r\n\r\nPrix: GRATUIT \r\nDur\u00e9e : environ 45 min\/ 1 heure \r\nAge: de 4 \u00e0 12 ans \r\nEntr\u00e9e libre (aucune r\u00e9servation n\u00e9cessaire)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.nbbmuseum.be","email":"museum@nbb.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538416"},"nl":{"name":"Schatten van Vlieg: Welkom op de NBBoerderij","shortdescr":null,"longdescr":"Knor Knor!  \r\n\r\nWelkom op de NBBoerderij! Maak kennis met Victor het spaarvarken. Victor heeft \u00e9\u00e9n grote droom: zijn oude boerderij helemaal opknappen zodat alle dieren, groot en klein, hier een thuis kunnen vinden. Daarvoor heeft het spaarvarken veel hulp nodig. Gelukkig heeft Victor heel wat dierenvriendjes in het museum van de Nationale Bank. Help jij samen met Billie de Bij en Fideel de Bever de NBBoerderij te redden? Pak jouw klompen, neem de hooivork en steek jouw handen uit de mouwen! Via een zoektocht in het museum kan jij de boerderij stap voor stap mooier en beter maken. En wie weet heb je op het einde van dit avontuur een mooie oogst.   \r\n\r\nEen geslaagde missie op de boerderij wordt natuurlijk beloond. Victor het spaarvarken geeft aan alle helden en heldinnen van de boerderij niet alleen een deeltje van de oogst, maar ook een heel speciaal geschenk. Neem je mooiste lach mee naar het museum want je kan na de speurtocht een bankbiljet maken met een foto van\u2026 jouw gezicht!  \r\n\r\nVerken het museum aan de hand van speelse doe-boekjes op maat van de leeftijd van jouw kind (4-6 of 7-12 jaar). Deze zijn zowel in het Frans als het Nederlands te verkrijgen. Het spel wordt begeleid door de ouders (of andere begeleiders) en is een fijne uitstap voor het hele gezin. \r\n \r\nMeer informatie vind je op de website van het museum. https:\/\/www.nbbmuseum.be\/nl\/agenda\/schatten-van-vlieg-welkom-op-de-nbboerderij \r\n\r\nPrijs: GRATIS \r\nDuur: 45min - 1u \r\nLeeftijd: 4-12 jaar \r\nVrije toegang (reserveren is niet nodig)","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538416"},"en":{"name":"BNBienvenue \u00e0 la ferme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538416"},"de":{"name":"BNBienvenue \u00e0 la ferme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538416"},"it":{"name":"BNBienvenue \u00e0 la ferme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538416"},"sp":{"name":"BNBienvenue \u00e0 la ferme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538416"},"pt":{"name":"BNBienvenue \u00e0 la ferme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.538416"},"cn":{"name":"BNBienvenue \u00e0 la ferme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.538416"}},"place":{"id":220155,"translations":{"fr":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Bruxelles","description_web":"Depuis 2018, le mus\u00e9e de la Banque nationale de Belgique est install\u00e9 dans un magnifique b\u00e2timent bancaire datant du XIXe si\u00e8cle. \r\n\r\nUn premier circuit dans le mus\u00e9e aborde les r\u00f4les d\u2019une banque centrale \u00e0 travers une sc\u00e9nographie interactive. Gr\u00e2ce \u00e0 son audioguide, le visiteur peut ainsi tant\u00f4t en apprendre un peu plus sur l\u2019\u00e9mission des pi\u00e8ces et des billets, tant\u00f4t tester ses connaissances sur l\u2019euro ou encore \u00eatre amen\u00e9 \u00e0 contr\u00f4ler le niveau d\u2019inflation. \r\n\r\nLe second circuit retrace l\u2019\u00e9volution des moyens de payement et fait la part belle aux collections historiques du mus\u00e9e. Monnaies marchandises, anciens objets de change, anciennes pi\u00e8ces et billets se c\u00f4toient ainsi dans une fresque th\u00e9matique et chronologique qui fera voyager le visiteur dans le temps et \u00e0 travers le monde.\r\n\r\nEnfin, le dernier circuit regroupe une s\u00e9rie d\u2019objets qui d\u00e9montre \u00e0 quel point l\u2019argent est pr\u00e9sent dans notre quotidien.\r\n\r\nLes visites de groupe sont organis\u00e9es \u00e0 partir de 10 personnes - maximum 25. Elles sont gratuites et durent environ 1 heure. Les r\u00e9servations se font via le formulaire en ligne disponible sur le site internet http:\/\/www.nbbmuseum.be\/fr\/booking. \r\nRenseignements : 02 221 22 06 \u2013 museum@nbb.be","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van de Nationale Bank van Belgi\u00eb","address_street_name":"Warmoesberg","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Warmoesberg","address_line2":"1000 Brussel","description_web":"Sinds 2018 is het museum van de Nationale Bank van Belgi\u00eb in een prachtig 19de-eeuwse bankgebouw ondergebracht.\r\n\r\nAan de hand van interactieve opstellingen focust een eerste parcours in het museum op de taken van een centrale bank. Met behulp van een audiogids kan de bezoeker meer te weten komen over de uitgifte van munten en biljetten, zijn of haar kennis van de euro testen of proberen de inflatie onder controle te houden.\r\nHet tweede parcours schetst de evolutie van de betaalmiddelen en zet hierbij de collecties van het museum in de kijker. Goederengeld, oude ruilmiddelen, munten en biljetten vormen een thematisch en chronologisch geheel, waarbij de bezoeker wordt meegenomen op een reis in de tijd en over heel de wereld.\r\nHet derde parcours tenslotte toont een aantal voorwerpen waarmee wordt aangetoond hoe sterk geld aanwezig is in ons dagelijkse leven.\r\n\r\nGroepsbezoeken kunnen vanaf 10 personen, maximum 25. Ze zijn gratis en duren ongeveer 1 uur. Reserveren graag via de website van het museum https:\/\/www.nbbmuseum.be\/nl\/booking.\r\nMeer informatie: tel 02 221 22 06 - museum@nbb.be  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of the National Bank of Belgium","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Brussels","description_web":"Since 2018 the museum of the National Bank of Belgium is housed in a splendid 19t century bank building situates at a mere 10-minute walk from the Central Station.\r\n\r\nThe first part of the exhibition pays particular attention to the role and the functions of the National Bank. By use of an audio guide and interactive displays, the visitor will no doubt discover lots of interesting facts about the issue of notes and coins, test their knowledge of the euro, or even try to control the rate of inflation.\r\n\r\nThe second part paints an overall picture of the evolution of money, and showcases many wonderful objects from the museum collection. Commodity money, diverse and peculiar objects once used for bartering, coins and notes... These many various pieces are purposely put in a thematical and chronological context which in the end will provide the visitor with a fascinating overview.\r\n\r\nThe third part of the exhibition proves just how much money is present in our day to day life by displaying a wide range of objects, some everyday and trivial, some quirky.\r\n\r\nGroup visits can be from 10 people up to 25. They are free and take about 1 hour. Please book via the website of the museum https:\/\/www.nbbmuseum.be\/en\/booking.\r\nMore information: 02 221 22 06 - museum@nbb.be ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"ru