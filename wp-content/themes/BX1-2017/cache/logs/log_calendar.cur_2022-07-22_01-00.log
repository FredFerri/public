day":"2022-08-12","doors":null,"start":"13:00:00","end":"19:00:00"},{"day":"2022-08-13","doors":null,"start":"13:00:00","end":"19:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"13:00:00","end":"19:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"13:00:00","end":"19:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"13:00:00","end":"19:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi et dimanche: ferm\u00e9","jeudi, vendredi et samedi: de 13:00 \u00e0 19:00"],"nl":["maandag, dinsdag, woensdag en zondag: gesloten","donderdag, vrijdag en zaterdag: van 13:00 tot 19:00"],"en":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 13:00 to 19:00"]},"date_start":"2022-07-14","date_end":"2022-08-13","is_also_by_appointment":true}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[8,11,19,10],"translations":{"fr":["Jeunes 15-18 ans","Famille","Enseignants","Seniors"],"nl":["Jongeren 15-18 j.","Familie","Leerkrachten","Senioren"],"en":["Youth 15-18  yr.","Family","Teachers","Seniors"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-17T01:35:42+02:00","published_at":"2022-04-14T09:04:23+02:00","backoffice_id":251084,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.40107239119072},{"id":535902,"date_start":"2022-07-14","date_end":"2022-08-14","date_next":"2022-07-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"In the Streets","shortdescr":"\u00c0 IN THE STREETS, tout se passe dans la rue afin que le public, urbain, familial et h\u00e9t\u00e9roclite, fasse l\u2019exp\u00e9rience d\u2019une ville agr\u00e9able, accueillante, inclusive. Une foule de rendez-vous gratuits et conviviaux permettent des d\u00e9couvertes insolites dans un centre-ville plus attractif et dynamique que jamais.","longdescr":"L\u2019\u00e9v\u00e9nement offre des rendez-vous gratuits (sportifs, culturels et artistiques), conviviaux et instagrammables. Ils soulignent l\u2019identit\u00e9 de divers quartiers parmi les plus attractifs de la capitale et permettent des d\u00e9couvertes insolites.\r\n\r\nLes Bruxellois et les touristes qui circulent dans les ruelles du centre-ville ne peuvent pas faire 200 m\u00e8tres sans \u00eatre surpris :\r\n\u2022PLAY UP et PLAY DOWN, deux villages urbains : sports de ville et autres activit\u00e9s estivales ; \r\n\u2022WALK, un parcours qui relie ces deux villages : cinq installations artistiques originales et divers parcours existants (Parcours Street Art et BD, fresques murales et les autres \u0153uvres du Comit\u00e9\u0301 d\u2019Art Urbain) ;\r\n\u2022VIBE, un festival de musique : cinq escaliers iconiques du centre-ville se transforment en gradins \u00e0 ciel ouvert.\r\n\r\nInfos pratiques : \r\n\r\nL\u2019\u00e9v\u00e9nement se d\u00e9roule du 14 juillet au 14 ao\u00fbt, du jeudi au samedi de 12h \u00e0 22h et le dimanche de 12h \u00e0 20h.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.inthestreets.be\/","email":null,"phone_contact":"+32 2 318 64 70","phone_booking":"+32 2 318 64 70","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535902.html"},"nl":{"name":"In the Streets","shortdescr":"Bij IN THE STREETS speelt alles zich op straat af. Het is immers de bedoeling een divers stadspubliek, overwegend samengesteld uit gezinnen, een sfeervolle, inclusieve ervaring te bezorgen. Een waaier aan gezellige evenementen, gratis bovendien, biedt de kans op ongewone ontdekkingen en maakt het stadscentrum aantrekkelijker en dynamischer dan ooit.","longdescr":"Het evenement omvat gratis evenementen (sportief, cultureel en artistiek), uitnodigend en instagramwaardig. Ze onderstrepen de identiteit van enkele wijken die tot de aantrekkelijkste van de hoofdstad behoren. Er wachten de bezoeker verrassende ontdekkingen.\r\n\r\nAl kuierend door het stadscentrum worden zowel Brusselaars als toeristen zowat om de 200 meter verrast:\r\n\u2022PLAY UP en PLAY DOWN, twee city villages: stadssporten en andere zomerse activiteiten; \r\n\u2022WALK, een parcours dat beide villages met elkaar verbindt: vijf originele artistieke installaties en diverse bestaande routes (Street Art Parcours en Stripparcours, muurschilderingen en andere werken van het Comit\u00e9\u0301 voor Kunst in de Stad);\r\n\u2022VIBE, een muziekfestival: vijf iconische trappen in het stadscentrum worden omgetoverd tot tribunes in de openlucht.\r\n\r\nPraktische informatie: \r\n\r\nHet evenement vindt plaats van 14 juli tot en met 14 augustus, van donderdag tot en met zaterdag van 12.00 tot 22.00 uur en op zondag van 12.00 tot 20.00 uur.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535902.html"},"en":{"name":"In the Streets","shortdescr":"At IN THE STREETS, everything happens in the streets to allow the resolutely urban, family-oriented and diverse public will experience an agreeable, welcoming and inclusive city. A host of free and convivial events will allow for unusual discoveries in a city centre which is more attractive and dynamic than ever before.","longdescr":"The event will offer free sporting, cultural and artistic events, all of which will be convivial and Instagrammable. They highlight the identity of some of the capital's most attractive neighbourhoods and lead to some surprising discoveries!\r\n\r\nThe inhabitants of Brussels and tourists who amble through the narrow streets of the city centre have a surprise in store every 200 meters (at most):\r\n\u2022PLAY UP and PLAY DOWN, two urban villages: city sports and other summer activities; \r\n\u2022WALK, a route linking these two villages: five original art installations and various existing routes (Street Art and Comic Book Route, murals and other works of the Urban Art Committee);\r\n\u2022VIBE, a music festival: five iconic city centre staircases are transformed into open-air stands.\r\n\r\nPractical information: \r\n\r\nThe event takes place from July 14 to August 14, Thursday to Saturday from 12pm to 10pm and Sunday from 12pm to 8pm.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535902.html"},"de":{"name":"In the Streets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/535902.html"},"it":{"name":"In the Streets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/535902.html"},"sp":{"name":"In the Streets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/535902.html"},"pt":{"name":"In the Streets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/535902.html"},"cn":{"name":"In the Streets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email