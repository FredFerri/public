nda\/event-detail.50003635"},"fr":{"name":"Expo Dagnino et hommage \u00e0 Pacheco","shortdescr":"CR\u00c9ABULLES \u00e0 la Galerie Passerelle Louise\n- Hommage \u00e0 Carlos PACHECO\n- Fernando DAGNINO \"Winter Queen\"\n","longdescr":"En cette fin octobre 2023, c'est avec une certaine \u00e9motion que nous vous proposons une exposition hommage d\u00e9di\u00e9e \u00e0 Carlos Pacheco, qui nous a quitt\u00e9s il y aura bient\u00f4t un an, \u00e0 laquelle plusieurs dessinateurs de diff\u00e9rentes nationalit\u00e9s ont aussit\u00f4t r\u00e9pondu. Leur travail sera expos\u00e9 sous forme de dessins originaux ou \u0153uvres digitales en print in\u00e9dits. C'est avec grand plaisir que nous vous attendons nombreux \u00e0 cette exposition hommage.\nCr\u00e9abulles vous invite \u00e9galement \u00e0 venir d\u00e9couvrir l\u2019exposition consacr\u00e9e \u00e0 Fernando Dagnino qui pr\u00e9sentera les planches de son dernier album Winter Queen paru chez Gl\u00e9nat ainsi que de nombreuses illustrations originales qui refl\u00e8tent les diff\u00e9rentes facettes de son talent.","performers":"ASBL Cr\u00e9abulles, Fernando Dagnino, Ruben Del Rincon et Roger Vidal","boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003635"},"sp":{"name":"Expo Dagnino et hommage \u00e0 Pacheco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003635"},"nl":{"name":"Expo Dagnino et hommage \u00e0 Pacheco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors