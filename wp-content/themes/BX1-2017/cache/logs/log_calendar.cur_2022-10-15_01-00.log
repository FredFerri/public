book_link":null,"publication_state":"public","last_updated_at":"2022-10-11T06:35:50+02:00","published_at":"2022-09-09T14:41:47+02:00","backoffice_id":261475,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":542866,"date_start":"2022-10-15","date_end":"2022-10-15","date_next":"2022-10-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"],"de":["Stadtteile"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Brussels Mobility Game","shortdescr":"Le samedi 15 octobre, participez au Brussels Mobility Game! Constituez votre \u00e9quipe, relevez des d\u00e9fis autour de la mobilit\u00e9 et tentez de remporter un des nombreux prix mis en jeu!","longdescr":"Inscrivez-vous au Brussels Mobility Game et tentez de gagner de nombreux prix !\r\nL'entra\u00eeneur de l'\u00e9quipe de curling d\u2019Uccle a disparu et doit \u00eatre retrouv\u00e9 avant le prochain match ! Formez une \u00e9quipe de 3 ou 4 personnes et rendez-vous au centre culturel d'Uccle le samedi 15 octobre pour lancer la recherche !\r\nVoici les prix \u00e0 gagner :\r\n\u2022 1 voyage en train de nuit de Bruxelles \u00e0 Vienne avec 2 nuits en h\u00f4tel pour 4 personnes,\r\n\u2022 4 bons cadeaux d'une valeur de 200\u20ac,\r\n\u2022 1 trottinette \u00e9lectrique,\r\n\u2022 2 exp\u00e9riences gastronomiques pour 4 personnes\r\nVous souhaitez d\u00e9couvrir de mani\u00e8re ludique les diff\u00e9rents modes de transport \u00e0 Bruxelles avec en plus \u00e0 la cl\u00e9 des cadeaux \u00e0 gagner ?\r\n\r\nInscrivez-vous d\u00e8s maintenant au Brussels Mobility Game sur : https:\/\/www.brusselsmobilitygame.be","performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselsmobilitygame.be","email":"info@brusselmobilitygame.be","phone_contact":"+32 80 09 40 01","phone_booking":"+32 80 09 40 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542866"},"nl":{"name":"Brussels Mobility Game","shortdescr":"Doe op zaterdag 15 oktober mee met de Brussels Mobility Game! Stel een eigen team samen, ga samen mobiliteitsuitdagingen aan en maak kans op \u00e9\u00e9n van onze prijzen!","longdescr":"Schrijf je in voor de Brussels Mobility Game en maak kans op mooie prijzen!\r\nDe coach van het Ukkels curlingteam is verdwenen en moet gevonden worden voor de volgende wedstrijd plaatsvindt! Vorm een speurteam van 3 of 4 vrienden en kom op zaterdag 15 oktober samen bij het Cultureel centrum van Ukkel om de zoektocht te starten!\r\nDe beloningen bestaan uit:\r\n\u2022 1 nachttreinreis Brussel - Wenen met 2 overnachtingen in een hotel voor 4 personen, \r\n\u2022 4 cadeaubonnen ter waarde van \u20ac 200, \r\n\u2022 1 elektrische step,\r\n\u2022 2 gastronomische ervaringen voor 4 personen\r\nWil je spelenderwijs de verschillende mobiliteitsdiensten in Brussel ontdekken en tegelijkertijd kans maken om prijzen te winnen? \r\n\r\nSchrijf je dan nu in voor de Brussels Mobility Game via: https:\/\/www.brusselsmobilitygame.be","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542866"},"en":{"name":"Brussels Mobility Game","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542866"},"de":{"name":"Brussels Mobility Game","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542866"},"it":{"name":"Brussels Mobility Game","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542866"},"sp":{"name":"Brussels Mobility Game","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542866"},"pt":{"name":"Brussels Mobility Game","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542866"},"cn":{"name":"Brussels Mobility Game","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542866"}},"place":{"id":7929,"translations":{"fr":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"Le Centre culturel d\u2019Uccle est contemporain de l\u2019Atomium. Con\u00e7u pour se trouver dans un \u00e9crin de verdure, face au Parc de Wolvendael, la premi\u00e8re pierre fut pos\u00e9e le 30 novembre 1957. Le Centre Culturel et Artistique d\u2019Uccle fut inaugur\u00e9 le 5 octobre 1958.\r\nLe CCU est une \u0153uvre de l\u2019architecte L\u00e9on Stynen, qui avait aussi con\u00e7u les casinos de Knokke, Blankenberge et Ostende.\r\nCe nouveau Centre Culturel permit aux soci\u00e9t\u00e9s et associations int\u00e9ress\u00e9es d\u2019organiser des bals, des conf\u00e9rences, des concerts, des projections de films, des d\u00e9bats et toutes autres manifestations culturelles et artistiques (ballets, concerts, expositions, r\u00e9ceptions, \u2026). Il proposait aussi des repr\u00e9sentations th\u00e9\u00e2trales, un cycle de conf\u00e9rences et des spectacles musicaux.\r\nL'ensemble du b\u00e2timent abrite principalement un hall d\u2019entr\u00e9e donnant acc\u00e8s \u00e0 une grande Salle de Spectacle de 800 fauteuils, un Grand Foyer pouvant accueillir jusqu'\u00e0 400 personnes assises, ainsi qu'un Petit Foyer pouvant contenir 120 personnes.\r\nPlus de cinquante ans apr\u00e8s sa cr\u00e9ation, le Centre Culturel d\u2019Uccle r\u00e9nov\u00e9 a un look \u00e0 la fois contemporain et chaleureux. Pleinement actif, il r\u00e9pond aux d\u00e9fis culturels de son si\u00e8cle en accueillant les plus grands noms du th\u00e9\u00e2tre, de la danse, de la chanson et de la musique ainsi que des artistes et des conf\u00e9renciers de renom. Il s\u2019est constamment modernis\u00e9 pour offrir \u00e0 son public une vie culturelle de qualit\u00e9 au c\u0153ur de la commune d\u2019Uccle.\r\nDirig\u00e9 par une \u00e9quipe dynamique, le CCU met tout en \u0153uvre pour fid\u00e9liser sa client\u00e8le et conqu\u00e9rir sans cesse un public nouveau.\r\nLe Centre Culturel d\u2019Uccle en quelques chiffres, c\u2019est\u2026\r\n-\tUn des plus grands centres culturels \u00e0 Bruxelles et ses environs\r\n-\tUn rendez-vous des professionnels du spectacle\r\n-\t4 espaces bien distincts (Hall, Grand Foyer, Petit Foyer, Salle de Spectacle)\r\n-\tUne salle de spectacle de 800 places\r\n-\tUn gradin r\u00e9tractable de 172 places\r\n-\t200 activit\u00e9s par an\r\n-\t600 artistes par saison\r\n-\t60.000 spectateurs par an\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CC Ukkel","address_street_name":"Rodestraat","address_street_number":"47","address_street_box":null,"email":"info@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Ukkel","address_line1":"Rodestraat, 47","address_line2":"1180 Ukkel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centre Culturel d'Uccle"