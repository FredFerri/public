se,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[3],"translations":{"fr":["Musique Contemporaine"],"nl":["Hedendaagse Muziek"],"en":["Contemporary music"],"de":["Zeitgen\u00f6ssische Musik"],"it":["Musica contemporanea"],"sp":["M\u00fasica contempor\u00e1nea"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","it","en"],"subtitles":[]},"translations":{"fr":{"name":"Elettro Mascarimir\u00ec - soir\u00e9e \u00e9lectro pizzica","shortdescr":"Apr\u00e8s l\u2019Alg\u00e9rie, on continue notre tour du monde des cultures avec un mois d\u00e9di\u00e9 \u00e0 l\u2019Italie. Le samedi 18 mars, c\u2019est un artiste originaire des Pouilles (sud de l\u2019Italie) qui viendra \u00e9lectriser le MedexMuseum.","longdescr":"Apr\u00e8s l\u2019Alg\u00e9rie, on continue notre tour du monde des cultures avec un mois d\u00e9di\u00e9 \u00e0 l\u2019Italie. En mars, des artistes de la deuxi\u00e8me communaut\u00e9 \u00e9trang\u00e8re de Belgique racontent pourquoi ils & elles ont quitt\u00e9 l\u2019Italie et ce qu\u2019ils ont emport\u00e9 avec eux de leur culture. \r\n\r\nLe samedi 18 mars, c\u2019est un artiste originaire des Pouilles dans le sud de l\u2019Italie qui viendra \u00e9lectriser le MedexMuseum. \r\n\r\n\u2028\u00ab\u00a0Elettro Mascarimir\u00ec\u00a0\u00bb, c\u2019est une version trans-\u00e9lectronique de la\u00a0\u00ab\u00a0trad-innovazione\u00a0\u00bb du groupe Masscarim\u00ec, brassant les rythmes de la musique salentine comme la pizzica \u00e0 d\u2019autres sonorit\u00e9s du bassin m\u00e9diterran\u00e9en. \r\n\r\nDanse folklorique de la r\u00e9gion des Pouilles, la pizzica est un type de \u00ab\u00a0tarantelle\u00a0\u00bb, cette danse th\u00e9rapeutique et cathartique n\u00e9e au XIVe si\u00e8cle pour traiter le poison diffus\u00e9 par la morsure d\u2019une araign\u00e9e. \r\n\r\nAvant le concert, des performances et un banquet italien vous r\u00e9galeront les yeux et l\u2019estomac.  \r\n\r\nPlus d'infos sur la page de l'\u00e9v\u00e8nement = https:\/\/fb.me\/e\/2zpQdFVVZ \r\n\r\nCet \u00e9v\u00e8nement b\u00e9n\u00e9ficie du soutien de la r\u00e9gion Bruxelles-Capitale.","performers":"Mascarimir\u00ec ; Claudio Cavallo (chant, tambour, instruments \u00e0 vents ethniques) ; Kasia \u00ab Kashu \u00bb Kurdziel (arts visuels)","boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2zpQdFVVZ","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552289"},"nl":{"name":"Elettro Mascarimir\u00ec - soir\u00e9e \u00e9lectro pizzica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2zpQdFVVZ","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552289"},"en":{"name":"Elettro Mascarimir\u00ec - soir\u00e9e \u00e9lectro pizzica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2zpQdFVVZ","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552289"},"de":{"name":"Elettro Mascarimir\u00ec - soir\u00e9e \u00e9lectro pizzica @MedexMuseum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2zpQdFVVZ","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552289"},"it":{"name":"Elettro Mascarimir\u00ec - soir\u00e9e \u00e9lectro pizzica @MedexMuseum","shortdesc