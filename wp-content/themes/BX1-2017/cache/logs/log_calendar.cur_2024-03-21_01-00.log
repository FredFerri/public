,"performers":null,"boxoffice_url":null,"website":"https:\/\/fondationastichting.com\/nl\/","email":"info@fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005657"}},"place":{"id":251684,"translations":{"de":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Van Volxemlaan, 304","address_line2":"1190 Forest","description_web":"The Foundation is settled in a formerly industrial area of the town which has gradually been transformed into a residential neighborhood with many sites devoted to artistic creation. As a cultural actor, the Foundation\u2019s desire is to participate in the life of this neighborhood. A genuine platform devoted to the photographic image, the A Foundation also works toward forming partnerships for exhibition and book projects organized in collaboration with Belgian and international cultural institutions.\nIn October 2012, the A Foundation opened its doors in the south of Brussels on the site of the former Bata factories. Created upon the initiative of d\u2019Astrid Ullens de Schooten Whettnall, and recognized as promoting the public interest, it has a vocation to support the creation, knowledge, and preservation of the photographic image.\n","description_print":null,"booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null,"visit_url":null},"it":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"La Fondation s\u2019inscrit dans une zone de la ville anciennement vou\u00e9e \u00e0 l\u2019industrie qui s\u2019est progressivement transform\u00e9e en un quartier de logements avec de nombreux lieux consacr\u00e9s \u00e0 la cr\u00e9ation artistique. Elle s\u2019y inscrit avec le d\u00e9sir, en tant qu\u2019acteur culturel, de participer \u00e0 la vie de ce quartier. V\u00e9ritable plate-forme consacr\u00e9e \u00e0 l\u2019image photographique, la Fondation A Stichting se propose \u00e9galement de devenir partenaire de projets d\u2019expositions et d\u2019\u00e9ditions, organis\u00e9es en collaboration avec des institutions culturelles belges et \u00e9trang\u00e8res.\nEn octobre 2012, la Fondation A Stichting ouvre ses portes au sud de Bruxelles, sur le site des anciennes usines Bata. Cr\u00e9\u00e9e \u00e0 l\u2019initiative d\u2019Astrid Ullens de Schooten Whettnall, reconnue d\u2019utilit\u00e9 publique, elle a pour vocation de soutenir la cr\u00e9ation, la connaissance et la conservation de l\u2019image photographique.\n","description_print":null,"booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null,"visit_url":null},"sp":{"name":"Fundaci\u00f3n A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"En octubre de 2012, la Fundaci\u00f3n A stichting abri\u00f3 sus puertas en el sur de Bruselas en el lugar de la antigua f\u00e1brica Bata. Creada bajo la iniciativa de Astrid Ullens de Schooten, y reconocida por promover el inter\u00e9s p\u00fablico, tiene una vocaci\u00f3n para apoyar la creaci\u00f3n, el conocimiento y la preservaci\u00f3n de la imagen fotogr\u00e1fica. Ya no existe nada que no parezca haber sido atestiguado por la imagen. Sin embargo, la idea de dejar constancia sobre el uso real de la fotograf\u00eda no es necesaria. Lo que ocurre con nuestra capacidad de ver y percibir cuando en su abundancia y su inmediaci\u00f3n virtual, las im\u00e1genes que nos rodean se est\u00e1n convirtiendo r\u00e1pida y poderosamente m\u00e1s complicadas. El proyecto de la fundaci\u00f3n consiste en explorar las riesgos y contradicciones  de la imagen-documento, cuestionando un mundo en el que todo es visible. Organiza tres exhibiciones temporales cada a\u00f1o.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 304","address_line2":"1190 Vorst","description_web":"De Stichting bevindt zich in een stadsdeel waar vroeger industrie was en dat geleidelijk aan een wijk werd voor bewoning, met een heel aantal organisaties gewijd aan artistieke creatie. Als culturele actor wil de Stichting deel uitmaken van dat buurtleven. A Stichting, een platform gewijd aan de fotografie, wil zich tevens engageren als partner van tentoonstellings- en boekprojecten georganiseerd in samenwerking met Belgische en buitenlandse culturele instellingen.\nIn oktober 2012 opent A Stichting haar deuren in het zuiden van Brussel, op de site van de voormalige fabrieken van Bata. De stichting, een initiatief van d\u2019Astrid Ullens de Schooten Whettnall, is een vereniging van openbaar nut en stelt zich tot doel ondersteuning te bieden aan de creatie, de kennis en de conservatie van het fotografische beeld.\n","description_print":null,"booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"art_center","facebook_id":null,"backoffice_id":13764,"location":{"lat":50.8227478,"lon":4.3257667},"region":"brussels","last_updated_at":"2024-01-17T13:58:54+01:00","published_at":"2013-10-19T01:38:02+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":251684,"translations":{"de":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondatio