ext":"2024-02-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-18T01:03:52+01:00","published_at":"2023-10-18T15:55:47+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":287365,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.29119348824543295,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Holding Rehearsals by Robin Vanbesien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50003509"},"pt":{"name":"Holding Rehearsals by Robin Vanbesien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003509"},"en":{"name":"Robin Vanbesien - 'Holding Rehearsals'","shortdescr":null,"longdescr":"\n\nAs a visual artist and filmmaker, Robin Vanbesien explores modes of embodied knowledge and collective imagination engaged in social and political struggles. Through a series of audiovisual works, his exhibition Holding Rehearsals by Robin Vanbesien traces a lived social infrastructure of care, solidarity, and struggle that is addressing recent cases of police and state violence in the context of migration border controls in Belgium and France. Vanbesien has organized hearings on the case of Mawda Shawri and other deadly Channel crossings, assembling the stories and reflections of resident activists - both documented and undocumented.\n\nPlease note that the exhibition includes a 75-minute audiovisual installation.\nThe screening starts at 13:15, 14:45, 16:15.\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003509"},"it":{"name":"Holding Rehearsals by Robin Vanbesien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003509"},"cn":{"name":"Holding Rehearsals by Robin Vanbesien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003509"},"fr":{"name":"Robin Vanbesien - 'Holding Rehearsals'","shortdescr":null,"longdescr":"\n\nEn tant qu\u2019artiste visuel et cin\u00e9aste, Robin Vanbesien explore les modes de connaissance incarn\u00e9e et d\u2019imagination collective engag\u00e9es dans les luttes sociales et politiques. \u00c0 travers une s\u00e9rie d'\u0153uvres audiovisuelles, son exposition Holding Rehearsals \u00e0 La Loge retrace une infrastructure sociale v\u00e9cue ax\u00e9e sur les soins, la solidarit\u00e9 et la lutte, qui fait face \u00e0 des cas r\u00e9cents de violences polici\u00e8re et \u00e9tatique dans le contexte des contr\u00f4les des fronti\u00e8res migratoires en Belgique et en France. Vanbesien a organis\u00e9 des auditions sur le cas de Mawda Shawri et d'autres travers\u00e9es mortelles de la Manche, rassemblant les histoires et les r\u00e9flexions d'activistes r\u00e9sidents avec ou sans papiers.\n\nNotez que l'exposition inclut une installation audiovisuelle de 75 minutes. La projection d\u00e9marre les jours d'ouverture \u00e0 13:15, 14:45, 16:15.\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003509"},"sp":{"name":"Holding Rehearsals by Robin Vanbesien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003509"},"nl":{"name":"Robin Vanbesien - 'Holding Rehearsals'","shortdescr":null,"longdescr":"Als beeldend kunstenaar en filmmaker onderzoekt Robin Vanbesien vormen van belichaamde kennis en collectieve verbeelding die zich in sociale en politieke strijd situeren. In zijn tentoonstelling Holding Rehearsals traceert hij aan de hand van verschillende audiovisuele werken een geleefde sociale infrastructuur van zorg, solidariteit en strijd, gericht op recente gevallen van politie- en staatsgeweld in de context van grenscontroles in Belgi\u00eb en Frankrijk. Vanbesien organiseerde hoorzittingen over de zaak Mawda Shawri en andere dodelijke oversteekpogingen over het Kanaal. Hij verzamelde daarbij de verhalen en reflecties van zowel activisten zonder papieren als die met papieren.\n\nLet op : In de tentoonstelling wordt een audiovisuele installatie van 75 minuten getoond. De vertoning start om 13:15, 14:45 en 16:15.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003509"}},"place":{"id":238201,"translations":{"de":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge ist ein Ort, der sich der zeitgen\u00f6ssischen Kunst, der Architektur und der Theori widmet und von dem Architekten Philippe Rotthier gegr\u00fcndet wurde. Ziel ist die Ausarbeitung einer hochwertigen Programmgestaltung mit konkreten und kritischen Projekten, die angesichts des gegenw\u00e4rtigen kulturellen Kontexts von Belang sind. Architekten, K\u00fcnstler, Ausstellungskommissare und kulturelle Akteure sind eingeladen, ihre Vorschl\u00e4ge und die spezifischen Aspekte aus ihrer Arbeit einzubringen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge is a Brussels-based space dedicated to contemporary art, architecture and theory founded by architect Philippe Rotthier. Its aim is to develop a high-quality program that plays a critical role in today\u2019s cultural conversations through specific and precise projects. Architects, artists, curators and cultural agents are invited to develop propositions in which they seek out the characteristic and the peculiar within their practices.\r\nLa Loge is a space where ideas, discussion and presentation coexist. Public formats vary depending on the project; from exhibitions, symposiums, screenings, lectures, and performances to events\u2019 series. Its identity is drawn from the architectural gem that houses it, as well as from the commitment and concerns of its founders. La Loge values engagement of thought and feels particularly interested in exploring questions of space, habitat and use. The small-scale format of La Loge contributes to a context where intimate and direct conversations with its audience and the diversity of protagonists it invites can be initiated and sustained.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null,"visit_url":null},"it":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge est un espace d\u00e9di\u00e9 \u00e0 l\u2019art contemporain, l\u2019architecture et la th\u00e9orie, initi\u00e9e par l\u2019architecte Philippe Rotthier. Son objectif est de d\u00e9velopper une programmation de qualit\u00e9 \u00e0 travers des projets pr\u00e9cis et critiques, qui font sens au sein des enjeux culturels actuels. Architectes, artistes, commissaires d\u2019expositions et acteurs culturels sont invit\u00e9s \u00e0 y articuler des propositions qui explorent les aspects sp\u00e9cifiques de leur pratique.\r\nLa Loge est un lieu o\u00f9 coexistent les id\u00e9es, la discussion et la pr\u00e9sentation.\r\nChaque projet est d\u00e9velopp\u00e9 selon une formule de pr\u00e9sentation qui lui est propre, allant de l\u2019exposition au s\u00e9minaire, de la projection \u00e0 la conf\u00e9rence, de la performance \u00e0 la s\u00e9rie d\u2019\u00e9v\u00e9nements.\r\nLa Loge puise son identit\u00e9 dans le joyau architectural qui l\u2019abrite ainsi que dans l\u2019engagement et les pr\u00e9occupations de ses fondateurs. La Loge valorise une pens\u00e9e engag\u00e9e et s\u2019int\u00e9resse en particulier \u00e0 des -questions d\u2019espace, d\u2019habitat et d\u2019usage. La structure d\u2019envergure relativement r\u00e9duite de La Loge g\u00e9n\u00e8re un contexte qui permet d\u2019engager et de poursuivre un dialogue direct et intime, tant avec son public qu\u2019avec la diversit\u00e9 d\u2019intervenants qui y sont invit\u00e9s.\r\n ","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null,"visit_url":null},"sp":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Loge","address_street_name":"Kluisstraat","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Kluisstraat, 86","address_line2":"1050 Ixelles","description_web":"La Loge is een Brusselse ruimte opgericht door architect Philippe Rotthier en gewijd aan hedendaagse kunst, architectuur en theorie. Het doel is een hoogwaardig programma te ontwikkelen dat een cruciale rol speelt in het hedendaagse culturele debat door middel van concrete en punctuele projecten. Architecten, kunstenaars, curatoren en andere culturele spelers  worden uitgenodigd om voorstellen in te dienen waarin ze op zoek gaan naar het karakteristieke en bijzondere in hun praktijk.\r\nLa Loge is een ruimte waar idee\u00ebn, dialoog en presentatie samengaan. Publieksformaten vari\u00ebren afhankelijk van het project. Dat kan gaan van tentoonstellingen, symposia, filmprojecties, lezingen tot performances of een evenementenreeks. De identiteit van La Loge is geankerd in het architectonisch juweeltje waarin het is  gevestigd maar ook in de toewijding en interesses van de oprichters. La Loge waardeert intellectueel engagement en is in het bijzonder ge\u00efnteresseerd in de verkenning van vragen rond ruimte, habitat en gebruik.\r\nDe kleinschalige vorm van La Loge draagt bij tot een context waarin er plaats is voor intieme, directe gesprekken tussen het publiek en erg diverse gesprekspartners.\r\n \r\n","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null,"visit_url":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"art_center","facebook_id":null,"backoffice_id":1942,"location":{"lat":50.82845961,"lon":4.36564707},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:14:46+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":238201,"translations":{"de":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge ist ein Ort, der sich der zeitgen\u00f6ssischen Kunst, der Architektur und der Theori widmet und von dem Architekten Philippe Rotthier gegr\u00fcndet wurde. Ziel ist die Ausarbeitung einer hochwertigen Programmgestaltung mit konkreten und kritischen Projekten, die angesichts des gegenw\u00e4rtigen kulturellen Kontexts von Belang sind. Architekten, K\u00fcnstler, Ausstellungskommissare und kulturelle Akteure sind eingeladen, ihre Vorschl\u00e4ge und die spezifischen Aspekte aus ihrer Arbeit einzubringen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge is a Brussels-based space dedicated to contemporary art, architecture and theory founded by architect Philippe Rotthier. Its aim is to develop a high-quality program that plays a critical role in today\u2019s cultural conversations through specific and precise projects. Architects, artists, curators and cultural agents are invited to develop propositions in which they seek out the characteristic and the peculiar within their practices.\r\nLa Loge is a space where ideas, discussion and presentation coexist. Public formats vary depending on the project; from exhibitions, symposiums, screenings, lectures, and performances to events\u2019 series. Its identity is drawn from the architectural gem that houses it, as well as from the commitment and concerns of its founders. La Loge values engagement of thought and feels particularly interested in exploring questions of space, habitat and use. The small-scale format of La Loge contributes to a context where intimate and direct conversations with its audience and the diversity of protagonists it invites can be initiated and sustained.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null,"visit_url":null},"it":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge est un espace d\u00e9di\u00e9 \u00e0 l\u2019art contemporain, l\u2019architecture et la th\u00e9orie, initi\u00e9e par l\u2019architecte Philippe Rotthier. Son objectif est de d\u00e9velopper une programmation de qualit\u00e9 \u00e0 travers des projets pr\u00e9cis et critiques, qui font sens au sein des enjeux culturels actuels. Architectes, artistes, commissaires d\u2019expositions et acteurs culturels sont invit\u00e9s \u00e0 y articuler des propositions qui explorent les aspects sp\u00e9cifiques de leur pratique.\r\nLa Loge est un lieu o\u00f9 coexistent les id\u00e9es, la discussion et la pr\u00e9sentation.\r\nChaque projet est d\u00e9velopp\u00e9 selon une formule de pr\u00e9sentation qui lui est propre, allant de l\u2019exposition au s\u00e9minaire, de la projection \u00e0 la conf\u00e9rence, de la performance \u00e0 la s\u00e9rie d\u2019\u00e9v\u00e9nements.\r\nLa Loge puise son identit\u00e9 dans le joyau architectural qui l\u2019abrite ainsi que dans l\u2019engagement et les pr\u00e9occupations de ses fondateurs. La Loge valorise une pens\u00e9e engag\u00e9e et s\u2019int\u00e9resse en particulier \u00e0 des -questions d\u2019espace, d\u2019habitat et d\u2019usage. La structure d\u2019envergure relativement r\u00e9duite de La Loge g\u00e9n\u00e8re un contexte qui permet d\u2019engager et de poursuivre un dialogue direct et intime, tant avec son public qu\u2019avec la diversit\u00e9 d\u2019intervenants qui y sont invit\u00e9s.\r\n ","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null,"visit_url":null},"sp":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Loge","address_street_name":"Kluisstraat","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-l