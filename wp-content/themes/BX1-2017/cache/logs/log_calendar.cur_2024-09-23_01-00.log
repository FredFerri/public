s":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000509"},"en":{"name":"Adieu, moi je reste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000509"},"it":{"name":"Adieu, moi je reste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000509"},"cn":{"name":"Adieu, moi je reste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000509"},"fr":{"name":"Adieu, moi je reste","shortdescr":"Sofia Douieb d\u00e9couvre que sa grand-m\u00e8re paternelle est n\u00e9e dans une famille juive d'Essaouira. Convertie \u00e0 l'islam, elle est reni\u00e9e des siens. Sofia d\u00e9cide de partir \u00e0 la recherche de cette famille Benlolo, exil\u00e9e aux quatre coins du monde. \n","longdescr":"Sofia Douieb d\u00e9couvre que Zhor, sa grand-m\u00e8re paternelle, qu\u2019elle a toujours connue musulmane, est n\u00e9e dans une famille juive d\u2019Essaouira sous le pr\u00e9nom Sultana. Elle se convertit \u00e0 l\u2019islam et perd sa famille qui s\u2019exile aux quatre coins du monde. Sofia, journaliste, d\u00e9cide de partir \u00e0 leur recherche\n\nLe 19 septembre, \u00e0 19h00, Sofia Douieb pr\u00e9sentera son livre \u00ab Adieu, moi je reste \u00bb (Edern Editions), en pr\u00e9sence de l\u2019\u00e9crivain Yves Wellens","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000509"},"sp":{"name":"Adieu, moi je reste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000509"},"nl":{"name":"Adieu, moi je reste","shortdescr":"Sofia Douieb ontdekt dat haar grootmoeder van vaderskant is geboren in een Joodse familie in Essaouira. Ze bekeerde zich tot de islaamse godsdienst en werd door haar familie verstoten. Sofia beslist om op zoek te gaan naar deze Benlolo-familie, verbannen naar alle uithoeken van de wereld.","longdescr":"Sofia Douieb ontdekt dat Zhor, haar grootmoeder van vaderskant, van wie ze altijd had geweten als moslimse, was geboren in een joodse familie in Essaouira onder de naam Sultana. Ze bekeerde zich tot de islam en verloor haar familie, die over de hele wereld in ballingschap ging. Sofia, een journaliste, besluit naar hen op zoek te gaan.\n\nOp 19 september, om 19u00 stelt Sofia Douieb haar boek \u201cAdieu, moi je reste\u201d (Edern Editions) voor, in aanwezigheid van schrijver Yves Wellens.","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000509"}},"place":{"id":243578,"translations":{"de":{"name":"Maison des Cultures et de la coh\u00e9sion sociale de Mo