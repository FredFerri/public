ns":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[37,36],"translations":{"de":["Audiovisuelle K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Audiovisual art","Museums and art centers"],"it":["Arti audiovisive","Musei e centri artistici"],"cn":[null,null],"fr":["Arts audiovisuels","Mus\u00e9es et art centers"],"sp":["Artes audiovisuales","Museos y centros de arte"],"nl":["Audiovisuele kunst","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Div.fuse media arts festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.divfuse.be\/","email":"info@argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004162"},"pt":{"name":"Div.fuse media arts festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.divfuse.be\/","email":"info@argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004162"},"en":{"name":"Div.fuse media arts festival","shortdescr":"BREEDBEELD x argos proudly present Div.fuse, a brand new Media Arts Festival. We join forces by opening our doors to showcase and inspire new talents and emerging artists through an exhibition, workshops, lectures and feedback.","longdescr":"Does the internet inspire you? Are you into film, coding or making your own electronic instruments? Then Div.fuse might be for you.\n\nFor eight days you can come and experience everything media art, video and technology has to offer in Argos. Through workshops you explore the fab lab, become acquainted with new techniques or learn to refine your own work. At the exhibition or during the lectures you will become acquainted with the work of other artists.\n\nAfter all, the festival is a meeting place of styles, ideas and people, a community of media artists. You will get to know other makers and organizations and can have a drink in the foyer and discuss the works.","performers":"Jannes Snyers\nMonica Basbous & Charbel Alkhoury\nShino Matsuura\nQuinten De Wilde\nAsma Laajimi\nL\u00e9a Mainguy\nAna In\u00e9s Spagnolo L\u00f3pez\nLo\u00efs Soleil\nGabriella Achadinha\nBrecht De Cock\nLuka Van der Cruyssen\nLoes Vanneste\nLyn de Weijer","boxoffice_url":null,"website":"https:\/\/www.divfuse.be\/","email":"info@argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004162"},"it":{"name":"Div.fuse media arts festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.divfuse.be\/","email":"info@argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004162"},"cn":{"name":"Div.fuse media arts festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.divfuse.be\/","email":"info@argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004162"},"fr":{"name":"festival des arts m\u00e9diatiques","shortdescr":"BREEDBEELD x argos ont le plaisir de pr\u00e9senter Div.fuse, un tout nouveau festival d'arts num\u00e9riques. \u00c0 cette occasion, nous cr\u00e9ons un cadre propice pour mettre en lumi\u00e8re de nouveaux talents et artistes \u00e9mergents \u00e0 travers une exposition, des ateliers, des conf\u00e9rences et des sessions de feedbacks.","longdescr":"Internet vous inspire ? Aimez-vous le cin\u00e9ma, le codage ou la fabrication de vos propres instruments \u00e9lectroniques ? Alors Div.fuse est fait pour vous.\n\nPendant huit jours, \u00e0 Argos vous pourrez go\u00fbter \u00e0 tout ce que les arts m\u00e9diatiques, la vid\u00e9o et la technologie ont \u00e0 offrir. Dans des ateliers, vous explorez le fab lab, vous familiarisez avec de nouvelles techniques ou apprenez \u00e0 affiner votre propre travail. Lors de l'exposition ou lors des conf\u00e9rences, vous ferez connaissance avec le travail d'autres artistes.\n\nApr\u00e8s tout, le festival est un lieu de rencontre de styles, d'id\u00e9es et de personnes, une communaut\u00e9 d'artistes m\u00e9diatiques. Vous ferez connaissance avec d'autres cr\u00e9ateurs et organisations et pourrez prendre un verre dans le foyer et discuter des \u0153uvres.","performers":"Jannes Snyers\nMonica Basbous & Charbel Alkhoury\nShino Matsuura\nQuinten De Wilde\nAsma Laajimi\nL\u00e9a Mainguy\nAna In\u00e9s Spagnolo L\u00f3pez\nLo\u00efs Soleil\nGabriella Achadinha\nBrecht De Cock\nLuka Van der Cruyssen\nLoes Vanneste\nLyn de Weijer","boxoffice_url":null,"website":"https:\/\/www.divfuse.be\/","email":"info@argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004162"},"sp":{"name":"Div.fuse media arts festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.divfuse.be\/","email":"info@argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004162"},"nl":{"name":"Div.fuse mediakunstfestival","shortdescr":"BREEDBEELD x argos introduceren met veel enthousiasme Div.fuse, een fonkelnieuw media arts festival. We slaan de handen ineen om nieuw talent en opkomende kunstenaars te tonen en te inspireren met een expo, workshops, lezingen en feedbacksessies.","longdescr":"Inspireert het internet je? Ben je bezig met film, coderen of maak je je eigen elektronische instrumenten? Dan is Div.fuse iets voor jou. \n \nAcht dagen lang kan je in argos komen proeven van al wat mediakunst, video en technologie te bieden hebben. Via workshops verken je het fablab, maak je kennis met nieuwe technieken of leer je jouw eigen werk scherper te stellen. In de expo of tijdens de lezingen maak je dan weer kennis met het werk van andere kunstenaars.\n\nHet festival is immers een ontmoetingsplaats van stijlen, idee\u00ebn en mensen, een community van mediakunstenaars. Je leert er andere makers en organisaties kennen en kan in de foyer napraten met een drankje en discussi\u00ebren over de werken.","performers":"Jannes Snyers\nMonica Basbous & Charbel Alkhoury\nShino Matsuura\nQuinten De Wilde\nAsma Laajimi\nL\u00e9a Mainguy\nAna In\u00e9s Spagnolo L\u00f3pez\nLo\u00efs Soleil\nGabriella Achadinha\nBrecht De Cock\nLuka Van der Cruyssen\nLoes Vanneste\nLyn de Weijer","boxoffice_url":null,"website":"https:\/\/www.divfuse.be\/","email":"info@argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004162"}},"place":{"id":228372,"translations":{"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussels","address_line1":"Werfstraat, 13","address_line2":"1000 Brussels","description_web":"Founded in 1989 in Brussels, argos is an institution and resource for the presentation, production, and study of critical audiovisual arts, as well as for its distribution, conservation and restoration. argos considers the audiovisual as a primary means of looking at and understanding the world in more open and integrated ways. Supporting a multiplicity of voices in society, it fosters dialogue with a broad range of institutional and non-institutional partners, both in Brussels and beyond, and seeks new ways to engage diverse audiences. \r\n\r\nargos makes exhibitions and programmes, distributes moving image works, and builds, preserves, and discloses a prominent collection of artist films and videos. It also houses a unique media library containing a broad selection of publications, as well as the audiovisual works of the collection, which is open to both professionals and the general public. Additionally, it develops original research projects relating to significant gaps in art history and its relationship to culture and society. Through these various activities, argos aims to more fully understand the past and present of audiovisual arts, as well as provide tools to collectively imagine and shape its futures.\r\n","description_print":null,"booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null,"visit_url":null},"it":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9 en 1989 \u00e0 Bruxelles, argos est un lieu ressource pour la pr\u00e9sentation, la production et le d\u00e9veloppement des arts audiovisuels critiques, ainsi que pour leur distribution, conservation et restauration.\r\n\r\nargos consid\u00e8re l\u2019audiovisuel comme un moyen des plus pertinents pour regarder et comprendre le monde de mani\u00e8re ouverte et int\u00e9gr\u00e9e. Soutenant les voix alternatives dans la soci\u00e9t\u00e9, il favorise le dialogue avec un large \u00e9ventail de partenaires institutionnels ou non, tant \u00e0 Bruxelles qu\u2019ailleurs. argis recherche sans cesse de nouvelles fa\u00e7ons d'impliquer et d\u2019associer les publics les plus larges.\r\n\r\nargos  con\u00e7oit des expositions et programmations, distribue les \u0153uvres audiovisuelles les plus contemporaines et critiques; sa mission par ailleurs constitue, conserve et fait conna\u00eetre un tr\u00e8s important fonds de films et de vid\u00e9os d\u2019artistes. Il comporte \u00e9galement une m\u00e9diath\u00e8que unique en son genre, ouverte aux professionnels et au grand public. Celle-ci inclut une tr\u00e8s large s\u00e9lection de publications et les \u0153uvres audiovisuelles de la collection. De plus, ARGOS d\u00e9veloppe des projets de recherche in\u00e9dits pour pallier les lacunes importantes dans l'histoire de l'art, questionnant les relations entre culture et soci\u00e9t\u00e9.\r\n\r\n\u00c0 travers ces multiples activit\u00e9s, argis a pour objectif de permettre une meilleure compr\u00e9hension du pass\u00e9 et du pr\u00e9sent des arts audiovisuels tout en fournissant les outils pour imaginer et fa\u00e7onner collectivement leur avenir.","description_print":null,"booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null,"visit_url":null},"sp":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussel","address_line1":"Werfstraat, 13","address_line2":"1000 Brussel","description_web":"argos werd opgericht in 1989 in Brussel en is een instituut, en bron, voor de studie, productie en vooruitgang van kritische audiovisuele kunsten, evenals de distributie, het behoud en de restauratie ervan.\r\n\r\nargos beschouwt het audiovisuele als een belangrijk middel om op meer open en ge\u00efntegreerde manieren de wereld te bekijken en te begrijpen. We ondersteunen een veelheid aan stemmen in de samenleving en gaan in dialoog met een breed scala aan institutionele en niet-institutionele partners, zowel in Brussel als daarbuiten. Zo willen we een steeds ruimer en \u200b\u200bmeer divers publiek bij onze activiteiten betrekken.\r\n\r\n\u249c\u24ad\u24a2\u24aa\u24ae maakt tentoonstellingen en programma's, distribueert audiovisuele werken en bouwt, beheert en ontsluit een prominente collectie van kunstenaarfilms en -video's. We hebben ook een unieke mediatheek met een ruime selectie van publicaties en de audiovisuele werken van de collectie, die zowel voor professionals als het algemene publiek toegankelijk is. Daarnaast ontwikkelen we originele onderzoeksprojecten met betrekking tot vooraanstaande hiaten in de kunstgeschiedenis en de relatie ervan tot cultuur en maatschappij.\r\n\r\nVia deze verschillende activiteiten wil argos het verleden en het heden van de audiovisuele kunsten beter doorgronden, en ook instrumenten bieden om collectief hun toekomst in te beelden en opnieuw vorm te geven.","description_print":null,"booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"art_center","facebook_id":null,"backoffice_id":769,"location":{"lat":50.856632,"lon":4.3496322},"region":"brussels","last_updated_at":"2024-06-06T14:59:20+02:00","published_at":"2013-10-19T01:13:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":228372,"translations":{"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelle