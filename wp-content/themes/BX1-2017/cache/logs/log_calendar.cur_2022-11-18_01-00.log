"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,259,263],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-20T01:06:46+02:00","published_at":"2022-08-23T15:42:29+02:00","backoffice_id":260193,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.17760448410452},{"id":540599,"date_start":"2022-09-01","date_end":"2023-08-31","date_next":"2022-12-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"ET SI ON EN PARLAIT ? - Spectacle d'improvisation des Gallapiats","shortdescr":null,"longdescr":"* ET SI ON EN PARLAIT ? *\r\n\r\nUne salle d\u2019attente o\u00f9 des patients vont participer \u00e0 une s\u00e9ance de th\u00e9rapie collective.\r\nLe c\u00e9l\u00e8bre professeur GALAPSTEIN est \u00e0 la man\u0153uvre avec son staff d\u2019assistantes qui circulent entre des tables basses garnies de magazines et de boites de Kleenex \u2026\r\n\r\nCes patients ont rempli leur fiche m\u00e9dicale car, s\u2019ils veulent gu\u00e9rir, ils devront se mettre \u00e0 nu et livrer leurs angoisses et leur mal-\u00eatre au Groupe !\r\n\r\n\r\n\r\n\u00ab Et si on en parlait ? \u00bb est un spectacle d\u2019improvisation sorti du cerveau d\u00e9rang\u00e9 des Galapiats, repr\u00e9sent\u00e9s par David HOROWITZ et Christian CHERPION.\r\n\r\n\r\n-------\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (Vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\nSur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\nSur place : 15\u20ac\/personne\r\n--> Pensez \u00e0 r\u00e9server","performers":"L'\u00e9quipe des Gallapiats","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540599"},"nl":{"name":"ET SI ON EN PARLAIT ? - Spectacle d'improvisation des Gallapiats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540599"},"en":{"name":"ET SI ON EN PARLAIT ? - Spectacle d'improvisation des Gallapiats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540599"},"de":{"name":"ET SI ON EN PARLAIT ? - Spectacle d'improvisation des Gallapiats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540599"},"it":{"name":"ET SI ON EN PARLAIT ? - Spectacle d'improvisation des Gallapiats",