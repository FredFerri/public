14"},"en":{"name":"Jean Jacques Kira","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539614"},"de":{"name":"Jean Jacques Kira","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539614"},"it":{"name":"Jean Jacques Kira","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539614"},"sp":{"name":"Jean Jacques Kira","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539614"},"pt":{"name":"Jean Jacques Kira","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539614"},"cn":{"name":"Jean Jacques Kira","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539614"}},"place":{"id":247078,"translations":{"fr":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":"Le B\u2019Izou est le th\u00e9\u00e2tre de toutes les proximit\u00e9s. (C\u2019est l\u2019occasion de d\u00e9couvrir des artistes, de laisser la t\u00e9l\u00e9 pour sortir, rire, s\u2019\u00e9mouvoir, r\u00e9fl\u00e9chir, revenir). L\u2019ancien atelier de garnissage de fauteuils s\u2019est transform\u00e9 en un espace chaleureux. Jean s\u2019affaire derri\u00e8re la console, Izou \u00e9crit des chansons. Au B\u2019Izou vous \u00eates chez Jean et Izou, autant dire vous \u00eates chez vous.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Au B'izou","address_street_name":"Wandelingstraat","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Wandelingstraat, 13","address_line2":"1070 Anderlecht","description_web":"De B\u2019Izou is een theater van uitersten. Het is een theater waar je, nadat je de stekker uit de televisie hebt getrokken, naartoe gaat om artiesten te ontdekken, om de bloemen buiten te zetten, om te lachen, te huilen en met verstomming te worden geslagen. Dit oude atelier van meubelstoffeerders werd omgetoverd in een warme theaterplek. Jean zit er achter de toetsen, Izou schrijft er de liedjes. Je bent er thuis, ook al ben je eigenlijk op bezoek bij Jean en Izou. Komt dat zien!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":"\u2018Au B\u2019Izou\u2019 is the theatre for everyone. (It\u2019s an opportunity to discover artists, to abandon your TV and go out, laugh, be moved, reflect and return). The former workshop for upholstering armchairs has been transformed into a welcoming space. Jean busies himself behind the console and Izou writes songs. At \u2018Au B\u2019Izou\u2019, you are at Jean and Izou\u2019s; in other words, you are at home.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":nu