osed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-05-25T02:00:53+02:00","published_at":"2024-03-21T11:56:10+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296990,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2770984186529621,"languages":{"spoken":["en","it","fr"],"subtitles":["nl"]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Exposition Dans la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/albertmarinus.org","email":"centremarinus@woluwe1200.be","phone_contact":"+32 2 762 62 14","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008725"},"pt":{"name":"Exposition Dans la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/albertmarinus.org","email":"centremarinus@woluwe1200.be","phone_contact":"+32 2 762 62 14","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008725"},"en":{"name":"Exposition Dans la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/albertmarinus.org","email":"centremarinus@woluwe1200.be","phone_contact":"+32 2 762 62 14","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008725"},"it":{"name":"Exposition Dans la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/albertmarinus.org","email":"centremarinus@woluwe1200.be","phone_contact":"+32 2 762 62 14","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008725"},"cn":{"name":"Exposition Dans la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/albertmarinus.org","email":"centremarinus@woluwe1200.be","phone_contact":"+32 2 762 62 14","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008725"},"fr":{"name":"Exposition Dans la maison","shortdescr":"L\u2019exposition pr\u00e9sente une s\u00e9lection d\u2019\u0153uvres de grands noms de l\u2019art belge (XIXe et XXe). Elle invite \u00e0 d\u00e9couvrir l\u2019histoire de la Maison Devos (XIXe si\u00e8cle) qui fait tout le charme du Mus\u00e9e de Woluwe, ainsi que des pi\u00e8ces pr\u00eat\u00e9es par trois institutions attach\u00e9es \u00e0 la pr\u00e9servation du patrimoine culturel immat\u00e9riel (Mus\u00e9e international du carnaval et du masque, Th\u00e9\u00e2tre royal de Toone, Surnateum).","longdescr":"L\u2019exposition Dans la maison, organis\u00e9e par le Centre Albert Marinus, d\u00e9voile une s\u00e9lection d\u2019\u0153uvres du Mus\u00e9e de Woluwe  : des tableaux, sculptures, gravures et dessins r\u00e9alis\u00e9s par de grands noms de l\u2019art belge du XIXe et du XXe si\u00e8cle, tels Constant Montald, Raymond de Meester, Oscar Jespers, Charles De Coorde, Jane Graverol, Jean Laudy, Adrien-Jean Madyol ou Henri-Victor Wolvens. Ce sera \u00e9galement l\u2019occasion d\u2019admirer une pi\u00e8ce exceptionnelle qui vient de b\u00e9n\u00e9ficier d\u2019une restauration, le Carrousel r\u00e9alis\u00e9 par Edgard Tytgat et son \u00e9pouse durant la Premi\u00e8re Guerre mondiale. \nUne collection forte d\u2019une belle diversit\u00e9 qui compte aussi les travaux de cr\u00e9ateurs qui ont marqu\u00e9 l\u2019\u00e9volution de l\u2019art contemporain, dont Henry Dorchy, Jean Degottex, Pol Mara, Paul Van Hoeydonck, Paul Devaux, Victor Vasarely ou encore Vic Gentils.\n\nLes secrets de la maison-mus\u00e9e \nCette exposition d\u00e9voile \u00e9galement l\u2019histoire de la maison Devos, demeure particuli\u00e8re de la fin du XIXe si\u00e8cle qui abrite le Mus\u00e9e de Woluwe depuis 1950 et le Centre Albert Marinus depuis 1980. Construit entre 1886 et 1925 dans un style frison (Nord de la Hollande) \u00e0 l\u2019initiative d\u2019Emile Devos, le b\u00e2timent pr\u00e9sente un aspect \u00e9minemment pittoresque avec ses nombreux pignons \u00e0 gradins, ses tourelles et son calepinage de tuiles rouges et noires. L\u2019int\u00e9rieur a conserv\u00e9 bon nombre de ses d\u00e9cors d\u2019origine. La visite \u00e9voquera la chemin\u00e9e sculpt\u00e9e illustrant deux fables de La Fontaine ; les  boiseries finement ouvrag\u00e9es et les huisseries complexes \u00e0 motifs champ\u00eatres  pour la plupart dessin\u00e9es par Emile Devos lui-m\u00eame ; les carreaux de c\u00e9ramique provenant de la plus ancienne manufacture hollandaise et les plafonds joliment peints de fleurs et d\u2019oiseaux.\n\nL\u2019exposition met aussi \u00e0 l\u2019honneur des partenaires institutionnels, attach\u00e9s \u00e0 la pr\u00e9servation du patrimoine culturel immat\u00e9riel :\nLe Mus\u00e9e international du carnaval et du masque pr\u00e9sente des pi\u00e8ces illustrant les traditions carnavalesques europ\u00e9ennes. \nLe Th\u00e9\u00e2tre royal de Toone, seul th\u00e9\u00e2tre de marionnettes traditionnelles bruxelloises \u00e0 tringles encore en activit\u00e9, invite \u00e0 d\u00e9couvrir l\u2019un des illustres personnages de son r\u00e9pertoire : Saint-Michel, archange qui terrassa le dragon Satan et saint patron de Bruxelles.\nLe Surnateum rassemble une collection consacr\u00e9e aux mythes, l\u00e9gendes, superstitions et ph\u00e9nom\u00e8nes surnaturels. Il propose une s\u00e9lection d\u2019objets et de documents du XIXe si\u00e8cle qui remettent en contexte une pi\u00e8ce surprenantes du mus\u00e9e qui \u00e9tait d\u00e9di\u00e9e aux s\u00e9ances de spiritisme, un passe-temps tr\u00e8s en vogue \u00e0 la Belle \u00c9poque. \n","performers":"D\u00e9couvrez les oeuvres de grands noms de l\u2019art belge du XIXe et XXe si\u00e8cle :  Constant Montald, Raymond de Meester, Oscar Jespers, Edgerd Tytgat, Charles De Coorde, Henry Dorchy, Jane Graverol, Jean Laudy, Adrien-Jean Madyol, Henri-Victor Wolvens, Paul Delvaux, Paul Van Hoeydonck, Henry Dorchy, Pol Mara ou encore Vic Gentils.","boxoffice_url":null,"website":"http:\/\/albertmarinus.org","email":"centremarinus@woluwe1200.be","phone_contact":"+32 2 762 62 14","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008725"},"sp":{"name":"Exposition Dans la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/albertmarinus.org","email":"centremarinus@woluwe1200.be","phone_contact":"+32 2 762 62 14","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008725"},"nl":{"name":"Exposition Dans la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/albertmarinus.org","email":"centremarinus@woluwe1200.be","phone_contact":"+32 2 762 62 14","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008725"}},"place":{"last_updated_at":"2023-05-04T13:17:53+02:00","published_at":"2013-10-19T01:20:03+02:00","id":243945,"translations":{"de":{"name":"Centre Albert Marinus (Museum Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Albert Marinus (Mus\u00e9e de Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Albert Marinus Centre","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":"The Mus\u00e9e de Woluwe Museum is the setting for exhibitions organised by the Centre Albert Marinus and other occasional cultural activities (readings, conferences, etc.).\r\n\r\nLocated on the edge of the Roodebeek park in Woluwe-Saint-Lambert, the museum lies in a private house built at the initiative of Emile Devos at the end of the 19th century. The architecture of this atypical house is inspired by Frisian houses (North of Holland). A large part of the period decorations have been preserved, giving a lot of charm to the museum rooms. Since its opening in 1950, the museum has been the setting for artistic events. \r\n\r\nSince 1980, the museum has been the headquarters of the NPO Centre Albert Marinus, which contains the collection (library, correspondence and writings) bequeathed by Albert Marinus (1886-1979), an internationally renowned sociologist and writer who dedicated his life to the study and promotion of intangible cultural heritage. The Centre Albert Marinus has a documentation centre and organises numerous cultural activities: exhibitions, publications, guided tours, on themes related to intangible cultural heritage. It has been recognised for its expertise in this field by UNESCO since 2016.\r\n\r\nAccessible to people with reduced mobility\r\n\r\nBus lines 27 and 29, stop Verheyleweghen\r\nMetro line 1, station Roodebeek\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Centre Albert Marinus (Mus\u00e9e de Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Centre Albert Marinus (Mus\u00e9e de Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Centre Albert Marinus (Mus\u00e9e de Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":"Le Mus\u00e9e de Woluwe Museum est le cadre des expositions organis\u00e9es par le Centre Albert Marinus et d\u2019autres activit\u00e9s culturelles ponctuelles (lectures, conf\u00e9rences, rencontres litt\u00e9raires,\u2026).\r\n\r\nImplant\u00e9 en bordure du parc de Roodebeek \u00e0 Woluwe-Saint-Lambert le Mus\u00e9e est install\u00e9 dans une maison particuli\u00e8re construite \u00e0 l\u2019initiative d\u2019Emile Devos \u00e0 la fin du 19e si\u00e8cle. De style atypique son architecture s\u2019inspire des maisons frisonnes (Nord de la Hollande). Une grande partie des d\u00e9cors d\u2019\u00e9poque ont \u00e9t\u00e9 conserv\u00e9s, donnant beaucoup de charme aux salles mus\u00e9ales. Depuis son ouverture en 1950, il est le cadre de manifestations artistiques. \r\n\r\nDepuis 1980, le mus\u00e9e est le si\u00e8ge, du Centre Albert Marinus asbl, constitu\u00e9 du fond (biblioth\u00e8que, courriers et \u00e9crits) l\u00e9gu\u00e9 par Albert Marinus (1886-1979), sociologue et \u00e9crivain de renomm\u00e9e internationale qui a d\u00e9di\u00e9 sa vie \u00e0 l\u2019\u00e9tude et \u00e0 la promotion du patrimoine culturel immat\u00e9riel. Le Centre Marinus dispose d\u2019un centre de documentation et organise de nombreuses activit\u00e9s culturelles : expositions, publications, visites guid\u00e9es, sur des th\u00e9matiques en lien avec le patrimoine culturel immat\u00e9riel. Il est reconnu pour son expertise en la mati\u00e8re aupr\u00e8s de l\u2019UNESCO depuis  2016.\r\n\r\nAccessible PMR\r\n\r\nBus ligne 27 et 29 arr\u00eat Verheyleweghen\r\nM\u00e9tro ligne 1 arr\u00eat Roodebeek\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Centre Albert Marinus (Mus\u00e9e de Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Albert Marinus Centrum  (Museum van Sint-Lambrechts-Woluwe)","address_street_name":"Karrestraat","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Sint-Lambrechts-Woluwe","address_line1":"Karrestraat, 40","address_line2":"1200 Sint-Lambrechts-Woluwe","description_web":"Het Mus\u00e9e de Woluwe Museum is het decor van door het Centre Albert Marinus georganiseerde tentoonstellingen en van andere specifieke culturele activiteiten (lezingen, conferenties, enz.).\r\n\r\nHet museum is gelegen aan de rand van het Roodebeekpark in Sint-Lambrechts-Woluwe en bevindt zich in een priv\u00e9woning die op initiatief van Emile Devos op het einde van de 19e eeuw werd gebouwd. De architectuur van dit atypische gebouw is ge\u00efnspireerd op de huizen in Friesland (Noord-Nederland). Een groot deel van de antieke decoraties is bewaard gebleven, wat de museumzalen veel charme geeft. Sinds zijn opening in 1950 is het museum het decor voor artistieke evenementen. \r\n\r\nSinds 1980 is het museum de zetel van de vzw Centre Albert Marinus. Dit centrum bestaat uit de collectie (bibliotheek, correspondentie en geschriften) die werd nagelaten door Albert Marinus (1886-1979), een internationaal vermaard socioloog en schrijver die zijn leven heeft gewijd aan de studie en bevordering van immaterieel cultureel erfgoed. Het Centre Albert Marinus beschikt over een documentatiecentrum en organiseert talrijke culturele activiteiten: tentoonstellingen, publicaties, rondleidingen, over thema\u2019s die verband houden met immaterieel cultureel erfgoed. Het is sinds 2016 door UNESCO erkend voor zijn expertise op dit gebied.\r\n\r\nToegankelijk voor mensen met beperkte mobiliteit.\r\n\r\nBuslijnen 27 en 29, halte Verheyleweghen\r\nMetrolijn 1, station Roodebeek\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":6278,"location":{"lat":50.85026588,"lon":4.42243794},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2023-05-04T13:17:53+02:00","published_at":"2013-10-19T01:20:03+02:00","id":243945,"translations":{"de":{"name":"Centre Albert Marinus (Museum Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Albert Marinus (Mus\u00e9e de Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Albert Marinus Centre","address_street_name":"Rue de la Charrette","address_street_number":"40","address_street_box":null,"email":"musee.museum@woluwe1200.be","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 11","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette, 40","address_line2":"1200 Woluwe-Saint-Lambert","description_web":"The Mus\u00e9e de Woluwe Museum is the setting for exhibitions organised by the Centre Albert Marinus and other occasional cultural activities (readings, conferences, etc.).\r\n\r\nLocated on the edge of the Roodebeek park in Woluwe-Saint-Lambert, the museum lies in a private house built at the initiative of Emile Devos at the end of the 19th century. The architecture of this atypical house is inspired by Frisian houses (North of Holland). A large part of the period decorations have been preserved, giving a lot of charm to the museum rooms. Since its opening in 1950, the museum has been the setting for artistic events. \r\n\r\nSince 1980, the museum has been the headquarters of the NPO Centre Albert Marinus, which contains the collection (library, correspondence and writings) bequeathed by Albert Marinus (1886-1979), an internationally renowned sociologist and writer who dedicated his life to the study and promotion of intangible cultural heritage. The Centre Albert Marinus has a documentation centre and organises numerous cultural activities: exhibitions, publications, guided tours, on themes related to intangible cultural heritage. It has been recognised for its expertise in this field by UNESCO since 2016.\r\n\r\nAccessible to people with reduced mobility\r\n\r\nBus lines 27 and 29, stop Verheyleweghen\r\nMetro 