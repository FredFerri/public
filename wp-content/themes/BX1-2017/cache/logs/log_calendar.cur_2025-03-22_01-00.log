\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007228"},"en":{"name":"Courage(s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/laclarenciere.be\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007228"},"it":{"name":"Courage(s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/laclarenciere.be\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007228"},"cn":{"name":"Courage(s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/laclarenciere.be\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007228"},"fr":{"name":"Courage(s)","shortdescr":"\nApr\u00e8s deux ans d\u2019absence, Courages revient pour trois soir\u00e9es intenses o\u00f9 le courage se d\u00e9voile sous toutes ses formes : h\u00e9ro\u00efque, maladroit, bouleversant ou compl\u00e8tement absurde.\n\nSur sc\u00e8ne, une troupe pr\u00eate \u00e0 tout oser, \u00e0 plonger sans filet et \u00e0 vous embarquer dans un tourbillon d\u2019\u00e9motions et de surprises.","longdescr":"Courage(s), c\u2019est un freeform d\u2019impro o\u00f9 le public partage anonymement ses histoires avant le spectacle : des \u00e9preuves surmont\u00e9es ou des d\u00e9fis non r\u00e9solus.\n\nComme ce moment o\u00f9 quelqu\u2019un a fait une remarque sexiste et vous n\u2019avez pas su r\u00e9agir, changer de vie, de pays et d'amis, ou m\u00eame oser parler en public pour la premi\u00e8re fois.\n\nLes com\u00e9diens transforment ces r\u00e9cits en 1h15 d\u2019improvisation : parfois douce, parfois absurde, parfois poignante. On revisite vos moments, grands ou petits, pour en rire, les sublimer et nous pr\u00e9parer \u00e0 affronter les prochaines fois avec encore plus de courage.\n\nUn spectacle unique, \u00e0 vivre les jeudi 20, vendredi 21 et samedi 22 mars 2025 au Th\u00e9\u00e2tre La Clarenci\u00e8re, pr\u00e8s de la Place Flagey.\n\nR\u00e9servez vite vos places ! leverbefou.fr\/reservationth\/reservation.php","performers":"Alexandre Valancin, Catherine Lembr\u00e9e, Marie-Pierre Thomas, Guillaume Lucet","boxoffice_url":null,"website":"https:\/\/laclarenciere.be\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007228"},"sp":{"name":"Courage(s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/laclarenciere.be\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007228"},"nl":{"name":"Courage(s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/laclarenciere.be\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007228"}},"place":{"id":50002432,"translations":{"de":{"name":"ASBL Ebullition","address_street_name":null,"address_street_number":"85","address_street_box":null,"email":"info@ebullitiontheatre.org","website":"www.ebullitiontheatre.org","phone_contact":"+32 497 44 27 73","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"ASBL Ebullition","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"ASBL Ebullition","address_street_name":null,"address_st