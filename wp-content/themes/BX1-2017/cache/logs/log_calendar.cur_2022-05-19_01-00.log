:528906,"date_start":"2022-05-21","date_end":"2022-05-21","date_next":"2022-05-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{"list":[85],"translations":{"fr":["Portes ouvertes"],"nl":["Opendeurdag"],"en":["Open door"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Centenaire des cit\u00e9s-jardins  : Bon Air","shortdescr":"Festivit\u00e9s \u00e0 Bon Air","longdescr":"En mai, nous c\u00e9l\u00e9brons le centenaire des cit\u00e9s-jardins de Bruxelles. \u00c0 Anderlecht, les trois cit\u00e9s-jardins seront c\u00e9l\u00e9br\u00e9s le week-end du 21 et 22 mai avec ce programme du Service du Tourisme et de la Culture N\u00e9erlandophone de la Commune d'Anderlecht.\r\n\r\n\r\nProgramme 21.05 - Bon Air - Place S\u00e9verine:\r\n\r\n14:00 > 15:30- Visite guid\u00e9e de la cit\u00e9-jardin. plus d'info? tourisme@anderlecht.brussels\r\n\r\n14:00 > 18:00: Ch\u00e2teau gonflable, animations, d\u00e9couvrez les projets du Comit\u00e9 de quartier de Bon Air, \u00abJeugdjaren van Anderlechtenaren - verhalen uit Bon Air\u00bb: courts m\u00e9trages par De Swaene, Fedos Anderlecht et Beeldenstorm (NL)\r\n\r\n15:30: Pr\u00e9sentation de \u00abBon Air, la cit\u00e9-jardin se raconte\u00bb par Stephanie Lemmens devant l\u2019\u00e9cole GBS Goede Lucht + \u266b spectacle \u00abSon Flamenco - Coral Vados\u00bb\r\n\r\n17:00 Performance Move Danz'Attitude\r\n\r\nNous vous invitons \u00e9galement dans les deux autres cit\u00e9s-jardins d\u2019Anderlecht:\r\n21.05: Moortebeek: https:\/\/agenda.brussels\/fr\/528888\/centenaire-des-cites-jardins-moortebeek\r\n22.05: La Roue: https:\/\/agenda.brussels\/fr\/528912\/centenaire-des-cites-jardins-la-roue","performers":null,"boxoffice_url":null,"website":"http:\/\/www.anderlecht.be","email":"tourisme@anderlecht.brussels","phone_contact":"+32 2 526 83 51","phone_booking":"+32 2 526 83 65","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528906.html"},"nl":{"name":"100 jaar tuinwijken   :  Goede Lucht","shortdescr":"Festiviteiten in Goede Lucht","longdescr":"In mei vieren we het honderdjarig bestaan van de Brusselse tuinwijken. In Anderlecht worden de drie tuinwijken tijdens het weekend van 21 en 22 mei gevierd met een programma van de Dienst Toerisme en de Nederlandstalige Cultuurdienst van de Gemeente van Anderlecht.\r\n\r\n\r\nProgramma 21.05 - Goede Lucht - S\u00e9verineplein:\r\n\r\n14:00 > 15:30: Rondleiding door de tuinwijk.  Meer info? toerisme@anderlecht.brussels\r\n\r\n14:00 > 18:00: springkasteel, animaties, ontdek de projecten van het Wijkcomit\u00e9 Goede Lucht, \u00abJeugdjaren van Anderlechtenaren - verhalen uit Bon Air\u00bb: kortfilms door De Swaene, Fedos Anderlecht en Beeldenstorm\r\n\r\n15:30: voorstelling van \u201cGoede Lucht \u2013 Verhalen uit de tuinwijk\u201d door Stephanie Lemmens voor de school GBS Goede Lucht met \u266b spektakel \u00abSon Flamenco - Coral Vados\u00bb\r\n\r\n17:00 Performance Move Danz'Attitude\r\n \r\nWe nodigen je ook graag uit in de twee andere Anderlechtse tuinwijken:\r\n21.05: Moortebeek: https:\/\/agenda.brussels\/nl\/528888\/100-jaar-tuinwijken-moortebeek \r\n22.05: Het Rad: https:\/\/agenda.brussels\/nl\/528912\/100-jaar-tuinwijken-het-rad","performers":null,"boxoffice_url":null,"website":null,"email":"toerisme@anderlecht.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528906.html"},"en":{"name":"100th anniversary of the Garden Cities : Bon Air \/ Goede Lucht","shortdescr":"Festivities in Bon Air \/ Goede Lucht","longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528906.html"},"de":{"name":"Centenaire des cit\u00e9s-jardins  : programme du Bon Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528906.html"},"it":{"name":"Centenaire des cit\u00e9s-jardins  : programme du Bon Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528906.html"},"sp":{"name":"Centenaire des cit\u00e9s-jardins  : programme du Bon Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528906.html"},"pt":{"name":"Centenaire des cit\u00e9s-jardins  : programme du Bon Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528906.html"},"cn":{"name":"Centenaire des cit\u00e9s-jardins  : programme du Bon Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528906.html"}},"place":{"id":270247,"translations":{"fr":{"name":"Cit\u00e9-jardin Bon Air","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Cit\u00e9-jardin Bon Air","address_line2":"1070 Anderlecht","description_web":"Cette cit\u00e9-jardin, au nom plus qu\u2019\u00e9vocateur, se situe quelque part entre le ring et les champs, aux confins de la commune d\u2019Anderlecht. Sa construction par le Foyer anderlechtois d\u00e9bute en 1923, mais le chantier s\u2019\u00e9talera sur une dur\u00e9e de 30 ans. 439 maisons verront le jour, permettant d\u2019accueillir les personnes expropri\u00e9es de leur logement du centre-ville suite aux travaux li\u00e9s \u00e0 la jonction ferroviaire nord-midi. \r\n\r\nComme si le nom de la cit\u00e9-jardin ne suffisait pas, les noms des rues transmettent le m\u00eame enthousiasme : rue de l\u2019Hygi\u00e8ne, de la Dignit\u00e9, de la Temp\u00e9rance, ou encore rue de la F\u00e9condit\u00e9, de l\u2019Enthousiasme et du Bonheur. \r\n\r\nIci, on a vraiment l\u2019impression d\u2019avoir quitt\u00e9 la ville\u202f! ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Tuinwijk Goede Lucht","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Tuinwijk Goede Lucht","address_line2":"1070 Anderlecht","description_web":"Deze tuinwijk met een tot de verbeelding sprekende naam ligt ergens tussen de Brusselse Ring en de velden, op de rand van de gemeente Anderlecht. De Anderlechtse Haard begon in 1923 met de bouw ervan, maar het duurde maar liefst dertig jaar tot de werkzaamheden afgerond waren. Er werden 439 woningen opgetrokken voor de onteigende stadsbewoners die hun woning in het centrum moesten verlaten door de werkzaamheden aan de Noord-Zuidverbinding.\u202f \r\n\r\nAlsof de naam van deze tuinwijk nog niet vrolijk genoeg is, stralen de straatnamen evenveel enthousiasme uit: Hygi\u00ebnestraat, Waardigheidsstraat, Matigheidslaan, Vruchtbaarheidslaan, Geestdriftstraat, Geluksstraat...\u202f \r\n\r\nHier heb je echt het gevoel dat je niet meer in de stad bent!\u202f ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Bon Air Garden City","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Bon Air Garden City","address_line2":"1070 Anderlecht","description_web":"This garden city, with a highly evocative name, lies between fields and Brussels\u2019 ring road, on the edge of the commune of Anderlecht. Its construction by the Foyer Anderlechtois began in 1923, but the project spanned 30 years. 439 houses were built, making it possible to accommodate people whose housing in the city centre was expropriated as a result of works for the Nord-Midi railway junction. \r\nAs if the garden city\u2019s name were not enough, the street names convey the same enthusiasm: rue de l\u2019Hygi\u00e8ne, rue de la Dignit\u00e9, rue de la Temp\u00e9rance, rue de la F\u00e9condit\u00e9, rue de l\u2019Enthousiasme and rue du Bonheur. \r\nHere, you really feel as though you\u2019ve left the city!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Quartier du Bon Air","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Quartier du Bon Air","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Quartier du Bon Air","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Quartier du Bon Air","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Quartier du Bon Air","address_street_name":