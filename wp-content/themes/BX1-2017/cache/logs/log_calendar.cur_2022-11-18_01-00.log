ackoffice_id":265515,"import_origin":null,"sub_type":"party","show_in_agenda":true,"ranking":1},{"id":543049,"date_start":"2022-10-26","date_end":"2022-11-20","date_next":"2022-11-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[55],"translations":{"fr":["Th\u00e9\u00e2tre de marionnettes"],"nl":["Poppentheater"],"en":["Puppet show"],"de":["Puppentheater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"le Chat Bott\u00e9","shortdescr":"Un petit chat qui parle et qui a des bottes, et qui plus encore promet d'exaucer trois voeux de son petit ma\u00eetre Julien. L'histoire exceptionnelle d'un petit chat et du Marquis de Carabas!","longdescr":"D'apr\u00e8s Charles Perrault. Un petit chat propose trois souhaits \u00e0 son Ma\u00eetre: le bonheur, la fortune et la chance. En trois jours, ce petit chat r\u00e9alisera-t-il autant de prouesses pour son ma\u00eetre, le fameux Marquis de Carabas ? Il devra affronter le c\u00e9l\u00e8bre m\u00e9chant Ogre, le plus puissant de la Terre, pour le plus beau des ch\u00e2teaux et les plus beaux tr\u00e9sors. Le bonheur est aussi au bout du chemin...\r\nO\u00f9","performers":"Dimitri Jageneau, Biserka Assenova","boxoffice_url":null,"website":"http:\/\/www.theatreperuchet.be","email":"info@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543049"},"nl":{"name":"le Chat Bott\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":