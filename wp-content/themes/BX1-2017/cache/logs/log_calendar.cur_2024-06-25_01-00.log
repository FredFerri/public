high_capacity":false,"is_not_major_event":false,"backoffice_id":300071,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Les Marolles et l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010568"},"pt":{"name":"Les Marolles et l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010568"},"en":{"name":"Les Marolles et l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010568"},"it":{"name":"Les Marolles et l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010568"},"cn":{"name":"Les Marolles et l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010568"},"fr":{"name":"Les Marolles et l'Art nouveau","shortdescr":null,"longdescr":"Le quartier des Marolles est depuis toujours un lieu d\u2019accueil des populations et des formules sociales innovantes. Au tournant du XXe si\u00e8cle, deux \u00e9coles, un vaste entrep\u00f4t de vins et spiritueux, une cit\u00e9 sociale de type phalanst\u00e8re et un atelier d\u2019artiste y sont \u00e9difi\u00e9s en style Art nouveau. Cette visite met en \u00e9vidence ces lieux phares de l\u2019Art nouveau bruxellois dans ce quartier populaire du centre-ville.\n\nPoint de d\u00e9part de la visite : Devant les marches du palais de Justice, place Poelart, 1000 Bruxelles\n\nDur\u00e9e : 2h","performers":"Le quartier des Marolles est depuis toujours un lieu d\u2019accueil des populations et des formules sociales innovantes.","boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010568"},"sp":{"name":"Les Marolles et l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010568"},"nl":{"name":"Les Marolles et l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010568"}},"place":{"last_updated_at":"2023-08-14T16:40:35+02:00","published_at":"2013-10-19T01:14:04+02:00","id":232780,"translations":{"de":{"name":"Der Br\u00fcsseler Justizpalast","address_street_name":"Pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Der Br\u00fcsseler Justizpalast z\u00e4hlt zu den bemerkenswertesten und gleichzeitig bombastischsten europ\u00e4ischen Monumenten des 19. Jh. und ist in Europa noch heute der gr\u00f6\u00dfte seiner Art.\r\n\r\nMajest\u00e4tische Dimensionen: Die L\u00e4ngs- und die Querachse des Bauwerks messen 160 bzw. 150 Meter. Die Gesamtfl\u00e4che bel\u00e4uft sich auf 26 000 m\u00b2 mit acht Innenh\u00f6fen. Dominiert wird das imposante Rechteck von einer massiven Kuppel (24 000 Tonnen) in einer H\u00f6he von 142 Metern. Architektonisch herrscht der griechisch-r\u00f6mische Stil vor. Die belgischen K\u00f6nige Leopold I. und Leopold II. wollten mit diesem symboltr\u00e4chtigen Bauwerk hoch \u00fcber der Stadt zwischen Ober- und Unterstadt ein Zeichen f\u00fcr den damals noch jungen,1830 gegr\u00fcndeten belgischen Staat setzen.\r\n\r\nEin architektonisches Mammutprojekt: Mit dem Bau wurde der Architekt Joseph Poelaert beauftragt. Von der Grundsteinlegung 1866 bis zur Einweihung 1883 vergingen ganze 17 Jahre, sie fand im Jahr 1883, bereits einige Jahre nach dem Tode Poelaerts, statt.\r\n\r\nGestern & heute: Gesellschaftlich sorgte der Bau des Kolosses seinerzeit f\u00fcr Unmut, da gro\u00dfe Teile des volkst\u00fcmlichen Marollenviertels dem Justizpalast weichen mussten - und auch heute ist er nicht unumstritten: Seit Mitte der 80er Jahre ist die Kuppel von Bauger\u00fcsten umgeben, von denen aus Sicherungs- und Restaurierungsarbeiten durchgef\u00fchrt werden.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Brussels' Palace of Justice","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Poelaert, 1","address_line2":"1000 Brussels","description_web":"Standing in front of this gigantic building leaves you (almost) dizzy. Everything is done to impress, both inside and out. It's a symbolic place with a long history, built on the (rather aptly named) Mont des Potences, meaning Gallows Hill, where condemned men were executed in the Middle Ages.\u202fLegend has it that in the 16th century, the famous doctor Vesalius went there at night to steal corpses so that he could study the human body\u2026 \r\n\r\nIt\u2019s one of the most impressive monuments in Brussels, which also offers a breathtaking panoramic view of lower Brussels. \r\n\r\nA little history \r\nIn March 1860 (under Leopold I), the Belgian government organised an international competition for the construction of a new courthouse in Brussels. The jury did not select any of the projects presented and the project was instead entrusted to the architect of the City of Brussels (who was on the jury!). Joseph Poelaert's project was colossal: to synthesise the history of humanity in the architecture of a single building. The construction, which finally began in October 1866, took 17 years. It led to the sacrificing of part of the Marolles, the working-class district in the lower part of the city, through expropriations at derisory prices, evictions and demolitions. The inauguration (under Leopold II) was held on 15 October 1883, without the architect of this colossus having seen his work completed. Exhausted and driven mad, he died four years before the work was completed. \r\n\r\nThe \u201cSkieven architek\u201d and \u201cThe Great Inkwell\u201d\u2026 \r\nThe monument left no one indifferent. It was adored by some and mocked by others. Poelaert was granted tremendous artistic and financial freedom throughout the project, which led to popular, political and cultural discontent. A number of charming expressions were coined, such as 'Rotten' and 'Skieven architek' (twisted architect), with the latter being adopted as the name of a caf\u00e9 on Place du Jeu de Balle in the heart of the Marolles. Victor Horta described the building as \"... a crushing mass crowned by a cheese bell\". Freud praised it highly: \"At the top of a steep hill stands a massive building, with columns so beautiful that the whole evokes an Assyrian royal palace or an illustration by Gustave Dor\u00e9\". Victor Hugo christened it \"The Great Inkwell\". \r\n\r\nBuilt in the classical Greco-Roman style and larger than Saint Peter's Basilica in Rome, it is (still to this day) the largest palace of justice in the world: \r\n40,000m\u00b2 \r\na dome that reaches a height of 100 metres \r\na colossal vestibule \r\nover 250 rooms, including 27 impressive courtrooms\u2026\r\n \r\n\"A cyclopean architecture, dreamed up by hands unaware of the human scale\" (Victor Horta) ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Palazzo di Giustizia di Bruxelles","address_street_name":"pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Costruito tra il 1866 ed il 1883 dall'architetto Poelaert, maestoso simbolo della potenza della giustizia, \u00e8 il pi\u00f9 grande edificio eretto nel XIX secolo in Occidente.\u00a0...\r\n\"Costruito tra il 1866 ed il 1883 dall'architetto Poelaert, maestoso simbolo della potenza della giustizia, \u00e8 il pi\u00f9 grande edificio eretto nel XIX secolo in Occidente.Su una superficie di 26.000 m\u00b2, 27 sale d'udienza, 245 sale...ispirazione di stile classico greco-romano. \r\nDa vedere: la sala dei Pas-Perdus sovrastata da una grandiosa cupola che si erge a 100 m dal suolo, le gallerie del primo piano, il panorama (dalla terrazza) sulla citt\u00e0 bassa e sul quartiere di Marolles\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"On est (presque) pris d\u2019un vertige face \u00e0 cette gigantesque b\u00e2tisse. Tout est fait pour impressionner, \u00e0 l\u2019ext\u00e9rieur comme \u00e0 l\u2019int\u00e9rieur. Lieu symbolique et porteur d\u2019une lourde histoire, le Palais de Justice est \u00e9rig\u00e9 sur le (bien nomm\u00e9) Mont des Potences o\u00f9 l\u2019on ex\u00e9cutait les condamn\u00e9s au Moyen- Age.\u202fLa l\u00e9gende raconte qu\u2019au XVI\u00e8me si\u00e8cle, le c\u00e9l\u00e8bre m\u00e9decin V\u00e9sale allait y d\u00e9rober les cadavres la nuit pour \u00e9tudier le corps humain\u2026 \r\n\r\nC\u2019est un des monuments les plus impressionnants de Bruxelles qui offre \u00e0 ses c\u00f4t\u00e9s un panorama \u00e9poustouflant sur le bas de la ville. \r\n\r\nUn peu d\u2019histoire \r\n\r\nEn mars 1860, (sous L\u00e9opold Ier), le gouvernement belge organise un concours international pour la construction d\u2019un nouveau palais de justice \u00e0 Bruxelles. \r\nLe jury ne retient aucun des projets pr\u00e9sent\u00e9s et le dossier est confi\u00e9 \u00e0 l\u2019architecte de la Ville de Bruxelles (qui faisait partie du jury !). \r\n\r\nLe projet de Joseph Poelaert est pharaonique : faire la synth\u00e8se de l'histoire de l'humanit\u00e9 dans l'architecture de ce seul b\u00e2timent. La construction qui d\u00e9bute finalement en octobre 1866 prendra 17 ans. \r\n\r\nElle entra\u00eene le sacrifice d\u2019une partie des Marolles, le quartier populaire du bas de la ville, \u00e0 coup d\u2019expropriations \u00e0 prix d\u00e9risoires, d\u2019expulsions et de d\u00e9molitions. \r\n\r\nL\u2019inauguration (sous L\u00e9opold II) aura lieu le 15 octobre 1883, sans que l\u2019architecte de ce colosse n\u2019ait pu voir son oeuvre achev\u00e9e. Epuis\u00e9 et devenu fou, il meurt quatre ans avant la fin des travaux. \r\n\r\nLe \u00ab Skieven architek \u00bb et \u00ab Le grand encrier \u00bb\u2026 \r\n\r\nLe monument ne laisse personne indiff\u00e9rent. Il est ador\u00e9 par certains et moqu\u00e9 par d\u2019autres. \r\n\r\nPour la r\u00e9alisation du projet, Poelaert b\u00e9n\u00e9ficie d\u2019une tr\u00e8s grande libert\u00e9, tant artistique que financi\u00e8re, ce qui va provoquer un m\u00e9contentement populaire, politique et culturel. \r\n\r\nNaissent des expressions savoureuses comme \u00ab Rotten \u00bb et \u00ab Skieven architek \u00bb (architecte pourri ou tordu) qui deviendra le nom d\u2019un caf\u00e9 de la Place du Jeu de Balle au c\u0153ur des Marolles. \r\n\r\nVictor Horta qualifiera le b\u00e2timent de \u00ab \u2026 Masse \u00e9crasante couronn\u00e9e par une cloche \u00e0 fromage \u00bb. Freud en fait un bel \u00e9loge \u00ab Au sommet d\u2019une colline rapide se dresse un b\u00e2timent massif, avec des colonnes si belles que l\u2019ensemble \u00e9voque un palais royal assyrien ou une illustration de Gustave Dor\u00e9 \u00bb. Victor Hugo le baptisera \u00ab le grand encrier \u00bb . \r\n\r\nLe plus grand palais (de justice) du monde\u2026 \r\n\r\nDe style classique gr\u00e9co romain, plus grand que la Basilique St Pierre \u00e0 Rome, il est (encore \u00e0 ce jour) le plus grand palais de Justice du monde : \r\n\r\n40.000 m2 \r\n\r\nune coupole qui culmine \u00e0 100 m\u00e8tres de haut \r\n\r\nune salle des pas perdus pharaonique \r\n\r\nplus de 250 locaux, dont 27 impressionnantes salles d\u2019audience \u2026 \r\n\r\n\u00ab Une architecture cyclop\u00e9enne, r\u00eav\u00e9e par des mains n\u2019ayant pas conscience de l\u2019\u00e9chelle humaine \u00bb (Victor Horta) ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"El Palacio de Justicia de Bruselas","address_street_name":"pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Construido entre 1866 y 1883 por Poelaert, este majestuoso s\u00edmbolo de la justicia, constituy\u00f3 la mayor construcci\u00f3n del s. XIX en Occidente....\r\nVisita: \r\nSus 26.000 m de superficie, 27 salas de audiencia, 245 salas...\r\nEl estilo grecorromano cl\u00e1sico \r\nLa sala Pas-Perdus con una grandiosa c\u00fapula a 100 m de altura\r\nLas galer\u00edas de la primera planta\r\nEl mirador que hay en la plaza, con vistas a la parte baja de la ciudad \r\nEl ascensor acristalado que te llevar\u00e1 al Barrio de Les Marolles\r\nEl mirador de noche\r\n\r\nRecuerda que, por la noche, el Palacio de Justicia se ilumina ofreciendo una imagen evocadora.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Het Brusselse Justitiepaleis ","address_street_name":"Poelaertplein","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Poelaertplein, 1","address_line2":"1000 Brussel","description_web":"Wie voor dit gigantische gebouw staat, kan gaan duizelen. Alles is gedaan om indruk te maken, zowel binnen als buiten. Het Justitiepaleis, een symbolische plek met een zware geschiedenis, is gebouwd op de (toepasselijk genaamde) Galgenberg, waar veroordeelde middeleeuwers werden terechtgesteld. Volgens de legende ging de beroemde 16e-eeuwse dokter Vesalius er 's nachts lijken stelen, zodat hij het menselijk lichaam kon bestuderen... \r\n\r\nHet is een van de indrukwekkendste monumenten in Brussel en biedt een adembenemend uitzicht op de benedenstad. \r\n\r\nEen beetje geschiedenis \r\nIn maart 1860 (onder Leopold I) hield de Belgische regering een internationale wedstrijd voor de bouw van een nieuw justitiepaleis in Brussel. De jury weigerde alle ingediende projecten en het project werd toevertrouwd aan de architect van de Stad Brussel (die deel uitmaakte van de jury!). \r\n\r\nHet project van Joseph Poelaert was megalomaan: de geschiedenis van de hele mensheid synthetiseren in de architectuur van \u00e9\u00e9n enkel gebouw. De bouw, die uiteindelijk van start ging in oktober 1866, duurde 17 jaar. Het leidde tot de opoffering van een deel van de Marollen, de volkswijk in het lagere gedeelte van de stad. Bewoners kregen te maken met onteigeningen tegen belachelijk lage prijzen, uitzettingen en afbraak. De inhuldiging (onder Leopold II) vond plaats op 15 oktober 1883, maar de architect heeft het niet kunnen meemaken. Uitgeput en tot waanzin gedreven stierf hij vier jaar voor de voltooiing van zijn meesterwerk. \r\n\r\nDe \"Skieven Architek\" en \"De Grote Inktpot\"... \r\nHet monument liet niemand onverschillig. Het werd door sommigen aanbeden en door anderen bespot. Poelaert genoot tijdens het hele project een enorme artistieke en financi\u00eble vrijheid, wat voor onvrede zorgde in de politiek, de cultuur en bij het volk. Er werden een aantal charmante uitdrukkingen bedacht, zoals 'Rotten' en 'Skieven architek' (verdraaide architect), dat de naam werd van een caf\u00e9 op het Vossenplein in het hart van de Marollen. \r\n\r\nVictor Horta beschreef het gebouw als \"... een verpletterende massa bekroond met een kaasstolp\". Freud was er vol lof over: \"Op de top van een steile heuvel staat een massief gebouw, met zuilen die zo mooi zijn dat het geheel doet denken aan een Assyrisch koninklijk paleis of een illustratie van Gustave Dor\u00e9\". Victor Hugo doopte het \"De Grote Inktpot\". \r\n\r\nHet Justitiepaleis, gebouwd in de klassieke Grieks-Romeinse stijl en groter dan de Sint-Pietersbasiliek in Rome, is (tot op heden) het grootste gerechtsgebouw ter wereld: \r\n40.000 vierkante meter \r\neen koepel die tot 100 meter hoog reikt \r\neen kolossale vestibule \r\nmeer dan 250 zalen, waaronder 27 indrukwekkende rechtszalen... \r\n\r\n\"Een cyclopische architectuur, bedacht door handen die geen weet hebben van de menselijke maat\" (Victor Horta) ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[2],"translations":{"de":["Marollen"],"pt":[null],"en":["Marolles"],"it":["Marolles"],"cn":[null],"fr":["Marolles"],"sp":["Marolles"],"nl":["Marollen"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":1128,"location":{"lat":50.83701292,"lon":4.35210879},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2024-04-18T16:00:05+02:00","published_at":"2013-10-19T01:13:31+02:00","id":204134,"translations":{"de":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Midi, 165","address_line2":"1000 Brussels","description_web":"Understanding Brussels to better defend it!\r\nARAU was founded in 1969, in a context of \u2018Brusselsisation\u2019 and the exodus of Brussels residents to the periphery. The challenge at the time, which is still relevant today, was to defend and promote the inhabited city and a quality of life for all the inhabitants of Brussels. This led to major protests against demolition projects on the one hand and the development of counter-projects on the other, with a view to urban renewal and improving the living environment.\r\nThe ARAU intends, through its action to raise awareness and inform the population, to provide the public with the necessary tools to monitor the evolution of the city. This action takes the form of the publication of analyses and studies, the organisation of conferences and workshops, press releases, etc., as well as guided tours.\r\nThese tours, which are pioneering in the Brussels region and have been organised since 1977, aim to enhance the city and its assets, and to develop a critical view of its transformations, which includes the preservation and maintenance of its heritage.\r\nOver the years, the ARAU has developed a rich catalogue of guided tours on various themes: \u201cUnmissable Brussels\u201d, \u201cArchitecture\u201d, \u201cBrussels in Districts\u201d, \u201cThe City in Transformation\u201d, \u201cSummer Journey\u201d, \u201cA Brussels House\u201d, \u201cBrussels: City of Trams\u201d, \u201cSocial Brussels\u201d, which can be discovered during public tours or in the form of private, customised tours.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"ARAU - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"Comprendre Bruxelles pour mieux la d\u00e9fendre !\r\nL\u2019ARAU a \u00e9t\u00e9 fond\u00e9 en 1969, dans un contexte de \u00ab bruxellisation \u00bb et d\u2019exode des Bruxellois vers la p\u00e9riph\u00e9rie. L\u2019enjeu \u00e0 l\u2019\u00e9poque, toujours d\u2019actualit\u00e9 : d\u00e9fendre et promouvoir la ville habit\u00e9e et une qualit\u00e9 de vie pour tous les Bruxellois, ce qui s\u2019est traduit par d\u2019importantes contestations de projets de d\u00e9molition d\u2019une part et le d\u00e9veloppement de contre-projets d\u2019autre part, dans une optique de r\u00e9novation urbaine et d\u2019am\u00e9lioration du cadre de vie.\r\nL\u2019ARAU entend, par son action de sensibilisation et d\u2019information de la population, mettre \u00e0 disposition du public les outils n\u00e9cessaires pour suivre l\u2019\u00e9volution de la ville. Cette action se mat\u00e9rialise \u00e0 travers la publication d\u2019analyses et d\u2019\u00e9tudes, l\u2019organisation de colloques et d\u2019ateliers, des communiqu\u00e9s de presse, \u2026ainsi que de visites guid\u00e9es.\r\nCes visites, pionni\u00e8res en r\u00e9gion bruxelloise et organis\u00e9es depuis 1977, visent \u00e0 revaloriser la ville et ses atouts, \u00e0 d\u00e9velopper un regard critique sur ses transformations, ce qui passe par la sauvegarde et l\u2019entretien de son patrimoine.\r\nAu fil de toutes ces ann\u00e9es, l\u2019ARAU a d\u00e9velopp\u00e9 un riche catalogue de visites guid\u00e9es se d\u00e9clinant en diverses th\u00e9matiques : \u00ab Bruxelles incontournable \u00bb, \u00ab Architecture \u00bb, \u00ab Bruxelles en quartiers \u00bb, \u00ab La ville en transformation \u00bb, \u00ab Parcours d\u2019\u00e9t\u00e9 \u00bb, \u00ab Une maison bruxelloise \u00bb, \u00ab Bruxelles : ville de trams \u00bb, \u00ab Bruxelles sociale \u00bb, qu\u2019il est possible de d\u00e9couvrir lors de tours publics ou sous forme de visites priv\u00e9es, personnalisables.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Zuidstraat","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zuidstraat, 165","address_line2":"1000 Brussel","description_web":"Brussel begrijpen om het beter te kunnen verdedigen!\r\nHet ARAU werd opgericht in 1969, in een context van \u201cBrusselisering\u201d en de uittocht van de Brusselaars naar de rand. De uitdaging van die tijd, die ook vandaag nog actueel is, bestond erin de bewoonde stad en de levenskwaliteit van alle Brusselaars te verdedigen en te bevorderen. Dat leidde tot grote protesten tegen afbraakprojecten enerzijds en de ontwikkeling van tegenprojecten anderzijds, met het oog op stadsvernieuwing en verbetering van de leefomgeving.\r\nHet ARAU wil met zijn bewustmakings- en voorlichtingsactie de bevolking de nodige instrumenten aanreiken om de evolutie van de stad te volgen. Deze actie neemt de vorm aan van de publicatie van analyses en studies, de organisatie van conferenties en workshops, perscommuniqu\u00e9s, enz. en rondleidingen.\r\nDeze rondleidingen, die baanbrekend zijn in het Brusselse Gewest en al sinds 1977 worden georganiseerd, hebben tot doel de stad en haar troeven tot hun recht te laten komen en een kritische kijk te ontwikkelen op haar transformaties, die ook het behoud en de instandhouding van haar erfgoed inhouden.\r\nIn de loop der jaren heeft het ARAU een rijke catalogus van rondleidingen over verschillende thema\u2019s samengesteld: \u201cOnmisbaar Brussel\u201d, \u201cArchitectuur\u201d, \u201cBrussel in wijken\u201d, \u201cDe stad in transformatie\u201d, \u201cZomerreis\u201d, \u201cEen Brussels huis\u201d, \u201cBrussel: stad van de trams\u201d, \u201cSociaal Brussel\u201d, die tijdens openbare rondleidingen of in de vorm van priv\u00e9rondleidingen op maat kunnen worden ontdekt.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":422,"location":{"lat":50.84343195,"lon":4.34634563},"is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/0d560172c70ec53b8e9d1aa1c204ac8eacb89c6d.jpg","width":3000,"height":4000,"ratio":0.75,"oEmbed_height":4000,"oEmbed_width":3000,"translations":{"de":{"title":"Les Marolles et l'Art nouveau","copyright":null},"pt":{"title":"Les Marolles et l'Art nouveau","copyright":null},"en":{"title":"Les Marolles et l'Art nouveau","copyright":null},"it":{"title":"Les Marolles et l'Art nouveau","copyright":null},"cn":{"title":"Les Marolles et l'Art nouveau","copyright":null},"fr":{"title":"Les Marolles e