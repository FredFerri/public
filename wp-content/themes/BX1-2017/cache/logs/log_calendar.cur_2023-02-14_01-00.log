facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-11T09:36:47+01:00","published_at":"2022-12-16T12:47:49+01:00","backoffice_id":267517,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":550683,"date_start":"2023-02-15","date_end":"2023-02-15","date_next":"2023-02-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Nos circollections\u2026 (Th\u00e9\u00e2tre du Papyrus et La Relative)","shortdescr":"Depuis des ann\u00e9es, elles parcourent le monde pour recueillir des t\u00e9moignages, des r\u00e9cits, des anecdotes de cirque.","longdescr":"Ce qui les int\u00e9resse plus particuli\u00e8rement, ce sont les histoires de cirques int\u00e9rieurs, celles qui se traduisent dans la vie de tous les jours. Car le cirque est partout. Parfois invisible pour les yeux, il nous habite souvent.\r\nLu et Clo, chercheuses en histoires circassiennes les font voyager dans une collection mobile afin que celles-ci soient transmises et demeurent vivantes. C\u2019est comme cela que leur \u201cCircollection\u201d continue de s\u2019\u00e9tayer \u00e0 chaque rencontre, parce que du cirque il y en a vraiment partout. La preuve...\r\nUn spectacle participatif de proximit\u00e9 pour partager de grandes acrobaties \u00e9motionnelles.","performers":"Avec Chlo\u00e9 Duvauchel en alternance avec Lucie Lastella, Elsa Debefve et Anne-Catherine Petit. Texte : Chlo\u00e9 Duvauchel. Dessin : Lucie Lastella. Ma\u00efeutique : Nicolas Duvauchel et Marianne Hans\u00e9. Soutien artistique : Bernard Chemin. Cr\u00e9ation textile : Marie Kersten. Constructions : Paul Ernouf et Antoine Petit. Diffusion Belgique : Val\u00e9rie Kohl. Direction artistique : Chlo\u00e9 Duvauchel.","boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550683"},"nl":{"name":"Nos circollections\u2026 (Th\u00e9\u00e2tre du Papyrus et La Relative)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550683"},"en":{"name":"Nos circollections\u2026 (Th\u00e9\u00e2tre du Papyrus et La Relative)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550683"},"de":{"name":"Nos circollections\u2026 (Th\u00e9\u00e2tre du Papyrus et La Relative)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550683"},"it":{"name":"Nos circollections\u2026 (Th\u00e9\u00e2tre du Papyrus et La Relative)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,