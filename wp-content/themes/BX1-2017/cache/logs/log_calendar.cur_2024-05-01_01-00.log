{"name":"Mus\u00e9e Bruxellois du Moulin et de l'Alimentation","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.moulindevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue du Moulin \u00e0 Vent, 21","address_line2":"1140 Evere","description_web":"Le Mus\u00e9e bruxellois du Moulin et de l'Alimentation est situ\u00e9 dans l'ancien moulin d'Evere. T\u00e9moin unique du patrimoine industriel bruxellois, ce b\u00e2timent class\u00e9 a suivi toutes les \u00e9volutions techniques des XIXe et XXe si\u00e8cles. Les collections permanentes illustrent le monde de la meunerie et l\u2019histoire du moulin d\u2019Evere. Chaque ann\u00e9e, en septembre, le renouvellement complet des objets expos\u00e9s permet d'approfondir une th\u00e9matique alimentaire diff\u00e9rente.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Mus\u00e9e Bruxellois du Moulin et de l'Alimentation","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.moulindevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue du Moulin \u00e0 Vent, 21","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brussels Museum van de Molen en de Voeding","address_street_name":"Windmolenstraat","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.molenevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Windmolenstraat, 21","address_line2":"1140 Evere","description_web":"Het Brussels Museum van de Molen en de Voeding is gelegen in de oude molen van Evere. Als unieke getuige van het industrieel erfgoed van Brussel, heeft dit beschermde monumentale gebouw alle technische ontwikkelingen van de negentiende en twintigste eeuw gekend. De permanente collecties illustreren de wereld en de geschiedenis van de molen van Evere. Elk jaar in september wordt de selectie van tentoongestelde voorwerpen compleet vernieuwd wat toelaat zich telkens opnieuw in een nieuw voedingsthema te verdiepen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":9262,"location":{"lat":50.87297273,"lon":4.39540048},"is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/924a600ea7f119f17bc9adf904e68e61d0504d85.jpg","width":900,"height":900,"ratio":1,"oEmbed_height":900,"oEmbed_width":900,"translations":{"de":{"title":"Forever Bread - Du grain au pain","copyright":"Adobestock"},"pt":{"title":"Forever Bread - Du grain au pain","copyright":"Adobestock"},"en":{"title":"Forever Bread - Du grain au pain","copyright":"Adobestock"},"it":{"title":"Forever Bread - Du grain au pain","copyright":"Adobestock"},"cn":{"title":"Forever Bread - Du grain au pain","copyright":"Adobestock"},"fr":{"title":"Forever Bread - Du grain au pain","copyright":"Adobestock"},"sp":{"title":"Forever Bread - Du grain au pain","copyright":"Adobestock"},"nl":{"title":"Forever Bread - Du grain au pain","copyright":"Adobestock"}}}],"dates":[{"day":"2023-10-06","doors":null,"start":"10:00:00","end":"12:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-06","doors":null,"start":"13:30:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-07","doors":null,"start":"13:00: