","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","LGTBQIA","Senioren"],"en":["Schools","Teachers","Family","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors"]}},"educational_targets":{"list":[3,8,9],"translations":{"fr":["Secondaire","14 - 16 ans","16 - 18 ans"],"nl":["Secundair onderwijs","14 - 16 jaar","16 - 18 jaar"],"en":["Secondary school","14 - 16 years","16 - 18 years"]}},"tags":["kids"],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-14T01:05:38+01:00","published_at":"2021-03-04T10:28:03+01:00","backoffice_id":229491,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.082778184256805},{"id":539785,"date_start":"2022-11-19","date_end":"2022-11-19","date_next":"2022-11-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[54],"translations":{"fr":["One man Show et humour"],"nl":["Onemanshow en humor"],"en":["One man show and comedy"],"de":["One Man Show & Comedy"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Freddy Tougaux: Hein!","shortdescr":"\u00ab Hein ! \u00bb... Mais c'est pas un titre de spectacle \u00e7a!\r\nC'est une interjection, une ponctuation ! \r\nExactement, ce show c'est trois points de suspension.","longdescr":"\u00ab Hein ! \u00bb... Mais c'est pas un titre de spectacle \u00e7a!\r\nC'est une interjection, une ponctuation ! \r\nExactement, ce show c'est trois points de suspension.\r\nUn moment particulier en apesanteur que le public partage avec Freddy.\r\n\r\nIl ne devait pas exister ce spectacle, mais il est apparu comme une turgescence sauvage \u00e9merge dans le humus fertile de la spontan\u00e9it\u00e9.\r\nPendant les p\u00e9riodes compliqu\u00e9es de ces deux derni\u00e8res ann\u00e9es, il a fallu trouver d'autres formes pour se produire sur sc\u00e8ne, cr\u00e9er, recr\u00e9er l'espace sc\u00e9nique.\r\nEt ainsi des textes, des situations sont n\u00e9s de ces nouvelles formes et ont donn\u00e9 naissance \u00e0 \u00ab HEIN ! \u00bb\r\n\r\nC'est du Freddy en toute libert\u00e9 qui l\u00e2che les brides du cheval fougueux de son enthousiasme.\r\nEn grand \u00e9cart, il passe aussi virevoltemment, d'une analyse pointue de la conjecture actuelle sans cesse en \u00e9volution \u00e0 la r\u00e9interpr\u00e9tation tr\u00e8s personnelle des Grands Classiques de la Chanson fran\u00e7aise.\r\nC'est pas un spectacle \u00e0 voir, c'est un spectacle \u00e0 vivre !\r\n\u00ab HEIN ! \u00bb de et par Freddy Tougaux","performers":"Freddy Tougaux","boxoffice_url":null,"website":"http:\/\/www.fourire.be","email":"reservations@fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 483 59 92 29","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539785"},"nl":{"name":"Freddy Tougaux: Hein!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539785"},"en":{"name":"Freddy Tougaux: Hein!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539785"},"de":{"name":"Freddy Tougaux: Hein!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539785"},"it":{"name":"Freddy Tougaux: Hein!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539785"},"sp":{"name":"Freddy Tougaux: Hein!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539785"},"pt":{"name":"Freddy Tougaux: Hein!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539785"},"cn":{"name":"Freddy Tougaux: Hein!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539785"}},"place":{"id":249081,"translations":{"fr":{"name":"Fou Rire","address_street_name":"rue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Ixelles","address_line1":"rue des Grenadiers, 48","address_line2":"1050 Ixelles","description_web":"Vous cherchez une soir\u00e9e pleine d'humour et de divertissement ? Vous \u00eates alors \u00e0 la bonne adresse (attention, celle-ci a chang\u00e9 en 2019). Par la d\u00e9tente, l'interaction et l'\u00e9motion, il vise \u00e0 relier les gens par et \u00e0 travers le th\u00e9\u00e2tre bruxellois et \u00e0 les renvoyer chez eux avec un sentiment de sati\u00e9t\u00e9 et d'exub\u00e9rance. Dans ce th\u00e9\u00e2tre de quartier, le texte et l'\u00e9motion occupent une place pr\u00e9pond\u00e9rante, car en plus de la com\u00e9die, retrouvez aussi de la po\u00e9sie, de la philosophie, des contes et du th\u00e9\u00e2tre jeune public.   \r\n\r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Fou Rire","address_street_name":"Grenadiersstraat","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Elsene","address_line1":"Grenadiersstraat, 48","address_line2":"1050 Elsene","description_web":"Op zoek naar een avond vol humor en vermaak? Dan bij je bij Le Fou Rire aan het juiste (sinds 2019 nieuwe!) adres, want dat betekent \u2018slappe lach\u2019 in het Frans. Via ontspanning, wisselwerking en emotie wil dit door en door Brussels theater mensen verbinden en hen met een verzadigd en uitgelaten gevoel weer naar huis sturen. Tekst en emotie krijgen een glansrol in dit buurttheater, want naast stand-upcomedy komen ook po\u00ebzie, filosofie en zelfs sprookjes en jeugdtheater ruimschoots aan bod.   ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Fou Rire","address_street_name":"rue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Ixelles","address_line1":"rue des Grenadiers, 48","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Fou Rire","address_street_name":"rue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fou