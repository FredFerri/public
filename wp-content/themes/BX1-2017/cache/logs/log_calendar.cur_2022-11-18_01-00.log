start":"20:00:00","end":"22:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"20:00:00","end":"22:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"20:00:00","end":"22:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi et dimanche: ferm\u00e9","mardi, mercredi, jeudi, vendredi et samedi: de 20:00 \u00e0 22:00"],"nl":["maandag en zondag: gesloten","dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 20:00 tot 22:00"],"en":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 20:00 to 22:00"]},"date_start":"2022-11-22","date_end":"2022-11-26","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":13},{"translations":{"fr":{"name":"Cat\u00e9gorie 2"},"nl":{"name":"Categorie 2"},"en":{"name":"Category 2"}},"value":9},{"translations":{"fr":{"name":"Cat\u00e9gorie 3"},"nl":{"name":"Categorie 3"},"en":{"name":"Category 3"}},"value":6},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T21:05:10+02:00","published_at":"2022-08-08T16:53:39+02:00","backoffice_id":259408,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.73680629972808},{"id":539299,"date_start":"2022-11-22","date_end":"2022-12-03","date_next":"2022-11-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La Place - Laure Lapel","shortdescr":"\u00abTu sais il y a des petits inconforts qui tout de suite t\u2019\u00e9nervent pour peu\r\nque t u te sentes d\u00e9j\u00e0 un peu mal\u00bb  Karim","longdescr":"Le bistrot du coin a ferm\u00e9 et les arbres ont \u00e9t\u00e9 arrach\u00e9s.\r\nThierry et Karim cherchent leur place. Les modifications rapides et violentes que traverse le quartier perturbent leurs rep\u00e8res.\r\nPartant d\u2019entretiens enregistr\u00e9s, deux jeunes com\u00e9diennes interpr\u00e8tent ces vieux ch\u00f4meurs c\u00e9libataires, alcooliques et autodidactes.\r\nL\u2019un dit \u00eatre un arbre, l\u2019autre Robin des Bois. Leur parole et le regard d\u2019autrui sont leurs seules armes de r\u00e9sistance.\r\nPendant ce temps, un personnage muet explore les vestiges de l\u2019espace de jeu. Un lieu qui s\u2019effrite et dont la m\u00e9moire s\u2019efface.\r\n\r\n\u201cJe m\u2019arr\u00eate sur trois rencontres (Thierry, Karim et Pierre) qui ont r\u00e9sonn\u00e9 en moi de mani\u00e8re particuli\u00e8re, et qui sont motrices pour un passage au plateau sur trois aspects. Le premier est que ces personnes s\u2019introduisent elles-m\u00eames comme des personnages, leurs histoires me fascinent et en deviennent mythiques. Le deuxi\u00e8me est que je porte un point de vue contradictoire sur eux et que je souhaite le partager. Le troisi\u00e8me est le potentiel litt\u00e9raire et stylistique qui se d\u00e9gage de leur parole.\r\n\r\nIl y a pour moi comme une \u00e9vidence \u00e0 partir de ces trois personnages, un \u00e9quilibre, une trinit\u00e9 : ils offrent trois fa\u00e7ons d\u2019\u00eatre au quartier comme trois fa\u00e7ons d\u2019\u00eatre au monde. D\u2019ailleurs, pour eux, le monde c\u2019est la place. \r\n\r\nBien qu\u2019isol\u00e9s, ces trois points de vue se frottent, relativisent ou entrent en \u00e9cho les uns avec les autres. Je tiens selon moi des personnages mythiques et l\u00e9gendaires, en lutte et en re-conqu\u00eate d\u2019une justice, d\u2019un espace, de liens solides, au moment o\u00f9 tout cela s\u2019effrite.\u201d","performers":"Avec Yasmina Al-Assi, Zenabou Mbamba, Zo\u00e9 Sjollema Conception et mise en sc\u00e8ne Laure Lapel Aide \u00e0 l\u2019\u00e9criture et dramaturgie J\u00e9r\u00f4me Michez \u2013 Cr\u00e9ation sonore Louison Assi\u00e9, Laure Lapel \u2013 Lumi\u00e8re Jonathan Kibani \u2013 Sc\u00e9nographie Nathalie Moisan\u2013 Aide \u00e0 la production Laetitia Neri-Miranda","boxoffice_url":null,"website":"http:\/\/www.oceannord.org","email":"info@oceannord.org","phone_contact":"+32 2 242 96 89","phone_booking":"+32 2 216 75 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539299"},"nl":{"name":"La Place - Laure Lapel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539299"},"en":{"name":"La Place - Laure Lapel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539299"},"de":{"name":"La Place - Laure Lapel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539299"},"it":{"name":"La Place - Laure Lapel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"websit