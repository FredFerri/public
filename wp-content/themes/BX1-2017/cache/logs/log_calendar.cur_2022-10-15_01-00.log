","is_soldout":false,"is_canceled":false},{"day":"2022-10-12","doors":"19:30:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-13","doors":"19:30:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-14","doors":"19:30:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-15","doors":"19:30:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-21","doors":"19:30:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-22","doors":"19:30:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":22},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":15},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":15},{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groep"},"en":{"name":"Group"}},"value":18},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"tags":["kids"],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T02:06:34+02:00","published_at":"2022-09-06T11:31:29+02:00","backoffice_id":261130,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.44303093598303},{"id":543534,"date_start":"2022-10-13","date_end":"2022-11-05","date_next":"2022-10-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[55],"translations":{"fr":["Th\u00e9\u00e2tre de marionnettes"],"nl":["Poppentheater"],"en":["Puppet show"],"de":["Puppentheater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Dracula","shortdescr":"Parodie pour marionnettes, en bruxellois fran\u00e7ais.","longdescr":"Apr\u00e8s \"Rom\u00e9o et Juliette\", voici la deuxi\u00e8me cr\u00e9ation du jeune Toone VIII, Nicolas G\u00e9al.\r\n\"Dracula\" est une adaptation bruxelloise du c\u00e9l\u00e8bre roman de Bram Stoker.\r\nL\u2019action se d\u00e9roule en Transylvanie et dans le quartier des Marolles.\r\nWoltje, mascotte l\u00e9gendaire du Th\u00e9\u00e2tre de Toone, jouera le r\u00f4le de Jonathan Harker.\r\nC\u2019est donc lui qui sera charg\u00e9 d\u2019aller rencontrer le comte Dracula en Transylvanie pour lui vendre l\u2019abbaye de Carfax, situ\u00e9e place de Brouck\u00e8re.\r\nL\u2019\u00e9preuve sera rude. Il ira de surprise en surprise et attrapera des \"slaptitudes\", des \"flanellebiene\" et les \"poepers\" au fur et \u00e0 mesure que le sinistre ch\u00e2teau d\u00e9voilera ses secrets.\r\nTrois vampires \"froucheless\" vont m\u00eame le faire biberer jusque dans son \"dikkentien\".\r\n\r\nLa distribution comprend \u00e9galement d\u2019autres \"poechenelles\" c\u00e9l\u00e8bres tel que \"Jef Pat\u00e2\u00e2t\" et le \"Duivel\".\r\nCe spectacle s\u2019adresse aux familles et \u00e0 tous ceux qui aiment l\u2019humour bruxellois.\r\n\r\nDe et par Nicolas G\u00e9al d\u2019apr\u00e8s Bram Stoker\r\nD\u00e9cors et costumes de Thierry Bosquet\r\nR\u00e9alisation des d\u00e9cors : Eug\u00e9nie Obolensky\r\nR\u00e9alisation des costumes : Lidia Gosamo","performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":"woltje@skynet.be","phone_contact":null,"phone_booking":"+32 2 513 54 86","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543534"},"nl":{"name":"Dracula","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543534"},"en":{"name":"Dracula","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543534"},"de":{"name":"Dracula","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543534"},"it":{"name":"Dracula","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543534"},"sp":{"name":"Dracula","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543534"},"pt":{"name":"Dracula","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543534"},"cn":{"name":"Dracula","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543534"}},"place":{"id":231143,"translations":{"fr":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"Le Th\u00e9\u00e2tre Royal de Toone: un th\u00e9\u00e2tre original et authentique, impr\u00e9gn\u00e9 d\u2019histoire et de culture bruxelloise !\r\nId\u00e9alement situ\u00e9 \u00e0 c\u00f4t\u00e9 de la Grand-Place, dans une maison v\u00e9n\u00e9rable datant de 1696, le Th\u00e9\u00e2tre Royal de Toone poursuit la tradition s\u00e9culaire du th\u00e9\u00e2tre populaire de marionnettes depuis 1830. \r\nLa programmation est bas\u00e9e sur les grands classiques du th\u00e9\u00e2tre tels que \u00ab Les Trois Mousquetaires \u00bb d\u2019apr\u00e8s Alexandre Dumas ou encore \u00ab Rom\u00e9o et Juliette \u00bb d\u2019apr\u00e8s William Shakespeare.\r\nActuellement, le mus\u00e9e permanent de Toone situ\u00e9 au premier \u00e9tage du b\u00e2timent principal se visite gratuitement pendant l\u2019entracte.\r\nL\u2019estaminet folklorique au rez-de-chauss\u00e9e est ouvert tous les jours de 12h00 \u00e0 24h00, sauf le lundi (jour de fermeture).\r\nC\u2019est  un estaminet tricentenaire o\u00f9, dans une ambiance authentique de briques roses espagnoles, poutres noircies et sol dall\u00e9, vous pourrez appr\u00e9cier quelques bi\u00e8res, dont la c\u00e9l\u00e8bre gueuze. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koninklijk Poppentheater Toone","address_street_name":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussel","address_line1":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Brussel","description_web":"Traditioneel marionettentheater Brusselse folklore - Typisch Staminee.\r\nMuseum van Toone: Gratis toegang voor het publiek tijdens de pauze.\r\nHet Koninklijk Theater Toone in Brussel is een origineel en authentiek poppentheater dat doorspekt is van Brusselse geschiedenis en cultuur! \r\nHet Koninklijk Theater Toone zet sinds 1830 de eeuwenoude traditie van het volkse Theater voort.\r\nDe programmatie is gebaseerd op grote toneelklassiekers zoals \"Cyrano de Bergerac\" van Edmond Rostand, \"De Drie Musketiers\" van Alexandre Dumas, \"Romeo en Julia\" van William Shakespeare en \"Tijl Uilenspiegel\" van Charles De Coster. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussels","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Brussels","description_web":"During the Spanish occupation of the Netherlands all theaters were closed to prevent the actors from raising satirical pieces against the Spanish rulers. As a result, doll shows came into play: it was easier to tolerate the fierce dialogues when pronounced by lifeless dolls. About 1830 Antoine \"Toone\" Genty opened  a puppet theater, then in the Marolles. More than 180 years later, this popular entertainment has grown into a Royal Puppet Theater. After Genty, his (unrelated) successors would also be called Toone (Antoine).\r\nThe classics are performed in the local Brussels dialect with wooden puppets (the so-called poechenel), sometimes in Dutch or in French. The puppet theater and museum has been located near the Grand Place for four decades. The theater is located on the upper floors of the building, on the ground floor there is a pub. The museum contains old dolls, including 19th century specimens.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Marionettentheater - Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"W\u00e4hrend der spanischen Besetzung der Niederlande wurden zwangsweise s\u00e4mtliche Theater geschlossen, um Kritik - in Form von satirischen St\u00fccken - an den spanischen Herrschern zu unterbinden. Die Br\u00fcsseler haben alsdann die Schauspieler durch Marionetten (\"Poechenelles\" in Br\u00fcsseler Mundart) ersetzt, die in illegalen Theatern auftragen. \r\nAnfang des 19. Jahrhunderts z\u00e4hlten die Br\u00fcsseler Marionettentheater zu den beliebtesten Vergn\u00fcgungen f\u00fcr Erwachsene, denn sie boten eine enorme Freiheit, ben\u00f6tigen nur wenig finanzielle Mittel und konnten \u00fcberall aufgef\u00fchrt werden. Ihr Repertoire ist bis heute sehr vielf\u00e4ltig und reicht von volkst\u00fcmlichen Legenden \u00fcber Rittergeschichten bis hin zu religi\u00f6sen oder historischen St\u00fccken, die sehr frei interpretiert werden. \r\nSeit der Gr\u00fcndung des Theaters im Marollenviertel ist nun bereits die 9. Puppenspielergeneration der Toone-Dynastie am Werk. Der jeweils neue Toone (Br\u00fcsseler Kosename f\u00fcr \"Antoine\", so der Vorname des Gr\u00fcnders) muss sowohl von seinem Vorg\u00e4nger als auch von dem Publikum angenommen werden - und so ist es nicht unbedingt der jeweilige Sohn, der die Nachfolge antritt. \r\nDie Klassiker werden in Br\u00fcsseler Mundart und manchmal auch auf Niederl\u00e4ndisch oder Franz\u00f6sisch aufgef\u00fchrt. \r\nDas Th\u00e9\u00e2tre de Toone birgt auch ein urige Schenke und ein Marionettenmuseum.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Teatro Reale di Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"Traditional Brussels\u2019 puppet theater & museum - Typical caf\u00e9\r\nBordering the Impasses Schuddeveld and Sainte-P\u00e9tronille, you will find one of the favourite places of Brussels citizens: Le th\u00e9\u00e2tre de Toone.\r\nTheater Toone is simultaneously a typical estaminet with its Spanish pink brick walls, blackened beams and tiled floor, a puppet theatre in the attic, with its wooden benches, festooned, multicoloured cushions nailed into the raw wood planks and a puppet museum. There, we find the characters who retired from the stage, these Toone heroes of the past and fetish characters of fellow puppeteers from around the world.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Teatro Real Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":[],"neca":null,"facebook_id":null,"backoffice_id":913,"location":{"lat":null,"lon":null},"region":"brussels","last_updated_at":"2022-10-14T02:05:29+02:00","published_at":"2013-10-19T01:13:54+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231143,"translations":{"fr":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"Le Th\u00e9\u00e2tre Royal de Toone: un th\u00e9\u00e2tre original et authentique, impr\u00e9gn\u00e9 d\u2019histoire et de culture bruxelloise !\r\nId\u00e9alement situ\u00e9 \u00e0 c\u00f4t\u00e9 de la Grand-Place, dans une maison v\u00e9n\u00e9rable datant de 1696, le Th\u00e9\u00e2tre Royal de Toone poursuit la tradition s\u00e9culaire du th\u00e9\u00e2tre populaire de marionnettes depuis 1830. \r\nLa programmation est bas\u00e9e sur les grands classiques du th\u00e9\u00e2tre tels que \u00ab Les Trois Mousquetaires \u00bb d\u2019apr\u00e8s Alexandre Dumas ou encore \u00ab Rom\u00e9o et Juliette \u00bb d\u2019apr\u00e8s William Shakespeare.\r\nActuellement, le mus\u00e9e permanent de Toone situ\u00e9 au premier \u00e9tage du b\u00e2timent principal se visite gratuitement pendant l\u2019entracte.\r\nL\u2019estaminet folklorique au rez-de-chauss\u00e9e est ouvert tous les jours de 12h00 \u00e0 24h00, sauf le lundi (jour de fermeture).\r\nC\u2019est  un estaminet tricentenaire o\u00f9, dans une ambiance authentique de briques roses espagnoles, poutres noircies et sol dall\u00e9, vous pourrez appr\u00e9cier quelques bi\u00e8res, dont la c\u00e9l\u00e8bre gueuze. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koninklijk Poppentheater Toone","address_street_name":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussel","address_line1":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Brussel","description_web":"Traditioneel marionettentheater Brusselse folklore - Typisch Staminee.\r\nMuseum van Toone: Gratis toegang voor het publiek tijdens de pauze.\r\nHet Koninklijk Theater Toone in Brussel is een origineel en authentiek poppentheater dat doorspekt is van Brusselse geschiedenis en cultuur! \r\nHet Koninklijk Theater Toone zet sinds 1830 de eeuwenoude traditie van het volkse Theater voort.\r\nDe programmatie is gebaseerd op grote toneelklassiekers zoals \"Cyrano de Bergerac\" van Edmond Rostand, \"De Drie Musketiers\" van Alexandre Dumas, \"Romeo en Julia\" van William Shakespeare en \"Tijl Uilenspiegel\" van Charles De Coster. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussels","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Brussels","description_web":"During the Spanish occupation of the Netherlands all theaters were closed to prevent the actors from raising satirical pieces against the Spanish rulers. As a result, doll shows came into play: it was easier to tolerate the fierce dialogues when pronounced by lifeless dolls. About 1830 Antoine \"Toone\" Genty opened  a puppet theater, then in the Marolles. More than 180 years later, this popular entertainment has grown into a Royal Puppet Theater. After Genty, his (unrelated) successors would also be called Toone (Antoine).\r\nThe classics are performed in the local Brussels dialect with wooden puppets (the so-called poechenel), sometimes in Dutch or in French. The puppet theater and museum has been located near the Grand Place for four decades. The theater is located on the upper floors of the building, on the ground floor there is a pub. The museum contains old dolls, including 19th century specimens.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Marionettentheater - Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"W\u00e4hrend der spanischen Besetzung der Niederlande wurden zwangsweise s\u00e4mtliche Theater geschlossen, um Kritik - in Form von satirischen St\u00fccken - an den spanischen Herrschern zu unterbinden. Die Br\u00fcsseler haben alsdann die Schauspieler durch Marionetten (\"Poechenelles\" in Br\u00fcsseler Mundart) ersetzt, die in illegalen Theatern auftragen. \r\nAnfang des 19. Jahrhunderts z\u00e4hlten die Br\u00fcsseler Marionettentheater zu den beliebtesten Vergn\u00fcgungen f\u00fcr Erwachsene, denn sie boten eine enorme Freiheit, ben\u00f6tigen nur wenig finanzielle Mittel und konnten \u00fcberall aufgef\u00fchrt werden. Ihr Repertoire ist bis heute sehr vielf\u00e4ltig und reicht von volkst\u00fcmlichen Legenden \u00fcber Rittergeschichten bis hin zu religi\u00f6sen oder historischen St\u00fccken, die sehr frei interpretiert werden. \r\nSeit der Gr\u00fcndung des Theaters im Marollenviertel ist nun bereits die 9. Puppenspielergeneration der Toone-Dynastie am Werk. Der jeweils neue Toone (Br\u00fcsseler Kosename f\u00fcr \"Antoine\", so der Vorname des Gr\u00fcnders) muss sowohl von seinem Vorg\u00e4nger als auch von dem Publikum angenommen werden - und so ist es nicht unbedingt der jeweilige Sohn, der die Nachfolge antritt. \r\nDie Klassiker werden in Br\u00fcsseler Mundart und manchmal auch auf Niederl\u00e4ndisch oder Franz\u00f6sisch aufgef\u00fchrt. \r\nDas Th\u00e9\u00e2tre de Toone birgt auch ein urige Schenke und ein Marionettenmuseum.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Teatro Reale di Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"Traditional Brussels\u2019 puppet theater & museum - Typical caf\u00e9\r\nBordering the Impasses Schuddeveld and Sainte-P\u00e9tronille, you will find one of the favourite places of Brussels citizens: Le th\u00e9\u00e2tre de Toone.\r\nTheater Toone is simultaneously a typical estaminet with its Spanish pink brick walls, blackened beams and tiled floor, a puppet theatre in the attic, with its wooden benches, festooned, multicoloured cushions nailed into the raw wood planks and a puppet museum. There, we find the characters who retired from the stage, these Toone heroes of the past and fetish characters of fellow puppeteers from around the world.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Teatro Real Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":913,"location":{"lat":null,"lon":null},"region":"brussels","last_updated_at":"2022-10-14T02:05:30+02:00","published_at":"2013-10-19T01:13:54+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/75e6628f81e48c8ff48fc2ae6bbd4730b8282ada.jpg","width":2309,"height":1535,"ratio":1.5,"translations":{"fr":{"title":"Dracula","copyright":null},"nl":{"title":"Dracula","copyright":null},"en":{"title":"Dracula","copyright":null}}}],"dates":[{"day":"2022-10-13","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-10-14","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-10-15","doors":null,"start":"16:00:00","end":"18:00:00"},{"day":"2022-10-15","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-10-20","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-10-21","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-10-22","doors":null,"start":"16:00:00","end":"18:00:00"},{"day":"2022-10-22","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-10-27","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-10-28","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-10-29","doors":null,"start":"16:00:00","end":"18:00:00"},{"day":"2022-10-29","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-11-03","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-11-04","doors":null,"start":"20:30:00","end":"22:30:00"},{"day":"2022-11-05","doors":null,"start":"16:00:00","end":"18:00:00"},{"day":"2022-11-05","doors":null,"start":"20:30:00","end":"22:30:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"20:30:00","end":"22:30:00"}]},"friday":{"is_open":true,"hours":[{"start":"20:30:00","end":"22:30:00"}]},"saturday":{"is_open":true,"hours":[{"start":"16:00:00","end":"18:00:00"},{"start":"20:30:00","end":"22:30:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi et dimanche: ferm\u00e9","jeudi et vendredi: de 20:30 \u00e0 22:30","samedi: de 16:00 \u00e0 18:00 et de 20:30 \u00e0 22:30"],"nl":["maandag, dinsdag, woensdag en zondag: gesloten","donderdag en vrijdag: van 20:30 tot 22:30","zaterdag: van 16:00 tot 18:00 en van 20:30 tot 22:30"],"en":["monday, tuesday, wednesday and sunday: closed","thursday and friday: from 20:30 to 22:30","saturday: from 16:00 to 18:00 and from 20:30 to 22:30"]},"date_start":"2022-10-13","date_end":"2022-11-05","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":10},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":10},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":10},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T02:05:30+02:00","published_at":"2022-10-06T08:10:06+02:00","backoffice_id":263534,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.43679023236815},{"id":542865,"date_start":"2022-09-17","date_end":"2022-11-27","date_next":"2022-10-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":"Henry Bauchau (1913-2012) est un \u00e9crivain majeur, traduit dans toutes les langues europ\u00e9ennes, le chinois et le japonais. Membre de l\u2019Acad\u00e9mie de Langue et litt\u00e9rature fran\u00e7aise de Belgique. \u00c0 la fois po\u00e8te, dramaturge et diariste, il a fait sa renomm\u00e9e gr\u00e2ce \u00e0 son art du roman.","longdescr":"\u00c0 l\u2019occasion du 10e anniversaire du d\u00e9c\u00e8s de l\u2019\u00e9crivain\r\n\r\nHenry Bauchau (1913-2012) est un \u00e9crivain majeur, traduit dans toutes les langues europ\u00e9ennes, le chinois et le japonais. Membre de l\u2019Acad\u00e9mie de Langue et litt\u00e9rature fran\u00e7aise de Belgique. \u00c0 la fois po\u00e8te, dramaturge et diariste, il a fait sa renomm\u00e9e gr\u00e2ce \u00e0 son art du roman. \r\n\r\nOr sous les mots d\u2019Henry Bauchau, il y a toujours des images. \r\n\r\nD\u2019une part, il y a celles qui l\u2019inspirent : les tableaux de grands ma\u00eetres ou les cr\u00e9ations de ses contemporains qui l\u2019interpellent au point de les int\u00e9grer \u00e0 ses \u00e9crits, ou d\u2019engager une collaboration avec des plasticiens ou des photographes. Lui-m\u00eame dessinateur et sculpteur amateur, Henry Bauchau entreprend de faire \u00e9merger ce qu\u2019il appelle \u00ab les v\u00e9rit\u00e9s de la main \u00bb et confie \u00e0 ses dessins le r\u00f4le d\u2019illustration de couverture de ses livres. En tant que psychanalyste et th\u00e9rapeute, il encourage ses patients \u00e0 pratiquer les arts plastiques en atelier. Son accompagnement du jeune Lionel donne mati\u00e8re au roman L\u2019Enfant bleu (2005) et \u00e0 des projets \u00e9ditoriaux. \r\n\r\nD\u2019autre part, il y a les images que son \u00e9criture g\u00e9n\u00e8re, depuis les illustrations graphiques ou photographiques de ses r\u00e9cits aux livres d\u2019artistes et aux cr\u00e9ations les plus improbables, telles cette marionnette de glace ou cette usine con\u00e7ue par un architecte au d\u00e9part du roman \u0152dipe sur la route (1990). Les innombrables adaptations sc\u00e9niques et musicales d\u00e9borderaient le cadre de la pr\u00e9sente exposition.\r\n\r\nL\u2019exposition montre l\u2019importance des images \u00e0 l\u2019origine du travail litt\u00e9raire d\u2019Henry Bauchau et la capacit\u00e9 de l\u2019\u0153uvre \u00e0 g\u00e9n\u00e9rer chez autrui un imaginaire visuel innovant. Les vitrines sont organis\u00e9es par th\u00e8me : influences et inspirations picturales de l\u2019\u00e9crivain, collaborations avec des artistes, travail plasticien exerc\u00e9 par l\u2019auteur, initiatives ext\u00e9rieures de mises en images de ses textes.\r\n\r\nSont expos\u00e9s aussi les r\u00e9sultats du concours organis\u00e9 en 2022 \u00e0 l\u2019\u00c9cole nationale sup\u00e9rieure des arts visuels de La Cambre portant sur des cr\u00e9ations de narration graphique, des reliures ou des livres-objets : ils livrent le regard de la jeunesse contemporaine sur l\u2019\u0153uvre.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":null,"phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542865"},"nl":{"name":"Henry Bauchau, onder de woorden, de beelden","shortdescr":"Henry Bauchau (1913-2012) is een belangrijke schrijver op het internationale literaire toneel, vertaald in bijna alle europese talen, het Chinees en het Japans. Lid van de Acad\u00e9mie de Langue et de litt\u00e9rature fran\u00e7aises de Belgique. Hij is dichter, toneelschrijver en dagboekschrijver, en heeft naam gemaakt door zijn romankunst.","longdescr":"Tentoonstelling georganiseerd ter gelegenheid van de tiende verjaardag van het overlijden van de schrijver\r\n\r\nHenry Bauchau (1913-2012) is een belangrijke schrijver op het internationale literaire toneel, vertaald in bijna alle europese talen, het Chinees en het Japans. Lid van de Acad\u00e9mie de Langue et de litt\u00e9rature fran\u00e7aises de Belgique. Hij is dichter, toneelschrijver en dagboekschrijver, en heeft naam gemaakt door zijn romankunst.\r\n\r\nOnder Henry Bauchau\u2019s woorden, zijn er altijd beelden.\r\n\r\nEnerzijds zijn er beelden die hem inspireren: de schilderijen van de grote meesters of de creaties van zijn tijdgenoten die hem zo aanspreken dat hij ze in zijn geschriften integreert, of dat hij met beeldende kunstenaars of fotografen samenwerkt. Als amateur-tekenaar en beeldhouwer neemt Henry Bauchau zich voor om wat hij noemt \u00ab de waarheden van de hand \u00bb naar voren te brengen ; hij geeft zijn tekeningen de rol van omslagillustraties voor zijn boeken. Als psychoanalist en therapeut moedigt hij zijn pati\u00ebnten aan om plastische kunsten te beoefenen in workshops. Zijn begeleiding van de jonge Lionel geeft aanleiding tot de roman L\u2019Enfant bleu (2005) en tot uitgeverijprojecten. \r\n\r\nAnderzijds zijn er de beelden die zijn geschriften voortbrengen, van de grafische of fotografische illustraties van zijn verhalen tot de kunstenaarsboeken en de meest onwaarschijnlijke creaties, zoals de ijspop of de door een architect ontworpen fabriek ge\u00efnspireerd op het boek \u0152dipe sur la route (1990). De ontelbare toneel- en musicalbewerkingen vallen buiten het bestek van deze tentoonstelling.\r\n\r\nDe tentoonstelling toont het belang van beelden in het literaire werk van Henry Bauchau en het vermogen van zijn werk om bij anderen een vernieuwende visuele verbeelding op te wekken. De vitrines zijn gerangschikt volgens thema: de picturale invloeden en inspiratiebronnen van de schrijver, de samenwerking met kunstenaars, het werk van de schrijver als beeldend kunstenaar en de externe initiatieven om zijn teksten in beeld te brengen.\r\n\r\nDe resultaten van de in 2022 aan de \u00c9cole nationale sup\u00e9rieure des arts visuels de La Cambre georganiseerde wedstrijd over grafische verhaalcreaties en boekbanden zijn ook te zien: zij geven de kijk van de hedendaagse jeugd op het werk.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542865"},"en":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542865"},"de":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542865"},"it":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542865"},"sp":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542865"},"pt":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542865"},"cn":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542865"}},"place":{"id":142,"translations":{"fr":{"name":"Bibliotheca Wittockiana : Mus\u00e9e des Arts du livre et de la Reliure","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":"Fond\u00e9e en 1983 par Michel Wittock, bibliophile de renom, la Bibliotheca Wittockiana est \u00e0 la fois un mus\u00e9e du livre, une biblioth\u00e8que et une r\u00e9serve pr\u00e9cieuse de livres anciens, modernes et contemporains.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Bibliotheca Wittockiana - Museum van de Boekkunsten en de Boekband","address_street_name":"Bemelstraat","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Sint-Pieters-Woluwe","address_line1":"Bemelstraat, 23","address_line2":"1150 Sint-Pieters-Woluwe","description_web":"De Bibliotheca Wittockiana biedt onderdak aan een van de mooiste en meest prestigieuze boekbandcollecties ter wereld. In het leven geroepen door een enthousiaste boekenliefhebber, is het de enige instelling in zijn soort in Belgi\u00eb en het buitenland. De permanente collectie, die enkel op afspraak te bezichtigen is, bevat meer dan 3000 kunstbindingen van de 16de tot de 21ste eeuw. Wittockiana organiseert ongeveer vier tijdelijke tentoonstellingen per jaar over boekbinden en boekenkunsten.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Bibliotheca Wittockiana","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","d