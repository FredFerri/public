street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Luikenaarsstraat, 53","address_line2":"1050 Ixelles","description_web":"Explore.Brussels is a network of associations that organize top-quality guided tours in the Brussels-Capital Region. \n\nIts membre associations are ARAU, Pro Velo, Brussels Chatterguides and Arkadia. La Fonderie (in 2020) & Korei (in 2021) joined the network as a partner association.\n\nDiscover UNESCO\u2019s heritage, Art nouveau, Victoria Horta, Magritte, Herg\u00e9, Street art, Europe, beer, chocolate, or visit buildings built in Art Nouveau, Art Deco or neoclassical style that are usually closed for public visits. \n\nTours are available for individual visitors and groups, and organized in a classical, exceptional or completely new way. Besides walking tours, visits can be organized by bike, bus or boat.\n\nExplore.Brussels organizes the Brussels Art Nouveau & Art Deco (BANAD) Festival and Brussels Biennale \u2013 Neoclassic (BBN), Brussels Biennale of Eclectic Architecture (BBEA) as well as other projects such as the visits of Art Nouveau Mansions, the formation of tour guides, the owners club and the friends club. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels","address_street_name":"Rue des Li\u00e9geois","address_street_number":"53","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue des Li\u00e9geois, 53","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Explore.brussels","address_street_name":"Rue des