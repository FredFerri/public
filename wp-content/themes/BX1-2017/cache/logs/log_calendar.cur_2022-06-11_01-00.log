eren"},"en":{"name":"Young"}},"value":10},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":13}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-22T01:08:33+02:00","published_at":"2022-03-30T11:59:35+02:00","backoffice_id":250544,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.24935232870451},{"id":514825,"date_start":"2022-06-22","date_end":"2022-06-25","date_next":"2022-06-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Discours \u00e0 la nation","shortdescr":"De l\u2019ironie \u00e0 la farce, de la satire politique \u00e0 la r\u00e9alit\u00e9 crue, Ascanio Celestini et David Murgia nous emm\u00e8nent dans un monde engag\u00e9, peupl\u00e9 de personnages attachants, de violences et de po\u00e9sie. Ce triptyque est propos\u00e9 dans le sens inverse de leur cr\u00e9ation.","longdescr":"Camarades ! Et je veux vous appeler ainsi, m\u00eame si je sais que vous n\u2019employez plus ces belles paroles !\r\n\r\nNous sommes dans un pays m\u00e9taphorique contemporain ou futur o\u00f9 se d\u00e9roule une guerre civile non-d\u00e9clar\u00e9e. Un pays dans lequel il pleut, sans arr\u00eat. Au milieu des citoyens, de leurs pens\u00e9es, des peurs et des violences quotidiennes, le pouvoir, renferm\u00e9 dans le palais, qui habituellement n\u2019a aucunement besoin de s\u2019adresser aux masses, se penche au balcon. Patrons financiers, aspirants tyrans et dictateurs, se penchent au balcon et s\u2019adressent \u00e0 la foule, sans langue de bois, pour tenter d\u2019obtenir leur consentement. Ils parlent sans rien cacher. Ils parlent comme parleraient nos tyrans d\u00e9mocrates s\u2019ils n\u2019\u00e9taient pas contraints de cacher leur despotisme derri\u00e8re le costume de sc\u00e8ne de l\u2019\u00e9tat d\u00e9mocratique. Conf\u00e9rence, exp\u00e9rience sid\u00e9rante, bombe ou performance, on assiste \u00e0 une le\u00e7on de g\u00e9o-sociopolitique depuis le point de vue des puissants.\r\n\r\nCe qu\u2019en dit la presse:\r\n\r\n\u00c9poustouflant, hilarant, f\u00e9roce et salutaire. **** LE SOIR\r\n\r\nEntre Rimbaud, Guevara et Vaneigem, ce jeune acteur belge gifle avec ironie la r\u00e9signation de l\u2019\u00e9poque. LIB\u00c9RATION\r\n\r\nUn discours tellement loufoque et cynique qu\u2019il ne peut provoquer que le rire. Un spectacle roboratif. LE CANARD ENCHA\u00ceN\u00c9\r\n\r\nRedoutable machine \u00e0 d\u00e9fabriquer la coh\u00e9rence de bien des id\u00e9es toutes faites. MARIANNE\r\n\r\ndur\u00e9e 1h20\r\n\r\n++ \r\nBord de sc\u00e8ne. Je 23.06 apr\u00e8s spectacle. Avec David Murgia.\r\n\r\nProduction Festival de Li\u00e8ge et Th\u00e9\u00e2tre National\/Bruxelles. - Avec le soutien de L\u2019ANCRE\/Charleroi.","performers":"Une cr\u00e9ation d\u2019Ascanio Celestini et David Murgia - Texte et mise en sc\u00e8ne Ascanio Celestini - Interpr\u00e9tation David Murgia - Musique Julien Courroye - Composition musicale Carmelo Prestigiacomo - traduction Patrick Bebi - Cr\u00e9ation Lumi\u00e8res Danilo Facco - Sc\u00e9nographie Chlo\u00e9 Kegelart - R\u00e9gie Lumi\u00e8re Manu Savini - R\u00e9gie son Philippe Kariger","boxoffice_url":null,"website":"http:\/\/www.lerideau.brussels\/","email":"billetterie@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/514825.html"},"nl":{"name":"Discours \u00e0 la nation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/514825.html"},"en":{"name":"Discours \u00e0 la nation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/514825.html"},"de":{"name":"Discours \u00e0 la nation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/514825.html"},"it":{"name":"Discours \u00e0 la nation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/514825.html"},"sp":{"name":"Discours \u00e0 la nation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/514825.html"},"pt":{"name":"Discours \u00e0 la nation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/514825.html"},"cn":{"name":"Discours \u00e0 la nation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/514825.html"}},"place":{"id":944,"translations":{"fr":{"name":"Le Rideau","address_street_name":"Rue Goffart","address_street_number":"7 A","address_street_box":null,"email":"contact@rideaudebruxelles.be","website":"http:\/\/www.rideaudebruxelles.be","phone_contact":"+32 2 737 16 01","phone_booking":"+32 2 737 16 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Goffart, 7 A","address_line2":"1050 Ixelles","description_web":"Fond\u00e9 le 17 mars 1943 par Claude Etienne, le Rideau de Bruxelles est la compagnie th\u00e9\u00e2trale la plus ancienne de la capitale, et m\u00eame du pays. Subventionn\u00e9 par la F\u00e9d\u00e9ration Wallonie-Bruxelles, n'a jusqu'ici connu que trois directeurs artistiques : son fondateur Claude Etienne jusqu'\u00e0 son d\u00e9c\u00e8s (1992), Jules-Henri Marchant, et depuis octobre 2007, Michael Delaunoy. Le Rideau privil\u00e9gie la cr\u00e9ation contemporaine en r\u00e9v\u00e9lant les \u00e9critures belges et internationales les plus singuli\u00e8res et les nouvelles pratiques sc\u00e9niques. Il se veut aussi lieu de m\u00e9moire active, en particulier \u00e0 travers une exploration renouvel\u00e9e du r\u00e9pertoire belge francophone du XX\u00e8me si\u00e8cle et d'oeuvres internationales fondatrices de la modernit\u00e9 \r\nLe Rideau f\u00eate lors de cette saison 2018\/2019, 75 ans d'audace et pr\u00e9sentera ses spectacles HORS LES MURS dans des th\u00e9\u00e2tres partenaires et amis durant les travaux de r\u00e9novation de sa maison de th\u00e9\u00e2tre situ\u00e9e rue Goffart \u00e0 Ixelles. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Rideau","address_street_name":"Goffartstraat","address_street_number":"7 A","address_street_box":null,"email":"contact@rideaudebruxelles.be","website":"http:\/\/www.rideaudebruxelles.be","phone_contact":"+32 2 737 16 01","phone_booking":"+32 2 737 16 00","address_zip":"1050","address_city":"Elsene","address_line1":"Goffartstraat, 7 A","address_line2":"1050 Elsene","description_web":"Gesticht op 17 maart 1943 door Claude Etienne is Le Rideau het oudste theatergezelschap van Brussel. Le Rideau streeft  ernaar een schouwburg te zijn voor hedendaagse - zowel Belgische als buitenlandse - auteurs. Sinds 2007 wordt het geleid door Michael Delaunoy, steeds trouw aan de ontdekkingsgeest dankzij een boeiende programmatie die de relatie tussen het intieme en de wereld onderzoekt. Le Rideau de Bruxelles is aan het werk in verschillende zalen zoals de Po\u00e8me 2, Theatre Marni, Atelier 210, Th\u00e9\u00e2tre National en Petit Varia.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Rideau","address_street_name":"Rue Goffart","address_street_number":"7 A","address_street_box":null,"email":"contact@rideaudebruxelles.be","website":"http:\/\/www.rideaudebruxelles.be","phone_contact":"+32 2 737 16 01","phone_booking":"+32 2 737 16 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Goffart, 7 A","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Le Rideau","address_street_name":"Rue Goffart","address_street_number":"7 A","address_street_box":null,"email":"contact@rideaudebruxelles.be","website":"http:\/\/www.rideaudebruxelles.be","phone_contact":"+32 2 737 16 01","phone_booking":"+32 2 737 16 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Goffart, 7 A","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Rideau","address_street_name":"Rue Goffart","address_street_number":"7 A","address_street_box":null,"email":"contact@rideaudebruxelles.be","website":"http:\/\/www.rideaudebruxelles.be","phone_contact":"+32 2 737 16 01","phone_booking":"+32 2 737 16 00","add