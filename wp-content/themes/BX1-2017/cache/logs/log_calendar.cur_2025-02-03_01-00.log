e":"Quizz Night","shortdescr":"\n ","longdescr":"Ces derni\u00e8res ann\u00e9es, les quizz de l'Os \u00e0 Moelle connaissent un grand succ\u00e8s !\n\nLa mise \u00e0 l'\u00e9preuve de vos connaissances, le plaisir de jouer, l'ambiance festive et chaleureuse sont, sans doute, toutes les raisons qui font que ces soir\u00e9es sont pratiquement toujours sold-out !\n\n \n\nSi vous n'avez pas encore eu l'occasion de venir en profiter, ne tra\u00eenez pas.\n\nCr\u00e9ez votre \u00e9quipe de 4, 5, 6 ou 8 personnes et venez tester vos connaissances en musique.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50013310"},"sp":{"name":"Quizz Night","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50013310"},"nl":{"name":"Quizz Night","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50013310"}},"place":{"id":1078,"translations":{"de":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"L'Os \u00e0 Moelle",