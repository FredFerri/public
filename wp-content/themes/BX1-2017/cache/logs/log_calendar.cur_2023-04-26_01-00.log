nts":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-12T15:05:11+02:00","published_at":"2023-04-12T14:43:20+02:00","backoffice_id":275297,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1.2599210498949},{"id":555761,"date_start":"2023-04-29","date_end":"2023-04-29","date_next":"2023-04-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[53],"translations":{"fr":["Contes"],"nl":["Verteltheater"],"en":["Tales"],"de":["M\u00e4rchen"],"it":["Racconti"],"sp":["Cuentos"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le Petit Prince en Musique","shortdescr":"Le Ch\u00e2teau du Karreveld est ouvert pour le Karreveld Classic Festival avec un spectacle en musique \u00e0 l'attention du jeune public avec Le Petit Prince en Musique \u00e0 15h00 et les musiciens & circassiens d'Ora Jam\u00e0s \u00e0 17h30...","longdescr":"Le Petit Prince en Musique, d'apr\u00e8s le texte d'Antoine de Saint-Exup\u00e9ry, est mis en sc\u00e8ne. Beno\u00eet Strulus raconte une merveilleuse histoire et les musiciens animent en musique les personnages du Conte : Le Petit Prince, l\u2019Aviateur, la Fleur ou le Renard sont repr\u00e9sent\u00e9s par un motif musical particulier \u00e9voluant selon l\u2019histoire tout en s\u2019entrem\u00ealant et en se r\u00e9pondant l'un l'autre... \r\nPetites et grandes oreilles bienvenues ! On vous attend !","performers":"Beno\u00eet Strulus (conteur); Corentin Sauvager (violon, auteur du spectacle et compositeur); Javier Penalver (piano); Iris Ines da Silva (illustrations)","boxoffice_url":null,"website":"http:\/\/www.chambermusiceurope.org","email":"info@chambermusiceurope.org","phone_contact":"+32 455 14 72 12","phone_booking":"+32 455 14 72 12","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555761"},"nl":{"name":"Le Petit Prince en Musique","shortdescr":"Kasteel Karreveld is open voor het Karreveld Classic Festival met een muzikale show voor jong publiek met De Kleine Prins in Muziek om 15.00 uur en de muzikanten & circusartiesten van Ora Jam\u00e0s om 17.30 uur...","longdescr":"De Kleine Prins in Muziek, naar de tekst van Antoine de Saint-Exup\u00e9ry, wordt opgevoerd. Beno\u00eet Strulus vertelt een prachtig verhaal en de muzikanten brengen de personages van het verhaal met muziek tot leven : De Kleine Prins, de Aviator, de Bloem of de Vos worden vertegenwoordigd door een bepaald muzikaal motief dat evolueert naargelang het verhaal, terwijl het tegelijkertijd in elkaar grijpt en op elkaar reageert... \r\nKleine en grote oren welkom! We wachten op jullie! \r\n\r\nMet teksten in het Frans","performers":"Beno\u00eet Strulus (verteller); Corentin Sauvager (viool, auteur en componist); Javier Penalver (piano); Iris Ines da Silva (illustraties)","boxoffice_url":null,"website":"http:\/\/www.chambermusiceurope.org","email":"info@chambermusiceurope.org","phone_contact":"+32 455 14 72 12","phone_booking":"+32 455 14 72 12","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555761"},"en":{"name":"Le Petit Prince en Musique","shortdescr":"Karreveld Castle is open for the Karreveld Classic Festival with a musical show for young audiences with The Little Prince in Music at 15.00 and Ora Jam\u00e0s musicians & circus performers at 17.30...","longdescr":"The Little Prince in Music, based on the text by Antoine de Saint-Exup\u00e9ry, is staged. Beno\u00eet Strulus tells a wonderful story and the musicians bring the characters of the tale to life with music.\r\n\r\nWith texts in French","performers":"Beno\u00eet Strulus (storyteller); Corentin Sauvager (violin, author and composer); Javier Penalver (piano); Iris Ines da Silva (illustrations)","boxoffice_url":null,"website":"http:\/\/www.chambermusiceurope.org","email":"info@chambermusiceurope.org","phone_contact":"+32 455 14 72 12","phone_booking":"+32 455 14 72 12","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555761"},"de":{"name":"Le Petit Prince en Musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.chambermusiceurope.org","email":"info@chambermusiceurope.org","phone_contact":"+32 455 14 72 12","phone_booking":"+32 455 14 72 12","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555761"},"it":{"name":"Le Petit Prince en Musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.chambermusiceurope.org","email":"info@chambermusiceurope.org","phone_contact":"+32 455 14 72 12","phone_booking":"+32 455 14 72 12","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555761"},"sp":{"name":"Le Petit Prince en Musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.chambermusiceurope.org","email":"info@chambermusiceurope.org","phone_contact":"+32 455 14 72 12","phone_booking":"+32 455 14 72 12","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555761"},"pt":{"name":"Le Petit Prince en Musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.chambermusiceurope.org","email":"info@chambermusiceurope.org","phone_contact":"+32 455 14 72 12","phone_booking":"+32 455 14 72 12","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555761"},"cn":{"name":"Le Petit Prince en Musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.chambermusiceurope.org","email":"info@chambermusiceurope.org","phone_contact":"+32 455 14 72 12","phone_booking":"+32 455 14 72 12","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555761"}},"place":{"id":2507,"translations":{"fr":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Le Karreveld n'est pas qu'un parc mais c'est aussi une \"ferme-ch\u00e2teau\" devenue un espace culturel au centre du parc entour\u00e9 d'arbres et d'un \u00e9tang.\r\n\r\nVous pourrez vous y promener, visiter une exposition, fl\u00e2ner le long des chemins en d\u00e9couvrant ces \u00e9co-syst\u00e8mes.\r\n\r\nAu coeur du parc, ce trouve une ancienne ferme-ch\u00e2teau devenu le lieu des c\u00e9r\u00e9monies officielles de mariages des Molenbeekois mais \u00e9galement un espace culturel accueillant des expositions, concerts, spectacles, march\u00e9 artisanal (March\u00e9 de No\u00ebl), ...","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Karreveldkasteel","address_street_name":"Jean de la Hoeselaan","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Jean de la Hoeselaan, 3","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"\r\nHet Karreveld is niet alleen een park, maar ook een \"kasteelboerderij\" die een culturele ruimte is geworden in het midden van het park, omringd door bomen en een vijver.\r\n\r\nU kunt er rondwandelen, een tentoonstelling bezoeken, over de paden wandelen en deze ecosystemen ontdekken.\r\n\r\nIn het hart van het park bevindt zich een voormalige boerderij-kasteel waar offici\u00eble huwelijksceremonies van de Molenbeekenaars plaatsvinden, maar ook een culturele ruimte waar tentoonstellingen, concerten, voorstellingen, een ambachtsmarkt (kerstmarkt), ... plaatsvinden.\r\n\r\nOm (opnieuw) ontdekt te word","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"websi