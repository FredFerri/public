www.galeriebd.com\/expositions\/isabelle-dethan-egypte-antique\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002700"},"fr":{"name":"\u00c9gypte antique - Isabelle Dethan","shortdescr":"Du 8 au 30 novembre 2024, \u00e0 Bruxelles, la Galerie de la Bande Dessin\u00e9e expose les planches originales et les couvertures d\u2019Isabelle Dethan, autrice fran\u00e7aise de bande dessin\u00e9e, sp\u00e9cialis\u00e9e dans l'\u00c9gypte antique. Ces dessins originaux ont \u00e9t\u00e9 publi\u00e9s dans les s\u00e9ries Sur les terres d\u2019Horus et Le roi de Paille.","longdescr":"Il s\u2019agit de la premi\u00e8re exposition-vente de l\u2019autrice Isabelle Dethan en plus de 30 ans de carri\u00e8re. Outres les planches originales, vous pourrez d\u00e9couvrir des illustrations publi\u00e9es par le Mus\u00e9e du Louvre, Le Figaro Histoire, ainsi que quelques illustrations sp\u00e9cifiquement r\u00e9alis\u00e9es pour cette exposition.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.galeriebd.com\/expositions\/isabelle-dethan-egypte-antique\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002700"},"sp":{"name":"Ancient Egypt - Isabelle Dethan","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galeriebd.com\/expositions\/isabelle-dethan-egypte-antique\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002700"},"nl":{"name":"Het oude Egypte - Isabelle Dethan","shortdescr":"Van 8 tot 30 november 2024 stelt de Galerie de la Bande Dessin\u00e9e in Brussel de originele tekeningen en omslagen van Isabelle Dethan tentoon, gepubliceerd in de series Sur les terres d'Horus en Le Roi de Paille.","longdescr":"Dit is de eerste tentoonstellingsverkoop van auteur Isabelle Dethan in meer dan 30 jaar carri\u00e8re. Naast de originele tekeningen kunt u illustraties ontdekken die zijn gepubliceerd door het Louvre, Le Figaro Histoire, evenals enkele illustraties die speciaal voor deze tentoonstelling zijn gemaakt.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.galeriebd.com\/expositions\/isabelle-dethan-egypte-antique\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002700"}},"place":{"id":271230,"translations":{"de":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":"Based in the heart of Brussels, close to the European District, the gallery specializes in the exhibition, sale and purchase of original comic and illustration art.\r\nWhether you\u2019ve been fond of comic books since childhood or are just discovering this fantastic medium, we offer a selection of more than a thousand pieces from well-known and up-and-coming comic book artists, both European and American. We also showcase the art of children\u2019s book illustrators.","description_print":"Based in the heart of Brussels, close to the European District, the Comic Art Factory gallery specializes in the exhibition, sale and purchase of original comic and illustration art.\r\n\r\nWhether you\u2019ve been fond of comic books since childhood or are just discovering this fantastic medium, we offer a selection of more than a thousand pieces from well-known and up-and-coming comic book artists, both European and American. We also showcase the art of children\u2019s book illustrators.\r\nWe offer consulting services on how to build a collection, and are always interested in buying great pieces of art.\r\n\r\nIt would be a pleasure to have you at our gallery, where you can see our passion for sequential art firsthand. We\u2019re open Thursday through Saturday, 1 PM to 7 PM, as well as other days by appointment.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":"Situ\u00e9e au c\u0153ur de Bruxelles, proche du Quartier Europ\u00e9en, La Galerie de la Bande Dessin\u00e9e est sp\u00e9cialis\u00e9e dans l\u2019exposition, l\u2019achat et la vente de dessins BD originaux, de planches originales de bande dessin\u00e9e, d\u2019illustrations originales, de cellulos de dessins anim\u00e9s et de crayonn\u00e9s d\u2019animation japonaise (layouts, dogas, gengas).\n  \nFr\u00e9d\u00e9ric Lorge, le directeur de la galerie, qu\u2019il a cr\u00e9\u00e9e en 2014, est membre de la Chambre belge des experts en bandes dessin\u00e9es.\n\nQue vous soyez passionn\u00e9s de bande dessin\u00e9e, lectrice ou lecteur occasionnel, fan de BD franco-belge, de comics am\u00e9ricains, ou de mangas, nous vous proposons plus d\u2019un millier d\u2019\u0153uvres d\u2019art disponibles \u00e0 la vente. Nous vous recevrons avec plaisir, et partagerons avec vous notre passion pour le neuvi\u00e8me art et l\u2019animation japonaise.\n","description_print":"Situ\u00e9e au c\u0153ur de Bruxelles, proche du Quartier Europ\u00e9en, la galerie d\u2019art Comic Art Factory est sp\u00e9cialis\u00e9e dans l\u2019exposition, l\u2019achat et la vente de planches originales de bande dessin\u00e9e et d\u2019illustrations originales.\r\n\r\nQue vous soyez passionn\u00e9s de bande dessin\u00e9e, lectrice ou lecteur occasionnel, fan de BD franco-belge ou de comics am\u00e9ricains, nous vous proposons d\u2019acheter les planches BD et les illustrations originales d\u2019autrices et d\u2019auteurs de bande dessin\u00e9e, prometteurs ou confirm\u00e9s.\r\nNous proposons \u00e9galement un service de conseil pour celles et ceux qui souhaitent commencer une collection ou l\u2019affiner.\r\n\r\nNous sommes ouverts du jeudi au samedi, de 13 \u00e0 19h. Les autres jours sur rendez-vous. Nous vous recevrons avec plaisir, et partagerons avec vous notre passion pour le neuvi\u00e8me art.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Galerie de la Bande Dessin\u00e9e","address_street_name":"Waversesteenweg ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Waversesteenweg , 237","address_line2":"1050 Elsene","description_web":null,"description_print":null,"booking_url":null,"so