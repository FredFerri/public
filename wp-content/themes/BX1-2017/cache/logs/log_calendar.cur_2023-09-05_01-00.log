d_at":"2023-09-04T08:33:30+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284649,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.27909200099982406,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"La Robe Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arielledhauterives.be\/","email":"info@arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001741"},"pt":{"name":"La Robe Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arielledhauterives.be\/","email":"info@arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001741"},"en":{"name":"La Robe Rouge","shortdescr":"A garment evokes stories, presences and moods.","longdescr":"A dress is halfway between a coat and a shirt, covering and protecting, but above all dressing, enveloping the body, undulating with it. A red dress is the ultimate color, so intense is its intensity that it catches the eye. You can't remain indifferent. In the manner of Doris Lessing, who traces the multiple states of her heroine Anna in notebooks of different colors, this exhibition invites us to discover the notebooks of a red dress, what it harbors, what it exudes, its multiple facets. Around her, oscillating between power and fragility, protection and unveiling, ardor and mysterious presence, the paintings, embroideries, textiles and watercolors all work together to reveal the powers of the garment, of this red dress suspended in space, floating and hieratic.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.arielledhauterives.be\/","email":"info@arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001741"},"it":{"name":"La Robe Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arielledhauterives.be\/","email":"info@arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001741"},"cn":{"name":"La Robe Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arielledhauterives.be\/","email":"info@arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001741"},"fr":{"name":"La Robe Rouge","shortdescr":"Un v\u00eatement \u00e9voque des r\u00e9cits, des pr\u00e9sences, des humeurs.","longdescr":"Un v\u00eatement \u00e9voque des r\u00e9cits, des pr\u00e9sences, des humeurs.\nUne robe c\u2019est \u00e0 mi-chemin entre le manteau et la chemise, elle recouvre et prot\u00e8ge, mais elle habille surtout, enveloppant le corps, ondulant avec lui. \nUne robe rouge, c\u2019est la couleur qui l\u2019emporte, tellement son intensit\u00e9 nous saisit l\u2019\u0153il. On ne peut y rester indiff\u00e9rent. Les histoires se chevauchent, les sentiments hurlent, il y a ici du courage, du danger, de la sensualit\u00e9, du vivant certainement.\nA la mani\u00e8re de Doris Lessing qui retrace les \u00e9tats multiples de son h\u00e9ro\u00efne Anna dans des carnets de diff\u00e9rentes couleurs, cette exposition propose de d\u00e9couvrir ici les carnets d\u2019une robe rouge, ce qu\u2019elle abrite, ce qu\u2019elle d\u00e9gage, ses multiples facettes. \nAutour d\u2019elle, oscillant entre puissance et fragilit\u00e9, protection et d\u00e9voilement, ardeur et pr\u00e9sence myst\u00e9rieuse, les peintures, broderies, pi\u00e8ces textiles et aquarelles, concourent \u00e0 nous r\u00e9v\u00e9ler les pouvoirs du v\u00eatement, de cette robe rouge suspendue dans l\u2019espace, flottante et hi\u00e9ratique.\n","performers":"H\u00e9l\u00e8ne Picard (peinture, installation)","boxoffice_url":null,"website":"https:\/\/www.arielledhauterives.be\/","email":"info@arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001741"},"sp":{"name":"La Robe Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arielledhauterives.be\/","email":"info@arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001741"},"nl":{"name":"La Robe Rouge","shortdescr":"Een kledingstuk roept verhalen, aanwezigheid en stemmingen op.","longdescr":"Een jurk houdt het midden tussen een jas en een overhemd, hij bedekt en beschermt, maar bovenal kleedt hij af, omhult hij het lichaam en golft hij mee. Een rode jurk is de ultieme kleur, zo intens dat hij in het oog springt. Het kan je niet onverschillig laten. Op de manier van Doris Lessing, die de verschillende toestanden van haar heldin Anna beschrijft in notitieboekjes met verschillende kleuren, nodigt deze tentoonstelling ons uit om de notitieboekjes van een rode jurk te ontdekken, wat ze herbergt, wat ze uitstraalt, haar vele facetten. Rondom haar, schommelend tussen macht en kwetsbaarheid, bescherming en onthulling, vurigheid en mysterieuze aanwezigheid, werken de schilderijen, borduurwerken, textiel en aquarellen samen om de krachten van het kledingstuk te onthullen, van deze rode jurk die in de ruimte hangt, zweeft en hi\u00ebratisch is.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.arielledhauterives.be\/","email":"info@arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001741"}},"place":{"id":278514,"translations":{"de":{"name":"Arielle d'Hauterives galerie ","address_street_name":"Rue Blaes","address_street_number":"118","address_street_box":null,"email":"info@arielledhauterives.be","website":"http:\/\/www.arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Blaes, 118","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Arielle d'Hauterives galerie ","address_street_name":"Rue Blaes","address_street_number":"118","address_street_box":null,"email":"info@arielledhauterives.be","website":"http:\/\/www.arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Blaes, 118","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arielle d'Hauterives galerie ","address_street_name":"Rue Blaes","address_street_number":"118","address_street_box":null,"email":"info@arielledhauterives.be","website":"http:\/\/www.arielledhauterives.be","phone_contact":"+32 477 70 02 32","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Blaes, 118