languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite d'expo (UN)COMMON VALUES : Two Corporate Collections of Contemporary Art","shortdescr":"La collection d'art contemporain de la Banque nationale de Belgique c\u00e9l\u00e8bre son 50e anniversaire avec une exposition conjointe avec Banque d'Espagne qui exposera pour la permi\u00e8re fois les chefs-d\u2019\u0153uvre de sa collection d\u2019art contemporain sur le sol belge !","longdescr":"La collection d'art contemporain de la Banque nationale de Belgique c\u00e9l\u00e8bre son 50e anniversaire avec une exposition conjointe avec Banque d'Espagne qui exposera pour la permi\u00e8re fois les chefs-d\u2019\u0153uvre de sa collection d\u2019art contemporain sur le sol belge !L\u2019exposition (UN)COMMON VALUES : Two Corporate Collections of Contemporary Art,r\u00e9unira les \u0153uvres de pr\u00e8s de 43 artistes majeurs de la sc\u00e8ne contemporaine r\u00e9unis pour dialoguer sur la valeur intrins\u00e8que de l'art. Cet \u00e9v\u00e9nement exceptionnel aura pour toile de fond la majestueuse salle des guichets de la Banque nationale de Belgique, un joyau de l\u2019architecture moderniste !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532036.html"},"nl":{"name":"(UN)COMMON VALUES : Two Corporate Collections of Contemporary Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532036.html"},"en":{"name":"(UN)COMMON VALUES : Two Corporate Collections of Contemporary Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532036.html"},"de":{"name":"(UN)COMMON VALUES : Two Corporate Collections of Contemporary Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532036.html"},"it":{"name":"(UN)COMMON VALUES : Two Corporate Collections of Contemporary Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532036.html"},"sp":{"name":"(UN)COMMON VALUES : Two Corporate Collections of Contemporary Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532036.html"},"pt":{"name":"(UN)COMMON VALUES : Two Corporate Collections of Contemporary Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532036.html"},"cn":{"name":"(UN)COMMON VALUES : Two Corporate Collections of Contemporary Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532036.html"}},"place":{"id":220155,"translations":{"fr":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Bruxelles","description_web":"Depuis 2018, le mus\u00e9e de la Banque nationale de Belgique est install\u00e9 dans un magnifique b\u00e2timent bancaire datant du XIXe si\u00e8cle. \r\n\r\nUn premier circuit dans le mus\u00e9e aborde les r\u00f4les d\u2019une banque centrale \u00e0 travers une sc\u00e9nographie interactive. Gr\u00e2ce \u00e0 son audioguide, le visiteur peut ainsi tant\u00f4t en apprendre un peu plus sur l\u2019\u00e9mission des pi\u00e8ces et des billets, tant\u00f4t tester ses connaissances sur l\u2019euro ou encore \u00eatre amen\u00e9 \u00e0 contr\u00f4ler le niveau d\u2019inflation. \r\n\r\nLe second circuit retrace l\u2019\u00e9volution des moyens de payement et fait la part belle aux collections historiques du mus\u00e9e. Monnaies marchandises, anciens objets de change, anciennes pi\u00e8ces et billets se c\u00f4toient ainsi dans une fresque th\u00e9matique et chronologique qui fera voyager le visiteur dans le temps et \u00e0 travers le monde.\r\n\r\nEnfin, le dernier circuit regroupe une s\u00e9rie d\u2019objets qui d\u00e9montre \u00e0 quel point l\u2019argent est pr\u00e9sent dans notre quotidien.\r\n\r\nLes visites de groupe sont organis\u00e9es \u00e0 partir de 10 personnes - maximum 25. Elles sont gratuites et durent environ 1 heure. Les r\u00e9servations se font via le formulaire en ligne disponible sur le site internet http:\/\/www.nbbmuseum.be\/fr\/booking. \r\nRenseignements : 02 221 22 06 \u2013 museum@nbb.be","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van de Nationale Bank van Belgi\u00eb","address_street_name":"Warmoesberg","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Warmoesberg","address_line2":"1000 Brussel","description_web":"Sinds 2018 is het museum van de Nationale Bank van Belgi\u00eb in een prachtig 19de-eeuwse bankgebouw ondergebracht.\r\n\r\nAan de hand van interactieve opstellingen focust een eerste parcours in het museum op de taken van een centrale bank. Met behulp van een audiogids kan de bezoeker meer te weten komen over de uitgifte van munten en biljetten, zijn of haar kennis van de euro testen of proberen de inflatie onder controle te houden.\r\nHet tweede parcours schetst de evolutie van de betaalmiddelen en zet hierbij de collecties van het museum in de kijker. Goederengeld, oude ruilmiddelen, munten en biljetten vormen een thematisch en chronologisch geheel, waarbij de bezoeker wordt meegenomen op een reis in de tijd en over heel de wereld.\r\nHet derde parcours tenslotte toont een aantal voorwerpen waarmee wordt aangetoond hoe sterk geld aanwezig is in ons dagelijkse leven.\r\n\r\nGroepsbezoeken kunnen vanaf 10 personen, maximum 25. Ze zijn gratis en duren ongeveer 1 uur. Reserveren graag via de website van het museum https:\/\/www.nbbmuseum.be\/nl\/booking.\r\nMeer informatie: tel 02 221 22 06 - museum@nbb.be  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of the National Bank of Belgium","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Brussels","description_web":"Since 2018 the museum of the National Bank of Belgium is housed in a splendid 19t century bank building situates at a mere 10-minute walk from the Central Station.\r\n\r\nThe first part of the exhibition pays particular attention to the role and the functions of the National Bank. By use of an audio guide and interactive displays, the visitor will no doubt discover lots of interesting facts about the issue of notes and coins, test their knowledge of the euro, or even try to control the rate of inflation.\r\n\r\nThe second part paints an overall picture of the evolution of money, and showcases many wonderful objects from the museum collection. Commodity money, diverse and peculiar objects once used for bartering, coins and notes... These many various pieces are purposely put in a thematical and chronological context which in the end will provide the visitor with a fascinating overview.\r\n\r\nThe third part of the exhibition proves just how much money is present in our day to day life by displaying a wide range of objects, some everyday and trivial, some quirky.\r\n\r\nGroup visits can be from 10 people up to 25. They are free and take about 1 hour. Please book via the website of the museum https:\/\/www.nbbmuseum.be\/en\/booking.\r\nMore information: 02 221 22 06 - museum@nbb.be ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":null,"address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":592,"location":{"lat":50.84984775,"lon":4.35727802},"region":"brussels","last_updated_at":"2022-07-17T04:05:31+02:00","published_at":"2013-10-19T01:13:39+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","