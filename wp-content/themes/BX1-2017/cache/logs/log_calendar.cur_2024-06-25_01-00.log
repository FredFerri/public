filiation. De ce fait, l'affiliation \u00e0 l'asbl Loisirs & Sant\u00e9 est gratuite pour les membres.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Loisirs et Sant\u00e9 ASBL \/ Fmsb","address_street_name":"Rue des Moineaux, ","address_street_number":"17-19 ","address_street_box":null,"email":"loisirs.sante@fmsb.be","website":"https:\/\/www.fmsb.be\/adultes-loisirs-et-sante-asbl","phone_contact":"02 546 15 70 \/ Fax : 02 546 14 32","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Moineaux, , 17-19 ","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Loisirs et Sant\u00e9 ASBL \/ Fmsb","address_street_name":"Rue des Moineaux, ","address_street_number":"17-19 ","address_street_box":null,"email":"loisirs.sante@fmsb.be","website":"https:\/\/www.fmsb.be\/adultes-loisirs-et-sante-asbl","phone_contact":"02 546 15 70 \/ Fax : 02 546 14 32","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Rue des Moineaux, , 17-19 ","address_line2":"1000 Brussel","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":31674,"location":{"lat":50.84473122,"lon":4.34902334},"last_updated_at":"2021-08-21T04:20:28+02:00","published_at":"2018-07-19T08:52:36+02:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[],"dates":[{"day":"2023-09-16","doors":null,"start":"08:45:00","end":"09:45:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-09-23","doors":null,"start":"08:45:00","end":"09:45:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-09-30","doors":null,"start":"08:45:00","end":"09:45:00","end_n