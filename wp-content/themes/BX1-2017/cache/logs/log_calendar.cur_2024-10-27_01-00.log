":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-06T02:02:13+02:00","published_at":"2024-07-18T10:16:13+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":304260,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.25065445324781105,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"Guided tour of the Solvay Hotel","shortdescr":null,"longdescr":"In 1894, the Art Nouveau enthusiast and millionaire industrialist Armand Solvay commissioned Victor Horta to build him a huge mansion on the fashionable Avenue Louise. Having developed a friendship with Horta and a close understanding of his requirements and preferences, he gave the architect carte blanche and an unlimited budget. Horta did not disappoint his friend and channelled his design genius into what is considered by many to be his masterpiece. The fa\u00e7ade features two symmetrical, two-storey bay windows, topped with balconies. Inside, Horta used expensive materials to decorate an airy interior that could be adapted for entertaining and family life. Horta used 23 different types of marble and 17 varieties of wood in a decorative scheme dominated by red and orange tones that reinforced the luxurious atmosphere. The interior has been remarkably well-preserved and maintained and the building is a UNESCO World Heritage Site.\n\nThe H\u00f4tel Solvay gets a facelift! From 10 January, the front of the H\u00f4tel Solvay will be restored. Scaffolding will be present, but this will not prevent the beauty of the interior from shining through.\n\nChildren under 12 years of age are not allowed.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012638"},"pt":{"name":"Guided tour of the Solvay Hotel","shortdescr":null,"longdescr":"In 1894, the Art Nouveau enthusiast and millionaire industrialist Armand Solvay commissioned Victor Horta to build him a huge mansion on the fashionable Avenue Louise. Having developed a friendship with Horta and a close understanding of his requirements and preferences, he gave the architect carte blanche and an unlimited budget. Horta did not disappoint his friend and channelled his design genius into what is considered by many to be his masterpiece. The fa\u00e7ade features two symmetrical, two-storey bay windows, topped with balconies. Inside, Horta used expensive materials to decorate an airy interior that could be adapted for entertaining and family life. Horta used 23 different types of marble and 17 varieties of wood in a decorative scheme dominated by red and orange tones that reinforced the luxurious atmosphere. The interior has been remarkably well-preserved and maintained and the building is a UNESCO World Heritage Site.\n\nThe H\u00f4tel Solvay gets a facelift! From 10 January, the front of the H\u00f4tel Solvay will be restored. Scaffolding will be present, but this will not prevent the beauty of the interior from shining through.\n\nChildren under 12 years of age are not allowed.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012638"},"en":{"name":"Guided tour of the Solvay Hotel","shortdescr":null,"longdescr":"In 1894, the Art Nouveau enthusiast and millionaire industrialist Armand Solvay commissioned Victor Horta to build him a huge mansion on the fashionable Avenue Louise. Having developed a friendship with Horta and a close understanding of his requirements and preferences, he gave the architect carte blanche and an unlimited budget. Horta did not disappoint his friend and channelled his design genius into what is considered by many to be his masterpiece. The fa\u00e7ade features two symmetrical, two-storey bay windows, topped with balconies. Inside, Horta used expensive materials to decorate an airy interior that could be adapted for entertaining and family life. Horta used 23 different types of marble and 17 varieties of wood in a decorative scheme dominated by red and orange tones that reinforced the luxurious atmosphere. The interior has been remarkably well-preserved and maintained and the building is a UNESCO World Heritage Site.\n\nChildren under 12 years of age are not allowed.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012638"},"it":{"name":"Guided tour of the Solvay Hotel","shortdescr":null,"longdescr":"In 1894, the Art Nouveau enthusiast and millionaire industrialist Armand Solvay commissioned Victor Horta to build him a huge mansion on the fashionable Avenue Louise. Having developed a friendship with Horta and a close understanding of his requirements and preferences, he gave the architect carte blanche and an unlimited budget. Horta did not disappoint his friend and channelled his design genius into what is considered by many to be his masterpiece. The fa\u00e7ade features two symmetrical, two-storey bay windows, topped with balconies. Inside, Horta used expensive materials to decorate an airy interior that could be adapted for entertaining and family life. Horta used 23 different types of marble and 17 varieties of wood in a decorative scheme dominated by red and orange tones that reinforced the luxurious atmosphere. The interior has been remarkably well-preserved and maintained and the building is a UNESCO World Heritage Site.\n\nThe H\u00f4tel Solvay gets a facelift! From 10 January, the front of the H\u00f4tel Solvay will be restored. Scaffolding will be present, but this will not prevent the beauty of the interior from shining through.\n\nChildren under 12 years of age are not allowed.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012638"},"cn":{"name":"Guided tour of the Solvay Hotel","shortdescr":null,"longdescr":"In 1894, the Art Nouveau enthusiast and millionaire industrialist Armand Solvay commissioned Victor Horta to build him a huge mansion on the fashionable Avenue Louise. Having developed a friendship with Horta and a close understanding of his requirements and preferences, he gave the architect carte blanche and an unlimited budget. Horta did not disappoint his friend and channelled his design genius into what is considered by many to be his masterpiece. The fa\u00e7ade features two symmetrical, two-storey bay windows, topped with balconies. Inside, Horta used expensive materials to decorate an airy interior that could be adapted for entertaining and family life. Horta used 23 different types of marble and 17 varieties of wood in a decorative scheme dominated by red and orange tones that reinforced the luxurious atmosphere. The interior has been remarkably well-preserved and maintained and the building is a UNESCO World Heritage Site.\n\nThe H\u00f4tel Solvay gets a facelift! From 10 January, the front of the H\u00f4tel Solvay will be restored. Scaffolding will be present, but this will not prevent the beauty of the interior from shining through.\n\nChildren under 12 years of age are not allowed.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012638"},"fr":{"name":"Visite guid\u00e9e de l'H\u00f4tel Solvay","shortdescr":null,"longdescr":"De 1894 \u00e0 1898, Victor Horta construisit pour Armand Solvay, le fils du c\u00e9l\u00e8bre industriel Ernest Solvay, le plus prestigieux des h\u00f4tels de ma\u00eetre Art nouveau sur une avenue, \u00e0 l'\u00e9poque, grandiose. Il disposa pour cela d'un budget illimit\u00e9. Sur la fa\u00e7ade deux bow-windows sym\u00e9triques, s'\u00e9l\u00e8vent sur deux \u00e9tages et sont surmont\u00e9s de balcons. \u00c0 l'int\u00e9rieur c'est un v\u00e9ritable feu d'artifice visuel. Victor Horta a utilis\u00e9 des mat\u00e9riaux nobles et pr\u00e9cieux. La gamme des tons rouge-orange renforce encore l'atmosph\u00e8re de luxe et de confort. Inscrit sur la Liste du patrimoine mondial de l'UNESCO.\n\nPhotos interdites.\n\nEnfants -12 ans non admis.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012638"},"sp":{"name":"Guided tour of the Solvay Hotel","shortdescr":null,"longdescr":"In 1894, the Art Nouveau enthusiast and millionaire industrialist Armand Solvay commissioned Victor Horta to build him a huge mansion on the fashionable Avenue Louise. Having developed a friendship with Horta and a close understanding of his requirements and preferences, he gave the architect carte blanche and an unlimited budget. Horta did not disappoint his friend and channelled his design genius into what is considered by many to be his masterpiece. The fa\u00e7ade features two symmetrical, two-storey bay windows, topped with balconies. Inside, Horta used expensive materials to decorate an airy interior that could be adapted for entertaining and family life. Horta used 23 different types of marble and 17 varieties of wood in a decorative scheme dominated by red and orange tones that reinforced the luxurious atmosphere. The interior has been remarkably well-preserved and maintained and the building is a UNESCO World Heritage Site.\n\nThe H\u00f4tel Solvay gets a facelift! From 10 January, the front of the H\u00f4tel Solvay will be restored. Scaffolding will be present, but this will not prevent the beauty of the interior from shining through.\n\nChildren under 12 years of age are not allowed.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012638"},"nl":{"name":"Rondleiding van het Solvay Herenhuis","shortdescr":null,"longdescr":"In 1894 vertrouwde Armand Solvay, een vurige bewonderaar van de art nouveau, de bouw van zijn herenhuis op de prestigieuze Louizalaan toe aan Victor Horta. De architect kreeg carte blanche en een onbeperkt budget om Hotel Solvay uit de grond te stampen. Horta, die het prima kon vinden met de opdrachtgever, haalde al zijn talent uit de kast om van dit huis een van zijn meest grandioze pronkstukken te maken. Op de gevel rekken twee erkerramen, bekroond met balkons, zich uit over twee verdiepingen. Achter de voordeur gebruikt Horta edele materialen voor een open interieur dat functioneel is maar ook de gebruiken van die tijd volgt. Zo vermengt hij 23 soorten marmer en 17 verschillende houtsoorten in rode en oranje tinten, waarmee hij deze luxueuze sfeer nog extra versterkt. Dit verbluffend goed bewaard gebleven herenhuis prijkt op de werelderfgoedlijst van UNESCO.\n\nKinderen onder 12 jaar niet toegestaan","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012638"}},"place":{"id":261979,"translations":{"de":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architekt: Victor Horta - 1895\/1898\r\nDieses luxuri\u00f6se Anwesen wurde 1894 von Victor Horta f\u00fcr den Sohn des Unternehmers Ernest Solvay erbaut. Dem Architekten wurde vollkommen freie Hand gelassen und bei der bis ins kleinste Detail durchdachten Innenausstattung und dem Mobiliar \u00fcberlie\u00df er nichts dem Zufall. Die Fassade wird von zwei symmetrischen Erkern geziert, die sich \u00fcber zwei Etagen erstrecken. Dar\u00fcber befinden sich zwei Balkone. Im Interieur erwartet den Besucher ein optisches Feuerwerk. Die Farbpalette zwischen Rot- und Oranget\u00f6nen verst\u00e4rkt noch den Eindruck von Luxus und Komfort. Ein Besuch lohnt sich! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Solvay House","address_street_name":"Louizalaan","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Louizalaan, 224","address_line2":"1050 Ixelles","description_web":"Architect: Victor Horta - 1895\/1898 \r\nThis luxury townhouse was built by Victor Horta in 1894 for the son of captain of industry Ernest Solvay. The architect was given \u201ccarte blanche\u201d and designed the interior and the furniture down to the smallest detail. On the fa\u00e7ade, two symmetric bow windows surmounted by balconies are seen to protrude across two floors. Indoors it is a visual extravaganza, with the sheer range of red-orange hues on offer only acting to underpin the atmosphere of luxury and comfort. A must-see building. \r\n\r\nPlease note : Children under 12 years of age are not admitted to the guided tours.\r\n","description_print":null,"booking_url":"http:\/\/ticket.visit.brussels\/en\/261979\/solvay-house\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architetto Victor Horta \u2013 1895 \/ 1898 \r\nQuesta lussuosa villa \u00e9 stata costruita da Victor Horta nel 1894 per il figlio dell\u2019industriale Ernest Solvay. L\u2019architetto ha ricevuto totale libert\u00e0 e ha concepito l\u2019interno e i mobili nei minimi dettagli. Sulla facciata, due \u201cbow-window\u201d simetriche si elevano su due piani e sono superate da balconi. Al interno, \u00e9 un fuoco d'artificio visivo. La gamma dei toni rossi \u2013 arrancione rinforza l\u2019atmosfera di lusso e di conforto. Da vedere assolutamente. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architecte: Victor Horta - 1895\/1898\nCette demeure luxueuse fut construite par Victor Horta en 1894 pour le fils de l\u2019industriel Ernest Solvay. L\u2019architecte re\u00e7ut \u201ccarte blanche\u201d et con\u00e7ut l\u2019int\u00e9rieur et le mobilier jusque dans les moindres d\u00e9tails. Sur la fa\u00e7ade, deux bow-windows sym\u00e9triques s\u2019\u00e9l\u00e8vent sur deux \u00e9tages et sont surmont\u00e9s de balcons. A l\u2019int\u00e9rieur, c\u2019est un feu d\u2019artifices visuel. La gamme des tons rouge-orange renforce l\u2019atmosph\u00e8re de luxe et de confort. A voir absolument.\n\nAchat des tickets uniquement en ligne.\n\nVisite guid\u00e9e sur demande \u00e0 l'adresse  info@hotelsolvay.be\n\nAttention : Les enfants de moins de 12 ans ne sont pas admis aux visites guid\u00e9es.","description_print":null,"booking_url":"http:\/\/ticket.visit.brussels\/fr\/261979\/hotel-solvay\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Arquitecto: Victor Horta - 1895\/1898\r\nEsta lujosa mansi\u00f3n fue construida por Victor Horta en 1894 para el hijo del empresario Ernest Solvay. El arquitecto recibi\u00f3 carta blanca y concibi\u00f3 el interior y el mobiliario hasta el \u00faltimo detalle. En la fachada, dos miradores sim\u00e9tricos se elevan sobre los dos pisos y los balcones. El interior es una maravilla visual. La gama de los tonos rojo-naranja refuerza la atm\u00f3sfera de lujo y de confort. Una visita imprescindible.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Solvay Herenhuis","address_street_name":"Louizalaan","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Louizalaan, 224","address_line2":"1050 Elsene","description_web":"Architect: Victor Horta - 1895\/1898\r\nVictor Horta bouwde dit luxueuze herenhuis in 1894 voor de zoon van de industrieel Ernest Solvay. De architect kreeg carte blanche voor dit project. Hij ontwierp het interieur en het meubilair tot in de kleinste details. Op de gevel lopen twee symmetrische erkers over twee verdiepingen, met daarboven balkons. Binnen wacht een visueel vuurwerk. Het palet van rood- en oranjetinten zet de sfeer van luxe en comfort nog sterker in de verf. Een bezoek meer dan waard.\r\n\r\nBelangrijke opmerking : Kinderen jonger dan 12 jaar mogen niet deelnemen aan rondleidingen.\r\n","description_print":null,"booking_url":"http:\/\/ticket.visit.brussels\/nl\/261979\/solvay-herenhuis\/shop","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[6,5],"translations":{"de":["Chatelain\/Bailli","Flagey"],"pt":[null,null],"en":["Chatelain\/Bailli","Flagey"],"it":["Chatelain\/Bailli","Flagey"],"cn":[null,null],"fr":["Chatelain\/Bailli","Flagey"],"sp":["Ch\u00e2telain\/Bailli","Flagey"],"nl":["Kasteleinswijk\/Baljuw","Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":21979,"location":{"lat":50.8263727,"lon":4.3654832},"region":"brussels","last_updated_at":"2024-06-14T16:18:43+02:00","published_at":"2015-06-26T11:03:12+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":240214,"translations":{"de":{"name":"Explore.brussels","address_street_name":"Rue des Li\u00e9geois","address_street_number":"53","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue des Li\u00e9geois, 53","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels","address_street_name":"Rue des Li\u00e9geois","address_street_number":"53","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue des Li\u00e9geois, 53","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.Brussels","address_street_name":"Luikenaarsstraat","address_street_number":"53","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Luikenaarsstraat, 53","address_line2":"1050 Ixelles","description_web":"Explore.Brussels is a network of associations that organize top-quality guided tours in the Brussels-Capital Region. \n\nIts membre associations are ARAU, Pro Velo, Brussels Chatterguides and Arkadia. La Fonderie (in 2020) & Korei (in 2021) joined the network as a partner association.\n\nDiscover UNESCO\u2019s heritage, Art nouveau, Victoria Horta, Magritte, Herg\u00e9, Street art, Europe, beer, chocolate, or visit buildings built in Art Nouveau, Art Deco or neoclassical style that are usually closed for public visits. \n\nTours are available for individual visitors and groups, and organized in a classical, exceptional or completely new way. Besides walking tours, visits can be organized by bike, bus or boat.\n\nExplore.Brussels organizes the Brussels Art Nouveau & Art Deco (BANAD) Festival and Brussels Biennale \u2013 Neoclassic (BBN), Brussels Biennale of Eclectic Architecture (BBEA) as well as other projects such as the visits of Art Nouveau Mansions, the formation of tour guides, the owners club and the friends club. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels","address_street_name":"Rue des Li\u00e9geois","address_street_number":"53","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/