7":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T02:01:29+02:00","published_at":"2023-08-17T11:16:13+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283423,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.27909200099982406,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[255],"translations":{"de":["Besuche von Ausstellungen"],"pt":[null],"en":["Exhibition guided tours"],"it":["Visite a esposizioni"],"cn":[null],"fr":["Visites d'expositions"],"sp":["Visitas a las exposiciones"],"nl":["Tentoonstelling"]}}},"translations":{"de":{"name":"First Sunday of the month: Brussels City Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselscitymuseum.brussels\/fr\/evenement\/premier-dimanche-du-mois","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001030"},"pt":{"name":"First Sunday of the month: Brussels City Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselscitymuseum.brussels\/fr\/evenement\/premier-dimanche-du-mois","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001030"},"en":{"name":"First Sunday of the month: Brussels City Museum","shortdescr":"Every first Sunday of the month, the museum opens its doors for free.\n","longdescr":"Every first Sunday of the month, the museum opens its doors for free.\n\nWant to know more about a work, an event from the history of Brussels? To help you discover the collections, our guides are at your disposal in the museum\u2019s rooms. They will be happy to explain the works to you.\n\nPractical information:\n\nDates: 05.02, 05.03, 02.04, 07.05, 04.06, 02.07, 06.08, 03.09, 01.10, 05.11, 03.12\nThe museum will be closed on 01.01.23\nOn 03.12, the museum celebrates the International Day for People with Disabilities. On this occasion, the team will introduce you to the activities intended for the disabled public: visually impaired, hearing impaired, etc.\nFree admission and standing guidesFree admission and activities for all\nActivities from 1.30 pm to 5 pm\nBooking is not necessary to meet our guides. However, we recommend booking your visit for greater convenience.\nLast entry at 4.15 PM","performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselscitymuseum.brussels\/fr\/evenement\/premier-dimanche-du-mois","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001030"},"it":{"name":"First Sunday of the month: Brussels City Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselscitymuseum.brussels\/fr\/evenement\/premier-dimanche-du-mois","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001030"},"cn":{"name":"First Sunday of the month: Brussels City Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselscitymuseum.brussels\/fr\/evenement\/premier-dimanche-du-mois","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001030"},"fr":{"name":"Premier Dimanche du mois: Mus\u00e9e de la Ville de Bruxelles","shortdescr":"Le Mus\u00e9e vous ouvre gratuitement ses portes chaque premier dimanche du mois.\n","longdescr":"Le Mus\u00e9e vous ouvre gratuitement ses portes chaque premier dimanche du mois.\n\nEnvie d\u2019en savoir plus sur une \u0153uvre, un \u00e9v\u00e8nement de l\u2019histoire de Bruxelles ? Pour vous accompagner dans la d\u00e9couverte des collections, nos guides sont \u00e0 votre disposition dans les salles du mus\u00e9e.\n\nInformations pratiques:\n\nDates : 05.02, 05.03, 02.04, 07.05, 04.06, 02.07, 06.08, 03.09, 01.10, 05.11, 03.12\nLe mus\u00e9e est ferm\u00e9 le 01.01.23\nLe 03.12, le mus\u00e9e c\u00e9l\u00e8bre la Journ\u00e9e de la personne handicap\u00e9. A cette occasion, l\u2019\u00e9quipe vous fait d\u00e9couvrir les animations destin\u00e9es au public en situation de handicap : malvoyants, malentendants \u2026\nEntr\u00e9es et rencontres gratuites\nRencontres avec les guides : 13h30 > 16h30\nLa r\u00e9servation n\u2019est pas n\u00e9cessaire pour rencontrer nos guides. Nous vous conseillons cependant de r\u00e9server votre visite pour plus de confort.\nDerni\u00e8re entr\u00e9e \u00e0 16h15","performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselscitymuseum.brussels\/fr\/evenement\/premier-dimanche-du-mois","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001030"},"sp":{"name":"First Sunday of the month: Brussels City Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselscitymuseum.brussels\/fr\/evenement\/premier-dimanche-du-mois","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001030"},"nl":{"name":"Eerste zondag van de maand: Museum van de stad Brussel","shortdescr":"Elke eerste zondag van de maand opent het museum gratis zijn deuren.\n","longdescr":"Elke eerste zondag van de maand opent het museum gratis zijn deuren.\n\nWil je meer weten over een werk, een gebeurtenis uit de geschiedenis van Brussel? Om u te begeleiden bij het ontdekken van de collecties, staan onze gidsen tot uw beschikking in de zalen van het museum. Zij lichten u graag de werken toe.\n\nPraktische informatie:\n\nData: 05.02, 05.03, 02.04, 07.05, 04.06, 02.07, 06.08, 03.09, 01.10, 05.11, 03.12\nHet museum is gesloten op 01.01.23\nOp 03.12 viert het museum de Internationale Dag voor Mensen met een Beperking. Voor deze gelegenheid laat het team u kennismaken met de activiteiten die bestemd zijn voor het gehandicapte publiek: slechtzienden, slechthorenden, enz.\nGratis toegang en activiteiten voor iedereen\nActiviteiten van 13u30 tot 17u00.\nReserveren is niet nodig om onze gidsen te ontmoeten. Wij raden u echter aan uw bezoek te reserveren voor meer comfort.\nLaatste toegang om 16u15","performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselscitymuseum.brussels\/fr\/evenement\/premier-dimanche-du-mois","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001030"}},"place":{"id":242977,"translations":{"de":{"name":"Bruxella 1238 - Arch\u00e4ologisches Museum der Stadt Br\u00fcssel","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brucity.be","phone_contact":"+32 2 279 43 50","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":"Am Fu\u00dfe der Br\u00fcsseler B\u00f6rse verbirgt sich eine kleine, aber ganz erstaunliche arch\u00e4ologische St\u00e4tte, die auch f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich ist. Es handelt sich um die Ruinen des Franziskanerordens, der in Br\u00fcssel ab 1238 erbaut wurde. Hier befindet sich auch das Grab des Herzogs Johann I. von Brabant. Das Fundament und verschiedene andere \u00dcberreste geben einen faszinierenden Einblick in einen weniger bekannten Teil der Br\u00fcsseler Stadtgschichte.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Bruxella 1238 - Mus\u00e9e arch\u00e9ologique de la Ville de Bruxelles","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brucity.be","phone_contact":"+32 2 279 43 50","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Bruxella 1238 - Mus\u00e9e arch\u00e9ologique de la Ville de Bruxelles","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brucity.be","phone_contact":"+32 2 279 43 50","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":"Next to the stock exchange building, in the heart of Brussels, is a fascinating little archaeological site.  It contains the remains of the Franciscan monastery founded in Brussels in 1238 and the tomb of Duke John I of Brabant.  The foundations and various other objects offer a glimpse of an unknown side of the history of Brussels, and at the same time give a good idea of the different aspects of an archaeological dig.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Bruxella 1238 - Mus\u00e9e arch\u00e9ologique de la Ville de Bruxelles","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brucity.be","phone_contact":"+32 2 279 43 50","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Bruxella 1238 - Mus\u00e9e arch\u00e9ologique de la Ville de Bruxelles","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brucity.be","phone_contact":"+32 2 279 43 50","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Bruxella 1238 - Mus\u00e9e arch\u00e9ologique de la Ville de Bruxelles","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brucity.be","phone_contact":"+32 2 279 43 50","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":"Au pied de la Bourse, se cache un \u00e9tonnant petit site arch\u00e9ologique ouvert au public, au coeur de Bruxelles, celui-ci pr\u00e9sente les vestiges du Couvent de l'ordre franciscain \u00e9rig\u00e9 \u00e0 Bruxelles d\u00e8s 1238. On y trouve notamment le tombeau du Duc Jean Ier de Brabant. Les fondations et un mat\u00e9riel diversifi\u00e9 permettent de faire revivre un pan m\u00e9connu de l'histoire de Bruxelles, tout en laissant percevoir diff\u00e9rents aspects de la r\u00e9alit\u00e9 du m\u00e9tier d'arch\u00e9ologue.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Bruxella 1238 - Mus\u00e9e arch\u00e9ologique de la Ville de Bruxelles","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brucity.be","phone_contact":"+32 2 279 43 50","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Bruxella 1238 - Archeologisch museum van de Stad Brussel","address_street_name":"Beursstraat","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brucity.be","phone_contact":"+32 2 279 43 50","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Beursstraat","address_line2":"1000 Bruxelles","description_web":"Aan de voet van de Beurs verbergt er zich een fascinerende archeologische site in het centrum van Brussel die de bezoekers een kijk geeft op de resten van het franciscaans klooster dat in Brussel vanaf 1238 werd opgericht. We vinden er ondermeer het graf van Hertog Jan I van Brabant. De funderingen en allerlei ander materiaal laten ons toe om een ongekend stukje uit de geschiedenis van Brussel te laten herleven en ons tegelijkertijd een goed beeld te geven van de verschillende aspecten van het beroep van archeoloog.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":5373,"location":{"lat":50.84821022,"lon":4.35055323},"region":"brussels","last_updated_at":"2023-04-19T07:43:55+02:00","published_at":"2013-10-19T01:18:35+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231543,"translations":{"de":{"name":"Br\u00fcsseler Stadtmuseum - Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Das majest\u00e4tische Maison du Roi (dt. Haus des K\u00f6nigs), in dem sich das Br\u00fcsseler Stadtmuseum befindet, ist Teil des architektonischen Ensembles des ber\u00fchmten Grand-Place und z\u00e4hlt zum UNESCO-Weltkulturerbe.\r\n\r\nBei dem neogotischen Geb\u00e4ude, das im 19. Jahrhundert nach den Pl\u00e4nen des Architekten Pierre-Victor Jamaer fertiggestellt wurde, handelt es sich um eine Nachbildung eines Bauwerks im sp\u00e4tgotischen Stil des 16. Jahrhunderts. \r\n\r\nDas hier untergebrachte Br\u00fcsseler Stadtmuseum birgt Ausstellungen und Sammlungen zur Geschichte der Stadt Br\u00fcssel, Stadtentwicklung, Arch\u00e4ologie, Kunst und Stadtleben etc. Auch die Br\u00fcsseler Folklore wird beleuchtet. So ist der Garderobe von Manneken Pis ein eigener Saal gewidmet. Seit Februar 2017 hat sie sogar ein eigenes Museum: GardeRobe MannekenPis an der Rue du Ch\u00eane 19, gleich neben der ber\u00fchmten Brunnenfigur.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la Ville de Bruxelles - Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedelavilledebruxelles.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of the City of Brussels","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Two majestic buildings that stand opposite each other on Brussels' Grand Place have a long-standing rivalry: on one side you have Brussels' City Hall, and on the other the Broodhuis (Bread House), a UNESCO World Heritage Site which houses the Brussels City Museum. The rivalry between these two buildings is no coincidence. In the 15th century, the Duke of Brabant replaced the 13th century wooden bread market building with a prestigious building that would be a symbol of his power and face off against the imposing building on the other side of the Grand Place that symbolised the city's independence. The building owes its French name of Maison du Roi (King's House) to Charles V, Holy Roman Emperor, who once ruled over a large part of the globe and once owned the Bread House. After being destroyed in the 16th century, it was rebuilt in the Gothic Revival style in the 19th century by city architect Victor Jamaer.\r\nBut it's not all about the Broodhuis' history and facade. Inside the Brussels City Museum gives a comprehensive overview of Brussels' history, with particular attention given to the arts, crafts,urbanism and architecture . The original Manneken Pis is also housed here for security reasons, but as for his wardrobe, which is a thousand times larger than even the most passionate fashionista's, you can marvel at that in its dedicated museum on Rue du Ch\u00eane - Eikstraat. \r\n\r\nCombined ticket giving access to  the Brussels City Museum -Maison du Roi and the Garderobe MannekenPis.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"MUSEO DELLA CITTA' DI BRUXELLES - CASA DEL RE","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Ricostituzione del XIX secolo dell'edificio costruito durante il regno di Carlo V all'inizio del XVI secolo....\r\n\r\n\"Ricostituzione del XIX secolo dell'edificio costruito durante il regno di Carlo V all'inizio del XVI secolo.\r\nMonumento classificato come stile gotico fiammeggiante .\r\nArti plastiche e decorative di Bruxelles: pittura, pale, arazzi, sculture, porcellana, ceramica, argenteria, stagno.\r\nSviluppo urbanistico: mappe, plastici, evocazione dei problemi di comunicazione, delle zone verdi, del porto di Bruxelles, i principali monumenti, le grandi creazioni urbanistiche.\r\nStoria di Bruxelles; le istituzioni politiche locali, il ruolo di Bruxelles quale capitale, la storia economica, sociale, religiosa, culturale ed il folclore (tra cui il guardaroba del Manneken-Pis).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la Ville de Bruxelles - Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedelavilledebruxelles.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9e de la Ville de Bruxelles \/ Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedelavilledebruxelles.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Faisant face \u00e0 l\u2019H\u00f4tel de Ville gothique, ce magnifique \u00e9difice, b\u00e2ti \u00e0 la fin du 19e si\u00e8cle, profite de la d\u00e9molition de son anc\u00eatre du 16e si\u00e8cle, qui tombe en ruine, pour le remplacer sous la forme d\u2019une reconstitution n\u00e9ogothique, men\u00e9e par l\u2019architecte de la Ville Victor Jamaer. Le souci de perfection dans la reconstitution finira par engendrer un b\u00e2timent id\u00e9alis\u00e9\u2026\r\nL\u2019appellation de l\u2019\u00e9difice appelle quelques explications et contraint \u00e0 un voyage dans le pass\u00e9. D\u00e8s le 13e si\u00e8cle, le site est occup\u00e9 par une halle au pain, construite en bois \u2014 Broodhuis en n\u00e9erlandais, appellation toujours en vigueur dans la langue de Vondel. Le duc de Brabant, propri\u00e9taire des lieux, d\u00e9cide au 15e si\u00e8cle de remplacer cette halle par un \u00e9difice prestigieux, mani\u00e8re pour lui de rappeler son pouvoir en \u00e9rigeant le b\u00e2timent en vis-\u00e0-vis de l\u2019H\u00f4tel de Ville, symbole pour sa part de l\u2019autonomie communale. La d\u00e9signation de \u00ab Maison du Roi \u00bb date du r\u00e8gne de Charles-Quint, \u00e0 la t\u00eate de plusieurs royaumes. Au m\u00eame titre que l\u2019ensemble de la Grand-Place, la Maison du Roi est inscrite au patrimoine mondial de l\u2019UNESCO depuis 2000.\r\nClass\u00e9e dans son enti\u00e8ret\u00e9 en 1936, la Maison du Roi est, depuis 2000, inscrite au patrimoine mondial de l\u2019UNESCO avec l\u2019ensemble de la Grand-Place.\r\nOuvert \u00e0 la fin du 19e si\u00e8cle, le mus\u00e9e de la Ville balaye la longue histoire bruxelloise, en insistant particuli\u00e8rement sur les sph\u00e8res de l\u2019art, de l\u2019artisanat,de l\u2019urbanisme et de l\u2019architecture  . \u00c0 ce dernier titre, une salle enti\u00e8re est d\u00e9di\u00e9e \u00e0 l\u2019histoire de la r\u00e9put\u00e9e statuette du Manneken-Pis, et pr\u00e9sente la statue originale du 17e si\u00e8cle. \u00c0 quelques pas de l\u00e0, vous d\u00e9couvrirez la GardeRobe MannekenPis, une s\u00e9lection de quelques-uns des costumes du ketje, qui en poss\u00e8de pr\u00e8s de 1000 !\r\n\r\nBillet combin\u00e9 donnant acc\u00e8s au Mus\u00e9e de la Ville de Bruxelles - Maison du Roi et \u00e0 la GardeRobe MannekenPis.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa del Rey - Museo de la Ciudad de Bruselas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"El Museo de la Ciudad de Bruselas es uno de los tres Premios de los Museos 2014. Ven a visitarlo y descubre por qu\u00e9.\u00a0...\r\n\r\nEl Museo de la Ciudad de Bruselas es uno de los tres Premios de los Museos 2014. Ven a visitarlo y descubre por qu\u00e9.\r\n\r\nUbicado en pleno centro hist\u00f3rico de la ciudad, en la Grand-Place, el Museo de la Ciudad de Bruselas se ha consagrado a la historia y a las artes de la ciudad.\u00a0\r\n\r\nLa versi\u00f3n original del m\u00e1s conocido de los bruselenses, el  Manneken-Pis y su armario, se han conservado magn\u00edficamente en este edificio neog\u00f3tico, declarado Patrimonio Mundial de la Unesco, junto con la Grand-Place.\u00a0\r\nSus colecciones presentan los or\u00edgenes de Bruselas, su desarrollo a lo largo de los siglos y la vida de sus habitantes.\r\nDurante tu visita, podr\u00e1s descubrir objetos arqueol\u00f3gicos, porcelanas, retablos y tapicer\u00edas, grabados, esculturas, pinturas y maquetas de la ciudad.\u00a0\r\n\r\nTe permitir\u00e1n comprender mejor la evoluci\u00f3n de esta capital \u00fanica. En la gran sala de la \u00faltima planta, el museo organiza exposiciones temporales y desvela el fabuloso guardarrop\u00eda de  Manneken-Pis, un tesoro que no te puedes perder.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van de Stad Brussel \/ Broodhuis","address_street_name":"Grote Markt","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museumvandestadbrussel.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grote Markt","address_line2":"1000 Bruxelles","description_web":"Op de Grote Markt van Brussel steken twee majestueuze gebouwen elkaar de loef af. Aan de ene kant het Stadhuis van Brussel, er recht tegenover het Broodhuis, UNESCO-werelderfgoed waar het Museum van de Stad Brussel gevestigd is. De rivaliteit tussen de twee gebouwen is geen toeval: de hertog van Brabant verving de 13de eeuwse houten broodhallen \u2013 vandaar de naam Broodhuis - er in de 15de eeuw door een prestigieus gebouw, dat zijn macht in de verf moest zetten en zo tegengewicht moest bieden aan het imposante gebouw aan de overkant, symbool van de stedelijke onafhankelijkheid. De Franse benaming Maison du Roi heeft het gebouw te danken aan Karel V, ooit heerser over een groot deel van de wereld en ook ooit nog eigenaar van het Broodhuis. In de 16de eeuw vernield, werd het op het einde van de 19de eeuw in neogotische stijl heropgebouwd door stadsarchitect Victor Jamaer. \r\nNiet alleen de geschiedenis en de buitenkant van het Broodhuis is de moeite waard. Binnenin geeft het Museum van de Stad Brussel een rijk gestoffeerd overzicht van de geschiedenis van Brussel, met veel aandacht voor kunst, ambachten, stedenbouw en architectuur. Het oorspronkelijke beeldje van Manneken Pis is hier om veiligheidsoverwegingen ook ondergebracht, maar zijn garderobe \u2013 met bijna 1.000 outfits groter dan die van welke fashionista ook \u2013 moet bewonderd worden in het speciaal daarvoor ingerichte museum in de Eikstraat. Veel dichter bij het blote ventje dus.\r\n\r\nEen combiticket geeft toegang tot het Museum van de Stad Brussel-Broodhuis en de Garderobe MannekenPis.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":958,"location":{"lat":50.8466937,"lon":4.35252339},"last_updated_at":"2022-11-04T11:47:09+01:00","published_at":"2013-10-19T01:13:56+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/e4e4c9665734ada881fd092cbaa20f8da46bfc0d.jpg","width":5333,"height":3000,"ratio":1,"oEmbed_height":3000,"oEmbed_width":5333,"translations":{"de":{"title":"First Sunday of the month","copyright":null},"pt":{"title":"First Sunday of the month","copyright":null},"en":{"title":"First Sunday of the month","copyright":null},"it":{"title":"First Sunday of the month","copyright":null},"cn":{"title":"First Sunday of the month","copyright":null},"fr":{"title":"First Sunday of the month","copyright":null},"sp":{"title":"First Sunday of the month","copyright":null},"nl":{"title":"First Sunday of the month","copyright":null}}}],"dates":[{"day":"2023-09-03","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-10-01","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-05","doors":null,"start":"10:00:00","end":"17: