right":null},"en":{"title":"La course des g\u00e9ants","copyright":null},"de":{"title":"La course des g\u00e9ants","copyright":null},"it":{"title":"La course des g\u00e9ants","copyright":null},"sp":{"title":"La course des g\u00e9ants","copyright":null},"pt":{"title":"La course des g\u00e9ants","copyright":null},"cn":{"title":"La course des g\u00e9ants","copyright":null}}}],"dates":[{"day":"2023-01-27","doors":null,"start":"20:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normal"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":35},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"},"de":{"name":"Jugendliche"},"it":{"name":"Jeunes"},"sp":{"name":"Jeunes"},"pt":{"name":"Jeunes"},"cn":{"name":"Jeunes"}},"value":11}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[257],"translations":{"fr":["Am\u00e9nagements pour personnes sourdes et malentendantes"],"nl":["Voorzieningen voor dove en slechthorende personen"],"en":["Facilities for deaf and hearing-impaired people"],"de":["Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen."],"it":[null],"sp":[null],"pt":[null],"cn":[null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:51:38+01:00","published_at":"2022-06-28T11:40:15+02:00","backoffice_id":257172,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":540375,"date_start":"2023-01-27","date_end":"2023-01-28","date_next":"2023-01-27","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La Musica Deuxi\u00e8me","shortdescr":null,"longdescr":"Une femme et un homme se sont aim\u00e9s passionn\u00e9ment. Ils ne s\u2019aiment aujourd\u2019hui plus. \u00c0 la veille de leur divorce, ils cherchent \u00e0 (se) comprendre et se livrent \u00e0 l\u2019autopsie de leur histoire d\u2019amour. Un texte de Marguerite Duras port\u00e9 par un duo hors pair, dans une mise en sc\u00e8ne d\u2019une justesse vertigineuse. Le temps, ses affres et ses tentations ont suivi leurs pas, jusqu\u2019\u00e0 les perdre et les faire choir. Elle, Anne-Marie, a voulu le suicide, lui, Michel, le meurtre. Puis, ils se sont s\u00e9par\u00e9s. C\u2019\u00e9tait avant-hier. C\u2019\u00e9tait hier. Aujourd\u2019hui les a r\u00e9unis de nouveau, au tribunal (au th\u00e9\u00e2tre) pour entendre leur divorce prononc\u00e9. Une derni\u00e8re fois, dans la nuit, avant de regagner leurs \u00ab autres \u00bb respectifs, ils vont chercher \u00e0 se parler, tenter de comprendre l\u2019\u00e9nigme qui les a amen\u00e9s \u00e0 la perte, au d\u00e9sastre de l\u2019autre.\r\n\r\nCris et chuchotements, sourires forc\u00e9s et fous rires subits, sanglots \u00e9touff\u00e9s, d\u00e9sir de comprendre et refus de savoir, haine et sottise, mots arrach\u00e9s au silence pour faire taire le silence, pour retarder l\u2019ultime moment du d\u00e9part o\u00f9 plus rien, jamais, ne pourra \u00eatre dit.\r\n\r\nTexte Marguerite Duras\r\n\r\nMise en sc\u00e8ne Guillemette Laurent\r\n\r\nAvec Catherine Sal\u00e9e et Yoann Blanc\r\n\r\nSc\u00e9nographie et costumes Christine Gr\u00e9goire et Nicolas Mouzet-Tagawa\r\n\r\nCr\u00e9ation lumi\u00e8re Julie Petit-Etienne\r\n\r\nR\u00e9gie (en alternance) Nicolas Sanchez \/ Michel Delvigne\r\n\r\nD\u00e9veloppement et diffusion BLOOM Project\r\n\r\nPhotographie Michel Boermans\r\n\r\nHoraires\r\n\r\nVendredi 27 janvier - 20.00\r\n\r\nSamedi 28 janvier - 18.00\r\n\r\nInformations\r\n\r\nDur\u00e9e : 1h15\r\n\r\nA partir de 16 ans\r\n\r\nTarifs\r\n\r\nPrix libres et solidaires \u00e0 partir de 3,5 euros. Nous acceptons aussi les Art.27.\r\n\r\nOptez pour une \u00ab impression \u00e0 domicile \u00bb ou t\u00e9l\u00e9chargez votre e-ticket sur votre Smartphone : vous \u00e9viterez les files gr\u00e2ce \u00e0 votre QR Code.\r\n\r\nPartenaires\r\n\r\nProduction Le Colonel Astral et le Th\u00e9\u00e2tre Oc\u00e9an Nord\r\n\r\nUn accueil en cr\u00e9ation au Th\u00e9\u00e2tre Oc\u00e9an Nord\r\n\r\nAvec le soutien de Bloom Project et l\u2019aide \u00e0 la reprise de la F\u00e9d\u00e9ration Wallonie- Bruxelles- Service du th\u00e9\u00e2tre CAPT","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejacquesfranck.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540375"},"nl":{"name":"La Musica Deuxi\u00e8me","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540375"},"en":{"name":"La Musica Deuxi\u00e8me","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540375"},"de":{"name":"La Musica Deuxi\u00e8me","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail