ories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"l'ermite ornemental | Patrick CORILLON","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/lermite-ornemental\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012032"},"pt":{"name":"l'ermite ornemental | Patrick CORILLON","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/lermite-ornemental\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012032"},"en":{"name":"L'ermite ornemental","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/lermite-ornemental\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012032"},"it":{"name":"l'ermite ornemental | Patrick CORILLON","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/lermite-ornemental\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012032"},"cn":{"name":"l'ermite ornemental | Patrick CORILLON","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/lermite-ornemental\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012032"},"fr":{"name":"L'ermite ornemental","shortdescr":null,"longdescr":"les vies en soi - volet 3\n\n60 minutes pour ne rien dire\n\nApr\u00e8s avoir d\u00e9couvert une exposition de sculptures de Richard Serra, le narrateur est tellement touch\u00e9 par la puret\u00e9 de ce qu\u2019il vient de voir que, pour rester sous le charme, il d\u00e9cide de ne plus parler jusqu\u2019\u00e0 ce que le souvenir des \u0153uvres s\u2019estompe en lui. Mais l\u2019envo\u00fbtement dure beaucoup plus longtemps que pr\u00e9vu et, pour pouvoir mener une vie \u00e9conomiquement et socialement acceptable tout en ne pronon\u00e7ant plus le moindre mot, il se voit contraint de proposer ses services comme ermite ornemental dans un parc. Commence alors pour le narrateur une s\u00e9rie d\u2019aventures qui ne pourront que l\u2019amener \u00e0 tourner en rond, mais en produisant \u00e0 chaque fois des cercles un peu plus larges, jusqu\u2019\u00e0 l\u2019entra\u00eener autour du monde \u2026\n\nProfitez de tarifs attractifs en combinant l\u2019achat de plusieurs volets des Vies en soi gra\u0302ce au Combo 3, 5 ou 7 !\n\nCOMBO 3 : Plein tarif 54 \u20ac | + 65 ans 45 \u20ac | \u2013 30 ans 33 \u20ac\n\nCOMBO 5 : Plein tarif 80 \u20ac | + 65 ans 65 \u20ac | \u2013 30 ans 50 \u20ac \n\nCOMBO 7 : Plein tarif 100 \u20ac | + 65 ans 80 \u20ac | \u2013 30 ans 65 \u20ac","performers":"\u00e9criture, sc\u00e9nographie et jeu Patrick Corillon\ncollaboration artistique Dominique Roodthooft\nassistance graphique et sc\u00e9nographique R\u00fcdiger Fl\u00f6rke, Ioannis Katikakis, Raoul Lhermitte, Caroline Ronceret\n\nproduction le corridor (Li\u00e8ge)\nAvec le soutien de la F\u00e9d\u00e9ration Wallonie-Bruxelles\/Service du Th\u00e9\u00e2tre et de la Wallonie\/Emploi","boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/lermite-ornemental\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012032"},"sp":{"name":"l'ermite ornemental | Patrick CORILLON","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/lermite-ornemental\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012032"},"nl":{"name":"L'ermite ornemental","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/lermite-ornemental\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012032"}},"place":{"id":231711,"translations":{"de":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22"