s_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo est une association de guides b\u00e9n\u00e9voles locaux ayant \u00e0 c\u0153ur Bruxelles et le v\u00e9lo. Ils partagent avec enthousiasme leur passion pour la ville et le v\u00e9lo avec des visiteurs de Bruxelles et d\u2019autres Bruxellois. A v\u00e9lo ils trouvent le rythme id\u00e9al pour vous immerger dans la ville et ils offrent une exp\u00e9rience authentique \u00e0 Bruxelles. Avant tout, ils pr\u00e9f\u00e8rent vous guider hors des chemins battus et cela dans une ambiance conviviale. Vivez Bruxelles dans toute sa splendeur \u00e0 v\u00e9lo et d\u00e9cou