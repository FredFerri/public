: from 14:00 to 18:00"],"cn":["monday, tuesday and sunday: closed","wednesday, thursday, friday and saturday: from 14:00 to 18:00"]},"date_start":"2023-04-13","date_end":"2023-06-10","is_also_by_appointment":true}],"date_exceptions":[{"day":"2023-04-13","start":"17:00:00","end":"21:00:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-04-13","start":"17:00:00","timestamp":"2023-04-13T17:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[255,259,261,263],"translations":{"fr":["Accessible","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei","Assistenzhund","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile","Cane guida","Parcheggio accessibile","Accessibile ai pedoni con supporti"],"sp":["Habilitado","Perros gu\u00eda","Estacionamiento habilitado","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-23T03:06:52+02:00","published_at":"2023-04-19T16:39:46+02:00","backoffice_id":275748,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25687154396614},{"id":542867,"date_start":"2023-03-09","date_end":"2024-01-14","date_next":"2023-04-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,40],"translations":{"fr":["Mus\u00e9es et art centers","Arts graphiques"],"nl":["Musea en kunstcentra","Grafische kunst, vormgeving"],"en":["Museums and art centers","Graphic art"],"de":["Museen & Kunstzentren","Grafische K\u00fcnste"],"it":["Musei e centri artistici","Arti grafiche"],"sp":["Museos y centros de arte","Artes gr\u00e1ficas"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Privat Livemont. Fleurs \u00e0 l'affiche !","shortdescr":"La Maison Autrique pr\u00e9sente l'\u0153uvre et la vie de Privat Livemont, artiste bruxellois embl\u00e9matique de l\u2019Art nouveau.","longdescr":"De mars 2023 \u00e0 janvier 2024, la Maison Autrique pr\u00e9sente l'\u0153uvre et la vie de Privat Livemont, artiste bruxellois embl\u00e9matique de l\u2019Art nouveau. Artiste complet et polyvalent, artisan, enseignant \u00e0 l\u2019Acad\u00e9mie de dessin et d\u2019industrie de Schaerbeek... Livemont semble avoir \u00e9t\u00e9 un travailleur infatigable. Il est surtout reconnu pour ses affiches et les sgraffites pr\u00e9sents sur de nombreuses fa\u00e7ades \u00e0 Bruxelles.\r\nLa finesse de son trait, son go\u00fbt pour les \u00e9l\u00e9ments d\u00e9coratifs v\u00e9g\u00e9taux et leur stylisation, son imagination fertile et sa palette color\u00e9e font de Privat Livemont une figure importante que la Maison Autrique choisit de mettre \u00e0 l\u2019honneur en 2023, ann\u00e9e de l'Art nouveau.\r\n\r\nRetrouvez le programme du cycle de conversations et conf\u00e9rences autour de l\u2019\u0153uvre et l\u2019\u00e9poque de Livemont sur autrique.be.\r\n\r\nAvec la complicit\u00e9 de la Galerie Le Tout Venant, ARCHistory et la Commune de Schaerbeek\r\nEn collaboration avec le Mus\u00e9e d\u2019Ixelles, les Archives de la Ville de Bruxelles, la KBR, l\u2019H\u00f4tel Solvay, la Maison Cauchie et Jonathan Mangelinckx\r\nAvec le soutien d'urban.brussels, la Loterie Nationale, la F\u00e9d\u00e9ration Wallonie-Bruxelles, la R\u00e9gion de Bruxelles-Capitale, la Vlaamse Gemeenschapscommissie et A Step Forward","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542867"},"nl":{"name":"Privat Livemont. Bloemenpracht!","shortdescr":"Het Autrique Huis presenteert het werk en leven van Privat Livemont, een emblematische Brusselse art-nouveaukunstenaar.","longdescr":"Van maart 2023 tot januari 2024 presenteert het Autrique Huis het werk en leven van Privat Livemont, een emblematische Brusselse art-nouveaukunstenaar. Veelzijdige artiest, ambachtslied, leerkracht aan de Nijverheidsschool\u2026 Livemont lijkt een onvermoeibare werker te zijn geweest. Hij is vooral bekend om zijn affiches en de sgraffiti op vele voorgevels in Brussel.\r\nDe finesse van zijn lijn, zijn smaak voor decoratieve plantenelementen en hun stilering, zijn vruchtbare verbeelding en zijn kleurrijke palet maken van Privat Livemont een belangrijke figuur die het Autrique Huis in 2023, het jaar van de art nouveau, in de kijker wil zetten.\r\n\r\nOntdek het programma van de gesprekken en lezingen rond het oeuvre en de tijd van Livemont op autrique.be.\r\n\r\nMet hulp van de Galerie Le Tout Venant, ARCHistory en de Gemeente Schaarbeek\r\nIn samenwerking met het Museum van Elsene, het Archief van de Stad Brussel, KBR, H\u00f4tel Solvay, Cauchiehuis en Jonathan Mangelinckx\r\nMet steun van urban.brussels, de Nationale Loterij, F\u00e9d\u00e9ration Wallonie-Bruxelles, Brussel Hoofdstedelijk Gewest, de Vlaamse Gemeenschapscommissie en A Step Forward","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542867"},"en":{"name":"Privat Livemont. Fleurs \u00e0 l'affiche! Bloemenpracht!","shortdescr":"The Autrique House presents the work and life of Privat Livemont, an emblematic Art Nouveau artist from Brussels.","longdescr":"From March 2023 to January 2024, the Autrique House presents the work and life of Privat Livemont, an emblematic Art Nouveau artist from Brussels. Working as a versatile artist, a craftsman, and a teacher at the Industrial Academy in Schaerbeek, Livemont seems to have been a tireless worker. He is best known for his posters and the sgraffiti on many facades in Brussels.\r\nThe delicacy of his line, his taste for decorative plant elements and their stylisation, his fertile imagination and his colourful palette make Privat Livemont an important figure that Maison Autrique has chosen to honour in 2023, the year of Art Nouveau.\r\n\r\nDiscover the programme of our discussions and lectures on the work and era of Livemont on autrique.be.\r\n\r\nWith the complicity of Galerie Le Tout Venant, ARCHistory & Commune de Schaerbeek\/Gemeente Schaarbeek\r\nIn collaboration with Mus\u00e9e d\u2019Ixelles\/Museum van Elsene, Archives de la Ville de Bruxelles\/Archief van de Stad Brussel, KBR, H\u00f4tel Solvay, Cauchie House & Jonathan Mangelinckx\r\nWith the support of urban.brussels, Loterie Nationale\/Nationale Loterij, Brussels Capital Region, Vlaamse Gemeenschapscommissie, F\u00e9d\u00e9ration Wallonie-Bruxelles & A Step Forward","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542867"},"de":{"name":"Privat Livemont. Fleurs \u00e0 l'affiche ! Bloemenpracht!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542867"},"it":{"name":"Privat Livemont et le r\u00e8gne du v\u00e9g\u00e9tal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542867"},"sp":{"name":"Privat Livemont et le r\u00e8gne du v\u00e9g\u00e9tal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542867"},"pt":{"name":"Privat Livemont et le r\u00e8gne du v\u00e9g\u00e9tal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542867"},"cn":{"name":"Privat Livemont et le r\u00e8gne du v\u00e9g\u00e9tal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542867"}},"place":{"id":241931,"translations":{"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaarbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Autrique House","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact"