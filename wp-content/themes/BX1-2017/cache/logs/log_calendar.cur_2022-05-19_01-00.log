{"title":"Faire du kayak pour un canal plus propre","copyright":null},"nl":{"title":"Faire du kayak pour un canal plus propre","copyright":null},"en":{"title":"Faire du kayak pour un canal plus propre","copyright":null}}}],"dates":[],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":false},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"]},"date_start":"2020-10-01","date_end":"2022-12-21","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[527588],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-03-11T15:05:04+01:00","published_at":"2020-10-19T09:02:15+02:00","backoffice_id":225907,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.10718844985353},{"id":523499,"date_start":"2021-11-25","date_end":"2025-12-31","date_next":"2025-12-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Nourrir Bruxelles, entre ville et campagne","shortdescr":"D\u00e9couvrez la nature et l\u2019alimentation durable \u00e0 Neerpede (Anderlecht) \u00e0 travers une chasse aux tr\u00e9sors, guid\u00e9 par votre smartphone.","longdescr":"Connaissez-vous la zone de Neerpede \u00e0 Anderlecht ? Un territoire qui regorge de richesses naturelles ! Cette zone est cl\u00e9 pour l\u2019\u00e9quilibre de la ville, gr\u00e2ce \u00e0 ses milieux aquatiques, ses zones bois\u00e9es, ses champs et sa biodiversit\u00e9 mais aussi pour \u201cnourrir Bruxelles\u201d.\r\n\r\nCe n\u2019est pas pour rien qu\u2019on voit \u00e9merger ici de nouvelles initiatives de jeunes urbains qui se lancent dans l\u2019agriculture agro\u00e9cologique pleine terre. D\u00e9couvrez ce territoire, sa biodiversit\u00e9, ses projets & enjeux et l\u2019importance d\u2019un bon \u00e9quilibre entre agriculture et nature.\r\n\r\nCOMMENT JOUER ?\r\nLa chasse est 100% gratuite !\r\n\r\nPour participer, t\u00e9l\u00e9chargez l\u2019application TOTEMUS sur votre smartphone, cherchez la balade \u00e0 Neerpede \u00ab Nourrir Bruxelles, entre ville et campagne \u00bb et amusez-vous !","performers":null,"boxoffice_url":null,"website":"https:\/\/totemus.be\/les-chasses\/77-bruxelles-neerpede-nourrir-bruxelles-entre-ville-et-campagne","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/523499.html"},"nl":{"name":"Brusselse kost, tussen stad en platteland","shortdescr":"Ontdek de natuur en de duurzame voeding in Neerpede (het Pajottenland van Anderlecht) tijdens een schattenjacht, begeleid door je smartphone.","longdescr":"Ken je Neerpede in Anderlecht? Het is een plek met heel wat wondermooie natuur! Deze zone speelt een belangrijke rol in het natuurlijke evenwicht van Brussel, door de watergebieden, de bosjes, de velden en de biodiversiteit, maar ook als voedsel voor Brussel.\r\n\r\nNiet voor niets ontstaan hier allerlei nieuwe initiatieven van jonge stadsmensen, die gaan voor agro-ecologische landbouw in volle grond. Ontdek deze zone, zijn biodiversiteit, zijn projecten en uitdagingen, en het belang van een goed evenwicht tussen landbouw en natuur.\r\n\r\nHOE GA JE OP SCHATTENJACHT?\r\nDe jacht is 100% gratis !\r\n\r\nOm mee te doen installeer je de de TOTEMUS-app op je smartphone en je zoekt de de wandeling in Neerpede \u201cBrusselse kost, tussen stad en platteland.\u201d Veel plezier!","performers":null,"boxoffice_url":null,"website":null,"email":"info@mvb.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/523499.html"},"en":{"name":"Feeding Brussels, between city and countryside","shortdescr":"Discover nature and sustainable agriculture in Neerpede (Anderlecht), through a treasure hunt, guided by your smartphone.","longdescr":"Do you know the Neerpede area in Anderlecht? An area full of natural resources! This area is essential for the balance of the city, thanks to its aquatic environments, its wooded areas, its fields and its biodiversity, but also for \"feeding  Brussels\". It is not for nothing that new initiatives by young urbanites, who are embarking on agro-ecological farming, are emerging here.\r\nDiscover this territory, its biodiversity, its projects & challenges and the importance of a good balance between agriculture and nature.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/523499.html"},"de":{"name":"Brusselse kost, tussen stad en platteland","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/523499.html"},"it":{"name":"Brusselse kost, tussen stad en platteland","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/523499.html"},"sp":{"name":"Brusselse kost,