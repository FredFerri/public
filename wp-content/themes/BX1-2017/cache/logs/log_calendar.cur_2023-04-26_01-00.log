ull,null,null,null,null,null,null,null],"cn":[null,null,null,null,null,null,null,null,null,null,null]}},"opening":{"day":"2023-04-27","start":"18:30:00","timestamp":"2023-04-27T18:30:00+02:00","end":"21:00:00","is_only_by_appointment":true},"tags":["kids","annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":{"list":[252,255,259,263,265,266],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC","Brussels Health Safety Label"],"it":["Accessibile alle persone con difficolt\u00e0 di comprensione","Accessibile","Cane guida","Accessibile ai pedoni con supporti","WC idoneo","Brussels Health Safety Label"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n","Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados","Brussels Health Safety Label"],"pt":[null,null,null,null,null,null],"cn":[null,null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-25T02:37:34+02:00","published_at":"2023-04-17T13:28:43+02:00","backoffice_id":275508,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32737967507804},{"id":551274,"date_start":"2023-03-09","date_end":"2023-05-06","date_next":"2023-04-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"],"it":["Gallerie d'arte","Multidisciplinare"],"sp":["Galer\u00edas de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":"Nous sommes ravies d\u2019annoncer Ecologies intimes, une exposition qui rassemble trois artistes femmes li\u00e9es par une amiti\u00e9 commune et des pratiques compl\u00e9mentaires : Tatiana Wolska, Dorota Buczkowska et Sandra Lecoq.","longdescr":"\u00ab Une bouteille en plastique, un drap jauni par le temps, une feuille de papier, une chute de carton, de bois, un ve\u0302tement de\u0301chire\u0301, les mate\u0301riaux qui fondent les pratiques artistiques de Tatiana Wolska (1977), Dorota Buczkowska (1971) et Sandra Lecoq (1972) appartiennent au quotidien. Les trois artistes s\u2019emploient a\u0300 transformer et a\u0300 sublimer le presque rien, la matie\u0300re invisible, voire inde\u0301sirable. Une e\u0301conomie de moyen est mise au service de re\u0301flexions plastiques, poe\u0301tiques et politiques ou\u0300 le territoire de l\u2019intime est explore\u0301 couche par couche, point par point, motif par motif. L\u2019intime est traduit visuellement au moyen de formes sensuelles et organiques, des corps enlace\u0301s, de superpositions, de profondeurs, de matie\u0300res textiles imbibe\u0301es d\u2019histoires anonymes, de myste\u0300res et de secrets. \u00bb \r\n- Julie Crenn","performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551274"},"nl":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551274"},"en":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":"We are delighted to announce Ecologies intimes, an exhibition that brings together three woman artists linked by a common friendship and complementary practices: Tatiana Wolska, Dorota Buczkowska and Sandra Lecoq.","longdescr":"\"A plastic bottle, a bed sheet yellowed by time, a sheet of paper, a scrap of cardboard or wood, a torn piece of clothing - the materials that form the basis of the artistic practices of Tatiana Wolska (1977), Dorota Buczkowska (1971) and Sandra Lecoq (1972) belong to the everyday. The three artists strive to transform and sublimate the almost nothing, the invisible, or even undesirable materials. Their economy of means is put at the service of visual, poetic and political reflections where the landscape of the intimate is explored layer by layer, point by point, texture by texture. The intimate is visually conveyed through sensual and organic forms, embracing bodies, superimpositions, depths and textile materials imbued with anonymous stories, mysteries and secrets. \u00bb\r\n - Julie Crenn","performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551274"},"de":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551274"},"it":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551274"},"sp":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551274"},"pt":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551274"},"cn"