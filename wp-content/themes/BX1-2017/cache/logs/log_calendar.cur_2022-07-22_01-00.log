oors":null,"start":"14:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-07-22","doors":null,"start":"15:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-07-27","doors":null,"start":"14:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[11,7,3,4,5],"translations":{"fr":["Famille","Jeunes 12-15 ans","Enfants 3-6 ans","Enfants 6-9 ans","Enfants 9-12 ans"],"nl":["Familie","Jongeren 12-15 j.","Kinderen 3-6 j.","Kinderen 6-9 j.","Kinderen 9-12 j."],"en":["Family","Youth 12-15  yr.","Children 3-6 yr.","Children 6-9 yr.","Children 9-12 yr."]}},"tags":["exterior","kids"],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:36:09+02:00","published_at":"2022-06-20T14:56:19+02:00","backoffice_id":256386,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.32931687800417},{"id":537679,"date_start":"2022-07-01","date_end":"2022-08-31","date_next":"2022-07-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Une exp\u00e9rience mus\u00e9ale pour les jeunes et les familles","shortdescr":"Venez d\u00e9couvrir le MigratieMuseumMigration pendant les vacances, Une exp\u00e9rience mus\u00e9ale pour les jeunes et les familles.","longdescr":"Il y a une qu\u00eate pour les plus de 12 ans et les petits enfants construisent leur propre vitrine.\r\n\r\nCherchez votre propre histoire. Vous d\u00e9couvrez \u00e0 quel point votre nom est populaire \u00e0 Bruxelles, ce que ce nom vous dit. Les photos et les r\u00e9cits des migrants vous invitent \u00e9galement \u00e0 les raconter. Vous d\u00e9m\u00ealez le message cach\u00e9 dans les \u0153uvres des grands artistes. Vous partez \u00e0 la chasse au tr\u00e9sor dans les vitrines avec les t\u00e9moignages personnels.\r\n\r\nEn fin de compte, il y a quelque chose de savoureux pour chaque d\u00e9tective.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537679.html"},"nl":{"name":"Museumervaring voor jongeren en families","shortdescr":"Kom op ontdekking in het MigratieMuseumMigration tijdens de vakantie, een museumervaring voor jongeren en kleine kinderen.","longdescr":"Er is een zoektocht voor de 12 plussers en kleine kinderen kunnen hun eigen vitrine maken.\r\n\r\nOp zoek gaan naar je eigen verhaal. Je ontdekt hoe populair jouw naam is in Brussel en wat die naam vertelt. De sprekende foto\u2019s en verhalen van migranten nodigen je uit om ook te vertellen. Je ontrafelt de boodschap die verborgen zit in de kunstwerken van grote artiesten. Je gaat op schattenjacht in de vitrines met de persoonlijke getuigenissen.\r\n\r\nOp het einde is er iets lekkers voor elke deelnemer.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537679.html"},"en":{"name":"Museum experience for young people and families","shortdescr":"Come and discover the MigratieMuseumMigration during the holidays: A museum experience for young people and families.","longdescr":"There is a quest for the 12+ and small children can make their own showcase.\r\n\r\nLooking for your own story. You discover how popular your name is in Brussels and what it tells us. The telling photos and stories of migrants invite you to tell them as well. You will unravel the message hidden in the works of art of great artists. You go on a treasure hunt in the showcases with the personal testimonies.\r\n\r\nAt the end there is something sweet for every participant.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537679.html"},"de":{"name":"Museumervaring voor jongeren en families","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/537679.html"},"it":{"name":"Museumervaring voor jongeren en families","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/537679.html"},"sp":{"name":"Museumervaring voor jongeren en families","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/537679.html"},"pt":{"name":"Museumervaring voor jongeren en families","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/537679.html"},"cn":{"name":"Museumervaring voor jongeren en families","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/537679.html"}},"place":{"id":274307,"translations":{"fr":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Aujourd'hui, plus de 180 nationalite\u0301s vivent ensemble a\u0300 Bruxelles. Le MigratieMuseumMigration raconte l\u2019histoire de la premie\u0300re ge\u0301ne\u0301ration de travailleurs immigre\u0301s invite\u0301s, des premiers arrivants au Petit Cha\u0302teau, des expatrie\u0301s, des re\u0301fugie\u0301s de guerre, des Europe\u0301ens qui se sont de\u0301place\u0301s librement au sein de l\u2019UE et de tous les autres. C\u2019est un muse\u0301e chaleureux ou\u0300 les visiteurs peuvent de\u0301couvrir la ville et la vie des autres a\u0300 travers des souvenirs, mais aussi, et avant tout, un lieu accueillant pour y partager sa propre histoire.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"MigratieMuseumMigration","address_street_name":"Werkhuizenstraat","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Werkhuizenstraat, 17","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Vandaag de dag wonen meer dan 180 nationaliteiten samen in Brussel. Het MigratieMuseumMigration geeft de verhalen van de eerste generatiegastarbeiders, van de vroegste bewoners van het Klein Kasteeltje, van de expats, de oorlogsvluchtelingen, de Europeanen die zich vrij bewegen binnen de EU en vele anderen een permanente thuis. Het is een warme omgeving waar bezoekers via herinneringen en kunst op ontdekking gaan in Brussel en in het leven van anderen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Today, more than 180 nationalities live together in Brussels. The MigratieMuseumMigration gives a permanent home to the stories of the first generation of guest workers, of the earliest inhabitants of the Petit-Cha\u0302teau, of the expats, the war refugees, the Europeans who move freely within the EU and many others. It is a warm environment where visitors can discover Brussels and the lives of others through memories and souvenirs. Above all, it is a museum with plenty of room to share your own story.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 