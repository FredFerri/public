null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/517605.html"},"en":{"name":"L'Annexe Brewery Tours","shortdescr":"Come to visit a craft brewery where tradition and innovation have one and only one purpose: taste.","longdescr":"Beer is part of our cultural legacy in Belgium, and Brussels takes its own share of it. The brewing industry is having its renewal for quite a while now, and some of them are part of the cutting edge of it. A blatant example of the perfect blending of innovation with tradition in beer: l'Annexe. Come and discover the story behind the legend, and find out what makes this place so unique! And after that: we'll share a flight together!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/517605.html"},"de":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/517605.html"},"it":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/517605.html"},"sp":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/517605.html"},"pt":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/517605.html"},"cn":{"name":"Visites de la