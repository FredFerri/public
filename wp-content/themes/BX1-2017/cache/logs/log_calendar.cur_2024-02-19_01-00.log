T17:00:00"}},{"id":50004453,"date_start":"2024-01-25","date_end":"2024-03-23","date_next":"2024-02-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-18T01:03:37+01:00","published_at":"2023-11-16T11:38:27+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":288987,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3236378653619318,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Generations of resilience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.hangar.art\/","email":"contact@hangar.art","phone_contact":"32 (0)2 538 00 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50004453"},"pt":{"name":"Generations of resilience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.hangar.art\/","email":"contact@hangar.art","phone_contact":"32 (0)2 538 00 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50004453"},"en":{"name":"Generations of Resilience \u2013 22 Ukrainian photographers","shortdescr":"The history of Ukraine is a struggle for the future, which continues through generations. Here photography and art become one of the main methods to record and archive changes and one of the ways to fight in the war and resist colonial policy.","longdescr":"The exhibition shows the challenges, faced by several generations of Ukrainian photographers. Cyclical processes, historical events and unity erase the borderline between these generations. The collection of photos from the 1970s to present emphasises the spiral nature of the struggle for Ukraine\u2019s independence and democratic development. The history of Ukraine is a struggle for the future, which continues through generations. Here photography and art become one of the main methods to record and archive changes and one of the ways to fight in the war and resist colonial policy.\nText: Kateryna Radchenko","performers":"Collective exhibition\nThe artists will be announced shortly on our website: https:\/\/www.hangar.art\/","boxoffice_url":null,"website":"https:\/\/www.hangar.art\/","email":"contact@hangar.art","phone_contact":"32 (0)2 538 00 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50004453"},"it":{"name":"Generations of resilience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.hangar.art\/","email":"contact@hangar.art","phone_contact":"32 (0)2 538 00 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50004453"},"cn":{"name":"Generations of resilience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.hangar.art\/","email":"contact@hangar.art","phone_contact":"32 (0)2 538 00 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50004453"},"fr":{"name":"Generations of Resilience \u2013 22 Ukrainian photographers","shortdescr":"L\u2019histoire de l\u2019Ukraine est une lutte pour l\u2019avenir, qui se poursuit \u00e0 travers les g\u00e9n\u00e9rations. Ici, la photographie et l\u2019art deviennent l\u2019un des principaux moyens d\u2019enregistrer et d\u2019archiver les changements, ainsi qu\u2019un moyen de lutter en temps de guerre et de r\u00e9sister \u00e0 l\u2019imp\u00e9rialisme.","longdescr":"L\u2019exposition Generations of resilience met en lumi\u00e8re les d\u00e9fis auxquels ont \u00e9t\u00e9 confront\u00e9es plusieurs g\u00e9n\u00e9rations de photographes ukrainiens. Les processus cycliques, les \u00e9v\u00e9nements historiques et l\u2019unit\u00e9 effacent la fronti\u00e8re entre ces g\u00e9n\u00e9rations. La pr\u00e9sentation d\u2019un ensemble de photographies des ann\u00e9es 1970 \u00e0 aujourd\u2019hui met l\u2019accent sur la nature spirale de la lutte pour l\u2019ind\u00e9pendance de l\u2019Ukraine et de son d\u00e9veloppement d\u00e9mocratique. L\u2019histoire de l\u2019Ukraine est une lutte pour l\u2019avenir, qui se poursuit \u00e0 travers les g\u00e9n\u00e9rations. Ici, la photographie et l\u2019art deviennent l\u2019un des principaux moyens d\u2019enregistrer et d\u2019archiver les changements, ainsi qu\u2019un moyen de lutter en temps de guerre et de r\u00e9sister \u00e0 l\u2019imp\u00e9rialisme.\nTexte : Kateryna Radchenko","performers":"Exposition collective\nLes artistes seront annonc\u00e9s prochainement sur notre site : https:\/\/www.hangar.art\/","boxoffice_url":null,"website":"https:\/\/www.hangar.art\/","email":"contact@hangar.art","phone_contact":"32 (0)2 538 00 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004453"},"sp":{"name":"Generations of resilience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.hangar.art\/","email":"contact@hangar.art","phone_contact":"32 (0)2 538 00 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004453"},"nl":{"name":"Generations of Resilience \u2013 22 Ukrainian photographers","shortdescr":"De geschiedenis van Oekra\u00efne is een strijd voor de toekomst, die voortduurt door de generaties heen. Hier worden fotografie en kunst een van de belangrijkste methoden om veranderingen vast te leggen en te archiveren, evenals een manier om te vechten in de oorlog en weerstand te bieden aan koloniale politiek.","longdescr":"De tentoonstelling toont de uitdagingen waarmee verschillende generaties Oekra\u00efense fotografen worden geconfronteerd. Cyclische processen, historische gebeurtenissen en eenheid wissen de grens tussen deze generaties uit. De verzameling foto's van de jaren 1970 tot heden benadrukt de spiraalvormige aard van de strijd voor de onafhankelijkheid en democratische ontwikkeling van Oekra\u00efne. De geschiedenis van Oekra\u00efne is een strijd voor de toekomst, die voortduurt door de generaties heen. Hier worden fotografie en kunst een van de belangrijkste methoden om veranderingen vast te leggen en te archiveren, evenals een manier om te vechten in de oorlog en weerstand te bieden aan koloniale politiek.\nTekst : Kateryna Radchenko","performers":"Collectieve tentoonstelling\nDe artiesten worden binnenkort aangekondigd op onze website: https:\/\/www.hangar.art\/","boxoffice_url":null,"website":"https:\/\/www.hangar.art\/","email":"contact@hangar.art","phone_contact":"32 (0)2 538 00 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004453"}},"place":{"id":257183,"translations":{"de":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":"Das Hangar ist ein Kunstzentrum f\u00fcr Fotografie, das f\u00fcr alle Formen und Str\u00f6mungen der zeitgen\u00f6ssischen Fotografie offen ist. Dabei sind den Genres und den Herangehensweisen des Mediums keine Grenzen gesetzt. Nur der K\u00fcnstler, die Aussage \u00fcber seine Zeit und das szenografische Erlebnis f\u00fcr den Betrachter z\u00e4hlen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Hangar","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":"Hangar is the photo art center of Brussels. \r\nHangar organizes 3-4 large exhibitions per year among which a major annual event: PhotoBrussels Festival. Hangar is dedicated to all forms and sensitivities of contemporary photography. No restrictions as to genres, territories, or modes of operation. The only thing that counts is the artist, what they have to say about our time, and the scenographic experience they offer to the visitor. Hangar focuses on emotion as much as on the understanding of the medium. The exhibitions also serve as a theatre for conferences, workshops, performances, and meetings. Hangar is also a publisher of photography books and a bookshop offering a selection of novelties as well as the sale of limited editions. Created by a passionate Belgian art collector, Hangar is located in the heart of the Ch\u00e2telain neighborhood in Brussels and spread on more than 1000m2.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Hangar","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":"Centre d\u2019art d\u00e9di\u00e9 \u00e0 la photographie, hangar se donne pour mission l\u2019ouverture \u00e0 toutes les formes et sensibilit\u00e9s de la photographie contemporaine. Pas de restriction de genres, ni de territoires, ni de modes op\u00e9ratoires du medium. Seuls comptent l\u2019artiste, ce qu\u2019il \u00e0 a dire sur son \u00e9poque par le biais de la photographie et l\u2019exp\u00e9rience sc\u00e9nographique qu\u2019il offre au visiteur.\r\n\r\nHangar soutient la jeune cr\u00e9ation photographique \u00e0 travers des partenariats avec des \u00e9coles d\u2019art et de photographie, une attention et un soutien particuliers aux jeunes talents et \r\nl\u2019organisation de concours comme le PBF Prize lors du PhotoBrussels Festival. \r\n\r\nLe rythme de 8 \u00e0 10 expositions par an est maintenu et permettra aux visiteurs de d\u00e9couvrir une large s\u00e9lection d\u2019artistes photographes. Place \u00e0 la m\u00e9diation et \u00e0 l\u2019ouverture \u00e0 tous les publics, avec un programme de conf\u00e9rences, workshops et diverses animations autour de la photo. L\u2019activit\u00e9 commerciale (vente de tirages, de livres photos, d\u2019\u00e9ditions limit\u00e9es\u2026) est abrit\u00e9e dans un nouveau bookshop et dans une nouvelle entit\u00e9 Photo Art Center galerie (PAC galerie).\r\nHangar est un centre d\u2019art priv\u00e9 belge fond\u00e9 en 2014 par Rodolphe de Spoelberch et dirig\u00e9 par Delphine Dumont depuis juillet 2017. Sur plus de 1000 m2, il est constitu\u00e9 de deux espaces d\u2019exposition (mainspace et frontspace), d\u2019un bookshop d\u00e9di\u00e9 \u00e0 la photographie et du restaurant Campo, qui jouxte le hangar.\r\n","description_print":null,"booking_url":null,"sort_order":"hangar","virtual_visit":null,"visit_url":null},"sp":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Hangar","address_street_name":"Kasteleinsplein","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Kasteleinsplein, 18","address_line2":"1050 Ixelles","description_web":"Photo Art Center Hangar presenteert een gecureerde selectie van bekende internationale kunstenaars en veelbelovend jong talent in samenwerking met het kunst-en fotografie-onderwijs. Hangar draagt zo bij tot een grotere waardering voor fotografie in Brussel. Elk jaar vinden in Hangar 8 \u00e0 10 tentoonstellingen plaats, waaronder het PhotoBrussels Festival. In het kader van deze tentoonstellingen worden vaak ook lezingen, performances en vergaderingen georganiseerd. \r\nHangar werd opgericht door een enthousiaste Belgische kunstverzamelaar. Het kunstencentrum bevindt zich in het hart van de Kasteleinswijk in Brussel en heeft een oppervlakte van meer dan 1000 m\u00b2.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[6],"translations":{"de":["Chatelain\/Bailli"],"pt":[null],"en":["Chatelain\/Bailli"],"it":["Chatelain\/Bailli"],"cn":[null],"fr":["Chatelain\/Bailli"],"sp":["Ch\u00e2telain\/Bailli"],"nl":["Kasteleinswijk\/Baljuw"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"art_center","facebook_id":null,"backoffice_id":17183,"location":{"lat":50.82483298,"lon":4.36016843},"region":"brussels","last_updated_at":"2023-01-18T12:23:32+01:00","published_at":"2014-03-14T09:48:11+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"i