00 to 18:00"],"it":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 15:00 to 18:00"],"sp":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 15:00 to 18:00"],"pt":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 15:00 to 18:00"],"cn":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 15:00 to 18:00"]},"date_start":"2023-03-18","date_end":"2023-04-23","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,261],"translations":{"fr":["Accessible","Parking accessible"],"nl":["Toegankelijk","Toegankelijke parking"],"en":["Accessible","Accessible parking"],"de":["Barrierefrei","Barrierefreier Parkplatz"],"it":["Accessibile","Parcheggio accessibile"],"sp":["Habilitado","Estacionamiento habilitado"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-26T04:08:32+02:00","published_at":"2023-03-20T10:48:22+01:00","backoffice_id":273777,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.38157141418444},{"id":552655,"date_start":"2023-03-17","date_end":"2023-04-23","date_next":"2023-03-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,27],"translations":{"fr":["Galeries d'art","Photographie"],"nl":["Galeries","Fotografie"],"en":["Art Galleries","Photography"],"de":["Kunstgalerien","Fotografie"],"it":["Gallerie d'arte","Fotografia"],"sp":["Galer\u00edas de arte","Fotograf\u00eda"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Biennale de Photographie de Molenbeek","shortdescr":"En mars-avril 2023, la Biennale de Photographie de Molenbeek fera son grand retour au Ch\u00e2teau du Karreveld, \u00e0 la Maison des Cultures et de la Coh\u00e9sion Sociale et dans l\u2019espace public.","longdescr":"Pour cette deuxi\u00e8me \u00e9dition, les liens singuliers entre photographie et litt\u00e9rature seront mis en r\u00e9sonnance au travers d\u2019une quarantaine d\u2019artistes r\u00e9unis sous forme de duos compos\u00e9s d\u2019un.e photographe et d\u2019un.e \u00e9crivain.e.\r\n\r\n\" Quand le peu importe \" est la th\u00e9matique de travail propos\u00e9e aux photographes. Ouvertes comme le titre d\u2019un livre d\u2019images, les trois expositions conjugueront le visible au lisible, l\u2019image \u00e0 l\u2019\u00e9cho.\r\nAux c\u00f4t\u00e9s des photographies, des \u00e9crivain.e.s poseront des voix d\u2019accompagnement, des textes sous forme de po\u00e9sie, des r\u00e9cits, un rien de prose, un cri, une nuance. Nous vous invitons d\u00e9j\u00e0 \u00e0 vous pr\u00e9parer au d\u00e9fil\u00e9 de propositions originales o\u00f9 le peu sera d\u00e9clin\u00e9 de multiples fa\u00e7ons, au carrefour des regards et des mots en chemin.\r\n\r\nVernissage 17.03.2023 - \u00e0 partir de 18h\r\nHoraires me > di 13h > 18h\r\nVendredi 07 & 21.04 - sp\u00e9cial Nocturnes - jusque 21h\r\nFinissage - 23.04 - Ch\u00e2teau du Karreveld\r\n\r\n4 lieux :\r\nMaison des Cultures et de la Coh\u00e9sion Sociale (MCCS)\r\nCh\u00e2teau du Karreveld\r\nRue de l'Avenir, espace public molenbeekois\r\nTiny Gallery (rue de la Cuve 26 - 1050 Ixelles)","performers":"A. Blavier, A.-S. Costenoble, B.D\u2019Hainaut, A. de Gelas, J.-P. Dessy, I. Dykmans, R. Elshan, F. Emmanuel, C. Epure, C. Gatineau, F. Goffin, A. Griz, C. Havelange, P. Herbet, P. Hermant, A. Jim\u00e9nez Saiz, F. Lafontaine, M. Lagage, C. Lamarche, S. Marcq, M. Pierard, H. Petite, A. Pleeck, R. Sassi, S. Tilman, C. Vey","boxoffice_url":null,"website":"http:\/\/www.lamaison1080hethuis.be","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552655"},"nl":{"name":"Molenbeek Fotografie Bi\u00ebnnale","shortdescr":"In maart-april 2023 maakt de Molenbeekse Fotografie Bi\u00ebnnale haar comeback in het Kasteel van Karreveld, het Huis van Culturen en Sociale Samenhang en in de openbare ruimte.","longdescr":"Voor deze tweede editie worden de bijzondere banden tussen fotografie en literatuur samengebracht in de vorm van duo's bestaande uit een fotograaf en een schrijver.\r\n\r\n\"When the little matters\" is het thema dat aan de fotografen wordt voorgesteld. Open als de titel van een prentenboek zullen de drie tentoonstellingen het zichtbare met het leesbare, het beeld met de echo combineren.\r\nNaast de foto's zullen de schrijvers zorgen voor begeleidende stemmen, teksten in de vorm van po\u00ebzie, verhalen, een vleugje proza, een kreet, een nuance. Wij nodigen u uit om u voor te bereiden op de parade van originele voorstellen waarbij het kleine op meerdere manieren zal worden afgewezen, op het kruispunt van blikken en woorden onderweg.\r\n\r\nOpening 17.03.2023 - vanaf 18 uur\r\nOpeningsuren woe > zon 13u > 18u\r\nVrijdag 07 & 21.04 - speciale Nocturnes - tot 21u\r\nFinissage - 23.04 - Kasteel Karreveld\r\n\r\n4 locaties :\r\nHuis van Culturen en Sociale Samenhang (MCCS)\r\nKasteel Karreveld\r\nRue de l'Avenir, openbare ruimte in Molenbeek\r\nTiny Gallery (rue de la Cuve 26 - 1050 Elsene)","performers":"A. Blavier, A.-S. Costenoble, B.D\u2019Hainaut, A. de Gelas, J.-P. Dessy, I. Dykmans, R. Elshan, F. Emmanuel, C. Epure, C. Gatineau, F. Goffin, A. Griz, C. Havelange, P. Herbet, P. Hermant, A. Jim\u00e9nez Saiz, F. Lafontaine, M. Lagage, C. Lamarche, S. Marcq, M. Pierard, H. Petite, A. Pleeck, R. Sassi, S. Tilman, C. Vey","boxoffice_url":null,"website":"http:\/\/www.lamaison1080hethuis.be","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552655"},"en":{"name":"Biennale of Photography of Molenbeek","shortdescr":null,"longdescr":null,"performers":"A. Blavier, A.-S. Costenoble, B.D\u2019Hainaut, A. de Gelas, J.-P. Dessy, I. Dykmans, R. Elshan, F. Emmanuel, C. Epure, C. Gatineau, F. Goffin, A. Griz, C. Havelange, P. Herbet, P. Hermant, A. Jim\u00e9nez Saiz, F. Lafontaine, M. Lagage, C. Lamarche, S. Marcq, M. Pierard, H. Petite, A. Pleeck, R. Sassi, S. Tilman, C. Vey","boxoffice_url":null,"website":"http:\/\/www.lamaison1080hethuis.be","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552655"},"de":{"name":"Biennale de Photographie de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lamaison1080hethuis.be","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552655"},"it":{"name":"Biennale de Photographie de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lamaison1080hethuis.be","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552655"},"sp":{"name":"Biennale de Photographie de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lamaison1080hethuis.be","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552655"},"pt":{"name":"Biennale de Photographie de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lamaison1080hethuis.be","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552655"},"cn":{"name":"Biennale de Photographie de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lamaison1080hethuis.be","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552655"}},"place":{"id":2507,"translations":{"fr":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Le Karreveld n'est pas qu'un parc mais c'est aussi une \"ferme-ch\u00e2teau\" devenue un espace culturel au centre du parc entour\u00e9 d'arbres et d'un \u00e9tang.\r\n\r\nVous pourrez vous y promener, visiter une exposition, fl\u00e2ner le long des chemins en d\u00e9couvrant ces \u00e9co-syst\u00e8mes.\r\n\r\nAu coeur du parc, ce trouve une ancienne ferme-ch\u00e2teau devenu le lieu des c\u00e9r\u00e9monies officielles de mariages des Molenbeekois mais \u00e9galement un espace culturel accueillant des expositions, concerts, spectacles, march\u00e9 artisanal (March\u00e9 de No\u00ebl), ...","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Karreveldkasteel","address_street_name":"Jean de la Hoeselaan","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Jean de la Hoeselaan, 3","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"\r\nHet Karreveld is niet alleen een park, maar ook een \"kasteelboerderij\" die een culturele ruimte is geworden in het midden van het park, omringd door bomen en een vijver.\r\n\r\nU kunt er rondwandelen, een tentoonstelling bezoeken, over de paden wandelen en deze ecosystemen ontdekken.\r\n\r\nIn het hart van het park bevindt zich een voormalige boerderij-kasteel waar offici\u00eble huwelijksceremonies van de Molenbeekenaars plaatsvinden, maar ook een culturele ruimte waar tentoonstellingen, concerten, voorstellingen, een ambachtsmarkt (kerstmarkt), ... plaatsvinden.\r\n\r\nOm (opnieuw) ontdekt te word","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[23],"translations":{"fr":["Ouest"],"nl":["West"],"en":["West"],"de":["Westen"],"it":["Ovest"],"sp":["Oeste"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":240,"location":{"lat":50.86023792,"lon":4.31543689},"region":"brussels","last_updated_at":"2023-03-26T04:35:04+02:00","published_at":"2013-10-19T01:13:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":243578,"translations":{"fr":{"name":"Maison des Cultures et de la coh\u00e9sion sociale de Molenbeek (MCCS)","address_street_name":"Rue Mommaerts","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Mommaerts, 4","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"La Maison des Cultures et de la Coh\u00e9sion Sociale est un service \u00e0 part enti\u00e8re de la commune de Molenbeek-St-Jean.\r\nAu c\u0153ur du Molenbeek historique, situ\u00e9 \u00e0 la fronti\u00e8re symbolique de l'autre rive du canal, sur un territoire riche de populations vari\u00e9es, la Maison des Cultures constitue un espace artistique de service public. Elle \u00e9tablit des relations directes avec les habitants, dans un rapport de proximit\u00e9, notamment par le biais des ateliers organis\u00e9s pour les adultes et les enfants et la Court'Echelle, espace consacr\u00e9 \u00e0 la petite enfance.\r\nLieu d\u2019accueil, de rencontres, d\u2019\u00e9changes et de dialogue, la programmation de la Maison veut aller \u00e0 l'encontre des besoins et les r\u00e9alit\u00e9s quotidiennes des habitants de Molenbeek en privil\u00e9giant la cr\u00e9ation vers la mixit\u00e9 culturelle et les relations interg\u00e9n\u00e9rationnelles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Het Huis van Culturen en Sociale Samenhang van Molenbeek (HCSS)","address_street_name":"Mommaertsstraat","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Mommaertsstraat, 4","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Het Huis van Culturen en Sociale Samenhang is een initiatief van openbare dienstverlening van de gemeente Sint-Jans-Molenbeek, gelegen in het hart van het historische Molenbeek, aan de symbolische grens van de andere kant van het kanaal. Het Huis van Culturen is een artistieke ruimte die nauwe banden aanhaalt met de bewoners door onder meer workshops te organiseren voor volwassenen en kinderen, en activiteiten in Court'Echelle, de ruimte gewijd aan de allerkleinsten. In een wijk rijk aan diverse bevolkingsgroepen, wil het Huis een plek zijn voor ontmoetingen, uitwisselingen en dialoog, en met de programmatie inspelen op de dagelijkse behoeften en realiteit van de inwoners van Molenbeek.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Maison des Cultures et de la Coh\u00e9sion sociale de Molenbeek  (MCCS)","address_street_name":"Rue Mommaerts","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Mommaerts, 4","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Maison des Cultures et de la coh\u00e9sion sociale de Molenbeek (MCCS)","address_street_name":"Rue Mommaerts","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Mo