by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-14T01:35:46+01:00","published_at":"2022-07-19T10:44:46+02:00","backoffice_id":258658,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28543716208189},{"id":542697,"date_start":"2022-11-11","date_end":"2022-12-23","date_next":"2022-11-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Exposition collective - Playground? Autour du football...","shortdescr":"A l\u2019approche de la prochaine Coupe du Monde de football, nous r\u00e9unissons une quinzaine d\u2019artistes internationaux pour une exposition collective qui abordera les nombreuses facettes de ce sport populaire li\u00e9 aux multiples enjeux du monde contemporain, tout particuli\u00e8rement avec cette \u00e9dition au Qatar.","longdescr":"Un sociologue belge, Pascal De Maeseneire, \u00e9crivait, au milieu des ann\u00e9es 1990 : \u00ab Le football est une chose beaucoup trop s\u00e9rieuse pour la laisser aux seuls commentateurs sportifs et \u00e0 leurs phrases toutes faites \u00bb.\r\n\r\nEn effet, le football rassemble un nombre inestimable de fervents supporters ou de spectateurs occasionnels.\u2028Jeu populaire devenu spectacle de masse \u00e0 l\u2019\u00e9chelle plan\u00e9taire, le football est aujourd\u2019hui configur\u00e9 comme une v\u00e9ritable dramaturgie, capable de captiver des millions de spectateurs de par le monde, comme Levalet le repr\u00e9sente de mani\u00e8re satirique dans son oeuvre intitul\u00e9e \u00ab\u00a0La soci\u00e9t\u00e9 du spectacle.\u00a0\u00bb\r\n\r\nCe sport est devenu un enjeu strat\u00e9gique et politique majeur pour les pays organisateurs des plus grandes comp\u00e9titions internationales.\r\n\r\nAu-del\u00e0 des questions d\u2019argent qui entoure le monde du football (comme l\u2019illustre parfaitement l\u2019\u0153uvre de l\u2019artiste fran\u00e7ais Brusk avec le troph\u00e9e de la coupe du monde affubl\u00e9e du dollar sign et la mention \u00ab\u00a0Slave\u00a0\u00bb ), le contexte Qatari de cette \u00e9dition 2022 nous confronte au probl\u00e8me \u00e9cologique.\r\nL\u2019homme, peut-il au XXIeme si\u00e8cle continuer de se divertir et d\u2019offrir un spectacle, sans prendre en compte les cons\u00e9quences climatiques pour les g\u00e9n\u00e9rations futures ?\u2028Le tableau \u00ab\u00a0FifaOil Cup22\u00a0\u00bb du street artiste fran\u00e7ais Kurar est une parfaite critique de cet \u00e9v\u00e9nement sportif organis\u00e9 et pay\u00e9 avec l\u2019argent du p\u00e9trole.\u2028\u2028Mais le football reste \u00e9galement un moyen d\u2019unir les individus, Nelson Mandela disait \u00ab S'il y a une chose sur cette plan\u00e8te qui a le pouvoir de lier les gens, c'est bien le football.\u00a0\u00bb\u00a0","performers":"Carlos Aires; Brusk; Simon Berger; Alfred Cheng; Vincent Corpet; C215; Kurar; Levaletr; Jean-Luc Moerman; Laurina Paperina; Pantonio; St\u00e9phane Pencr\u00e9ac'h; Sonac","boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542697"},"nl":{"name":"Exposition collective - Playground? Autour du football...","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"w