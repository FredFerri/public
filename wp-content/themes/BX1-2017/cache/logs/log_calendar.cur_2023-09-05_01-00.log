"2023-09-04T08:45:06+02:00","published_at":"2023-09-04T08:36:46+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284626,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Compagnie Artichoke \"Schubert est amoureux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001730"},"pt":{"name":"Compagnie Artichoke \"Schubert est amoureux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001730"},"en":{"name":"Compagnie Artichoke \"Schubert est amoureux\"","shortdescr":"The story of Franz Schubert's first love in a musical theatre and slightly...cabaret version!","longdescr":"This is the true but fictionalised story of Franz Schubert's first love as told by the famous Trout!\nDiscover how the great composer fell in love with Th\u00e9r\u00e8se, a singer in his choir. Yes, Th\u00e9r\u00e8se loves Franz Schubert's music. But she also loves croissants. What an awful dilemma, having to choose between music and pastries!  \nHere's a tender, offbeat introduction to the Lieder of Franz Schubert, one of the first great Viennese Romantics, in the company of some great artists who need no introduction: Sarah Laulan as Th\u00e9r\u00e8se Grob, Julien Brocal as Franz Schubert & Julien Fanthou as the Trout.  \n","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001730"},"it":{"name":"Compagnie Artichoke \"Schubert est amoureux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001730"},"cn":{"name":"Compagnie Artichoke \"Schubert est amoureux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001730"},"fr":{"name":"Compagnie Artichoke \"Schubert est amoureux\"","shortdescr":"C'est l'histoire vraie mais romanc\u00e9e mais vraie du premier amour de Franz Schubert racont\u00e9e par la c\u00e9l\u00e8bre Truite !","longdescr":"D\u00e9couvrez comment le grand compositeur est tomb\u00e9 amoureux de Th\u00e9r\u00e8se, une chanteuse de sa chorale. Eh oui, Th\u00e9r\u00e8se adore la musique de Franz Schubert. Mais elle aime aussi beaucoup\u2026 les croissants. Quel affreux dilemme, que de devoir choisir entre la musique et la p\u00e2tisserie!  Voici une initiation tendre et d\u00e9cal\u00e9e aux Lieder de Franz Schubert, l\u2019un des premiers grands romantiques viennois en compagnie de tr\u00e8s grands artistes qu'on ne pr\u00e9sente plus: Sarah Laulan, dans le r\u00f4le de Th\u00e9r\u00e8se Grob, Julien Brocal dans le r\u00f4le de Franz Schubert & Julien Fanthou dans le r\u00f4le de la Truite","performers":"Compagnie Artichoke \nSarah Laulan, dans le r\u00f4le de Th\u00e9r\u00e8se Grob, Julien Brocal dans le r\u00f4le de Franz Schubert & Julien Fanthou dans le r\u00f4le de la Truite","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001730"},"sp":{"name":"Compagnie Artichoke \"Schubert est amoureux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001730"},"nl":{"name":"Compagnie Artichoke \"Schubert est amoureux\"","shortdescr":"Het verhaal van de eerste liefde van Franz Schubert in een muzikale theater- en lichtelijk...cabaretversie!","longdescr":"Dit is het waargebeurde maar gefictionaliseerde verhaal van de eerste liefde van Franz Schubert zoals verteld door de beroemde Forel!\nOntdek hoe de grote componist verliefd werd op Th\u00e9r\u00e8se, een zangeres in zijn koor. Ja, Th\u00e9r\u00e8se houdt van de muziek van Franz Schubert. Maar ze houdt ook van croissants. Wat een vreselijk dilemma, moeten kiezen tussen muziek en gebak!  \nDit is een tedere, onconventionele introductie tot de liederen van Franz Schubert, een van de eerste grote Weense romantici, in het gezelschap van enkele geweldige artiesten die geen introductie nodig hebben: Sarah Laulan als Th\u00e9r\u00e8se Grob, Julien Brocal als Franz Schubert & Julien Fanthou als de Forel. ","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001730"}},"place":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Baixu","address_street_name":"Picardstraat","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Picardstraat, 3","address_line2":"1000 Bruxelles","description_web":"De naam \"Baixu\" betekent \"mooi\" in de taal van de Pataxos indianen die in de zuidelijke staat Bahia (Brazili\u00eb) wonen. Dit woord staat voor de ambitie van het project en de kwaliteit van de culturele evenementen, maar ook voor de verbondenheid van de initiatiefnemers met de Braziliaanse cultuur. \r\nLe Baixu is ondergebracht in een voormalig industrieel gebouw in het hart van de trendy Brusselse Tour & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":39109,"location":{"lat":50.86391031,"lon":4.34697026},"region":"brussels","last_updated_at":"2023-05-11T08:22:15+02:00","published_at":"2022-07-15T20:19:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_