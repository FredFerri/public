:"2022-06-30","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-04-15","start":"17:00:00","timestamp":"2022-04-15T17:00:00+02:00","end":"20:00:00","is_only_by_appointment":false},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-15T01:09:32+02:00","published_at":"2022-04-04T15:37:32+02:00","backoffice_id":250857,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23505514316043},{"id":534013,"date_start":"2022-05-21","date_end":"2022-05-21","date_next":"2022-05-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Garden Tales \u2013 Le verger de la transition","shortdescr":"Garden Tales est un \u00e9v\u00e9nement annuel gratuit qui vous propose de visiter des jardins priv\u00e9s et publics \u00e0 Bruxelles.","longdescr":"Nature \u00e0 Jette est un groupe du mouvement Jette en Transition, la branche jettoise du R\u00e9seau Transition, n\u00e9e d\u00e9but 2017. NAJ a repris la gestion d\u2019un verger \u00e9ducatif aux essences s\u00e9lectionn\u00e9es par les P\u00e9pini\u00e8res d'Enghien pour leur caract\u00e8re autochtone. Pommiers, poiriers tiges ou paliss\u00e9s, pruniers, et autres fruitiers en tous genres habillent ce lieu paisible.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.civa.brussels\/fr\/expos-events\/le-verger-de-la-transition","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534013.html"},"nl":{"name":"Garden Tales \u2013 De boomgaard van de verandering","shortdescr":"Garden Tales is een jaarlijks evenement waarbij je gratis heel wat priv\u00e9- en publieke tuinen in Brussel kan bezoeken.","longdescr":"Nature \u00e0 Jette is onderdeel van Jette en Transition, de plaatselijke afdeling van het R\u00e9seau Transition dat begin 2017 is opgericht. NAJ heeft het beheer op zich genomen van een educatieve boomgaard met soorten die door de Boomkwekerijen van Edingen zijn geselecteerd om hun inheemse karakter. Allerlei soorten appelbomen, perenbomen, pruimenbomen en andere fruitbomen sieren deze vredige plek.","performers":null,"boxoffice_url":null,"website":null,"email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534013.html"},"en":{"name":"Garden Tales \u2013 The orchard of transition","shortdescr":"Garden Tales is a free yearly festival that turns the spotlight on private and public gardens in Brussels.","longdescr":"Nature \u00e0 Jette is a group of the Jette en Transition movement, the Jette branch of the Transition Network, born in early 2017. NAJ has taken over the management of an educational orchard with species selected by the P\u00e9pini\u00e8res d'Enghien for their indigenous character. Apple trees, pear trees, plum trees, and other fruit trees of all kinds adorn this peaceful place.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534013.html"},"de":{"name":"Garden Tales \u2013 Le verger de la transition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https