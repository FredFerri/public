translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50007519,"date_start":"2024-02-25","date_end":"2024-09-14","date_next":"2024-05-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-19T17:37:28+02:00","published_at":"2024-02-20T13:07:54+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":295073,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.1701510580563294,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Balades des arbres remarquables","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ixelles.be\/site\/agenda.php?evenId=21705","email":"tourisme@ixelles.brussels","phone_contact":"0251567378","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007519"},"pt":{"name":"Balades des arbres remarquables","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ixelles.be\/site\/agenda.php?evenId=21705","email":"tourisme@ixelles.brussels","phone_contact":"0251567378","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007519"},"en":{"name":"Balades des arbres remarquables","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ixelles.be\/site\/agenda.php?evenId=21705","email":"tourisme@ixelles.brussels","phone_contact":"0251567378","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007519"},"it":{"name":"Balades des arbres remarquables","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ixelles.be\/site\/agenda.php?evenId=21705","email":"tourisme@ixelles.brussels","phone_contact":"0251567378","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007519"},"cn":{"name":"Balades des arbres remarquables","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ixelles.be\/site\/agenda.php?evenId=21705","email":"tourisme@ixelles.brussels","phone_contact":"0251567378","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007519"},"fr":{"name":"Balades des arbres remarquables","shortdescr":"Ixelles a choisi de mettre en valeur le patrimoine arbor\u00e9 de la commune et d\u2019offrir aux citoyen-ne-s trois balades-d\u00e9couvertes des arbres remarquables en f\u00e9vrier, mai et septembre.  Ces promenades des arbres remarquables sont l\u2019occasion de contribuer \u00e0 la reconnexion des Ixellois.es avec la nature et les arbres. ","longdescr":"Ixelles a choisi de mettre en valeur le patrimoine arbor\u00e9 de la commune et d\u2019offrir aux citoyen-ne-s trois balades-d\u00e9couvertes des arbres remarquables en f\u00e9vrier, mai et septembre. \n\nCes promenades des arbres remarquables sont l\u2019occasion de contribuer \u00e0 la reconnexion des Ixellois.es avec la nature et les arbres, tout en valorisant leur r\u00f4le incontournable en mati\u00e8re de lutte contre le d\u00e9r\u00e8glement climatique ; c\u2019est aussi une autre fa\u00e7on de faire d\u00e9couvrir notre magnifique commune aux Bruxelloi-e-s et aux touristes de passage chez nous !\n\nPour rappel, l\u2019arbre remarquable est un arbre que sa taille ou sa forme distingue de tous les autres. Il est dit remarquable s\u2019il pr\u00e9sente un ou plusieurs crit\u00e8res li\u00e9(s), entre autres, \u00e0 son \u00e2ge (avanc\u00e9), \u00e0 ses caract\u00e9ristiques physiques (hauteur et circonf\u00e9rence), biologiques et esth\u00e9tiques, ou encore \u00e0 des faits historiques (ou de l\u00e9gende).\n\nIxelles a la chance de compter plus de quatre cents arbres remarquables sur son territoire dont certains vivent paisiblement depuis plusieurs centaines d\u2019ann\u00e9es !\n\nEn quoi consistent ces balades?\n\nDix arbres remarquables ont \u00e9t\u00e9 retenus pour composer chacune des balades dans trois quartiers privil\u00e9gi\u00e9s : les Etangs d\u2019Ixelles, le quartier Boondael, au sud de la commune et, enfin, le quartier outre Louise autour du parc Tenbosch et de l\u2019avenue Louis Lepoutre.\n\nPromenades guid\u00e9es \n\nVous avez l\u2019occasion de participer \u00e0 4 promenades guid\u00e9es : trois promenades en fran\u00e7ais et une promenade en n\u00e9erlandais. \n\nCette ann\u00e9e nous organisons une promenade en hiver \u00e0 Flagey, deux promenades au printemps \u00e0 Boondael et une promenade en \u00e9t\u00e9 \u00e0 Tenbosch. \n\nVoici les infos pratiques : \n\n-              Dimanche 25 f\u00e9vrier de 15h30 \u00e0 17h00 : Flagey (FR)\n\n-              Dimanche 26 mai de 9h30 \u00e0 12h00 (NL) et de 10h00 \u00e0 12h30 (FR) : Boondael \n\n-              Samedi 14 septembre de 9h30 \u00e0 12h00: Tenbosch (FR)\n\nLes inscriptions sont obligatoires \u00e0 l\u2019adresse tourisme@ixelles.brussels. \n\n\u00b7        Les balades sont disponibles dans les trois langues (FR-NED-ENG)\n\n-              en ligne \u00e0 l\u2019adresse www.woodwideweb.be\/1050 o\u00f9 les citoyens pourront renseigner leurs arbres pr\u00e9f\u00e9r\u00e9s ou encore partager leur coup de c\u0153ur ;\n\n-              en format papier reprenant, pour chacune d\u2019elle, le plan de la promenade ainsi qu\u2019une fiche d\u2019identit\u00e9 de chaque arbre d\u00e9voilant leurs secrets et bienfaits pour l\u2019environnement. Sur demande \u00e0 l\u2019adresse tourisme@ixelles.brussels.\n\n\u00b7        Les promenades sont aussi ludiques et pens\u00e9es pour les familles: les enfants pourront s\u2019amuser \u00e0 faire correspondre la feuille, le fruit ou encore l\u2019\u00e9corce au bon arbre. \n\nInscription obligatoire","performers":"Ixelles a choisi de mettre en valeur le patrimoine arbor\u00e9 de la commune et d\u2019offrir aux citoyen-ne-s trois balades-d\u00e9couvertes des arbres remarquables en f\u00e9vrier, mai et septembre. ","boxoffice_url":null,"website":"https:\/\/www.ixelles.be\/site\/agenda.php?evenId=21705","email":"tourisme@ixelles.brussels","phone_contact":"0251567378","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007519"},"sp":{"name":"Balades des arbres remarquables","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ixelles.be\/site\/agenda.php?evenId=21705","email":"tourisme@ixelles.brussels","phone_contact":"0251567378","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007519"},"nl":{"name":"Balades des arbres remarquables","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ixelles.be\/site\/agenda.php?evenId=21705","email":"tourisme@ixelles.brussels","phone_contact":"0251567378","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007519"}},"place":{"last_updated_at":"2023-11-06T13:37:51+01:00","published_at":"2023-05-26T13:56:41+02:00","id":280525,"translations":{"de":{"name":"Commune d'Ixelles","address_street_name":"Chauss\u00e9e d'Ixelles","address_street_number":"168","address_street_box":null,"email":"toerisme@elsene.brussels","website":null,"phone_contact":"+32 2 515 67 37","phone_booking":null,"address_z