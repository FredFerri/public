s":[],"parent_events":[],"targets":{"list":[11,10],"translations":{"fr":["Famille","Seniors"],"nl":["Familie","Senioren"],"en":["Family","Seniors"],"de":["Familie","Senioren"],"it":["Famiglie","Anziani"],"sp":["Familias","Personas de la tercera edad"],"pt":[null,null],"cn":[null,null]}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"],"de":["Jugendstil & Art d\u00e9co"],"it":["Art Nouveau e Art D\u00e9co"],"sp":["Art nouveau y art d\u00e9co"],"pt":[null],"cn":[null]}},"tags":["kids","annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-10T23:06:15+01:00","published_at":"2022-12-16T12:47:13+01:00","backoffice_id":267518,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.29615092275388},{"id":544966,"date_start":"2022-10-29","date_end":"2023-09-01","date_next":"2023-04-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"],"it":["Cabaret"],"sp":["Caf\u00e9 teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":"Spectacles dont les b\u00e9n\u00e9fices vont \u00e0 diff\u00e9rentes associations caritatives","longdescr":"\" IMPROPEDIA \"\r\n\r\nT'as rien \u00e0 faire ce soir-l\u00e0 ?\r\n\r\n\r\nT'as envie de d\u00e9penser de l'argent pour une bonne cause (les entr\u00e9es vont au \u00e0 une association) ? T'as envie de revoir des Coolos sur sc\u00e8ne ? Tu veux devenir plus intelligent ? \r\n\r\n Alors viens te marrer devant IMPROPEDIA, un spectacle d'impro qui rend plus malin que le fils de Julien Lepers et d'Albert Einstein.\r\n\r\n\r\nPar l'\u00e9quipe des Coolos\r\n\r\n-------`\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\n- Sur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\n- Sur place : 15\u20ac\/personne","performers":"Spectacle de l'\u00e9quipe d'improvisation \"Les Coolos 2.0\"","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544966"},"nl":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544966"},"en":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544966"},"de":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"perform