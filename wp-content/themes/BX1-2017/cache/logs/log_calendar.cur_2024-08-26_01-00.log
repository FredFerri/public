":{}},"educational_targets":{"list":[],"translations":{}},"tags":["major_event"]},{"id":50011392,"date_start":"2024-07-26","date_end":"2024-12-31","date_next":"2024-08-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-08-25T02:01:56+02:00","published_at":"2024-06-06T14:35:56+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":301600,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.4651299298806676,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Harry Potter: Visions of Magic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/harrypottervisionsofmagic.com\/be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011392"},"pt":{"name":"Harry Potter: Visions of Magic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/harrypottervisionsofmagic.com\/be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011392"},"en":{"name":"Harry Potter: Visions of Magic","shortdescr":null,"longdescr":"Harry Potter: Visions of Magic created by Warner Bros. Discovery Global Themed\nEntertainment and NEON is an evocative and interactive art experience exploring some of the\nmost mysterious corners of the wizarding world across a 3,000 square meter venue. Discover\na series of artistic and immersive environments inspired by enigmatic places in the magical\ncommunity, like the Room of Requirement, Newt\u2019s Menagerie, the Ministry of Magic, and more.\nResponsive video content, bold architecture, and original soundscapes create breathtaking\nmulti-sensory installations, while interactive technology invites guests to illuminate the invisible,\nrevealing visions of magic that bring the entire experience to life. ","performers":null,"boxoffice_url":null,"website":"https:\/\/harrypottervisionsofmagic.com\/be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011392"},"it":{"name":"Harry Potter: Visions of Magic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/harrypottervisionsofmagic.com\/be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011392"},"cn":{"name":"Harry Potter: Visions of Magic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/harrypottervisionsofmagic.com\/be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011392"},"fr":{"name":"Harry Potter: Visions of Magic","shortdescr":null,"longdescr":"Harry Potter : Visions of Magic, une cr\u00e9ation de Warner Bros. Discovery Global Themed\nEntertainment et NEON propose sur 3000 m\u00e8tres carr\u00e9s une exp\u00e9rience artistique \u00e9vocatrice\net interactive qui explore les recoins les plus myst\u00e9rieux du Wizarding World\u2122. D\u00e9couvrez\nune s\u00e9rie d'environnements artistiques et immersifs inspir\u00e9s de lieux \u00e9nigmatiques de la \ncommunaut\u00e9 magique, comme la Salle sur Demande, la M\u00e9nagerie de Norbert Dragonneau,\nle Minist\u00e8re de la Magie et bien d'autres. Des contenus vid\u00e9o r\u00e9actifs, une architecture\naudacieuse et des ambiances sonores originales cr\u00e9ent des installations multisensorielles \u00e0\ncouper le souffle, tandis que la technologie interactive invite les visiteurs \u00e0 illuminer l'invisible,\nr\u00e9v\u00e9lant des visions de magie qui donnent vie \u00e0 l'ensemble de l'exp\u00e9rience.","performers":null,"boxoffice_url":null,"website":"https:\/\/harrypottervisionsofmagic.com\/be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011392"},"sp":{"name":"Harry Potter: Visions of Magic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/harrypottervisionsofmagic.com\/be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011392"},"nl":{"name":"Harry Potter: Visions of Magic","shortdescr":null,"longdescr":"Harry Potter: Visions of Magic, een creatie van Warner Bros. Discovery Global Themed\nEntertainment en NEON, is een meeslepende interactieve kunstervaring van meer dan\n3000 vierkante meter die bezoekers meevoert naar enkele van de meest mysterieuze\nuithoeken van de tovenaarswereld. Ontdek immersieve en artistiek hoogstaande\nomgevingen ge\u00efnspireerd door raadselachtige plaatsen uit de tovenaarswereld, zoals de\nKamer van Hoge Nood, Newts Menagerie, het Ministerie van Toverkunst en meer. De \nresponsieve video\u2019s, de gedurfde architectuur en de originele geluidservaring cre\u00ebren\neen adembenemend avontuur voor alle zintuigen, terwijl de bezoekers dankzij de\ninteractieve technologie de onzichtbare magie om zich heen tot leven laten komen. \n","performers":"Warner Bros. Discovery Global Themed Entertainment en NEON, samen met lokale partners Explorado Group & Exhibition Hub","boxoffice_url":null,"website":"https:\/\/harrypottervisionsofmagic.com\/be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011392"}},"place":{"id":222762,"translations":{"de":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"Die ehemalige Logistikplattform mit Zolldepot Tour & Taxis, die Anfang des 20. Jahrhunderts erbaut und intensiv genutzt wurde, bietet eine ganze Reihe eindrucksvoller Geb\u00e4ude von hoher architektonischer Qualit\u00e4t: Entrep\u00f4t Royal, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste und Gare Maritime. Unter Ber\u00fccksichtigungen der urspr\u00fcnglichen Architektur und des besonderen historischen Wertes erhielt das Geb\u00e4ude nun eine zeitgem\u00e4\u00dfe Neuinterpretation und erf\u00fcllt inzwischen mehrere Aufgaben: Ausstellungen, Veranstaltungen, Arbeitsbereiche, Gesch\u00e4ftsr\u00e4ume, Dienstleistungen...\r\n\r\nDie Gr\u00fcnfl\u00e4chen und der sich entwickelnde Park als Orte der Entspannung und Unterhaltung sind zentrale Elemente des neuen Konzepts.\r\n\r\nDas industrielle Erbe von Tour & Taxis k\u00f6nnen Sie auch \u00fcber die App mit Audio-Guide, Karte und Fotos entdecken. Laden Sie die kostenlose App \u00fcber den folgenden Link herunter: www.tt-app.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86c","address_line2":"1000 Brussels","description_web":"The historical logistics platform of Tour & Taxis presents a number of buildings of exceptional size and architectural value: the Royal Depot, the Sheds, the H\u00f4tel des Douanes, the H\u00f4tel de la Poste and the Gare Maritime. A modern interpretation is given to the historic buildings on the Tour & Taxis site, with great respect for their authenticity and heritage value.\r\nThe site is ideally located on the tourist routes, between the Brussels old city centre and other tourist attactions such as the Atomium.\r\nThe green areas and the evolutionary park are central features and an inherent part of the philosophy behind the Tour & Taxis development.\r\nTour & Taxis is becoming a reinvented neighbourhood with residences, culture, offices and public services all in one, creating a positive alternative for people looking for new experiences. The Sheds welcome different major events including antique and art fairs.\r\nWith eateries, bars and activities on the site, there\u2019s something to suit everyone\u2019s taste.\r\n\r\nTour & Taxis offers you the chance to discover the industrial heritage of this unique site using our App, which comprises of an audio guide working together with historic photos. You can download our App for free at: www.tt-app.be","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"L\u2019ancienne plateforme logistique de Tour & Taxis datant du d\u00e9but du 20\u00e8me si\u00e8cle offre des immeubles d\u2019envergure et d\u2019une haute qualit\u00e9 architecturale : l\u2019Entrep\u00f4t Royal, les Sheds, l\u2019H\u00f4tel des Douanes, l\u2019H\u00f4tel de la Poste et la Gare Maritime. Tout en respectant leur authenticit\u00e9 et leur valeur historique, une r\u00e9interpr\u00e9tation contemporaine est donn\u00e9e \u00e0 ces immeubles h\u00e9rit\u00e9s du si\u00e8cle pass\u00e9. Ils connaissent d\u00e9sormais des affectations multiples : expositions, \u00e9v\u00e9nements, espaces de travail, espaces commerciaux, services...\r\nLe site est id\u00e9alement situ\u00e9 sur le parcours touristique bruxellois, entre la vieille ville (Grand-Place, Manneken Pis \u2026) et d\u2019autres attractions touristiques telles que l\u2019Atomium.\r\nLes espaces verts et le parc \u00e9volutif sont des \u00e9l\u00e9ments centraux et inh\u00e9rents \u00e0 la philosophie de d\u00e9veloppement. Ils offrent des lieux de d\u00e9tente et de divertissement.\r\nTour & Taxis devient donc un quartier multifonctionnel r\u00e9invent\u00e9 avec des logements, de la culture, des espaces de travail, cr\u00e9ant une alternative positive pour les visiteurs \u00e0 la recherche de nouvelles exp\u00e9riences.\r\nDans un cadre inspirant, les Sheds accueillent des \u00e9v\u00e9nements incontournables et attirent de nombreux visiteurs.\r\nGr\u00e2ce aux diff\u00e9rents restaurants, bars et activit\u00e9s sur le site, il y a toujours une exp\u00e9rience \u00e0 vivre.\r\n\r\nT&T vous propose de d\u00e9couvrir l\u2019h\u00e9ritage industriel du site \u00e0 l\u2019aide de l\u2019App avec audio-guide, plan et photos. T\u00e9l\u00e9chargez l\u2019App gratuitement via le lien suivant : www.tt-app.be\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"La hist\u00f3rica plataforma log\u00edstica de Tour & Taxis presenta un n\u00famero de edificios de gran envergadura y valor arquitect\u00f3nico: Royal Depot, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste y Gare Maritime. Se le da una interpretaci\u00f3n moderna a los edifcios hist\u00f3ricos de Tour & Taxis, respetando su autenticidad y valor patrimonial.\r\nEl lugar est\u00e1 idealmente localizado en las rutas tur\u00edsticas, entre la parte antigua de la ciudad y otros lugares de inter\u00e9s tur\u00edstico tales como el Atomium.\r\nLas zonas verdes y el parque, que est\u00e1 en constante evoluci\u00f3n, son las principales caracter\u00edsticas y una parte inherente de la filosof\u00eda que hay detr\u00e1s del desarrollo de Tour & Taxis.\r\nTour & Taxis se est\u00e1 convirtiendo en un nuevo vecindario con residencias, cultura, oficinas y servicios p\u00fablicos todo en uno, creando una alternativa positiva para aquella gente que busca nuevas experiencias. El edificio Sheds acoge diferentes eventos de gran envergadura, incluyendo ferias de arte y antig\u00fcedades.\r\n\u00a1En los restaurantes, bares y actividades que hay en el lugar encontrar\u00e1s cosas para todos los gustos!\r\n\r\nTour & Taxis te ofrece la oportunidad de descubrir el patrimonio industrial de este lugar \u00fanico usando nuestra aplicaci\u00f3n, que incluye una audiogu\u00eda junto con fotos hist\u00f3ricas. Puedes descargar la aplicaci\u00f3n de manera gratuita aqu\u00ed: www.tt-app.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Tour & Taxis","address_street_name":"Havenlaan","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Havenlaan, 86c","address_line2":"1000 Brussel","description_web":"Het voormalige logistieke platform van Tour & Taxis uit de vroege jaren van de 20e eeuw  bestaat uit gebouwen met hoge architectonische kwaliteit: het Koninklijk Pakhuis, de Sheds, het H\u00f4tel des Douanes, het H\u00f4tel de la Poste en de Gare Maritime zijn stuk voor stuk erfgoedparels.  Dit patrimonium kreeg met respect  voor historische waarde en oog voor authenticiteit een nieuwe eigentijdse invulling met  tentoonstellingen, evenementen, kantoren, coworking, retail, services ...\r\nDe site sluit nauw aan bij het toeristisch parcours tussen het historische stadscentrum (Grote Markt, Manneken Pis ...) en andere bezienswaardigheden zoals het Atomium. Het bevindt zich ook op wandelafstand van het toekomstige nieuwe museum voor moderne en hedendaagse kunst.\r\nDe groene ruimtes en het moderne park bieden ruimte aan ontspanning en vrijetijdsactiviteiten.\r\nTour & Taxis wordt een vooruitstrevende participatieve wijk met woningen, cultuur, workspaces, food hall \u2026 die een uitvalsbasis vormt voor de bezoekers op zoek naar nieuwe ervaringen. Zo vinden er in de Sheds uiteenlopende topbeurzen plaats. Dankzij die grote diversiteit aan activiteiten, restaurants, bars en talloze andere activiteiten op de site valt er steeds iets te beleven.\r\n\r\nTour&Taxis biedt u de mogelijkheid om het industrieel patrimonium van de site te ontdekken aan de hand van een App met audio-guide en foto\u2019s. U kunt de App gratis downloaden op: www.tt-app.be\r\n \r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":658,"location":{"lat":50.86573978,"lon":4.3509828},"region":"brussels","last_updated_at":"2023-10-02T11:55:29+02:00","published_at":"2013-10-19T01:13:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":242496,"translations":{"de":{"name":"PR Caracas","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"PR Caracas","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_