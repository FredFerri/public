ept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[3],"translations":{"fr":["Musique Contemporaine"],"nl":["Hedendaagse Muziek"],"en":["Contemporary music"]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"\"Douce France\", Concert \u00e0 l'occasion de la pr\u00e9sidence fran\u00e7aise du Conseil de l'Union europ\u00e9enne","shortdescr":"La Fondation internationale Yehudi Menuhin organise un concert \u00e0 l'occasion de la pr\u00e9sidence fran\u00e7aise. Plusieurs musiciens de renom interpr\u00e9teront un r\u00e9pertoire de styles diff\u00e9rents mettant en valeur la richesse du patrimoine musical fran\u00e7ais. Au programme : bal musette, chanson fran\u00e7aise, musique de film, musique classique, slam et musique du monde.","longdescr":"L\u2019International Yehudi Menuhin Foundation organise un concert \u00e0 l\u2019occasion de la Pr\u00e9sidence fran\u00e7aise du Conseil de l\u2019Union Europ\u00e9enne le 21 juin 2022 \u00e0 Wolubilis. Depuis plus de trente ans, la Fondation r\u00e9alise des projets socio-culturels visant \u00e0 favoriser l\u2019\u00e9galit\u00e9 des chances d\u2019acc\u00e8s \u00e0 la culture et \u00e0 la pratique artistique. A travers ses concerts annuels, elle d\u00e9livre un message de paix, d\u2019universalisme, et de tol\u00e9rance en c\u00e9l\u00e9brant les expressions musicales de diverses cultures.\r\n\r\nUn programme musical riche et vari\u00e9 \r\nPlusieurs musiciens et musiciennes de renoms interpr\u00e8teront un r\u00e9pertoire de styles diff\u00e9rents mettant en valeur la richesse du patrimoine musical fran\u00e7ais. Au programme du bal musette, de la chanson fran\u00e7aise, de la musique de film, de la musique classique, du slam et de la musique du monde. \r\n\r\nDes artistes de cultures et de styles diff\u00e9rents\r\nDans l\u2019esprit de Yehudi Menuhin, le r\u00e9pertoire sera interpr\u00e9t\u00e9 par de nombreux artistes de cultures et de styles musicaux diff\u00e9rents : Le violoniste fran\u00e7ais Gilles Apap, les sollistes du Brussels Chamber Orchestra accompagn\u00e9s de l\u2019accord\u00e9oniste anversois Gwen Cressens et du cymbaliste roumain Marius Preda, la chanteuse ha\u00eftienne Marl\u00e8ne Dorc\u00e9na, la chanteuse fran\u00e7aise Marianne Aya Omac, le slammer Congolais microMEGA le Verbivore. \r\n\r\nConcert pour la paix et la solidarit\u00e9 \r\nCe concert sera \u00e9galement sous le signe de la paix et de la solidarit\u00e9 en accueillant deux violonistes, l\u2019une tch\u00e8que d\u2019origine russe, Olga Sroubkkova, l\u2019autre ukrainien, Valerij Sokolov. En jouant ensemble ils illustreront la puissance du dialogue et de l\u2019\u00e9coute en ces temps troubl\u00e9s. \r\n\r\nL\u2019International Yehudi Menuhin Foundation \r\nDepuis sa cr\u00e9ation en 1991 \u00e0 Bruxelles, l\u2019IYMF utilise les expressions artistiques comme outil de rencontre entre les cultures du monde et produit une marque europ\u00e9enne de concerts multiculturels de grande qualit\u00e9.  A travers tous ces projets la Fondation utilise l\u2019art comme un moyen de faciliter l\u2019inclusion sociale et le dialogue interculturel.","performers":"Thierry Van Roy (direction musicale), Mario Villuendas (direction musicale), Gilles Apap, Les solistes du Brussels Chamber Orchestra, Gwen Cresens, Marius Preda, Marl\u00e8ne Dorc\u00e9na, Marianne Aya Omac, microMega le Verbivore, Valery Sokolov, Olga \u0160roubkov\u00e1.","boxoffice_url":null,"website":"http:\/\/www.menuhin-foundation.com","email":"juliette.vanmaele@menuhin-foundation.com","phone_contact":"+32 484 98 63 30","phone_booking":"+32 484 98 63 30","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534066.html"},"nl":{"name":"\"Douce France\", Concert ter gelegenheid van het Franse voorzitterschap van de Raad van de Europese Unie","shortdescr":"De International Yehudi Menuhin Foundation organiseert een concert ter gelegenheid van het Franse voorzitterschap. Verschillende gerenommeerde musici zullen een repertoire van verschillende stijlen ten gehore brengen, waarbij de rijkdom van het Franse muzikale erfgoed wordt belicht. Op het programma staan onder meer bal musette, Frans chanson, filmmuziek, klassieke muziek, slam en wereldmuziek.","longdescr":"De International Yehudi Menuhin Foundation organiseert een concert ter gelegenheid van het Franse voorzitterschap van de Raad van de Europese Unie op 21 juni 2022 in Wolubilis. Al meer dan dertig jaar voert de Stichting sociaal-culturele projecten uit ter bevordering van gelijke kansen bij de toegang tot cultuur en kunstbeoefening. Via haar jaarlijkse concerten brengt zij een boodschap van vrede, universalisme en verdraagzaamheid over door de muzikale uitingen van verschillende culturen te huldigen.\r\n\r\nEen rijk en gevarieerd muziekprogramma\r\nVerschillende gerenommeerde musici zullen een repertoire van verschillende stijlen ten gehore brengen, waarbij de rijkdom van het Franse muzikale erfgoed wordt belicht. Op het programma staan onder meer bal musette, Frans chanson, filmmuziek, klassieke muziek, slam en wereldmuziek. \r\n\r\nKunstenaars uit verschillende culturen en stijlen\r\nIn de geest van Yehudi Menuhin zal het repertoire worden vertolkt door een groot aantal artiesten uit verschillende culturen en muziekstijlen: De Franse violist Gilles Apap, de solisten van het Brussels Kamerorkest begeleid door de Antwerpse accordeoniste Gwen Cressens en de Roemeense cimbaalspeler Marius Preda, de Ha\u00eftiaanse zangeres Marl\u00e8ne Dorc\u00e9na, de Franse zangeres Marianne Aya Omac, de Congolese slammer microMEGA le Verbivore.\r\n\r\nConcert voor vrede en solidariteit \r\nDit concert zal ook in het teken staan van vrede en solidariteit door het verwelkomen van twee violisten, een Tsjechische van Russische afkomst, Olga Sroubkkova, de andere Oekra\u00efense, Valerij Sokolov. Door samen te spelen zullen zij de kracht van dialoog en luisteren in deze moeilijke tijden illustreren. \r\n\r\nThe International Yehudi Menuhin Foundation \r\nSinds zijn oprichting in 1991 in Brussel heeft het IYMF artistieke expressie gebruikt als een instrument voor de ontmoeting van wereldculturen en heeft het een Europees merk van multiculturele concerten van hoge kwaliteit voortgebracht.  Via al deze projecten gebruikt de Stichting kunst als een middel om sociale integratie en interculturele dialoog te bevorderen.","performers":"Thierry Van Roy (muzikaal directeur), Mario Villuendas (muzikaal directeur), Gilles Apap, De solisten van het Brussels Kamerorkest, Gwen Cresens, Marius Preda, Marl\u00e8ne Dorc\u00e9na, Marianne Aya Omac, microMega le Verbivore, Valery Sokolov, Olga \u0160roubkov\u00e1","boxoffice_url":null,"website":"http:\/\/www.menuhin-foundation.com","email":"juliette.vanmaele@menuhin-foundation.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534066.html"},"en":{"name":"\"Douce France\", Concert on the occasion of the French Presidency of the Council of the European Union","shortdescr":"The International Yehudi Menuhin Foundation is organising a concert on the occasion of the French Presidency. Several renowned musicians will perform a repertoire of different styles highlighting the richness of the French musical heritage. The programme includes bal musette, French chanson, film music, classical music, slam and world music.","longdescr":"The International Yehudi Menuhin Foundation is organising a concert on the occasion of the French Presidency of the Council of the European Union on 21 June 2022 in Wolubilis. For more than thirty years, the Foundation has been carrying out socio-cultural projects aimed at promoting equal opportunities for access to culture and artistic practice. Through its annual concerts, it delivers a message of peace, universalism and tolerance by celebrating the musical expressions of various cultures.\r\n\r\nA rich and diversified musical programme\r\nSeveral renowned musicians will perform a repertoire of different styles highlighting the richness of the French musical heritage. The programme includes bal musette, French chanson, film music, classical music, slam and world music. \r\n\r\nArtists from different cultures and styles\r\nIn the spirit of Yehudi Menuhin, the repertoire will be interpreted by many artists from different cultures and musical styles: The French violinist Gilles Apap, the soloists of the Brussels Chamber Orchestra accompanied by the Antwerp accordionist Gwen Cressens and the Romanian cymbalist Marius Preda, the Haitian singer Marl\u00e8ne Dorc\u00e9na, the French singer Marianne Aya Omac, the Congolese slammer microMEGA le Verbivore. \r\n\r\nConcert for peace and solidarity\r\nThis concert will also be under the sign of peace and solidarity by welcoming two violinists, one Czech of Russian origin, Olga Sroubkkova, the other Ukrainian, Valerij Sokolov. By playing together they will illustrate the power of dialogue and listening in these troubled times. \r\n\r\nThe International Yehudi Menuhin Foundation \r\nSince its creation in 1991 in Brussels, the IYMF has used artistic expression as a tool for the encounter of world cultures and has produced a European brand of high quality multicultural concerts.  Through all these projects the Foundation uses art as a means to facilitate social inclusion and intercultural dialogue.","performers":"Thierry Van Roy (conductor), Mario Villuendas (conductor), Gilles Apap, Brussels Chamber Orchestra soloists, Gwen Cresens, Marius Preda, Marl\u00e8ne Dorc\u00e9na, Marianne Aya Omac, microMega le Verbivore, Valery Sokolov, Olga \u0160roubkov\u00e1","boxoffice_url":null,"website":null,"email":"juliette.vanmaele@menuhin-foundation.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534066.html"},"de":{"name":"\"Douce France\", Concert \u00e0 l'occasion de la pr\u00e9sidence fran\u00e7aise du Conseil de l'Union europ\u00e9enne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/534066.html"},"it":{"name":"\"Douce France\", Concert \u00e0 l'occasion de la pr\u00e9sidence fran\u00e7aise du Conseil de l'Union europ\u00e9enne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/534066.html"},"sp":{"name":"\"Douce France\", Concert \u00e0 l'occasion de la pr\u00e9sidence fran\u00e7aise du Conseil de l'Union europ\u00e9enne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/534066.html"},"pt":{"name":"\"Douce France\", Concert \u00e0 l'occasion de la pr\u00e9sidence fran\u00e7aise du Conseil de l'Union europ\u00e9enne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/534066.html"},"cn":{"name":"\"Douce France\", Concert \u00e0 l'occasion de la pr\u00e9sidence fran\u00e7aise du Conseil de l'Union europ\u00e9enne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/534066.html"}},"place":{"id":220532,"translations":{"fr":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1