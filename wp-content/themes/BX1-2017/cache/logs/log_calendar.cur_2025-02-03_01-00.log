ull,"performers":"Th\u00e9\u00e2tre Royal du Peruchet ( Dimitri Jageneau et \u00e9quipe)","boxoffice_url":null,"website":"https:\/\/theatreperuchet.be\/programme\/","email":"contact@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005318"},"sp":{"name":"l'enfant Mozart","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatreperuchet.be\/programme\/","email":"contact@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005318"},"nl":{"name":"het Mozart kind","shortdescr":"Een concert over een kindercomponist met de naam Wolfgang Mozart. Het leven en het sprookje van een kind dat werd uitverkoren door de Muziekfee en nooit van zijn zijde week. We volgen het leven van dit kind van 3 tot 10 jaar. Een kennismaking met de muziek van Mozart. \nVoor kinderen vanaf 4 jaar. Voorstelling om 15.00 uur. Check de data op onze website. ","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatreperuchet.be\/programme\/","email":"contact@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005318"}},"place":{"id":241472,"translations":{"de":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name