aterdag en zondag: van 11:00 tot 19:00"]},"date_start":"2024-10-22","date_end":"2025-03-02","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700003345,"date_start":"2024-10-31","date_end":"2025-01-06","date_next":"2024-11-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:01:39+01:00","published_at":"2024-11-20T15:22:56+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311016,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.24499865251482233,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Exhibition \"Chromatic Dreams\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"Helene.GUILLOU@sofitel.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003345"},"pt":{"name":"Exhibition \"Chromatic Dreams\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"Helene.GUILLOU@sofitel.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003345"},"en":{"name":"Chromatic Dreams","shortdescr":"Let yourself be carried away by the unique experience of Chromatic Dreams: Mapping the Inner Landscape, an immersive exhibition where colors and textures become an inner journey. Hosted by Flowspace and Sofitel Brussels Europe, this exhibition brings together the bold creations of Jane Puylagarde, Sylv\u00e8re Jarrosson, and Marc-Antoine Garnier, curated by Eugenia Durandy de Naurois-Turgot.","longdescr":"Join us at the Sofitel Brussels Europe for Chromatic Dreams: Mapping the Inner Landscape, an immersive exhibition curated by Eugenia Durandy de Naurois-Turgot. This showcase features the transformative works of three innovative artists:\n\nJane Puylagarde explores texture and repetition through her signature \u201cdot\u201d technique, creating mesmerizing monochromatic reliefs that embody cycles of growth, decay, and rebirth.\n\nSilv\u00e8re Jarrosson bridges dance and abstract painting, employing fluid techniques to evoke movement and emotion, inviting viewers to engage in a dynamic exploration of stillness and chaos.\n\nMarc-Antoine Garnier captures the interplay of light and time in his sculptural photography, offering a tactile experience that mirrors the viewer's own emotional landscapes.\n\nSet against the backdrop of Brussels' vibrant European Quarter, this exhibition invites you to reflect on your inner journey through color and form. Don\u2019t miss this unique opportunity to connect with art that resonates on a personal level.","performers":null,"boxoffice_url":null,"website":null,"email":"Helene.GUILLOU@sofitel.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003345"},"it":{"name":"Exhibition \"Chromatic Dreams\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"Helene.GUILLOU@sofitel.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003345"},"cn":{"name":"Exhibition \"Chromatic Dreams\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"Helene.GUILLOU@sofitel.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003345"},"fr":{"name":"Chromatic Dreams","shortdescr":"Laissez-vous emporter par l\u2019exp\u00e9rience unique de Chromatic Dreams: Mapping the Inner Landscape, une exposition immersive o\u00f9 couleurs et textures deviennent un voyage int\u00e9rieur. Organis\u00e9e par Flowspace et Sofitel Brussels Europe, cette exposition r\u00e9unit les cr\u00e9ations audacieuses de Jane Puylagarde, Sylv\u00e8re Jarrosson et Marc-Antoine Garnier sous le commissariat d\u2019Eugenia Durandy de Naurois-Turgot.","longdescr":"Rejoignez-nous au Sofitel Brussels Europe pour Chromatic Dreams: Mapping the Inner Landscape, une exposition immersive curat\u00e9e par Eugenia Durandy de Naurois-Turgot. Ce showcase pr\u00e9sente les \u0153uvres transformantes de trois artistes innovants :\n\nJane Puylagarde explore la texture et la r\u00e9p\u00e9tition \u00e0 travers sa technique de \u00ab points \u00bb, cr\u00e9ant des reliefs monochromatiques envo\u00fbtants qui incarnent les cycles de croissance, de d\u00e9composition et de renaissance.\n\nSilv\u00e8re Jarrosson fait le lien entre la danse et la peinture abstraite, utilisant des techniques fluides pour \u00e9voquer le mouvement et l'\u00e9motion, invitant les spectateurs \u00e0 une exploration dynamique de la tranquillit\u00e9 et du chaos.\n\nMarc-Antoine Garnier capture le jeu de la lumi\u00e8re et du temps dans sa photographie sculpturale, offrant une exp\u00e9rience tactile qui refl\u00e8te les paysages \u00e9motionnels des spectateurs.\n\nDans le cadre du vibrant quartier europ\u00e9en de Bruxelles, cette exposition vous invite \u00e0 r\u00e9fl\u00e9chir \u00e0 votre parcours int\u00e9rieur \u00e0 travers la couleur et la forme. Ne manquez pas cette occasion unique de vous connecter \u00e0 un art qui r\u00e9sonne sur un plan personnel.","performers":null,"boxoffice_url":null,"website":null,"email":"Helene.GUILLOU@sofitel.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003345"},"sp":{"name":"Exhibition \"Chromatic Dreams\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"Helene.GUILLOU@sofitel.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003345"},"nl":{"name":"Chromatic Dreams","shortdescr":"Laat u meeslepen door de unieke ervaring van Chromatic Dreams: Mapping the Inner Landscape, een meeslepende tentoonstelling waar kleuren en texturen een innerlijke reis vormen. Georganiseerd door Flowspace en Sofitel Brussels Europe, brengt deze tentoonstelling de gedurfde creaties van Jane Puylagarde, Sylv\u00e8re Jarrosson en Marc-Antoine Garnier samen onder de curatorschap van Eugenia Durandy.","longdescr":"Kom naar het Sofitel Brussels Europe voor Chromatic Dreams: Mapping the Inner Landscape, een meeslepende tentoonstelling onder curatorschap van Eugenia Durandy de Naurois-Turgot. Deze showcase toont de transformerende werken van drie innovatieve kunstenaars:\n\nJane Puylagarde verkent textuur en herhaling met haar kenmerkende \"stip\" techniek, waarbij ze betoverende monochromatische reli\u00ebfs cre\u00ebert die de cycli van groei, verval en wedergeboorte belichamen.\n\nSilv\u00e8re Jarrosson overbrugt de werelden van dans en abstracte schilderkunst, waarbij hij vloeiende technieken gebruikt om beweging en emotie te verkennen en kijkers uit te nodigen tot een dynamische verkenning van stilte en chaos.\n\nMarc-Antoine Garnier vangt het spel van licht en tijd in zijn sculpturale fotografie, en biedt een tastbare ervaring die de emotionele landschappen van de kijkers weerspiegelt.\n\nTegen de achtergrond van de bruisende Europese wijk van Brussel nodigt deze tentoonstelling je uit om na te denken over je innerlijke reis door kleur en vorm. Mis deze unieke kans niet om je te verbinden met kunst die op een persoonlijk niveau resoneert.","performers":null,"boxoffice_url":null,"website":null,"email":"Helene.GUILLOU@sofitel.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003345"}},"place":{"id":50000372,"translations":{"de":{"name":"Sofitel Brussels Europe","address_street_name":"Place Jourdan","address_street_number":"1","address_street_box":null,"email":"H5282@sofitel.com","website":"https:\/\/www.sofitel-brussels-europe.com\/en\/","phone_contact":"+32 2 235 51 00","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Jourdan, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Sofitel Brussels Europe","address_street_name":"Place Jourdan","address_street_number":"1","address_street_box":null,"email":"H5282@sofitel.com","website":"https:\/\/www.sofitel-brussels-europe.com\/en\/","phone_contact":"+32 2 235 51 00","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Jourdan, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Sofitel Brussels Europe","address_street_name":"Jourdanplein","address_street_number":"1","address_street_box":null,"email":"H5282@sofitel.com","website":"https:\/\/www.sofitel-brussels-europe.com\/en\/","phone_contact":"+32 2 235 51 00","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Jourdanplein, 1","address_line2":"1040 Etterbeek","description_web":"Sofitel Brussels Europe is centrally located on the lively Place Jourdan, 