00:00"},{"day":"2022-09-22","doors":null,"start":"18:00:00","end":"19:00:00"},{"day":"2022-09-29","doors":null,"start":"18:00:00","end":"19:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"18:00:00","end":"19:00:00"}]},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, vendredi, samedi et dimanche: ferm\u00e9","jeudi: de 18:00 \u00e0 19:00"],"nl":["maandag, dinsdag, woensdag, vrijdag, zaterdag en zondag: gesloten","donderdag: van 18:00 tot 19:00"],"en":["monday, tuesday, wednesday, friday, saturday and sunday: closed","thursday: from 18:00 to 19:00"]},"date_start":"2022-09-01","date_end":"2022-09-29","is_also_by_appointment":false}],"prices":[],"child_events":[540136,540130,540137],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["major_event"],"accessibilities":{"list":[255,256,257,259,261,263,265],"translations":{"fr":["Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-09T01:36:07+02:00","published_at":"2022-07-14T11:11:27+02:00","backoffice_id":258404,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.32548726473767},{"id":539002,"date_start":"2022-08-18","date_end":"2022-09-24","date_next":"2022-09-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en","de"],"subtitles":[]},"translations":{"fr":{"name":"Un Mus\u00e9e du Capitalisme \u00e0 Bruxelles !","shortdescr":"Du 18 ao\u00fbt 2020 au 23 septembre 2022, un Mus\u00e9e du Capitalisme s\u2019installe \u00e0 la fronti\u00e8re entre la Ville de Bruxelles et Schaerbeek dans les ateliers de Zinneke. Il s\u2019agit de proposer un espace de r\u00e9flexion et de discussion sur ce syst\u00e8me complexe qui structure nos vies, et de pr\u00e9senter des alternatives existantes en Belgique.","longdescr":"Du 18 ao\u00fbt 2020 au 23 septembre 2022, un Mus\u00e9e du Capitalisme s\u2019installe \u00e0 la fronti\u00e8re entre la Ville de Bruxelles et Schaerbeek dans les ateliers de Zinneke.\r\n\r\nCr\u00e9\u00e9e en 2012 par un collectif de citoyen.ne.s, l\u2019association Mus\u00e9e du Capitalisme recouvre diverses initiatives dont une exposition itin\u00e9rante et bilingue (NL\/FR) sur notre syst\u00e8me \u00e9conomique et culturel, accessible \u00e0 tout public \u00e0 partir de 15 ans. Il s\u2019agit de proposer un espace de r\u00e9flexion et de discussion sur ce syst\u00e8me complexe qui structure nos vies, et de pr\u00e9senter des alternatives existantes en Belgique. \r\n\r\nQue trouve-t-on dans le Mus\u00e9e du Capitalisme ? Origines, espoirs, limites et alternatives au capitalisme : les quatre salles de l\u2019exposition reviennent sur les fondamentaux d\u2019un syst\u00e8me souvent mentionn\u00e9 mais rarement expliqu\u00e9. On y aborde le capitalisme en lien avec diff\u00e9rentes th\u00e9matiques telles que l\u2019alimentation, la sant\u00e9, la culture, la consommation, l\u2019environnement, la finance...\r\n\r\nPour permettre aux visiteurs d\u2019\u00e9changer sur ces sujets, pas de Monopoly ou de livre de Karl Marx, mais plut\u00f4t des vid\u00e9os, des textes, des mises en situation, des t\u00e9moignages et des animations.\r\n\r\nLe projet, engag\u00e9 mais non partisan, s\u2019inscrit dans une d\u00e9marche d\u2019\u00e9ducation permanente et est avant tout bas\u00e9 sur les \u00e9changes lors des visites guid\u00e9es organis\u00e9es pour les \u00e9coles, les groupes associatifs ainsi que pour le grand public.\r\n\r\nDes visites individuelles sont bien entendu aussi organis\u00e9es et se veulent tout aussi stimulantes, notamment gr\u00e2ce \u00e0 des brochures disponibles en fran\u00e7ais, n\u00e9erlandais, anglais, espagnol, allemand, arabe et italien. Notre souhait est que, au terme de la visite, chaque personne reparte mieux outill\u00e9e pour s\u2019affirmer pleinement dans sa citoyennet\u00e9.\r\n\r\n\u00c0 ce jour, plus de 25.000 personnes ont visit\u00e9 l\u2019exposition, ainsi que des centaines d\u2019\u00e9coles, lors de 14 \u00e9tapes : Namur (2014), Saint-Gilles (2015), Gand (2015), Laeken (2016), Mons (2017), Anderlecht (2018), Li\u00e8ge (2018), Arlon (2018), Louvain-la-Neuve (2019), Mouscron (2019), Bruxelles-Ville (2019), Gembloux (2019), Rochefort (2019), Verviers (2020), Charleroi (2021), Beauraing et Welkenraedt (2022).\r\n\r\nInfos pratiques :\r\nDates : Du 18 ao\u00fbt au 23 septembre 2022\r\nLieu : Zinneke, place Masui 13, 1000 Bruxelles.\r\nTrain : Bruxelles-Nord, Tram : Masui ligne 3, 55, 93 & Thomas ligne 4, 25. Bus : Masui ligne 58, N18.\r\nHoraires d\u2019ouverture : les mercredis, jeudis et vendredis de 16h \u00e0 20h et les samedis et dimanches de 12h \u00e0 18h. En septembre aussi ouvert le mercredi entre 10h et 17h. Tous les jeudis soir\u00e9es culturelles.\r\n\r\nEntr\u00e9e \u00e0 prix libre\r\n\r\nInfo et reservations : contact@museeducapitalisme.org, 0472\/51.24.84\r\nSite internet : www.museeducapitalisme.org","performers":null,"boxoffice_url":null,"website":"https:\/\/museeducapitalisme.org\/","email":"contact@museeducapitalisme.org","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539002"},"nl":{"name":"Een Museum van het Kapitalisme in Brussel!","shortdescr":"Van 18 augustus tot 23 september 2022 isntalleert een Museum van het Kapitalisme zich op de grens van Stad Brussel en Schaarbeek in de ateliers van Zinneke. Het doel is om ruimte te bieden voor reflectie en discussie over dit complexe systeem dat ons leven structureert, en om bestaande alternatieven in Belgi\u00eb te presenteren.","longdescr":"Van 18 augustus tot 23 september 2022 installeert een Museum van het Kapitalisme zich op de grens van Stad Brussel en Schaarbeek in de ateliers van Zinneke.\r\n\r\nIn 2012 ontstond de vereniging Museum van het Kapitalisme, opgericht door een collectief van burgers, dat verschillende initiatieven omvat waaronder een tweetalige (NL\/FR) reizende tentoonstelling over ons economisch en cultureel systeem, toegankelijk voor het grote publiek vanaf de leeftijd van 15 jaar.\r\n\r\nHet doel is om ruimte te bieden voor reflectie en discussie over dit complexe systeem dat ons leven structureert, en om bestaande alternatieven in Belgi\u00eb te presenteren. Wat is er te vinden in het Museum van het Kapitalisme? Oorsprong, hoop, grenzen en alternatieven voor het kapitalisme: de vier zalen van de tentoonstelling keren terug naar de fundamenten van een systeem dat vaak wordt genoemd maar zelden wordt uitgelegd. Het kapitalisme wordt besproken in relatie tot verschillende thema's zoals voeding, gezondheid, cultuur, consumptie, milieu, financi\u00ebn, enz.\r\n\r\nOm de bezoekers in staat te stellen om over deze onderwerpen van gedachten te wisselen, geen Monopoly of Karl Marx' boek, maar video's, teksten, interactieve installaties, getuigenissen en animaties.\r\n\r\nHet project, dat ge\u00ebngageerd maar niet partizaan is, vertrekt vanuit het kader van permanente vorming en is vooral gebaseerd op uitwisselingen tijdens rondleidingen die worden georganiseerd voor scholen, verenigingen en bezoekerspubliek.\r\n\r\nIndividuele bezoeken worden natuurlijk ook georganiseerd en zijn net zo stimulerend bedoeld, met name dankzij de brochures die beschikbaar zijn in het Frans, Nederlands, Engels, Spaans, Duits, Arabisch en Italiaans. Onze wens is dat, aan het einde van het bezoek, elke persoon beter uitgerust vertrekt om zich ten volle te laten gelden in zijn burgerschap.\r\n\r\nTot nu toe hebben meer dan 25.000 mensen de tentoonstelling bezocht, evenals honderden scholen, gedurende 14 etappes: Namen (2014), Sint-Gillis (2015), Gent (2015), Laken (2016), Bergen (2017), Anderlecht (2018), Luik (2018), Aarlen (2018), Louvain-la-Neuve (2019), Moeskroen (2019), Brussel-Stad (2019), Gembloux (2019), Rochefort (2019), Verviers (2020), Charleroi (2021), Beauraing en Welkenraedt (2022).\r\n\r\nPraktische informatie :\r\nData : Van 18 augustus tot 23 september 2022\r\nLocatie: Zinneke, Masuiplaats 13, 1000 Brussel\r\nTrein : Brussel-Noord Tram : Masui lijn 3, 55, 93 & Thomas lijn 4, 25. Bus : Masui lijn 58, N18.\r\n\r\nOpeningstijden: donderdag en vrijdag van 10.00 tot 17.00 uur en zaterdag en zondag van 13.00 tot 19.00 uur. In september ook open op woensdag van 10.00 tot 17.00. Elke donderdag museumnocturnes.\r\n\r\nToegang aan vrije bijdrage\r\n\r\nReservering of info: contact@museeducapitalisme.org 0472\/51.24.84 Website : www.museeducapitalisme.org","performers":null,"boxoffice_url":null,"website":"https:\/\/museeducapitalisme.org\/nl\/homepage-2\/","email":"contact@kapitalismemuseum.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539002"},"en":{"name":"A Museum of Capitalism in Brussels!","shortdescr":"From 18th August to 23rd September 2022, a Museum of Capitalism is set up on the border of City of Brussels and Schaerbeek, in the workplace of Zinneke. The aim is to offer a space for reflection and discussion on this complex system that structures our lives, and to present alternatives that exist in Belgium.","longdescr":"From 18th August to 23rd September 2022, a Museum of Capitalism is set up on the border of City of Brussels and Schaerbeek, in the workplace of Zinneke.\r\n\r\nCreated in 2012 by a collective of citizens, the association Mus\u00e9e du Capitalisme covers various initiatives including a travelling and bilingual (NL\/FR) exhibition on our economic and cultural system, accessible to the general public from the age of 15.\r\n\r\nThe aim is to offer a space for reflection and discussion on this complex system that structures our lives, and to present alternatives that exist in Belgium. What can be found in the Museum of Capitalism? Origins, hopes, limits and alternatives to capitalism: the four rooms of the exhibition return to the fundamentals of a system often mentioned but rarely explained. Capitalism is discussed in relation to various themes such as food, health, culture, consumption, the environment, finance, etc.\r\n\r\nTo allow visitors to exchange on these subjects, no Monopoly or Karl Marx's book, but rather videos, texts, interactive installations, testimonies and animations.\r\n\r\nThe project, which is engaging but non-partisan, is part of a life-long educative approach and is above all based on exchanges during guided tours organised for schools, associations and the general public.\r\n\r\nIndividual visits are of course also organised and are intended to be just as stimulating, thanks in particular to brochures available in French, Dutch, English, Spanish, German, Arabic and Italian. Our wish is that, at the end of the visit, each person leaves better equipped to assert themselves fully in their citizenship. To date, more than 25,000 people have visited the exhibition, as well as hundreds of schools, during 14 stages: Namur (2014), Saint-Gilles (2015), Ghent (2015), Laeken (2016), Mons (2017), Anderlecht (2018), Li\u00e8ge (2018), Arlon (2018), Louvain-la-Neuve (2019), Mouscron (2019), Brussels-City (2019), Gembloux (2019), Rochefort (2019), Charleroi (2021), Beauraing and Welkenraedt (2022).\r\n\r\nPractical information :\r\nDates : From 6 January to 21 March 2021\r\nLocation: See U (above the Kinograph) Avenue de la Couronne, 227 1050 Ixelles\r\nBus 95 and N08; Trams 7 and 25; Etterbeek Station\r\n\r\nOpening hours: Thursdays and Fridays from 10am to 5pm and Saturdays and Sundays from 1pm to 7pm. In September also open on Wednesdays from 10am to 5pm. Every Thursdays: nocturn events.\r\n\r\nAdmission at free contribution\r\n\r\nReservations & info: contact@museeducapitalisme.org 0472\/51.24.84 Website : www.museeducapitalisme.org","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539002"},"de":{"name":"Le Mus\u00e9e du Capitalisme est \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539002"},"it":{"name":"Le Mus\u00e9e du Capitalisme est \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539002"},"sp":{"name":"Le Mus\u00e9e du Capitalisme est \u00e0 Bruxelles","short