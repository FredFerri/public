/www.bfe.be","phone_contact":"+32 2 474 84 85","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Place de Belgique, 1","address_line2":"1020 Laeken","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Brussels Fairs and Exhibitions","address_street_name":"Place de Belgique","address_street_number":"1","address_street_box":null,"email":"bfe@bfe.be","website":"http:\/\/www.bfe.be","phone_contact":"+32 2 474 84 85","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Place de Belgique, 1","address_line2":"1020 Laeken","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Brussels Fairs and Exhibitions","address_street_name":"Place de Belgique","address_street_number":"1","address_street_box":null,"email":"bfe@bfe.be","website":"http:\/\/www.bfe.be","phone_contact":"+32 2 474 84 85","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Place de Belgique, 1","address_line2":"1020 Laeken","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Brussels Fairs and Exhibitions","address_street_name":"Place de Belgique","address_street_number":"1","address_street_box":null,"email":"bfe@bfe.be","website":"http:\/\/www.bfe.be","phone_contact":"+32 2 474 84 85","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Place de Belgique, 1","address_line2":"1020 Laeken","description_web":"Brussels Fairs &amp; Exhibitions (BFE) est une entreprise cr\u00e9\u00e9e en 1919 et sp\u00e9cialis\u00e9e dans l\u2019organisation de foires et salons, tant professionnels que grand public.   Tous les aspects li\u00e9s \u00e0 l\u2019organisation d\u2019une manifestation comme l\u2019\u00e9tude du march\u00e9, la valorisation des exposants, la campagne publicitaire, l\u2019accueil des visiteurs, la d\u00e9coration des espaces,... y sont g\u00e9r\u00e9s par une \u00e9quipe dynamique.   Artexis is the Belgian market leader in the management of exhibition halls and conference centres and in the organization of trade fairs.  The meeting places are our halls: modern and technologically well equipped, but they are also welcoming places, which in time will have to be CO2 neutral.  The marketplaces are our trade fairs that must be the reference point in their sector.   Our values \u2022 Efficiency  Professional principles and actions  \u2022 Creativity and innovation  Devising new paths and innovating  \u2022 Commitment Commitment with a passion that constantly renews itself \u2022 Results-driven Our resolve to analyse the outcome of our efforts, to measure our results against those originally predicted \u2022 Team spirit  The will to work together and with the other parties to achieve more  \u2022 Environmental awareness  Creating value but being less demanding of the environment  \u2022 Integrity  Acting with respect and keeping promises  \u2022 Having fun  Sharing impressions and emotions and enjoying moments that are warm and intense","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Brussels Fairs and Exhibitions","address_street_name":"Place de Belgique","address_street_number":"1","address_street_box":null,"email":"bfe@bfe.be","website":"http:\/\/www.bfe.be","phone_contact":"+32 2 474 84 85","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Place de Belgique, 1","address_line2":"1020 Laeken","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brussels Fairs and Exhibitions","address_street_name":"Belgi\u00ebplein","address_street_number":"1","address_street_box":null,"email":"bfe@bfe.be","website":"http:\/\/www.bfe.be","phone_contact":"+32 2 474 84 85","phone_booking":null,"address_zip":"1020","address_city":"Laken","address_line1":"Belgi\u00ebplein, 1","address_line2":"1020 Laken","description_web":"Brussels Fairs &amp; Exhibitions (BFE) is een bedrijf opgericht in 1919 en gespecialiseerd in de organisatie van beurzen en tentoonstellingen, zowel voor professionelen als voor het grote publiek.   Alle aspecten in verband met de organisatie van een manifestatie zoals marktstudies, valorisatie van exposanten, publiciteitscampagnes, onthaal van de bezoekers, decoratie van de ruimtes, ... worden er door een dynamische ploeg beheerd.   Artexis is the Belgian market leader in the management of exhibition halls and conference centres and in the organization of trade fairs.  The meeting places are our halls: modern and technologically well equipped, but they are also welcoming places, which in time will have to be CO2 neutral.  The marketplaces are our trade fairs that must be the reference point in their sector.   Our values \u2022 Efficiency  Professional principles and actions  \u2022 Creativity and innovation  Devising new paths and innovating  \u2022 Commitment Commitment with a passion that constantly renews itself \u2022 Results-driven Our resolve to analyse the outcome of our efforts, to measure our results against those originally predicted \u2022 Team spirit  The will to work together and with the other parties to achieve more  \u2022 Environmental awareness  Creating value but being less demanding of the environment  \u2022 Integrity  Acting with respect and keeping promises  \u2022 Having fun  Sharing impressions and emotions and enjoying moments that are warm and intense","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":25076,"location":{"lat":50.89920982,"lon":4.33763291},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2016-01-12T16:49:09+