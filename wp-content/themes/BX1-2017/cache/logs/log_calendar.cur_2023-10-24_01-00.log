\u00e9es sont une c\u00e9l\u00e9bration de la couleur rose, symbole de f\u00e9minit\u00e9, de douceur, de tendresse, de romance, mais surtout d'optimisme pour les victimes de cancers. L'art comme moteur d'espoir pour l'avenir.\n\nLa galerie, en partenariat avec la fondation Fournier-Majoie, encourage par l\u2019interm\u00e9diaire des peintures et des dessins pr\u00e9sent\u00e9s, \u00e0 la conversation et \u00e0 la compr\u00e9hension de ces maladies qui touchent malheureusement encore beaucoup trop de femmes.\n10 % de chaque \u0153uvre seront revers\u00e9s de la part des artistes et de la galerie \u00e0 deux programmes de recherche : `Chasser les nuages\u2019 et `La cape d\u2019invisibilit\u00e9\u2019.","performers":null,"boxoffice_url":null,"website":"https:\/\/alienorprouvost.com\/","email":"ap@alienorprouvost.com","phone_contact":"+32 477 93 23 06","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002686"},"sp":{"name":"Exposition ROSE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/alienorprouvost.com\/","email":"ap@alienorprouvost.com","phone_contact":"+32 477 93 23 06","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002686"},"nl":{"name":"Exposition ROSE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/alienorprouvost.com\/","email":"ap@alienorprouvost.com","phone_contact":"+32 477 93 23 06","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002686"}},"place":{"id":276427,"translations":{"de":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Washington