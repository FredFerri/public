ers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/fr-brussel-velo\/fr-programme-ete","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012850"},"it":{"name":"Gegidste fietstocht - Brussel en haar kerkhoven","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/fr-brussel-velo\/fr-programme-ete","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012850"},"cn":{"name":"Gegidste fietstocht - Brussel en haar kerkhoven","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/fr-brussel-velo\/fr-programme-ete","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012850"},"fr":{"name":"Tour guid\u00e9 \u00e0 v\u00e9lo - Bruxelles et ses cimeti\u00e8res","shortdescr":"Profitez de l'\u00e9t\u00e9 \u00e0 Bruxelles et enfourchez votre v\u00e9lo! Laissez-vous surprendre et red\u00e9couvrez Bruxelles \u00e0 v\u00e9lo en juillet et ao\u00fbt avec nos tours \u00e0 v\u00e9lo estivaux. ","longdescr":"Un tour d\u00e9di\u00e9 aux cimeti\u00e8res de Bruxelles: uniques dans leur genre, atypiques par leur taille et leur paysagisme, reposants par leur nature ils n\u2019attendent que vous (vivant.e.s !). Nous p\u00e9dalerons vers Laeken pour visiter ses cryptes, avant de bifurquer vers Evere et son cimeti\u00e8re de Bruxelles pour finir par le cimeti\u00e8re du Dieweg \u00e0 Uccle. Lieux de culte, de repos, bien souvent au milieu d\u2019une v\u00e9g\u00e9tation luxuriante, ce tour est propice \u00e0 la r\u00eaverie et l\u2019\u00e9merveillement Un arr\u00eat pique-nique est pr\u00e9vu.","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/fr-brussel-velo\/fr-programme-ete","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012850"},"sp":{"name":"Gegidste fietstocht - Brussel en haar kerkhoven","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/fr-brussel-velo\/fr-programme-ete","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012850"},"nl":{"name":"Gegidste fietstocht - Brussel en haar kerkhoven","shortdescr":"Spring op je fiets en geniet van de zomer in Brussel! Laat je verrassen en herontdek Brussel met de fiets in juli en augustus met onze zomerfietstours.\n","longdescr":"Een tocht gewijd aan de Brusselse begraafplaatsen: uniek in hun soort, atypisch in hun grootte en landschapsinrichting, en rustgevend in hun aard, ze wachten gewoon op u (levend!). We fietsen naar Laken om de grafkelders te bezoeken, alvorens af te buigen naar Evere en de Brusselse begraafplaats en te eindigen op de begraafplaats Dieweg in Ukkel. Plaatsen van aanbidding en rust, vaak omgeven door weelderige vegetatie, deze tocht is ideaal om te dagdromen en te verwonderen. Een picknickstop is gepland.","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/fr-brussel-velo\/fr-programme-ete","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012850"}},"place":{"id":277608,"translations":{"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Brussels","description_web":"Cactus Brussel \u00e0 v\u00e9lo is an association of local volunteer guides with a passion for Brussels and cycling. They enthusiastically share their passion for the city and cycling with visitors to Brussels and other Brussels residents. On their bikes they find the right pace to immerse you in the city and offer an authentic Brussels experience. Above all, they prefer to guide you off the beaten track in a friendly atmosphere. Experience Brussels in all its splendour by bike and discover more than you think.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":