dress_city":"Li\u00e8ge","address_line1":"Avenue C. de Gerlache, 41","address_line2":"4000 Li\u00e8ge","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Image & 3D Europe","address_street_name":"Avenue C. de Gerlache","address_street_number":"41","address_street_box":null,"email":"alexandra@3dstereomedia.eu","website":null,"phone_contact":"+32 4 233 62 97","phone_booking":null,"address_zip":"4000","address_city":"Li\u00e8ge","address_line1":"Avenue C. de Gerlache, 41","address_line2":"4000 Li\u00e8ge","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Image & 3D Europe","address_street_name":"Avenue C. de Gerlache","address_street_number":"41","address_street_box":null,"email":"alexandra@3dstereomedia.eu","website":null,"phone_contact":"+32 4 233 62 97","phone_booking":null,"address_zip":"4000","address_city":"Li\u00e8ge","address_line1":"Avenue C. de Gerlache, 41","address_line2":"4000 Li\u00e8ge","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Image & 3D Europe","address_street_name":"Avenue C. de Gerlache","address_street_number":"41","address_street_box":null,"email":"alexandra@3dstereomedia.eu","website":null,"phone_contact":"+32 4 233 62 97","phone_booking":null,"address_zip":"4000","address_city":"Li\u00e8ge","address_line1":"Avenue C. de Gerlache, 41","address_line2":"4000 Li\u00e8ge","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":23113,"location":{"lat":50.6147253,"lon":5.5712668},"region":"wallonia","last_updated_at":"2022-10-11T04:06:15+02:00","published_at":"2015-10-27T12:27:54+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/4e472feb783dd20227baff7ebfe0b28d3c5db1c7.png","width":1920,"height":1080,"ratio":1.78,"translations":{"fr":{"title":"Brussels Virtual Week","copyright":null},"nl":{"title":"Brussels Virtual Week","copyright":null},"en":{"title":"Brussels Virtual Week","copyright":null}}}],"dates":[{"day":"2022-10-17","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-18","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-19","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T04:06:15+02:00","published_at":"2022-09-15T11:23:00+02:00","backoffice_id":261909,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.69336127435063},{"id":541435,"date_start":"2022-10-18","date_end":"2022-10-18","date_next":"2022-10-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"],"de":["Pop, Rock, Jazz...","Pop, Rock"]}}},"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"translations":{"fr":{"name":"ANNUL\u00c9 No Angry Young Man - Release Party \/ concert","shortdescr":"No Angry Young Man est de retour en force ! Le tout nouvel album 'Rise Again' est le troisi\u00e8me disque du groupe. Pendant le covid, les membres du groupe ont d\u00e9m\u00e9nag\u00e9 dans une cabane isol\u00e9e dans les Ardennes o\u00f9 ils ont tranquillement travaill\u00e9 sur ce successeur.","longdescr":"No Angry Young Man est de retour en force ! Le tout nouvel album 'Rise Again' est le troisi\u00e8me disque du groupe. Lors d'une pause covid, les membres du groupe se sont install\u00e9s dans une cabane isol\u00e9e des Ardennes o\u00f9 ils ont tranquillement travaill\u00e9 sur ce successeur.\r\n\r\nL'\u00e9vasion tout au long des chansons est soigneusement entrelac\u00e9e avec les arrangements et le r\u00e9sultat sonne \u00e9tonnamment estival et frais. Sept chansons tr\u00e8s diverses ont atteint la ligne d'arriv\u00e9e. Avec ce disque, leur chanteur Jeroen Van Ham est \u00e0 nouveau sous les projecteurs et il a pu compter sur ses compagnons de route : Pieter Hulst au violoncelle et Johan Loeckx aux claviers. \"Apr\u00e8s Paris Rains (\u00e0 partir de 2013), tout le monde cherchait du temps pour faire son propre truc, mais nous avons continu\u00e9 \u00e0 nous voir \u00e0 travers des projets parall\u00e8les et une chose en a entra\u00een\u00e9 une autre...\", raconte Jeroen. No Angry Young Man est avant tout une bande de potes, 20 musiciens accompagnent le nouvel album. \r\n\r\nNo Angry Young Man a d\u00e9j\u00e0 jou\u00e9 sur plus de 200 sc\u00e8nes en Flandre, en Wallonie et aux Pays-Bas. \u00c0 l'automne, ils partiront en tourn\u00e9e avec le nouvel album.\r\n\r\nSite Web : www.naym.be\r\ntickets : https:\/\/www.eventbrite.com\/e\/no-angry-young-man-rise-again-release-party-tickets-416080075707","performers":"No Angry Young Man \r\nJeroen Van Ham - chant \/ guitare \r\nJohan Loeckx - Piano \r\nPieter Hulst - Violoncelle\r\nPeter Verhaegen - Basse\r\nTim Paredaens - Batterie","boxoffice_url":null,"website":"http:\/\/www.naym.be","email":"booking@naym.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541435"},"nl":{"name":"UITGESTELD No Angry Young Man - Release Party \/ concert","shortdescr":"\u200b\u200bNo Angry Young Man is terug van weggeweest! Het gloednieuwe album \u2018Rise Again\u2019 is de derde plaat van de band. Tijdens covid trokken de bandleden naar een afgelegen hut in de Ardennen waar ze in alle stilte aan deze opvolger werkten.","longdescr":"\u200b\u200bNo Angry Young Man is terug van weggeweest! Het gloednieuwe album \u2018Rise Again\u2019 is de derde plaat van de band. Tijdens een welverdiende covid- pauze trokken de bandleden naar een afgelegen hut in de Ardennen waar ze in alle stilte aan deze opvolger werkten. \r\n\r\nHet \u2018escapisme\u2019 doorheen de songs wordt op een zorgvuldige manier verweven met de arrangementen en het resultaat klinkt verrassend zomers en fris. Zeven zeer diverse songs haalde de eindstreep.  Met deze plaat staat frontman Jeroen Van Ham opnieuw in de spotlight en kon hij rekenen op zijn compagnons de route : Pieter Hulst op cello en Johan Loeckx op toetsen. \u201cNa Paris Rains (uit 2013) zocht iedereen tijd om zijn eigen ding te doen, maar we zijn elkaar blijven zien via zijprojecten en van het \u00e9\u00e9n kwam het ander \u2026\u201d  aldus Jeroen. No Angry Young Man is op de eerste plaats een groep vrienden, zo spelen er 20 muzikanten mee op het nieuwe album. Het handelsmerk van de band blijven de klassieke instrumenten die zorgvuldig verstopt zitten in gelaagde popsongs. \r\n\r\nNo Angry Young Man speelde al op meer dan 200 podia in Vlaanderen, Walloni\u00eb en Nederland. In het najaar gaan ze op tournee met het nieuwe album. \r\n\r\n\u200b\u200bWebsite: www.naym.be\r\ntickets : https:\/\/www.eventbrite.com\/e\/no-angry-young-man-rise-again-release-party-tickets-416080075707","performers":"No Angry Young Man \r\nJeroen Van Ham - zang \/ gitaar \r\nJohan Loeckx - Piano \r\nPieter Hulst - Cello \r\nPeter Verhaegen - Bass\r\nTim Paredaens - Drum","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Noangryyoungman","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541435"},"en":{"name":"POSTPONED No Angry Young Man - Release Party \/ concert","shortdescr":"No Angry Young Man is back! The brand new album 'Rise Again' is the band's third record. During covid, the band members moved to a remote cabin in the Ardennes where they quietly worked on this successor.","longdescr":"No Angry Young Man is back! The brand new album 'Rise Again' is the band's third record. During  covid, the band members moved to a remote hut in the Ardennes where they quietly worked on this successor.\r\n\r\nThe 'escapism' throughout the songs is carefully interwoven with the arrangements and the result sounds surprisingly summery and fresh. Seven very diverse songs made it to the finish line. With this record, frontman Jeroen Van Ham is once again in the spotlight and he could count on his companions de route: Pieter Hulst on cello and Johan Loeckx on keys. \u201cAfter Paris Rains (from 2013), everyone was looking for time to do their own thing, but we kept seeing each other through side projects and one thing led to another \u2026\u201d says Jeroen. No Angry Young Man is first and foremost a group of friends, 20 musicians play along on the new album. The band's trademark remains the classical instruments carefully hidden in layered pop songs.\r\n\r\nNo Angry Young Man has already played on more than 200 stages in Flanders, Wallonia and the Netherlands. In the fall they will tour with the new album.\r\n\r\nWebsite: www.naym.be\r\ntickets : https:\/\/www.eventbrite.com\/e\/no-angry-young-man-rise-again-release-party-tickets-416080075707","performers":"No Angry Young Man \r\nJeroen Van Ham - Lead vocal \/ guitar \r\nJohan Loeckx - Piano \r\nPieter Hulst - Cello \r\nPeter Verhaegen - Bass\r\nTim Paredaens - Drums","boxoffice_url":null,"website":"https:\/\/open.spotify.com\/artist\/5t8uzN3qMpQXyMWBVQ8fxW?si=lgkKPLYLSXKIg96KOW58Ag","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541435"},"de":{"name":"No Angry Young Man - Release Party \/ concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541435"},"it":{"name":"No Angry Young Man - Release Party \/ concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541435"},"sp":{"name":"No Angry Young Man - Release Party \/ concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541435"},"pt":{"name":"No Angry Young Man - Release Party \/ concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541435"},"cn":{"name":"No Angry Young Man - Release Party \/ concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541435"}},"place":{"id":245494,"translations":{"fr":{"name":"Au Bassin","address_street_name":"Quai aux Briques","address_street_number":null,"address_street_box":null,"email":"info@aubassin.be","website":"https:\/\/aubassin.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai aux Briques","address_line2":"1000 Bruxelles","description_web":"Ce ex-ViaVia Caf\u00e9 est un point de rencontres pour les Bruxellois et les visiteurs de la ville. Sur la carte jus, caf\u00e9 et bi\u00e8res biologiques, une gamme de th\u00e9s surprenante et des cocktails (essayez le pisco sour contest\u00e9 par les Chiliens et les P\u00e9ruviens !) Vous pouvez y d\u00e9guster une bonne \u201cpinte\u201d belge et tous les classiques n\u00e9cessaires, mais laissez-vous aussi surprendre par des sp\u00e9cialit\u00e9s bruxelloises comme la Zinnebir et les bi\u00e8res de Brussels Beer Project et la Brasserie de la Senne. \u2026Pour les petit creux, il y a une petite s\u00e9lection de finger food.\r\nLe lieu se pr\u00eate \u00e0 toutes sortes d'\u00e9v\u00e9nements: march\u00e9s aux plantes, jams, ap\u00e9ros, stand-up comedy et sets DJ. Les fumeurs ont \u00e9t\u00e9 g\u00e2t\u00e9s avec une terrasse int\u00e9rieure. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Au Bassin","address_street_name":"Baksteenkaai","address_street_number":null,"address_street_box":null,"email":"info@aubassin.be","website":"https:\/\/aubassin.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Baksteenkaai","address_line2":"1000 Brussel","description_web":"Dit ex-ViaVia caf\u00e9 kan rekenen op een divers publiek dat bestaat uit een mix van stadsbewoners en stadsbezoekers.  Op de drankenkaart biologische sapjes, koffie en bier, cocktails (probeer de door Chilenen en Peruvianen betwiste pisco sour), een aantrekkelijke selectie aan exotische theesoorten en ook Brusselse specialiteiten zoals het bekende Zinnebir en het aanbod van Brussels Beer Project en Brasserie de la Senne. Voor de kleine honger is er een beperkte selectie finger food. De locatie leent zich tot allerlei evenementen, van plantenmarkten tot jams, afterworks tot stand-up comedy... en af en toe een dj-set in het caf\u00e9.  De rokers werden verwend met een binnenterras. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Au Bassin","address_street_name":"Quai aux Briques","address_street_number":null,"address_street_box":null,"email":"info@aubassin.be","website":"https:\/\/aubassin.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Quai aux Briques","address_line2":"1000 Brussels","description_web":"What started out as a travelers caf\u00e9 in Brussels grew to become a unique meeting place, multilingual and open to both townsfolk and people visiting Brussels. Travel books are there to inspire you for a future adventure, and board games contribute to good old school human contact. The offer includes an extensive organic range of drinks and a spectacular homemade ginger ale. But also local specialities like the famous Zinnebir and a selection of Brussels Beer Project star at the menu. For the hungry there are \"quiches\" (meat and vegetable pies) and the typical \"croques monsieur\" (crispy hot ham en cheese sandwiches), soupes and cheesecake for dessert. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Au Bassin","address_street_name":"Quai aux Briques","address_street_number":null,"address_street_box":null,"email":"info@aubassin.be","website":"https:\/\/aubassin.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai aux Briques","address_line2":"1000 Bruxelles","description_web":"Das Caf\u00e9 Au Bassin ist der Treffpunkt f\u00fcr Einheimische und Touristen schlechthin. Auf der Getr\u00e4nkekarte stehen Saft, Kaffee und Bio-Biersorten, duftende Teesorten und k\u00f6stlichen Cocktails (probieren Sie unbedingt auch den Pisco Sour nach peruanischer und chilenischer Art). G\u00f6nnen Sie sich ein klassisches belgisches Bier oder lassen Sie sich von den originellen Br\u00fcsseler Bierspezialit\u00e4ten \u00fcberraschen, wie z. B. das Zinnebir oder die Biere des Brussels Beer Project oder der Brasserie de la Senne. F\u00fcr den kleinen Appetit gibt es eine kleine Auswahl an Fingerfood. \r\nDas Au Bassin eignet sich f\u00fcr ganz vielf\u00e4ltige Veranstaltungen: von Pflanzenm\u00e4rkten \u00fcber Jam Sessions, Afterwork-Veranstaltungen und Stand-up-Comedy bis hin zu Partys mit DJ. \r\nRaucher k\u00f6nnen ihrem Laster auf der Innenterrasse fr\u00f6hnen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Au Bassin","address_street_name":"Quai aux Briques","address_street_number":null,"address_street_box":null,"email":"info@aubassin.be","website":"https:\/\/aubassin.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai aux Briques","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Au Bassin","address_street_name":"Quai aux Briques","address_street_number":null,"address_street_box":null,"email":"info@aubassin.be","website":"https:\/\/aubassin.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai aux Briques","address_line2":"1000 Bruxelles","description_web":"Lo que comenz\u00f3 como un caf\u00e9 de viajeros en Bruselas se convirti\u00f3 en un lugar de reuni\u00f3n \u00fanico, multiling\u00fce y abierto tanto para la gente de la ciudad como para los que visitan Bruselas. La oferta incluye una amplia gama de bebidas org\u00e1nicas y una espectacular ginger ale casera. Pero tambi\u00e9n hay especialidades locales como el famoso Zinnebir y en el men\u00fa una selecci\u00f3n de cervezas estrella del Brussels Beer Project. Para los hambrientos hay una peque\u00f1a selecci\u00f3n de tapas. El lugar se presta a todo tipo de eventos: mercados de plantas, jams, afterworks, comedia stand-up... y el ocasional set de DJ en el caf\u00e9.  Los fumadores disfrutan de la terraza interior. ","descrip