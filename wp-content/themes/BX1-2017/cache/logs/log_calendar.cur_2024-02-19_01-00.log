"https:\/\/ras-el-hanout.be\/spectacle\/li-fet-met\/","email":"info@ras-el-hanout.be","phone_contact":"+32 2 256 76 80","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007254"},"fr":{"name":"Li Fet Met","shortdescr":"Relation interg\u00e9n\u00e9rationnelles \u2013 pr\u00e9jug\u00e9s \u2013 famille \u2013 immigration \u2013 th\u00e9\u00e2tre-forum","longdescr":"La vie quotidienne dans les familles issues de l\u2019immigration ?\n\nIl y a le papa qui n\u2019est pas l\u00e0, la maman qui fait tout, le fils qui n\u2019est jamais content, le grand p\u00e8re qui est de trop, l\u2019une qui veut son bien, une autre qui veut \u00e0 tout prix \u00abr\u00e9ussir\u00bb, et encore un autre qui n\u2019a rien \u00e0 dire, car Li Fet Met, le pass\u00e9 est mort.\n\nLes com\u00e9dien(ne)s vous invitent \u00e0 une rencontre interg\u00e9n\u00e9rationnelle et interculturelle, au travers de multiples interludes et interrogations. Et gr\u00e2ce au th\u00e9\u00e2tre-forum, c\u2019est une pi\u00e8ce de th\u00e9\u00e2tre dans laquelle le public intervient pour changer le cours de l\u2019histoire.","performers":"Jou\u00e9 par la troupe de th\u00e9\u00e2tre-action de Ras El Hanout ","boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/li-fet-met\/","email":"info@ras-el-hanout.be","phone_contact":"+32 2 256 76 80","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007254"},"sp":{"name":"Li Fet Met","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/li-fet-met\/","email":"info@ras-el-hanout.be","phone_contact":"+32 2 256 76 80","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007254"},"nl":{"name":"Li Fet Met","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/li-fet-met\/","email":"info@ras-el-hanout.be","phone_contact":"+32 2 256 76 80","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007254"}},"place":{"id":280007,"translations":{"de":{"name":" Ras El Hanout","address_street_name":"Rue du ruisseau 17-19","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"https:\/\/ras-el-hanout.be\/","phone_contact":"+32 488 01 14 11","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue du ruisseau 17-19, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":" Ras El Hanout","address_street_name":"Rue du ruisseau 17-19","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"https:\/\/ras-el-hanout.be\/","phone_contact":"+32 488 01 14 11","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue du ruisseau 17-19, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":" Ras El Hanout","address_street_name":"Rue du ruisseau 17-19","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"https:\/\/ras-el-hanout.be\/","phone_contact":"+32 488 01 14 11","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue du ruisseau 17-19, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":" Ras El Hanout","address_street_name":"Rue du ruisseau 17-19","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"https:\/\/ras-el-hanout.be\/","phone_contact":"+32 488 01 14 11","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue du ruisseau 17-19, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":" Ras El Hanout","address_street_name":"Rue du ruisseau 17-19","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"https:\/\/ras-el-hanout.be\/","phone_contact":"+32 488 01 14 11","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue du ruisseau 17-19, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":" Ras El Hanout","address_street_name":"Rue du ruisseau 17-19","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"https:\/\/ras-el-hanout.be\/","phone_contact":"+32 488 01 14 11","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue du ruisseau 17-19, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Ras El Hanout fut fond\u00e9e en 2010 par un groupe d\u2019amis bruxellois croyant au th\u00e9\u00e2tre comme moyen d\u2019\u00e9mancipation et de dialogue. Le nom de Ras El Hanout d\u00e9signe en arabe un m\u00e9lange d\u2019\u00e9pices venues du monde entier et signifie litt\u00e9ralement \u201cLa t\u00eate de l\u2019\u00e9picerie\u201d. Ce m\u00e9lange est r\u00e9put\u00e9 \u00eatre le meilleur et symbolise le caract\u00e8re enrichissant du brassage des cultures, et son go\u00fbt piquant rappelle notre d\u00e9marche engag\u00e9e.\r\n\r\nL\u2019association est une actrice de d\u00e9mocratie et de d\u00e9mocratisation culturelle qui m\u00e8ne des activit\u00e9s d'\u00e9ducation permanente, d'expression \u00e0 la cr\u00e9ativit\u00e9 et de cr\u00e9ation artistique amateure et professionnelle, dans une optique d'empowerment et de coh\u00e9sion sociale.\r\n\r\nAu fil des ann\u00e9es, l\u2019association s\u2019est professionnalis\u00e9e, pour en arriver \u00e0 une r\u00e9partition claire de ses activit\u00e9s en 4 axes :\r\n1. L\u2019\u00c9ducation permanente : donner du sens avec des moments collectifs de r\u00e9flexion, de d\u00e9bats et d\u2019\u00e9mancipation. Axe pour lequel l\u2019association est reconnue depuis 2021, et dans le cadre duquel s\u2019inscrivent entre autres nos spectacles de th\u00e9\u00e2tre-action.\r\n2. L\u2019Expression et Cr\u00e9ativit\u00e9 : donner acc\u00e8s \u00e0 la culture en formant \u00e0 des pratiques artistiques permettant de s\u2019exprimer. Axe pour lequel l\u2019association est en proc\u00e9dure de demande de reconnaissance. C\u2019est notamment via des projets socio-artistiques de cet axe que sont cr\u00e9\u00e9es certaines cr\u00e9ations collectives de th\u00e9\u00e2tre amateur.\r\n3. Le Th\u00e9\u00e2tre amateur : donner \u00e0 des artistes autodidactes et des jeunes issu\u00b7es des quartiers populaires la possibilit\u00e9 de se produire sur sc\u00e8ne, et d\u2019acqu\u00e9rir les outils pour se professionnaliser si ils et elles le souhaitent. Cet axe accueille aussi la diffusion de certains projets des deux premiers axes lorsqu\u2019ils se poursuivent et sortent d\u00e8s lors du cadre des d\u00e9crets.\r\n4. Les Arts de la sc\u00e8ne : produire la culture, en tant que sujet et pas objet, pour cr\u00e9er du lien dans la soci\u00e9t\u00e9 et \u00e9veiller des consciences. Axe pour lequel Ras EL Hanout est reconnue depuis 2018 par circulaire minist\u00e9rielle comme compagnie de th\u00e9\u00e2tre professionnelle. Il inclut les projets d\u2019artistes professionnel\u00b7les qu\u2019ils et elles cr\u00e9ent de la recherche \u00e0 repr\u00e9sentation, mais il inclut aussi des reprises par des com\u00e9dien\u00b7nes professionnel\u00b7les de textes \u00e9crits dans le cadre de nos activit\u00e9s d\u2019\u00c9ducation Permanente et d'Expression et cr\u00e9ativit\u00e9. De plus, de nombreuses cr\u00e9ations artistiques professionnelles de ce 4\u00e8me axe trouvent leur point de d\u00e9part (\u00e9motionnelle, th\u00e9matiques, etc.) dans les t\u00e9moignages, r\u00e9cits et d\u00e9bats qui ont \u00e9man\u00e9 des activit\u00e9s d\u2019\u00c9ducation Permanente et d'Expression et cr\u00e9ativit\u00e9.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":" Ras El Hanout","address_street_name":"Rue du ruisseau 17-19","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"https:\/\/ras-el-hanout.be\/","phone_contact":"+32 488 01 14 11","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue du ruisseau 17-19, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":" Ras El Hanout","address_street_name":"Rue du ruisseau 17-19","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"https:\/\/ras-el-hanout.be\/","phone_contact":"+32 488 01 14 11","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue du ruisseau 17-19, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[23],"translations":{"de":["Westen"],"pt":[null],"en":["West"],"it":["Ovest"],"cn":[null],"fr":["Ouest"],"sp":["Oeste"],"nl":["West"]}},"neca":null,"facebook_id":null,"backoffice_id":40007,"location":{"la