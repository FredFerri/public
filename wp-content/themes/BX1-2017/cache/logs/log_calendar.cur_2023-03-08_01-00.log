as"],"pt":[null],"cn":[null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-07T02:35:36+01:00","published_at":"2023-01-03T08:58:44+01:00","backoffice_id":268312,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.15142671606934},{"id":550474,"date_start":"2023-03-14","date_end":"2023-03-14","date_next":"2023-03-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[4,8],"translations":{"fr":["Pop, rock, jazz\u2026","Chanson"],"nl":["Pop, rock, jazz\u2026","Chanson"],"en":["Pop, rock, jazz\u2026","Song"],"de":["Pop, Rock, Jazz...","Chanson"],"it":["Pop, rock, jazz\u2026","Canzone"],"sp":["Pop, rock, jazz\u2026","Canci\u00f3n francesa"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Nuances de et par Marion Coussineau","shortdescr":"Seule avec sa basse, Marion Cousineau apporte une touche musicale rare dans le monde de la chanson fran\u00e7aise, pour ne pas dire in\u00e9dite.\u200b","longdescr":"Seule avec sa basse, Marion Cousineau apporte une touche musicale rare dans le monde de la chanson fran\u00e7aise, pour ne pas dire in\u00e9dite.\u200b\r\n\r\nL'artiste franco-canadienne offre \u00e0 son public un spectacle d'une qualit\u00e9 inhabituelle, entre tendresse et humour,\r\nentre phras\u00e9 intime et instruments vari\u00e9s pour donner une dimension \u00e0 son art foutument bien enlev\u00e9.\r\nOn touche au grand art, par le biais de sonorit\u00e9s nouvelles qui se m\u00ealent \u00e0 l\u2019intelligence des textes et aux trouvailles musicales.\r\n\r\nRencontr\u00e9e sur toutes les sc\u00e8nes des festivals de chansons frtan\u00e7aise de l'Hexagone, Marion Cousineau fait une incursion \u00e0 Bruxelles pour un soir entre amis. Laur\u00e9ate de plusieurs concours et reconnue par tous les sp\u00e9cialistes du genre,\r\non se souvient que la grande Anne Sylvestre ne s'y \u00e9tait pas tromp\u00e9e qui avait d\u00e9cid\u00e9 de devenir sa marraine de coeur dans le monde artistique.\r\n\r\nSur sc\u00e8ne, son geste geste est celui d'une interpr\u00e8te en le frottant \u00e0 diff\u00e9rentes formes d'art de la sc\u00e8ne (clown, conte, th\u00e9\u00e2tre physique, cirque\u2026).\r\n\r\nA La Clarenci\u00e8re pour une soir\u00e9e unique","performers":"de et par Marion Coussineau en tourn\u00e9e internationale","boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550474"},"nl":{"name":"Nuances de et par Marion Coussineau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550474"},"en":{"name":"Nuances de et par Marion Coussineau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550474"},"de":{"name":"Nuances de et par Marion Coussineau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 