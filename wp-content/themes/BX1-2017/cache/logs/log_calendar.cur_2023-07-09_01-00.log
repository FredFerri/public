one con difficolt\u00e0 di comprensione","Accessibile","Accessibile ai pedoni con supporti"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n","Habilitado","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T03:06:23+02:00","published_at":"2023-04-14T14:23:26+02:00","backoffice_id":275449,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25},{"id":555601,"date_start":"2023-04-20","date_end":"2023-08-27","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{"list":[95],"translations":{"fr":["Patrimoine"],"nl":["Erfgoed"],"en":["Heritage"],"de":["Kulturerbe"],"it":["Patrimonio culturale"],"sp":["Patrimonio"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"City Game Coudenberg","shortdescr":"La Qu\u00eate de la Cl\u00e9 d'Or, une aventure passionnante dans le Quartier Royal !","longdescr":"Ann\u00e9e 1615. Alors que Bruxelles pr\u00e9pare les c\u00e9l\u00e9brations du cort\u00e8ge de l\u2019Ommegang, un jeune architecte nomm\u00e9 Joris se pr\u00e9sente \u00e0 la cour pour se mettre au service des archiducs Albert et Isabelle. Mais entrer au service de la cour est loin d\u2019\u00eatre une t\u00e2che simple : Joris va devoir prouver sa comp\u00e9tence !\r\n\r\nMunissez-vous de votre smartphone et partez \u00e0 la d\u00e9couverte du quartier Royal en compagnie de Joris, \u00e0 la rencontre de notables haut en couleurs qui vous mettront \u00e0 l\u2019\u00e9preuve : observation, r\u00e9flexion, logique\u2026 Triomphez et vous obtiendrez la pr\u00e9cieuse Cl\u00e9 d\u2019Or qui vous ouvrira les portes du Palais du Coudenberg ! Une aventure \u00e0 vivre, un city game passionnant qui vous plongera en plein 17e si\u00e8cle, \u00e0 la cour des archiducs.\r\n \r\nInformations pratiques :\r\nCity Game : La qu\u00eate de la Cl\u00e9 d\u2019or \u2013 20 juin \u00e0 27 ao\u00fbt\r\nComment \u00e7a se passe : T\u00e9l\u00e9chargement sur Apple Store ou Google Play. Tapez le mot cl\u00e9 \u00ab Coudenberg \u00bb \u2013 choisissez \u00ab City Game \u00bb.\r\nTarif : \u20ac 5.99. Tarif d\u2019entr\u00e9e r\u00e9duit au Palais du Coudenberg (1+1 gratuit) sur pr\u00e9sentation d\u2019une preuve de t\u00e9l\u00e9chargement du jeu.\r\nOu : Palais du Coudenberg, 7 Place des Palais \u00e0 1000 Bruxelles.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555601"},"nl":{"name":"City Game Coudenberg","shortdescr":"De zoektocht naar de Gouden Sleutel, een spannend avontuur in de Koningswijk!","longdescr":"1615, terwijl Brussel de viering van de Ommegang voorbereidt, presenteert een jonge architect, Joris, zich aan het hof om bij de aartshertogen Albrecht en Isabella in dienst te komen. Maar in dienst treden aan het hof is verre van eenvoudig: Joris zal zijn kunde moeten bewijzen!\r\n\r\nPak je smartphone en ga op verkenning in de Koninklijk Wijk in het gezelschap van onze held, om kleurrijke notabelen te ontmoeten die je op de proef zullen stellen: observatie, reflectie, logica... Wie slaagt in de opdracht, bemachtigt de kostbare gouden sleutel die de deuren van het Coudenbergpaleis voor je opent! Een avontuur, een spannend stadsspel dat je onderdompelt in het midden van de 17e eeuw, aan het hof van de Aartshertogen.\r\n \r\nPraktische info :\r\nCity Game: De zoektocht naar de Gouden Sleutel \u2013 20 juni tot 27 augustus\r\nHoe werkt het? Download via Apple Store of Google Play. Typ het trefwoord \u201cCoudenberg\u201d in - kies \u201cCity Game\u201d.\r\nPrijs? \u20ac 5.99. Korting op de toegang tot het Coudenbergpaleis (1+1 gratis) op vertoon van een bewijs van de download.\r\nWaar? Coudenbergpaleis, Paleizenplein 7 1000 Brussel.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555601"},"en":{"name":"City Game Coudenberg","shortdescr":"The Quest for the Golden Key, an exciting adventure in the Royal Quarter!","longdescr":"The Year 1615. As Brussels prepares for the celebrations of the Ommegang procession, a young architect named Joris presents himself to the court to enter the service of the Archdukes Albert and Isabella. But entering the service of the court is far from being a simple task: Joris will have to prove his competence!\r\n\r\nGrab your smartphone and set off to discover the Royal Quarter in the company of our hero, meeting colourful notables who will put you to the test: observation, reflection, logic\u2026 Triumph and you will obtain the precious Golden Key that will open the doors of Coudenberg Palace! An adventure to be experienced, an exciting city game that will plunge you into the 17th century, at the court of the Archdukes.\r\n\r\nPractical information:\r\nCity Game: Quest of the Golden Key - 20 June - 27 August\r\nHow does it work: Download on Apple Store of Google Play. Enter the keyword \u201cCoudenberg\u201d - choose \u201cCity Game\u201d.\r\nFee: \u20ac 5.99. Reduced fee to the Coudenberg Palace (1+1 free) upon proof of download.\r\nWhere: Coudenberg Palace, Place des Palais 7 1000 Brussels.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555601"},"de":{"name":"City Game: De zoektocht naar de gouden sleutel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555601"},"it":{"name":"City Game: De zoektocht naar de gouden sleutel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555601"},"sp":{"name":"City Game: De zoektocht naar de gouden sleutel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555601"},"pt":{"name":"City Game: De zoektocht naar de gouden sleutel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555601"},"cn":{"name":"City Game: De zoektocht naar de gouden sleutel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555601"}},"place":{"id":258195,"translations":{"fr":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Autrefois, l\u2019impressionnant palais du Coudenberg dominait la ville de Bruxelles. Charles Quint et d\u2019autres souverains parmi les plus puissants que l\u2019Europe ait connus ont habit\u00e9 cette r\u00e9sidence princi\u00e8re du 12e au 18e si\u00e8cle, jusqu\u2019\u00e0 ce qu\u2019un terrible incendie la d\u00e9truise \u00e0 jamais. Les ruines de ce palais ont disparu pendant de nombreuses ann\u00e9es dans les sous-sols. Aujourd\u2019hui, ces vestiges forment un site arch\u00e9ologique enchanteur constitu\u00e9 d\u2019un r\u00e9seau de salles et de passages souterrains.\r\n \r\nAu cours de votre visite, vous d\u00e9couvrirez les b\u00e2timents principaux du palais et vous fl\u00e2nerez dans la rue Isabelle, qui est aujourd\u2019hui souterraine. Dans le mus\u00e9e du Coudenberg, qui est abrit\u00e9 dans l\u2019h\u00f4tel d\u2019Hoogstraeten, sont expos\u00e9es les plus belles d\u00e9couvertes arch\u00e9ologiques effectu\u00e9es lors des diff\u00e9rentes campagnes de fouilles men\u00e9es sur le site du Coudenberg\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Coudenbergpaleis","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Ooit werd Brussel gedomineerd door het reusachtige Coudenbergpaleis. Keizer Karel en het kruim van de Europese adel verbleven er tussen de twaalfde en de achttiende eeuw. Tot het noodlot toesloeg en een brand het prachtige gebouw verwoestte. Vele resten bleven echter intact en verdwenen ... onder de grond. Nu is het een betoverende archeologische site, een netwerk van gewelfde gangen, zalen en verborgen kamers.\r\n \r\nTijdens een bezoek ontdek je de hoofdgebouwen van het paleis en flaneer je door de Isabellastraat, die nu onder de grond ligt! In het museum van de Coudenberg, dat in het bovengrondse Hof van Hoogstraeten ondergebracht is, kan je de mooiste archeologische voorwerpen bewonderen die in de loop van de verschillende opgravingswerken op de Coudenbergsite werden ontdekt.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Coudenberg Palace","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais, 7","address_line2":"1000 Brussels","description_web":"Once upon a time, the Coudenberg Palace towered over the city of Brussels. Charles V and many other of the most powerful rulers ever to reign in Europe made this princely residence their home between the 12th and 18th centuries, until it was consumed by a terrible fire.  Every trace of this prestigious palace simply disappeared underground for many years. Today, however, these ruins constitute a fascinating archeological site incorporating a network of underground passages and chambers.\r\n \r\nWhen you visit it you can explore the principal buildings of the palace and enjoy a stroll along the Rue Isabelle, which is now underground.  In the Coudenberg Museum, located in Hoogstraeten House, the finest of the archeological discoveries made during the various excavations of the Coudenberg site are displayed.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Coudenberg Palast","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Ein unterirdischer Parcours, in dessen Verlauf Sie die \u00dcberreste des Palastes von Charles V. entdecken k\u00f6nnen. Seit dem Mittelalter \u00fcberragt eine f\u00fcrstliche Residenz auf dem Coudenberg die Stadt Br\u00fcssel. Das architektonische Ensemble, das sich seit dem 12. Jahrhundert immer wieder weiterentwickelt hat, gilt als einer der sch\u00f6nsten Pal\u00e4ste Europas und eine der wichtigsten Residenzen von Karl V. Dieses prestigetr\u00e4chtige Geb\u00e4ude wurde bei einem Brand im Februar 1731 schwer besch\u00e4digt. Vierzig Jahre sp\u00e4ter wurden die Ruinen des Palasts dem Erdboden gleichgemacht, um Platz f\u00fcr den Place Royale zu machen. Die \u00dcberreste dieses Geb\u00e4udes bilden heute die arch\u00e4ologische St\u00e4tte des Coudenberg. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Coudenberg Palazzo","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"\"Il sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\tSito Archeologico di Coudenbergl sito...\"\r\n\r\nIl sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\r\n\r\nSito Archeologico di Coudenberg\r\n\r\nl sito riunisce vestigia dell'antico palazzo di Bruxelles, della residenza di Hoogstraeten e della Rue Isabelle. Un'affascinante passeggiata che vi conduce sotto il pav\u00e9 della place Royale, alla scoperta dei resti del Palazzo di Coudenberg che fu una delle residenze principali di Carlo V. \u00a0\r\n\r\nMuseo del Coudenberg\r\nil museo vi invita a scoprire un'esposizione permanente di oggetti trovati durante gli scavi effettuati sul sito negli ultimi 25 anni. potete combinare la vostra visita con quella del Museo BELvue.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Coudenberg Palacio","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"En el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas....\r\n\r\nEn el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas.\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg est\u00e1 compuesto de vestigios del antiguo Palacio de Bruselas, del Hotel Hoogstraeten y de la Rue Isabelle.\u00a0Este fascinante paseo te llevar\u00e1 a descubrir los <b>vestigios del Palacio Coudenberg<\/b>, que fue una de las residencias de Carlos V.\r\n\r\nMuseo Coudenberg\r\n\r\nInstalado en los vestigios del antiguo Hotel de Hoogstraeten, el Museo Coudenberg  te invita a descubrir una <b>exposici\u00f3n permanente<\/b> de objetos hallados durante las distintas <b>excavaciones arqueol\u00f3gicas<\/b> realizadas los \u00faltimos 25 a\u00f1os.\u00a0Podr\u00e1s combinar tu visita del Coudenberg con la del Museo BELvue.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"],"de":["K\u00f6nigliches Viertel"],"it":["Quartiere reale"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":18195,"location":{"lat":50.84261029,"lon":4.36068879},"region":"brussels","last_updated_at":"2023-07-08T03:06:02+02:00","published_at":"2014-05-05T10:58:29+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":258195,"translations":{"fr":{"name":"Palais du 