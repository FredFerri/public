 de Pataxos indianen die in de zuidelijke staat Bahia (Brazili\u00eb) wonen. Dit woord staat voor de ambitie van het project en de kwaliteit van de culturele evenementen, maar ook voor de verbondenheid van de initiatiefnemers met de Braziliaanse cultuur. \r\nLe Baixu is ondergebracht in een voormalig industrieel gebouw in het hart van de trendy Brusselse Tour & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":39109,"location":{"lat":50.86391031,"lon":4.34697026},"region":"brussels","last_updated_at":"2024-07-30T15:45:30+02:00","published_at":"2022-07-15T20:19:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","