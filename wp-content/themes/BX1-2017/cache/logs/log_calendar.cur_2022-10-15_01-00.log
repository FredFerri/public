:28+02:00","backoffice_id":251290,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1.2599210498949},{"id":544166,"date_start":"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen"}},"others":{"list":[98],"translations":{"fr":["Parcours p\u00e9destres et cyclistes"],"nl":["Fiets- of wandelroute"],"en":["Pedestrian and cyclist path"],"de":["Wander- & Radwege"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Promenade collective","shortdescr":"En cette Journ\u00e9e de la for\u00eat de Soignes, nous organisons une promenade collective gratuite.\r\nAvec ou sans chien, rejoignez-nous pour une promenade d\u2019environ 1h30.","longdescr":"En cette Journ\u00e9e de la for\u00eat de Soignes, nous organisons une promenade collective gratuite.\r\nAvec ou sans chien, rejoignez-nous pour une promenade d\u2019environ 1h30.\r\nLe d\u00e9but de la promenade n\u00e9cessite la laisse, nous irons ensuite dans une zone \"chiens ma\u00eetris\u00e9s\" o\u00f9 les chiens peuvent \u00eatre l\u00e2ch\u00e9s sous la responsabilit\u00e9 du ma\u00eetre.\r\nPendant cette promenade, nous r\u00e9pondrons \u00e0 toutes les questions sur l'\u00e9ducation de votre chien (actuel ou \u00e0 venir).\r\nDate: 16\/10\/2022 \u00e0 14h\r\nLieu: Stand Godog au Centre Rouge Clo\u00eetre (For\u00eat de Soignes)\r\nPrix: gratuit","performers":"Sophie Vandenbussche (Educatrice Canin)","boxoffice_url":null,"website":"http:\/\/www.godog.be","email":"info@godog.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\