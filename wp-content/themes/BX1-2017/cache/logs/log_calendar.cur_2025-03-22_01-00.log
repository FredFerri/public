ions":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[120],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Festival Linguales Focus Qu\u00e9bec","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.le140.be\/festival\/festival-linguales\/","email":"tickets@le140.be","phone_contact":"+32 2 733 97 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006476"},"pt":{"name":"Festival Linguales Focus Qu\u00e9bec","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.le140.be\/festival\/festival-linguales\/","email":"tickets@le140.be","phone_contact":"+32 2 733 97 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006476"},"en":{"name":"Festival Linguales Focus Qu\u00e9bec","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.le140.be\/festival\/festival-linguales\/","email":"tickets@le140.be","phone_contact":"+32 2 733 97 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006476"},"it":{"name":"Festival Linguales Focus Qu\u00e9bec","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.le140.be\/festival\/festival-linguales\/","email":"tickets@le140.be","phone_contact":"+32 2 733 97 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006476"},"cn":{"name":"Festival Linguales Focus Qu\u00e9bec","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.le140.be\/festival\/festival-linguales\/","email":"tickets@le140.be","phone_contact":"+32 2 733 97 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006476"},"fr":{"name":"Festival Linguales Focus Qu\u00e9bec","shortdescr":"Les Linguales sont un festival biennal qui se d\u00e9ploie autour de la question d\u2019un territoire partag\u00e9 et de partage, la francophonie. Ici, il n\u2019est pas question d\u2019une unicit\u00e9 de culture et de langue, mais plut\u00f4t de la multiplicit\u00e9 des expressions qui coexistent sur ces territoires \u00e9parpill\u00e9s au travers des continents humains.","longdescr":"Ici, nous ne d\u00e9fendons pas une langue, mais nous c\u00e9l\u00e9brerons l\u2019art et ses expressions m\u00e9tiss\u00e9es, plurielles et riches. Cette premi\u00e8re \u00e9dition s\u2019int\u00e9resse au Qu\u00e9bec et \u00e0 quelques-un\u00b7es de ses artistes singulier\u00b7es. Iels sont \u00e9tonnant\u00b7es, perturbant\u00b7es, d\u00e9pla\u00e7ant\u00b7es, cocasses, tendres ou encore inventif\u00b7ves, exub\u00e9rant\u00b7es, g\u00e9n\u00e9reux\u00b7ses et souvent d\u00e9bordant\u00b7es\u2026\nNous vous invitons \u00e0 d\u00e9couvrir des \u0153uvres et des personnalit\u00e9s issues d\u2019un territoire, bulles de francophonie, du nord des Am\u00e9riques.","performers":"Soudain les Iles, Confession Publique, Koros, Genevi\u00e8ve Matthieu et Le Gardien des enfants.","boxoffice_url":null,"website":"https:\/\/www.le140.be\/festival\/festival-linguales\/","email":"tickets@le140.be","phone_contact":"+32 2 733 97 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006476"},"sp":{"name":"Festival Linguales Focus Qu\u00e9bec","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.le140.be\/festival\/festival-linguales\/","email":"tickets@le140.be","phone_contact":"+32 2 733 97 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006476"},"nl":{"n