opyright":null}}}],"dates":[{"day":"2023-03-10","doors":null,"start":"20:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":28},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"},"de":{"name":"Jugendliche"},"it":{"name":"Ragazzi"},"sp":{"name":"J\u00f3venes"},"pt":{"name":"Jeunes"},"cn":{"name":"Jeunes"}},"value":11}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[257],"translations":{"fr":["Am\u00e9nagements pour personnes sourdes et malentendantes"],"nl":["Voorzieningen voor dove en slechthorende personen"],"en":["Facilities for deaf and hearing-impaired people"],"de":["Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen."],"it":["Disposizioni per persone non udenti e ipoudenti"],"sp":["Equipos para personas sordas y con problemas de audici\u00f3n"],"pt":[null],"cn":[null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-18T07:36:27+01:00","published_at":"2022-06-28T11:40:26+02:00","backoffice_id":257174,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":551426,"date_start":"2023-03-10","date_end":"2023-03-10","date_next":"2023-03-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"],"it":["Classica"],"sp":["Cl\u00e1sica"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["nl","fr","en","de"],"subtitles":[]},"translations":{"fr":{"name":"Trois G\u00e9ants de Piano - Frescobaldi, Chopin et Liszt\u2028","shortdescr":"Venez d\u00e9couvrir ces g\u00e9nies qui ont r\u00e9volutionn\u00e9 la technique et l\u2019interpretation dans leur \u00e9poque et pouss\u00e9 les limites du piano. Le concert d\u00e9butera avec un tout jeune pianiste de 11 ans, Lorenzo Bari et se poursuivra par son professeur, Calogero di Liberto.","longdescr":"La 10\u00e8me saison de Clame se poursuit avec un concert d\u00e9di\u00e9 \u00e0 trois ma\u00eetres du clavier : \r\nFrescobaldi, Chopin et Liszt. Venez d\u00e9couvrir ces g\u00e9nies qui ont r\u00e9volutionn\u00e9 la technique et l\u2019interpretation dans leur \u00e9poque et pouss\u00e9 les limites du piano. Le concert d\u00e9butera avec un tout jeune pianiste de 11 ans, Lorenzo Bari et se poursuivra par son professeur, Calogero di Liberto. Calogero di Liberto est un artiste d'exception, chaleureux et g\u00e9n\u00e9reux. Il parcourt les salles de concert pour transmettre\r\nson amour de la musique.\r\n\r\nNous nous r\u00e9jouissons de vous accueillir le 10 mars 2023 au Mus\u00e9e Charlier, Avenue des Arts 16, 1210 Bruxelles (m\u00e9tro Arts-Loi). Le concert d\u00e9bute \u00e0 19h30. Le mus\u00e9e ouvre ses portes \u00e0 partir de 18h30, avec un verre de bienvenue. Fermeture des portes du mus\u00e9e \u00e0 19.45.\r\n\r\nN'h\u00e9sitez plus \u00e0 r\u00e9server vos places pour notre concert exceptionnel et \u00e0 partager cette invitation avec vos amis.","performers":"Calogero Di Liberto (piano); Lorenzo Bari (jeune talent - piano)","boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"mmersinli@me.com","phone_contact":"+32 484 57 10 83","phone_booking":"+32 484 57 10 83","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551426"},"nl":{"name":"Three Piano Giants -  Frescobaldi, Chopin en Liszt","shortdescr":"We nodigen U uit om werken van deze drie grote componisten te ontdekken, die in hun tijd een revolutie in de techniek en in de interpretatie teweegbrachten en de grenzen van de piano verruimden. Het concert begint met een zeer jong talent : Lorenzo Bari, 11 jaar oud","longdescr":"Het 10de seizoen\u00a0 van Clame stelt U een derde concert voor gewijd aan drie meesters van het klavier : Frescobaldi, Chopin en Liszt. We nodigen U uit om werken van deze drie grote componisten te ontdekken, die in hun tijd een revolutie in de techniek en in de interpretatie teweegbrachten en de grenzen van de piano verruimden. Het concert begint met een zeer jong talent : Lorenzo Bari, 11 jaar oud. Calogero di Liberto, zijn leraar, zal vervolgens het concert voortzetten. Calogero di Liberto is een buitengewone artiest, die regelmatig op het podium staat met zijn warm enthousiasme en\u00a0liefde voor de muziek.\r\n\r\nWe verheugen ons U op 10 maart te kunnen onthalen in het Charlier Museum, Kunstlaan 16, 1210 Brussel (metrostation Kunst-Wet). Het concert begint om 19.30 uur. Het museum is open vanaf 18.30 uur, waar U met uw vrienden van een glaasje kunt genieten. 19.45 uur : laatste toegang tot het concert.\r\n\r\nDeel gerust deze uitnodiging met uw vrienden. Het aantal plaatsen is beperkt, vergeet niet uw plaatsen te reserveren.","performers":"Calogero Di Liberto (piano); Lorenzo Bari (jong talent - piano)","boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"mmersinli@me.com","phone_contact":"+32 484 57 10 83","phone_booking":"+32 484 57 10 83","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551426"},"en":{"name":"Three Piano Giants -  Frescobaldi, Chopin and Liszt","shortdescr":"Come and discover these geniuses who revolutionised technique and interpretation in their time and expended the limits of their instrument, the piano. The concert will be opened by 11 years young talent Lorenzo Bari who will come from Italy with his master Calogero Di Liberto for this musical evening.","longdescr":"Clame's 10th season continues with an exceptional concert dedicated to three keyboard giants, Frescobaldi, Chopin and Liszt. Come and discover these geniuses who revolutionised technique and interpretation in their time and expended the limits of their instrument, the piano. The concert will be opened by 11 years young talent Lorenzo Bari who will come from Italy with his master for this musical evening. Maestro Calogero Di Liberto is a master and an exceptional artist who is applauded by all the major scenes in the world for his enthusiasm and love for music. \r\n\r\nWe look forward to welcoming you on 10 March 2023 at the Charlier Museum, Avenue des Arts 16, 1210 Brussels (Arts-Loi metro station). The concert will start at 7:30 p.m. but you can come and have a drink and discover the museum from 6:30 p.m. on. (Doors close at 7:45 p.m.)\r\n\r\nDon't hesitate any longer, book your tickets for our superb exceptional concert. Feel free to share with your friends! The number of places is limited; remember to reserve your places!","performers":"Calogero Di Liberto (piano); Lorenzo Bari (young talent - piano)","boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"mmersinli@me.com","phone_contact":"+32 484 57 10 83","phone_booking":"+32 484 57 10 83","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551426"},"de":{"name":"Trois G\u00e9ants de Piano - Frescobaldi, Chopin et Liszt\u2028","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"mmersinli@me.com","phone_contact":"+32 484 57 10 83","phone_booking":"+32 484 57 10 83","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551426"},"it":{"name":"Trois G\u00e9ants de Piano - Frescobaldi, Chopin et Liszt\u2028","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"mmersinli@me.com","phone_contact":"+32 484 57 10 83","phone_booking":"+32 484 57 10 83","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551426"},"sp":{"name":"Trois G\u00e9ants de Piano - Frescobaldi, Chopin et Liszt\u2028","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"mmersinli@me.com","phone_contact":"+32 484 57 10 83","phone_booking":"+32 484 57 10 83","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551426"},"pt":{"name":"Trois G\u00e9ants de Piano - Frescobaldi, Chopin et Liszt\u2028","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"mmersinli@me.com","phone_contact":"+32 484 57 10 83","phone_booking":"+32 484 57 10 83","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551426"},"cn":{"name":"Trois G\u00e9ants de Piano - Frescobaldi, Chopin et Liszt\u2028","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"mmersinli@me.com","phone_contact":"+32 484 57 10 83","phone_booking":"+32 484 57 10 83","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551426"}},"place":{"id":753,"translations":{"fr":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le mus\u00e9e, inaugur\u00e9 en 1928, est comme un tableau d\u2019\u00e9poque\u2026 on se retrouve au temps de La Libre Esth\u00e9tique et du Groupe des 20. Les collections sont expos\u00e9es dans les salons, riches en mobilier et objets d\u2019art d\u00e9coratifs d\u2019\u00e9poque Louis XV, Louis XVI et Empire.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Charliermuseum","address_street_name":"Kunstlaan","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Kunstlaan, 16","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"Het museum, geopend in 1928, is gevestigd in het prive-herenhuis van de beeldhouwer Guillaume Charlier, dat dateert uit de 19e eeuw. Het richt zich op de Belgische schilderkunst van eind 19e tot begin 20e eeuw. De collecties worden getoond in de salons, rijkelijk voorzien van decoratieve stukken uit de Louis XV, Louis XVI en Empire periodes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Charlier Museum","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The museum is based in the private mansion, dating from the 19th century, of the sculptor Guillaume Charlier. It focuses on Belgian painting from the late 19th to the early 20th century. Its art exhibitions take place in a setting of lavish furnishings, with numerous decorative pieces from the Louis XV, Louis XVI, and Empire periods.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Das 1928 eingeweihte Museum ist wie ein Gem\u00e4lde der Epoche... man findet sich in der Zeit der La Libre Est\u00e9tique und der Groupe des 20 wieder. Die Sammlungen werden in den reich mit Mobiliar und historischen Dekorationsgegenst\u00e4nden (Louis XV, Louis XV und Empire) best\u00fcckten Salons ausgestellt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"El Museo Charlier, una mansi\u00f3n del siglo XIX obra de Horta durante sus a\u00f1os de juventud, te sumergir\u00e1 en la atm\u00f3sfera de un lujoso sal\u00f3n de arte: la Belle Epoque te invita a so\u00f1ar, a pasear entre las esculturas de Charlier, Hager y Wouters, las pinturas de Smits, Fr\u00e9d\u00e9ric, Oleffe, Laermans, Van Strydonck, Ensor... Este ambiente \u00edntimo se completa con los muebles de los ebanistas Chapuis, Sen\u00e9, Nadal l'A\u00een\u00e9, numerosos objetos de arte decorativo de estilos Luis XIV, XV, XVI y estilo Imperio, tapices de Bruselas y Audenaerde, as\u00ed como excepcionales un excepcional sal\u00f3n chino. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"],"de":["Osten"],"it":["Est"],"sp":["Este"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":152,"location":{"lat":50.84755959,"lon":4.36997724},"region":"brussels","last_updated_at":"2023-02-18T07:36:02+01:00","published_at":"2013-10-19T01:13:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":252302,"translations":{"fr":{"name":"CLAME asbl","address_street_name":null,"address_st