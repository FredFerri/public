dress_street_box":null,"email":"dir@ma-an.be","website":"http:\/\/www.ma-an.be","phone_contact":"+32 2 522 05 51","phone_booking":"+32 2 522 05 51","address_zip":"1070","address_city":"Anderlecht","address_line1":"Place de la Vaillance, 5","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Muziekacademie Anderlecht","address_street_name":"Place de la Vaillance","address_street_number":"5","address_street_box":null,"email":"dir@ma-an.be","website":"http:\/\/www.ma-an.be","phone_contact":"+32 2 522 05 51","phone_booking":"+32 2 522 05 51","address_zip":"1070","address_city":"Anderlecht","address_line1":"Place de la Vaillance, 5","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Muziekacademie Anderlecht","address_street_name":"Place de la Vaillance","address_street_number":"5","address_street_box":null,"email":"dir@ma-an.be","website":"http:\/\/www.ma-an.be","phone_contact":"+32 2 522 05 51","phone_booking":"+32 2 522 05 51","address_zip":"1070","address_city":"Anderlecht","address_line1":"Place de la Vaillance, 5","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"],"de":["S\u00fcden"],"it":["Sud"],"sp":["Sur"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":25380,"location":{"lat":50.83547887,"lon":4.30700694},"region":"brussels","last_updated_at":"2023-02-24T02:36:33+01:00","published_at":"2016-02-15T20:34:39+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":8600,"translations":{"fr":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Maison d\u2019\u00c9rasme et le b\u00e9guinage, voisins de la coll\u00e9giale des Saints-Pierre-et-Guidon, constituent un ensemble historique remarquable au c\u0153ur de la commune d\u2019Anderlecht.  \r\nLa Maison d\u2019\u00c9rasme est une des plus anciennes demeures de la r\u00e9gion de Bruxelles. \u00c9rasme y r\u00e9sida de mai \u00e0 octobre 1521. On y d\u00e9couvre des sculptures, peintures et gravures de ma\u00eetres des 15e au 17e si\u00e8cles : Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... ainsi que des portraits d\u2019\u00c9rasme, inspir\u00e9s de Hans Holbein et de Quentin Metsys. Une riche collection de livres du 16e si\u00e8cle refl\u00e8te la pens\u00e9e d'\u00c9rasme, le \u00ab Prince des humanistes \u00bb. \r\nUn Jardin de plantes m\u00e9dicinales, dessin\u00e9 par le paysagiste Ren\u00e9 Pech\u00e8re, pr\u00e9sente une centaine de plantes connues du 16e si\u00e8cle. Au-del\u00e0, s\u2019\u00e9tend un Jardin philosophique qui abrite des \u0153uvres d\u2019artistes contemporains dont Marie-Jo Lafontaine et Bob Verschueren. \r\n\r\nLe b\u00e9guinage d\u2019Anderlecht est le plus petit b\u00e9guinage de Belgique. Fond\u00e9 en 1252, il se compose de deux ailes encadrant un jardin clos. Il accueillait des b\u00e9guines jusqu\u2019\u00e0 la R\u00e9volution fran\u00e7aise. Le b\u00e9guinage a subi une restauration approfondie et est d\u00e9sormais ouvert aux visiteurs. Un nouveau projet mus\u00e9al sera finalis\u00e9 \u00e0 l\u2019automne 2023. ","description_print":"21\/09\/2022\r\n\u00c9rasme a s\u00e9journ\u00e9 en 1521 dans cette maison gothique (1450-1515) qui rassemble \u00e0\r\nla fois une collection de peintures, gravures et scuptures (Albrecht Du\u0308rer, Joos Van\r\nCleve, Pieter Huys, Cornelis Metsys, Frans Francken le Jeune \u2026), une biblioth\u00e8que\r\nsp\u00e9cialis\u00e9e dans les \u00e9ditions princeps, c\u2019est-\u00e0-dire les premi\u00e8res \u00e9ditions d\u2019une \u0153uvre\r\nchez diff\u00e9rents imprimeurs, un Jardin philosophique et un Jardin de plantes\r\nm\u00e9dicinales. Le mus\u00e9e publie des livres et organise des conf\u00e9rences, des concerts,\r\ndes expositions d\u2019art contemporain et historiques, des activit\u00e9s p\u00e9dagogiques, des\r\nvisites guid\u00e9es pour groupes.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Erasmushuis & Begijnhofmusea","address_street_name":"Formanoirstraat","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Formanoirstraat, 31","address_line2":"1070 Anderlecht","description_web":"Het Erasmushuis, het begijnhof en de collegiale Sint-Pieter-en Sint-Guidokerk vormen een uitzonderlijk historisch geheel in het centrum van de gemeente Anderlecht. Het Erasmushuis is een van de oudste huizen in Brussel waar Erasmus verbleef van mei tot oktober 1521. In de verschillende vertrekken kun je schilderijen en prenten van de meesters uit de 15de tot de 17de eeuw ontdekken, zoals Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... alsook portretten van Erasmus naar het voorbeeld van Hans Holbein en Quentin Metsys. Een rijke collectie boeken uit de 16de eeuw vertegenwoordigt het gedachtegoed van deze bijzondere humanist.  \r\n\r\nAchter het huis bevindt zich een tuin met geneeskrachtige planten ontworpen door landschapsarchitect Ren\u00e9 Pech\u00e8re. Hier worden zo\u2019n honderd geneeskrachtige planten gekweekt die bekend waren bij de geneesheren uit de 16de eeuw. Daarachter bevindt zich een filosofische tuin met werken van hedendaagse kunstenaars, zoals Marie-Jo Lafontaine en Bob Verschueren.  \r\n\r\nHet begijnhof van Anderlecht is het kleinste van Belgi\u00eb. Het werd gesticht in 1252 en bestaat tegenwoordig uit twee vleugels rondom een ommuurde tuin met waterput. Hier vonden begijnen onderdak tot aan de Franse Revolutie. Na een grondige restauratie staat het begijnhof voortaan weer open voor bezoekers! Momenteel wordt een nieuw museumproject uitgewerkt dat tegen de herfst 2023 voltooid zou moeten zijn. \r\n","description_print":"21\/09\/2022\r\nIn 1521 verbleef Erasmus in dit gotische huis (1450-1515) waar zich niet alleen een collectie bevindt van schilderijen, prenten en beeldhouwwerken (Albrecht Du\u0308rer, Joos\r\nVan Cleve, Pieter Huys, Cornelis Metsys, Frans Francken de Jongere\u2026), maar ook een\r\nbibliotheek gespecialiseerd in \u2018editiones principes\u2019, dat wil zeggen de eerste uitgaven\r\nvan een werk bij verschillende drukkers. Verder bevindt zich buiten nog een Filosofische\r\ntuin en een tuin met Geneeskrachtige planten.\r\nDaarnaast publiceert het museum boeken en organiseert voordrachten, concerten,\r\ntentoonstellingen met een historisch thema en tentoonstellingen Hedendaagse kunst,\r\npedagogische activiteiten en rondleidingen voor groepen.","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Erasmus House & Beguinage Museums","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"The Erasmus House, beguinage, and collegiate church of Saints Peter and Guido form a magnificent historical ensemble, right in the heart of the commune. Erasmus House \u2013 in which the famous philosopher and scholar stayed from May to October 1521 \u2013 is one of the oldest Gothic houses in the Belgian capital. It hosts a sublime collection of paintings, prints and sculptures by 15th-17th century masters like Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys\u2026 not to mention portraits of Erasmus inspired by Hans Holbein and Quentin Metsys. A rich collection of 16th century books is a nod to the singular humanist\u2019s thinking.  \r\n\r\nA medicinal plant garden \u2013 designed by landscape architect Ren\u00e9 Pech\u00e8re \u2013 presents around one hundred medicinal plants that were known to 16th century physicians. Beyond it stretches a philosophical garden that is home to the works of contemporary artists like Marie-Jo Lafontaine and Bob Verschueren. \r\n\r\nThe beguinage of Anderlecht is Belgium\u2019s smallest. Founded in 1252, today it consists of two wings framing an enclosed garden with its own well. It housed beguines right up until the French Revolution and has been completely and lovingly restored, meaning it could, once again, be re-opened to the public! A new museum project is currently in the pipeline and should be finalised in autumn 2023. ","description_print":"21\/09\/2022\r\nFor several months, this house, which looks like a cloister, was home to the brilliant 16th-century humanist. Works of art, engravings, books, and archives bear witness to life in that era. End your visit in the philosophical and medicinal garden.","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"21\/09\/2022\r\nDas \u201eMaison d\u2019Erasme\u201c in der Br\u00fcsseler Gemeinde Anderlecht wurde Ende des 15. Jahrhunderts im Auftrag eines Stiftsherrn der nahegelegenen Stiftskirche St. Peter und St. Guido  im sp\u00e4tgotischen Stil errichtet.\r\n\r\nDas Haus beherbergte im Jahr 1521 den bedeutenden niederl\u00e4ndischen Gelehrten des Renaissance-Humanismus Erasmus von Rotterdam, der hier, fernab von den gro\u00dfen Machtzentren und den dort herrschenden Religionskriegen, die Ruhe und Abgeschiedenheit der Natur suchte.\r\n\r\nDas im Maison d\u2019Erasme untergebrachte Museum zeigt sowohl eine Gem\u00e4ldesammlung mit Werken von Holbein, Bosch und Metsys als auch eine reich mit alten B\u00fccherausgaben best\u00fcckte Bibliothek. Der umliegende Garten besteht aus einem \u201eJardin des Maladies\u201c \u2013 dem \u201eGarten der Krankheiten\u201c mit zahlreichen Heilpflanzen \u2013 und einem \u201eJardin philosophique\u201c \u2013 dem \u201ePhilosophischen Garten\u201c.","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"21\/09\/2022\r\nLa Casa di Erasmo deve il suo nome e la sua fama ad Erasmo da Rotterdam, che vi soggiorn\u00f2 nel 1521. Divenuta un museo dedicato al grande umanista rinascimentale, \u00e8 luogo di esposizione di una collezione unica composta da opere d'arte - sculture e dipinti di maestri fiamminghi -, mobili e libri antichi, molti dei quali scritti dallo stesso Erasmo. Se la Casa di Erasmo \u00e8 una delle pi\u00f9 antiche di Bruxelles - costruita in tre fasi nel corso dei secoli XV e XVI -, nel 1932 \u00e8 stata oggetto di un restauro completo voluto, nello spirito del pi\u00f9 puro storicismo, da Daniel Van Damme, fondatore del museo, con l'aiuto dell'architetto Charles Van Elst, che costru\u00ec anche la casa di Maurice Car\u00eame.  Gli spazi interni sono stati poi riconvertiti in sale del museo. Queste sono state decorate (una stanza con le pareti completamente rivestite di sontuose pelli di Cordoba) ed arredate con mobili provenienti dall'antica collezione del Ministro Vandenpeereboom. Gli interni sono quindi ricostruzioni con lo scopo di dare ai visitatori un'idea di quello che poteva essere una residenza rinascimentale. Le ricostruzioni sono in parte basate su documenti storici (lo studio di Erasmo che d\u00e0 sul giardino) ed in parte su ritrovamenti archeologici quali lo splendido fregio affrescato del primo piano. Nella parte posteriore della casa, un ampio giardino ombreggiato da grandi alberi conserva alcuni resti archeologici dell'antico castello di Anderlecht, poeticamente abbinati a diverse installazioni di artisti contemporanei. ","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"21\/09\/2022\r\nLa Casa de Erasmo debe su nombre y prestigio a la temporada que pas\u00f3 en ella Erasmo de R\u00f3terdam en 1521. Convertida en un museo dedicado a este gran humanista del Renacimiento, es el envoltorio de una colecci\u00f3n \u00fanica compuesta por obras de arte (esculturas y pinturas de maestros flamencos), muebles y libros antiguos, entre ellos numerosas ediciones erasmianas. Si la Casa de Erasmo es una de las m\u00e1s antiguas de Bruselas (construida en tres fases a lo largo de los siglos XV y XVI), a partir de 1932 fue objeto de una restauraci\u00f3n completa llevada a cabo, en el m\u00e1s puro historicismo, por Daniel Van Damme, fundador del museo, con la ayuda del arquitecto Charles Van Elst, que tambi\u00e9n construy\u00f3 la casa de Maurice Car\u00eame. Los espacios interiores se reorganizaron entonces en salas de museo que fueron decoradas (entre ellas, una sala con las paredes totalmente cubiertas por suntuosas pieles de C\u00f3rdoba) y amuebladas con mobiliario procedente de la antigua colecci\u00f3n del ministro Vandenpeereboom. El interior es, por tanto, una reproducci\u00f3n cuyo fin es dar a los visitantes la idea de lo que podr\u00eda haber sido una residencia en el Renacimiento, basada en parte en documentos hist\u00f3ricos (despacho de Erasmo frente al jard\u00edn) y en hallazgos arqueol\u00f3gicos como el maravilloso friso pintado al fresco del primer piso. Detr\u00e1s de la casa, un vasto jard\u00edn con grandes \u00e1rboles que le dan sombra conserva algunos restos arqueol\u00f3gicos del antiguo castillo de Anderlecht, los cuales se encuentran, po\u00e9ticamente, cerca de varias instalaciones de artistas contempor\u00e1neos. ","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":327,"location":{"lat":50.83592263,"lon":4.3077579},"region":"brussels","last_updated_at":"2023-02-24T02:36:33+01:00","published_at":"2013-10-19T01:13:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/9fc403cd3cad5ee4ac6c6d8cdf56a0f7f19c337e.jpg","width":1169,"height":584,"ratio":2,"translations":{"fr":{"title":"Concerts de midi Erasmusica","copyright":null},"nl":{"title":"Concerts de midi Erasmusica","copyright":null},"en":{"title":"Concerts de midi Erasmusica","copyright":null},"de":{"title":"Concerts de midi Erasmusica","copyright":null},"it":{"title":"Concerts de midi Erasmusica","copyright":null},"sp":{"title":"Concerts de midi Erasmusica","copyright":null},"pt":{"title":"Concerts de midi Erasmusica","copyright":null},"cn":{"title":"Concerts de midi Erasmusica","copyright":null}}}],"dates":[{"day":"2022-10-27","doors":"12:15:00","start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2022-11-24","doors":"12:15:00","start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2022-12-22","doors":"12:15:00","start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2023-01-26","doors":"12:15:00","start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2023-02-23","doors":"12:15:00","start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2023-03-30","doors":"12:15:00","start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2023-04-27","doors":"12:15:00","start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2023-06-01","doors":"12:15:00","start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2023-06-29","doors":"12:15:00","start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-24T02:36:33+01:00","published_at":"2022-10-25T14:35:15+02:00","backoffice_id":264728,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":0.15959586353904},{"id":540016,"date_start":"2022-09-01","date_end":"2023-06-29","date_next":"2023-03-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport","de":"Sport","it":"Sport","sp":"Deporte","pt":null,"cn":null}},"others":{"list":[159,164],"translations":{"fr":["Activit\u00e9 sportive","Fitness, gymnastique, danse et sports de combats"],"nl":["Sportieve activiteit","Fitness, gymnastiek, dans en vechtsport"],"en":["Sporting activity","Fitness, gymnastics, dance and combat sports"],"de":["Sportliche Aktivit\u00e4t","Fitness, Gymnastik, Tanz & Kampfsportarten"],"it":["Attivit\u00e0 sportive","Fitness, ginnastica, danza e sport da combattimento"],"sp":["Actividad deportiva","Fitnes, gimnasia, danza y deportes de combate"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Zumba\u00ae dancing","shortdescr":"Zumba\u00ae pour adultes & ados tr\u00e8s dansante et dynamique! Tubes latino, populaires et du monde entier. Plus qu'une simple remise en forme, une heure de Zumba vous apportera le sourire m\u00eame si le stress ou les nuages ont envahi votre journ\u00e9e... Avec notre \u00e9quipe, l'ambiance est assur\u00e9e \u00e0 chaque cours :)","longdescr":"- Les jeudis 19h00-20h00\r\n- Inscription en avance obligatoire svp (1 ou plusieurs dates): info@danceandzumbafun.com t\u00e9l: 0484\/661 000 \r\n- Chez nous il n'y a pas des frais d'inscription ou membre comme dans les structures de sport\/gyms\/clubs: on peut toujours payer par cours; tr\u00e8s pratique pour un court s\u00e9jour \u00e0 Bruxelles! Vous pouvez commencer quand on veut pendant l'ann\u00e9e, et venir uniquement 1 fois. \r\nSi vous restez plus longtemps, optez pour une carte de 5 cours \u00e0 50 euros ou 10 cours \u00e0 90 euros. Vous pouvez aussi utiliser votre carte pour nos cours a Etterbeek, Bruxelles (metro Schuman\/Merode) pour zumba lundi, mardi, mercredi, dimanche.\r\n- M\u00e9lange sympathique des belges et expatri\u00e9s dans nos cours, sympathique pour trouver des co-patriotes et de s'approcher aux belges qui vivent ici :) et ne pas seulement rester \"tourist(e)\".\r\n- Ne restez pas isol\u00e9(e) dans votre chambre d'h\u00f4tel le soir\/week-end: venez passer un bon moment en groupe! Chez nous une ambiance amusante, d\u00e9contract\u00e9z, non-comp\u00e9titive et accueillant pour des nouvelles personnes.\r\n- Nous avons aussi des cours de zumba lundi, mardi, mercredi et dimanche et un cours d'abdos-fessiers-bras les dimanches \u00e0 Etterbeek, Bruxelles.\r\n- Stages de danse; une opportunit\u00e9 d'apprendre par des professeurs sp\u00e9cialis\u00e9s d'ici. Example: Salsa et Bachata lady-styling, Bollywood, Danse orientale... info ici:\r\nhttps:\/\/www.danceandzumbafun.com\/stages-de-danse.html\r\n- Salles spacieuses et facile \u00e0 ventiler.\r\n- Site web: www.danceandzumbafun.com\r\nBienvenue \u00e0 nous joindre! Sofie","performers":null,"boxoffice_url":null,"website":"http:\/\/www.danceandzumbafun.com","email":"info@danceandzumbafun.com","phone_contact":"+32 484 66 10 00","phone_booking":"+32 484 66 10 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540016"},"nl":{"name":"Zumba\u00ae dancing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.danceandzumbafun.com","email":"info@danceandzumbafun.com","phone_contact":"+32 484 66 10 00","phone_booking":"+32 484 66 10 00","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540016"},"en":{"name":"Zumba\u00ae dancing","shortdescr":"Zumba\u00ae for adults & teens very danceable and dynamic! Latin songs, popular hits and music from all over the world. More than just getting back in shape, an hour of Zumba will bring you a smile even if stress or clouds have invaded your day... With our team, the atmosphere is assured in each class :)","longdescr":"- Thursdays 19h00-20h00\r\n- Advance registration required please (1 or several dates): info@danceandzumbafun.com tel: 0484\/661 000\r\n- No inscription or membership fees as in sports structures\/gyms\/clubs: you can always pay per class; very convenient for a short stay in Brussels! You can start whenever you want during the year, and come only once. \r\nIf you stay longer, opt for a 5 class card at 50 eur or 10 classes at 90 eur. You can also use your card for our zumba classes in Etterbeek, Brussels (metro Schuman\/Merode) Monday, Tuesday, Wednesday, Sunday.\r\n- Nice mix of Belgians and expatriates in our classes; you might find co-patriots and great to approach Belgians who live here :) and not just remain \"a tourist\".\r\n- Don't stay isolated in your hotel room at night\/weekend: come and have a good time in a group! We have a fun, relaxed, non-competitive and welcoming atmosphere for new participants.\r\n- We also have zumba Mondays, Tuesdays, Wednesdays and Sundays + an abs-butt-arms class on Sundays in Etterbeek, Brussels.\r\n- Also dance workshops, example: Salsa and Bachata lady-styling, Bollywood, Belly dancing... see here: https:\/\/www.danceandzumbafun.com\/dance.html\r\n- Spacious venues, easy to ventilate.\r\n- Website: www.danceandzumbafun.com\r\nWelcome to join us! Sofie","performers":null,"boxoffice_url":null,"website":"http:\/\/www.danceandzumbafun.com","email":"info@danceandzumbafun.com","phone_contact":"+32 484 66 10 00","phone_booking":"+32 484 66 10 00","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540016"},"de":{"name":"Zumba\u00ae dancing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.danceandzumbafun.com","email":"info@danceandzumbafun.com","phone_contact":"+32 484 66 10 00","phone_booking":"+32 484 66 10 00","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540016"},"it":{"name":"Zumba\u00ae dancing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.danceandzumbafun.com","email":"info@danceandzumbafun.com","phone_contact":"+32 484 66 10 00","phone_booking":"+32 484 66 10 00","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540016"},"sp":{"name":"Zumba\u00ae dancing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.danceandzumbafun.com","email":"info@danceandzumbafun.com","phone_contact":"+32 484 66 10 00","phone_booking":"+32 484 66 10 00","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540016"},"pt":{"name":"Zumba\u00ae dancing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.danceandzumbafun.com","email":"info@danceandzumbafun.com","phone_contact":"+32 484 66 10 00","phone_booking":"+32 484 66 10 00","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540016