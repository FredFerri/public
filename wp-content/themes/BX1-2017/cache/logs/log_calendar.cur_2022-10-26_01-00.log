improviste","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue de Fierlant, 120","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":30611,"location":{"lat":50.82474185,"lon":4.3319982},"region":"brussels","last_updated_at":"2022-10-10T15:05:56+02:00","published_at":"2018-01-17T15:25:41+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/d91c15ebd11e59c4288fb7efcc49acec24f2487c.jpg","width":638,"height":895,"ratio":0.71,"translations":{"fr":{"title":"M\u00e9moire","copyright":null},"nl":{"title":"M\u00e9moire","copyright":null},"en":{"title":"M\u00e9moire","copyright":null}}},{"type":"video","link":"https:\/\/youtu.be\/dY4IV1iuhgM","oEmbed_title":"Teaser M\u00e9moire","oEmbed_author_name":"Th\u00e9\u00e2tre l'Improviste","oEmbed_author_url":"https:\/\/www.youtube.com\/c\/Th\u00e9\u00e2trelImproviste","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/dY4IV1iuhgM\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/dY4IV1iuhgM?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen title=\"Teaser M\u00e9moire\"><\/iframe>","translations":{"fr":{"title":"Teaser M\u00e9moire"},"nl":{"title":"Teaser M\u00e9moire"},"en":{"title":"Teaser M\u0