2-08-10","doors":null,"start":"07:00:00","end":"23:00:00"},{"day":"2022-08-11","doors":null,"start":"07:00:00","end":"23:00:00"},{"day":"2022-08-12","doors":null,"start":"07:00:00","end":"23:00:00"},{"day":"2022-08-13","doors":null,"start":"07:00:00","end":"23:00:00"},{"day":"2022-08-14","doors":null,"start":"07:00:00","end":"23:00:00"},{"day":"2022-08-15","doors":null,"start":"07:00:00","end":"23:00:00"}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"07:00:00","end":"23:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"07:00:00","end":"23:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"07:00:00","end":"23:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"07:00:00","end":"23:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"07:00:00","end":"23:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"07:00:00","end":"23:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"07:00:00","end":"23:00:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 07:00 \u00e0 23:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 07:00 tot 23:00"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 07:00 to 23:00"]},"date_start":"2022-08-01","date_end":"2022-08-15","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":["major_event","exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T10:05:24+02:00","published_at":"2022-08-02T12:40:21+02:00","backoffice_id":259171,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.51087295492904},{"id":536544,"date_start":"2022-07-07","date_end":"2022-08-28","date_next":"2022-08-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Exposition Local Fictions","shortdescr":"Comment habitons nous le monde local ? Avons-nous toujours conscience de la richesse des lieux que nous habitons et des histoires qu'ils abritent ? Chacun des artistes participant \u00e0 l'exposition ont essay\u00e9 de r\u00e9pondre \u00e0 ces questions, chacun \u00e0 leur mani\u00e8re.","longdescr":"L\u2019exposition collective \u00ab Local Fictions \u00bb r\u00e9unit neuf jeunes artistes laur\u00e9ats de l\u2019Acad\u00e9mie Royale des Beaux-arts de Bruxelles, invit\u00e9s \u00e0 r\u00e9fl\u00e9chir au travail de la narration, de la m\u00e9moire et des histoires locales, r\u00e9elles comme fictionnelles.\r\nPrenant comme point de d\u00e9part les missions de proximit\u00e9 du centre culturel et sportif Tour \u00e0 Plomb, les artistes invit\u00e9s ont explor\u00e9 les environs du Centre, en parcourant le quartier et en allant \u00e0 la rencontre de ses habitants.\r\nLes probl\u00e9matiques relev\u00e9es ont re\u00e7u un \u00e9cho diff\u00e9rent chez chaque artiste, en fonction de leurs m\u00e9diums, de leurs rapports \u00e0 la fiction et de leurs propres exp\u00e9riences des lieux et des publics qui les fr\u00e9quentent.\r\nQue cela soit par la photographie, le textile, le dessin, la vid\u00e9o, le son ou le texte, les artistes ont cherch\u00e9 \u00e0 s\u2019approprier et \u00e0 mettre en forme les r\u00e9cits qui font vivre nos quartiers.\r\nPar cette grande diversit\u00e9 d\u2019approches et de points de vue, cette exposition propose un regard complexe autour de la narrativit\u00e9 comme ph\u00e9nom\u00e8ne de r\u00e9\u00e9criture de la m\u00e9moire locale. Une belle opportunit\u00e9 pour r\u00e9flechir sur nos fa\u00e7ons d\u2019habiter nos localit\u00e9s, de vivre, de ressentir et de penser celles-ci.","performers":"Marina Amaral, Mich\u00e8le Bellanger, Marie Dubus, Lila Poimboeuf Mahieu, Pierre Alexis, No\u00e9mie Le Meur, Camille Lemille et le Collectif Confus\u00b7e\u00b7s","boxoffice_url":null,"website":"https:\/\/touraplomb.be\/","email":"touraplomb@brucity.be","phone_contact":"+32 2 279 59 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536544"},"nl":{"name":"Exposition Local Fictions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.536544"},"en":{"name":"Local Fictions Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.536544"},"de":{"name":"Exposition Local Fictions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.536544"},"it":{"name":"Exposition Local Fictions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.536544"},"sp":{"name":"Exposition Local Fictions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.536544"},"pt":{"name":"Exposition Local Fictions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.536544"},"cn":{"name":"Exposition Local Fictions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.536544"}},"place":{"id":271867,"translations":{"fr":{"name":"Tour \u00e0 Plomb Centre Culturel et Sportif","address_street_name":"rue de l'Abattoir","address_street_number":"20-26","address_street_box":null,"email":"touraplomb@brucity.be","website":"https:\/\/touraplomb.be\/","phone_contact":"+32 2 279 59 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de l'Abattoir, 20-26","address_line2":"1000 Bruxelles","description_web":"Le Centre Tour \u00e0 Plomb est un centre de proximit\u00e9, du Service de la Jeunesse de la Ville de Bruxelles, d\u00e9di\u00e9 aux diverses formes de r\u00e9flexions, d\u2019expressions et de cr\u00e9ation, qu\u2019elles soient culturelles, socioculturelles, artistiques ou sportives. En tant qu\u2019infrastructure de proximit\u00e9, le Centre Tour \u00e0 Plomb est mis prioritairement \u00e0 la disposition des bruxellois et plus sp\u00e9cifiquement des habitants et des groupes structur\u00e9s (associations sans but lucratif, services et institutions publics, \u2026) du quartier Jardin aux Fleurs.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Hageltoren Sport- en Cultureel Centrum","address_street_name":"Slachthuisstraat","address_street_number":"20-26","address_street_box":null,"email":"touraplomb@brucity.be","website":"https:\/\/touraplomb.be\/","phone_contact":"+32 2 279 59 10","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Slachthuisstraat, 20-26","address_line2":"1000 Brussel","description_web":"Het Centrum Hageltoren is een buurtcentrum van de Jeugddienst van de Stad Brussel, dat bestemd is voor verschillende vormen van reflectie, expressie en creatie, of het nu gaat om culturele, sociaal-culturele, artistieke of sportieve activiteiten. Als wijkinfrastructuur staat de Hageltoren in de eerste plaats ter beschikking van de Brusselaars en meer bepaald van de inwoners en de georganiseerde groepen (verenigingen zonder winstoogmerk, openbare diensten en instellingen...) van de Bloemenhofwijk.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Culturel et Sportif Tour \u00e0 Plomb","address_street_name":"rue de l'Abattoir","address_street_number":"20-26","address_street_box":null,"email":"touraplomb@brucity.be","website":"https:\/\/touraplomb.be\/","phone_contact":"+32 2 279 59 10","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de l'Abattoir, 20-26","address_line2":"1000 Brussels","description_web":"The Tour \u00e0 Plomb Center is a neighborhood center of the Youth Service of the City of Brussels, dedicated to various forms of reflection, expression and creation, whether cultural, socio-cultural, artistic or sporting. As a neighborhood infrastructure, the Tour \u00e0 Plomb is first and foremost available to the residents of Brussels and more specifically to the residents and organized groups (non-profit associations, public services and institutions...) of the Jardin aux Fleurs neighborhood.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Culturel et Sportif Tour \u00e0 Plomb","address_street_name":"rue de l'Abattoir","address_street_number":"20-26","address_street_box":null,"emai