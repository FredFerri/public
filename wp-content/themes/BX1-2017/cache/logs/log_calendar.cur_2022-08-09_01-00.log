tegories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,32],"translations":{"fr":["Galeries d'art","Design"],"nl":["Galeries","Design"],"en":["Art Galleries","Design"]}}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Le modernisme Ludique. Ganshoren 1958.","shortdescr":"Au programme sont pr\u00e9vues de nombreuses d\u00e9couvertes autour de l\u2019architecture des ann\u00e9es 50. Le tout prendra place au travers des visites guid\u00e9es, des plans promenades, des vid\u00e9os\u2026 de quoi vous initier avec enthousiasme \u00e0 l\u2019esth\u00e9tique audacieuse et color\u00e9e du modernisme ludique !","longdescr":"ARCHistory, en collaboration avec les services Culture Franc\u0327aise et Ne\u0301erlandaise,  vous proposent de de\u0301couvrir un pavillon pop-up de\u0301die\u0301 a\u0300 l\u2019architecte ganshorenois Raoul J. Brunswyck (1924-1979). Cet illustre repr\u00e9sentant du modernisme ludique, connu sous le nom de style 58, a construit une cinquantaine d\u2019habitations a\u0300 Ganshoren. L\u2019exposition se tiendra au 31 avenue de Villegas, dans le hall raffine\u0301 du bureau de l\u2019architecte Brunswyck.","performers":"ARCHIstory, Urban, service de la culture fran\u00e7aise de Ganshoren, service de la culture n\u00e9erlandaise de Ganshoren","boxoffice_url":null,"website":"https:\/\/www.ganshoren.be\/agenda\/raoulbrunswyck\/","email":"info.brunswyck@ganshoren.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.532480"},"nl":{"name":"Het Speels Modernisme. Ganshoren 1958.","shortdescr":"Duik in de architectuur van de jaren vijftig aan de hand van een gevarieerd programma. Rondleidingen, wandelkaarten, video's... genoeg om enthousiast kennis te maken met de gedurfde en kleurrijke esthetiek van het speelse modernisme!","longdescr":"De erfgoedvereniging ARCHistory, in samenwerking met de diensten Nederlandse en Franse Cultuur nodigen je uit om een pop-up paviljoen te ontdekken, gewijd aan de Ganshorense architect Raoul J. Brunswyck (1924-1979). Brunswyck is een belangrijke vertegenwoordiger van het speelse modernisme, in de nasleep van de Expo 58, en bouwde in Ganshoren zo\u2019n 50-tal woningen. De expo loopt in de prachtige inkomhal van het voormalig architectenbureau van de vennoten Brunswyck en Odon Wathelet, waar sinds kort de gemeentelijke cultuurdiensten ondergebracht zijn.","performers":"ARCHIstory, Urban, Dienst franse cultuur van Ganshoren, Dienst nederlandse cultuur van Ganshoren","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.532480"},"en":{"name":"Le modernisme Ludique. Ganshoren 1958.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.532480"},"de":{"name":"Exposition 'Le modernisme Ludique. Ganshoren 1958.\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.532480"},"it":{"name":"Exposition 'Le modernisme Ludique. Ganshoren 1958.\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.532480"},"sp":{"name":"Exposition 'Le modernisme Ludique. Ganshoren 1958.\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.532480"},"pt":{"name":"Exposition 'Le moder