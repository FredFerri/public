que d\u2019art urbain sur l\u2019une des tours \u00e0 appartements du Quartier Germinal. Une initiation graffiti sur b\u00e2ches sera \u00e9galement propos\u00e9e \u00e0 toute personne souhaitant s\u2019essayer \u00e0 cette discipline.\r\n\r\nDimanche 18 septembre \/\/ 12h \u203a 18h\r\nCroisement rue de Zaventemet av. J. Bordet \u2013 1140 Evere\r\nUne Jam Graffiti se d\u00e9roulera dans le quartier Platon, qui compte \u00e0 pr\u00e9sent de nombreuses installations d\u00e9di\u00e9es au Street Art. Lors de cet \u00e9v\u00e9nement, le public aura l\u2019opportunit\u00e9 de voir les graffeurs\u00b7euses peindre en direct, ou encore de s\u2019essayer \u00e0 l\u2019art du graffiti lors d\u2019une initiation propos\u00e9e par les artistes.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lentrela.be\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541334"},"nl":{"name":"Initiation au graffiti","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541334"},"en":{"name":"Initiation au graffiti","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541334"},"de":{"name":"Initiation au graffiti","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541334"},"it":{"name":"Initiation au graffiti","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"htt