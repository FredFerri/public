ress_street_number":"55","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Adolphe Maxlaan, 55","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":"55","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Boulevard Adolphe Max, 55","address_line2":"1000 Brussels","description_web":"Since 1977, ARAU has been a pioneer of urban tourism in Brussels and has offered unconventional guided tours that raise awareness of urban democracy and the role of residents in the development of their city. Over the decades, ARAU has also developed an expert knowledge of the city\u2019s architectural and planning history, which it has passed on through its programme of guided tours that continue to play an essential role in the defence of the heritage buildings of Brussels.\r\n\r\nOur catalogue includes: guided tours about the history and architectural heritage of Brussels, discovery of neighbourhoods, and tours over current projects on urban development.\r\n\r\nARAU can arrange these tours on request for private groups throughout the year, tailored to your specific requirements regarding date, time, duration and language (French, English, Dutch, German, Spanish or Italian). So if you would like to follow a guided tour of Brussels with qualified guides in a convivial atmosphere, contact us!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Ma