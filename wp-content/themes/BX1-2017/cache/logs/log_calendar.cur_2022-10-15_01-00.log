ication_state":"public","last_updated_at":"2022-10-14T11:35:03+02:00","published_at":"2022-10-11T09:39:17+02:00","backoffice_id":263832,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.16113901317993},{"id":506364,"date_start":"2022-10-22","date_end":"2022-10-22","date_next":"2022-10-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,11],"translations":{"fr":["Pop, rock, jazz\u2026","Hip hop, rnb, rap"],"nl":["Pop, rock, jazz\u2026","Hip hop, r&b, rap"],"en":["Pop, rock, jazz\u2026","Hip hop, rnb, rap"],"de":["Pop, Rock, Jazz...","Hiphop, Rnb, Rap"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Jok'Air","shortdescr":"Big Daddy Jok aka Jok'Chirac revient pour kicker sale \u00e0 l'Orangerie !","longdescr":"Jok\u2019air fait rapidement parler de lui avec la MZ qui conna\u00eet un succ\u00e8s fulgurant avec cinq mixtapes, trois albums, dont un disque d'or et deux tourn\u00e9es europ\u00e9ennes. Pour des raisons priv\u00e9es, la Mafia Zeutrei explose en plein vol et Jok\u2019air continue sa route en solo. Le rappeur du 13\u00e8me ne baisse pas les bras et nous inonde de projets : \u00ab Big Daddy Jok \u00bb, \u00ab Je suis Big Daddy \u00bb, \u00ab Jok\u2019Pololo \u00bb et \u00ab Jok'Rambo \u00bb. Plus prolifique que jamais, il collabore avec Mac Tyer, Sadek, S.pri Noir, Deen Burbigo, Alkpote, Sneazzy ou encore Laylow. Avec son nouvel album \u00ab Jok'Chirac \u00bb, il nous revient plus que jamais en forme, la preuve avec \u00ab Sa maire aux m\u00e8res \u00bb, o\u00f9 il s\u2019entoure de Diddi Trix, Sadek, Luv Resval et Alk ! A l\u2019aise pour kicker autant que pour chanter et nous entra\u00eener dans des univers teint\u00e9s de romance, de gr\u00e2ce et de m\u00e9lancolie, le plus grand lover du game avec ses grillz, locks et tatouages est pr\u00eat \u00e0 vous conqu\u00e9rir !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.botanique.be","email":"info@botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":"+32 2 218 37 32","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.506364"},"nl":{"name":"Jok'Air","shortdescr":"Big Daddy Jok aka Jok'Chirac komt terug met zijn nieuw album","longdescr":"Als lid van MZ kende Jok'Air een bliksemachtig succes met een reeks mixtapes, twee albums, een gouden plaat en twee Europese tours. Om priv\u00e9redenen ging de groep uit mekaar en tegenwoordig doet Jok'Air het solo. De rapper uit het 13de district rondde 2017 af met drie projecten \"Big Daddy Jok\", \"Je Suis Big Daddy\" en \"Jok'Pololo\". In 2018 bracht hij het album \"Jok'Rambo\" uit en niet veel later volgde in 2019 \u2018Jok\u2019Travolta\u2019. Rusten kent deze Franse hiphop artiest niet. We mogen zijn laatste album \"Jak\u2019Chirac\" verwachten en komt voor deze gelegenheid naar de Botanique.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.506364"},"en":{"name":"Jok'Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.506364"},"de":{"name":"Jok'Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.506364"},"it":{"name":"Jok'Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.506364"},"sp":{"name":"Jok'Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.506364"},"pt":{"name":"Jok'Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.506364"},"cn":{"name":"Jok'Air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.506364"}},"place":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"L\u2019\u00e9l\u00e9gant Centre Culturel de la Communaut\u00e9 fran\u00e7aise est joliment situ\u00e9 dans les anciens jardins botaniques pr\u00e8s de la petite ceinture de Bruxelles. Vous pouvez assister \u00e0 des concerts dans les espaces intimes \u00e0 l\u2019ambiance chaleureuse, dont  les plus connus sont l\u2019Orangerie, la Rotonde, le Mus\u00e9e et le Witloof Bar. \r\n\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"nl":{"name":"Botanique","address_street_name":"Koningsstraat","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Koningsstraat, 236","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"In de voormalige botanische tuinen aan de kleine ring, thans het klassevolle cultuurcentrum van de Franse Gemeenschap, is het goed toeven. Concerten vinden er plaats op een unieke locatie, in sfeervolle en intieme ruimtes. De kwalitatieve eclectische programmatie staat zeer open voor nieuwe trends.","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"en":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The former botanical gardens provide the unique location for the stylish cultural centre of the French community and are a great place to relax. Concerts are held in the intimate surroundings of its eight spaces and multipurpose halls, of which the most famous are the Orangerie, the Rotonde, the Museum, and the Witloof Bar.\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"de":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le Botanique z\u00e4hlt ohne Zweifel zu den sch\u00f6nsten und spektakul\u00e4rsten Veranstaltungsorten Br\u00fcssels. Das von 1826 bis 1829 von der \u201eSoci\u00e9t\u00e9 Royale d'Horticulture\u201c erbaute, ehemalige Gew\u00e4chshaus im neoklassizistischen Stil mit Eisen- und Glasarchitektur beherbergt seit 1984 einen hochkar\u00e4tigen Veranstaltungsort.\r\n\r\nInmitten des botanischen Gartens von Saint-Josse-ten-Noode, einer der 19 Br\u00fcsseler Gemeinden, w\u00e4chst und gedeiht heute ein quicklebendiger Ort der Kultur, der vor allem f\u00fcr Musikveranstaltungen, als Galerie und Caf\u00e9 genutzt wird. H\u00f6hepunkt des Jahres bildet im Fr\u00fchling das Musikfestival \u201eLes Nuits Botaniques\".","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Questo grande edificio, che doveva ospitare le collezioni di un precedente giardino botanico, \u00e8 stato costruito fra il 1826 ed il 1829. L'artista-arredatore Pierre-Fran\u00e7ois Gineste diresse i lavori secondo progetto dell'architetto Tilman-Fran\u00e7ois Suys. Rispettando la struttura tradizionale degli aranceti, ha immaginato un'imponente cupola rotonda centrale, affiancata da due ali ciascuna delle quali terminante in un padiglione leggermente sporgente. Grazie alla sua regolarit\u00e0 e semplicit\u00e0, la costruzione illustra perfettamente i principi dello stile neoclassico. Alle vetrate che riempiono gli spazi tra le colonne della sala circolare e che coprono il portico delimitato dal colonnato stesso, si aggiungono le serre adiacenti alle ali laterali. Inizialmente si era pensato di organizzare feste all'interno di questo ambiente magico, e a questo scopo venne allestita una grande sala fra l'aranceto orientale e la sala rotonda, ma questa diventer\u00e0 poi la sala degli erbari dal 1870. Fino al 1939, l'edificio verr\u00e0 utilizzato per il suo scopo originale. Riacquistato dallo Stato nel 1970, il locale diventer\u00e0 il Centro Culturale della Federazione Vallonia-Bruxelles e verr\u00e0 inaugurato come tale nel 1984. Oggi ospita numerosi eventi culturali dedicati all'arte contemporanea e vi si svolgono festival, tra i quali il famoso Nuits du Botanique, che hanno contribuito ad affermare la sua reputazione. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Este enorme edificio, pensado para albergar las colecciones de un antiguo jard\u00edn bot\u00e1nico, fue construido entre 1826 y 1829. El artista-decorador Pierre-Fran\u00e7ois Gineste dirigi\u00f3 las obras a partir de los planos del arquitecto Tilman-Fran\u00e7ois Suys. Respetando la estructura tradicional de los invernaderos de naranjas, imagin\u00f3 una imponente rotonda central con c\u00fapula flanqueada por dos pasillos que terminaban en un pabell\u00f3n ligeramente en relieve. Gracias a su regularidad y simplicidad, la elevaci\u00f3n ilustra a la perfecci\u00f3n los principios del estilo neocl\u00e1sico. Las vidrieras situadas en los intercolumnios de la rotonda y que cubren el p\u00f3rtico delimitado por esta misma columnata se suman a los invernaderos adosados a los pasillos laterales. Pronto se pens\u00f3 en organizar fiestas en este lugar m\u00e1gico, para lo cual se acondicion\u00f3 una sala entre el invernadero de naranjas oriental y la rotonda, pero a partir de 1870 se convirti\u00f3 en la sala de los herbarios. Hasta 1939 cumpli\u00f3 las funciones teniendo en cuenta su vocaci\u00f3n inicial. Recomprado por el Estado en 1970, el lugar se convirti\u00f3 en el centro cultural de la Federaci\u00f3n Valonia-Bruselas y se inaugur\u00f3 como tal en 1984. A d\u00eda de hoy este lugar alberga numerosas manifestaciones culturales dedicadas a la creaci\u00f3n contempor\u00e1nea y se ha vuelto prestigioso por los festivales que se celebran en \u00e9l, tales como las \u00abNoches del bot\u00e1nico\u00bb. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[15],"translations":{"fr":["Rogier"],"nl":["Rogier"],"en":["Rogier"]}},"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":"art_center","facebook_id":null,"backoffice_id":5,"location":{"lat":50.85461438,"lon":4.36620044},"region":"brussels","last_updated_at":"2022-10-11T03:06:10+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ra