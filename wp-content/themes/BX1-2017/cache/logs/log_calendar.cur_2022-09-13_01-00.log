intment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visa pour P\u00e9kin","shortdescr":"La saga Sherlock Holmes est de retour au Magic Land Th\u00e9\u00e2tre !","longdescr":"Clou\u00e9 au lit par une terrible fi\u00e8vre, Sherlock Holmes attend vainement son ami le docteur Watson; mais c'est le professeur Kubrick, le directeur du British Museum, compl\u00e8tement terrifi\u00e9 qui frappe \u00e0 sa porte en pleine nuit. Il faut dire que l'heure est grave, le myst\u00e9rieux parchemin de Lhassa vient d'\u00eatre d\u00e9rob\u00e9...\r\n\r\nCe texte essentiel \u00e0 la survie de l'humanit\u00e9 est d\u00e9sormais entre les mains d'individus dont le but ne fait aucun doute. Oubliant sa maladie, Sherlock Holmes embarque pour cette nouvelle aventure qui va l'emmener des ruelles de P\u00e9kin aux montagnes enneig\u00e9es du nord de la Chine. Un r\u00e9cit palpitant dont Watson et notre h\u00e9ros ne sortiront pas indemnes.","performers":"Texte et Mise en sc\u00e8ne de Patrick Chaboud\r\n\r\nAvec : Philippe Drecq, Barnab\u00e9 Dekeyser, St\u00e9fanie Greco, Anne-Isabelle Justens, Juan Marquez Garcia et Michael Manconi","boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"info@magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":"+32 2 245 50 64","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541130"},"nl":{"name":"Visa pour P\u00e9kin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541130"},"en":{"name":"