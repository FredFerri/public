ires et des rencontres adapt\u00e9es \u00e0 la capitale. Apprenez tout sur le travail, les \u00e9tudes, et la vie \u00e0 Bruxelles et en Flandre. D\u00e9couvrez la richesse de l' offre culturelle n\u00e9erlandophone des organisations bruxelloises et flamandes.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Muntpunt ","address_street_name":"Muntplein","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Brussel","address_line1":"Muntplein, 6","address_line2":"1000 Brussel","description_web":"Muntpunt is een bibliotheek, informatiehuis, ontmoetingsplek en je venster op Brussel. Laat je inspireren door boeken, verhalen en ontmoetingen op maat van de hoofdstad. Kom meer te weten over wonen, werken, studeren, leven en beleven in Brussel en Vlaanderen. Ontdek het rijke Nederlandstalige culturele en vrijetijdsaanbod van Brusselse en Vlaamse organisaties.\r\n\r\nIn Muntpunt kan je meer dan alleen boeken, cd\u2019s en dvd\u2019s ontlenen. Je kan er ook terecht voor activiteiten, taalcursussen, infosessies, luisterboeken, strips, spelletjes, en nog veel meer. Er valt bijna dagelijks iets te beleven in Muntpunt, van voorlezen tot documentaires, van infosessies tot rondleidingen, voor jong en oud. De activiteiten sluiten aan bij de bibliotheekwerking of spelen in op actuele thema's, steeds met de Brusselse hoofdstedelijke context in het achterhoofd. De rode draad door de programmatie is de samenwerking met Vlaamse en Brusselse partnerorganisaties. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":13020,"location":{"lat":50.84996484,"lon":4.35348679},"last_updated_at":"2024-08-30T11:20:51+02:00","published_at":"2013-10-19T01:35:36+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/1741668187559-muntpunt-ae3d83947e8663ecbdbeefb75e37ecd0e8517929.jpg","width":2000,"height":1333,"ratio":1.5,"oEmbed_height":1333,"oEmbed_width":2000,"translations":{"de":{"title":"Festival Norouz","copyright":null},"pt":{"title":"Festival Norouz","copyright":null},"en":{"title":"Festival Norouz","copyright":null},"it":{"title":"Festival Norouz","copyright":null},"cn":{"title":"Festival Norouz","copyright":null},"fr":{"title":"Festival Norouz","copyright":null},"sp":{"title":"Festival Norouz","copyright":null},"nl":{"title":"Festival Norouz","copyright":null}}}],"dates":[{"day":"2025-03-22","doors":null,"start":"12:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":0}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700007407,"date_start":"2025-03-22","date_end":"2025-03-22","date_next":"2025-03-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holida