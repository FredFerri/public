-festival"]}},{"id":546394,"date_start":"2022-12-03","date_end":"2023-12-23","date_next":"2023-10-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-22T02:05:03+02:00","published_at":"2023-07-24T08:56:00+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":266394,"facebook_link":null,"import_origin":null,"is_part_of":"V\u00e9lo tourisme","sub_type":"tour","ranking":0.1373422733576596,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546394"},"pt":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.546394"},"en":{"name":"Guided bike tour | Highlights and hidden gems","shortdescr":"Discover Brussels by bike along its highlights and hidden gems","longdescr":"This bike guided bike tour along highlights and hidden gems is an ideal introduction to Brussels, its various neighbourhoods and many identities. During this tour, our guides offer you an interesting mix between highlights such as the Marolles, the Fish Market, the Courthouse and hidden gems along the city's less beaten tracks. A surprising view on the city, its heritage and versatility. The bikes are set aside halfway the tour for a break at a cosy bar or terrace. Discover more than you can imagine by bike! Practical info: - Every Saturday, tours in EN, FR and NL - With your own bike or with one of our classic or e-bikes - Time: 3h30 - Meeting point: city center, Grand Hospice Discover more on our website: https:\/\/cactus.brussels\/public-bike-tours","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/discover-brussels-bike-tours","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546394"},"it":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546394"},"cn":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.546394"},"fr":{"name":"Tour guid\u00e9 \u00e0 v\u00e9lo | Les incontournables et Insolite","shortdescr":"D\u00e9couvrez Bruxelles \u00e0 v\u00e9lo le long de ses incontournables et sentiers moins battus!","longdescr":"Cette visite guid\u00e9e \u00e0 v\u00e9lo est l\u2019introduction id\u00e9ale \u00e0 Bruxelles, son histoire et ses nombreux quartiers. Un m\u00e9lange original entre les incontournables tels que le quartier des Marolles, le March\u00e9 aux Poissons, le Palais de Justice,... et les sentiers moins battus de la ville. Ce tour vous offre une vue surprenante sur la ville, son patrimoine et sa diversit\u00e9. \u00c0 mi-parcours, les v\u00e9los sont mis de c\u00f4t\u00e9 pour une pause dans un bar sympathique ou sur une terrasse. D\u00e9couvrez plus que vous ne l'imaginez \u00e0 v\u00e9lo ! Infos pratiques: - Tous les samedis, tours en FR, NL et EN - Avec votre propre v\u00e9lo ou un v\u00e9lo classique ou e-bike \u00e0 nous - Dur\u00e9e: 3h30 - D\u00e9part et arriv\u00e9e dans le centre-ville au Grand Hospice D\u00e9couvrez plus sur notre site web: https:\/\/cactus.brussels\/tours-velo-publiques","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546394"},"sp":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546394"},"nl":{"name":"Gegidste fietstocht | Highlights en minder betreden paden","shortdescr":"Ontdek Brussel met de fiets langs highlights en minder betreden paden!","longdescr":"Deze fietstocht langs de highlights en minder betreden paden is de ideale kennismaking met Brussel, haar erfgoed en diversiteit aan wijken. Onze gidsen maken van deze tour een boeiende mix tussen highlights als de Marollen, de Vismarkt of het Justitiepaleis en de minder betreden paden van de stad. Een verrassende blik op de stad en haar veelzijdigheid want Brussel is meer dan haar klassieke highlights! Halverwege de tour gaan de fietsen aan de kant voor een pauze in een gezellige bar of terrasje. Ontdek meer dan je zou verwachten, met de fiets! Praktische info: - \nElke zaterdag tours in NL, FR en EN - Met je eigen fiets of een klassieke fiets of e-bike van ons - Vertrek en einde in het stadscentrum, Grand Hospice Ontdek meer op onze website: https:\/\/cactus.brussels\/publieke-fietstochten","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-met-de-fiets","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546394"}},"place":{"id":277608,"translations":{"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo is an association of local volunteer guides with a passion for Brussels and cycling. They enthusiastically share their passion for the city and cycling with visitors to Brussels and other Brussels residents. On their bikes they find the right pace to immerse you in the city and offer an authentic Brussels experience. Above all, they prefer to guide you off the beaten track in a friendly atmosphere. Experience Brussels in all its splendour by bike and discover more than you think.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo est une association de guides b\u00e9n\u00e9voles locaux ayant \u00e0 c\u0153ur Bruxelles et le v\u00e9lo. Ils partagent avec enthousiasme leur passion pour la ville et le v\u00e9lo avec des visiteurs de Bruxelles et d\u2019autres Bruxellois. A v\u00e9lo ils trouvent le rythme id\u00e9al pour vous immerger dans la ville et ils offrent une exp\u00e9rience authentique \u00e0 Bruxelles. Avant tout, ils pr\u00e9f\u00e8rent vous guider hors des chemins battus et cela dans une ambiance conviviale. Vivez Bruxelles dans toute sa splendeur \u00e0 v\u00e9lo et d\u00e9couvrez plus que vous ne le pensez.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo is een vereniging van lokale vrijwillige gidsen met een passie voor Brussel en de fiets. Ze delen hun passie voor de stad en het fietsen enthousiast met bezoekers van Brussel en andere Brusselaars. Op hun fietsen vinden ze het juiste tempo om u onder te dompelen in de stad en u een authentieke Brusselse ervaring te bieden. Bovenal begeleiden ze jullie graag buiten de gebaande paden in een vriendelijke sfeer. Beleef Brussel in al zijn pracht per fiets en ontdek meer dan jullie denken.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":37608,"location":{"lat":50.85351136,"lon":4.35012167},"region":"brussels","last_updated_at":"2023-07-10T11:07:14+02:00","published_at":"2022-01-17T17:56:22+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":277608,"translations":{"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Cactus Brussel \u00e0