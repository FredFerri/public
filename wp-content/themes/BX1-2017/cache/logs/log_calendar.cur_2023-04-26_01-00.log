ame":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":15}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,259,263],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-13T10:05:17+02:00","published_at":"2022-08-23T14:40:05+02:00","backoffice_id":260185,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.18616131324212},{"id":549977,"date_start":"2023-01-28","date_end":"2023-06-24","date_next":"2023-05-06","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[255],"translations":{"fr":["Visites d'expositions"],"nl":["Tentoonstelling"],"en":["Exhibition guided tours"],"de":["Besuche von Ausstellungen"],"it":["Visite a esposizioni"],"sp":["Visitas a las exposiciones"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Exposition Art Beats - Belfius Art Collection","shortdescr":"L'exposition baptis\u00e9e \u00ab Art Beats \u00bb rassemble des styles, des mouvements et des artistes diff\u00e9rents, avec la volont\u00e9 de les faire entrer en dialogue.","longdescr":"N\u00e9e de la fusion des collections d\u2019art du Cr\u00e9dit Communal, de la Banque Paribas Belgique et de la Banque BACOB, la Belfius Art Collection, compos\u00e9e de plus de 4300 oeuvres, balaie pr\u00e8s de cinq si\u00e8cles d'art et s\u2019articule autour de trois axes : les grands ma\u00eetres flamands, l'art moderne et l'art contemporain.\r\n\r\nL'exposition baptis\u00e9e \u00ab Art Beats \u00bb rassemble des styles, des mouvements et des artistes diff\u00e9rents, avec la volont\u00e9 de les faire entrer en dialogue. Les ma\u00eetres classiques parlent aux talents de notre temps. Les modernes se confrontent aux anciens. Des \u0153uvres c\u00e9l\u00e8bres conversent avec des joyaux discrets, de Pierre-Paul Rubens, Ren\u00e9 Magritte, Rik Wouters, Paul Delvaux, L\u00e9on Spilliaert, Jules Schmalzigaug, Th\u00e9o Van Rysselberghe et James Ensor \u00e0 Pierre Alechinsky, Sanam Khatibi, Micha\u00ebl Borremans, en passant par Edith Dekyndt, Jan Vercruysse, Joris Van de Moortel, Jan Van Imschoot, Sophie Kuijken, Bendt Eyckermans et bien d\u2019autres artistes de renom.\r\n\r\nVenez d\u00e9couvrir cette exposition qui c\u00e9l\u00e8bre la rencontre in\u00e9dite entre des \u0153uvres d\u2019art belges qui se m\u00ealent en un concert qui r\u00e9sonnera longtemps. Une exp\u00e9rience in\u00e9dite qui met tous les sens en \u00e9veil !\r\n\r\nSitu\u00e9 au 32e \u00e9tage de la Tour Belfius, place Rogier, vous d\u00e9couvrirez aussi un panorama exceptionnel sur Bruxelles.\r\nL'exposition se cl\u00f4ture le 24 juin 2023.\r\n\r\nSi vous participez \u00e0 une visite Arkadia merci de ne pas vous inscrire sur le site de Belfius. Votre place sera automatiquement r\u00e9serv\u00e9e. \r\n\r\nBelfius demande \u00e0 chaque visiteur une contribution de 5 euros \u00e0 r\u00e9gler sur place afin de soutenir les actions Viva for Life (en faveur des jeunes enfants et familles qui vivent sous le seuil de pauvret\u00e9) et JEZ! (en faveur d'organisations intervenant aupr\u00e8s des jeunes). Cette contribution est facultative pour les clients Belfius munis de leur carte de banque ou de l\u2019app Belfius Mobile.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/exposition-art-beats-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549977"},"nl":{"name":"Exposition Art Beats - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/exposition-art-beats-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549977"},"en":{"name":"Exposition Art Beats - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/exposition-art-beats-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549977"},"de":{"name":"Exposition Art Beats - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/exposition-art-beats-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.549977"},"it":{"name":"Exposition Art Beats - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/exposition-art-beats-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.549977"},"sp":{"name":"Exposition Art Beats - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/exposition-art-beats-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.549977"},"pt":{"name":"Exposition Art Beats - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/exposition-art-beats-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.549977"},"cn":{"name":"Exposition Art Beats - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/exposition-art-beats-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.549977"}},"place":{"id":266601,"translations":{"fr":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"La collection Belfius est la plus grande collection d\u2019art belge du pays. La collection compte plus de 4 300 \u0153uvres d\u2019art et r\u00e9sulte de la fusion des collections du Cr\u00e9dit communal de Belgique, de Paribas Banque Belgique et de BACOB Banque.\r\n\r\nApr\u00e8s la Deuxi\u00e8me Guerre Mondiale, tant le Cr\u00e9dit communal que Paribas Belgique ont commenc\u00e9 \u00e0 acqu\u00e9rir des \u0153uvres de grande valeur li\u00e9es \u00e0 l\u2019h\u00e9ritage national belge, afin d\u2019\u00e9viter qu\u2019elles ne disparaissent \u00e0 l\u2019\u00e9tranger. D\u00e8s le d\u00e9but, le Cr\u00e9dit communal a mis l\u2019accent sur l\u2019art belge \u00e0 partir de 1860, tandis que Paribas se concentrait principalement sur des \u0153uvres du 16e au 18e si\u00e8cle et sur l\u2019art contemporain. BACOB banque a commenc\u00e9 sa collection en 1980 et s\u2019est exclusivement consacr\u00e9e \u00e0 l\u2019art contemporain belge. Aujourd\u2019hui, la collection couvre pr\u00e8s de cinq si\u00e8cles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Belfius Art Gallery","address_street_name":"Charles Rogierplein","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Charles Rogierplein","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"De Belfius-kunstcollectie is de grootste verzameling van Belgische kunst van het land en omvat meer dan 4300 werken, het gevolg van de samensmelting van de kunstverzamelingen van het Gemeentekrediet, Paribas Bank Belgi\u00eb en BACOB Bank.\r\n\r\nZowel het Gemeentekrediet als Paribas Belgi\u00eb begonnen na de Tweede Wereldoorlog met het verzamelen van waardevolle kunstwerken uit het nationaal erfgoed om te vermijden dat ze naar het buitenland verdwenen. Het Gemeentekrediet legde van in het begin het accent op Belgische kunst vanaf 1860, terwijl Paribas Belgi\u00eb kunst uit de 16de tot de 18de eeuw en moderne kunst kocht. BACOB bank begon zijn verzameling in 1980 en legde zich uitsluitend toe op Belgische hedendaagse kunst. Vandaag bestrijkt de collectie werken uit bijna vijf eeuwen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/ww