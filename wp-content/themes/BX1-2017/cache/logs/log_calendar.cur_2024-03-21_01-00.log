,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296261,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.311765953881872,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"STELLA by Anne-Charlotte Moulard","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.annecharlottemoulard.com\/stella","email":"project@brainstories.art","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008330"},"pt":{"name":"STELLA by Anne-Charlotte Moulard","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.annecharlottemoulard.com\/stella","email":"project@brainstories.art","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008330"},"en":{"name":"STELLA by Anne-Charlotte Moulard","shortdescr":"EXPOSITION - STELLA \n\nStella est le lieu o\u00f9 Anne-Charlotte Moulard a grandi et le point de d\u00e9part de tous ses projets ; Cinecitt\u00e0 sans Pier Paolo Pasolini, la ville d\u2019un western spaghetti sans Sergio Leone et la plage abandonn\u00e9e par G\u00e9rard Depardieu et Patrick Dewaere depuis le tournage du film Les Valseuses, ici la ville attend d\u00e9sesp\u00e9r\u00e9ment le mot  \u00ab action \u00bb  de sa r\u00e9alisatrice.","longdescr":"EXPOSITION - STELLA \nPendant 18 ans, Anne-Charlotte Moulard, photographe et cin\u00e9aste, a captur\u00e9 ses voisins comme s\u2019ils \u00e9taient les acteurs d\u2019une sc\u00e8ne pr\u00eate \u00e0 \u00eatre film\u00e9e et les lieux comme des d\u00e9cors de cin\u00e9ma dans un projet de documentaire narratif \u00e0 la lisi\u00e8re de la fiction.\n\nStella est le lieu o\u00f9 Anne-Charlotte Moulard a grandi et le point de d\u00e9part de tous ses projets ; Cinecitt\u00e0 sans Pier Paolo Pasolini, la ville d\u2019un western spaghetti sans Sergio Leone et la plage abandonn\u00e9e par G\u00e9rard Depardieu et Patrick Dewaere depuis le tournage du film Les Valseuses, ici la ville attend d\u00e9sesp\u00e9r\u00e9ment le mot  \u00ab action \u00bb  de sa r\u00e9alisatrice.\n\nPar ces images \u00e0 la lisi\u00e8re de la fiction, elle sugg\u00e8re la ligne de faille de la repr\u00e9sentation objective d\u2019un lieu. Pour ajouter au trouble, l\u2019harmonie des images rend impossible leur datation, celles-ci ayant \u00e9t\u00e9 r\u00e9alis\u00e9es sur une grande p\u00e9riode. \n\u200b\nSans jamais indiquer \u00e0 quoi ressemble la ville dans son ensemble, insidieusement, elle perd toujours plus le spectateur dans ce lieu r\u00e9el aux contours imaginaires.Stella devient alors un personnage. La ville fascine et intrigue. \u00c0 dessein, cet endroit secret, reste impalpable et \u00e9ternel. ","performers":"EXPOSITION - STELLA \n\nStella est le lieu o\u00f9 Anne-Charlotte Moulard a grandi et le point de d\u00e9part de tous ses projets ; Cinecitt\u00e0 sans Pier Paolo Pasolini, la ville d\u2019un western spaghetti sans Sergio Leone et la plage abandonn\u00e9e par G\u00e9rard Depardieu et Patrick Dewaere depuis le tournage du film Les Valseuses, ici la ville attend d\u00e9sesp\u00e9r\u00e9ment le mot  \u00ab action \u00bb  de sa r\u00e9alisatrice.","boxoffice_url":null,"website":"https:\/\/www.annecharlottemoulard.com\/stella","email":"project@brainstories.art","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008330"},"it":{"name":"STELLA by Anne-Charlotte Moulard","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.annecharlottemoulard.com\/stella","email":"project@brainstories.art