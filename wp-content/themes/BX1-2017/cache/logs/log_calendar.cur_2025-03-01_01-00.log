n zondag: van 15:00 tot 18:00"]},"date_start":"2024-12-10","date_end":"2025-03-09","is_also_by_appointment":true}],"date_exceptions":[],"closing_days":["2024-12-14","2024-12-25","2025-01-01"],"child_events":[],"parent_events":[],"accessibilities":{"list":[263],"translations":{"de":["Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"pt":[null],"en":["Accessible to pedestrians with mobility aids"],"it":["Accessibile ai pedoni con supporti"],"cn":[null],"fr":["Accessible aux pi\u00e9tons appareill\u00e9s"],"sp":["Habilitado para peatones con aud\u00edfonos"],"nl":["Toegankelijk voor voetgangers met hulpmiddelen"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2024-12-10","end":"21:00:00","is_only_by_appointment":false,"start":"17:30:00","timestamp":"2024-12-10T17:30:00"}},{"id":5700006024,"date_start":"2025-02-16","date_end":"2025-08-17","date_next":"2025-02-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-28T01:03:08+01:00","published_at":"2025-01-30T17:30:29+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317219,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2795994421189559,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"NAPOLEON, L'\u00e9pop\u00e9e immersive","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be\/fr\/napoleon-lepopee-immersive","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006024"},"pt":{"name":"NAPOLEON, L'\u00e9pop\u00e9e immersive","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be\/fr\/napoleon-lepopee-immersive","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006024"},"en":{"name":"NAPOLEON, L'\u00e9pop\u00e9e immersive","shortdescr":"Leap into history with Napoleon. The Immersive Saga! Enjoy a unique 30-minute virtual reality experience at the Royal Museum of the Armed Forces and of Military History in Brussels starting 16 February 2025, and discover Napoleon I in an entirely new light.  ","longdescr":"Longwood, 1817. Napoleon welcomes you to his last residence, on Saint Helena, where dark skies hover over the southern Atlantic Ocean. Your virtual reality helmet enables you to hear his thoughts and listen to his confidences. As he speaks, everything comes to life: the staff meeting on the eve of the Battle of Austerlitz, a cavalry charge by the Guard Cuirassiers, taking the stairs inside the Vend\u00f4me Column, the icy atmosphere of the Berezina, the last journey to Saint Helena...\nEquipped with an HTC Vive Focus 3 helmet, you wander around a 60 m2 venue and discover the First Empire\u2019s emblematic sites and watershed moments, elaborated with great historical accuracy and exceptional rendering of both images and sounds. A selection of the Museum\u2019s collection items acts as an introduction and offers a fascinating perspective on the era and its context. \nTo make this experience truly unforgettable, you chat with the Emperor\u2019s virtual twin.\nOn your own, with family or with friends: don\u2019t miss out on this unique dive into the legend of Napoleon!\n","performers":null,"boxoffice_url":null,"website":"https:\/\/militarymuseum.be\/en\/napoleon-immersive-saga","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006024"},"it":{"name":"NAPOLEON, L'\u00e9pop\u00e9e immersive","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be\/fr\/napoleon-lepopee-immersive","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006024"},"cn":{"name":"NAPOLEON, L'\u00e9pop\u00e9e immersive","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be\/fr\/napoleon-lepopee-immersive","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006024"},"fr":{"name":"NAPOLEON, L'\u00e9pop\u00e9e immersive","shortdescr":"Plongez au c\u0153ur de l\u2019Histoire avec Napol\u00e9on. L\u2019\u00e9pop\u00e9e immersive ! \u00c0 partir du 16 f\u00e9vrier 2025, vivez pendant 30 minutes une exp\u00e9rience de r\u00e9alit\u00e9 virtuelle unique au Mus\u00e9e royal de l\u2019Arm\u00e9e et d\u2019Histoire militaire de Bruxelles, et d\u00e9couvrez Napol\u00e9on Ier comme vous ne l\u2019avez jamais vu.","longdescr":"Longwood, 1817. Sous le ciel lourd de l\u2019Atlantique Sud, Napol\u00e9on vous accueille dans sa derni\u00e8re demeure, \u00e0 Sainte-H\u00e9l\u00e8ne. \u00c9quip\u00e9 de votre casque de r\u00e9alit\u00e9 virtuelle, vous \u00e9coutez ses confidences et plongez dans ses m\u00e9moires. Tandis qu\u2019il relate ses souvenirs, les sc\u00e8nes prennent vie autour de vous : la r\u00e9union d\u2019\u00e9tat-major \u00e0 la veille de la bataille d\u2019Austerlitz, une charge de cavalerie des cuirassiers de la Garde, la mont\u00e9e de la colonne Vend\u00f4me, l\u2019ambiance glaciale de la B\u00e9r\u00e9zina, l\u2019ultime voyage vers Sainte-H\u00e9l\u00e8ne... \nMuni d\u2019un casque HTC Vive Focus 3, vous d\u00e9ambulez dans un espace de 60 m2, \u00e0 la d\u00e9couverte des lieux et moments cl\u00e9s du Premier Empire, recr\u00e9\u00e9s avec une pr\u00e9cision historique rigoureuse et une restitution visuelle et sonore d\u2019exception. En pr\u00e9lude \u00e0 cette exp\u00e9rience, une s\u00e9lection de pi\u00e8ces embl\u00e9matiques issues des collections du Mus\u00e9e illustre la p\u00e9riode napol\u00e9onienne, offrant une perspective captivante sur l\u2019\u00e9poque et son contexte.\nPour compl\u00e9ter cette immersion, vous avez \u00e9galement l\u2019opportunit\u00e9 de vous entretenir avec le jumeau virtuel de l\u2019Empereur. \nQue vous soyez seul, en famille ou entre amis, ne manquez pas ce voyage in\u00e9dit au c\u0153ur de la l\u00e9gende napol\u00e9onienne !\n","performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be\/fr\/napoleon-lepopee-immersive","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006024"},"sp":{"name":"NAPOLEON, L'\u00e9pop\u00e9e immersive","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be\/fr\/napoleon-lepopee-immersive","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006024"},"nl":{"name":"NAPOLEON, L'\u00e9pop\u00e9e immersive","shortdescr":"Duik de geschiedenis in met Napoleon. Het immersieve avontuur! Vanaf 16 februari 2025 kan u in het Brusselse Koninklijk Museum van het Leger en de Krijgsgeschiedenis 30 minuten lang van een unieke virtual reality-ervaring genieten en Napoleon I vanuit een volledig nieuw perspectief ontdekken.","longdescr":"Longwood, 1817. Napoleon verwelkomt u in zijn laatste verblijfplaats, op Sint-Helena, waar donkere wolken laag over het zuiden van de Atlantische Oceaan drijven. Via uw virtual reality-helm neemt hij u in vertrouwen en haalt hij herinneringen op. Terwijl hij vertelt, komt alles tot leven: de stafvergadering aan de vooravond van de slag bij Austerlitz, een cavalerieaanval door de kurassiers van de Garde, het bestijgen van de trappen in de Vend\u00f4me-kolom, de ijzige atmosfeer van de Berezina, de laatste reis naar Sint-Helena... \nUitgerust met een HTC Vive Focus 3-helm dwaalt u rond in een ruimte van 60 m2 en ontdekt u de kenmerkende plaatsen en de keerpunten van het Eerste Keizerrijk, uitgewerkt met verregaande historische nauwkeurigheid en uitzonderlijke weergave van beeld en klank. Als inleiding illustreren enkele objecten uit de collecties van het Museum de napoleontische periode, waardoor een boeiend perspectief op het tijdperk en de context wordt geboden.\nOm deze ervaring onvergetelijk te maken, voert u ook nog een gesprek met de virtuele tweelingbroer van de keizer. \nAlleen, met familie of met vrienden: mis deze unieke duik in de legende van Napoleon niet!\n","performers":null,"boxoffice_url":null,"website":"https:\/\/legermuseum.be\/nl\/napoleon-immersieve-saga","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006024"}},"place":{"id":555,"translations":{"de":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Mais de dez s\u00e9culos de hist\u00f3ria e de t\u00e9cnicas militares passaram em revista por este museu. A\u00ed encontramos toda a pan\u00f3plia de guerra, da Idade M\u00e9dia \u00e0 \u00e9poca contempor\u00e2nea: armaduras medievais, armas de fogo, avi\u00f5es, carros blindados contempor\u00e2neos, uniformes e penteados militares\u2026\r\nDesde 1 de maio de 2017, o Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar pertence ao War Heritage Institute, a nova institui\u00e7\u00e3o de refer\u00eancia para o patrim\u00f3nio militar e a mem\u00f3ria na B\u00e9lgica.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"War Heritage Institute (Royal Military Museum)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Brussels","description_web":"Here you\u2019ll find medieval armour and souvenirs from the Napoleonic campaigns, as well as a hundred or so aircraft and armoured vehicles from the two Great Wars. A breathtaking panoramic view awaits you at the top of the Arcade.\r\n\r\nSince May 1, 2017 the Royal Military Museum is part of the War Heritage Institute, the new reference institution for military heritage and remembrance in Belgium. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"War Heritage Institute (Mus\u00e9e Royal de l\u2019Arm\u00e9e)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Plus de dix si\u00e8cles d\u2019histoire et de techniques militaires sont pass\u00e9s en revue dans ce mus\u00e9e. On y trouve toute la panoplie de guerre, du Moyen \u00c2ge \u00e0 l\u2019\u00e9poque contemporaine: armures m\u00e9di\u00e9vales, armes \u00e0 feu, avions, blind\u00e9s contemporains, uniformes et coiffures militaires\u2026\r\n\r\nDepuis le 1er mai 2017, le Mus\u00e9e royal de l\u2019Arm\u00e9e appartient au War Heritage Institute, la nouvelle institution de r\u00e9f\u00e9rence pour le patrimoine militaire et la m\u00e9moire en Belgique. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Real de la Armada e Historia militar (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"El museo posee alrededor de 100.000 objetos(armas, uniformes, maquetas, documentos...), siendo as\u00ed unos de los museos militares m\u00e1s grandes del mundo. Encontrar\u00e1s: una secci\u00f3n de armas y armaduras de la Edad Media, una preciosa colecci\u00f3n del Imperio franc\u00e9s, la Armada belga desde 1831 a 1914 con vitrinas dedicadas al rey Leopoldo l y Leopoldo ll, el desarrollo de la tecnolog\u00eda armament\u00edstica(hacia la mitad del s.XX), la Primera y Segunda Guerra Mundial(uniformes, materiales fotos y documentos), veh\u00edculos armados y barcos de guerra. La secci\u00f3n \"a\u00e9rea\" del museo ofrece una gama completa de aviones, alrededor de 80 son expuestos.\u00a1Y no te pierdas nuestros juegos educativos para todas las \u00e9pocas!. \r\n\r\nLos centros de documentaci\u00f3n est\u00e1n abiertos al p\u00fablico.\r\n\r\nEspectacular vista panor\u00e1mica de la ciudad desde la galer\u00eda.\r\n\r\nLas exposiciones temporales pueden ser de varios temas.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"War Heritage Institute (Koninklijk Legermuseum)","address_street_name":"Jubelpark","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 3","address_line2":"1000 Brussel","description_web":"Meer dan tien eeuwen militaire geschiedenis passeren de revue in dit museum. Je krijgt er een overzicht van de ingrijpende veranderingen die door de jaren heen hebben plaatsgegrepen op het gebied van bewapening en militaire technologie, van de middeleeuwen tot op heden: wapens, harnassen, pantsers, vliegtuigen, uniformen, \u2026\r\n\r\nSinds 1 mei 2017 is het Koninklijk Legermuseum onderdeel van het War Heritage Institute, de nieuwe instelling voor militair erfgoed en herinnering in Belgi\u00eb. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":127,"location":{"lat":50.84086428,"lon":4.39335612},"region":"brussels","last_updated_at":"2023-04-13T11:45:06+02:00","published_at":"2013-10-19T01:13:18+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":555,"translations":{"de":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantena