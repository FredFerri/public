m 14:00 to 16:00"}}],"closing_days":["2022-03-11","2022-03-12","2022-03-13","2022-03-14","2022-03-15"],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[16,5,19,11,7,8,12,10],"translations":{"fr":["Ecoles","Enfants 9-12 ans","Enseignants","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","LGTBQIA","Seniors"],"nl":["Scholen","Kinderen 9-12 j.","Leerkrachten","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","LGTBQIA","Senioren"],"en":["Schools","Children 9-12 yr.","Teachers","Family","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors"]}},"educational_targets":{"list":[3,6,7,8,9],"translations":{"fr":["Secondaire","10 - 12 ans","12 - 14 ans","14 - 16 ans","16 - 18 ans"],"nl":["Secundair onderwijs","10 - 12 jaar","12 - 14 jaar","14 - 16 jaar","16 - 18 jaar"],"en":["Secondary school","10 - 12 years","12 - 14 years","14 - 16 years","16 - 18 years"]}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"]}},"tags":["kids"],"accessibilities":{"list":[255,261,263],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-17T01:07:06+02:00","published_at":"2021-03-04T11:38:08+01:00","backoffice_id":229506,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.11450960685465},{"id":513441,"date_start":"2021-06-18","date_end":"2024-01-06","date_next":"2022-07-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Chocolate Walking Tour and Workshop","shortdescr":"Venez pendant quatre heures battre le pav\u00e9 bruxellois et d\u00e9couvrir avec nous le monde merveilleux du chocolat avant de vous lancer dans la fabrication de votre propre chocolat. Nos guides vous feront partager leurs connaissances, ils vous permettront de d\u00e9couvrir les meilleurs chocolatiers et de d\u00e9lecter vos papilles des cr\u00e9ations chocolati\u00e8res les plus savoureuses.","longdescr":"Ce circuit chocolat est le summum du succulent ; vous d\u00e9couvrirez les principales marques de chocolat et o\u00f9 se trouvent leurs magasins. Cette visite est parfaite si vous souhaitez offrir du chocolat \u00e0 votre famille ou vos amis.\r\n\r\nVous pourrez go\u00fbter de nombreux chocolats exquis, dont la qualit\u00e9 augmentera de l\u2019un \u00e0 l\u2019autre. Ce circuit offre un aper\u00e7u impressionnant charg\u00e9 d\u2019histoire. Chaque \u00e9tape d\u00e9voile des monuments de Bruxelles : les Galeries Royales, le Palais Royal, la Cath\u00e9drale Saint-Paul et tous les myst\u00e8res qui s\u2019y cachent.\r\n\r\nPuis vous d\u00e9couvrirez l\u2019art de fabriquer du chocolat, la temp\u00e9rature de fusion, le pourcentage appropri\u00e9 de cacao et le processus de fabrication de la praline. Le circuit chocolat comprend aussi un atelier pratique d\u2019une heure sur le chocolat qui vous permettra de maitriser cet art.\r\n\r\nVous d\u00e9couvrirez comment cr\u00e9er vos propres formes et les d\u00e9corer avec des ingr\u00e9dients tels que le sel de mer, les fruits exotiques ou le s\u00e9same, le tout selon votre imagination et vos pr\u00e9f\u00e9rences.\r\n\r\nPour une exp\u00e9rience plus vivante, vous pourrez voir comment une praline est cr\u00e9\u00e9e en trois \u00e9tapes et vous pourrez la remplir avec une ganache. De plus, vous pourrez emporter vos cr\u00e9ations \u00e0 la maison !\r\n\r\nLe circuit chocolat est le compagnon id\u00e9al lors de votre s\u00e9jour \u00e0 Bruxelles.","performers":"Marc Oris guide","boxoffice_url":null,"website":"http:\/\/globalenterprises.be","email":"info@brusselsguidedwalkingtours.eu","phone_contact":"+32 479 31 90 03","phone_booking":"+32 479 31 90 03","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/513441.html"},"nl":{"name":"Chocolate Walking Tour and Workshop","shortdescr":"Ontdek Brussel tijdens een 4 uur durende begeleide wandeling, terwijl je de beste chocolatiers bezoekt. Een droom voor iedereen die van chocolade houdt. Overal kan je genieten van heerlijke proeverijen en tijdens de workshop leer je ze zelf te maken.","longdescr":"Het proeven van chocolade zal nooit meer hetzelfde zijn als anders, aangezien je de beste chocolade merken zult leren kennen. De tour is ook perfect voor mensen die chocolade willen kopen voor familie en vrienden, aangezien je vele chocolades zult proeven met verschillende smaken. \r\nDe tour bevat ook een wandeling langs de belangrijkste monumenten en gebouwen van Brussel; zoals de Koningklijke Gallerijen, Manneken Pis. \r\nHet hoogtepunt van de tour is de chocolade workshop waar we jou leren om jou eigen creaties te maken. Alles wat je maakt kan je meer naar huis nemen. \r\nDeze tour is een ervaring voor chocolade kenners en voor mensen die voor de eerste keer met betere kwaliteit chocolade in contact komen.","performers":"Marc Oris gids","boxoffice_url":null,"website":null,"email":"info@brusselsguidedwalkingtours.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/513441.html"},"en":{"name":"Chocolate Walking Tour and Workshop","shortdescr":"Explore Brussels on a 4-hour guided walking tour with a twist as you follow the trial of the city\u2019s top chocolate shops. A chocoholics dream! You will enjoy free samples and tastings of delectable Belgian chocolates and learn how to make your own sweet Belgian treats in a workshop.","longdescr":"Chocolate tasting will never be more delectable than during this tour, in which you will discover the top chocolate brands and the locations of their stores. This tour is also perfect for buying top-quality chocolate as a gift for relatives and friends \u2013 as you will sample many, exquisite chocolates of a quality that will increasingly surprise and delight you.\r\n\r\nThe route brings you through an impressive cityscape, full of history, with Brussels highlights located at every step. You will discover the Royal Galleries, The Royal Palace, Saint Michael\u2019s Cathedral \u2013 and all the mysteries behind them.\r\n\r\nAnd then \u2013 you will discover the art of chocolate making! Learn about melting temperature, determining a suitable percentage of cacao and the process of producing fine pralines. The Brussels Chocolate Walking Tour and Workshop also includes a 1\u2011hour, hands-on chocolate workshop, during which you will be the master chocolate-maker!\r\n\r\nFind out how to make your own shapes and decorate them with ingredients like sea salt, exotic fruits and sesame \u2013 all based on your own imagination and taste preferences.\r\n\r\nAnother vivid experience follows, as you see how a praline is created in three steps and fill your owns with caramel. And, of course, you get to take your chocolate creations home!\r\n\r\nThe Brussels Chocolate and Workshop Tour is your must-have chocolate and travel\u2011savvy friend in Brussels.","performers":"Marc Oris guide","boxoffice_url":null,"website":null,"email":"info@brusselsguidedwalkingtours.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/513441.html"},"de":{"name":"Chocolate Walking Tour and Workshop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/513441.html"},"it":{"name":"Chocolate Walking Tour and Workshop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/513441.html"},"sp":{"name":"Chocolate Walking Tour and Workshop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/513441.html"},"pt":{"name":"Chocolate Walking Tour and Workshop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/513441.html"},"cn":{"name":"Chocolate Walking Tour and Workshop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/513441.html"}},"place":{"id":266585,"translations":{"fr":{"name":"Global Enterprises","address_street_name":"Grand Place","address_street_number":"21","address_street_box":null,"email":"info@globalenterprises.be","website":"http:\/\/globalenterprises.be","phone_contact":"+32 479 31 90 03","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand Place, 21","address_line2":"1000 Bruxelles","description_web":"Global enterprises tours, est une entreprise sp\u00e9cialis\u00e9e dans l\u2019organisation de tours touristiques. Cr\u00e9\u00e9e dans le but de promouvoir l\u2019h\u00e9ritage culturel de Bruxelles. \r\n\r\nLes tours propos\u00e9s se d\u00e9marquent par leur haute qualit\u00e9, dont peuvent jouir les voyageurs ind\u00e9pendants ainsi que les groupes priv\u00e9s pour lesquels il est possible de cr\u00e9er des tours personnalis\u00e9s. \r\n\r\nNous vous proposons un grand panel de tours, allant de la d\u00e9gustation de chocolat \u00e0 celle de la bi\u00e8re, en passant par la d\u00e9couverte de l\u2019art culinaire belge, tout cela combin\u00e9 avec une d\u00e9couverte personnalis\u00e9e de la ville.\r\n\r\nL\u2019entreprise propose \u00e9galement des voyages sur mesure, personnalisables selon vos envies, Gand, Bruges ou le Luxembourg.\r\n\r\nLangues: fran\u00e7ais, n\u00e9erlandais, anglais.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Global Enterprises","address_street_name":"Grand Place","address_street_number":"21","address_street_box":null,"email":"info@globalenterprises.be","website":"http:\/\/globalenterprises.be","phone_contact":"+32 479 31 90 03","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grand Place, 21","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Global Enterprises","address_street_name":"Grand Place","address_street_number":"21","address_street_box":null,"email":"info@globalenterprises.be","website":"http:\/\/globalenterprises.be","phone_contact":"+32 479 31 90 03","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand Place, 21","address_line2":"1000 Brussels","description_web":"Global Enterprises Tours is a professional trade company created with the primary purpose of promoting Brussels\u2019s legacy within the tour operator industry. \r\n\r\nThe company specialises in providing competitive and superior quality tours to independent travellers, whether private or in a custom group, through a diverse brochure of tour programs and packages, including chocolate, beer and cuisine and city discovery.\r\n\r\nThe company is also an adept of the tailor-made travel, customizable to suit the needs and preferences of the clients and therefore organizing tours as well in Bruges, Gent or Luxembourg.\r\n\r\nLanguages: English, Dutch, French.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Global Enterprises","address_street_name":"Grand Place","address_street_number":"21","address_street_box":null,"email":"info@globalenterprises.be","website":"http:\/\/globalenterprises.be","phone_contact":"+32 479 31 90 03","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand Place, 21","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Global Enterprises","address_street_name":"Grand Place","address_street_number":"21","address_street_box":null,"email":"info@globalenterprises.be","website":"http:\/\/globalenterprises.be","phone_contact":"+32 479 31 90 03","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand Place, 21","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Global Enterprises","address_street_name":"Grand Place","address_street_number":"21","address_street_box":null,"email":"info@globalenterprises.be","website":"http:\/\/globalenterprises.be","phone_contact":"+32 479 31 90 03","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand Place, 21","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Global Enterprises","address_street_name":"Grand Place","address_street_number":"21","address_street_box":null,"email":"info@globalenterprises.be","website":"http:\/\/globalenterprises.be","phone_contact":"+32 479 31 90 03","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand Place, 21","address_line2":"1000 Bruxelles","description_web":"","