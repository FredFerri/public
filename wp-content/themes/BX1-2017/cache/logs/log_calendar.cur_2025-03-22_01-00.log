:00"],"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 19:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 19:00"]},"date_start":"2025-03-05","date_end":"2025-12-31","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"elloha_lmt_id":"7f6e4590-1ff7-496c-b81e-8fcf49b70e29"},{"id":5700006879,"date_start":"2025-02-19","date_end":"2025-12-31","date_next":"2025-03-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T12:22:34+01:00","published_at":"2025-02-19T10:13:13+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":318620,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.18497554021932686,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"Visite des Mus\u00e9es Maison d'Erasme & B\u00e9guinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/de\/besucher\/veranstaltungskalender\/event-detail\/book-tickets.Visite-des-Musees-Maison-d-Erasme-and-Beguinage.5700006879","website":"https:\/\/www.erasmushouse.museum\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006879"},"pt":{"name":"Visite des Mus\u00e9es Maison d'Erasme & B\u00e9guinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Visite-des-Musees-Maison-d-Erasme-and-Beguinage.5700006879","website":"https:\/\/www.erasmushouse.museum\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006879"},"en":{"name":"Visit of the Museums Erasmushouse & Beguinage","shortdescr":null,"longdescr":"The Erasmus House, beguinage, and collegiate church of Saints Peter and Guido forma magnificent historical ensemble, right in the heart of the commune. Erasmus House\u2013in which the famous philosopher and scholar stayed from May to October 1521\u2013is one of the oldest Gothic houses in the Belgian capital.\n\nIt hosts a sublime collection of paintings, prints and sculptures by 15th-17th century masters like Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... not to mention portraits of Erasmus inspired by Hans Holbein and Quentin Metsys. A rich collection of 16th century books is a nod to the singular humanist\u2019s thinking.\n\nA medicinal plant garden\u2013designed by landscape architect Ren\u00e9 Pech\u00e8re\u2013presents around one hundred medicinal plants that were known to 16thcentury physicians. Beyond it stretches a philosophical garden that is home to the works of contemporary artists like Marie-Jo Lafontaine and Bob Verschueren. The beguinage of Anderlecht is Belgium\u2019s smallest.\n\nFounded in 1252, today it consists of two wings framing an enclosed garden with its own well. It housed beguines right up until the French Revolution. The beguinage has been restored in depth and is once again open to visitors each 1st Sunday of the month with guided tours. Discover this entirely restored architectural jewel in a pristine state. \n\nTo prepare for your visit, please consult the garden rules on the Erasmushouse & Beguinage website.  ","performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Visit-of-the-Museums-Erasmushouse-and-Beguinage.5700006879","website":"https:\/\/www.erasmushouse.museum\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006879"},"it":{"name":"Visite des Mus\u00e9es Maison d'Erasme & B\u00e9guinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/it\/visitatori\/agenda\/event-detail\/book-tickets.Visite-des-Musees-Maison-d-Erasme-and-Beguinage.5700006879","website":"https:\/\/www.erasmushouse.museum\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006879"},"cn":{"name":"Visite des Mus\u00e9es Maison d'Erasme & B\u00e9guinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Visite-des-Musees-Maison-d-Erasme-and-Beguinage.5700006879","website":"https:\/\/www.erasmushouse.museum\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006879"},"fr":{"name":"Visite des Mus\u00e9es Maison d'Erasme & B\u00e9guinage","shortdescr":null,"longdescr":"La Maison d\u2019\u00c9rasme et le b\u00e9guinage, voisins de la coll\u00e9giale des Saints-Pierre-et-Guidon, constituent un ensemble historique remarquable au c\u0153ur de la commune d\u2019Anderlecht. \n\nLa Maison d\u2019\u00c9rasme est une des plus anciennes demeures de la r\u00e9gion de Bruxelles. \u00c9rasme y r\u00e9sida de mai \u00e0 octobre 1521. On y d\u00e9couvre des sculptures, peintures et gravures de ma\u00eetres des 15e au 17e si\u00e8cles :Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... ainsi que des portraits d\u2019\u00c9rasme, inspir\u00e9s de Hans Holbein et de Quentin Metsys. Une riche collection de livres du 16e si\u00e8cle refl\u00e8te la pens\u00e9e d'\u00c9rasme, le \u00abPrince des humanistes \u00bb.\n\nUn Jardin de plantes m\u00e9dicinales, dessin\u00e9 par le paysagiste Ren\u00e9 Pech\u00e8re, pr\u00e9sente une centaine de plantes connues du 16e si\u00e8cle. Au-del\u00e0, s\u2019\u00e9tend un Jardin philosophique qui abrite des \u0153uvres d\u2019artistes contemporains dont Marie-Jo Lafontaine et Bob Verschueren. \n\nLe b\u00e9guinage d\u2019Anderlecht est le plus petit b\u00e9guinage de Belgique. Fond\u00e9 en 1252, il se compose de deux ailes encadrant un jardin clos. Il accueillait des b\u00e9guines jusqu\u2019\u00e0 la R\u00e9volution fran\u00e7aise. Le b\u00e9guinage a subi une restauration approfondie et est d\u00e9sormais ouvert aux visiteurs les premiers dimanches du mois avec visites guid\u00e9es. D\u00e9couvrez le travail accompli pour rendre son allure d\u2019origine \u00e0 ce patrimoine architectural exceptionnel et unique en Europe. \n\nPour pr\u00e9parer votre visite, nous vous invitons \u00e0 consulter le r\u00e8glement du jardin sur le site internet de la Maison d'Erasme & B\u00e9guinage.","performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/fr\/visiteurs\/agenda\/event-detail\/book-tickets.Visite-des-Musees-Maison-d-Erasme-and-Beguinage.5700006879","website":"https:\/\/www.erasmushouse.museum\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006879"},"sp":{"name":"Visite des Mus\u00e9es Maison d'Erasme & B\u00e9guinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agenda\/event-detail\/book-tickets.Visite-des-Musees-Maison-d-Erasme-and-Beguinage.5700006879","website":"https:\/\/www.erasmushouse.museum\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006879"},"nl":{"name":"Bezoek van Musea Erasmushuis & Begijnhof","shortdescr":null,"longdescr":"Het Erasmushuis, het begijnhof en de collegiale Sint-Pieter-en Sint-Guidokerk vormen een uitzonderlijk historisch geheel in het centrum van de gemeente Anderlecht. Het Erasmushuis is een van de oudste huizen in Brussel waar Erasmus verbleef van mei tot oktober 1521. In de verschillende vertrekken kun je schilderijen en prenten van de meesters uit de 15de tot de 17de e euw ontdekken, zoals Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... als ook portretten van Erasmus naar het voorbeeld van Hans Holbein en Quentin Metsys.\n\nEen rijke collectie boeken uit de 16de eeuw vertegenwoordigt het gedachtegoed van deze bijzondere humanist. Achter het huis bevindt zich een tuin met geneeskrachtige planten ontworpen door landschapsarchitect Ren\u00e9 Pech\u00e8re. Hier worden zo\u2019n honderd geneeskrachtige planten gekweekt die bekend waren bij de geneesheren uit de 16de eeuw. Daarachter bevind t zich een filosofische tuin met werken van hedendaagse kunstenaars, zoals Marie - Jo Lafontaine en Bob Verschueren. \n\nHet begijnhof van Anderlecht is het kleinste van Belgi\u00eb. Het werd gesticht in 1252 en bestaat tegenwoordig uit twee vleugels rondom een ommuurde tuin met waterput. Hier vonden begijnen onderdak tot aan de Franse Revolutie. Na een grondige restauratie staat het begijnhof voortaan weer open voor bezoekers iedere 1ste zondag van de maand met rondleidingen. Ontdek wat voor een werk er werd verricht om aan dit uitzonderlijk architecturaal erfgoed \u2013 uniek in Europa\u2013 zijn oorspronkelijke allure terug te geven.\n\nOm uw bezoek voor te bereiden, kunt u het tuinreglement raadplegen op de website van Erasmushuis & Begijnhof","performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/nl\/bezoekers\/agenda\/event-detail\/book-tickets.Bezoek-van-Musea-Erasmushuis-and-Begijnhof.5700006879","website":"https:\/\/www.erasmushouse.museum\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006879"}},"place":{"id":8600,"translations":{"de":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nDas \u201eMaison d\u2019Erasme\u201c in der Br\u00fcsseler Gemeinde Anderlecht wurde Ende des 15. Jahrhunderts im Auftrag eines Stiftsherrn der nahegelegenen Stiftskirche St. Peter und St. Guido  im sp\u00e4tgotischen Stil errichtet.\r\n\r\nDas Haus beherbergte im Jahr 1521 den bedeutenden niederl\u00e4ndischen Gelehrten des Renaissance-Humanismus Erasmus von Rotterdam, der hier, fernab von den gro\u00dfen Machtzentren und den dort herrschenden Religionskriegen, die Ruhe und Abgeschiedenheit der Natur suchte.\r\n\r\nDas im Maison d\u2019Erasme untergebrachte Museum zeigt sowohl eine Gem\u00e4ldesammlung mit Werken von Holbein, Bosch und Metsys als auch eine reich mit alten B\u00fccherausgaben best\u00fcckte Bibliothek. Der umliegende Garten besteht aus einem \u201eJardin des Maladies\u201c \u2013 dem \u201eGarten der Krankheiten\u201c mit zahlreichen Heilpflanzen \u2013 und einem \u201eJardin philosophique\u201c \u2013 dem \u201ePhilosophischen Garten\u201c.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Erasmus House & Beguinage Museums","address_street_name":"Formanoirstraat","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Formanoirstraat, 31","address_line2":"1070 Anderlecht","description_web":"The Erasmus House, beguinage, and collegiate church of Saints Peter and Guido form a magnificent historical ensemble, right in the heart of the commune. Erasmus House \u2013 in which the famous philosopher and scholar stayed from May to October 1521 \u2013 is one of the oldest Gothic houses in the Belgian capital. It hosts a sublime collection of paintings, prints and sculptures by 15th-17th century masters like Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys\u2026 not to mention portraits of Erasmus inspired by Hans Holbein and Quentin Metsys. A rich collection of 16th century books is a nod to the singular humanist\u2019s thinking.  \n\nA medicinal plant garden \u2013 designed by landscape architect Ren\u00e9 Pech\u00e8re \u2013 presents around one hundred medicinal plants that were known to 16th century physicians. Beyond it stretches a philosophical garden that is home to the works of contemporary artists like Marie-Jo Lafontaine and Bob Verschueren. \n\nThe beguinage of Anderlecht is Belgium\u2019s smallest. Founded in 1252, today it consists of two wings framing an enclosed garden with its own well. It housed beguines right up until the French Revolution. The beguinage has been restored in depth and is once again open to visitors each 1st Sunday of the month with guided tours. Discover this entirely restored architectural jewel in a pristine state.\nA new museum project is currently in the pipeline.\n","description_print":"21\/09\/2022\r\nFor several months, this house, which looks like a cloister, was home to the brilliant 16th-century humanist. Works of art, engravings, books, and archives bear witness to life in that era. End your visit in the philosophical and medicinal garden.","booking_url":"http:\/\/ticket.visit.brussels\/en\/8600\/erasmus-house-beguinage-museums\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nLa Casa di Erasmo deve il suo nome e la sua fama ad Erasmo da Rotterdam, che vi soggiorn\u00f2 nel 1521. Divenuta un museo dedicato al grande umanista rinascimentale, \u00e8 luogo di esposizione di una collezione unica composta da opere d'arte - sculture e dipinti di maestri fiamminghi -, mobili e libri antichi, molti dei quali scritti dallo stesso Erasmo. Se la Casa di Erasmo \u00e8 una delle pi\u00f9 antiche di Bruxelles - costruita in tre fasi nel corso dei secoli XV e XVI -, nel 1932 \u00e8 stata oggetto di un restauro completo voluto, nello spirito del pi\u00f9 puro storicismo, da Daniel Van Damme, fondatore del museo, con l'aiuto dell'architetto Charles Van Elst, che costru\u00ec anche la casa di Maurice Car\u00eame.  Gli spazi interni sono stati poi riconvertiti in sale del museo. Queste sono state decorate (una stanza con le pareti completamente rivestite di sontuose pelli di Cordoba) ed arredate con mobili provenienti dall'antica collezione del Ministro Vandenpeereboom. Gli interni sono quindi ricostruzioni con lo scopo di dare ai visitatori un'idea di quello che poteva essere una residenza rinascimentale. Le ricostruzioni sono in parte basate su documenti storici (lo studio di Erasmo che d\u00e0 sul giardino) ed in parte su ritrovamenti archeologici quali lo splendido fregio affrescato del primo piano. Nella parte posteriore della casa, un ampio giardino ombreggiato da grandi alberi conserva alcuni resti archeologici dell'antico castello di Anderlecht, poeticamente abbinati a diverse installazioni di artisti contemporanei. ","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9es Maison d\u2019Erasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Maison d\u2019\u00c9rasme et le b\u00e9guinage, voisins de la coll\u00e9giale des Saints-Pierre-et-Guidon, constituent un ensemble historique remarquable au c\u0153ur de la commune d\u2019Anderlecht.  \nLa Maison d\u2019\u00c9rasme est une des plus anciennes demeures de la r\u00e9gion de Bruxelles. \u00c9rasme y r\u00e9sida de mai \u00e0 octobre 1521. On y d\u00e9couvre des sculptures, peintures et gravures de ma\u00eetres des 15e au 17e si\u00e8cles : Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... ainsi que des portraits d\u2019\u00c9rasme, inspir\u00e9s de Hans Holbein et de Quentin Metsys. Une riche collection de livres du 16e si\u00e8cle refl\u00e8te la pens\u00e9e d'\u00c9rasme, le \u00ab Prince des humanistes \u00bb. \nUn Jardin de plantes m\u00e9dicinales, dessin\u00e9 par le paysagiste Ren\u00e9 Pech\u00e8re, pr\u00e9sente une centaine de plantes connues du 16e si\u00e8cle. Au-del\u00e0, s\u2019\u00e9tend un Jardin philosophique qui abrite des \u0153uvres d\u2019artistes contemporains dont Marie-Jo Lafontaine et Bob Verschueren. \n\nLe b\u00e9guinage d\u2019Anderlecht est le plus petit b\u00e9guinage de Belgique. Fond\u00e9 en 1252, il se compose de deux ailes encadrant un jardin clos. Il accueillait des b\u00e9guines jusqu\u2019\u00e0 la R\u00e9volution fran\u00e7aise. Le b\u00e9guinage a subi une restauration approfondie et est d\u00e9sormais ouvert aux visiteurs les premiers dimanches du mois avec visites guid\u00e9es. D\u00e9couvrez le travail accompli pour rendre son allure d\u2019origine \u00e0 ce patrimoine architectural exceptionnel et unique en Europe. Un nouveau projet mus\u00e9al est en cours d\u2019\u00e9laboration.","description_print":"21\/09\/2022\r\n\u00c9rasme a s\u00e9journ\u00e9 en 1521 dans cette maison gothique (1450-1515) qui rassemble \u00e0\r\nla fois une collection de peintures, gravures et scuptures (Albrecht Du\u0308rer, Joos Van\r\nCleve, Pieter Huys, Cornelis Metsys, Frans Francken le Jeune \u2026), une biblioth\u00e8que\r\nsp\u00e9cialis\u00e9e dans les \u00e9ditions princeps, c\u2019est-\u00e0-dire les premi\u00e8res \u00e9ditions d\u2019une \u0153uvre\r\nchez diff\u00e9rents imprimeurs, un Jardin philosophique et un Jardin de plantes\r\nm\u00e9dicinales. Le mus\u00e9e publie des livres et organise des conf\u00e9rences, des concerts,\r\ndes expositions d\u2019art contemporain et historiques, des activit\u00e9s p\u00e9dagogiques, des\r\nvisites guid\u00e9es pour groupes.\r\n\r\n","booking_url":"http:\/\/ticket.visit.brussels\/fr\/8600\/musees-maison-d-erasme-beguinage\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nLa Casa de Erasmo debe su nombre y prestigio a la temporada que pas\u00f3 en ella Erasmo de R\u00f3terdam en 1521. Convertida en un museo dedicado a este gran humanista del Renacimiento, es el envoltorio de una colecci\u00f3n \u00fanica compuesta por obras de arte (esculturas y pinturas de maestros flamencos), muebles y libros antiguos, entre ellos numerosas ediciones erasmianas. Si la Casa de Erasmo es una de las m\u00e1s antiguas de Bruselas (construida en tres fases a lo largo de los siglos XV y XVI), a partir de 1932 fue objeto de una restauraci\u00f3n completa llevada a cabo, en el m\u00e1s puro historicismo, por Daniel Van Damme, fundador del museo, con la ayuda del arquitecto Charles Van Elst, que tambi\u00e9n construy\u00f3 la casa de Maurice Car\u00eame. Los espacios interiores se reorganizaron entonces en salas de museo que fueron decoradas (entre ellas, una sala con las paredes totalmente cubiertas por suntuosas pieles de C\u00f3rdoba) y amuebladas con mobiliario procedente de la antigua colecci\u00f3n del ministro Vandenpeereboom. El interior es, por tanto, una reproducci\u00f3n cuyo fin es dar a los visitantes la idea de lo que podr\u00eda haber sido una residencia en el Renacimiento, basada en parte en documentos hist\u00f3ricos (despacho de Erasmo frente al jard\u00edn) y en hallazgos arqueol\u00f3gicos como el maravilloso friso pintado al fresco del primer piso. Detr\u00e1s de la casa, un vasto jard\u00edn con grandes \u00e1rboles que le dan sombra conserva algunos restos arqueol\u00f3gicos del antiguo castillo de Anderlecht, los cuales se encuentran, po\u00e9ticamente, cerca de varias instalaciones de artistas contempor\u00e1neos. ","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Erasmushuis & Begijnhofmusea","address_street_name":"Formanoirstraat","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Formanoirstraat, 31","address_line2":"1070 Anderlecht","description_web":"Het Erasmushuis, het begijnhof en de collegiale Sint-Pieter-en Sint-Guidokerk vormen een uitzonderlijk historisch geheel in het centrum van de gemeente Anderlecht. Het Erasmushuis is een van de oudste huizen in Brussel waar Erasmus verbleef van mei tot oktober 1521. In de verschillende vertrekken kun je schilderijen en prenten van de meesters uit de 15de tot de 17de eeuw ontdekken, zoals Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... alsook portretten van Erasmus naar het voorbeeld van Hans Holbein en Quentin Metsys. Een rijke collectie boeken uit de 16de eeuw vertegenwoordigt het gedachtegoed van deze bijzondere humanist.  \n\nAchter het huis bevindt zich een tuin met geneeskrachtige planten ontworpen door landschapsarchitect Ren\u00e9 Pech\u00e8re. Hier worden zo\u2019n honderd geneeskrachtige planten gekweekt die bekend waren bij de geneesheren uit de 16de eeuw. Daarachter bevindt zich een filosofische tuin met werken van hedendaagse kunstenaars, zoals Marie-Jo Lafontaine en Bob Verschueren.  \n\n\nHet begijnhof van Anderlecht is het kleinste van Belgi\u00eb. Het werd gesticht in 1252 en bestaat tegenwoordig uit twee vleugels rondom een ommuurde tuin met waterput. Hier vonden begijnen onderdak tot aan de Franse Revolutie. \nNa een grondige restauratie staat het begijnhof voortaan weer open voor bezoekers iedere 1ste zondag van de maand met rondleidingen. Ontdek wat voor een werk er werd verricht om aan dit uitzonderlijk architecturaal erfgoed \u2013 uniek in Europa \u2013 zijn oorspronkelijke allure terug te geven.\nMomenteel wordt een nieuw museumproject uitgewerkt.\n","description_print":"21\/09\/2022\r\nIn 1521 verbleef Erasmus in dit gotische huis (1450-1515) waar zich niet alleen een collectie bevindt van schilderijen, prenten en beeldhouwwerken (Albrecht Du\u0308rer, Joos\r\nVan Cleve, Pieter Huys, Cornelis Metsys, Frans Francken de Jongere\u2026), maar ook een\r\nbibliotheek gespecialiseerd in \u2018editiones principes\u2019, dat wil zeggen de eerste uitgaven\r\nvan een werk bij verschillende drukkers. Verder bevindt zich buiten nog een Filosofische\r\ntuin en een tuin met Geneeskrachtige planten.\r\nDaarnaast publiceert het museum boeken en organiseert voordrachten, concerten,\r\ntentoonstellingen met een historisch thema en tentoonstellingen Hedendaagse kunst,\r\npedagogische activiteiten en rondleidingen voor groepen.","booking_url":"http:\/\/ticket.visit.brussels\/nl\/8600\/erasmushuis-begijnhofmusea\/shop","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[23],"translations":{"de":["Westen"],"pt":[null],"en":["West"],"it":["Ovest"],"cn":[null],"fr":["Ouest"],"sp":["Oeste"],"nl":["West"]}},"neca":null,"facebook_id":null,"backoffice_id":327,"location":{"lat":50.8365441,"lon":4.308198},"region":"brussels","last_updated_at":"2025-02-19T11:26:42+01:00","published_at":"2013-10-19T01:13:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":8600,"translations":{"de":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nDas \u201eMaison d\u2019Erasme\u201c in der Br\u00fcsseler Gemeinde Anderlecht wurde Ende des 15. Jahrhunderts im Auftrag eines Stiftsherrn der nahegelegenen Stiftskirche St. Peter und St. Guido  im sp\u00e4tgotischen Stil errichtet.\r\n\r\nDas Haus beherbergte im Jahr 1521 den bedeutenden niederl\u00e4ndischen Gelehrten des Renaissance-Humanismus Erasmus von Rotterdam, der hier, fernab von den gro\u00dfen Machtzentren und den dort herrschenden Religionskriegen, die Ruhe und Abgeschiedenheit der Natur suchte.\r\n\r\nDas im Maison d\u2019Erasme untergebrachte Museum zeigt sowohl eine Gem\u00e4ldesammlung mit Werken von Holbein, Bosch und Metsys als auch eine reich mit alten B\u00fccherausgaben best\u00fcckte Bibliothek. Der umliegende Garten besteht aus einem \u201eJardin des Maladies\u201c \u2013 dem \u201eGarten der Krankheiten\u201c mit zahlreichen Heilpflanzen \u2013 und einem \u201eJardin philosophique\u201c \u2013 dem \u201ePhilosophischen Garten\u201c.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name"