es un peu fous de deux artistes, Patricia Ide et Michel Kacenelenbogen, le Th\u00e9\u00e2tre Le Public est un lieu o\u00f9 se m\u00ealent diff\u00e9rentes familles th\u00e9\u00e2trales. Un lieu o\u00f9 s\u2019invente une relation chaleureuse entre les acteurs et les spectateurs.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Braemtstraat","address_street_number":"64 70","address_street_box":null,"email":"info@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Braemtstraat, 64 70","address_line2":"1210 Sint-Joost-Ten-Node","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":689,"location":{"lat":50.8511915,"lon":4.37676916},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:13:43+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/c8cc1838295a1a7bdf1855ed66329b72b5da60b0.jpg","width":3334,"height":2221,"ratio":1.5,"oEmbed_height":2221,"oEmbed_width":3334,"translat