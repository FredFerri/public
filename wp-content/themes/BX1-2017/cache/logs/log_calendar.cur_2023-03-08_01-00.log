00","published_at":"2022-10-06T11:10:53+02:00","backoffice_id":263595,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":548099,"date_start":"2023-03-17","date_end":"2023-03-18","date_next":"2023-03-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[4,8],"translations":{"fr":["Pop, rock, jazz\u2026","Chanson"],"nl":["Pop, rock, jazz\u2026","Chanson"],"en":["Pop, rock, jazz\u2026","Song"],"de":["Pop, Rock, Jazz...","Chanson"],"it":["Pop, rock, jazz\u2026","Canzone"],"sp":["Pop, rock, jazz\u2026","Canci\u00f3n francesa"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Tibidi \u2013 Ch\u00e2teau Cheval","shortdescr":"Elles prennent grand soin \u00e0 trouver l\u2019accent qui sonne juste, un phras\u00e9 soign\u00e9. Le tout avec un humour insolent, qui les pousse \u00e0 trouver pour chaque morceau une nouvelle harmonie d\u00e9cal\u00e9e, d\u00e9tonante. Un go\u00fbt assum\u00e9 de la plaisanterie et du m\u00e9lange des genres. Ici, elles sont accompagn\u00e9es d'un quatri\u00e8me larron, \u00e0 cheval sur sa basse, Gil Mortio...","longdescr":"Elles prennent grand soin \u00e0 trouver l\u2019accent qui sonne juste, un phras\u00e9 soign\u00e9. Le tout avec un humour insolent, qui les pousse \u00e0 trouver pour chaque morceau une nouvelle harmonie d\u00e9cal\u00e9e, d\u00e9tonante. Un go\u00fbt assum\u00e9 de la plaisanterie et du m\u00e9lange des genres.  Et apr\u00e8s plusieurs ann\u00e9es de travail polyphonique minutieux, et tout en cherchant un son acoustique singulier, Tibidi prend une nouvelle direction. Des compositions originales, une \u00e9criture personnelle, quitter l\u2019a capella en introduisant un clavier, une basse, des percussions\u2026 Voil\u00e0 l\u2019\u00e9lan de \u00ab Ch\u00e2teau Cheval \u00bb, le dernier cru Tibidi ! Ariane, Muriel et Julie invitent Gil Mortio sur sc\u00e8ne et chantent l\u2019amour, encore l\u2019amour, toujours l\u2019amour ! Le premier, le second, le troisi\u00e8me\u2026","performers":"Muriel Legrand (voix); Julie Leyder (voix); Ariane Rousseau (voix); Gil Mortio (basse)","boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548099"},"nl":{"name":"Tibidi \u2013 Ch\u00e2teau Cheval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548099"},"en":{"name":"Tibidi \u2013 Ch\u00e2teau Cheval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548099"},"de":{"name":"Tibidi \u2013 Ch\u00e2teau Cheval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.548099"},"it":{"name":"Tibidi \u2013 Ch\u00e2teau Cheval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.548099"},"sp":{"name":"Tibidi \u2013 Ch\u00e2teau Cheval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.548099"},"pt":{"name":"Tibidi \u2013 Ch\u00e2teau Cheval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.548099"},"cn":{"name":"Tibidi \u2013 Ch\u00e2teau Cheval","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.548099"}},"place":{"id":220283,"translations":{"fr":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"Le Jardin de ma S\u0153ur est situ\u00e9 au coin d'une rue du pittoresque March\u00e9 aux poissons, \u00e0 proximit\u00e9 de l\u2019ancien Grand B\u00e9guinage de Bruxelles. On peut difficilement imaginer un nom plus familier. Pourtant, cet endroit n'a pas vol\u00e9 son nom. Vous obtenez exactement ce que vous attendez : une soir\u00e9e sans pr\u00e9tention, pleine de divertissements et de moments partag\u00e9s. Vous vous y sentez comme dans votre salon. Vous oubliez imm\u00e9diatement tous vos soucis et riez, chantez et profitez du spectacle avec les autres participants. Sp\u00e9cialement pour les amateurs de chanson fran\u00e7aise et de th\u00e9\u00e2tre.  \u202f \r\nPensez \u00e0 r\u00e9server votre place !\r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Jardin de ma Soeur","address_street_name":"Op de hoek van de Brandhoutkaai en de Grootgodshuisstraat","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussel","address_line1":"Op de hoek van de Brandhoutkaai en de Grootgodshuisstraat","address_line2":"1000 Brussel","description_web":"Op een straathoek aan de pittoreske Vismarkt ligt Le Jardin de ma Soeur. Een familialere naam kan je haast niet bedenken. Toch heeft deze plek haar naam niet gestolen. Je krijgt exact wat je er zou verwachten: een pretentieloze avond vol vertier en gedeelde momenten. Hier waan je je in een gezellige en veilige woonkamer. Je vergeet er meteen al je zorgen en lacht, zingt en geniet met de andere aanwezigen. Vooral voor liefhebbers van het Franse chanson en verhaaltheater.    \u202f\u202f\u202f ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussels","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Brussels","description_web":"The desire to present theater amongst people; as if a performance is nothing but a conversation, in a place somewhere in between the large halls and the streets, half living room, half pub, in a warm ambiance where one can sip a glass while watching a performance. That's cafe-theater \"Le Jardin de ma Soeur\", at the edge of the ancient \"Grand B\u00e9guinage de Bruxelles\", alongside one of the quays of the old port of Brussels where the spirit of the dock workers lingers and where one can still feel the presence of the beguines with their long black robes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"Dieses malerische Caf\u00e9-Theater, das 1994 in der N\u00e4he des alten \"Grand B\u00e9guinage de Bruxelles\" er\u00f6ffnet wurde, \u00fcberrascht durch seine \u00fcberaus kleinen R\u00e4umlichkeiten. Doch daf\u00fcr ist das Programm ist umso \"gr\u00f6\u00dfer\". Reservierung empfohlen!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","addre