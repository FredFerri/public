t":"2023-09-04T14:15:03+02:00","published_at":"2023-08-23T12:03:49+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283767,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[54],"translations":{"de":["One Man Show & Comedy"],"pt":[null],"en":["One man show and comedy"],"it":["One man Show e comicit\u00e0"],"cn":[null],"fr":["One man Show et humour"],"sp":["Espect\u00e1culo unipersonal y humor"],"nl":["Onemanshow en humor"]}}},"translations":{"de":{"name":"Bruno Coppens : \"Je m\u00e8ne une vie sc\u00e8ne\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/bruno-coppens-je-mene-une-vie-scene\/","email":"info@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001202"},"pt":{"name":"Bruno Coppens : \"Je m\u00e8ne une vie sc\u00e8ne\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/bruno-coppens-je-mene-une-vie-scene\/","email":"info@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001202"},"en":{"name":"Bruno Coppens : \"Je m\u00e8ne une vie sc\u00e8ne\"","shortdescr":"Pour rire \u00e0 gorge d\u00e9ploy\u00e9e en ce d\u00e9but de saison th\u00e9\u00e2trale, nous accueillons au Senghor les nouvelles p\u00e9rip\u00e9ties de notre jongleur de mots national ! Le bien nomm\u00e9 Bruno Coppens.","longdescr":"Juch\u00e9 sur sa bicyclette, notre c\u00e9l\u00e8bre verbo-moteur lutte contre la crise \u00e9nerg\u00e9tique ! A coups de p\u00e9dales, il alimente clim\u2019 et \u00e9clairage de la salle ! Tel Don Quichotte, cet humoureux des mots affrontera son ordinateur qui lui demande : \u00ab Etes-vous un robot ?\u00bb, vous d\u00e9voilera gr\u00e2ce \u00e0 la Fontaine la fin de la guerre entre Poutine et Zelensky, et d\u00e9ballant \u00e9tats d\u2019\u00e2me et \u00e9tats d\u2019homme, ce trublion m\u00e9lancomique rendra un hommage \u00e9mouvant \u00e0 Raymond Devos.\nM\u00e9tamorphosant son v\u00e9lo en harpe, en videoprojecteur, en bureau d\u2019orthophoniste ou en v\u00e9hicule Deliveroo, Bruno Coppens, ce d\u00e9trousseur polisson de mots trop polic\u00e9s nous revient dans une forme olympique !\n","performers":"MISE EN SELLE : \u00c9ric De Staercke\nASSISTANTE \u00c0 LA MISE EN SELLE : Ad\u00e8le Crickx\nLUMI\u00c8RE : Nicolas Fauchet\nMUSIQUE ET BANDE-SON : Eloi Baudimont\nCONFECTION D\u2019ACCESSOIRES : Pierre Legrand","boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/bruno-coppens-je-mene-une-vie-scene\/","email":"reservation@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001202"},"it":{"name":"Bruno Coppens : \"Je m\u00e8ne une vie sc\u00e8ne\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/bruno-coppens-je-mene-une-vie-scene\/","email":"info@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001202"},"cn":{"name":"Bruno Coppens : \"Je m\u00e8ne une vie sc\u00e8ne\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/bruno-coppens-je-mene-une-vie-scene\/","email":"info@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001202"},"fr":{"name":"Bruno Coppens : \"Je m\u00e8ne une vie sc\u00e8ne\"","shortdescr":"Pour rire \u00e0 gorge d\u00e9ploy\u00e9e en ce d\u00e9but de saison th\u00e9\u00e2trale, nous accueillons au Senghor les nouvelles p\u00e9rip\u00e9ties de notre jongleur de mots national ! Le bien nomm\u00e9 Bruno Coppens.","longdescr":"Pour rire \u00e0 gorge d\u00e9ploy\u00e9e en ce d\u00e9but de saison th\u00e9\u00e2trale, nous accueillons au Senghor les nouvelles p\u00e9rip\u00e9ties de notre jongleur de mots national ! Le bien nomm\u00e9 Bruno Coppens.\nJuch\u00e9 sur sa bicyclette, notre c\u00e9l\u00e8bre verbo-moteur lutte contre la crise \u00e9nerg\u00e9tique ! A coups de p\u00e9dales, il alimente clim\u2019 et \u00e9clairage de la salle ! Tel Don Quichotte, cet humoureux des mots affrontera son ordinateur qui lui demande : \u00ab Etes-vous un robot ?\u00bb, vous d\u00e9voilera gr\u00e2ce \u00e0 la Fontaine la fin de la guerre entre Poutine et Zelensky, et d\u00e9ballant \u00e9tats d\u2019\u00e2me et \u00e9tats d\u2019homme, ce trublion m\u00e9lancomique rendra un hommage \u00e9mouvant \u00e0 Raymond Devos.\nM\u00e9tamorphosant son v\u00e9lo en harpe, en videoprojecteur, en bureau d\u2019orthophoniste ou en v\u00e9hicule Deliveroo, Bruno Coppens, ce d\u00e9trousseur polisson de mots trop polic\u00e9s nous revient dans une forme olympique !\n\nMISE EN SELLE : \u00c9ric De Staercke\n\u2014\nASSISTANTE \u00c0 LA MISE EN SELLE : Ad\u00e8le Crickx\n\u2014\nLUMI\u00c8RE : Nicolas Fauchet\n\u2014\nMUSIQUE ET BANDE-SON : Eloi Baudimont\n\u2014\nCONFECTION D\u2019ACCESSOIRES : Pierre Legrand\n\u2014\nDUR\u00c9E : 1h20 \n\u2014\nCo-production d\u2019Exquis Mots et du Th\u00e9\u00e2tre Le Public (Bruxelles) avec le soutien du Tax Shelter du Gouvernement F\u00e9d\u00e9ral belge avec l\u2019aide de la SABAM. \n\u2014","performers":"MISE EN SELLE : \u00c9ric De Staercke\nASSISTANTE