s\u2019\u00e9tend depuis le Haut Moyen Age. A v\u00e9lo, suivez la Senne pour rejoindre la ville qui fut avant Bruxelles le si\u00e8ge de l\u2019archi-dioc\u00e8se de Malines. En suivant le guide, d\u00e9couvrez la cath\u00e9drale Saint Rombaud, le palais de Marguerite d\u2019Autriche, la Grand place et la porte de Bruxelles. Une randonn\u00e9e \u00e0 v\u00e9lo qui vous fera sortir des sentiers battus.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.provelo.org","email":"info@provelo.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531294.html"},"nl":{"name":"De Bruxelles \u00e0 Malines","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.provelo.org","email":"info@provelo.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531294.html"},"en":{"name":"De Bruxelles \u00e0 Malines","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531294.html"},"de":{"name":"De Bruxelles \u00e0 Malines","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531294.html"},"it":{"name":"De Bruxelles \u00e0 Malines","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531294.html"},"sp":{"name":"De Bruxelles \u00e0 Malines","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531294.html"},"pt":{"name":"De Bruxelles \u00e0 Malines","shortde