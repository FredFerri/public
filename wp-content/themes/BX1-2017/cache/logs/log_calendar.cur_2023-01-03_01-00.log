t":"10:00:00","end":"17:00:00"},{"day":"2022-12-16","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-17","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-18","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-20","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-21","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-22","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-23","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-24","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-27","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-28","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-29","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-30","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-31","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-03","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-04","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-05","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-06","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-07","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-08","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-10","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-11","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-12","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-13","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-14","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-15","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-17","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-18","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-19","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"