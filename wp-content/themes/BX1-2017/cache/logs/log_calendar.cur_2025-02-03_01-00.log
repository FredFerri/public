/www.wolubilis.be\/a-voir\/les-musicales-de-la-woluwe","email":null,"phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005819"},"pt":{"name":"Harmonie au f\u00e9minin : les compositrices \u00e0 l'honneur \/ Les Musicales de la Woluwe 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/les-musicales-de-la-woluwe","email":null,"phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005819"},"en":{"name":"Harmonie au f\u00e9minin : les compositrices \u00e0 l'honneur \/ Les Musicales de la Woluwe 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/les-musicales-de-la-woluwe","email":null,"phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005819"},"it":{"name":"Harmonie au f\u00e9minin : les compositrices \u00e0 l'honneur \/ Les Musicales de la Woluwe 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/les-musicales-de-la-woluwe","email":null,"phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005819"},"cn":{"name":"Harmonie au f\u00e9minin : les compositrices \u00e0 l'honneur \/ Les Musicales de la Woluwe 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/les-musicales-de-la-woluwe","email":null,"phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005819"},"fr":{"name":"Harmonie au f\u00e9minin : les compositrices \u00e0 l'honneur \/ Les Musicales de la Woluwe 2025","shortdescr":"\u00ab Harmonie au f\u00e9minin \u00bb : les compositrices sont \u00e0 l'honneur le vendredi 7 f\u00e9vrier \u00e0 Wolubilis le temps d\u2019une soir\u00e9e o\u00f9 la cr\u00e9ativit\u00e9 f\u00e9minine r\u00e9sonne \u00e0 travers les si\u00e8cles, avec des \u0153uvres riches et vari\u00e9es, souvent m\u00e9connues. \nAu programme : Louise Farrenc, Amy Beach (pionni\u00e8re de la composition aux Etats-Unis), C\u00e9cile Chaminade, Fanny Mendelssohn (la s\u0153ur d\u2019un certain F\u00e9lix) et bien d\u2019autres !","longdescr":"De retour les 7 et 8 f\u00e9vrier 2025 \u00e0 Wolubilis, le Festival \u00ab Les Musicales de la Woluwe \u00bb promet une programmation \u00e9clectique et vibrante. Au programme : une soir\u00e9e c\u00e9l\u00e9brant les compositrices m\u00e9connues \u00e0 travers les si\u00e8cles, un spectacle familial initiant les enfants \u00e0 l\u2019expression \u00e9motionnelle par la musique, et un concert lyrique explorant les passions de l\u2019op\u00e9ra avec Mozart et Bizet. De quoi ravir m\u00e9lomanes et familles dans une \u00e9dition riche en d\u00e9couvertes.\n\nD\u00e9sireux d\u2019explorer chaque ann\u00e9e de nouveaux horizons, les organisateurs du Festival consacrent cette ann\u00e9e un concert aux compositrices, le temps d\u2019une soir\u00e9e o\u00f9 la cr\u00e9ativit\u00e9 f\u00e9minine r\u00e9sonne \u00e0 travers les si\u00e8cles. Ce programme unique, cr\u00e9\u00e9 pour l\u2019occasion et interpr\u00e9t\u00e9 par un trio de musiciennes passionn\u00e9es, met en lumi\u00e8re des \u0153uvres riches et vari\u00e9es, souvent m\u00e9connues. Au programme : Louise Farrenc, Amy Beach (pionni\u00e8re de la composition aux Etats-Unis), C\u00e9cile Chaminade, Fanny Mendelssohn (la s\u0153ur d\u2019un certain F\u00e9lix) et bien d\u2019autres !\n\nMaiko Inoue (au piano), Camille Donz\u00e9 (au violoncelle) et Camille Babut du Mar\u00e8s (au violon) seront accompagn\u00e9es de Catherine Miller, professeur d\u2019histoire de la musique, qui nous livrera les petits secrets de ces grandes compositions.","performers":"Maiko Inoue (au piano), Camille Donz\u00e9 (au violoncelle), Camille Babut du Mar\u00e8s (au violon), Catherine Miller (professeur d\u2019histoire de la musique qui nous livrera les petits secrets de ces grandes compositions).","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/les-musicales-de-la-woluwe","email":null,"phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005819"},"sp":{"name":"Harmonie au f\u00e9minin : les compositrices \u00e0 l'honneur \/ Les Musicales de la Woluwe 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/les-musicales-de-la-woluwe","email":null,"phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005819"},"nl":{"name":"Harmonie au f\u00e9minin : les compositrices \u00e0 l'honneur \/ Les Musicales de la Woluwe 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/les-musicales-de-la-woluwe","email":null,"phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005819"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_pr