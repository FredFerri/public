nheur de former un couple et bient\u00f4t deux enfants. Mais les ambitions professionnelles, les d\u00e9ceptions et le doute prennent le pas et c\u2019est une lente glissade vers l\u2019irr\u00e9m\u00e9diable\u2026 Le pire cauchemar d\u2019une m\u00e8re aux prises avec les d\u00e9mons d\u2019un homme. Une femme se fait l\u2019enqu\u00eatrice de sa propre vie et nous emporte dans les m\u00e9andres de sa m\u00e9moire, vers une histoire intense et sombre.","performers":"Texte : Dennis Kelly \r\nTraduction : Philippe Le Moine \r\nAvec : France Bastoen \r\nSc\u00e9nographie : Mathieu Delcourt \r\nMise en sc\u00e8ne : Jean-Baptiste Delcourt","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550853"},"nl":{"name":"Girls and boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550853"},"en":{"name":"Girls and boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550853"},"de":{"name":"Girls and boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550853"},"it":{"name":"Girls and boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\