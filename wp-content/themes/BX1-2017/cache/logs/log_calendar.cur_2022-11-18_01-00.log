c5c48ef784195b17e7e52283c90b72a66ed238.jpg","width":5008,"height":7063,"ratio":0.71,"translations":{"fr":{"title":"Freddy Tougaux: Hein!","copyright":null},"nl":{"title":"Freddy Tougaux: Hein!","copyright":null},"en":{"title":"Freddy Tougaux: Hein!","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/d5c6fa57f6143af083954fe741515c368e8aee89.jpg","width":5008,"height":7063,"ratio":0.71,"translations":{"fr":{"title":"Freddy Tougaux: Hein!","copyright":"le fou rire"},"nl":{"title":"Freddy Tougaux: Hein!","copyright":"le fou rire"},"en":{"title":"Freddy Tougaux: Hein!","copyright":"le fou rire"}}}],"dates":[{"day":"2022-11-19","doors":"19:15:00","start":"20:15:00","end":"22:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":20},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":10},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":17}],"child_events":[],"parent_events":[539149],"targets":{"list":[],"translations":{}},"visit_content":{"list":[360],"values":["cafe-theatre"]},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T22:05:43+02:00","published_at":"2022-08-16T14:51:56+02:00","backoffice_id":259785,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":543919,"date_start":"2022-11-19","date_end":"2022-11-19","date_next":"2022-11-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"MARA DOBRESCO : Piano et Musique de Chambre","shortdescr":"\"Nous allons ouvrir ensemble quelques fen\u00eatres vers le monde de la nuit, qui m\u2019est si cher, celui du silence, de la lumi\u00e8re et de l\u2019espoir, dans un programme qui vous sera d\u00e9voil\u00e9 le soir m\u00eame\u2026comme dans les Schubertiades.\" MARA DOBRESCO","longdescr":"\"La beaut\u00e9 du jeu de Mara Dobresco s\u00e9duit d'embl\u00e9e par une approche tr\u00e8s soign\u00e9e, un toucher d'une souplesse id\u00e9ale et une sonorit\u00e9 de r\u00eave...tenant un juste milieu entre la fougue fantasque d'Argerich et la profondeur d'Arrau.\" Classica\r\n\r\nLou\u00e9e pour son temp\u00e9rament et l\u2019\u00e9l\u00e9gance de son phras\u00e9, la pianiste franco-roumaine Mara Dobresco donne des r\u00e9citals dans toute l\u2019Europe, en Argentine, en Australie, au Japon et aux Etats-Unis.\r\n\r\nC'est avec une joie non-dissimul\u00e9e que nous sommes ravis d'accueillir cette artiste dans notre salon pour une soir\u00e9e sous le signe du partage, dans le style des Schubertiades de l\u2019\u00e9poque .\r\n\r\nQuoi de mieux que les mots de l'artiste pour \u00e9voquer ce qui nous attend :\r\n\r\n\"Nous allons ouvrir ensemble quelques fen\u00eatres vers le monde de la nuit, qui m\u2019est si cher, celui du silence, de la lumi\u00e8re et de l\u2019espoir, dans un programme qui vous sera d\u00e9voil\u00e9 le soir m\u00eame\u2026comme dans les Schubertiades.\" MARA DOBRESCO","performers":"Mara Dobresco","boxoffice_url":null,"website":"https:\/\/www.jardinmusical.org\/agenda-billetterie","email":"info@jardinmusical.org","phone_contact":"+32 456 04 35 05","phone_booking":"+32 456 04 35 05","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543919"},"nl":{"name":"MARA DOBRESCO: piano en kamermuziek","shortdescr":"\"Laten we samen een paar vensters openen naar de wereld van de nacht, die me zo dierbaar is, de nacht van de stilte, van licht en hoop, in een programma dat  diezelfde avond zal worden onthuld ... net zoals in de Schubertiades van weleer.\"\r\nMARA DOBRESCO","longdescr":"\"De schoonheid van Mara Dobresco's spel is verleid ons onmiddellijk, door haar zeer zorgvuldige aanpak, haar perfect soepel spel en een dromerige klank... weliswaar het juiste evenwicht tussen Argerichs grillige vurigheid en Arrau's diepgang.\u201d Classica\r\n\r\nGeprezen om haar temperament en de elegantie van haar frasering, geeft de Frans-Roemeense pianiste Mara Dobresco recitals in heel Europa, in Argentini\u00eb, Australi\u00eb, Japan en de Verenigde Staten.\r\n\r\nMet onverscholen vreugde verwelkomen wij deze kunstenares in ons midden voor een musicale ervaring, in de stijl van de Schubertiades van weleer.\r\n\r\nWie zou beter dan kunstenaar zelf kunnen verwoorden waar zij ons die avond mee zal verheugen:\r\n\"Laten we samen een paar vensters openen naar de wereld van de nacht, die me zo dierbaar is, de nacht van de stilte, van licht en hoop, in een programma dat  diezelfde avond zal worden onthuld ... net zoals in de Schubertiades van weleer.\"\r\nMARA DOBRESCO","performers":"Mara Dobresco","boxoffice_url":null,"website":null,"email":"info@jardinmusical.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543919"},"en":{"name":"MARA DOBRESCO: Piano and Chamber Music","shortdescr":"\"Together we will open a few windows to the world of the night, which is so dear to me, that of silence, light and hope, in a program that will be revealed to you that evening...as in the Schubertiades.\" MARA DOBRESCO","longdescr":"\"The beauty of Mara Dobresco's playing is immediately seductive, with a very meticulous approach, an ideally supple touch and a dreamy sound...holding a happy medium between the whimsical ardor of Argerich and the depth of Arrau.\" Classica\r\n\r\nPraised for her temperament and the elegance of her phrasing, the Franco-Romanian pianist Mara Dobresco gives recitals throughout Europe, in Argentina, Australia, Japan and the United States.\r\n\r\nIt is with undisguised joy that we are delighted to welcome this artist to our salon for an evening of sharing, in the style of the Schubertiades of the time.\r\n\r\nWhat could be better than the words of the artist to evoke what awaits us:\r\n\r\n\"Together we will open a few windows to the world of the night, which is so dear to me, that of silence, light and hope, in a program that will be revealed to you that evening...as in the Schubertiades.\" MARA DOBRESCO","performers":"Mara Dobresco","boxoffice_url":null,"website":null,"email":"info@jardinmusical.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543919"},"de":{"name":"MARA DOBRESCO : Piano et Musique de Chambre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543919"},"it":{"name":"MARA DOBRESCO : Piano et Musique de Chambre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543919"},"sp":{"name":"MARA DOBRESCO : Piano et Musique de Chambre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543919"},"pt":{"name":"MARA DOBRESCO : Piano et Musique de Chambre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543919"},"cn":{"name":"MARA DOBRESCO : Piano et Musique de Chambre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543919"}},"place":{"id":276657,"translations":{"fr":{"name":"Jardin Musical","address_street_name":"Quai aux Briques","address_street_number":"62","address_street_box":null,"email":"info@jardinmusical.org","website":"https:\/\/www.jardinmusical.org\/","phone_contact":"+32 456 04 35 05","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai aux Briques, 62","address_line2":"1000 Bruxelles","description_web":"un \u00e9cosyst\u00e8me cr\u00e9atif form\u00e9 par des artistes, pour des artistes.\r\n\r\n \r\n\r\nEn plein c\u0153ur historique de Bruxelles, dans l\u2019atelier de son fondateur le pianiste Julien Brocal, le Jardin Musical ouvre un salon \u00e0 \u00e9chelle humaine pour y mettre en lumi\u00e8re un terroir d\u2019artistes qu'il fait rayonner \u00e0 l\u2019international.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Jardin Musical","address_street_name":"Baksteenkaai","address_street_number":"62","address_street_box":null,"email":"info@jardinmusical.org","website":"https:\/\/www.jardinmusical.org\/","phone_contact":"+32 456 04 35 05","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Baksteenkaai, 62","address_line2":"1000 Brussel","description_web":"Een creatief ecosysteem gevormd door artiesten, voor artiesten.\r\n\r\n \r\n\r\nIn het historisch hartje van Brussel, in het muzikaal atelier van zijn oprichter, de pianist Julien Brocal, opent de Jardin Musical haar armen en een leefruimte op menselijke schaal m