website":"http:\/\/www.thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue Meyerbeer, 61","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"The Palm Beach","address_street_name":"Meyerbeerstraat","address_street_number":"61","address_street_box":null,"email":"sandrineviumasia@me.com","website":"http:\/\/www.thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Meyerbeerstraat, 61","address_line2":"1190 Vorst","description_web":"The Palm Beach is een atypische galerie gevestigd in een art deco huis van Joseph Diongre, de ontwerper van het Flageygebouw. Sandrine Viu Masia, curator van de galerie, zoekt  jong talent en stelt hen voor in kwalitatieve, niet-alledaagse tentoonstellingen. Er wordt bijzondere aandacht besteed aan de ontvangst van het publiek en aan de duiding van de symbiose tussen de plaats en de tentoongestelde werken. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":25910,"location":{"lat":50.8146756,"lon":4.34391913},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2023-10-04T14:15:19+02:00","published_at":"2016-05-17T09:27:10+02:00","id":265910,"translations":{"de":{"name":"The Palm Beach","address_street_name":"Rue Meyerbeer","address_street_number":"61","address_street_box":null,"email":"sandrineviumasia@me.com","website":"http:\/\/www.thepalmbeach.be","phone_contact":"+32