en":["monday: closed","tuesday, wednesday, thursday, friday and saturday: from 19:45","sunday: from 18:45"]},"date_start":"2022-01-01","date_end":"2022-09-30","is_also_by_appointment":false},{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"19:45:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"19:45:00"}]},"thursday":{"is_open":true,"hours":[{"start":"19:45:00"}]},"friday":{"is_open":true,"hours":[{"start":"19:45:00"}]},"saturday":{"is_open":true,"hours":[{"start":"19:45:00"}]},"sunday":{"is_open":true,"hours":[{"start":"11:45:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi, vendredi et samedi: \u00e0 partir de 19:45","dimanche: \u00e0 partir de 11:45"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 19:45","zondag: van 11:45"],"en":["monday: closed","tuesday, wednesday, thursday, friday and saturday: from 19:45","sunday: from 11:45"]},"date_start":"2022-10-01","date_end":"2023-04-01","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[266],"translations":{"fr":["Brussels Health Safety Label"],"nl":["Brussels Health Safety Label"],"en":["Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-24T01:05:46+02:00","published_at":"2022-04-07T14:02:59+02:00","backoffice_id":251124,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.096961157376676},{"id":538729,"date_start":"2022-10-26","date_end":"2022-10-26","date_next":"2022-10-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o en concert au Th\u00e9\u00e2tre Marni","shortdescr":null,"longdescr":"Avec Moi et le Th\u00e9o\/Ik en den Theo vous (re) d\u00e9couvrez le monde \u00e0 travers les yeux des petits. Enfants, parents et grands-parents marchent comme des robots, jouent \u00e0 la chaise musicale, re\u00e7oivent un souffle \u00e9nergique de l\u2019oncle Jazz, jouent de l\u2019air guitar et m\u00eame plus. Bref, ils explorent les limites ext\u00e9rieures de leur fantaisie.\r\n\r\nEn fonction de la composition du public, Moi et le Th\u00e9o\/Ik en den Theo chantent en fran\u00e7ais, en n\u00e9erlandais ou, dans le meilleur des mondes, en deux langues.\r\n\r\nPiet Maris et Theophane Raballand (tous les deux de Jaune Toujours) font leur truc \u00e0 l\u2019accord\u00e9on, \u00e0 la batterie et aux percussions, mais surtout\u2026 avec le public, qui est sans cesse invit\u00e9 \u00e0 danser, \u00e0 chanter, \u00e0 sauter et \u00e0 imaginer.","performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.be\/?pos=MARNI&module=ACTIVITYSERIEDETAILS&s=26E56292-F5E3-3EF0-DF4E-490A6655DDDD","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538729"},"nl":{"name":"Ik en den Theo\/ Moi et le Th\u00e9o in concert op het Marni Theater","shortdescr":null,"longdescr":"Bij Ik en den Theo \/ Moi et le Th\u00e9o (her)bekijk je de wereld door kinderogen. Kinderen, ouders en grootouders kunnen rondlopen als robots, stoelendansen, bezoek krijgen van nonkel Jazz, luchtgitaar spelen en nog veel meer... Kortom, ze verkennen de uiterste grenzen van hun fantasie.\r\n\r\nAfhankelijk van de samenstelling van het publiek zingen Ik en den Theo\/Moi et le Th\u00e9o in het Nederlands of in het Frans of, in de beste van alle werelden, in beide talen.\r\n\r\nPiet Maris en Theophane Raballand (allebei van Jaune Toujours) doen hun ding op accordeon en slagwerk ... en met het publiek, dat voortdurend wordt uitgedaagd om mee te zingen, dansen, springen en fantaseren.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538729"},"en":{"name":"Ik en den Theo\/ Moi et le Th\u00e9o in concert at the  Marni Theater","shortdescr":null,"longdescr":"Ik en den Theo\/Moi et le Th\u00e9o look at the world through children's eyes. Piet Maris and Theophane Raballand ( both of Jaune Toujours) do their thing on accordion and drums... and with the audience. Depending on its composition Ik en den Theo\/Moi et le Th\u00e9o sing in Dutch or French, or in the best of worlds in both languages.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538729"},"de":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o en concert au Th\u00e9\u00e2tre Marni","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538729"},"it":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o en concert au Th\u00e9\u00e2tre Marni","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538729"},"sp":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o en concert au Th\u00e9\u00e2tre 