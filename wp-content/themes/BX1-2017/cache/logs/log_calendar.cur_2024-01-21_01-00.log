ltuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-31T15:15:01+01:00","published_at":"2023-10-31T15:07:20+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":288023,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.4721631957086834,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[251],"translations":{"de":["Zeitgen\u00f6ssische Kunst "],"pt":[null],"en":["Contemporary Art"],"it":["Arte contemporanea "],"cn":[null],"fr":["Art Contemporain "],"sp":["Arte contempor\u00e1neo "],"nl":["Hedendaagse Kunst"]}}},"translations":{"de":{"name":"Meeting\/visit with Coraline Guilbeau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/rencontre-visite-avec-coraline-guilbeau\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50003896"},"pt":{"name":"Meeting\/visit with Coraline Guilbeau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/rencontre-visite-avec-coraline-guilbeau\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003896"},"en":{"name":"Visit with Coraline Guilbeau","shortdescr":"Coraline Guilbeau offers a personal reading of the exhibition L'art de rien, raising the issues at stake as one person per appointment wanders through the exhibition space at CENTRALE.\n\nevery 15' (one person per appointment)\nFree with registration at CENTRALE reception desk\/ticketing on the day of the event\n(when making an appointment, please specify your choice of language: FR or NL).","longdescr":"Coraline Guilbeau (1991) lives and works in Brussels. Her work has been presented in a variety of contexts: solo and group exhibitions in galleries, museums, artist run spaces and performance festivals, both in the Brussels-Capital Region and in association with the FWB, including (selection): Maison d\u2019\u00c9rasme & B\u00e9guinage (Anderlecht) in 2022, Centre Wallonie Bruxelles (Paris) in 2020, Studio Thor (Saint-Josse) in 2020, SB34 (Saint-Gilles) in 2019, Wandering Art Biennal (Brussels) in 2018, Wiels (Forest) and Clovis XV (Brussels) in 2017; in Flanders: Het Depot (Leuven) in 2023, LLS Paleis (Antwerp), De Studio (Antwerp) in 2021, CC Strombeek Grimbergen (Strombeek) in 2020 and 019 (Ghent) in 2016; in Europe: Meet Factory Prague (Czech Republic) in 2023, Ferme Asile Sion (Switzerland) in 2022, Futura Prague (Czech Republic) in 2020, Eponyme Gallery Bordeaux (France) in 2019, ALMA Espace d\u2019art Paris (France) in 2018, 5UN7 Bordeaux (France) in 2016, Galeria Mieszka\u0144cy Krakow (Poland) in 2013. Also recipient of a grant from the Morpho programme (Antwerp) in 2023, from the State of Valais (Switzerland) in 2022 and finalist for the \u201cPrix Fintro Prijs: Supporting Young Artists\u201d in 2022.","performers":"Coraline Guilbeau; ","boxoffice_url":null,"website":"https:\/\/centrale.brussels\/en\/events\/meeting-visit-with-coraline-guilbeau\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003896"},"it":{"name":"Meeting\/visit with Coraline Guilbeau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/rencontre-visite-avec-coraline-guilbeau\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003896"},"cn":{"name":"Meeting\/visit with Coraline Guilbeau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/rencontre-visite-avec-coraline-guilbeau\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003896"},"fr":{"name":"Visite avec Coraline Guilbeau (FR-NL)","shortdescr":"Coraline Guilbeau propose une lecture personnelle de l\u2019exposition L\u2019art de rien, convoquant les enjeux de celle-ci, au cours d\u2019une de\u0301ambulation dans l\u2019espace d\u2019exposition de la CENTRALE, a\u0300 raison d\u2019une personne par rdv.\n\ntoutes les 15\u2032 (une personne par rdv).\nGratuit sur inscriptions a\u0300 l\u2019accueil de la CENTRALE le jour me\u0302me\n(pre\u0301ciser lors de la prise de rdv le choix de la langue : FR ou NL).","longdescr":"Coraline Guilbeau (1991) vit et travaille a\u0300 Bruxelles. Son travail a e\u0301te\u0301 pre\u0301sente\u0301 dans diffe\u0301rents contextes : expositions individuelles et collectives dans des galeries, muse\u0301es, artist run spaces et festivals de performances, que ce soit en re\u0301gion Bruxelles-Capitale ou en lien avec la FWB comme (se\u0301lection) : Maison d\u2019E\u0301rasme & Be\u0301guinage (Anderlecht) en 2022, Centre Wallonie Bruxelles (Paris) en 2020, Studio Thor (Saint-Josse) en 2020, SB34 (Saint-Gilles) en 2019, Wandering Art Biennal (Bruxelles) en 2018, Wiels (Forest) et Clovis XV (Bruxelles) en 2017 ; en Flandres : Het Depot (Louvain) en 2023, LLS Paleis (Anvers), De Studio (Anvers) en 2021, CC Strombeek Grimbergen (Strombeek) en 2020 et 019 (Gand) en 2016 ; en Europe : Meet Factory Prague (Re\u0301publique Tche\u0300que) en 2023, Ferme Asile Sion (Suisse) en 2022, Futura Prague (Re\u0301publique Tche\u0300que) en 2020, Eponyme Gallery Bordeaux (France) en 2019, ALMA Espace d\u2019art Paris (France) en 2018, 5UN7 Bordeaux (France) en 2016, Galeria Mieszka\u0144cy Cracovie (Pologne) en 2013. E\u0301galement be\u0301ne\u0301ficiaire d\u2019une bourse du programme Morpho (Anvers) en 2023, de l\u2019E\u0301tat du Valais (Suisse) en 2022 et finaliste pour le \u00abPrix Fintro Prijs : Supporting Young Artists\u00bb en 2022.","performers":"Coraline Guilbeau; ","boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/rencontre-visite-avec-coraline-guilbeau\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003896"},"sp":{"name":"Meeting\/visit with Coraline Guilbeau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/rencontre-visite-avec-coraline-guilbeau\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003896"},"nl":{"name":"Bezoek met Coraline Guilbeau (NL-FR)","shortdescr":"Coraline Guilbeau geeft een persoonlijke interpretatie van de tentoonstelling L\u2019art de rien, waarbij ze ingaat op de thema's die op tafel liggen, tijdens een wandeling door de tentoonstellingsruimte van de CENTRALE. \u00a0\u00c9\u00e9n voor \u00e9\u00e9n kan je meewandelen.\n\nelke 15 min (\u00e9\u00e9n persoon per afspraak).\nGratis bij inschrijving aan de ticketing\/shop van de CENTRALE op de dag van het evenement\n(FR of NL).","longdescr":"Coraline Guilbeau geeft een persoonlijke interpretatie van de tentoonstelling L\u2019art de rien, waarbij ze ingaat op de thema\u2019s die op tafel liggen, tijdens een wandeling door de tentoonstellingsruimte van de CENTRALE.  \u00c9\u00e9n voor \u00e9\u00e9n kan je meewandelen.\n\nCoraline Guilbeau (1991) woont en werkt in Brussel. Haar werk werd getoond in verschillende contexten: solo- en groepstentoonstellingen in galerijen, musea, artist run spaces en performance festivals, zowel in het Brussels Hoofdstedelijk Gewest als in samenwerking met het FWB, waaronder (selectie): Maison d\u2019\u00c9rasme & B\u00e9guinage (Anderlecht) in 2022, Centre Wallonie Bruxelles (Parijs) in 2020, Studio Thor (Sint-Joost) in 2020, SB34 (Sint-Gillis) in 2019, Wandering Art Biennal (Brussel) in 2018, Wiels (Vorst) en Clovis XV (Brussel) in 2017; in Vlaanderen: Het Depot (Leuven) in 2023, LLS Paleis (Antwerpen), De Studio (Antwerpen) in 2021, CC Strombeek Grimbergen (Strombeek) in 2020 en 019 (Gent) in 2016; in Europa: Meet Factory Praag (Tsjechi\u00eb) in 2023, Ferme Asile Sion (Zwitserland) in 2022, Futura Praag (Tsjechi\u00eb) in 2020, Eponyme Gallery Bordeaux (Frankrijk) in 2019, ALMA Espace d\u2019art Parijs (Frankrijk) in 2018, 5UN7 Bordeaux (Frankrijk) in 2016, Galeria Mieszka\u0144cy Krakow (Polen) in 2013. Coraline ontving ook een beurs van het Morpho-programma (Antwerpen) in 2023, van de Staat Wallis (Zwitserland) in 2022 en was finalist voor de \u201cFintro Prijs: Ondersteuning van Jonge Kunstenaars\u201d in 2022.","performers":"Coraline Guilbeau; ","boxoffice_url":null,"website":"https:\/\/centrale.brussels\/nl\/events\/ontmoeting-bezoek-met-coraline-guilbeau\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003896"}},"place":{"id":243546,"translations":{"de":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Die CENTRALE for Contemporary Art hat sich im Br\u00fcsseler Stadtzentrum in einem ehemaligen Elektrizit\u00e4tswerk niedergelassen. Hier wird eine engagierte und in jeder Hinsicht offene Vision der Kunst entwickelt und gepflegt, die im engen Austausch mit der Stadt und der Gesellschaft steht. In den verschiedenen R\u00e4umen und S\u00e4len finden regelm\u00e4\u00dfig Ausstellungen und andere multidisziplin\u00e4re Projekte mit namhaften K\u00fcnstlern und aufstrebenden jungen Talenten statt, die sowohl aus Br\u00fcssel als auch von ausw\u00e4rts stammen.","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null},"pt":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Nestled in a former power station in the heart of Brussels, CENTRALE for contemporary art is the contemporary art centre of the City of Brussels.\r\nIt develops a committed vision of art, beyond boundaries, and connected to the city and to society.\r\nEach year it collaborates with confirmed and emerging artists from Brussels and the international scene to produce exhibitions and multidisciplinary projects housed in its various premises.\r\n","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null},"it":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Nich\u00e9e au coeur de Bruxelles, au sein d\u2019une ancienne centrale \u00e9lectrique, la CENTRALE for contemporary art est le centre d\u2019art contemporain de la Ville de Bruxelles. Elle d\u00e9veloppe une vision engag\u00e9e et d\u00e9cloisonn\u00e9e de l\u2019art, en lien avec la cit\u00e9 et la soci\u00e9t\u00e9. Chaque ann\u00e9e, elle produit dans ses divers espaces des expositions et projets multidisciplinaires avec des artistes confirm\u00e9.e.s et \u00e9mergent.e.s, tant bruxellois.e.s qu\u2019internationaux.ales.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null},"sp":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"El museo CENTRALE for contemporary art tiene como misi\u00f3n dar a conocer las creaciones art\u00edsticas contempor\u00e1neas en el campo de las artes visuales a un p\u00fablico lo m\u00e1s amplio posible. El centro de arte contempor\u00e1neo de la ciudad de Bruselas tambi\u00e9n quiere suscitar preguntas sobre la sociedad actual. Tiene la voluntad de ser un espacio abierto al mundo, a Europa, a la ciudad y al barrio y mostrar los aspectos espec\u00edficos de Bruselas, una ciudad caracterizada por la diversidad de su poblaci\u00f3n y su riqueza cultural. Con el CENTRALE.box y el CENTRALE.lab, el CENTRALE for contemporary art apoya a los artistas emergentes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CENTRALE for contemporary art","address_street_name":"Sint-Katelijneplein","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Sint-Katelijneplein, 45","address_line2":"1000 Bruxelles","description_web":"In hartje Brussel, in een oude elektriciteitscentrale vond de CENTRALE for contemporary art, het kunstencentrum van de Stad Brussel, zijn onderkomen. Het centrum geeft blijk van een ge\u00ebngageerde en open visie op kunst, afgestemd op de stad en de maatschappij. Elk jaar vinden in de verschillende ruimten van het centrum multidisciplinaire tentoonstellingen en projecten plaats met bekende en onbekende kunstenaars, al dan niet afkomstig uit Brussel en Belgi\u00eb.","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"art_center","facebook_id":null,"backoffice_id":5909,"location":{"lat":50.8503503,"lon":4.3480237},"region":"brussels","last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2013-10-19T01:19:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":243546,"translations":{"de":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Die CENTRALE for Contemporary Art hat sich im Br\u00fcsseler Stadtzentrum in einem ehemaligen Elektrizit\u00e4tswerk niedergelassen. Hier wird eine engagierte und in jeder Hinsicht offene Vision der Kunst entwickelt und gepflegt, die im engen Austausch mit der Stadt u