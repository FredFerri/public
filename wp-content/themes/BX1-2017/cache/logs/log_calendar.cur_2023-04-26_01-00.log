":null,"publication_state":"public","last_updated_at":"2023-04-25T02:35:32+02:00","published_at":"2022-11-07T16:02:59+01:00","backoffice_id":265251,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.21653158578865},{"id":553896,"date_start":"2023-04-02","date_end":"2023-12-31","date_next":"2023-04-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Parcours Art Nouveau et Franc-Ma\u00e7onnerie \u00e0 Bruxelles","shortdescr":"Parcours Art Nouveau et Franc-Ma\u00e7onnerie \u00e0 Bruxelles.","longdescr":"Dans le cadre de l\u2019ann\u00e9e Art Nouveau Brussels 2023, le Mus\u00e9e belge de la Franc-Ma\u00e7onnerie propose un nouveau parcours qui permet de d\u00e9couvrir l\u2019empreinte des architectes et sculpteurs francs-ma\u00e7ons dans le tissu urbain. Malgr\u00e9 une forte urbanisation en cette fin de XIXe si\u00e8cle, l\u2019Art Nouveau trouve sa place dans les lieux publics : magasins, cin\u00e9mas, usines, \u00e9coles...  La plupart des artistes Art Nouveau sont membres d\u2019une des deux grandes loges bruxelloises de l\u2019\u00e9poque, Les Amis Philanthropes et Les Vrais Amis de l\u2019Union et du Progr\u00e8s R\u00e9unis. Ainsi, des architectes comme Victor Horta, Paul Hankar, Paul Hamesse, des sculpteurs comme Julien Dillens, Jef Lambeaux, Victor Rousseau, ou des orf\u00e8vres tel Philippe Wolfers trouvent souvent leurs principaux m\u00e9c\u00e8nes et commanditaires parmi les fr\u00e8res de ces loges.\r\n\r\n10 \u20ac \/ personne pour maximum 20 personnes. Si moins de 10 personnes : forfait de 100 \u20ac. Dur\u00e9e: +\/- 2h.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":null,"phone_booking":"+32 2 223 06 04","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553896"},"nl":{"name":"Stadswandeling Art Nouveau en Vrijmetselarij in Brussel","shortdescr":"Stadswandeling Art Nouveau en Vrijmetselarij in Brussel","longdescr":"In het kader van het evenement Art Nouveau Brussel 2023 biedt het Belgisch Museum van de Vrijmetselarij een gloednieuwe stadswandeling door Brussel aan. U kunt er de stempel van de vrijmetselaars architecten en beeldhouwers op het stedelijk weefsel ontdekken. Ondanks de sterke verstedelijking van Brussel aan het einde van de 19de eeuw, vond de Art Nouveau zijn plaats in openbare plaatsen: winkels, bioscopen, fabrieken, scholen, enz.  De meeste Art Nouveau kunstenaars waren lid van \u00e9\u00e9n van de twee grote Brusselse loges uit die tijd, Les Amis Philanthropes en Les Vrais Amis de l'Union et du Progr\u00e8s R\u00e9unis. Architecten als Victor Horta, Paul Hankar en Paul Hamesse, beeldhouwers als Julien Dillens, Jef Lambeaux en Victor Rousseau, en juweliers als Philippe Wolfers vonden hun klanten vaak bij de leden van deze loges.\r\n\r\n10 \u20ac per persoon voor maximum 20 personen per groep. Bestaat de groep uit minder dan 7 personen dan wordt een forfaitprijs van 100 \u20ac aangerekend. Duur: 2 u.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":null,"phone_booking":"+32 2 223 06 04","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553896"},"en":{"name":"Art Nouveau and Freemasonry Tour in Brussels","shortdescr":"Tour of Art Nouveau and Freemasonry in Brussels","longdescr":"As part of the Art Nouveau Brussels 2023 event, the Belgian Museum of Freemasonry is offering a brand new tour of Brussels. It allows you to discover the imprint of Freemason architects and sculptors on the urban landscape. In fact, despite the strong urbanisation of Brussels at the end of the 19th century, Art Nouveau found its place in public places: shops, cinemas, factories, schools, etc.  Most Art Nouveau artists were members of one of the two major Brussels lodges of the time, Les Amis Philanthropes and Les Vrais Amis de l'Union et du Progr\u00e8s R\u00e9unis. Architects such as Victor Horta, Paul Hankar and Paul Hamesse, sculptors such as Julien Dillens, Jef Lambeaux and Victor Rousseau, and jewellers such as Philippe Wolfers often found their clientele among the members of these lodges.\r\n\r\n10 \u20ac per person for a maximum of 20 people per group. If the group consists of fewer than 7 people, a price of 100 \u20ac will be charged. Duration: 2 hrs.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":null,"phone_booking":"+32 2 223 06 04","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553896"},"de":{"name":"Art Nouveau et Franc-Ma\u00e7onnerie \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":null,"phone_booking":"+32 2 223 06 04","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.553896"},"it":{"name":"Art Nouveau et Franc-Ma\u00e7onnerie \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":null,"phone_booking":"+32 2 223 06 04","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.553896"},"sp":{"name":"Art Nouveau et Franc-Ma\u00e7onnerie \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":null,"phone_booking":"+32 2 223 06 04","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.553896"},"pt":{"name":"Art Nouveau et Franc-Ma\u00e7onnerie \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":null,"phone_booking":"+32 2 223 06 04","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.553896"},"cn":{"name":"Art Nouveau et Franc-Ma\u00e7onnerie \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":null,"phone_booking":"+32 2 223 06 04","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.553896"}},"place":{"id":243784,"translations":{"fr":{"name":"Mus\u00e9e Belge de la Franc-Ma\u00e7onnerie","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"Aper\u00e7u historique et th\u00e9matique de la franc-ma\u00e7onnerie en Belgique.\r\nLe Mus\u00e9e Belge de la Franc-Ma\u00e7onnerie correspond \u00e0 une volont\u00e9 d\u2019ouverture de la part d\u2019une association entour\u00e9e de myst\u00e8re. Situ\u00e9 dans un b\u00e2timent n\u00e9oclassique (H\u00f4tel Dewez, fin 18\u00e8me si\u00e8cle), les visiteurs ont la possibilit\u00e9 de d\u00e9couvrir l\u2019histoire, la symbolique et les valeurs d\u00e9fendues par les francs\u2013ma\u00e7ons. Le mus\u00e9e pr\u00e9sente des objets d\u2019art, des d\u00e9corations, des bijoux, de la vaisselle, des documents et des livres datant du 18\u00e8me si\u00e8cle \u00e0 nos jours qui t\u00e9moignent de l\u2019\u00e9volution historique, du fonctionnement, des id\u00e9es et des structures de la franc-ma\u00e7onnerie.\r\n\r\nFermeture provisoire pour travaux jusque mi juillet","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Belgisch Museum van de Vrijmetselarij","address_street_name":"Lakensestraat","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Lakensestraat, 73","address_line2":"1000 Brussel","description_web":"Historisch en thematisch overzicht van de vrijmetselarij in Belgi\u00eb.\r\nHet Belgisch Museum van de Vrijmetselarij is een gebaar van openheid, een uitnodiging van een vereniging die bekend staat voor haar discretie, om haar geschiedenis beter te leren kennen. Het museum, gelegen in een prachtig gerestaureerd, neo-classicistisch gebouw (Huis Dewez, eind 18de eeuw), stelt ma\u00e7onnieke kunstwerken, gebruiksvoorwerpen, boeken en documenten van de 18de eeuw tot heden tentoon. Het zijn stille getuigen van de oorsprong, historische evolutie, de werking, de idee\u00ebn en de hedendaagse structuren van de vrijmetselarij.\r\n\r\n\r\nTijdelijke sluiting voor werkzaamheden tot half juli","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Belgian Museum of Freemasonry","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Laeken, 73","address_line2":"1000 Brussels","description_web":"Historic and thematic overview of the history of freemasonry in Belgium.\r\nThe Belgian Museum of Freemasonry is a gesture of openness, an invitation by an institution renowned for it\u2019s discretion and veiled in mystery, to get acquainted with its history. The museum, situated in an exquisitely restored neoclassical townhouse (house Dewez, late 18th century), presents artworks, ritual objects, jewellery, textiles, documents and books from the 18th century and on. They illustrate the origins, historic evolution, workings, ideas and present structures of freemasonry. \r\n\r\nTemporary closure for works until mid-July","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Belgisches Museum der Freimaurerei","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"Das Museum befindet sich in den Geb\u00e4uden des Grand Orient de Belgique, der \u00e4ltesten und gr\u00f6\u00dften Freimaurerloge Belgiens. Es birgt zahlreiche historische Sammlungen: Gem\u00e4lde, thematische Vitrinen mit Dokumenten, Schmuck, Geschirr und freimaurerischen Schriften.\r\n\r\n\r\nVor\u00fcbergehende Schlie\u00dfung wegen Bauarbeiten bis Mitte Juli","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo Belga della Massoneria","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Belga de la Francmasoner\u00eda","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"El Museo Belga de la Francmasoner\u00eda responde a un deseo de apertura por parte de una asociaci\u00f3n conocida por su discreci\u00f3n. Intenta explicar el enfoque mas\u00f3nico a trav\u00e9s de vitrinas tem\u00e1ticas y did\u00e1cticas, con el fin de informar y estimular la reflexi\u00f3n. Las piezas presentadas \u2014decoraciones, joyas, vajillas, libros... desde el siglo XVIII hasta nuestros d\u00edas\u2014 son muestras, marcas de la memoria que ilustran la evoluci\u00f3n hist\u00f3rica, el funcionamiento, las ideas y las estructuras actuales de la francmasoner\u00eda. \r\n\r\nCierre temporal por obras hasta mediados de julio","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museo Belga de la Francmasoner\u00eda","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Belge de la Franc-Ma\u00e7onnerie","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","d