_third":true},"time_start":"10:00:00","time_end":"17:00:00","translations":{"fr":"Ouvert le troisi\u00e8me, dimanche du mois de 10:00 \u00e0 17:00","nl":"Open op de derde, zondag van de maand van 10:00 tot 17:00","en":"Open the third, sunday of the month from 10:00 to 17:00"}}],"targets":{"list":[3,4,7,11],"translations":{"de":["Kinder 3-6 Jahre","Kinder 6-9 Jahre","Jugendliche 12-15 Jahre","Familie"],"pt":[null,null,null,null],"en":["Children 3-6 yr.","Children 6-9 yr.","Youth 12-15  yr.","Family"],"it":["Bambini 3-6 anni","Bambini 6-9 anni","Ragazzi 12-15 anni","Famiglie"],"cn":[null,null,null,null],"fr":["Enfants 3-6 ans","Enfants 6-9 ans","Jeunes 12-15 ans","Famille"],"sp":["Ni\u00f1os de 3 a 6 a\u00f1os","Ni\u00f1os de 6 a 9 a\u00f1os","J\u00f3venes de 12 a 15 a\u00f1os","Familias"],"nl":["Kinderen 3-6 j.","Kinderen 6-9 j.","Jongeren 12-15 j.","Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":50002071,"date_start":"2023-10-17","date_end":"2024-03-17","date_next":"2024-02-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-18T01:03:34+01:00","published_at":"2023-09-13T09:34:50+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":285236,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.23556613421026437,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"STUDIO 7: REINVENTING THE PAST","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/studio\/studio-7-reinventer-le-passe#pll_switcher","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50002071"},"pt":{"name":"STUDIO 7: REINVENTING THE PAST","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/studio\/studio-7-reinventer-le-passe#pll_switcher","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002071"},"en":{"name":"STUDIO 7: REINVENTING THE PAST","shortdescr":"Thanks to the Studio, the museum is able to highlight recently acquired historical or ultra-contemporary items. The capsule exhibitions displayed in this space offer visitors a glimpse of the museum\u2019s rich collections. Now it\u2019s the turn of the new generation!","longdescr":"Thanks to the Studio, the museum is able to highlight recently acquired historical or ultra-contemporary items. The capsule exhibitions displayed in this space offer visitors a glimpse of the museum\u2019s rich collections. Now it\u2019s the turn of the new generation!\n\nBorn in the 1980s and 1990s, the fashion designers presented illustrate the challenges of our time by reinventing elements from the past. By advocating engaged and outside-the-box fashion, they place the deconstruction of gender, masculine and feminine, at the heart of their work, along with environmental awareness.\n\n \n\nAbove and beyond the sociological aspect of their creative work, they undertake genuine research into the cuts, materials, techniques and aesthetics proposed.\n\nDiscover the joyous, fun-filled, colourful and less constricting pieces by:\n\nFlorent Seligmann\nMeryll Rogge\nFlorentina Leitner\nMIPINTA ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/en\/studio\/stuido7-re-inventing-the-past","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002071"},"it":{"name":"STUDIO 7: REINVENTING THE PAST","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/studio\/studio-7-reinventer-le-passe#pll_switcher","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002071"},"cn":{"name":"STUDIO 7: REINVENTING THE PAST","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/studio\/studio-7-reinventer-le-passe#pll_switcher","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002071"},"fr":{"name":"STUDIO 7 : R\u00c9INVENTER LE PASS\u00c9","shortdescr":"A travers le Studio, le mus\u00e9e met en lumi\u00e8res des pi\u00e8ces historiques ou ultra contemporaines r\u00e9cemment acquises. Les expositions capsules propos\u00e9es dans cet espace donnent un aper\u00e7u des riches collections du mus\u00e9e. Aujourd\u2019hui, place \u00e0 la nouvelle g\u00e9n\u00e9ration !","longdescr":"A travers le Studio, le mus\u00e9e met en lumi\u00e8res des pi\u00e8ces historiques ou ultra contemporaines r\u00e9cemment acquises. Les expositions capsules propos\u00e9es dans cet espace donnent un aper\u00e7u des riches collections du mus\u00e9e. Aujourd\u2019hui, place \u00e0 la nouvelle g\u00e9n\u00e9ration ! \n\nN\u00e9e dans les ann\u00e9es 1980 et 1990, les cr\u00e9ateurs et cr\u00e9atrices pr\u00e9sent\u00e9s illustrent des enjeux de notre temps en r\u00e9inventant des \u00e9l\u00e9ments du pass\u00e9. En pr\u00f4nant une mode engag\u00e9e et hors des cadres, ils mettent la d\u00e9construction des genres, masculins et f\u00e9minins au c\u0153ur de leurs travaux. La conscience \u00e9cologique n\u2019est pas en reste.\n\n Au-del\u00e0 de l\u2019aspect sociologique de leur expression, ils poursuivent une v\u00e9ritable recherche dans les coupes, les mati\u00e8res, les techniques et les esth\u00e9tiques propos\u00e9es.\n\nD\u00e9couvrez les pi\u00e8ces joyeuses, ludiques, color\u00e9es et plus libres de:\n\nFlorent Seligmann\nMeryll Rogge\nFlorentina Leitner\nMIPINTA ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/studio\/studio-7-reinventer-le-passe#pll_switcher","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002071"},"sp":{"name":"STUDIO 7: REINVENTING THE PAST","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/studio\/studio-7-reinventer-le-passe#pll_switcher","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002071"},"nl":{"name":"STUDIO 7: HET VERLEDEN HERUITVINDEN","shortdescr":"Via de Studio toont het museum een aantal historische of net ultramoderne stukken die onlangs verworven werden. De capsuletentoonstellingen in deze ruimte geven je een inkijkje in de rijke collectie van het museum. Maak plaats voor de nieuwe generatie!","longdescr":"Via de Studio toont het museum een aantal historische of net ultramoderne stukken die onlangs verworven werden. De capsuletentoonstellingen in deze ruimte geven je een inkijkje in de rijke collectie van het museum. Maak plaats voor de nieuwe generatie!\n\nDe ontwerp(st)ers die in de jaren 80 en 90 geboren zijn, belichten de uitdagingen van onze tijd door elementen uit het verleden heruit te vinden. Met hun pleidooi voor een ge\u00ebngageerde mode buiten de ge\u00ebffende paden geven ze de deconstructie van de mannelijke en vrouwelijke sekse een centrale plaats in hun werk. Ze hebben daarnaast ook oog voor milieubewustzijn.\n\nLos van het sociologische aspect in hun werk, blijven ze ook echt onderzoek doen naar de snit, de materialen, de technieken en de esthetiek die ze voorstellen.\n\nOntdek de vrolijke, speelse, kleurrijke en vrijgevochten stukken van :\n\nFlorent Seligmann\nMeryll Rogge\nFlorentina Leitner\nMIPINTA ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/nl\/studio\/stuido-7-het-verleden-heruitvinden","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002071"}},"place":{"id":1515,"translations":{"de":{"name":"Mus\u00e9e Mode et Dentelle - Mode- und Spitzenmuseum (Museen der Stadt Br\u00fcssel)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Das im Jahr 1977 er\u00f6ffnete Mode- und Spitzenmuseum (Mus\u00e9e Mode et Dentelle) hat in Br\u00fcssel eine echte Daseinsberechtigung, denn die Geschichte der Stadt, ja des Landes ist im wahrsten Sinne des Wortes eng mit der Textilkunst verwoben.\r\n\r\nBr\u00fcssel weist ein reiches Erbe auf, was feine Stoffe und Textilwaren angeht. Die Tradition der Textilindustrie, die bis ins 12. Jahrhundert zur\u00fcckreicht und sich bis heute im Bereich Modedesign und Textilhandel zeigt, ist fest in der Br\u00fcsseler Kultur verankert.\r\n\r\nEinen faszinierenden Einblick in diesen Bereich geben die reichen Sammlungen des Mode- und Spitzenmuseums mit alten, aber auch modernen Spitzengeweben, Stickereien, Kost\u00fcmen und extravaganten Accessoires, die im Rahmen regelm\u00e4\u00dfig wechselnder Ausstellungen gezeigt werden.\r\n\r\nParallel zu den gro\u00dfen thematischen Ausstellungen bietet das Mode- und Spitzenmuseum der zeitgen\u00f6ssischen Textilkreation eine besondere Plattform: Seit 2004 empf\u00e4ngt das Museum wechselnde Ausstellungen, die sowohl die Arbeiten von Studierenden im Bereich Textilkunst als auch die Werke bereits etablierter Textilk\u00fcnstler zeigen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Museum of Fashion & Lace ","address_street_name":"rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"The Fashion & Lace Museum displays its collections by means of major annual exhibitions. These address both the design and the production and social use of the garments.\r\nThe exhibitions transport you to diverse and captivating worlds. From items never before exhibited, such as in Masculinities or Back Side, through historical themes, such as the glamour of the 1930s or the bold \u201870s, to exhibitions devoted to Belgian designers such as Carine Gilson and Jean-Paul Lespagnard.\r\n\r\nParallel to these major exhibitions, the museum also offers:\r\n\r\n- The Fashion Room, an unparalleled space in Belgium, provides you with the opportunity to understand how a museum builds its collections. Discover exceptional items, not hidden behind glass, in order to see them up close.\r\n\r\n- The Lace Room displays remarkable pieces that illustrate the finesse, high quality and beauty of Brussels lace. Explore the history of this type of fabric, so valued by the elites in the 17th century yet no longer in vogue today.\r\n\r\nHoused in a series of historic houses at the heart of Brussels, the Fashion & Lace Museum holds some 15,000 pieces from the 16th century to the present. The Museum has the most important collections in the world when it comes to Brussels design and production, which it seeks to position in a Belgian and international context.\r\nIts collections attest to the changes in fashion as well as to a specific era of our culture and our society.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Mode & Dentelle","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Le Mus\u00e9e Mode & Dentelle pr\u00e9sente ses collections \u00e0 travers de grandes expositions annuelles. Elles abordent tant la cr\u00e9ation que la production et l\u2019usage social du v\u00eatement.\r\nCes expositions vous transportent dans des univers aussi vari\u00e9s que captivants. De l\u2019in\u00e9dit avec Masculinities ou Back Side, de l\u2019historique avec le glamour des ann\u00e9es 30 ou les audacieuses seventies ou encore des expositions consacr\u00e9es \u00e0 des cr\u00e9ateurs de chez nous comme Carine Gilson ou Jean-Paul Lespagnard.\r\n\r\nEn parall\u00e8le \u00e0 ces grandes expositions, le mus\u00e9e propose \u00e9galement :\r\n\r\n- La Fashion Room, cet espace in\u00e9dit en Belgique vous permet de comprendre comment un mus\u00e9e enrichit ses collections. D\u00e9couvrez y des pi\u00e8ces exceptionnelles, hors vitrine, afin d\u2019\u00eatre au plus proche de celles-ci.\r\n\r\n- La Chambre des Dentelles pr\u00e9sente de remarquables pi\u00e8ces illustrant la finesse, la qualit\u00e9 et la beaut\u00e9 de la dentelle de Bruxelles. Explorez l\u2019histoire de cette \u00e9toffe pris\u00e9e des \u00e9lites d\u00e8s le 17e si\u00e8cle et aujourd\u2019hui disparue.\r\n\r\nAbrit\u00e9 au c\u0153ur de Bruxelles, dans un ensemble de maisons historiques, le Mus\u00e9e Mode & Dentelle conserve quelque 15.000 pi\u00e8ces datant du 16e si\u00e8cle \u00e0 nos jours. Il poss\u00e8de les plus importantes collections au monde en ce qui concerne la cr\u00e9ation et la confection bruxelloises, qu\u2019il vise \u00e0 replacer dans un contexte belge et international.\r\nSes collections sont les t\u00e9moins de l\u2019\u00e9volution de la mode mais aussi d\u2019une \u00e9poque, de notre culture, de notre soci\u00e9t\u00e9.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo del Traje y Encaje (Museos de la Ciudad de Bruselas)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"El Museo del Traje y el Encaje destaca por su perspectiva din\u00e1mica e innovadora centrada en la moda contempor\u00e1nea. Ideal para ver prendas excepcionales de moda belga y bruselense en exposiciones temporales, como la de Jean-Paul Lespagnard. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Mode en Kant Museum ","address_street_name":"Violetstraat","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Violetstraat, 12","address_line2":"1000 Bruxelles","description_web":"Het Mode & Kant Museum presenteert zijn collecties tijdens grote jaarlijkse tentoonstellingen. Daarin komen het ontwerp, de productie en de sociale dimensie van kleding aan bod.\r\nDeze tentoonstellingen nemen je telkens mee naar een wereld die even gevarieerd als boeiend is. Je maakt er kennis met het ongeziene in Masculinities en Back Side, of met de historische glamour uit de jaren dertig. Ook de gedurfde jaren zeventig en tentoonstellingen gewijd aan onze eigen ontwerpers, zoals Carine Gilson of Jean-Paul Lespagnard, stonden ooit op het programma.\r\n\r\nNaast deze grote tentoonstellingen laat het museum je ook graag kennismaken met:\r\n- De Fashion Room, een baanbrekend concept in Belgi\u00eb, dat je toont hoe een museum zijn collecties verrijkt. We hebben enkele uitzonderlijke stukken opgesteld buiten de vitrine, zodat je ze in detail kunt bekijken.\r\n\r\n- De Kantkamer, waar opmerkelijke stukken opgesteld staan die de verfijning, de kwaliteit en de schoonheid van het Brusselse kantwerk illustreren. Kom de geschiedenis van deze stof ontdekken, die vanaf de 17e eeuw erg door de elite werd gewaardeerd, maar die nu verdwenen is.\r\nIn hartje  Brussel, in een groep historische huizen, bewaart het Mode & Kant Museum ongeveer 15.000 voorwerpen die dateren van de 16e eeuw tot vandaag. Het bezit de belangrijkste collecties ter wereld rond de Brusselse ontwerpen en kleding, die het in een Belgische en internationale context wil plaatsen.\r\nDe collecties leggen getuigenis af over de evolutie van de mode, maar ook over een tijdperk, onze cultuur en onze maatschappij.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":197,"location":{"lat":50.84577733,"lon":4.35198995},"region":"brussels","last_updated_at":"2024-