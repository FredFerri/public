ant.be\/fr\/loisirs.sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003469"},"cn":{"name":"Taiji quan\/Qi gong \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/loisirs.sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003469"},"fr":{"name":"Taiji quan\/Qi gong \u00e0 Bruxelles","shortdescr":null,"longdescr":"La saison 2023-2024 d\u00e9bute le 11 septembre 2023 et se termine le 30 juin 2024. Il n\u2019y a pas de cours pendant les cong\u00e9s scolaires.\n\nR\u00e9serv\u00e9s aux adultes en \u00e2ge de travailler, les cours permettent de rester en forme, de se d\u00e9tendre et de pratiquer une activit\u00e9 en groupe.\n\nInscription obligatoire\n> Par e-mail (loisirs.sante@solidaris.be)\n> Par courrier (rue des Moineaux 17-19 \u2013 1000 Bruxelles)\nY mentionner :\nNom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm, le(s) cours choisi(s) (commune et horaire), n\u00b0 de membre Loisirs et Sant\u00e9 (ou n\u00b0 de mutuelle)\nLe cours se paie :\n> Soit 5\u20ac \u00e0 la s\u00e9ance directement au moniteur (hors entr\u00e9e de piscine)\n> Soit par carte de 10 s\u00e9ances au prix de 40 euros\n> Soit avec un abonnement valable de septembre \u00e0 juin co\u00fbtant 120\u20ac (soit 32 s\u00e9ances pour le prix de 24 s\u00e9ances), qui se demande par e-mail et qu\u2019on envoie par la poste d\u00e8s r\u00e9ception du virement.\n\nLoisirs et Sant\u00e9 organise des cours de sports dans diff\u00e9rentes communes de Bruxelles. Consultez le programme complet (yoga, gymnastique dynamique, aquagym, Qi Gong, Ta\u00efji Quan) dans notre brochure semestrielle l\u2019Echomutualiste Familles ou sur le site de Solidaris Brabant www.solidaris-brabant.be\/fr\/loisirs-et-sante","performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/loisirs.sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003469"},"sp":{"name":"Taiji quan\/Qi gong \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/loisirs.sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003469"},"nl":{"name":"Taiji quan\/Qi gong \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/loisirs.sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003469"}},"place":{"id":277771,"translations":{"de":{"name":"FMSB","address_street_name":"Bld Lemonnier 2\u00e8me \u00e9tage (sonnette Pierson)","address_street_number":"41","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Bld Lemonnier 2\u00e8me \u00e9tage (sonnette Pierson), 41","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"FMSB","address_street_name":"Bld Lemonnier 2\u00e8me \u00e9tage (sonnette Pierson)","address_street_number":"41","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Bld Lemonnier 2\u00e8me \u00e9tage (sonnette Pierson), 41","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null