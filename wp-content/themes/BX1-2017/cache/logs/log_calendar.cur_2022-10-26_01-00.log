d\u00e9rob\u00e9e par un fant\u00f4me farceur\u2026 Avec ses amis, il vous met au d\u00e9fi de relever quatre \u00e9preuves pour la retrouver ! Pr\u00e9parez votre d\u00e9guisement, armez-vous de courage et d\u00e9couvrez le mus\u00e9e comme vous ne l\u2019avez jamais vu.  \r\nEv\u00e9nement gratuit accessible aux enfants et grands enfants \u00e0 partir de 6 ans.  N'oubliez pas de r\u00e9server soit par t\u00e9l\u00e9phone au 02\/555.34.31 soit par mail : brigitte.dhossche@erasme.ulb.ac.be","performers":"L'\u00e9quipe du Mus\u00e9e de la M\u00e9decine","boxoffice_url":null,"website":"http:\/\/www.museemedecine.be\/","email":"museemedecine@erasme.ulb.ac.be","phone_contact":"+32 2 555 34 31","phone_booking":"+32 2 555 34 31","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542937"},"nl":{"name":"Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542937"},"en":{"name":"Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542937"},"de":{"name":"\u00a3Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542937"},"it":{"name":"\u00a3Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542937"},"sp":{"name":"\u00a3Halloween Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":n