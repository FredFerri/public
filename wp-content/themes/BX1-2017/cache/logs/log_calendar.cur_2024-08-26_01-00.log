tteile"],"pt":[null],"en":["Neighbourhoods"],"it":["Quartieri"],"cn":[null],"fr":["Quartiers"],"sp":["Barrios"],"nl":["Wijken"]}}},"translations":{"de":{"name":"ZINNE BAZAAR | MAROLLES (FR) | La d\u00e9couverte de l'\u00e9conomie locale et engag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010385"},"pt":{"name":"ZINNE BAZAAR | MAROLLES (FR) | La d\u00e9couverte de l'\u00e9conomie locale et engag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010385"},"en":{"name":"ZINNE BAZAAR | MAROLLES (FR) | La d\u00e9couverte de l'\u00e9conomie locale et engag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010385"},"it":{"name":"ZINNE BAZAAR | MAROLLES (FR) | La d\u00e9couverte de l'\u00e9conomie locale et engag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010385"},"cn":{"name":"ZINNE BAZAAR | MAROLLES (FR) | La d\u00e9couverte de l'\u00e9conomie locale et engag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010385"},"fr":{"name":"Balade ZINNE BAZAAR | MAROLLES (FR) | La d\u00e9couverte de l'\u00e9conomie locale et engag\u00e9e","shortdescr":"Plonge avec nous dans le grand Zinne Bazaar. Pars en balade, d\u00e9couvre les histoires, secrets et bons plans qui se cachent derri\u00e8re les vitrines de ta ville. Tu d\u00e9couvriras en m\u00eame temps les rouages d'une monnaie locale et comment elle cr\u00e9e du lien entre les habitant\u00b7e\u00b7s et des initiatives engag\u00e9es.\nQuartier des Marolles\n","longdescr":"Plonge avec nous dans le grand Zinne Bazaar. \nPars en balade, d\u00e9couvre les histoires, secrets et bons plans qui se cachent derri\u00e8re les vitrines de ta ville. Tu d\u00e9couvriras en m\u00eame temps les rouages d'une monnaie locale et comment elle cr\u00e9e du lien entre les habitant\u00b7e\u00b7s et des initiatives engag\u00e9es.\nQuartier des Marolles\n\nR\u00e9servations sur : www.zinne.brussels\/events\/\n5 Zinnes vous seront donn\u00e9es pendant la balades ! \n","performers":"Bazaar Trottoir (guide)\n","boxoffice_url":null,"website":"http:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010385"},"sp":{"name":"ZINNE BAZAAR | MAROLLES (FR) | La d\u00e9couverte de l'\u00e9conomie locale et engag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010385"},"nl":{"name":"ZINNE BAZAAR | MAROLLES (FR) | La d\u00e9couverte de l'\u00e9conomie locale et engag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010385"}},"place":{"id":238555,"translations":{"de":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Bei dem Place Poelaert, der sich 63 Meter \u00fcber der Br\u00fcsseler Unterstadt befindet, handelt es sich um den Vorplatz des beeindruckenden Br\u00fcsseler Justizpalasts. Ein Fahrstuhl ist die schnellste Verbindung zwischen Ober- und Unterstadt. Der Platz misst 155 m x 50 m, d. h. knapp 8 hat - damit ist der Place Poelaert der gr\u00f6\u00dfte Platz Br\u00fcssels.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Poelaert","address_line2":"1000 Brussels","description_web":"Between the popular Marolles district and the elegant Louise neighbourhood lies the place Poelaert. This is the place to go for a superb panoramic view of the lower part of the city. On the horizon are architectural heritage gems such as the Basilica of Koekelberg and the Atomium. Sunset in particular is a great time to enjoy the seemingly endless sky. Not afraid of heights? Since 2019, the giant Ferris wheel 'The View' has taken up residence here and you can admire the Belgian capital from a height of no less than one hundred metres! Afterwards, take the free glass lift and dive into the Marolles for more urban fun.\r\n\r\nPlace Poelaert, with its 750m\u00b2 surface area, is also the largest square in the capital. It was named after Joseph Poelaert, the architect of the Palace of Justice, which is the monumental courthouse you see on this square, a mastodon from the 19th century. The scaffolding surrounding the courthouse has become part of the public's collective memory.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Entre les Marolles tr\u00e8s populaires, et l'\u00e9l\u00e9gant quartier Louise, se trouve la place Poelaert. C'est le meilleur spot pour avoir une vue panoramique \u00e0 couper le souffle sur la ville. \u00c0 l'horizon se profilent des joyaux du patrimoine bruxellois comme la basilique de Koekelberg et l'Atomium ; \u00e0 admirer sans mod\u00e9ration, et particuli\u00e8rement au coucher du soleil. Vous n'avez pas le vertige ? Depuis 2019, la grande roue \" The View \" vous emm\u00e8ne \u00e0 cent m\u00e8tres de haut pour admirer la capitale belge, tandis que l'ascenseur (gratuit), tout en verre, vous fait plonger dans les Marolles pour encore plus de plaisir en ville.\r\n\r\nAvec ses 750 m2, la place Poelaert est \u00e9galement la plus grande place de la capitale. Elle doit son nom \u00e0 Joseph Poelaert, l'architecte du monumental palais de justice, construit au 19\u00e8me si\u00e8cle, qui tr\u00f4ne sur cette place ; et l\u2019\u00e9chafaudage qui le soutient depuis des ann\u00e9es fait d\u00e9sormais partie de la m\u00e9moire collective.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Poelaertplein","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Poelaertplein","address_line2":"1000 Brussel","description_web":"Tussen de volkse Marollen en de elegante Louizawijk ligt het Poelaertplein. Hier moet je zijn voor een prachtig panoramisch uitzicht over de (beneden)stad. Aan de horizon prijken architecturale erfgoedparels zoals de Basiliek van Koekelberg en het Atomium. Vooral bij zonsondergang is het hier volop genieten van een eindeloze hemel. Geen hoogtevrees? Sinds 2019 staat hier het reuzenrad \u2018The View\u2019 en kan je de Belgische hoofdstad bewonderen vanop maar liefst honderd meter hoogte! Nadien kan je gratis de glazen lift nemen en de Marollen induiken voor meer stadsplezier.\r\n\r\nHet Poelaertplein is met een oppervlakte van 750 m\u00b2 ook het grootste plein van de hoofdstad. Het werd vernoemd naar Joseph Poelaert, de architect van het justitiepaleis. Dat is het monumentale gerechtsgebouw dat je op dit plein ziet, een mastodont uit de 19de eeuw. De steigers waarin het justitiepaleis sinds jaar en dag verpakt is, maken ondertussen deel uit van het collectieve geheugen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[2],"translations":{"de":["Marollen"],"pt":[null],"en":["Marolles"],"it":["Marolles"],"cn":[null],"fr":["Marolles"],"sp":["Marolles"],"nl":["Marollen"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":"109264419156670","backoffice_id":2016,"location":{"lat":50.83696471,"lon":4.35179017},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:14:50+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":50001368,"translations":{"de":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Zinne","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"La Zinne, c\u2019est aussi et surtout une exp\u00e9rience citoyenne : un ensemble d\u2019objectifs, de valeurs et de crit\u00e8res, qui mat\u00e9rialise dans de jolis billets color\u00e9s la volont\u00e9 de faire vivre la Bruxelles que l\u2019on aime.\n\nL\u00e9galement, une monnaie locale compl\u00e9mentaire \u00e0 l\u2019euro est reconnue comme \u00ab bon de soutien \u00e0 l\u2019\u00e9conomie locale \u00bb, en R\u00e9gion bruxelloise. C\u2019est pour la g\u00e9rer et la faire grandir que la structure Zinne ASBL a \u00e9t\u00e9 cr\u00e9\u00e9e en 2019.\n\nNos missions principales, en tant qu\u2019ASBL, sont de veiller au respect de la charte de valeurs et aux objectifs du projet, promouvoir l\u2019utilisation des Zinnes en s\u2019activant pour \u00e9largir en permanence le r\u00e9seau o\u00f9 il est possible de les d\u00e9penser, travailler sur les fili\u00e8res professionnelles (fournisseurs, prestataires de services, etc.), afin qu\u2019une Zinne puisse circuler toujours plus longtemps au sein de notre \u00e9conomie locale","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visi