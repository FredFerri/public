d":315836,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.8170579406432438,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"La danse du silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccauderghem.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005234"},"pt":{"name":"La danse du silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccauderghem.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005234"},"en":{"name":"La danse du silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccauderghem.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005234"},"it":{"name":"La danse du silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccauderghem.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005234"},"cn":{"name":"La danse du silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccauderghem.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005234"},"fr":{"name":"La danse du silence","shortdescr":"Chaque jour, en moyenne, un enfant sur cinq est victime de violence intrafamiliale. La Danse du Silence explore ce fl\u00e9au \u00e0 travers le parcours poignant et universel d\u2019un jeune gar\u00e7on pris dans l\u2019engrenage du silence et de la souffrance.","longdescr":"A la base, on partait sur un tout autre projet ! Et puis St\u00e9phane H\u00e9rion m\u2019a racont\u00e9 sa vie, son enfance, son adolescence, la violence, les coups, la chose\u2026 sa danse du silence. Il m\u2019a livr\u00e9 son voyage pour devenir un homme \u00ab presque normal \u00bb : un boulot, 4 enfants, un mari et un chien ! On a d\u00e9cid\u00e9 d\u2019en faire un spectacle. Bient\u00f4t St\u00e9phane montera sur sc\u00e8ne entour\u00e9s de 2 jeunes com\u00e9diens talentueux qui vont tour \u00e0 tour incarner les diff\u00e9rents protagonistes de son histoire : le silence de la violence intra familiale. Comme le sujet du spectacle est dur, celui-ci se pr\u00e9sentera sous forme de sc\u00e8nes courtes qui s\u2019encha\u00eenent au travers de musiques, de chor\u00e9graphies et de tableaux pour symboliser la violence, le sexe et la dissociation. Une fa\u00e7on ludique, rythm\u00e9e, sinc\u00e8re et brute de rester dans le propos tout en le d\u00e9livrant de mani\u00e8re artistique. L\u2019urgence \u00e9tant de briser le silence dans les familles trop nombreuses qui vivent dans la violence. Arr\u00eater ce tango du silence entre la victime, le t\u00e9moin et le bourreau\u2026 cette danse implacable, terrible et brutale qui terrasse les familles. Odile Matthieu, metteuse en sc\u00e8ne, Janvier 2025","performers":"Cr\u00e9ation Mondiale \/Un texte de Odile Matthieu et St\u00e9phane H\u00e9rion\nAvec Julien Van Boeckel, Cyril Collet, Stephane H\u00e9rion\nMise en sc\u00e8ne Odile Matthieu\nSc\u00e9nographie et Costumes: Sophie Hazebroeck\nCr\u00e9ation lumi\u00e8re : Bruno Fontfr\u00e8de\nCr\u00e9ation sonore : Christophe de Moffarts\n","boxoffice_url":null,"website":"https:\/\/ccauderghem.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005234"},"sp":{"name":"La danse du silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccauderghem.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005234"},"nl":{"name":"La danse du silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccauderghem.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005234"}},"place":{"id":136,"translations":{"de":{"name":"Centre Culturel d'Auderghem","address_street_name":"Boulevard du Souverain","address_street_number":"183","address_street_box":null,"email":"accueil@ccauderghem.be","website":"http:\/\/www.ccauderghem.be","phone_contact":"+32 2 660 03 03","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Boulevard du Souverain, 183","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel d'Auderghem","address_street_name":"Boulevard du Souverain","address_street_number":"183","address_street_box":null,"email":"accueil@ccauderghem.be","website":"http:\/\/www.ccauderghem.be","phone_contact":"+32 2 660 03 03","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Boulevard du Souverain, 183","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Centre Culturel d'Auderghem","address_street_name":"Boulevard du Souverain","address_street_number":"183","address_street_box":null,"email":"accueil@ccauderghem.be","website":"http:\/\/www.ccauderghem.be","phone_contact":"+32 2 660 03 03","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","ad