ions":{"de":{"name":"Expo - Territoire miroir, \u00e9criture d\u2019\u00e9chapp\u00e9e - Linogravure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001471"},"pt":{"name":"Expo - Territoire miroir, \u00e9criture d\u2019\u00e9chapp\u00e9e - Linogravure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001471"},"en":{"name":"Expo - Territoire miroir, \u00e9criture d\u2019\u00e9chapp\u00e9e - Linogravure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001471"},"it":{"name":"Expo - Territoire miroir, \u00e9criture d\u2019\u00e9chapp\u00e9e - Linogravure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001471"},"cn":{"name":"Expo - Territoire miroir, \u00e9criture d\u2019\u00e9chapp\u00e9e - Linogravure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001471"},"fr":{"name":"Expo - Territoire miroir, \u00e9criture d\u2019\u00e9chapp\u00e9e - Linogravure","shortdescr":"Sylvie Malfait Carakehian creuse sans discontinuer la mati\u00e8re pour en tirer des territoires nouveaux, des compositions \u00e0 la fois intimes et universelles. Ses couleurs, ses transparences, ses formes, ses alphabets se glissent entre le papier et la presse pour nous permettre de fl\u00e2ner entre les lignes sinueuses de ses cheminements ondoyants. ","longdescr":"Sylvie Malfait Carakehian creuse sans discontinuer la mati\u00e8re pour en tirer des territoires nouveaux, des compositions \u00e0 la fois intimes et universelles. Ses couleurs, ses transparences, ses formes, ses alphabets se glissent entre le papier et la presse pour nous permettre de fl\u00e2ner entre les lignes sinueuses de ses cheminements ondoyants. Notre regard peut ainsi accrocher les espaces qu\u2019elle ouvre \u00e0 notre curiosit\u00e9, happ\u00e9e par l\u2019ensemble harmonieux ou par les d\u00e9tails, ci et l\u00e0, \u00e9chapp\u00e9s d\u2019un chaos primordial. Chaque \u0153uvre, unique, bouscule la logique m\u00eame de la gravure, refusant la tentation de la multiplication des images. Toute cette \u00e9nergie positive, n\u00e9e du doute comme des convictions, nous est offerte dans des formats divers et des alliances vari\u00e9es. ","performers":"Sylvie Malfait Carakehian (Linogravure)","boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001471"},"sp":{"name":"Expo - Territoire miroir, \u00e9criture d\u2019\u00e9chapp\u00e9e - Linogravure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001471"},"nl":{"name":"Expo - Territoire miroir, \u00e9criture d\u20