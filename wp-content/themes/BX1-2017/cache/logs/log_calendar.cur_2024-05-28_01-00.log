pe":"expo","ranking":0.2679161449185622,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[24],"translations":{"de":["Kunstgalerien"],"pt":[null],"en":["Art Galleries"],"it":["Gallerie d'arte"],"cn":[null],"fr":["Galeries d'art"],"sp":["Galer\u00edas de arte"],"nl":["Galeries"]}}},"translations":{"de":{"name":"Bestiaire star","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009535"},"pt":{"name":"Bestiaire star","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009535"},"en":{"name":"Bestiaire star","shortdescr":"Hectare's Bestiaire Star exhibition is part of the Be.Tour for the second edition of Brussels Jewellery Week from 25 to 28 April 2024. A festival that highlights contemporary jewellery and brings together 15 Brussels and international galleries.\n\"Between figuration and suggestion of the animal world. A play on the duality between what repels us and what attracts us\".","longdescr":"The animal kingdom has long been a source of inspiration for both the visual arts and jewellery.\nTrue to their philosophy of wearable contemporary jewellery, but also driven by a sense of humour and the offbeat, Hectare's gallery owners have selected six artists from near and far to put wildlife in the spotlight. Bestiaire Star ventures into disturbing, surprising and seductive territory, populated by hybrid creatures.\nThe creations of Miriam Arentz, Monika Brugger, Benedikt Fischer, Lore Langendries, M\u00e4rta Mattsson and Vivienne Varay play on attraction and repulsion, without avoiding the question of the materials used: imitated or real, reinvented or recycled.\nThe bestiary - an educational picture book - becomes a cabinet of curiosities. Where the trivial is adorned with the precious, where the object becomes a story, where the familiar is hijacked and emboldened to the brink of the strange.\n\nHectare's Bestiaire Star exhibition is part of the Be.Tour for the second edition of Brussels Jewellery Week from 25 to 28 April 2024. A festival that highlights contemporary jewellery and brings together 15 Brussels and international galleries.","performers":"Benedikt Fischer, Lore Langendries, M\u00e4rta Mattsson, Miriam Arentz, Monika Brugger, Vivienne Varay","boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/en\/exhibitions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009535"},"it":{"name":"Bestiaire star","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009535"},"cn":{"name":"Bestiaire star","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009535"},"fr":{"name":"Bestiaire star","shortdescr":"L\u2019exposition Bestiaire Star d\u2019Hectare s\u2019inscrit dans le Be.Tour de la seconde \u00e9dition de la Brussels Jewellery Week du 25 au 28 avril 2024. Un festival qui met en lumi\u00e8re le bijou contemporain et qui regroupe 15 galeries bruxelloises et internationales.\n\u00ab  Entre figuration et suggestion du monde animal. Un jeu sur la dualit\u00e9 entre, ce qui nous repousse et nous attire. \u00bb\n","longdescr":"Le r\u00e8gne animal inspire de longue date tant les arts visuels que les \u00e9l\u00e9ments de parure.\nFid\u00e8les \u00e0 leur philosophie du bijou contemporain portable, mues aussi par un sens certain de l\u2019humour et du d\u00e9calage, les galeristes d\u2019Hectare ont s\u00e9lectionn\u00e9 six artistes d\u2019ici et d\u2019ailleurs pour mettre la faune \u00e0 l\u2019honneur. Bestiaire Star s\u2019aventure dans des territoires inqui\u00e9tants, surprenants, s\u00e9duisants, peupl\u00e9s d\u2019hybrides cr\u00e9atures.\nLes cr\u00e9ations de Miriam Arentz, Monika Brugger, Benedikt Fischer, Lore Langendries, M\u00e4rta Mattsson et Vivienne Varay mettent en jeu l\u2019attraction et la r\u00e9pulsion, sans esquiver la question des mat\u00e9riaux convoqu\u00e9s: imit\u00e9s ou v\u00e9ritables, r\u00e9invent\u00e9s ou recycl\u00e9s.\nLe bestiaire \u2013 cet imagier \u00e0 vis\u00e9e \u00e9ducative \u2013 se mue ici en cabinet de curiosit\u00e9s. O\u00f9 le trivial se pare de pr\u00e9cieux, o\u00f9 l\u2019objet devient histoire, o\u00f9 la familiarit\u00e9 d\u00e9tourn\u00e9e s\u2019enhardit jusqu\u2019\u00e0 tutoyer l\u2019\u00e9trange.\n\nL\u2019exposition Bestiaire Star d\u2019Hectare s\u2019inscrit dans le Be.Tour de la seconde \u00e9dition de la Brussels Jewellery Week du 25 au 28 avril 2024. Un festival qui met en lumi\u00e8re le bijou contemporain et qui regroupe 15 galeries bruxelloises et internationales.\n","performers":"Benedikt Fischer, Lore Langendries, M\u00e4rta Mattsson, Miriam Arentz, Monika Brugger, Vivienne Varay","boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009535"},"sp":{"name":"Bestiaire star","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009535"},"nl":{"name":"Bestiaire star","shortdescr":"De tentoonstelling Bestiaire Star van Hectare maakt deel uit van de Be.Tour voor de tweede editie van de Brussels Jewellery Week van 25 tot 28 april 2024. Een festival dat hedendaagse juwelen in de kijker zet en 15 Brusselse en internationale galerijen samenbrengt.\n\"Tussen figuratie en suggestie van de dierenwereld. Een spel over de dualiteit tussen wat ons afstoot en wat ons aantrekt\".","longdescr":"Het dierenrijk is al lang een bron van inspiratie voor zowel de beeldende kunst als sieraden.\nTrouw aan hun filosofie van draagbare hedendaagse sieraden, maar ook gedreven door gevoel voor humor en het onconventionele, hebben de galeriehouders van Hectare zes kunstenaars van heinde en verre geselecteerd om wilde dieren in de schijnwerpers te zetten. Bestiaire Star begeeft zich op verontrustend, verrassend en verleidelijk terrein, bevolkt door hybride wezens.\nDe creaties van Miriam Arentz, Monika Brugger, Benedikt Fischer, Lore Langendries, M\u00e4rta Mattsson en Vivienne Varay spelen met aantrekking en afstoting, zonder de kwestie van de gebruikte materialen uit de weg te gaan: nagemaakt of echt, opnieuw uitgevonden of gerecycled.\nHet bestiarium - een educatief prentenboek - wordt een rariteitenkabinet. Waar het triviale wordt opgesierd met het kostbare, waar het object een verhaal wordt, waar het vertrouwde wordt gekaapt en uitvergroot tot het randje van het vreemde.\n\nDe tentoonstelling Bestiaire Star van Hectare maakt deel uit van de Be.Tour voor de tweede editie van de Brussels Jewellery Week van 25 tot 28 april 2024. Een festival dat hedendaagse juwelen in de kijker zet en 15 Brusselse en internationale galerijen samenbrengt.","performers":"Benedikt Fischer, Lore Langendries, M\u00e4rta Mattsson, Miriam Arentz, Monika Brugger, Vivienne Varay","boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/nl\/tentoonstellingen\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009535"}},"place":{"last_updated_at":"2024-04-10T16:30:10+02:00","published_at":"2024-04-10T16:30:09+02:00","id":50001488,"translations":{"de":{"name":"Hectare Galerie","address_street_name":"Rue Faider","address_street_number":"86","address_street_box":null,"email":"atelier@hectare-galerie.be","website":"https:\/\/hectare-galerie.be\/","phone_contact":"+32 2 640 72 53","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Faider, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Hectare Galerie","address_street_name":"Rue Faider","address_street_number":"86","address_street_box":null,"email":"atelier@hectare-galerie.be","website":"https:\/\/hectare-galerie.be\/","phone_contact":"+32 2 640 72 53","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Faider, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Hectare Galerie","address_street_name":"Faiderstraat","address_street_number":"86","address_street_box":null,"email":"atelier@hectare-galerie.be","website":"https:\/\/hectare-galerie.be\/","phone_contact":"+32 2 640 72 53","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Faiderstraat, 86","a