d_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,261],"translations":{"fr":["Accessible","Parking accessible"],"nl":["Toegankelijk","Toegankelijke parking"],"en":["Accessible","Accessible parking"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T01:08:10+02:00","published_at":"2022-07-29T10:15:34+02:00","backoffice_id":259067,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.26622042768612},{"id":522403,"date_start":"2021-11-08","date_end":"2022-11-07","date_next":"2022-11-07","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":"Un potager avec des poissons ! Vous connaissez? C'est possible m\u00eame en ville ! Cela s'appelle de l'Aquaponie ! Une technique de culture durable, \u00e9cologique et innovante !","longdescr":"Venez vivre une exp\u00e9rience sensorielle unique en apprenant plein de choses sur l\u2019aquaponie, ce mode de culture innovant et tr\u00e8s adapt\u00e9 pour la ville! Nous d\u00e9couvrirons ensemble son fonctionnement, ses avantages, les plantes potag\u00e8res cultiv\u00e9es, des notions de biologie des poisson, d\u2019hydraulique, de mat\u00e9riel n\u00e9cessaire.\r\nIl y aura \u00e9galement de la pratique : reconnaissance de plantes, plantations, tests de l\u2019eau, et notre activit\u00e9 phare : la p\u00eache \u00e0 l\u2019\u00e9puisette ! (Les poissons sont ensuite rel\u00e2ch\u00e9s). Ambiance convivale garantie m\u00eame en hiver ! :-)","performers":"Laurence Vanneyre (chef de projets aquaponie, biologiste, co-fondatrice de l'asbl)","boxoffice_url":null,"website":"http:\/\/www.aquaponiebxl.be","email":"aquaponiebxl@gmail.com","phone_contact":null,"phone_booking":"+32 470 17 45 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.522403"},"nl":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"aquaponiebxl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.522403"},"en":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"aquaponiebxl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.522403"},"de":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.522403"},"it":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.522403"},"sp":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.522403"},"pt":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visit