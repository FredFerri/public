ption_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"La Patinoire Royale - galer\u00eda Val\u00e9rie Bach","address_street_name":"Rue Veydt","address_street_number":"15","address_street_box":null,"email":"info@galerievaleriebach.com","website":"https:\/\/www.prvbgallery.com\/","phone_contact":"+32 2 553 03 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Veydt, 15","address_line2":"1060 Saint-Gilles","description_web":"La galer\u00eda Val\u00e9rie Bach est\u00e1 situada en un lugar excepcional, un complejo de estilo industrial considerado como parte del patromonio arquitect\u00f3nico de Bruselas. La galer\u00eda se centra en apoyar a artistas establecidos en Bruselas y en introducir a artistas extranjeros contempor\u00e1neos, emergentes o ya conocidos, pintores, escultores, artistas visuales y fot\u00f3grafos que han capturado su inter\u00e9s y cuyo trabajo ha sido seguido durante varios a\u00f1os.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La Patinoire Royale - galerie Val\u00e9rie Bach","address_street_name":"Rue Veydt","address_street_number":"15","address_street_box":null,"email":"info@galerievaleriebach.com","website":"https:\/\/www.prvbgallery.com\/","phone_contact":"+32 2 553 03 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Veydt, 15","address_line2":"1060 Saint-Gilles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"La Patinoire Royale - galerie Val\u00e9rie Bach","address_street_name":"Rue Veydt","address_street_number":"15","address_street_box":null,"email":"info@galerievaleriebach.com","website":"https:\/\/www.prvbgallery.com\/","phone_contact":"+32 2 553 03 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Veydt, 15","address_line2":"1060 Saint-Gilles","d