32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003243"},"en":{"name":"Qi gong \u00e0 Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003243"},"it":{"name":"Qi gong \u00e0 Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003243"},"cn":{"name":"Qi gong \u00e0 Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003243"},"fr":{"name":"Qi gong \u00e0 Jette","shortdescr":null,"longdescr":"R\u00e9serv\u00e9s aux personnes de plus de 50 ans, les cours  permettent de rester en forme, de se d\u00e9tendre et de pratiquer une activit\u00e9 en groupe.\nInscription obligatoire\u00a0:\n> Par e-mail (sacasport@solidaris.be)\n> Par courrier (rue des Moineaux 17-19 \u2013 1000 Bruxelles)\n> A notre accueil (Rue du Midi 118 \u2013 1000 Bruxelles, ouvert du lundi au vendredi de 8h30 \u00e0 12h, et de 13h30 \u00e0 15h)\nY mentionner :\nNom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm, le(s) cours choisi(s) (commune et horaire), n\u00b0 de membre S\u2019Acad\u00e9mie (ou n\u00b0 de mutuelle)\nLe cours se paie :\n> Soit 5\u20ac \u00e0 la s\u00e9ance directement au moniteur (hors entr\u00e9e de piscine)\n> Soit avec un abonnement valable de septembre \u00e0 juin co\u00fbtant 125\u20ac (soit 33 s\u00e9ances pour le prix de 25 s\u00e9ances), qui s\u2019ach\u00e8te uniquement \u00e0 notre accueil en cash jusqu\u2019au 1er octobre 2023 (un abonnement par cours bien d\u00e9fini). \n\n\nSeniors Acad\u00e9mie organise des cours de sports dans diff\u00e9rentes communes de Bruxelles. Consultez le programme complet (yoga, gymnastique douce, aquagym, Qi Gong, Ta\u00efji Quan) dans notre brochure semestrielle l\u2019Echomutualiste Seniors ou sur le site de Solidaris brabant www.solidaris-brabant.be\/fr\/sacademie. \n\nVoici \u00e9galement nos conditions g\u00e9n\u00e9rales","performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003243"},"sp":{"name":"Qi gong \u00e0 Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003243"},"nl":{"name":"Qi gong \u00e0 Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003243"}},"place":{"last_updated_at":"2023-02-05T12:29:22+01:00","published_at":"2017-10-10T10:30:37+02:00","id":270059,"translations":{"de":{"name":"Casa Veronica","address_street_name":"Avenue Capart","address_street_number":null,"address_street_box":null,"email":"contact.casa.veronica@gmail.com","website":"http:\/\/www.casaveronica.net","phone_contact":"+32 476 77 23 42","phone_booking":"+