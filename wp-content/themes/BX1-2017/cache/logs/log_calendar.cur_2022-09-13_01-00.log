ilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-06T11:35:12+02:00","published_at":"2022-08-01T11:17:29+02:00","backoffice_id":257724,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.8735804647363},{"id":541584,"date_start":"2022-09-23","date_end":"2022-10-09","date_next":"2022-09-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Bouff\u00e9e d'air - Ir\u00e8ne Ku & Alexander Kudriavchenko","shortdescr":"L'exposition pr\u00e9sentera des peintures, des illustrations, des objets - la plupart cr\u00e9\u00e9s par Alexander et Ir\u00e8ne, lors de leur s\u00e9jour en Belgique.  Dans leurs \u0153uvres, ils r\u00e9fl\u00e9chissent aux th\u00e8mes de la vie qui a radicalement chang\u00e9 pour eux apr\u00e8s le 24 f\u00e9vrier 2022.","longdescr":"La possibilit\u00e9 de faire de l'art est une bouff\u00e9e d'air frais pour les artistes. Et il en a toujours \u00e9t\u00e9 ainsi.\r\n\r\nLes artistes peignent m\u00eame quand il y a la guerre, m\u00eame quand il y a la souffrance.  Les \u00e9crivains et les musiciens ne sont pas silencieux...\r\n\r\nParce que c'est notre fa\u00e7on de parler.  Nous ne cr\u00e9ons pas de d\u00e9cor, mais nous parlons au monde \u00e0 notre mani\u00e8re.  Nous disons que nous ne sommes pas bris\u00e9s, m\u00eame si nous sommes d\u00e9prim\u00e9s.\r\n\r\nUne bouff\u00e9e d'air frais, c'est aussi l'aide de personnes en Belgique et en Pologne qui nous ont prot\u00e9g\u00e9s dans les moments difficiles, gr\u00e2ce auxquelles nous pouvons peindre maintenant, gr\u00e2ce \u00e0 chaque minute.\r\n\r\nUne bouff\u00e9e d'air frais, c'est la libert\u00e9 qui nous entoure en Belgique.  La libert\u00e9 d'autod\u00e9termination pour laquelle l'Ukraine se bat depuis 300 ans est la plus grande joie.  La perdre, c'est comme perdre la possibilit\u00e9 de respirer de l'air frais dans un sous-sol ferm\u00e9 o\u00f9 nous nous cachions des bombardements.\r\n\r\nL'exposition pr\u00e9sentera des peintures, des illustrations, des objets - la plupart cr\u00e9\u00e9s par Alexander et Ir\u00e8ne, lors de leur s\u00e9jour en Belgique.  Dans leurs \u0153uvres, ils r\u00e9fl\u00e9chissent aux th\u00e8mes de la vie qui a radicalement chang\u00e9 pour eux apr\u00e8s le 24 f\u00e9vrier 2022.  Il y aura \u00e9galement une s\u00e9rie de portraits sous le titre g\u00e9n\u00e9ral \"Cassandra\" par Irene Ku et des affiches.\r\n\r\n\u2192 Enfin , sachez que les artistes ont choisi de reverser 30% des b\u00e9n\u00e9fices de la vente des \u0153uvres \u00e0 la fondation Ukrainienne : \u201cCome Back Alive\u201d.","performers":"Ir\u00e8ne Ku (peintre et graphiste),  Alexander Kudriavchenko (peintre)","boxoffice_url":null,"website":"https:\/\/www.montdepiete.be\/expo-bouffee-d-air","email":"info@montdepiete.be","phone_contact":null,"phone_booking":"+32 2 512 13 85","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541584"},"nl":{"name":"Bouff\u00e9e d'air - Ir\u00e8ne Ku & Alexander Kudriavchenko","shortdescr":"Op de tentoonstelling zullen schilderijen, grafisch werk en voorwerpen te zien zijn - de meeste daarvan zijn door Alexander en Irene gemaakt tijdens hun verblijf in Belgi\u00eb.  In hun werken reflecteren zij over de thema's van het leven, die voor hen radicaal veranderden na 24 februari 2022.","longdescr":"De mogelijkheid om kunst te maken is een verademing voor kunstenaars. En dat is altijd zo geweest.\r\n\r\nKunstenaars schilderen zelfs als er oorlog is, zelfs als er lijden is.  Schrijvers en muzikanten zwijgen niet...\r\n\r\nOmdat dat onze manier van spreken is.  Wij cre\u00ebren geen decor, maar spreken de wereld op onze eigen manier aan.  We zeggen dat we niet gebroken zijn, zelfs als we depressief zijn.\r\nEen verademing is ook de hulp van mensen in Belgi\u00eb en Polen die ons in moeilijke tijden hebben beschermd, dankzij wie wij nu kunnen schilderen, dankzij elke minuut.\r\n\r\nEen verademing is de vrijheid die ons in Belgi\u00eb omringt.  De vrijheid van zelfbeschikking waarvoor Oekra\u00efne 300 jaar heeft gevochten, is de grootste vreugde.  Het verliezen ervan is als het verliezen van de mogelijkheid om frisse lucht in te ademen in een gesloten kelder waar we ons schuilhielden voor de bombardementen.\r\n\r\nOp de tentoonstelling zullen schilderijen, grafisch werk en voorwerpen te zien zijn - de meeste daarvan zijn door Alexander en Irene gemaakt tijdens hun verblijf in Belgi\u00eb.  In hun werken reflecteren zij over de thema's van het leven, die voor hen radicaal veranderden na 24 februari 2022.  Er zal ook een reeks portretten onder de algemene titel \"Cassandra\" van Irene Ku en affiches te zien zijn.\r\n\r\n\u2192 Ten slotte hebben de kunstenaars ervoor gekozen 30% van de winst uit de verkoop van hun werken te doneren aan de Oekra\u00efense stichting \"Come Back Alive\": \u201cCome Back Alive\u201d.","performers":"Ir\u00e8ne Ku (schilder),  Alexander Kudriavchenko (schilder)","boxoffice_url":null,"website":"https:\/\/www.bergvanbarmhartigheid.be\/nl\/expo-ademruimte","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541584"},"en":{"name":"Bouff\u00e9e d'air - Ir\u00e8ne Ku & Alexander Kudriavchenko","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541584"},"de":{"name":"Expo \u00ab Bouff\u00e9e d'air \u00bb d'Ir\u00e8ne Ku & Alexander Kudriavchenko","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541584"},"it":{"name":"Expo \u00ab Bouff\u00e9e d'air \u00bb d'Ir\u00e8ne Ku & Alexander Kudriavchenko","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541584"},"sp":{"name":"Expo \u00ab Bouff\u00e9e d'air \u00bb d'Ir\u00e8ne Ku & Alexander Kudriavchenko","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541584"},"pt":{"name":"Expo \u00ab Bouff\u00e9e d'air \u00bb d'Ir\u00e8ne Ku & Alexander Kudriavchenko","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541584"},"cn":{"name":"Expo \u00ab Bouff\u00e9e d'air \u00bb d'Ir\u00e8ne Ku & Alexander Kudriavchenko","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541584"}},"place":{"id":221323,"translations":{"fr":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"address_zip":"1000","address_city":"B