":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003673"},"pt":{"name":"La Litanie des Agonisantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/la-litanie-des-agonisantes\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003673"},"en":{"name":"La Litanie des Agonisantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/la-litanie-des-agonisantes\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003673"},"it":{"name":"La Litanie des Agonisantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/la-litanie-des-agonisantes\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003673"},"cn":{"name":"La Litanie des Agonisantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/la-litanie-des-agonisantes\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003673"},"fr":{"name":"La Litanie des Agonisantes","shortdescr":"Partant des conceptions tristement arch\u00e9typales de la f\u00e9minit\u00e9 et de la violence qui les traversent\ndepuis toujours, Sol\u00e8ne Valentin, Jean-Gabriel Vidal-Vandroy et L\u00e9a Quinsac subvertissent les r\u00e9cits ancr\u00e9s dans nos imaginaires collectifs.\n\nRemplie d\u2019humour, de pirouettes et d\u2019outrance, cette fable d\u00e9brid\u00e9e et r\u00e9paratrice c\u00e9l\u00e8bre la fureur,\nla passion et la libert\u00e9 des femmes.  ","longdescr":"\u00abJ\u2019ai, \nBr\u00fblant sur ma langue,\nDes splendeurs indicibles,\nPauvres agneaux fi\u00e9vreux,\nOui j\u2019ai, sifflant dans mes canines,\nDes merveilles redoutables \u00e0 vous annoncer\u2009! \nAlors, fermez vos gueules abjectes,\nEt ouvrez votre c\u0153ur \u00e0 ma boiteuse proph\u00e9tie\u2009: \nNos anciens dieux vieillissent et meurent,\nD\u2019autres viendront demain,\nil nous reste \u00e0 les inventer.\u2009\u00bb \n\nUn carnaval de stupeurs et de cris d\u2019effroi,\nla dinde la plus photographi\u00e9e du monde,\nun petit chien qui pue et qui s\u2019appelle Framboise,\nun ange d\u00e9compos\u00e9 \u00e0 la t\u00eate d\u2019une meute de loups,\nquelques puces exalt\u00e9es dansant le quadrille\nsur le pelage d\u2019un rat,une armada de fant\u00f4mes\net d\u2019amazones hurlantes, une carm\u00e9lite \u00f4tant\nson voile pour tor\u00e9er les fauves, \nune grande histoire d\u2019amour\u2009:\nC\u2019est le temps des m\u00e9t\u00e9ores!\nLe temps des inversions\u2009!\nEt celui des vengeances\u2009!\nLe grand, universel, et fabuleux carnage\u2009!  \n\nPartant des conceptions tristement arch\u00e9typales de la f\u00e9minit\u00e9 et de la violence qui les traversent\ndepuis toujours, Sol\u00e8ne Valentin, Jean-Gabriel Vidal-Vandroy et L\u00e9a Quinsac subvertissent les r\u00e9cits ancr\u00e9s dans nos imaginaires collectifs.\n\nRemplie d\u2019humour, de pirouettes et d\u2019outrance, cette fable d\u00e9brid\u00e9e et r\u00e9paratrice c\u00e9l\u00e8bre la fureur, la passion et la libert\u00e9 des femmes.  ","performers":"Conception : Sol\u00e8ne Valentin, L\u00e9a Quinsac \/ Mise en sc\u00e8ne et cr\u00e9ation costumes : Sol\u00e8ne Valentin \/ \u00c9criture : Jean-Gabriel Vidal-Vandroy et \u00e9criture collective \/ Accompagnement de cr\u00e9ation et photographies","boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/la-litanie-des-agonisantes\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003673"},"sp":{"name":"La Litanie des Agonisantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/la-litanie-des-agonisantes\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003673"},"nl":{"name":"La Litanie des Agonisantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/la-litanie-des-agonisantes\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003673"}},"place":{"id":10413,"translations":{"de":{"name":"Th\u00e9\u00e2tre de la Vie","address_street_name":"Rue Traversi\u00e8re","address_street_number":"45","address_street_box":null,"email":"reservations@theatredelavie.be","website":"http:\/\/www.theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 60 06","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Traversi\u00e8re, 45","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre de la Vie","address_street_name":"Rue Traversi\u00e8re","address_street_number":"45","address_street_box":null