age d'artistes \u00e0 Ixelles","copyright":null}}}],"dates":[{"day":"2022-09-22","doors":null,"start":"18:00:00","end":"19:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-10T21:35:08+02:00","published_at":"2022-04-03T03:30:28+02:00","backoffice_id":250802,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":538084,"date_start":"2022-09-22","date_end":"2022-09-23","date_next":"2022-09-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Gwerz","shortdescr":"Entre danse, drag show, th\u00e9\u00e2tre et cr\u00e9ation vid\u00e9o, Gwerz se fait l\u2019\u00e9cho de la fin de vie de Marilyn Monroe. Un chant du cygne qui interroge la starification des femmes et son impact sur leur vie.","longdescr":"Dans la tradition orale bretonne se transmettent les gwerzio\u00f9, des r\u00e9cits chant\u00e9s racontant souvent des histoires tragiques. Ils se d\u00e9placent d'un territoire \u00e0 l'autre, d'une voix \u00e0 l'autre, se transformant au gr\u00e9 des interpr\u00e8tes qui se les approprient. Sur ce th\u00e8me, Gwendal Raymond et Gilles Jacinto diffractent la prestation inoubliable de Marilyn Monroe pour l'anniversaire de JFK au miroir bris\u00e9 d'influences diverses et d'un imaginaire foisonnant. M\u00ealant les gwerzio\u00f9 \u00e0 l\u2019esth\u00e9tique drag et la beaut\u00e9 du travestissement, superposant chair, ombre, voix d'outre-tombe et play-back, le solo Gwerz r\u00e9interpr\u00e8te un r\u00e9cit moderne d'amour, de mort et de fatalit\u00e9. En jouant du pouvoir transfigurateur - et parfois destructeur - de l'image, le jeune danseur compose avec celui, myst\u00e9rieux, de l'incarnation.\r\n\r\nDistribution : DE Gwendal Raymond & Gilles Jacinto \u00b7 INTERPR\u00c9TATION Gwendal Raymond\r\n\r\nTh\u00e9matique : Corps - Queer \r\nParcours : R\u00eaver - Contester","performers":"Gwendal Raymond et Gilles Jacinto","boxoffice_url":null,"website":"https:\/\/www.famefestival.be","email":"ticket@famefestival.be","phone_contact":null,"phone_booking":"+32 474 30 96 81","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538084"},"nl":{"name":"Gwerz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538084"},"en":{"name":"Gwerz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538084"},"de":{"name":"Gwerz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538084"},"it":{"name":"Gwerz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https: