t":"2022-03-03T09:29:43+01:00","backoffice_id":248878,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.14971359717807},{"id":533082,"date_start":"2022-06-30","date_end":"2022-07-03","date_next":"2022-06-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[160,82],"translations":{"fr":["Manifestation sportive","Omnisports et autres"],"nl":["Sportmanifestatie","Omnisport en andere"],"en":["Sporting event","General sports and others"]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"Urban Sessions","shortdescr":"Le plus grand festival de sports d'action en Belgique","longdescr":"Coupe du monde de BMX Freestyle, sports d\u2019action, initiations, musique, street art et food trucks, que demander de mieux pour commencer l\u2019\u00e9t\u00e9 en beaut\u00e9 ! Venez assister entre amis ou en famille \u00e0 ce grand festival gratuit au coeur de Bruxelles.\r\n4 jours de festival dans le parc Josaphat pendant lesquels vous pourrez c\u00f4toyer les meilleurs athl\u00e8tes des diff\u00e9rentes disciplines et assister \u00e0 des exploits \u00e0 couper le souffle !\r\n\r\nPlus d\u2019infos : https:\/\/urbansessions.be\/\r\nR\u00e9servation obligatoire","performers":null,"boxoffice_url":null,"website":"https:\/\/urbansessions.be\/","email":"communication@urbansessions.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533082.html"},"nl":{"name":"Urban Sessions","shortdescr":"Het grootste Belgische actiesportfestival","longdescr":"Geen betere manier om de zomer in te zetten dan met actiesport, initiaties, muziek, streetart en foodtrucks\u2026 Ontdek het beste van wat urban culture te bieden heeft via een divers en verrassend programma. De BMX Freestyle World Cup is zeker een van de hoogtepunten van het evenement, maar daarnaast tonen ook andere topatleten in  BMX, parkour en skate hun kunsten tijdens allerlei wedstrijden, initiaties en demonstraties. Verder kun je er ook streetartists ontdekken die hun kunsten delen met het publiek. En dat allemaal gratis, in Josaphat Park!\r\n\r\nMeer info vind je op: https:\/\/urbansessions.be\/\r\nReservering vereist","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533082.html"},"en":{"name":"Urban Sessions","shortdescr":"The biggest action sports festival in Belgium","longdescr":"Extreme sports and world-class athletes competing for the BMX Freestyle World Cup, demonstrations, initiations, street art, music, and food trucks will kick off your summer in the right way!\r\nThis thrilling four-day urban festival will offer the best the urban scene has to offer for everyone to enjoy for free! \r\n\r\n\r\nMore info: https:\/\/urbansessions.be\/\r\nReservation is required","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533082.html"},"de":{"name":"Urban Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533082.html"},"it":{"name":"Urban Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533082.html"},"sp":{"name":"Urban Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533082.html"},"pt":{"name":"Urban Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533082.html"},"cn":{"name":"Urban Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533082.html"}},"place":{"id":236207,"translations":{"fr":{"name":"Parc Josaphat","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/theparkto.be","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Parc Josaphat","address_line2":"1030 Schaerbeek","description_web":"Le parc Josaphat est le poumon vert de Schaerbeek et le parc pr\u00e9f\u00e9r\u00e9 des Bruxellois. Selon la l\u00e9gende, un Bruxellois de retour de Terre Sainte, au XVIe si\u00e8cle, aurait \u00e9t\u00e9 frapp\u00e9 par la ressemblance entre la vall\u00e9e de Josaphat pr\u00e8s de J\u00e9rusalem et ce parc, qui aurait pris ce nom biblique.\r\n\r\nDe nombreuses activit\u00e9s y sont organis\u00e9es\u00a0: concerts, promenades nature, visites-d\u00e9couvertes\u2026 Lors de votre promenade, admirez des bustes d\u2019\u00e9crivains et d\u2019artistes et des sculptures inspir\u00e9es de la mythologie ou des contes. D\u00e9couvrez la fontaine d\u2019amour ou le pavillon Trinkhall, ancien ch\u00e2teau et laiterie-caf\u00e9-restaurant-h\u00f4tel.\r\n\r\nNon loin du parc, la Maison Autrique, ancien h\u00f4tel particulier d\u2019Eug\u00e8ne Autrique con\u00e7u dans le style Art Nouveau par Victor Horta au XIXe si\u00e8cle, et aujourd\u2019hui mus\u00e9e.\r\n\r\nPour une pause gourmande, rendez-vous au Boentje Caf\u00e9, un coffee house z\u00e9ro d\u00e9chet qui vous pr\u00e9pare des plats et des desserts faits maison avec des produits locaux et de saison. \u00c0 deux pas se trouve le Bar de la Mule, o\u00f9 savourer des bi\u00e8res allemandes typ\u00e9es et bio, fabriqu\u00e9es par la brasserie de la Mule.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Josaphatpark","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/theparkto.be","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Josaphatpark","address_line2":"1030 Schaarbeek","description_web":"Het Josaphatpark is de groene long van Schaarbeek. Het is het favoriete park van de Brusselaars. Volgens de legende merkte een Brusselaar die ergens in de 16e eeuw terugkeerde uit het Heilige Land, dat de plek wel erg veel weg had van de Josafatvallei bij Jeruzalem. Vandaar de bijbelse naam van het park.\r\n\r\nJe kan hier bijzonder veel doen. Vaak zijn er concerten, speciale wandelingen of ontdekkingstochten. Er staan heel wat beelden in het park. Niet alleen van schrijvers en kunstenaars maar ook beelden die verwijzen naar de mythologie. Je vindt er zelfs een liefdesfontein. In het park zijn ook enkele paviljoentjes waar je iets kan eten of drinken.\r\n\r\nNiet ver van het park ligt het Autriquehuis. Dat is het voormalige herenhuis van Eug\u00e8ne Autrique, ontworpen door Victor Horta. Nu is deze 19e-eeuwse art-nouveauparel een museum.\r\n\r\nHeb je al honger? Spring dan eens binnen bij Boentje, een zero-wastecaf\u00e9. Alles is er huisgemaakt en bereid met lokale en seizoensgebonden producten. Iets verderop vind je de Bar de la Mule, waar je kan genieten van het plaatselijk bier.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Josaphat Park","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/theparkto.be","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Josaphat Park","address_line2":"1030 Schaerbeek","description_web":"Josaphat Park is Schaerbeek's green lung and a favourite among the inhabitants of Brussels. According to legend, in the 16th century, a Brussels resident returning from the Holy Land was struck by the park's resemblance to the Valley of Jehoshaphat near Jerusalem, which gave the Park its biblical name.\r\n\r\nMany activities are organised here: concerts, nature walks, discovery tours, etc. During your walk, admire busts of writers and artists and sculptures inspired by mythology or fairy tales. Discover the Love Fountain or the Trinkhall pavilion, a former castle and hotel-caf\u00e9-restaurant.\r\n\r\nA stone\u2019s throw from the park you\u2019ll find Autrique House, the former private residence of Eug\u00e8ne Autrique, which was built in the Art Nouveau style by Victor Horta in the 19th century and is now a museum.\r\n\r\nFor a sweet break, head to Boentje Caf\u00e9, a zero-waste coffee house that prepares homemade dishes and desserts using local and seasonal products. Close by is Bar de la Mule, where you can enjoy typical German and organic beers made by Brasserie de la Mule.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Parc Josaphat","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/theparkto.be","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Parc Josaphat","address_line2":"1030 Schaerbeek","description_web":"Der Parc Josaphat ist die gr\u00fcne Lunge von Schaerbeek und einer der beliebtesten Br\u00fcsseler Parks. Dabei teilt er sich in drei Partien \u2013 den historischen Park, die gro\u00dfen Rasenfl\u00e4chen und den Spielplatzbereich. Seinen biblischen Namen verdankt der Park der Legende nach einem Reisenden, der im 16. Jahrhundert eine verbl\u00fcffende \u00c4hnlichkeit mit dem Tal von Josaphat in der N\u00e4he von Jerusalem festzustellen vermeinte.\r\n\r\nHier werden zahlreiche Aktivit\u00e4ten organisiert: Konzerte, Naturwanderungen, Entdeckungstouren... Bewundern Sie auf Ihrem Spaziergang B\u00fcsten von Schriftstellern und K\u00fcnstlern sowie Skulpturen, die von der Mythologie oder von M\u00e4rchen inspiriert sind. Entdecken Sie den Liebesbrunnen und verschiedene Park-Caf\u00e9s, die kleine Speisen und Getr\u00e4nke anbieten.\r\n\r\nNicht weit vom Park entfernt befindet sich das Maison Autrique, das ehemalige Jugendstil-Herrenhaus von Eug\u00e8ne Autrique, das im 19. Jahrhundert von Victor Horta entworfen wurde und heute als Museum dient.\r\n\r\nF\u00fcr eine Kaffeepause in der N\u00e4he des Parks bietet sich das Boentje Caf\u00e9 mit seiner Zero-Waste-Philosophie an, das hausgemachte Gerichte und Desserts aus lokalen und saisonalen Produkten serviert. Nur wenige Schritte entfernt befindet sich die Bar de la Mul, wo Sie lokale Bio-Biere genie\u00dfen k\u00f6nnen, die in der Brasserie de la Mule gebraut werden.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc Josaphat","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/theparkto.be","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Parc Josaphat","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Parque Josaphat","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/theparkto.be","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Parque Josaphat","address_line2":"1030 Schaerbeek","description_web":"Este parque de 20 hect\u00e1reas es conocido como el pulm\u00f3n verde de Schaerbeek y es un lugar para relajarse impregnado de historia y cultura. Est\u00e1 organizado en tres secciones: el parque hist\u00f3rico, los grandes jardines y la zona de parques.\r\n\r\nUn lugar alabado por escritores y artistas, un refugio para bot\u00e1nicos y ornit\u00f3logos, el parque tambi\u00e9n posee una colecci\u00f3n de esculturas, as\u00ed como \u00e1reas reservadas para actividades deportivas y j\u00f3venes. En julio y agosto se organizan conciertos gratuitos.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Parc Josaphat","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/theparkto.be","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Parc Josaphat","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Parc Josaphat","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/theparkto.be","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Parc Josaphat","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":null,"facebook_id":null,"backoffice_id":1509,"location":{"lat":50.86206632,"lon":4.38636156},"region":"brussels","last_updated_at":"2022-05-30T16:35:04+02:00","published_at":"2013-10-19T01:14:24+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":278457,"translations":{"fr":{"name":"Urban Sessions","address_street_name"