ussels.imgix.net\/113b577c8ecb44366c68f0b5703a882adc80abca.jpg","width":1000,"height":667,"ratio":1.5,"translations":{"fr":{"title":"Y'a de la place pour tout le monde ","copyright":null},"nl":{"title":"Y'a de la place pour tout le monde ","copyright":null},"en":{"title":"Y'a de la place pour tout le monde ","copyright":null}}}],"dates":[{"day":"2022-10-22","doors":null,"start":"15:00:00","end":"15:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":6},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":8},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-12T15:35:10+02:00","published_at":"2022-10-12T15:20:29+02:00","backoffice_id":263978,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":541061,"date_start":"2022-10-22","date_end":"2022-10-22","date_next":"2022-10-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Hommage \u00e0 Mamady Ke\u00efta","shortdescr":"La famille rend gloire au maitre du djemb\u00e9","longdescr":"Il y a un peu plus d\u2019un an s\u2019\u00e9teignait \u00e0 Bruxelles Mamady Ke\u00efta, l\u00e9gende du djemb\u00e9 et ambassadeur international de la culture et des rythmes mandingues. Ses enfants et sa famille organisent en son hommage un \u00e9v\u00e9nement rassemblant de nombreux artistes qui ont partag\u00e9 son chemin et son message. Parmi eux, nous pourrons compter sur la pr\u00e9sence de plusieurs membres de Sewa Kan, de Kobe Na Wati et de nombreux autres artistes qui ont travaill\u00e9 avec le Ma\u00eetre de Djembefola. En premi\u00e8re partie de soir\u00e9e, nous visionnerons le film \u2018Djembefola\u2019 de Laurent Chevalier. Ensuite ses amis et familles feront perdurer son talent en mettant \u00e0 l\u2019honneur les danses et rythmes Mandingues.\r\n\r\nN\u00e9 en 1950 \u00e0 Balandugu (Guin\u00e9e), Mamady Ke\u00efta a \u00e9t\u00e9 initi\u00e9 tr\u00e8s jeune par Karinkadjan Kond\u00e9 dans son village natal. \u00c0 14 ans, il est s\u00e9lectionn\u00e9 pour int\u00e9grer le Djoliba National Ballet de Guin\u00e9e en tant que premier soliste de djembefola et \u00e0 partir de 1979, il devient le directeur artistique du groupe jusqu\u2019en 1986. Plus tard, il int\u00e8gre \u00e9galement le Ballet Koteba d\u2019Abidjan (C\u00f4te d\u2019Ivoire). Ces deux exp\u00e9riences l\u2019am\u00e8nent \u00e0 faire de nombreuses tourn\u00e9es panafricaines et europ\u00e9ennes.\r\n\r\nEn 1988, il s\u2019installe en Belgique et enseigne le djemb\u00e9 et les rythmes mandingues \u00e0 l\u2019\u00e9cole R\u00e9percussions, avant de fonder un peu plus tard sa propre \u00e9cole \u00ab Tam Tam Mandingue \u00bb, dont il ouvre ensuite plusieurs antennes \u00e0 travers le monde. Parall\u00e8lement, il fonde le groupe Sewa Kan, qui signifie \u00ab le son de la joie \u00bb, joie qu\u2019il diffuse sur toutes les sc\u00e8nes d\u2019Europe, du Japon et du monde entier des ann\u00e9es durant.\r\n\r\n17h00 : ouverture & accueil en musique\r\n18h00 : Film Djembefola en pr\u00e9sence du r\u00e9alisateur Laurent Chevalier\r\n20h00 : Concerts\r\n23h00 : Jam Session au Bar\/Foyer\r\nDes en-cas seront vendus au foyer de 19h \u00e0 22h.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541061"},"nl":{"name":"Hommage aan Mamady Ke\u00efta","shortdescr":"Eerbetoon van de familie aan de djembe-master","longdescr":"Iets meer dan een jaar geleden overleed Mamady Ke\u00efta, djemb\u00e9-legende en internationaal ambassadeur van de Mandinka-cultuur en -ritmes in Brussel. Zijn kinderen en zijn familie organiseren dit hommage concert met talloze artiesten die zijn pad hebben gekruist zijn reis en zijn boodschap doen verder leven, onder hen verschillende leden van Sewa Kan, Kobe Na Wati en vele andere artiesten die hebben gewerkt met de meester van de djembefola. We openen de avond met de film \u2018Djembefola\u2019 van Laurent Chevalier om ons daarna te laten onderdompelen in de Mandinka-dansen en -ritmes.\r\n\r\nMamady Ke\u00efta, geboren in 1950 in Balandugu (Guinee), werd op zeer jonge leeftijd ingewijd door Karinkadjan Kond\u00e9 in zijn geboortedorp. Op 14-jarige leeftijd werd hij geselecteerd om als eerste djembefola-solist bij het Djoliba National Ballet of Guinee te komen werken, waarvan hij vanaf 1979 tot 1986 de artistieke leider was. Later trad hij toe tot het Ballet Koteba d \u2018Abidjan, Ivoorkust. Dankzij beide groepen kan hij tal toernees door Afrika en Europa maken. In \u201888 verhuisde hij naar Belgi\u00eb en doceerde djembe en mandinka-ritmes aan de R\u00e9percussions-school, om even later zijn eigen school \u201cTam Tam Mandingue\u201d op te richten met later verschillende vestingen over de hele wereld. Tegelijkertijd richtte hij de groep Sewa Kan op, wat \u201chet geluid van vreugde\u201d betekent, vreugde die hij jarenlang op alle podia van Europa, Japan en de hele wereld zou verspreiden.\r\n\r\n17h00 : opening deuren en ontvangst met muziek\r\n18h00 : Film Djembefola in aanwezigheid van de regisseur Laurent Chevalier\r\n20h00 : Optredens\r\n23h00 : Jam Sessie in de foyer\r\n \r\n\r\nTussen 19u en 22u worden hapjes verkocht in de foyer.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541061"},"en":{"name":"Tribute to Mamady Ke\u00efta","shortdescr":"The family gives glory to the master of the djembe","longdescr":"A little over one year ago, Mamady Ke\u00efta, legend of the djembe and international ambassador of Mandinka culture and rhythms, passed away in Brussels. His family and children are organizing an event as a tribute to his work, bringing together many artists who have shared his journey and his message. Among them, we can count on the presence of several members of Sewa Kan, Kobe Na Wati and many other artists who have worked with the Master of Djembefola. In the first part of the evening, the film \u2018Djembefola\u2019 will be screened in the presence of director Laurent Chevalier. Then his family and friends will perpetuate his talent by showcasing Mandingo dances and rhythms.\r\n\r\nBorn in 1950 in Balandugu (Guinea), Mamady Ke\u00efta was introduced to Mandinka music at a very young age by Karinkadjan Kond\u00e9 in his native village. At 14, he was selected to join the Djoliba National Ballet of Guinea as the first soloist of djembefola and from 1979, he became the artistic director of the group until 1986. Later, he also joined the Ballet Koteba d \u2018Abidjan (Ivory Coast). These two experiences lead him to make numerous pan-African and European tours.\r\n\r\nIn 1988, he moved to Belgium and taught djembe and Mandinka rhythms at the R\u00e9percussions school, before founding his own school \u201cTam Tam Mandingue\u201d a little later, of which he then opened several branches around the world. At the same time, he founded the group Sewa Kan, which means \u201cthe sound of joy\u201d, joy which he spread on numerous stages throughout Europe, in Japan and around the world for years.\r\n\r\n5:00 p.m.: Opening and musical welcome\r\n6 p.m.: Film Djembefola in the presence of director Laurent Chevalier\r\n8:00 p.m.: Concerts\r\n11:00 p.m.: Jam Session at the Bar\/Foyer\r\nSnacks will be sold at the foyer from 7 p.m. to 10 p.m.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541061"},"de":{"name":"Hommage \u00e0 Mamady Ke\u00efta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541061"},"it":{"name":"Hommage \u00e0 Mamady Ke\u00efta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541061"},"sp":{"name":"Hommage \u00e0 Mamady Ke\u00efta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541061"},"pt":{"name":"Hommage \u00e0 Mamady Ke\u00efta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541061"},"cn":{"name":"Hommage \u00e0 Mamady Ke\u00efta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541061"}},"place":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique, keeps music and dance traditions alive and kicking in Brussels through an ambitious programme of concerts, courses, and projects. A year-round concert programme, featuring Belgian and international artists, forms the core of the foundation\u2019s activities. From the contemplative to the madly festive concerts take place indoors,  in the small Moli\u00e8re Theatre, in the arcade at the Porte de Namur and outdoors, around the city and throughout the year.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Muziekpublique","address_street_