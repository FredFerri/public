alse,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-06T17:22:02+01:00","published_at":"2024-12-03T14:43:05+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312826,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[3],"translations":{"de":["Zeitgen\u00f6ssische Musik"],"pt":[null],"en":["Contemporary music"],"it":["Musica contemporanea"],"cn":[null],"fr":["Musique Contemporaine"],"sp":["M\u00fasica contempor\u00e1nea"],"nl":["Hedendaagse Muziek"]}}},"translations":{"de":{"name":"SAKAMOTO concert evening by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.eu\/fr\/agenda\/l-agenda-culturel\/escapades-ryuichi-sakamoto","email":"crit.escapade@gmail.com","phone_contact":"02 25 37 96 69","phone_booking":"02 23 15 35 79","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004108"},"pt":{"name":"SAKAMOTO concert evening by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.eu\/fr\/agenda\/l-agenda-culturel\/escapades-ryuichi-sakamoto","email":"crit.escapade@gmail.com","phone_contact":"02 25 37 96 69","phone_booking":"02 23 15 35 79","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004108"},"en":{"name":"RYUICHI SAKAMOTO concert evening by Concerts Escapades","shortdescr":"Renowned Japanese composer Ryuichi Sakamoto, known for film scores like Merry Christmas, Mr. Lawrence and The Last Emperor, headlines our final 2024 concert! Experience a unique journey through his contemporary classical music, drawing inspiration from Debussy, The Rolling Stones, Brussels' iconic TELEX, and his work with the band Y.M.O. (Yellow Magic Orchestra).\n","longdescr":"RYUICHI SAKAMOTO Concert Evening - December 15, 2024, from 5:30 PM\nRenowned Japanese composer Ryuichi Sakamoto, celebrated for his iconic film scores such as Merry Christmas, Mr. Lawrence and The Last Emperor, will take center stage in our final concert of 2024!\nA Unique Musical Journey\nExperience the contemporary classical music of Ryuichi Sakamoto, whose inspirations span an eclectic range\u2014from Debussy to the Rolling Stones, from the pioneering Brussels electronic group TELEX to his own involvement in Yellow Magic Orchestra (Y.M.O.).\n-\nProgram Highlights:\nAmor\nMerry Christmas, Mr. Lawrence\nSheltering Sky\nBolerish\nHappy End\nAqua\nExcerpts from \"12\", Ryuichi Sakamoto's final album, recorded before his passing.\n-\nEvening Schedule:\n5:30 PM: Pre-concert ambiance at the bar\n Immerse yourself in the techno\/pop universe of Yellow Magic Orchestra with a curated selection of 1970 & 80s CD classics.\n-\n6:00 PM: Concert in the \"Boudoir\" Hall\nFeaturing outstanding performers:\nYu-Fen Chang (piano)\nJean-Philippe Collard-Neven (piano & electronics)\nAlex Tambu (piano)\n-\n7:15 PM: Post-concert electro-pop at the bar\n Enjoy a live performance by the band Alek et les Japonaises, and perhaps be tempted to join the dance floor. \n-\nA surprise (Marika Suzuki?) might await you\u2014but shh, it\u2019s a secret!\nA night that promises to be truly unforgettable!\n-\nLocation: \"Boudoir\" Hall, La Tricoterie\nBar-restaurant open until 10 PM: Start and end your evening in the warm ambiance of La Tricoterie\u2019s bar-restaurant.\nDate & Time: Sunday, December 15, at 6 PM\nTicket Prices: \u20ac19 | \u20ac12 | Art. 27 - Last-minute tickets available on Visit.brussels.\nReserve your spot now for this extraordinary tribute to a master of contemporary music!\n","performers":"Yu-Fen Chang, (piano); Jean-Philippe Collard-Neven, (piano and electronics) and Alex Tambu, (piano).\nThe band Alek and Les Japonaises. Dancer Marika Suzuki. ","boxoffice_url":null,"website":"https:\/\/www.tricoterie.eu\/fr\/agenda\/l-agenda-culturel\/escapades-ryuichi-sakamoto","email":"crit.escapade@gmail.com","phone_contact":"02 25 37 96 69","phone_booking":"02 23 15 35 79","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004108"},"it":{"name":"SAKAMOTO concert evening by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.eu\/fr\/agenda\/l-agenda-culturel\/escapades-ryuichi-sakamoto","email":"crit.escapade@gmail.com","phone_contact":"02 25 37 96 69","phone_booking":"02 23 15 35 79","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004108"},"cn":{"name":"SAKAMOTO concert evening by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.eu\/fr\/agenda\/l-agenda-culturel\/escapades-ryuichi-sakamoto","email":"crit.escapade@gmail.com","phone_contact":"02 25 37 96 69","phone_booking":"02 23 15 35 79","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004108"},"fr":{"name":"RYUICHI SAKAMOTO soir\u00e9e concert  par Concerts Escapades","shortdescr":"Le c\u00e9l\u00e8bre compositeur japonais Ryuichi Sakamoto, connu pour ses musiques de films comme Furyo et Le Dernier Empereur, est \u00e0 l'honneur de notre dernier concert de 2024 ! Au programme : un voyage musical unique \u00e0 travers sa musique classique contemporaine, influenc\u00e9e par Debussy, les Rolling Stones, le groupe bruxellois TELEX et son travail avec le groupe Y.M.O. (Yellow Magic Orchestra).","longdescr":"Soir\u00e9e concert RYUICHI SAKAMOTO - Le 15 d\u00e9cembre 2024 d\u00e8s 17h30\n\nC\u00e9l\u00e9brissime compositeur japonais, connu notamment pour ses musiques de films comme Furyo ou Le Dernier Empereur, RYUICHI SAKAMOTO sera au menu de notre dernier concert de l\u2019ann\u00e9e 2024 !\n\nUn voyage musical unique : la musique classique contemporaine de M. SAKAMOTO, dont les inspirations sont multiples \u2013 de Debussy aux Rolling Stones, en passant par la musique \u00e9lectronique de TELEX, groupe pionnier bruxellois, et sa propre implication au sein du goupe Y.M.O. (Yellow Magic Orchestra).\n-\nLes titres propos\u00e9s tout au long du concert incluent : \nAmor\nMerry Christmas, Mr. Lawrence\nSheltering Sky\nBolerish\nHappy End\nAqua\nExtraits de \"12\", l'ultime album de Ryuichi Sakamoto, enregistr\u00e9 avant sa disparition. \n-\nD\u00e9roul\u00e9 de la soir\u00e9e :\n17h30 : Ambiance pr\u00e9-concert au bar\nl'univers techno\/pop de Yellow Magic Orchestra \u00e0 travers une s\u00e9lection de musique qui vous plongeront dans les ann\u00e9es 70 et 80.\n18h00 : Concert dans la salle \"Boudoir\"\nAvec des interpr\u00e8tes exceptionnels :\nYu-Fen Chang (piano)\nJean-Philippe Collard-Neven (piano & \u00e9lectronique)\nAlex Tambu (piano)\n19h15 : After-concert \u00e9lectro-pop au bar\nLaissez-vous entra\u00eener par un live exclusif du groupe Alek et les Japonaises.\n-\nUne surprise pourrait bien vous inciter \u00e0 quelques pas de danse, aussi, mais \u2026 on ne vous a rien dit ( Marika Suzuki ?) !!! \nLa soir\u00e9e promet d\u2019\u00eatre unique !\n-\nLieu :  Salle \u00abBoudoir\u00bb de La Tricoterie.... Et comme toujours :\nBar-restaurant ouvert jusqu\u2019\u00e0 22h : La soir\u00e9e commence et se poursuit au bar-restaurant de La Tricoterie.\nDate & Heure : Dimanche 15\/12 \u00e0 18h \u2014 Tarif : 19\u20ac I 12\u20ac I Art. 27 - Last-minute tickets sur Visit.brussels. \nR\u00e9servez d\u00e8s maintenant pour cette soir\u00e9e unique d\u00e9di\u00e9e \u00e0 un ma\u00eetre de la musique contemporaine !\n","performers":"Yu-Fen Chang, (piano) ; Jean-Philippe Collard-Neven, (piano et \u00e9lectronique) et Alex Tambu, (piano.\nLe groupe Alek et Les Japonaises. La danseuse Marika Suzuki. ","boxoffice_url":null,"website":"https:\/\/www.tricoterie.eu\/fr\/agenda\/l-agenda-culturel\/escapades-ryuichi-sakamoto","email":"crit.escapade@gmail.com","phone_contact":"02 25 37 96 69","phone_booking":"02 23 15 35 79","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004108"},"sp":{"name":"SAKAMOTO concert evening by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.eu\/fr\/agenda\/l-agenda-culturel\/escapades-ryuichi-sakamoto","email":"crit.escapade@gmail.com","phone_contact":"02 25 37 96 69","phone_booking":"02 23 15 35 79","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004108"},"nl":{"name":"RYUICHI SAKAMOTO concertavond door Concerts Escapades","shortdescr":"De beroemde Japanse componist Ryuichi Sakamoto, bekend van iconische filmmuziek zoals \"Merry Christmas\", \"Mr. Lawrence\" en \"The Last Emperor\", staat centraal in ons laatste concert van 2024! Geniet van een unieke muzikale reis door zijn eigentijdse klassieke muziek, ge\u00efnspireerd door Debussy, The Rolling Stones, de Brusselse groep TELEX en zijn werk met Y.M.O. (Yellow Magic Orchestra) .","longdescr":"RYUICHI SAKAMOTO Concertavond - 15 december 2024 vanaf 17:30\n-\nDe beroemde Japanse componist Ryuichi Sakamoto, geroemd om zijn iconische filmmuziek zoals Merry Christmas, Mr. Lawrence en The Last Emperor, staat centraal in ons laatste concert van 2024!\nEen unieke muzikale reis\nBeleef de eigentijdse klassieke muziek van Ryuichi Sakamoto, met invloeden die vari\u00ebren van Debussy tot de Rolling Stones, van de baanbrekende Brusselse elektronische groep TELEX en zijn eigen be\u00efnvloedend met Yellow Magic Orchestra (Y.M.O.).\n-\nHoogtepunten van het programma:\nAmor\nMerry Christmas, Mr. Lawrence\nSheltering Sky\nBolerish\nHappy End\nAqua\nFragmenten uit \"12\", het laatste album van Ryuichi Sakamoto,  vlak voor zijn overlijden.\n-\nProgramma van de avond:\n17:30: Pre-concert sfeer aan de bar\nDompel je onder in het techno\/pop-universum van Yellow Magic Orchestra met een selectie van hun iconische werk uit de jaren 70 en 80.\n18:00: Concert in de zaal \"Boudoir\"\nMet uitzonderlijke uitvoerders:\nYu-Fen Chang (piano)\nJean-Philippe Collard-Neven (piano & elektronica)\nAlex Tambu (piano)\n19:15: After-concert electro-pop aan de bar\nGeniet van een liveoptreden van Alek et les Japonaises, en misschien nodigt de sfeer je uit om een dansje te wagen. \n-\nEen verrassing (Marika Suzuki?) kan op je wachten\u2014maar psst, we hebben niets gezegd!\nEen avond die belooft onvergetelijk te worden!\n-\nLocatie: Zaal \"Boudoir\", La Tricoterie\nBar-restaurant open tot 22:00: Begin en sluit je avond af in de gezellige sfeer van het bar-restaurant van La Tricoterie.\nDatum & tijd: Zondag 15 december om 18:00\nTickets: \u20ac19 | \u20ac12 | Art. 27 - Last-minute tickets beschikbaar op Visit.brussels.\nReserveer nu je plek voor dit buitengewone eerbetoon aan een meester van de hedendaagse muziek!\n\n","performers":"Yu-Fen Chang, (piano); Jean-Philippe Collard-Neven, (piano en elektronica) en Alex Tambu, (piano).\nDe band Alek en Les Japonaises. Danseres Marika Suzuki. ","boxoffice_url":null,"website":"https:\/\/www.tricoterie.eu\/fr\/agenda\/l-agenda-culturel\/escapades-ryuichi-sakamoto","email":"crit.escapade@gmail.com","phone_contact":"02 25 37 96 69","phone_booking":"02 23 15 35 79","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004108"}},"place":{"id":252101,"translations":{"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie est un projet culturel fond\u00e9 en 2010 par une poign\u00e9e de citoyen\u00b7nes et situ\u00e9 dans une ancienne usine restaur\u00e9e avec des mat\u00e9riaux \u00e9cologiques. La Tricoterie propose une programmation culturelle tr\u00e8s diversifi\u00e9e et centr\u00e9e sur la rencontre entre les diff\u00e9rents publics et le m\u00e9lange des activit\u00e9s culturelles.\r\n\r\nPassez la porte et d\u00e9couvrez :\r\n- Des spectacles de th\u00e9\u00e2tre, de danse, de cirque...\r\n- Des concerts, des soir\u00e9es, des sc\u00e8nes ouvertes, des jam sessions, une chorale d'un soir...\r\n- Des ateliers z\u00e9ro d\u00e9chet, peinture, c\u00e9ramique, \u0153nologie, danse...\r\n- Des projections de films, conf\u00e9rences, d\u00e9bats...\r\n- Des couscous \"s\u00e9pharabes\", des soir\u00e9es jeux de soci\u00e9t\u00e9, des activit\u00e9s pour enfants...\r\n- Des march\u00e9s des cr\u00e9ateur\u00b7rices, des vide-dressings, des march\u00e9s de No\u00ebl durables...\r\n\r\nUn petit creux ? La Triciterie vous propose un brunch tous les dimanches et un concept \"live cooking\" tous les vendredis soirs. Tous les plats sont 100% artisanaux, et pr\u00e9par\u00e9s sur place par l'\u00e9quipe avec des ingr\u00e9dients bio, locaux et de saison.\r\n\r\nEnvie d'organiser votre \u00e9v\u00e9nement chez vous ? La Tricoterie met ses salles \u00e0 disposition pour tout type d'\u00e9v\u00e9nement priv\u00e9 ou professionnel et propose \u00e9galement un service traiteur, que ce soit dans ses murs ou \u00e0 l'ext\u00e9rieur. Rendez-vous sur www.tricoterie.be pour en savoir plus !\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl":["Sint-Gillis centrum"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":14176,"location":{"lat":50.83028735,"lon":4.33675871},"region":"brussels","last_updated_at":"2024-05-15T13:04:23+02:00","published_at":"2013-10-19T01:47:56+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276119,"translations":{"de":{"name":"Music Projects for Brussels","address_street_name":"Rue Albert Vanderkinderestraat","address_street_number":"24","address_street_box":null,"email":"info@mpfb.org","website":"www.mpfb.org","phon