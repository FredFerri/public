ist":[4,5,19,16,11,7,8,10],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Enseignants","Ecoles","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","Seniors"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Leerkrachten","Scholen","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","Senioren"],"en":["Children 6-9 yr.","Children 9-12 yr.","Teachers","Schools","Family","Youth 12-15  yr.","Youth 15-18  yr.","Seniors"]}},"educational_targets":{"list":[2,3,4,5,6,7,8,9],"translations":{"fr":["Primaire","Secondaire","6 - 8 ans","8 - 10 ans","10 - 12 ans","12 - 14 ans","14 - 16 ans","16 - 18 ans"],"nl":["Lagere school","Secundair onderwijs","6 - 8 jaar","8 - 10 jaar","10 - 12 jaar","12 - 14 jaar","14 - 16 jaar","16 - 18 jaar"],"en":["Primary school","Secondary school","6 - 8 years","8 - 10 years","10 - 12 years","12 - 14 years","14 - 16 years","16 - 18 years"]}},"tags":["kids"],"accessibilities":{"list":[252,257,258,259,263],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Am\u00e9nagements pour personnes sourdes et malentendantes","Appareils d'amplification du son","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor dove en slechthorende personen","Geluidsversterkende apparatuur","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to people with intellectual disabilities","Facilities for deaf and hearing-impaired people","Sound-amplifying equipment","Assistance dogs","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:05:53+02:00","published_at":"2020-08-31T13:02:43+02:00","backoffice_id":222693,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.10306166382878},{"id":511439,"date_start":"2021-05-11","date_end":"2023-12-31","date_next":"2022-07-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[103],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Discover Brussels, an APPetizing adventure","shortdescr":"Une visite interactive de Bruxelles, 100% Covid-friendly, m\u00ealant culture, jeux urbains et d\u00e9couvertes culinaires de sp\u00e9cialit\u00e9s bruxelloises, rassembl\u00e9es dans un panier garni.","longdescr":"Jeu urbain interactif l Panier garni l 2 \u00e0 6 pers. l 2-3h \r\n\r\nEntre amis ou coll\u00e8gues, partez \u00e0 la d\u00e9couverte de Bruxelles autrement gr\u00e2ce \u00e0 une activit\u00e9 digitale, ludique et interactive. \u00c0 l\u2019aide d\u2019une application disponible sur votre smartphone, Discover Belgium vous emm\u00e8ne admirer les plus belles p\u00e9pites du centre-ville, \u00e0 la rencontre d\u2019anecdotes et de perles architecturales. Gr\u00e2ce \u00e0 la g\u00e9olocalisation, notre ami fin connaisseur de Bruxelles, vous guidera dans la ville et vous indiquera les lieux exacts o\u00f9 vous rendre. \r\n\r\nTout au long de votre parcours, diverses missions vous seront propos\u00e9es telles que des \u00e9nigmes \u00e0 d\u00e9chiffrer, des informations \u00e0 d\u00e9nicher ou des situations \u00e0 reproduire. Un cot\u00e9 fun et d\u00e9cal\u00e9 pour profiter encore plus de votre journ\u00e9e ! \r\n \r\nPuisque visiter rime aussi avec go\u00fbter, vous d\u00e9gusterez les sp\u00e9cialit\u00e9s belges les plus exquises. Repartez avec un panier garni rempli de gourmandises bruxelloises et artisanales, \u00e0 retirer chez l\u2019un de nos partenaires locaux.\r\n\r\nQuel est le prix?\r\n39\u20ac pour 2-3 personnes (incluant un panier garni d'une valeur de 16\u20ac)\r\n59\u20ac pour 4-6 personnes (incluant un panier garni d'une valeur de 16\u20ac)\r\n\r\nQuand pouvons-nous participer \u00e0 cette visite ? Tous les jours. Vous pouvez commencer \u00e0 tout moment de la journ\u00e9e. Il vous suffit de tenir compte des heures d'ouverture du magasin pour retirer votre panier cadeau (fermeture g\u00e9n\u00e9ralement \u00e0 18h).\r\n\r\nPlus d'infos : https:\/\/www.discover-belgium.be\/fr\/bruxelles\/discover-brussels-an-appetizing-adventure.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.discover-belgium.be","email":"info@discover-belgium.be","phone_contact":null,"phone_booking":"+32 477 45 52 97","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/511439.html"},"nl":{"name":"Discover Brussels, an APPetizing adventure","shortdescr":"Deze 100 % Corona-proof interactieve stadstour in Brussel is een leuke combinatie van historische weetjes, een ludiek stadsspel en een smaakvolle ontdekking van Brusselse specialiteiten verzameld in een geschenkenpakket.","longdescr":"Interactieve stadsspel l Geschenkpakket l 2 tot 6 personen l 2-3u\r\n\r\nOntdek met vrienden of collega's Brussel op een ludieke manier dankzij deze digitale en interactieve tour. Met behulp van een app op je smartphone, wandel je op eigen tempo langsheen de 20 leukste en mooiste plekjes van de historische binnenstad. Dankzij geolocalisatie zal onze vriend Julien, een echte Brussel-kenner, jullie naar allerlei bekende maar ook minder gekende bezienswaardigheden begeleiden.   \r\n\r\nNaast een korte uitleg en grappige anekdotes, staat er ook een leuk stadsspel op het programma. Raadsels kraken, puzzels maken, informatie zoeken, originele selfies nemen, ... ze maken er een spannende en ludieke ontdekkingstocht van. \r\n\r\nBrusselse specialiteiten proeven hoort er uiteraard ook bij. Zo hebben we enkele Brusselse lekkernijen verzameld in een heerlijk geschenkpakket dat je tijdens of na de tour kan afhalen bij \u00e9\u00e9n van onze lokale partners.\r\n\r\nWat is de prijs?\r\n\u20ac 39 voor 2-3 personen (inclusief geschenkpakket ter waarde van \u20ac16)\r\n\u20ac 59 voor 4-6 personen (inclusief geschenkpakket ter waarde van \u20ac16)\r\n\r\nWanneer kunnen we aan deze tour deelnemer? Alle dagen. Je kan starten op elk moment van de dag. Je hoeft enkel rekening te houden met de openingsuren van de handelaar voor je geschenkpakket af te halen (18u).\r\n\r\nMeer info : https:\/\/www.discover-belgium.be\/nl\/brussel\/discover-brussels-an-appetizing-adventure.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/511439.html"},"en":{"name":"Discover Brussels, an APPetizing adventure","shortdescr":"This 100% Covid-friendly interactive city tour in Brussels is a original combination of historical facts, a fun city game and a tasty discovery of Brussels specialities collected in a gift pack.","longdescr":"Interactive urban game l Gift basket l 2 to 6 pers. l 2-3h \r\n\r\nDiscover Brussels in a playful way with friends or colleagues thanks to this digital and interactive tour. Using an app on your smartphone, you walk at your own pace along the 20 best and most beautiful spots of the historic city centre. Thanks to geolocation, our friend Julien, a true Brussels expert, will guide you to many well-known and lesser-known sights.   \r\n\r\nBesides a short explanation and funny anecdotes, there is also a fun city game on the programme. Cracking riddles, doing puzzles, searching for information, taking original selfies... They will make it an exciting and playful voyage of discovery. \r\n\r\nTasting Brussels specialities is also part of the game, of course. We have collected a few Brussels delicacies in a delicious gift pack that you can collect from one of our local partners during or after the tour.\r\n\r\nWhat is the price?\r\n39\u20ac for 2-3 people (including a 16\u20ac gift pack)\r\n59\u20ac for 4-6 persons (including a gift pack with a value of \u20ac16)\r\n\r\nWhen can we join this tour? Every day. You can start at any time of the day. You only have to take into account the opening hours of the shop for picking up your gift package (18h).\r\n\r\nMore info : https:\/\/www.discover-belgium.be\/en\/brussels\/discover-brussels-an-appetizing-adventure.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/511439.html"},"de":{"name":"Discover Brussels, an APPetizing adventure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/511439.html"},"it":{"name":"Discover Brussels, an APPetizing adventure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/511439.html"},"sp":{"name":"Discover Brussels, an APPetizing adventure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/511439.html"},"pt":{"name":"Discover Brussels, an APPetizing adventure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/511439.html"},"cn":{"name":"Discover Brussels, an APPetizing adventure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussel