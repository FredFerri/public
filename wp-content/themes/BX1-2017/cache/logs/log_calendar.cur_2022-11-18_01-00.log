":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[7,8,11],"translations":{"fr":["Jeunes 12-15 ans","Jeunes 15-18 ans","Famille"],"nl":["Jongeren 12-15 j.","Jongeren 15-18 j.","Familie"],"en":["Youth 12-15  yr.","Youth 15-18  yr.","Family"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T21:35:13+02:00","published_at":"2022-09-16T10:14:04+02:00","backoffice_id":262031,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":545577,"date_start":"2022-11-23","date_end":"2022-11-23","date_next":"2022-11-23","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"\"Le Banquet de Jean Do\" - Spectacle sur la po\u00e9tesse Jean Dominique","shortdescr":"N\u00e9e \u00e0 Bruxelles en 1873 et d\u00e9c\u00e9d\u00e9e en 1952, Jean Dominique (Marie Closset) fut une po\u00e9tesse et une figure artistique et intellectuelle brillante, engag\u00e9e, libre et reconnue \u00e0 la Belle \u00c9poque. Mais qui se souvient encore d\u02bcelle aujourd\u2019hui?","longdescr":"N\u00e9e \u00e0 Bruxelles en 1873 et d\u00e9c\u00e9d\u00e9e en 1952, Jean Dominique (Marie Closset) fut une po\u00e9tesse et une figure artistique et intellectuelle brillante, engag\u00e9e, libre et reconnue \u00e0 la Belle \u00c9poque. Mais qui se souvient encore d\u02bcelle aujourd\u2019hui?\r\n\r\nMis en sc\u00e8ne par Viviane Wansart, \u00ab Le Banquet de Jean Do \u00bb est un spectacle po\u00e9tique, convivial et musical qui fait vivre sur le plateau des femmes, des amies et des amantes, autour d\u2019un banquet d\u2019anniversaire pour les 75 ans de la po\u00e9tesse, organis\u00e9 par ses deux compagnes, Blanche et Marie.\r\n\r\nNous sommes en 1948, apr\u00e8s les souffrances des deux guerres mondiales, dans leur petite maison-\u00e9cole de Uccle. Parmi les invit\u00e9.es, on retrouve sa mentor Isabelle Gatti de Gamond et ses \u00ab Gatticiennes \u00bb comme Marie Nizet, Maria Van Rysselberghe et Ir\u00e8ne Podolwsky, ses \u00ab Fid\u00e8les \u00bb dont May Sarton et la jeune Jacqueline, Hannah, et deux amis aussi, Elys\u00e9e Reclus et Charles Houben\u2026 Certain.es sont d\u00e9c\u00e9d\u00e9.es et d\u2019autres pas, mais qu\u2019importe! Elles et ils se retrouvent avec simplicit\u00e9 autour d\u2019un piano, \u201cpour nous \u00e9treindre en silence, pour parler de n\u02bcimporte quoi, et, surtout, pour rire de nous-m\u00eames\u201d (M. Sarton).\r\n\r\nSouvenirs, blessures, joies, nostalgies, rires et r\u00e9flexions sur l\u2019amiti\u00e9, la cr\u00e9ation, la vieillesse, l\u2019amour, se m\u00ealent aux po\u00e8mes sensibles et myst\u00e9rieux de Jean Dominique, aux chants et aux improvisations musicales du pianiste de jazz Pirly Zurstrassen.\r\n\r\nC\u2019est dans un univers po\u00e9tique symboliste que nous convions notre public, un monde invisible, hors du temps, \u00e0 la fois tendre et secret, dans lequel ce qui compte n\u2019est plus tellement ce qui se dit \u2013 ni ce qui se passe \u2013 mais les impressions et sensorialit\u00e9s musicales partag\u00e9es.\r\n\r\nBon anniversaire Jean-Do!","performers":"JEU ET CHANTS : Jocelyne Bidart, Anne Bourtembourg, Julie Dautrebande, Catherine Domken, Pascale Jeanson, Isabelle Ling, Giorgos Sapountzoglou, Naomi Simidreanu, Aude Van Diest, Colomba Vargas, Viviane Wansart, Pirly Zurstrassen.\r\nPO\u00c8MES : Jean Dominique (extraits)\r\nDRAMATURGIE ET MISE EN SC\u00c8NE : Viviane Wansart\r\nASSISTANT \u00c0 LA MISE EN SC\u00c8NE : Giorgos Sapountzoglou\r\nMUSIQUES : Pirly Zurstrassen","boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/le-banquet-de-jean-do\/","email":"infosdelacour@gmail.com","phone_contact":"+32 2 733 76 52","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545577"},"nl":{"name":"\"Le Banquet de Jean Do\" - Spectacle sur la po\u00e9tesse Jean Dominique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545577"},"en":{"name":"\"Le Banquet de Jean Do\" - Spectacle sur la po\u00e9tesse Jean Dominique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545577"},"de":{"name":"Spectacle \"Le Banquet de Jean Do\" - Spectacle sur la po\u00e9tesse Jean Dominique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545577"},"it":{"name":"Spectacle \"Le Banquet de Jean Do\" - Spectacle sur la po\u00e9tesse Jean Dominique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545577"},"sp":{"name":"Spectacle \"Le Banquet de Jean Do\" - Spectacle sur la po\u00e9tesse Jean Dominique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,