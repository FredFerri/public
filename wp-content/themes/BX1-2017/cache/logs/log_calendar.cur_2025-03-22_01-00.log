2:03:18+01:00","published_at":"2024-10-10T11:53:04+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":309518,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.1912293963810262,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[51],"translations":{"de":["Kabarett"],"pt":[null],"en":["Cabaret"],"it":["Cabaret"],"cn":[null],"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"sp":["Caf\u00e9 teatro"],"nl":["Cabaret"]}}},"translations":{"de":{"name":"And....Cut ! - Spectacle d'Improvisation Dirig\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002434"},"pt":{"name":"And....Cut ! - Spectacle d'Improvisation Dirig\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002434"},"en":{"name":"And....Cut ! - Spectacle d'Improvisation Dirig\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002434"},"it":{"name":"And....Cut ! - Spectacle d'Improvisation Dirig\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002434"},"cn":{"name":"And....Cut ! - Spectacle d'Improvisation Dirig\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002434"},"fr":{"name":"And....Cut ! - Spectacle d'Improvisation Dirig\u00e9e","shortdescr":"AND...CUT !\n\nVivez une soir\u00e9e unique d\u2019improvisation avec Alexandre Valancin et Catherine Lembr\u00e9e. Assistez en direct \u00e0 la cr\u00e9ation d\u2019une histoire \u00e9pique de 2x40 minutes, avec des com\u00e9diens qui se rencontrent pour la premi\u00e8re fois sur sc\u00e8ne. D\u00e9couvrez les coulisses de l\u2019impro, les choix artistiques instantan\u00e9s et les surprises en continu.\n\nNe manquez pas cette immersion dans l\u2019art de l\u2019impro !","longdescr":"AND...CUT !\n\nPlongez dans les coulisses de la cr\u00e9ation d'histoires improvis\u00e9es comme vous ne les avez jamais vues ! Pour une soir\u00e9e unique, laissez-vous emporter dans l'univers d'un.e metteur.euse en sc\u00e8ne qui vous d\u00e9voilera les secrets derri\u00e8re chaque sc\u00e8ne et chaque moment d'improvisation. \n\nSous la direction attentive de Alexandre Valancin et Catherine Lembr\u00e9e, ainsi que leurs invit\u00e9.e.s du soir, vous assisterez \u00e0 la naissance d'une grande histoire de 2x40 minutes, fa\u00e7onn\u00e9e par des mises en sc\u00e8ne inspir\u00e9es et audacieuses. Mais attention, il y a un d\u00e9fi de taille : certains com\u00e9dien.nes ne se connaissent m\u00eame pas ou n'ont jamais jou\u00e9 ensemble ! \n\nLe ou la metteur.euse en sc\u00e8ne guidera les com\u00e9dien.nes et le.la r\u00e9gisseur.euse ajoutera sa touche magique, pour vous offrir une exp\u00e9rience th\u00e9\u00e2trale in\u00e9dite o\u00f9 tout peut arriver.\n\nAND...CUT ! est une invitation \u00e0 explorer ce qui se cache derri\u00e8re l'improvisation, \u00e0 d\u00e9couvrir les choix artistiques, et \u00e0 vivre une soir\u00e9e o\u00f9 la cr\u00e9ativit\u00e9 et l'audace sont \u00e0 l'honneur. Faites confiance au processus, et laissez-vous surprendre par l'histoire qui va se d\u00e9rouler sous vos yeux !\n\nNe manquez pas cette immersion totale dans l'art de l'impro ! ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002434"},"sp":{"name":"And....Cut ! - Spectacle d'Improvisation Dirig\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002434"},"nl":{"name":"And....Cut ! - Spectacle d'Improvisation Dirig\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002434"}},"place":{"id":267378,"translations":{"de":{"name":"Le TRAC","address_street_name":"Rue Albert Meunier","address_street_number":"110","address_street_box":null,"email":"info@letrac.be","website":"http:\/\/www.letrac.be\/","phone_contact":"+32 470 50 04 75","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue Albert Meunier, 110","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le TRAC","address_street_name":"Rue Albert Meunier","address_street_number":"110"