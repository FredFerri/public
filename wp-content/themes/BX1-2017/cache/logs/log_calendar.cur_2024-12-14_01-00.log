":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/lod-et-lumi\/2024-12-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003389"},"it":{"name":"Lod et Lumi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/lod-et-lumi\/2024-12-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003389"},"cn":{"name":"Lod et Lumi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/lod-et-lumi\/2024-12-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003389"},"fr":{"name":"Lod et Lumi","shortdescr":"Lod et Lumi est un spectacle de marionnettes librement inspir\u00e9 du conte de \u00ab La Reine des Neiges \u00bb de Hans Christian Andersen, sur le th\u00e8me de la tristesse et de l\u2019amiti\u00e9 au milieu de l\u2019hiver, des aurores bor\u00e9ales et du froid glacial.","longdescr":"Un beau jour d'\u00e9t\u00e9, Lod et Lumi se disputent. Lumi s'en va et Lod reste seul. Lod suit une petite lumi\u00e8re dans le ciel qui lui brise le c\u0153ur. Frigorifi\u00e9, il est emport\u00e9 par la Reine des Neiges. Lumi, malgr\u00e9 ses peurs, part \u00e0 la recherche de son meilleur ami. Elle plonge dans un monde imaginaire rempli de personnages farfelus et myst\u00e9rieux. ","performers":"Compagnie La P\u2019tite Canaille\nMise en sc\u00e8ne : Manon Copp\u00e9e\nTexte : Manon Copp\u00e9e et Patrick Michel\nAssistant mise en sc\u00e8ne : Matt\u00e9o Goblet et Hippolyte de Poucques\nAvec : Emilie Parmentier et Elodie Vriamont\n\nR\u00e9gie g\u00e9n\u00e9rale : Fanny Boizard\nR\u00e9gie : Fanny Boizard et L\u00e9a Vandooren\nMarionnettes : No\u00e9mie Favart\nAide cr\u00e9ation marionnettes : Camille Van Hoof\nCostumes : Camille Van Hoof","boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/lod-et-lumi\/2024-12-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003389"},"sp":{"name":"Lod et Lumi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/lod-et-lumi\/2024-12-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003389"},"nl":{"name":"Lod et Lumi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/lod-et-lumi\/2024-12-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003389"}},"place":{"id":4,"translations":{"de":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Waterloo, 94","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box