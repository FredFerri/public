echt","address_street_name":"Place de la Vaillance","address_street_number":"5","address_street_box":null,"email":"dir@ma-an.be","website":"http:\/\/www.ma-an.be","phone_contact":"+32 2 522 05 51","phone_booking":"+32 2 522 05 51","address_zip":"1070","address_city":"Anderlecht","address_line1":"Place de la Vaillance, 5","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":25380,"location":{"lat":50.83547887,"lon":4.30700694},"region":"brussels","last_updated_at":"2022-04-29T01:08:29+02:00","published_at":"2016-02-15T20:34:39+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":8600,"translations":{"fr":{"name":"Maison d'Erasme","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"\u00c9rasme a s\u00e9journ\u00e9 en 1521 dans cette maison gothique (1450-1515) qui rassemble \u00e0\r\nla fois une collection de peintures, gravures et scuptures (Albrecht Du\u0308rer, Joos Van\r\nCleve, Pieter Huys, Cornelis Metsys, Frans Francken le Jeune \u2026), une biblioth\u00e8que\r\nsp\u00e9cialis\u00e9e dans les \u00e9ditions princeps, c\u2019est-\u00e0-dire les premi\u00e8res \u00e9ditions d\u2019une \u0153uvre\r\nchez diff\u00e9rents imprimeurs, un Jardin philosophique et un Jardin de plantes\r\nm\u00e9dicinales. Le mus\u00e9e publie des livres et organise des conf\u00e9rences, des concerts,\r\ndes expositions d\u2019art contemporain et historiques, des activit\u00e9s p\u00e9dagogiques, des\r\nvisites guid\u00e9es pour groupes.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Erasmushuis","address_street_name":"Formanoirstraat","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Formanoirstraat, 31","address_line2":"1070 Anderlecht","description_web":"In 1521 verbleef Erasmus in dit gotische huis (1450-1515) waar zich niet alleen een collectie bevindt van schilderijen, prenten en beeldhouwwerken (Albrecht Du\u0308rer, Joos\r\nVan Cleve, Pieter Huys, Cornelis Metsys, Frans Francken de Jongere\u2026), maar ook een\r\nbibliotheek gespecialiseerd in \u2018editiones principes\u2019, dat wil zeggen de eerste uitgaven\r\nvan een werk bij verschillende drukkers. Verder bevindt zich buiten nog een Filosofische\r\ntuin en een tuin met Geneeskrachtige planten.\r\nDaarnaast publiceert het museum boeken en organiseert voordrachten, concerten,\r\ntentoonstellingen met een historisch thema en tentoonstellingen Hedendaagse kunst,\r\npedagogische activiteiten en rondleidingen voor groepen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Erasmus House","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"For several years, this house, which looks like a cloister, was home to the brilliant 16th-century humanist. Works of art, engravings, books, and archives bear witness to life in that era. End your visit in the philosophical and medicinal garden.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Museum des Maison d'Erasme","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"Das \u201eMaison d\u2019Erasme\u201c in der Br\u00fcsseler Gemeinde Anderlecht wurde Ende des 15. Jahrhunderts im Auftrag eines Stiftsherrn der nahegelegenen Stiftskirche St. Peter und St. Guido  im sp\u00e4tgotischen Stil errichtet.\r\n\r\nDas Haus beherbergte im Jahr 1521 den bedeutenden niederl\u00e4ndischen Gelehrten des Renaissance-Humanismus Erasmus von Rotterdam, der hier, fernab von den gro\u00dfen Machtzentren und den dort herrschenden Religionskriegen, die Ruhe und Abgeschiedenheit der Natur suchte.\r\n\r\nDas im Maison d\u2019Erasme untergebrachte Museum zeigt sowohl eine Gem\u00e4ldesammlung mit Werken von Holbein, Bosch und Metsys als auch eine reich mit alten B\u00fccherausgaben best\u00fcckte Bibliothek. Der umliegende Garten besteht aus einem \u201eJardin des Maladies\u201c \u2013 dem \u201eGarten der Krankheiten\u201c mit zahlreichen Heilpflanzen \u2013 und einem \u201eJardin philosophique\u201c \u2013 dem \u201ePhilosophischen Garten\u201c.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Casa di Erasmo","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Casa di Erasmo deve il suo nome e la sua fama ad Erasmo da Rotterdam, che vi soggiorn\u00f2 nel 1521. Divenuta un museo dedicato al grande umanista rinascimentale, \u00e8 luogo di esposizione di una collezione unica composta da opere d'arte - sculture e dipinti di maestri fiamminghi -, mobili e libri antichi, molti dei quali scritti dallo stesso Erasmo. Se la Casa di Erasmo \u00e8 una delle pi\u00f9 antiche di Bruxelles - costruita in tre fasi nel corso dei secoli XV e XVI -, nel 1932 \u00e8 stata oggetto di un restauro completo voluto, nello spirito del pi\u00f9 puro storicismo, da Daniel Van Damme, fondatore del museo, con l'aiuto dell'architetto Charles Van Elst, che costru\u00ec anche la casa di Maurice Car\u00eame.  Gli spazi interni sono stati poi riconvertiti in sale del museo. Queste sono state decorate (una stanza con le pareti completamente rivestite di sontuose pelli di Cordoba) ed arredate con mobili provenienti dall'antica collezione del Ministro Vandenpeereboom. Gli interni sono quindi ricostruzioni con lo scopo di dare ai visitatori un'idea di quello che poteva essere una residenza rinascimentale. Le ricostruzioni sono in parte basate su documenti storici (lo studio di Erasmo che d\u00e0 sul giardino) ed in parte su ritrovamenti archeologici quali lo splendido fregio affrescato del primo piano. Nella parte posteriore della casa, un ampio giardino ombreggiato da grandi alberi conserva alcuni resti archeologici dell'antico castello di Anderlecht, poeticamente abbinati a diverse installazioni di artisti contemporanei. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa de Erasmo","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Casa de Erasmo debe su nombre y prestigio a la temporada que pas\u00f3 en ella Erasmo de R\u00f3terdam en 1521. Convertida en un museo dedicado a este gran humanista del Renacimiento, es el envoltorio de una colecci\u00f3n \u00fanica compuesta por obras de arte (esculturas y pinturas de maestros flamencos), muebles y libros antiguos, entre ellos numerosas ediciones erasmianas. Si la Casa de Erasmo es una de las m\u00e1s antiguas de Bruselas (construida en tres fases a lo largo de los siglos XV y XVI), a partir de 1932 fue objeto de una restauraci\u00f3n completa llevada a cabo, en el m\u00e1s puro historicismo, por Daniel Van Damme, fundador del museo, con la ayuda del arquitecto Charles Van Elst, que tambi\u00e9n construy\u00f3 la casa de Maurice Car\u00eame. Los espacios interiores se reorganizaron entonces en salas de museo que fueron decoradas (entre ellas, una sala con las paredes totalmente cubiertas por suntuosas pieles de C\u00f3rdoba) y amuebladas con mobiliario procedente de la antigua colecci\u00f3n del ministro Vandenpeereboom. El interior es, por tanto, una reproducci\u00f3n cuyo fin es dar a los visitantes la idea de lo que podr\u00eda haber sido una residencia en el Renacimiento, basada en parte en documentos hist\u00f3ricos (despacho de Erasmo frente al jard\u00edn) y en hallazgos arqueol\u00f3gicos como el maravilloso friso pintado al fresco del primer piso. Detr\u00e1s de la casa, un vasto jard\u00edn con grandes \u00e1rboles que le dan sombra conserva algunos restos arqueol\u00f3gicos del antiguo castillo de Anderlecht, los cuales se encuentran, po\u00e9ticamente, cerca de varias instalaciones de artistas contempor\u00e1neos. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la Maison d'Erasme","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la Maison d'Erasme","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":327,"location":{"lat":50.83592263,"lon":4.3077579},"region":"brussels","last_updated_at":"2022-04-29T01:08:29+02:00","published_at":"2013-10-19T01:13:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/bae56b0c608827eafd206bcfd62d916e0f075c38.jpg","width":1169,"height":1654,"ratio":0.71,"translations":{"fr":{"title":"Erasmusica - concerts de midi musique ancienne","copyright":null},"nl":{"title":"Erasmusica - concerts de midi musique ancienne","copyright":null},"en":{"title":"Erasmusica - concerts de midi musique ancienne","copyright":null}}}],"dates":[{"day":"2022-01-27","doors":null,"start":"12:30:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-02-24","doors":null,"start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2022-03-31","doors":null,"start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2022-04-28","doors":null,"start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2022-05-19","doors":null,"start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false},{"day":"2022-06-30","doors":null,"start":"12:30:00","end":"13:15:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,256,259],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Chien d'assistance"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor blinde en slechtziende personen","Assistentiehonden"],"en":["Accessible to people with intellectual disabilities","Facilities for blind and partially-sighted persons","Assistance dogs"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-29T01:08:29+02:00","published_at":"2022-01-10T11:46:46+01:00","backoffice_id":245120,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":0.1865633907617},{"id":533611,"date_start":"2022-05-19","date_end":"2022-09-26","date_next":"2022-05-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,41],"translations":{"fr":["Mus\u00e9es et art centers","Installation, performance"],"nl":["Musea en kunstcentra","Installatie, performance"],"en":["Museums and art centers","Installation, performance"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Liquefy: Human-Nature","shortdescr":null,"longdescr":"\u00c0 travers le temps et les \u00e2ges, la Vie humaine se d\u00e9cline dans son enveloppe physique, avec la force qui nous r\u00e9unit tous.tes, celle de la Nature. Aujourd\u2019hui, ce pouvoir s\u2019oublie au profit d\u2019une vie en soci\u00e9t\u00e9. L\u2019exposition de Moni Wespi \u00abLiquefy: Human-Nature\u00bb, propose de changer de mod\u00e8le de repr\u00e9sentation du monde, en inversant les r\u00f4les. Ce n\u2019est plus l\u2019Humain qui envahit la Nature mais c\u2019est elle qui s\u2019en empare jusqu\u2019\u00e0 les confondre entre eux.\r\n\r\nC\u2019est du 19 mai au 26 septembre dans l\u2019espace public QARTIER de la Station Bourse - Grand-Place, que l\u2019artiste pr\u00e9sente dans les vitrines de nouvelles \u0153uvres, des vid\u00e9os, des photographies et deux panoramas mis en sc\u00e8ne de la 2D \u00e0 la 3D. Au fil des saisons, tant\u00f4t fixes, tant\u00f4t en mouvement, s\u2019y d\u00e9ploient des \u00eatres incarnant de multiples transformations, de leur condition humaine \u00e0 leur genre. Un univers esth\u00e9tique qui nous projette dans une imagerie extraordinaire, issue de la pratique transdisciplinaire de l\u2019artiste. Une recherche hybride, m\u00ealant l\u2019impression textile de surfaces naturelles \u00e0 des d\u00e9cors naturels ou imagin\u00e9s. Avec ce point de vue, le temps d\u2019un instant, l\u2019artiste et la curatrice invitent les passants \u00e0 s\u2019extraire de leur quotidien et d\u2019imaginer une autre \u00e9volution possible. Comme une alter-r\u00e9alit\u00e9, Moni Wespi dresse des portraits de nouvelles identit\u00e9s en concr\u00e9tisant l\u2019acte de transformation et en questionnant les codes op\u00e9r\u00e9s par la soci\u00e9t\u00e9 pour se rapprocher d\u2019un \u00eatre au plus proche de lui-m\u00eame.\r\n\r\nMa\u00eblle Delaplanche\r\n\r\nAvec Zinnema, Bruxelles Mobilit\u00e9 et la STIB et avec le soutien de la F\u00e9d\u00e9ration Wallonie-Bruxelles, commission Culturelle Transversale","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533611.html"},"nl":{"name":"Liquefy: Human-Nature","shortdescr":null,"longdescr":"Door tijd en eeuwen heen wordt het menselijk leven uitgedrukt in zijn fysieke omhulsel, met de kracht die ons allen verenigt, die van de Natuur. Vandaag wordt deze macht vergeten ten voordele van een leven in de maatschappij. Moni Wespi's tentoonstelling \"Liquefy: Human-Nature\", stelt voor om het model van representatie van de wereld te veranderen, door de rollen om te keren. Het is niet langer de mens die de natuur binnendringt, maar het is de natuur die het overneemt, totdat ze met elkaar verstrengeld raken.\r\nVan 19 mei tot 26 september presenteert de kunstenaar in de openbare ruimte QARTIER aan Station Beurs-Grote Markt nieuwe werken in de etalages: video's, foto's en twee panorama's in sc\u00e8ne gezet van 2D naar 3D. In de loop van de seizoenen, soms stilstaand, soms bewegend, belichamen wezens meerdere transformaties, van hun menselijke conditie tot hun geslacht. Een esthetisch universum dat ons projecteert in een buitengewone beeldtaal, voortkomend uit de transdisciplinaire praktijk van de kunstenaar. Een hybride onderzoek, waarbij textielbedrukking van natuurlijke oppervlakken wordt vermengd met natuurlijke of ingebeelde omgevingen. Vanuit dit gezichtspunt nodigen de kunstenaar en de curator de voorbijgangers uit om even aan hun dagelijkse leven te ontsnappen en zich een andere mogelijke evolutie voor te stellen. Als een alter-reality schetst Moni Wespi portretten van nieuwe identiteiten, door de daad van de transformatie te concretiseren en de codes die de maatschappij hanteert in twijfel te trekken, om zo dichter bij een wezen te komen dat dichter bij zichzelf staat.\r\n\r\nMa\u00eblle Delaplanche\r\n\r\nMet Zinnema, Brussel Mobiliteit en MIVB, en met steun van F\u00e9d\u00e9ration Wallonie-Bruxelles, Commission Culturelle Transversale","performers":"Moni Wespi, Ma\u00eblle Delaplanche, rue branly, Lucia Gerhardt, Fran\u00e7ois de Saint Georges, Noir Metal, Yoan Robin, Julien Celdran, Pauline Miko, Drag Couenne, Shukri, Pluche, Young Sprouts","boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533611.html"},"en":{"name":"Liquefy: Human-Nature","shortdescr":null,"longdescr":"Throughout time and ages, human life is expressed in its physical envelope, with the force that unites us all, that of Nature. Today, this power is being forgotten in favour of a life in society. Moni Wespi's exhibition \"Liquefy: Human-Nature\", proposes to change the model of representation of the world, by reversing the roles. It is no longer the Human who invades Nature, but it is Nature who takes over until they become entangled with one another.\r\n\r\nFrom 19 May to 26 September, the artist presents in the public space QARTIER at the Station Bourse \u2013 Grand-Place new works in the windows: videos, photographs and two panoramas staged from 2D to 3D. Over the course of the seasons, beings embody multiple transformations, sometimes still, sometimes moving, from their human condition to their gender. An aesthetic universe that projects us into an extraordinary imagery, resulting from the artist's transdisciplinary practice. A hybrid research, mixing textile printing of natural surfaces with natural or imagined settings. From this point of view, the artist and the curator invite passers-by to escape from their daily lives for a moment, and to imagine another possible evolution. Like an alter-reality, Moni Wespi draws up portraits of new identities by concretising the act of transformation and questioning the codes operated by society to get closer to a being closer to himself.\r\n\r\nMa\u00eblle Delaplanche\r\n\r\nWith Zinnema, Bruxelles Mobilit\u00e9 and the STIB and with the support of the F\u00e9d\u00e9ration Wallonie-Bruxelles, Commission Culturelle Transversale","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533611.html"},"de":{"name":"Liquefy: Human-Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533611.html"},"it":{"name":"Liquefy: Human-Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533611.html"},"sp":{"name":"Liquefy: Human-Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533611.html"},"pt":{"name":"Liquefy: Human-Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533611.html"},"cn":{"name":"Liquefy: Human-Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533611.html"}},"place":{"id":272743,"translations":{"fr":{"name":"M\u00e9tro Bourse","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"M\u00e9tro Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Metrostation Beurs","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":