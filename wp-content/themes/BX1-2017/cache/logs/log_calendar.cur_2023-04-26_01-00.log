alse,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Mers & Oc\u00e9ans par Talk C.E.C","shortdescr":"Du 20 avril au 25 juin 2023, d\u00e9couvrez l'exp\u00e9dition\u00a0Mers & Oc\u00e9ans\u00a0par Talk C.E.C r\u00e9unissant 40 artistes et 18 scientifiques. \u00c0 travers ses 3.500 m\u00e8tres carr\u00e9s d\u2019exposition, de conf\u00e9rences, d\u2019ateliers et de performances artistiques, Mers & Oc\u00e9ans propose une immersion sensorielle sous le niveau de la mer afin d\u2019en appr\u00e9hender la complexit\u00e9 et les enjeux environnementaux.","longdescr":"Nous, \u00eatres humains,\u00a0habitons les terres et sillonnons les mers. Cette immensit\u00e9 m\u00e9connue depuis l\u2019aube, source de myst\u00e8res et de fantasmes, a passionn\u00e9 les Hommes de l'Antiquit\u00e9 jusqu'\u00e0 nos jours et a inspir\u00e9 les plus grands artistes et \u00e9crivains. Les mers et les oc\u00e9ans, singularit\u00e9 de notre plan\u00e8te, sont un espace d'explorations et d'aventures mais aussi d\u2019exploitation et de destruction.\u00a0\r\n\r\nDu 20 avril au 25 juin 2023, d\u00e9couvrez l'exp\u00e9dition\u00a0Mers & Oc\u00e9ans\u00a0par Talk C.E.C r\u00e9unissant 40 artistes d\u2019art urbain et contemporain et 18 scientifiques. \u00c0 travers ses 3.500 m\u00e8tres carr\u00e9s d\u2019exposition, de conf\u00e9rences, d\u2019ateliers et de performances artistiques, Mers & Oc\u00e9ans propose une immersion sensorielle sous le niveau de la mer afin d\u2019en appr\u00e9hender la complexit\u00e9 et les enjeux environnementaux.\r\n\r\nQuand l'art rencontre la science,\u00a0il peut am\u00e9liorer notre perception du monde et accro\u00eetre notre conscience de celui-ci. Ensemble, ces disciplines fournissent un moyen de communication puissant qui peut changer nos habitudes et nos comportements. Artistes et scientifiques collaborent pour transmettre l'importance de la pr\u00e9servation de nos \u00e9cosyst\u00e8mes \u00e0 travers une forme artistique qui suscite imagination et \u00e9motions.\r\n\r\nTalk C.E.C (Cr\u00e9ateur d'Exp\u00e9riences Culturelles), emm\u00e8ne les \u00c9tablissements Demeuldre, ancienne manufacture de porcelaine datant de 1830, vers un nouveau cycle, avec la modernisation des infrastructures et \u00e9quipements ainsi que la restauration et la valorisation de son patrimoine historique, architectural et artistique. Talk C.E.C, un lieu novateur multidisciplinaire, qui r\u00e9partit ses activit\u00e9s en alliant culture et d\u00e9couverte, conscience \u00e9cologique et divertissement, le tout sur 3 niveaux pour une surface totale de 3.500 m2, au c\u0153ur de la capitale europ\u00e9enne.","performers":"Olivier COISNES (sculpteur); KAFE KORS\u00c9 (peintre muraliste); MISTER X (peintre muraliste); REVES ONE (peintre muraliste); NO\u00cbL BAKER (peintre et scientifique); MISTER COPY (peintre muraliste); Th\u00e9o DRUCKER (sculpteur); NAGA (peintre muraliste); A SQUID CALLED SEBASTIAN (artiste muraliste); Laurence RAFFAELI (sculptrice); STRANGE BIRD (peintre muraliste, sculpteur); AERO (peintre muraliste) \u2026","boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553973"},"nl":{"name":"Seas & Oceans by Talk C.E.C","shortdescr":"Ontdek van 20 april tot 25 juni 2023\u00a0de expeditie Mers & Oc\u00e9ans van Talk C.E.C. waaraan 40 kunstenaars en 18 wetenschappers deelnemen. Mers & Oc\u00e9ans biedt via 3500 vierkante meter expositie, conferenties, workshops en artistieke optredens een zintuiglijke onderdompeling onder de zeespiegel om de complexiteit en de milieuproblematiek ervan te begrijpen.","longdescr":"Ontdek van 20 april tot 25 juni 2023\u00a0de expeditie Mers & Oc\u00e9ans van Talk C.E.C. waaraan 40 kunstenaars en 18 wetenschappers deelnemen. Mers & Oc\u00e9ans biedt via 3500 vierkante meter expositie, conferenties, workshops en artistieke optredens een zintuiglijke onderdompeling onder de zeespiegel om de complexiteit en de milieuproblematiek ervan te begrijpen.","performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553973"},"en":{"name":"Seas & Oceans by Talk C.E.C","shortdescr":"From April 20 to June 25, 2023, discover\u00a0Seas & Oceans expedition by Talk C.E.C. gathering 40 artists and 18 scientists. Through its 3,500 square meters of exhibition, conferences, workshops and artistic performances, Seas & Oceans offers a sensory immersion below sea level to understand the complexity and environmental issues.","longdescr":"From April 20 to June 25, 2023, discover\u00a0Seas & Oceans expedition by Talk C.E.C. gathering 40 artists and 18 scientists. Through its 3,500 square meters of exhibition, conferences, workshops and artistic performances, Seas & Oceans offers a sensory immersion below sea level to understand the complexity and environmental issues.","performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":null,"phone_co