d":57,"translations":{"de":"Clubbing","pt":null,"en":"Clubbing","it":"Locali notturni","cn":null,"fr":"Clubbing","sp":"Ir de discoteca","nl":"Clubbing"}},"others":{}},"translations":{"de":{"name":"Cabaret King \u00b7 Queer \u00b7 Creature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cabaret\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000886"},"pt":{"name":"Cabaret King \u00b7 Queer \u00b7 Creature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cabaret\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000886"},"en":{"name":"Cabaret King \u00b7 Queer \u00b7 Creature","shortdescr":"This party will see us cutting the red tape and setting up shop at C12 for a drag show featuring 9 performers.","longdescr":"This party will see us cutting the red tape and setting up shop at C12 for a drag show featuring 9 performers.\n\nAmbiance: think, create, fight, rewind, remake\u2026\nThis party will see us smashing all glass ceilings and heading to C12 for a drag show featuring 9 performers.\n\nThe time has come to unpack and explore the theme of Legacy and Transmission\u00b7s in new ways.\nTo the sound of military marches and Euro-dance, monsters of all kinds will cut a rug alongside nymphs and mutants.\nTonight, we will show resistance to the true insidious monster that is part of our collective inheritance. We will shed light on a part of history that has been left in the shadows, we will pay tribute to an extraordinary toy, and lock away the gender codes that damage us all.\n\nFeaturing: Blanket La Goulue (host) \u00b7 Dicklan \u00b7 Dulce de MalaLeche \u00b7 Femmeboyant (from Berlin) \u00b7 King Baxter (host) \u00b7 La Morrigasme \u00b7 Paula Ro\u00efd \u00b7 Rose Gigot \u00b7 \u03c4\u03b5\u03c1\u03b1\u03c4\u03ac \u03bc\u03b1\u03bc\u03ad (Terata Mam\u00e9)\n\n \n\nOnce you are all warmed up and ready, the party will start.\n\nFeaturing: Paramida \u00b7 Audrey Danza \u00b7 Zouzibabe","performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cabaret\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000886"},"it":{"name":"Cabaret King \u00b7 Queer \u00b7 Creature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cabaret\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000886"},"cn":{"name":"Cabaret King \u00b7 Queer \u00b7 Creature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cabaret\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000886"},"fr":{"name":"Cabaret King \u00b7 Queer \u00b7 Creature","shortdescr":"\u00c0 coup de pied bien entrain\u00e9, on d\u00e9fonce quelques pedestals et on s\u2019installe au C12 pour un cabaret drag de 9 performeur\u00b7euses.","longdescr":"\n\u00c0 coup de pied bien entrain\u00e9, on d\u00e9fonce quelques pedestals et on s\u2019installe au C12 pour un cabaret drag de 9 performeur\u00b7euses.\n\nAmbiance : penser, cr\u00e9er, lutter, on rembobine et on refait.\n\u00c0 coup de pied bien entrain\u00e9, on d\u00e9fonce quelques pedestals et on s\u2019installe au C12 pour un cabaret drag de 9 performeur\u00b7euses.\n\nIci, c\u2019est le moment d\u2019explorer le th\u00e8me d\u2019H\u00e9ritage\u00b7s et Transmission\u00b7s sous des formes encore nouvelles. Au son de la marche militaire comme de l\u2019euro-dance, monstres de tous poils c\u00f4toieront les nymphes et les mutant\u00b7es.\nCe soir, nous r\u00e9sisterons \u00e0 un patrimoine nuisible et mortif\u00e8re.\nNous mettrons en lumi\u00e8re un pan de l\u2019histoire laiss\u00e9 dans l\u2019ombre.\nNous rendrons hommage \u00e0 un jouet hors normes, et enfermerons dans le placard les codes genr\u00e9s qui nous abiment.\nAvec : Blanket La Goulue (host) \u00b7 Dicklan \u00b7 Dulce de MalaLeche \u00b7 Femmeboyant (from Berlin) \u00b7 King Baxter (host) \u00b7 La Morrigasme \u00b7 Paula Ro\u00efd \u00b7 Rose Gigot \u00b7 \u03c4\u03b5\u03c1\u03b1\u03c4\u03ac \u03bc\u03b1\u03bc\u03ad (Terata Mam\u00e9)\n\n \n\nUne fois que vous serez bien tous\u00b7tes echauff\u00e9\u00b7es, le moment transitionne pour une sauterie musicale all night long.\n\nAvec : Paramida \u00b7 Audrey Danza \u00b7 Zouzibabe","performers":"Drag: Blanket La Goulue \u00b7 Dicklan \u00b7 Dulce de MalaLeche \u00b7 Femmeboyant \u00b7 King Baxter \u00b7 La Morrigasme \u00b7 Paula Ro\u00efd \u00b7 Rose Gigot \u00b7 Terata Mam\u00e9 (\u03c4\u03b5\u03c1\u03b1\u03c4\u03ac \u03bc\u03b1\u03bc\u03ad)\nDJ: Paramida \u00b7 Audrey Danza \u00b7 Zouzibabe","boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cabaret\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000886"},"sp":{"name":"Cabaret King \u00b7 Queer \u00b7 Creature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cabaret\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000886"},"nl":{"name":"Cabaret King \u00b7 Queer \u00b7 Creature","shortdescr":"Met een goed getrainde voet slaan we een paar voetstukken aan flarden en installeren we ons bij C12 voor een drag cabaret met 9 performers\u00b7sters.","longdescr":"Met een goed getrainde voet slaan we een paar voetstukken aan flarden en installeren we ons bij C12 voor een drag cabaret met 9 performers\u00b7sters.\n\nAmbiance: denken, cre\u00ebren, strijden, terugspoelen en opnieuw beginnen.\n\nMet een goed getrainde voet slaan we een paar voetstukken aan flarden en installeren we ons bij C12 voor een drag cabaret met 9 performers\u00b7sters.\n\nHet is tijd om het thema Erfenis\u00b7sen en Transmissie\u00b7s op nieuwe manieren te verkennen. Zowel op de klanken van militaire marsen als Eurodance zullen allerlei soorten monsters zich mengen met nimfen en mutanten.\n\nVanavond verzetten we ons tegen een schadelijk en dodelijk erfgoed.\nWe werpen licht op een deel van de geschiedenis dat in de schaduw is gebleven.\nWe brengen hulde aan een buitengewoon stuk speelgoed en sluiten de gendercodes die ons allemaal beschadigen op.\n\nMet: Blanket La Goulue (host) \u00b7 Dicklan \u00b7 Dulce de MalaLeche \u00b7 Femmeboyant (from Berlin) \u00b7 King Baxter (host) \u00b7 La Morrigasme \u00b7 Paula Ro\u00efd \u00b7 Rose Gigot \u00b7 \u03c4\u03b5\u03c1\u03b1\u03c4\u03ac \u03bc\u03b1\u03bc\u03ad (Terata Mam\u00e9)\n\n \n\nAls jullie allemaal zijn opgewarmd, is het tijd voor een nachtelijk muzikaal feest.\n\nMet: Paramida \u00b7 Audrey Danza \u00b7 Zouzibabe","performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cabaret\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000886"}},"place":{"id":270712,"translations":{"de":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":"C12 is a new multidisciplinary platform run by the Deep in House collective. Located at the heart of Brussels, C12 is tucked in the depths of the Horta Gallery next to the Grand Place and the Central Station. C12 is a safe place where freedom, diversity, creativity and alternative culture are protected from the restrictive and normative outside world. It is a safe place where the passion for art & music in all its forms unites all identities. The project will include concerts, art installations, lives, club nights and last but by no means least, a local market.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":"C12 est une nouvelle plateforme multidisciplinaire du collectif Deep in House. Situ\u00e9e au c\u0153ur de Bruxelles, la C12 est nich\u00e9e dans les profondeurs de la Galerie Horta \u00e0 c\u00f4t\u00e9 de la Grand Place et de la Gare Centrale. C12 est un endroit s\u00fbr o\u00f9 la libert\u00e9, la diversit\u00e9, la cr\u00e9ativit\u00e9 et la culture alternative sont prot\u00e9g\u00e9es du monde ext\u00e9rieur restrictif et normatif. C'est un endroit s\u00fbr o\u00f9 la passion pour l'art et la musique sous toutes ses formes unit toutes les identit\u00e9s. Le projet comprendra des concerts, des installations artistiques, des vies, des soir\u00e9es club et le dernier mais non le moindre, un march\u00e9 local.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":"Sinds begin 2018 is Brussel een nieuwe club en multidisciplinaire projectruimte rijker en we kunnen ons het nachtleven zonder al niet meer voorstellen. C12 ligt verborgen onder het Centraal Station in wat voorheen bekend stond als de Hortagalerij. Aan het roer staat \u2018Deep in House\u2019, een technocollectief dat lang niet meer aan zijn proefstuk toe is. Naast stomende house- en technofeesten is er ook plaats voor concerten, tentoonstellingen en performance. C12 is een vrijplaats waar vrijheid, diversiteit, creativiteit en alternatieve cultuur beschermd en gevierd worden. Een absolute aanrader. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":30712,"location":{"lat":50.84603022,"lon":4.35584479},"region":"brussels","last_updated_at":"2022-10-20T11:55:05+02:00","published_at":"2018-02-02T17:49:51+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":279041,"translations":{"de":{"name":"FAME Festival","address_street_name":"Rue des Riches Claires","address_street_n