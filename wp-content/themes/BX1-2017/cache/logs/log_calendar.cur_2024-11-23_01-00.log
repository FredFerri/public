list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700003882,"date_start":"2024-11-29","date_end":"2024-12-01","date_next":"2024-11-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T13:37:07+01:00","published_at":"2024-11-22T13:29:26+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312357,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.6933612743506347,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{}},"translations":{"de":{"name":"CurieuCity #3 - Marolles \/ Marollen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/curieucity.brussels\/fr\/","email":"contact@curieucity.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003882"},"pt":{"name":"CurieuCity #3 - Marolles \/ Marollen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/curieucity.brussels\/fr\/","email":"contact@curieucity.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003882"},"en":{"name":"CurieuCity #3 - Marolles \/ Marollen","shortdescr":"CurieuCity arrives in the Marolles, presenting its final scientific and artistic endeavor of the year through a free festival open to all. Discover space, math, machines, chemistry & physics through exhibitions, workshops, and games at iconic venues and hidden spots around the Place du Jeu de Balle. Perfect for curious minds of all ages\u2014explore science and art together in a fun, interactive way!","longdescr":"CurieuCity is coming to the Marolles! Experience the last big scientific and artistic adventure of the year at our free festival, open to everyone.\n\nOn the agenda: exhibitions, workshops, activities, interactive tours, and much more! Join us on November 29, 30, and December 1 around the Place du Jeu de Balle to explore fascinating themes like space, mathematics, mechanics, chemistry, and physics.\n\nContinue the CurieuCity adventure with us by discovering the iconic and hidden spots of the Marolles from a scientific and artistic perspective:\n\nAt the Bruegel Cultural Center, dive into the mysteries of space, the complexity of machines, and the beauty of mathematics through captivating exhibitions and activities.\nAt the Art & Marges Museum, discover \u201cArborescences,\u201d an exhibition by Michel Goyon that fuses art and mathematics in an \u201cimaginary encyclopedia of metamorphosis.\u201d\nAt Hectolitre, explore chemistry, physics, and the biomedical world by uncovering the secrets of liquids and fluids\u2014everything that flows and fascinates.\nAt the Mazette Bar, join board games centered around chemistry, bread, and beer for a fun and friendly experience.\nAt the Brussels City Archives, delve into the question of what is considered true or false in science and why, by exploring the construction of knowledge at the crossroads of science, technology, and art.\nMost festival activities are accessible to all, with specific indications when this is not the case. Unless otherwise noted, activities are suitable for all ages.","performers":"At CurieuCity, astrophysicists Sophie van Eck and Else Magnus explore the cosmos with talks and workshops like \"Stars, Black Holes & Co\"& Kosmos. Fran\u00e7ois Gaspard and Boris Wilmot present the interactive Sine, blending science and music. H\u00e9lo\u00efse Colrat amazes with live glassblowing, and Frederik Vanhoutte\u2019s Isocenter transforms radiotherapy technology into art, merging precision and compassion.","boxoffice_url":null,"website":"https:\/\/curieucity.brussels\/en\/","email":"contact@curieucity.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003882"},"it":{"name":"CurieuCity #3 - Marolles \/ Marollen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/curieucity.brussels\/fr\/","email":"contact@curieucity.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003882"},"cn":{"name":"CurieuCity #3 - Marolles \/ Marollen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/curieucity.brussels\/fr\/","email":"contact@curieucity.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003882"},"fr":{"name":"CurieuCity #3 - Marolles \/ Marollen","shortdescr":"CurieuCity arrive dans le quartier des Marolles avec un festival gratuit, ouvert \u00e0 tous. Du 29 novembre au 1er d\u00e9cembre, explorez l\u2019espace, les math\u00e9matiques, les machines, la chimie et la physique \u00e0 travers des expositions, ateliers et jeux dans des lieux embl\u00e9matiques autour de la Place du Jeu de Balle. Une aventure scientifique et artistique interactive \u00e0 vivre en famille !","longdescr":"CurieuCity#3 arrive dans le quartier des Marolles !\n\nVenez vivre la derni\u00e8re grande aventure scientifique et artistique de l\u2019ann\u00e9e lors de notre festival gratuit pour toutes et tous.\n\nAu programme : des expositions, des ateliers, des animations, des parcours interactifs et bien plus encore ! Rendez-vous les 29, 30 novembre et 1er d\u00e9cembre autour de la Place du Jeu de Balle pour explorer des th\u00e8mes fascinants comme l\u2019espace, les math\u00e9matiques, la m\u00e9canique, la chimie et la physique.\n\nContinuez l\u2019aventure CurieuCity avec nous en explorant les lieux embl\u00e9matiques et insolites des Marolles d\u2019un point de vue scientifique et artistique :\n\nAu Centre Culturel Bruegel, plongez dans les myst\u00e8res de l\u2019espace, la complexit\u00e9 des machines et la beaut\u00e9 des math\u00e9matiques \u00e0 travers des expositions et des animations captivantes.\nAu Art & Marges Museum, d\u00e9couvrez \u00ab Arborescences \u00bb, une exposition de Michel Goyon qui fusionne l\u2019art et les math\u00e9matiques dans une \u00ab encyclop\u00e9die imaginaire de la m\u00e9tamorphose \u00bb\n\u00c0 Hectolitre, explorez la chimie, la physique et le monde biom\u00e9dical en d\u00e9couvrant les secrets des liquides et des fluides, tout ce qui coule et fascine.\nAu Mazette Bar, participez \u00e0 des jeux de soci\u00e9t\u00e9 autour de la chimie, du pain et de la bi\u00e8re pour un moment ludique et convivial.\nAux Archives de la ville de Bruxelles, interrogez-vous sur ce qui est consid\u00e9r\u00e9 comme vrai ou faux en sciences et pourquoi  en plongeant dans la construction des savoirs m\u00ealant sciences, technologies et arts.\nLa majorit\u00e9 des activit\u00e9s du festival sont accessibles \u00e0 tous, avec des indications sp\u00e9cifiques lorsque ce n\u2019est pas le cas. Les activit\u00e9s sont adapt\u00e9es \u00e0 tous les \u00e2ges, sauf mention contraire.\n\n","performers":"\u00c0 CurieuCity, Sophie van Eck et Else Magnus explorent le cosmos avec Stars, Black Holes & Co et Kosmos. Fran\u00e7ois Gaspard et Boris Wilmot pr\u00e9sentent Sine, m\u00ealant science et musique. H\u00e9lo\u00efse Colrat \u00e9blouit avec du soufflage de verre en direct, et Isocenter de Frederik Vanhoutte transforme la radioth\u00e9rapie en art, alliant pr\u00e9cision et compassion.","boxoffice_url":null,"website":"https:\/\/curieucity.brussels\/fr\/","email":"contact@curieucity.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003882"},"sp":{"name":"CurieuCity #3 - Marolles \/ Marollen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/curieucity.brussels\/fr\/","email":"contact@curieucity.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003882"},"nl":{"name":"CurieuCity #3 - Marolles \/ Marollen","shortdescr":"CurieuCity komt naar de Marollen voor haar laatste wetenschappelijke en artistieke evenement van het jaar, een gratis festival voor iedereen. Ontdek ruimte, wiskunde, machines, chemie en natuurkunde via tentoonstellingen, workshops en spelletjes op iconische en verborgen plekken rond de Place du Jeu de Balle. Perfect voor nieuwsgierige geesten van alle leeftijden!","longdescr":"CurieuCity#3 komt naar de Marollen!\n\nBeleef het laatste grote wetenschappelijke en artistieke avontuur van het jaar tijdens ons festival, gratis voor iedereen.\n\nOp het programma: tentoonstellingen, workshops, animaties, interactieve parcoursen en nog veel meer! Afspraak op 29, 30 november en 1 december rond het Vossenplein om fascinerende thema\u2019s zoals ruimte, wiskunde, mechanica, chemie en fysica te verkennen.\n\nZet het CurieuCity-avontuur met ons voort door de befaamde en verborgen plaatsen van de Marollen te ontdekken vanuit een wetenschappelijk en artistiek perspectief:\n\nIn het Cultureel Centrum Bruegel duik je in de mysteries van de ruimte, de complexiteit van machines en de schoonheid van wiskunde via boeiende tentoonstellingen en animaties.\nIn het Art & Marges Museum ontdek je \u201cArborescences\u201d, een tentoonstelling van Michel Goyon die kunst en wiskunde samenbrengt in een \u201cdenkbeeldige encyclopedie van metamorfose\u201d.\nBij Hectolitre verken je chemie, fysica en de biomedische wereld door de geheimen van vloeistoffen en stromingen te ontdekken, van alles wat stroomt en fascineert.\nIn de Mazette Bar neem je deel aan gezelschapsspellen rond chemie, brood en bier voor een speels en gezellig moment.\nIn de Archief van Brussel kun je jezelf afvragen wat in de wetenschap als waar of onwaar wordt beschouwd en waarom, door te duiken in de opbouw van kennis die wetenschap, technologie en kunst combineert.\nDe meeste activiteiten van het festival zijn toegankelijk voor iedereen behalve specifieke aanduidingen waar dit niet het geval is. Tenzij anders vermeld, zijn de activiteiten geschikt voor alle leeftijden.\n\n","performers":"Op CurieuCity verkennen Sophie van Eck en Else Magnus het universum met Stars, Black Holes & Co en Kosmos. Fran\u00e7ois Gaspard en Boris Wilmot presenteren Sine, een mix van wetenschap en muziek. H\u00e9lo\u00efse Colrat verrast met live glasblazen, en Frederik Vanhouttes Isocenter transformeert radiotherapietechnologie in kunst, met precisie en medeleven.","boxoffice_url":null,"website":"https:\/\/curieucity.brussels\/nl\/","email":"contact@curieucity.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003882"}},"place":{"id":247443,"translations":{"de":{"name":"Inforsciences - ULB","address_street_name":"Boulevard du Triomphe","address_street_number":"260","address_street_box":null,"email":"inforsciences@ulb.ac.be","website":"http:\/\/www.ulb.ac.be\/inforsciences","phone_contact":"+32 2 650 50 24","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Boulevard du Triomphe, 260","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Inforsciences - ULB","address_street_name":"Boulevard du Triomphe","address_street_number":"260","addre