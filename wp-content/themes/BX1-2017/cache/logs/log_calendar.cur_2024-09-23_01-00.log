le les g\u00e9n\u00e9rations autour de l\u2019\u00e9criture, explorant la perception du travail \u00e0 travers les \u00e2ges.\n\nNouveaut\u00e9 cette ann\u00e9e ! Nous avons concoct\u00e9 de nouvelles surprises pour enrichir l'exposition, en donnant une voix unique \u00e0 nos personnages.\n\nVenez d\u00e9couvrir une exp\u00e9rience immersive qui \u00e9veillera vos sens et suscitera votre curiosit\u00e9 sur le travail et son impact sur nos vies.","performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":null,"phone_booking":"+32 475 46 79 48","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012558"},"sp":{"name":"Expo: \"Le travail : mode d\u2019emploi. Voyages au fil du temps et de l\u2019espace\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":null,"phone_booking":"+32 475 46 79 48","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012558"},"nl":{"name":"\"Le travail : mode d\u2019emploi. Voyages au fil du temps et de l\u2019espace\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":null,"phone_booking":"+32 475 46 79 48","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012558"}},"place":{"id":50002047,"translations":{"de":{"name":"Escale du Nord - Centre culturel d'Anderlecht","address_street_name":"Rue du Chapelain","address_street_number":"1","address_street_box":null,"email":null,"website":"https:\/\/escaledunord.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue du Chapelain, 1","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":nu