"Leerkrachten","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","LGTBQIA","Senioren","Doof\/slechthorend"],"en":["Schools","Children 9-12 yr.","Teachers","Family","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors","Deaf\/hard of hearing"]}},"opening":{"day":"2022-09-17","start":"12:00:00","timestamp":"2022-09-17T12:00:00+02:00","end":"13:00:00","is_only_by_appointment":false},"tags":["kids"],"accessibilities":{"list":[255,258,259,263,265],"translations":{"fr":["Accessible","Appareils d'amplification du son","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Geluidsversterkende apparatuur","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Sound-amplifying equipment","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-05T17:35:17+02:00","published_at":"2022-09-05T17:25:34+02:00","backoffice_id":261066,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.43679023236815},{"id":539401,"date_start":"2022-09-20","date_end":"2022-09-24","date_next":"2022-09-20","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Nasha Moskva","shortdescr":null,"longdescr":"Nasha Moskva (\u00ab notre Moscou \u00bb en fran\u00e7ais) est l\u2019histoire de trois individus qui se projettent sur Les Trois Soeurs de Tchekhov.\r\n\r\nFin du 19\u00e8me si\u00e8cle : trois s\u0153urs orphelines \u2013 Olga, Macha et Irina \u2013 vivent dans une grande maison \u00e0 l\u2019\u00e9cart de la ville. Dans cette ville grossi\u00e8re, elles se sentent comme des \u00e9trang\u00e8res et r\u00eavent de retrouver Moscou, lieu mythique de leur enfance, paradis originel o\u00f9 elles ont grandi.\r\n\r\nD\u00e9but du 21\u00e8me si\u00e8cle : Sabine, Edith et Bernard \u2013 trois \u00eatres oscillant entre marginaux amateurice\u00b7s de th\u00e9\u00e2tre et patient\u00b7e\u00b7s psychiatriques \u2013 sont tellement \u00e9pris de l\u2019\u0153uvre de Tchekhov qu\u2019ils\u00b7elles s\u2019y reconnaissent jusqu\u2019\u00e0 la fusion.\r\n\r\nDans un dialogue entre Les Trois S\u0153urs et les trois \u00ab \u00eatres \u00bb, entre Tchekhov et nous-m\u00eames, Nasha Moskva traite du besoin vital de s\u2019int\u00e9grer dans une soci\u00e9t\u00e9, alors m\u00eame que la part la plus intime de notre \u00eatre ne cesse de nous en \u00e9loigner. Avec humour, parfois avec rage, le spectacle interroge cet \u00ab \u00eatre en dehors \u00bb inh\u00e9rent \u00e0 l\u2019\u00eatre humain. En titillant la fronti\u00e8re incertaine entre norme et folie, il questionne notre capacit\u00e9 de survivre et de cr\u00e9er une \u0153uvre artistique dans une soci\u00e9t\u00e9 normative.\r\n\r\n--------\r\n\r\nConception, mise en sc\u00e8ne et interpr\u00e9tation : Marie Bos, Estelle Franco et Francesco Italiano \/ Co-mise en sc\u00e8ne : Guillemette Laurent \/ Mise en espace : Nicolas Mouzet-Tagawa \/ Costumes : Thijsje Strijpens \/ Cr\u00e9ation lumi\u00e8res : Julie Petit-Etienne \/ Direction technique et r\u00e9gie : Nelly Framinet \/ D\u00e9veloppement et diffusion : BLOOM Project Une cr\u00e9ation de la Compagnie Le Colonel Astral. R\u00e9sidence et cr\u00e9ation Th\u00e9\u00e2tre Oc\u00e9an Nord, Bruxelles. Avec le soutien de la SACD et de Wallonie-Bruxelles International. Avec l\u2019aide \u00e0 la reprise de la F\u00e9d\u00e9ration Wallonie-Bruxelles \u2013 Service du Th\u00e9\u00e2tre \u2013 CAPT.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatredelavie.be\/spectacle\/nasha-moskva\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 489 15 15 51","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539401"},"nl":{"name":"Nasha Moskva","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539401"},"en":{"name":"Nasha Moskva","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539401"},"de":{"name":"Nasha Moskva","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539401"},"it":{"name":"Nasha Moskva","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539401"},"sp":{"name":"Nasha Moskva","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539401"},"pt":{"name":"Nasha Moskva","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539401"},"cn":{"name":"Nasha Moskva","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":