ns","Jeunes 12-15 ans","Jeunes 15-18 ans","Ecoles","Famille"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Jongeren 12-15 j.","Jongeren 15-18 j.","Scholen","Familie"],"en":["Children 6-9 yr.","Children 9-12 yr.","Youth 12-15  yr.","Youth 15-18  yr.","Schools","Family"],"de":["Kinder 6-9 Jahre","Kinder 9-12 Jahre","Jugendliche 12-15 Jahre","Jugendliche 15-18 Jahre","Schulen","Familie"],"it":["Bambini 6-9 anni","Bambini 9-12 anni","Ragazzi 12-15 anni","Ragazzi 15-18 anni","Scuole","Famiglie"],"sp":["Ni\u00f1os de 6 a 9 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os","J\u00f3venes de 12 a 15 a\u00f1os","J\u00f3venes de 15 a 18 a\u00f1os","Escuelas","Familias"],"pt":[null,null,null,null,null,null],"cn":[null,null,null,null,null,null]}},"tags":["exterior","kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T02:36:38+02:00","published_at":"2023-04-03T17:15:26+02:00","backoffice_id":274791,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.15415080049095},{"id":553368,"date_start":"2023-04-01","date_end":"2023-12-31","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,37],"translations":{"fr":["Mus\u00e9es et art centers","Arts audiovisuels"],"nl":["Musea en kunstcentra","Audiovisuele kunst"],"en":["Museums and art centers","Audiovisual art"],"de":["Museen & Kunstzentren","Audiovisuelle K\u00fcnste"],"it":["Musei e centri artistici","Arti audiovisive"],"sp":["Museos y centros de arte","Artes audiovisuales"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"HAPPINESS. Art, a positive boost for your brain.","shortdescr":"HAPPINESS, une exp\u00e9rience immersive plein de dopamine, un vrai 'boost' pour votre cerveau. Family friendly !","longdescr":"C\u2019est officiel ! L\u2019art nous rend heureux. D\u00e9couvrez l\u2019impact positif de l\u2019art sur votre cerveau dans la nouvelle exp\u00e9rience d\u2019art num\u00e9rique HAPPINESS. Entrez dans un monde rempli de couleurs, de sons, de musique et d\u2019interactions. Explorez des installations artistiques \u00e0 360\u00b0 et d\u00e9couvrez comment l\u2019art donne plus de couleurs \u00e0 votre vie !\r\n\r\n- Une exp\u00e9rience immersive o\u00f9 se rencontrent l\u2019art et la science\r\n- Salles interactives pleines de \u2018boost\u2019 pour votre cerveau\r\n- Des installations artistiques multim\u00e9dias pour petits et grands\r\n- Apprenez-en plus sur l\u2019impact de l\u2019art sur vos hormones du bonheur","performers":"Studio Irma (Amsterdam, Barcelona) et PLEIN PUBLIEK Bruxelles","boxoffice_url":"http:\/\/ticket.visit.brussels\/fr\/553368\/happiness-art-a-positive-boost-for-your-brain\/shop","website":"http:\/\/www.happiness-expo.be","email":"lindatorfs@telenet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553368"},"nl":{"name":"HAPPINESS. Art, a positive boost for your brain.","shortdescr":"Ontdek de positieve boost van kunst op je hersenen in de nieuwe digitale tentoonstelling \r\nHAPPINESS. Art, a positive boost for your brain.","longdescr":"HAPPINESS is een kleurrijk en digitaal wonderland. Een fantastische en magische wereld speciaal gecre\u00eberd  door Studio Irma (Amsterdam, Barcelona) voor Plein Publiek Brussel. Een digitale belevingsexpo waar kunst en psychologie elkaar ontmoeten. Leer meer over de impact van kunst op jouw gelukshormonen. Geniet en laat die ' survival modus ' even los. Wees verrukt, verrast en verwonderd. Onderbouwd door WHO en wetenschappers tonen we hoe belangrijk het is om kunst te omarmen.  Waarom maakt Kunst ons gelukkig ?  Deze grensverleggende digitale installatie van Studio Irma nodigt jong en oud uit in een wereld van kleur met als doel de connectie te zien tussen de artistieke en de gevoelswereld, tussen slecht in je vel zitten en verbinding met jezelf en elkaar zoeken. De boodschap is dat kunst nooit intimiderend of onbelangrijk is en dat iedereen het kan omarmen.  HAPPINESS is geen wetenschappelijke tentoonstelling maar een uitnodiging in een wereld vol goede boosts voor je hersenen.  Tijdens je bezoek aan HAPPINESS prikkelen we je hersenen met kleuren, muziek en verrassende ontdekkingen.  Kom met je vrienden en geniet !","performers":"Studio Irma (Amsterdam, Barcelona) & PLEIN PUBLIEK Brussel","boxoffice_url":"http:\/\/ticket.visit.brussels\/nl\/553368\/happiness-art-a-positive-boost-for-your-brain\/shop","website":"http:\/\/www.happiness-expo.be","email":"lindatorfs@telenet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553368"},"en":{"name":"HAPPINESS. Art, a positive boost for your brain.","shortdescr":"HAPPINESS, a new digital exhibition and a family friendly experience full of good boosts for your brain.","longdescr":"It\u2019s official! Art makes us happy. Discover the positive boost of art on your brain in the new digital art exhibition HAPPINESS. Step inside a world of color, sound, music, and interaction. Explore 360\u00b0 art installations and discover how art gives your life more color.\r\n\r\n- An immersive experience where art and science meet\r\n- Interactive rooms full of good boosts for your brain\r\n- Multimedia art installations for young and old\r\n- Learn more about the impact of art on your happiness hormones","performers":"Studio Irma (Amsterdam, Barcelona) & PLEIN PUBLIEK Brussels","boxoffice_url":"http:\/\/ticket.visit.brussels\/en\/553368\/happiness-art-a-positive-boost-for-your-brain\/shop","website":"http:\/\/www.happiness-expo.be","email":"lindatorfs@telenet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553368"},"de":{"name":"HAPPINESS. Art, a positive boost for your brain.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.happiness-expo.be","email":"lindatorfs@telenet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.553368"},"it":{"name":"HAPPINESS. Art, a positive boost for your brain.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.happiness-expo.be","email":"lindatorfs@telenet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.553368"},"sp":{"name":"HAPPINESS. Art, a positive boost for your brain.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.happiness-expo.be","email":"lindatorfs@telenet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.553368"},"pt":{"name":"HAPPINESS. Art, a positive boost for your brain.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.happiness-expo.be","email":"lindatorfs@telenet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.553368"},"cn":{"name":"HAPPINESS. Art, a positive boost for your brain.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.happiness-expo.be","email":"lindatorfs@telenet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.553368"}},"place":{"id":273114,"translations":{"fr":{"name"