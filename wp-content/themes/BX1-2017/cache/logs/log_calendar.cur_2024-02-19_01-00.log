ets":{"list":[],"translations":{}},"tags":["kids"]},{"id":558120,"date_start":"2024-02-29","date_end":"2024-03-23","date_next":"2024-02-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-08-07T11:00:05+02:00","published_at":"2023-06-01T10:52:14+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":278120,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.6299605249474366,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"L'album photo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558120"},"pt":{"name":"L'album photo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558120"},"en":{"name":"L'album photo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558120"},"it":{"name":"L'album photo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558120"},"cn":{"name":"L'album photo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558120"},"fr":{"name":"L'album photo","shortdescr":null,"longdescr":"\u00c0 l\u2019\u00e9poque, l\u2019album photo n\u2019\u00e9tait pas une application sur votre t\u00e9l\u00e9phone. Non, c\u2019\u00e9tait un objet. Une sorte de livre \u00e0 l\u2019int\u00e9rieur duquel on collait des photos. On rangeait ces livres sur des \u00e9tag\u00e8res. On les oubliait\u2026\r\n\r\nAujourd\u2019hui, Elle, sa profession, c\u2019est album photo. Lui, il a lou\u00e9 ses services. Elle a le pouvoir de lui faire revivre les moments anodins, les repas, les conversations, les vacances. \r\nAvant les s\u00e9ances, elle pr\u00e9vient : vos culpabilit\u00e9s, vos douleurs, ce n\u2019est pas de son ressort. Elle n\u2019est pas l\u00e0 pour nous soigner, ou nous pardonner.\u202f \r\nNon. Elle est juste un album photo. \r\n\r\nLes paroles s\u2019envolent, les photos restent. Elles sont un entrelacs d\u2019images qui s\u2019assemblent, jaillissent et se succ\u00e8dent selon l\u2019axe irr\u00e9versible du temps. Venez vous plonger dans cet album photo, et ces petits moments occult\u00e9s qui nous r\u00e9v\u00e8lent ce que nous nous cachons \u00e0 nous-m\u00eame.\u202f \r\n\r\nPhilippe Blasband, gr\u00e2ce \u00e0 sa plume d\u00e9licate et franche, nous plonge, mine de rien, dans les profondeurs sublimes de nos m\u00e9lancolies. \r\n__________\r\n\r\nDe Philippe Blasband \/ Mise en sc\u00e8ne : Philippe Blasband \/ Avec : Georges Siatidis et Aylin Yay\r\n__________\r\n\r\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE ET DE LA COMMUNAUT\u00c9 FRAN\u00c7AISE.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558120"},"sp":{"name":"L'album photo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558120"},"nl":{"name":"L'album photo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558120"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_stree