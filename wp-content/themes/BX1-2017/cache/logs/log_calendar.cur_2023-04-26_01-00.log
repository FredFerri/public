dress_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[10],"translations":{"fr":["Louise"],"nl":["Louiza"],"en":["Louise"],"de":["Louise"],"it":["Louise"],"sp":["Louise"],"pt":[null],"cn":[null]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"],"de":["S\u00fcden"],"it":["Sud"],"sp":["Sur"],"pt":[null],"cn":[null]}},"neca":"gallery","facebook_id":null,"backoffice_id":1917,"location":{"lat":50.83305444,"lon":4.36110166},"region":"brussels","last_updated_at":"2023-04-23T03:08:03+02:00","published_at":"2013-10-19T01:14:44+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":238078,"translations":{"fr":{"name":"Baronian","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"Albert Baronian est l\u2019un des galeristes les plus embl\u00e9matiques de la capitale. Il a d\u00e9but\u00e9 ses activit\u00e9s dans les ann\u00e9es 70. La programmation de sa galerie refl\u00e8te ses gouts \u00e9clectiques et sensibles. Les artistes du mouvement de l\u2019arte povera comme Alighiero e Boetti ou Mario Merz y trouvent une vitrine belge pour valoriser leur travail. Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt\u2026 Le programme de la galerie est consacr\u00e9 \u00e0 l\u2019art contemporain ainsi qu'aux mouvements artistiques et aux artistes importants qui ont marqu\u00e9 les quarante derni\u00e8res ann\u00e9es. Toute proche de la place St\u00e9phanie, la galerie compte deux espaces distincts mais se faisant quasiment face : la galerie principale est install\u00e9e dans la rue Isidore Verheyden et l\u2019annexe \u00e0 la rue de la Concorde. ","description_print":"","booking_url":null,"sort_order":"Baronian ","virtual_visit":null},"nl":{"name":"Baronian","address_street_name":"Isidore Verheydenstraat","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Isidore Verheydenstraat, 2","address_line2":"1050 Elsene","description_web":"Albert Baronian is een van de meest emblematische galerijhouders in de hoofdstad, met een carri\u00e8re die eind jaren 1970 begon. Het programma van zijn galerij weerspiegelt zijn eclectische en gevoelige smaak. Kunstenaars van de arte-poverabeweging zoals Alighiero e Boetti of Mario Merz vinden er een Belgische vitrine voor hun werk. Nu circuleren er namen als Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt en vele anderen. Het programma van de galerij is daarmee zowel gewijd aan de hedendaagse kunst als aan de kunststromingen en kunstenaars die de laatste veertig jaar hun stempel hebben gedrukt. Vlakbij het Stefaniaplein beschikt de galerie over twee verschillende, maar bijna tegenover elkaar liggende ruimtes: de hoofdgalerie bevindt zich in de Isidore Verheydenstraat en het bijgebouw in de Eendrachtsstraat. ","description_print":"","booking_url":null,"sort_order":"Baronian ","virtual_visit":null},"en":{"name":"Baronian","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"Albert Baronian is one of the most emblematic gallery owners in the capital and began his activities in the 1970s. The programme of his gallery reflects his eclectic and sensitive tastes. Artists from the arte povera movement such as Alighiero e Boetti or Mario Merz are given a Belgian showcase for their work. Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt... The gallery's programme is devoted to contemporary art as well as to important artistic movements and artists who have marked the last forty years. Close to place St\u00e9phanie, the gallery has two distinct, but almost opposite spaces: the main gallery is located in rue Isidore Verheyden and the annex in rue de la Concorde.  \r\nAlbert Baronian opened his first gallery in 1973 and immediately enjoyed international success thanks to the presentation of Arte Povera artists Alighiero e Boetti, Mario Merz, Giulio Paolini, Gilberto Zorio. Later, as the president of the Galleries\u2019 Association, the Brussels Art fair took a more international turn whilst under his direction. He sees the responsibility of the gallery as three folds: to work for the long term development of each artists\u2019 career, acting as a liaison to international galleries and museums as well as placing works in collections; to create an historical archive for each artist; and to act as an accessible public space in which the exhibitions become an exemplary gesture of the power of subjectivity to the audience at large. The program is dedicated to contemporary art as well as important artistic movements and artists that have defined the last forty years. \u00bb \r\n","description_print":"","booking_url":null,"sort_order":"Baronian ","virtual_visit":null},"de":{"name":"Baronian Xippas","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_li