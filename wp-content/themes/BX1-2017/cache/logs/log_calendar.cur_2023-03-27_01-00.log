fice_id":268107,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":553661,"date_start":"2023-03-31","date_end":"2023-04-01","date_next":"2023-03-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[54],"translations":{"fr":["One man Show et humour"],"nl":["Onemanshow en humor"],"en":["One man show and comedy"],"de":["One Man Show & Comedy"],"it":["One man Show e comicit\u00e0"],"sp":["Espect\u00e1culo unipersonal y humor"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Marie Patrick + Oncle Nis (Nuit 3 : Les Nuits du Magic Hall)","shortdescr":null,"longdescr":"J\u00e9r\u00e9my Leruitte\u00a0\u00a0alias Oncle Nis\u00a0\u00a0n\u2019est pas encore une t\u00eate d\u2019affiche mais cela ne saurait tarder. Nous l\u2019avons d\u00e9couvert en premi\u00e8re partie du spectacle d\u2019Amandine Elsen, il revient cette fois-ci partager la sc\u00e8ne avec Evelyne Demaude. Une v\u00e9ritable p\u00e9pite !\r\n\r\nEvelyne Demaude n\u2019est pas une inconnue. Elle s\u2019est produite sur de nombreuses sc\u00e8nes et au cin\u00e9ma. Vous l\u2019avez peut-\u00eatre aussi d\u00e9j\u00e0 vu au Magic Land dans Silver Lake, r\u00e9cemment dans la l\u00e9gende de King Arthur ou dans Transg\u00e9nique Marquise des Anges. Elle s\u2019inspire de ces femmes de prestance telle une Genevi\u00e8ve de Fontenay, ou d\u2019une Christine Lagarde. Elle oscille entre le jeu clownesque et le bouffon, s\u2019amuse \u00e0 caricaturer puis appuyer l\u00e0 o\u00f9 c\u2019est plus sensible. Elle nous revient avec son \u00ab seule en sc\u00e8ne \u00bb Marie Patrick Ducolvert\u2026 Un personnage d\u00e9capant !\r\n\r\nL\u2019Oncle Nis met en priorit\u00e9 le plaisir d\u2019un moment ensemble. Un humour absurde qu\u2019il pense accessible \u00e0 tous. Un univers bien \u00e0 lui qui vaut le peine de tenter de comprendre. Nous ne garantissons pas que vous puissiez le suivre \u00e0 100% dans ses pens\u00e9es virevoltantes mais nous pouvons assurer que ce moment sera riche de partage. Faisant des allers et venus sur sc\u00e8ne depuis ses 19 ans, il d\u00e9barque cette fois au Magic Land avec l\u2019ambition de vous pr\u00e9senter sa fa\u00e7on de voir le monde. Vous expliquant tant bien que mal votre corps et ses secrets. Un voyage anatomique et introspectif puissant qui vous fera red\u00e9couvrir ce tas d\u2019os et de chair qui vous compose.\u00a0\r\n\r\nA d\u00e9couvrir absolument !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"chloe@magicland-theatre.com","phone_contact":"+32 495 26 18 42","phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553661"},"nl":{"name":"Marie Patrick + Oncle Nis (Nuit 3 : Les Nuits du Magic Hall)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"chloe@magicland-theatre.com","phone_contact":"+32 495 26 18 42","phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553661"},"en":{"name":"Marie Patrick + Oncle Nis (Nuit 3 : Les Nuits du Magic Hall)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"chloe@magicland-theatre.com","phone_contact":"+32 495 26 18 42","phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553661"},"de":{"name":"Marie Patrick + Oncle Nis (Nuit 3 : Les Nuits du Ma