":false,"is_soldout":false,"last_updated_at":"2025-02-26T01:02:35+01:00","published_at":"2025-01-09T11:11:53+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":315911,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"tour","ranking":0.14384239566619703,"languages":{"spoken":["es","fr","it","de","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[104],"translations":{"de":["Jugendstil, Art d\u00e9co"],"pt":[null],"en":["Art Nouveau, Art D\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"cn":[null],"fr":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"Art D\u00e9co \u00e0 Uccle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005245"},"pt":{"name":"Art D\u00e9co \u00e0 Uccle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005245"},"en":{"name":"Art D\u00e9co \u00e0 Uccle","shortdescr":"Follow the guide on this itinerary of lesser-known architectural qualities. You'll discover the Glass House built by Paul Amaury Michel, and the personalities of Henry Van de Velde, Robert Puttemans, Jo Ramaekers and Charles Colassin.","longdescr":"Follow the guide on this itinerary of lesser-known architectural qualities. You'll discover the Glass House built by Paul Amaury Michel, and the personalities of Henry Van de Velde, Robert Puttemans, Jo Ramaekers, Charles Colassin... You'll also get a glimpse of the Place Brugmann district - dominated by the Church of the Annunciation and the former Red Cross Clinic - and the Mus\u00e9e van Buuren, with its preserved Art Deco decor and vast garden.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005245"},"it":{"name":"Art D\u00e9co \u00e0 Uccle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005245"},"cn":{"name":"Art D\u00e9co \u00e0 Uccle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005245"},"fr":{"name":"Art D\u00e9co \u00e0 Uccle","shortdescr":"Suivez le guide dans cet itin\u00e9raire aux qualit\u00e9s architecturales moins connues. Vous d\u00e9couvrirez la Maison de Verre construite par Paul Amaury Michel, les personnalit\u00e9s de Henry Van de Velde, Robert Puttemans, Jo Ramaekers, Charles Colassin","longdescr":"Suivez le guide dans cet itin\u00e9raire aux qualit\u00e9s architecturales moins connues. Vous d\u00e9couvrirez la Maison de Verre construite par Paul Amaury Michel, les personnalit\u00e9s de Henry Van de Velde, Robert Puttemans, Jo Ramaekers, Charles Colassin\u2026 Vous aurez \u00e9galement un aper\u00e7u du quartier de la place Brugmann - domin\u00e9 par l\u2019\u00e9glise de l\u2019Annonciation et par l\u2019ancienne Clinique de la Croix-Rouge-, et du Mus\u00e9e van Buuren, au d\u00e9cor Art D\u00e9co pr\u00e9serv\u00e9 ainsi que son vaste jardin.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005245"},"sp":{"name":"Art D\u00e9co \u00e0 Uccle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005245"},"nl":{"name":"Art D\u00e9co \u00e0 Uccle","shortdescr":"Volg de gids op deze route langs minder bekende architecturale kwaliteiten. Je ontdekt het Glazen huis van Paul Amaury Michel en de persoonlijkheden van Henry Van de Velde, Robert Puttemans, Jo Ramaekers en Charles Colassin.","longdescr":"Volg de gids op deze route langs minder bekende architecturale kwaliteiten. Je ontdekt het Glazen huis van Paul Amaury Michel en de persoonlijkheden van Henry Van de Velde, Robert Puttemans, Jo Ramaekers, Charles Colassin... Je krijgt ook een glimp te zien van de wijk Brugmannplein - gedomineerd door de Annunciatiekerk en de voormalige Rode Kruiskliniek - en het Mus\u00e9e van Buuren, met zijn goed bewaarde art-decovers en uitgestrekte tuin.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005245"}},"place":{"id":267559,"translation