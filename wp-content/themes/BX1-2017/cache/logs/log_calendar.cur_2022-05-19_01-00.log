centre-ville aux estaminets ruraux du 19\u00e8me si\u00e8cle, de l\u2019ancienne laiterie pr\u00e9sente aux p\u00e9riph\u00e9ries de la ville aux guinguettes modernes et branch\u00e9es. Bruxelles se raconte \u00e0 travers ses bars et ses c\u00e9l\u00e8bres \u00e9tablissements. Sautez en selle pour une balade liant grande histoire et anecdotes de comptoir. La balade se terminera par un moment convivial dans l\u2019un des nombreux caf\u00e9s de la capitale.\n*consommation personnelle \u00e0 r\u00e9gler par les visiteurs*","performers":null,"boxoffice_url":null,"website":"http:\/\/www.provelo.org","email":"info@provelo.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531784.html"},"nl":{"name":"De l'estaminet au Carberdouche - Bruxelles et ses caf\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531784.html"},"en":{"name":"De l'estaminet au Carberdouche - Bruxelles et ses caf\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531784.html"},"de":{"name":"De l'estaminet au Carberdouche - Bruxelles et ses caf\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531784.html"},"it":{"name":"De l'estaminet au Carberdouche - Bruxelles et ses caf\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531784.html"},"sp":{"name":"De l'estaminet au Carberdouche - Bruxelles et ses caf\u00e9s","shortdescr":null,