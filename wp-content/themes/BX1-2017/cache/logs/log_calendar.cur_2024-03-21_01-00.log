tact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008453"},"en":{"name":"Pourvu qu'on ait l'ivresse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008453"},"it":{"name":"Pourvu qu'on ait l'ivresse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008453"},"cn":{"name":"Pourvu qu'on ait l'ivresse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008453"},"fr":{"name":"Pourvu qu'on ait l'ivresse","shortdescr":"POURVU QU\u2019ON AIT L\u2019IVRESSE\nUn spectacle cont\u00e9 pour adultes","longdescr":"\u00ab Pourvu qu\u2019on ait l\u2019ivresse \u00bb est un r\u00e9cit pour adultes, une travers\u00e9e po\u00e9tique et \u00e9mouvante, dr\u00f4le \u00e0 certains moments, parfois tragique, mais sensible d\u2019un bout \u00e0 l\u2019autre de la corde tendue au-dessus du vide. Car voil\u00e0 bien le th\u00e8me r\u00e9el de ce spectacle : le vide inh\u00e9rent \u00e0 toute existence, la vacuit\u00e9 \u00e0 la fois terrible et joyeuse laiss\u00e9e par le temps qui passe inexorablement, le n\u00e9ant absurde que nous promet la mort, le \u00ab creux n\u00e9ant musicien \u00bb que nous offre la vie.\n\nAu cours de ce spectacle, vous suivrez le parcours chaotique de Lilah, une trentenaire \u00e0 la d\u00e9rive qui \u00e9choue, par hasard, au Pays de l'ivresse. Cet endroit pittoresque et chaleureux abrite Margot, la reine des lieux, et cinq moines tr\u00e8s particuliers. Ceux-ci racontent des histoires inspir\u00e9es des \u0153uvres d\u2019Ovide, de Rabelais ou de Daudet, tandis que Margot pousse la chansonnette.\n\nDurant une heure et demie, une quinzaine de personnages prendront vie sous vos yeux. Vous voyagerez d\u2019un bistrot au sommet d\u2019une montage, vous passerez du rire aux larmes, et vous repartirez peut-\u00eatre heureux d\u2019avoir pleur\u00e9.","performers":"\u00c9crit et interpr\u00e9t\u00e9 par la Compagnie des c\u0153urs vagabonds - Artistes : Simone Balthazar et Beno\u00eet Vincent","boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008453"},"sp":{"name":"Pourvu qu'on ait l'ivresse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008453"},"nl":{"name":"Pourvu qu'on ait l'ivresse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008453"}},"place":{"id":248422,"translations":{"de":{"name":"Le Petit Chapeau Rond Rouge","address_street_name":"Rue P\u00e8re Eudore Devroye","address_street_number":"12","address_street_box":null,"email":"info@lepetitchapeaurondrouge.be","website":"http:\/\/www.lepetitchapeaurondrouge.be","phone_contact":"+32 498 51 35 63","phone_booking":"+32 498 51 35 63","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue P\u00e8re Eudore Devroye, 12","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":