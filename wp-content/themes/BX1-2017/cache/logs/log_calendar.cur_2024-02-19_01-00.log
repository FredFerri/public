en laatste zaterdags van de maand van 14:00 tot 16:00","en":"Open the first, second, third, fourth and last saturdays of the month from 14:00 to 16:00"}}],"targets":{"list":[7,5,10,16,11,19,8,12],"translations":{"de":["Jugendliche 12-15 Jahre","Kinder 9-12 Jahre","Senioren","Schulen","Familie","Lehrkr\u00e4fte","Jugendliche 15-18 Jahre","LGTBQIA"],"pt":[null,null,null,null,null,null,null,null],"en":["Youth 12-15  yr.","Children 9-12 yr.","Seniors","Schools","Family","Teachers","Youth 15-18  yr.","LGTBQIA"],"it":["Ragazzi 12-15 anni","Bambini 9-12 anni","Anziani","Scuole","Famiglie","Insegnanti","Ragazzi 15-18 anni","LGTBQIA"],"cn":[null,null,null,null,null,null,null,null],"fr":["Jeunes 12-15 ans","Enfants 9-12 ans","Seniors","Ecoles","Famille","Enseignants","Jeunes 15-18 ans","LGTBQIA"],"sp":["J\u00f3venes de 12 a 15 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os","Personas de la tercera edad","Escuelas","Familias","Profesores","J\u00f3venes de 15 a 18 a\u00f1os","LGTBQIA"],"nl":["Jongeren 12-15 j.","Kinderen 9-12 j.","Senioren","Scholen","Familie","Leerkrachten","Jongeren 15-18 j.","LGTBQIA"]}},"educational_targets":{"list":[8,6,7,3,9],"translations":{"de":["14 - 16 Jahre","10 - 12 Jahre","12 - 14 Jahre","Sekundarstufe","16 - 18 Jahre"],"pt":[null,null,null,null,null],"en":["14 - 16 years","10 - 12 years","12 - 14 years","Secondary school","16 - 18 years"],"it":["14 - 16 anni","10 - 12 anni","12 - 14 anni","Medie","16 - 18 anni"],"cn":[null,null,null,null,null],"fr":["14 - 16 ans","10 - 12 ans","12 - 14 ans","Secondaire","16 - 18 ans"],"sp":["14 - 16 a\u00f1os","10 - 12 a\u00f1os","12 - 14 a\u00f1os","Estudiantes de secundaria","16 - 18 a\u00f1os"],"nl":["14 - 16 jaar","10 - 12 jaar","12 - 14 jaar","Secundair onderwijs","16 - 18 jaar"]}},"tags":["kids"]},{"id":50006754,"date_start":"2024-02-25","date_end":"2024-02-25","date_next":"2024-02-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-06T11:30:01+01:00","published_at":"2024-02-02T08:53:22+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":293720,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Ren\u00e9 Magritte By Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/escapades-rene-magritte?id_evenement=5798","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006754"},"pt":{"name":"Ren\u00e9 Magritte By Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/escapades-rene-magritte?id_evenement=5798","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006754"},"en":{"name":"Ren\u00e9 Magritte By Concerts Escapades","shortdescr":"Concert Ren\u00e9 Magritte, because while painting he listened to Eric Satie. \nLes Concerts Escapades invites you to discover the world of Ren\u00e9 Magritte through music, in the form of a Satie recital.  But that's not all: the musicians in whom the Escapade team has placed its trust have also come up with some of their favorite soft music.\n\n\n\n\n","longdescr":"This is not a concert !\n-\nOn the other hand, Concerts Escapades is often about encounters: \nPjotr and Sanne, two art students, were invited to create a social project linked to culture.\n-\nThey thought of ESCAPADES and proposed a concert around an artist to our programming team. They proposed 10, and the ESCAPADIENS chose Magritte.\nCoincidentally, one of our board members told us that his mother knew Ren\u00e9 Magritte. It seems he had very particular musical tastes while painting : Satie and only Satie! \n-\nThat's why, for this Ren\u00e9 Magritte concert, we're offering almost all the Gymnop\u00e9dies and Gnossiennes. \n-\nHowever, the musicians in whom the Escapade team has confidence are not very enthusiastic about the idea of a mini-recital devoted exclusively to Satie. So we gave them the choice of presenting an additional piece of their favorite music, as long as it is soft.\n-\nProgram :\nEric Satie - Gnossiennes & Gymnopedies\nGuillaume Lekeu - 3 pieces for piano \nJohannes Brahms - Intermezzo 117 nr 1\nFr\u00e9d\u00e9ric Chopin - Fantasy & Impromptu op. 66\n-\nIn the \"Boudoir\" auditorium at La Tricoterie.\n... And don't forget that the shows begin and continue at La Tricoterie's bar and restaurant, open Sunday until 11:00 pm.\n","performers":"Nikolaas Kende (piano) - Olga Andryushenko (piano) - Veronika Iltchenko (piano)","boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/escapades-rene-magritte?id_evenement=5798","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006754"},"it":{"name":"Ren\u00e9 Magritte By Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/escapades-rene-magritte?id_evenement=5798","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006754"},"cn":{"name":"Ren\u00e9 Magritte By Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/escapades-rene-magritte?id_evenement=5798","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006754"},"fr":{"name":"Concert Ren\u00e9 Magritte By Concerts Escapades","shortdescr":"Concert Ren\u00e9 Magritte, parce qu'en peignant il \u00e9coutait Eric Satie. \nLes Concerts Escapades vous font d\u00e9couvrir l'univers de Ren\u00e9 Magritte en musique, sous la forme d'un r\u00e9cital Satie.  Mais ce n'est pas tout : les musiciens auxquels l'\u00e9quipe d'Escapade a accord\u00e9 sa confiance ont \u00e9galement propos\u00e9 quelques-unes de leurs musiques douces pr\u00e9f\u00e9r\u00e9es.\n","longdescr":"Ceci n'est pas un concert ! \n-\nEn revanche, Concerts Escapades est souvent une affaire de rencontres : \nPjotr et Sanne, deux \u00e9tudiants en \u00e9cole d\u2019art, ont \u00e9t\u00e9 invit\u00e9s \u00e0 cr\u00e9er un projet social li\u00e9 \u00e0 la culture.\n-\nIls ont pens\u00e9 \u00e0 ESCAPADES et nous ont propos\u00e9 un concert autour d'un artiste \u00e0 notre \u00e9quipe de programmation. Ils en ont propos\u00e9 10, et les ESCAPADIENS ont choisi Ren\u00e9 Magritte.\nPar co\u00efncidence, l'un des membres de notre conseil d'administration nous a dit que sa m\u00e8re connaissait Ren\u00e9 Magritte. Il semble qu'il avait des go\u00fbts musicaux tr\u00e8s particuliers, en peignant  il \u00e9coutait, Satie et seulement Satie ! \n-\nC'est pourquoi, pour ce concert Ren\u00e9 Magritte, nous proposons la quasi-totalit\u00e9 des Gymnop\u00e9dies et des Gnossiennes. \n-\nCependant, les musiciens en qui l'\u00e9quipe de l'Escapade a confiance ne sont pas tr\u00e8s enthousiastes \u00e0 l'id\u00e9e d'un mini-r\u00e9cital consacr\u00e9 exclusivement \u00e0 Satie. Donc ce n'est pas tout : les musiciens ont \u00e9galement propos\u00e9 quelques-unes de leurs musiques douces pr\u00e9f\u00e9r\u00e9es.\n-\nProgramme :\nEric Satie - Gnossiennes & Gymnopedies\nGuillaume Lekeu - 3 pieces pour piano \nJohannes Brahms - Intermezzo 117 nr 1\nFr\u00e9d\u00e9ric Chopin - Fantasie & Impromptu op. 66\n-\nDans l'auditorium \"Boudoir\" de La Tricoterie.\n... Et n'oubliez pas que les spectacles commencent et se poursuivent au bar-restaurant de La Tricoterie, ouvert le dimanche jusqu'\u00e0 23 heures.\n","performers":"Nikolaas Kende (piano) - Olga Andryushenko (piano) - Veronika Iltchenko (piano) - ","boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/escapades-rene-magritte?id_evenement=5798","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006754"},"sp":{"name":"Ren\u00e9 Magritte By Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/escapades-rene-magritte?id_evenement=5798","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006754"},"nl":{"name":"Ren\u00e9 Magritte By Concerts Escapades","shortdescr":"Concert Ren\u00e9 Magritte, omdat hij tijdens het schilderen luisterde naar Eric Satie. \nLes Concerts Escapades nodigt je uit om de wereld van Ren\u00e9 Magritte te ontdekken via muziek, in de vorm van een Satie-recital.  Maar dat is nog niet alles: de muzikanten in wie het Escapade-team zijn vertrouwen heeft gesteld, hebben ook enkele van hun favoriete zachte muziekjes bedacht.\n","longdescr":"Dit is geen concert!\n-\nAan de andere kant gaat Concerts Escapades vaak over ontmoetingen: \nPjotr en Sanne, twee kunststudenten, werden uitgenodigd om een sociaal project rond cultuur te cre\u00ebren.\n-\nZe dachten aan ESCAPADES en stelden ons programmeringsteam een concert voor rond een artiest. Zij stelden er 10 voor en de ESCAPADIENS kozen Magritte.\nToevallig vertelde een van onze bestuursleden ons dat zijn moeder Ren\u00e9 Magritte kende. Het schijnt dat hij, schilderend,  een bijzondere muzikale smaak had: Satie en alleen Satie! \n-\nDaarom bieden we voor dit Ren\u00e9 Magritte-concert bijna alle Gymnop\u00e9dies en Gnossiennes aan. \n-\nDe musici in wie het Escapade-team vertrouwen heeft, zijn echter niet erg enthousiast over het idee van een minirecital uitsluitend gewijd aan Satie. Dus gaven we hen de keuze om een extra stuk van hun favoriete muziek te presenteren.\n-\nProgramma :\nEric Satie - Gnossiennes & Gymnopedies\nGuillaume Lekeu - 3 stukken voor piano \nJohannes Brahms - Intermezzo 117 nr 1\nFr\u00e9d\u00e9ric Chopin - Fantasie & Impromptu op. 66\n-\nIn de \"Boudoir\" kamer in La Tricoterie.\n... En vergeet niet dat de shows beginnen en eindigen in het bar-restaurant van La Tricoterie, dat op zondag tot middernacht geopend is.\n","performers":"Nikolaas Kende (piano) - Olga Andryushenko (piano) - Veronika Iltchenko (piano)","boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/escapades-rene-magritte?id_evenement=5798","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006754"}},"place":{"id":252101,"translations":{"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie est un projet culturel fond\u00e9 en 2010 par une poign\u00e9e de citoyen\u00b7nes et situ\u00e9 dans une ancienne usine restaur\u00e9e avec des mat\u00e9riaux \u00e9cologiques. La Tricoterie propose une programmation culturelle tr\u00e8s diversifi\u00e9e et centr\u00e9e sur la rencontre entre les diff\u00e9rents publics et le m\u00e9lange des activit\u00e9s culturelles.\r\n\r\nPassez la porte et d\u00e9couvrez :\r\n- Des spectacles de th\u00e9\u00e2tre, de danse, de cirque...\r\n- Des concerts, des soir\u00e9es, des sc\u00e8nes ouvertes, des jam sessions, une chorale d'un soir...\r\n- Des ateliers z\u00e9ro d\u00e9chet, peinture, c\u00e9ramique, \u0153nologie, danse...\r\n- Des projections de films, conf\u00e9rences, d\u00e9bats...\r\n- Des couscous \"s\u00e9pharabes\", des soir\u00e9es jeux de soci\u00e9t\u00e9, des activit\u00e9s pour enfants...\r\n- Des march\u00e9s des cr\u00e9ateur\u00b7rices, des vide-dressings, des march\u00e9s de No\u00ebl durables...\r\n\r\nUn petit creux ? La Triciterie vous propose un brunch tous les dimanches et un concept \"live cooking\" tous les vendredis soirs. Tous les plats sont 100% artisanaux, et pr\u00e9par\u00e9s sur place par l'\u00e9quipe avec des ingr\u00e9dients bio, locaux et de saison.\r\n\r\nEnvie d'organiser votre \u00e9v\u00e9nement chez vous ? La Tricoterie met ses salles \u00e0 disposition pour tout type d'\u00e9v\u00e9nement priv\u00e9 ou professionnel et propose \u00e9galement un service traiteur, que ce soit dans ses murs ou \u00e0 l'ext\u00e9rieur. Rendez-vous sur www.tricoterie.be pour en savoir plus !\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl":["Sint-Gillis centrum"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":14176,"location":{"lat":50.83028735,"lon":4.33675871},"region":"brussels","last_updated_at":"2024-01-25T14:21:07+01:00","published_at":"2013-10-19T01:47:56+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276119,"translations":{"de":{"name":"Music Projects for Brussels ","address_street_name":null,"addre