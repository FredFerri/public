e27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-24T02:00:25+02:00","published_at":"2023-06-01T10:52:26+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":278358,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5665163349427048,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Zazie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558358"},"pt":{"name":"Zazie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558358"},"en":{"name":"Zazie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558358"},"it":{"name":"Zazie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558358"},"cn":{"name":"Zazie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558358"},"fr":{"name":"Zazie !","shortdescr":null,"longdescr":"Un vent de fraicheur va se glisser au Public en ce mois de juin. Sur les traces de Zazie, une mouflette de 12 ans \u00e0 la langue bien pendue, on red\u00e9couvre Paris, de la tour Eiffel au Moulin Rouge. Curieuse insatiable, elle s\u00e8me la zizanie dans le monde des adultes et le m\u00e9tamorphose en terrain de jeux. La gamine d\u00e9lur\u00e9e, qui traverse la vie hors des clous, qui d\u00e9fie la grammaire, pose toutes les questions interdites aux fillettes, passe son temps \u00e0 jurer et va mettre Paris cul par-dessus t\u00eate. \r\n\r\nToute une troupe d\u2019artistes inspir\u00e9s s\u2019est empar\u00e9e du chef-d\u2019\u0153uvre de Queneau et nous le restituent \u00e0 merveille. La langue, les personnages, les lieux... toute l\u2019\u0153uvre y est magnifiquement incarn\u00e9e. C\u2019est d\u00e9coiffant.\r\n\r\nV\u00e9ritable trompe-l\u2019\u0153il entre r\u00eaverie et r\u00e9alit\u00e9, enfance et maturit\u00e9, ce spectacle est un voyage initiatique qui questionne notre rapport \u00e0 l\u2019identit\u00e9 et au genre.\r\nC\u2019est loufoque, intelligent, impertinent. La r\u00e9alisation p\u00eachue nous la rend contemporaine, cette Zazie-l\u00e0, ludique, philosophique, po\u00e9tique... d\u00e9jant\u00e9e. \r\n\r\nEt vous savez quoi ? C\u2019est l\u2019occaz d\u2019amener m\u00e9m\u00e9 Jacquotte et tonton Fernand au Public. Et aussi les ados de la voisine du premier, et les rejetons de la cousine Hortense. Voici un spectacle qui va leur faire aimer le th\u00e9\u00e2tre.\r\n__________\r\n\r\nD'apr\u00e8s \"Zazie dans le m\u00e9tro\" de Raymond Queneau \/ Mise en sc\u00e8ne : Sh\u00e9rine Seyad \/ Avec : Allan Bertin, L\u00e9na\u00efc Brul\u00e9, Colin Javaux, Virgile Magniette, Sh\u00e9rine Seyad, R\u00e9al Siellez et Arnaud Van Parys \r\n__________\r\n\r\nUNE CR\u00c9ATION DE LA CIE DEBOUT SUR LA CHAISE, R\u00c9ALIS\u00c9E AVEC L\u2019AIDE DE LA COCOF \u2013 LE TH\u00c9\u00c2TRE MERCELIS\/COMMUNE D\u2019IXELLES \u2013 LE TH\u00c9\u00c2TRE MARNI, LE CENTRE CULTUREL WOLUBILIS, LE COCQ\u2019ARTS FESTIVAL, LA PROVINCE DE LI\u00c8GE ET LE BAMP.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558358"},"sp":{"name":"Zazie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558358"},"nl":{"name":"Zazie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558358"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","