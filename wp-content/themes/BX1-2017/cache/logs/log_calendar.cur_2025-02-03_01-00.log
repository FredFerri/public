turel Jacques Franck est situ\u00e9 dans une des grandes art\u00e8res commerciales de Saint-Gilles. A l\u2019origine un petit cin\u00e9ma de quartier baptis\u00e9 le \u00ab Saint-Gillois \u00bb et ensuite transform\u00e9 en th\u00e9\u00e2tre, le lieu est finalement affect\u00e9 comme centre culturel par le S\u00e9nateur-Bourgmestre Jacques Franck. Lieu de rencontre, de dialogue, de d\u00e9bat culturel, la programmation propose des oeuvres de qualit\u00e9, privil\u00e9giant la cr\u00e9ation contemporaine, notamment les arts de la sc\u00e8ne, sous forme de r\u00e9sidences d'artistes, de coproduction ou de partenariat. Cette planification s'inscrit au sein d'un projet culturel global favorisant le croisement des cultures et des g\u00e9n\u00e9rations.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Waterloo, 94","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CC Jacques Franck","address_street_name":"Waterlose Steenweg","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Waterlose Steenweg, 94","address_line2":"1060 Sint-Gillis","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gil