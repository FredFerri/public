e_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":295911,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.40775815911254065,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"Expo Golf 50 Years","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.autoworld.be\/fr\/expos\/32\/vw-golf-50th-anniversary","email":"info@autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008052"},"pt":{"name":"Expo Golf 50 Years","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.autoworld.be\/fr\/expos\/32\/vw-golf-50th-anniversary","email":"info@autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008052"},"en":{"name":"Expo Golf 50 Years","shortdescr":"From the 1st of March until the 28th of April Autoworld will be honouring 50 years of the Volkswagen Golf. At its birth, the successor to the VW Beetle was given the leaden task of doing at least as well. The decision was made to make a radical style change with the VW Golf. The Golf will not only succeed the Beetle, but become the most successful European car ever. And the rest is history!","longdescr":"From the 1st of March until the 28th of April Autoworld will be honouring 50 years of the Volkswagen Golf. At its birth, the successor to the VW Beetle was given the leaden task of doing at least as well.  But how do you follow up the best-selling car of all time? The decision was made to make a radical style change with the introduction of the VW Golf. The Golf will not only succeed the Beetle, but become the most successful European car ever. And the rest is history, which you can come and see at Autoworld from 1 March.","performers":"Autoworld","boxoffice_url":null,"website":"https:\/\/www.autoworld.be\/en\/expos\/32\/vw-golf-50th-anniversary","email":"info@autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008052"},"it":{"name":"Expo Golf 50 Years","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.autoworld.be\/fr\/expos\/32\/vw-golf-50th-anniversary","email":"info@autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008052"},"cn":{"name":"Expo Golf 50 Years","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.autoworld.be\/fr\/expos\/32\/vw-golf-50th-anniversary","email":"info@autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008052"},"fr":{"name":"Expo Golf 50 Years","shortdescr":"Du 1er mars au 28 avril, Autoworld rendra hommage aux 50 ans de la Volkswagen Golf. \u00c0 sa naissance, le successeur de la Coccinelle VW s'est vu confier la lourde t\u00e2che de faire au moins aussi bien. La d\u00e9cision a \u00e9t\u00e9 prise d'op\u00e9rer un changement radical de style avec la VW Golf. La Golf deviendra la voiture europ\u00e9enne la plus r\u00e9ussie de tous les temps. Et le reste, c'est de l'histoire!","longdescr":"Du 1er mars au 28 avril, Autoworld rendra hommage aux 50 ans de la Volkswagen Golf. \u00c0 sa naissance, le successeur de la Coccinelle VW s'est vu confier la lourde t\u00e2che de faire au moins aussi bien. Mais comment suivre la voiture la plus vendue de tous les temps ? La d\u00e9cision a \u00e9t\u00e9 prise d'op\u00e9rer un changement radical de style avec l'introduction de la VW Golf. La Golf ne succ\u00e9dera pas seulement \u00e0 la Coccinelle, mais deviendra la voiture europ\u00e9enne la plus r\u00e9ussie de tous les temps. Et le reste, c'est de l'histoire, que vous pouvez venir d\u00e9couvrir chez Autoworld \u00e0 partir du 1er mars.","performers":"Autoworld","boxoffice_url":null,"website":"https:\/\/www.autoworld.be\/fr\/expos\/32\/vw-golf-50th-anniversary","email":"info@autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008052"},"sp":{"name":"Expo Golf 50 Years","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.autoworld.be\/fr\/expos\/32\/vw-golf-50th-anniversary","email":"info@autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008052"},"nl":{"name":"Expo Golf 50 Years","shortdescr":"Autoworld eert van 1 maart tot 28 april 50 jaar Volkswagen Golf. De opvolger van de VW Kever kreeg bij z\u2019n geboorte de loodzware taak minstens even goed te doen.  Er wordt besloten een radicale stijlbreuk door te voeren met de introductie van de VW Golf. De Golf zal niet enkel de Kever opvolgen, maar de meest succesvolle Europese wagen ooit worden. En de rest is geschiedenis!","longdescr":"Autoworld eert van 1 maart tot 28 april 50 jaar Volkswagen Golf. De opvolger van de VW Kever kreeg bij z\u2019n geboorte de loodzware taak minstens even goed te doen.  Maar hoe volg je de meest verkochte auto allertijden op? Er wordt besloten een radicale stijlbreuk door te voeren met de introductie van de VW Golf. De Golf zal niet enkel de Kever opvolgen, maar de meest succesvolle Europese wagen ooit worden. En de rest is geschiedenis, die je vanaf 1 maart kan komen bezichtigen in Autoworld.","performers":"Autoworld","boxoffice_url":null,"website":"https:\/\/www.autoworld.be\/nl\/expos\/32\/vw-golf-50th-anniversary","email":"info@autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008052"}},"place":{"id":734,"translations":{"de":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":"Autoworld ist ein au\u00dfergew\u00f6hnlicher Ort, einzigartig in seiner Architektur, seiner Sammlung und den dort organisierten Ausstellungen.\r\nDas Museum befindet sich in einem repr\u00e4sentativen Geb\u00e4ude des Parc du Cinquantenaire, welches  1880 anl\u00e4sslich des 50. Jahrestages der Gr\u00fcndung des K\u00f6nigreichs Belgien erbaut wurde.\r\n\r\nMehr als 300 Fahrzeuge, Reisebusse und Motorr\u00e4der unterschiedlicher Herkunft zeichnen die Geschichte des Automobils nach und veranschaulichen die spektakul\u00e4re Entwicklung von Fahrzeugen \u00fcber mehr als ein Jahrhundert. Die emblematischsten Autos jeder Epoche erm\u00f6glichen es au\u00dferdem, die Entwicklung des Autodesigns von Anfang an bis heute zu verfolgen.\r\nThemenbereiche beleuchten spezifische Aspekte dieser Geschichte. Der \u201eSport & Wettbewerb\u201c Abschnitt zeichnet die Meilensteine des Motorsport (Rallyes und Rennen) seit 1906. \r\n\u201eMan darf nicht vergessen, dass unser Land im fr\u00fchen 20. Jahrhundert eines der wichtigsten Automobilhersteller war\u201c.\r\nIm neuen \"Media Room\" erz\u00e4hlen Filme, Videos und historische Dokumente diese Geschichte ebenso wie die automobile Entwicklung der letzten 30 Jahre.\r\n\r\nTempor\u00e4re Ausstellungen werden regelm\u00e4\u00dfig organisiert.\r\n\r\nWeitere Informationen und den Messekalender finden Sie unter: www.autoworld.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":"Esquecemo-nos frequentemente que o autom\u00f3vel foi um dos baluartes da ind\u00fastria belga antes da Segunda Guerra Mundial: Minerva, FN, Imperia, Nagant, Germain, Vivinus, para citar alguns dos mais importantes. A estrutura met\u00e1lica do museu foi concebida em 1880. Abrigou o Sal\u00e3o Autom\u00f3vel de 1902 a 1934. O museu pode ser considerado como um dos mais prestigiosos do seu g\u00e9nero na Europa, ou mesmo no mundo (cerca de 400 ve\u00edculos, todos operacionais). Podemos a\u00ed reviver a hist\u00f3ria do autom\u00f3vel, de 1886 aos anos 70, da Ford T, passando pela 2CV da Citro\u00ebn, a Carocha alem\u00e3, a Tatra checoslovaca e alguns modelos raros que pertenceram a celebridades do nosso s\u00e9culo (\u00e0 fam\u00edlia real belga ou um ve\u00edculo especialmente concebido de acordo com as exig\u00eancias do X\u00e1 da P\u00e9rsia, mas nunca fornecido).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Brussels","description_web":"An impressive historic building in Brussels, linked with automotive history, is home to Autoworld, the Belgian National Automobile Museum. Situated in the \u2018Parc du Cinquantenaire\u2019, the neo-classical building commemorated the 50th anniversary of the Kingdom of Belgium in 1880. From 1902 to 1936 it hosted motor\u00accar and motorbike exhibitions. Since 1986 it has treasured the major part of Ghislain Mahy\u2019s renowned classic car collection. \r\n\r\nOver 300 vehicles, ranging from cars and trucks to motorcycles, are on permanent display. From the earliest models of the dis\u00actant past to contemporary cars that prefigure the automobile of tomorrow, visitors are guided through the motorcar\u2019s history dating as far back as 1896. \r\n\r\nVarious cars representing the most exciting years of the auto\u00acmobile history since 1960 can be approached and admired from close by, thanks to a brilliantly designed scenography.\r\nSpecial sections focus on sports and competition, cars owned by the Belgian Royal Family, micro and bubble cars, and car design. The Belgium at Autoworld section is dedicated to the roots and history of the Belgian car industry. \r\n\r\nAutoworld is a museum on the move, with temporary exhibi\u00actions taking on various automotive themes organised through\u00acout the year. \r\n\r\nMore detailed information on autoworld.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be\/home","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":"Autoworld, la collezione d'auto pi\u00f9 prestigiosa al mondo, inaugurata nel 1986 \u00e8 ospitata nel sontuoso edificio del Palais Mondial di Bruxelles.\r\nAutoworld \u00e8 pi\u00f9 di unmuseo, vi scoprirete una collezione di pi\u00f9 di 250 auto che raccontano la storia dell'automobile  dalle sue origini. Una zona interamente allestitata con la scenografia delle gare di auto , un altra zona dove si racconta il la storia dell'automobile e del Belgio. Il tutto situato nel Parco  Halle Sud del Cinquantenario a Bruxelles.\r\nAutoworld, un museo vivente\r\nAutoworld \u00e8 un museo vivente dove vi attende la nuova sezione Sport & Comp\u00e9tition che traccia le grandi tappe della competizione automobilistica in una scenografia originale e dinamica. \r\nSenza dimenticare la sezione pedagogica che rappresenta in maniera interattiva e ludica i vari aspetti del settore automobilistico. \r\nIl museo propone delle esposizioni dedicate al mondo dell'automobile, ai personaggi chiave della sua storia e all'evoluzione della mobilit\u00e0. \r\n\r\nSe le auto da corsa vi appassionano non perdete il laboratorio di restauroche ha luogo ogni domenica.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":"Autoworld est un lieu exceptionnel et unique tant par son architecture que par la collection qu\u2019il abrite et les expositions qui y sont organis\u00e9es.\r\nLe mus\u00e9e est situ\u00e9 dans un prestigieux \u00e9difice du Parc du Cinquantenaire, construit en 1880 pour c\u00e9l\u00e9brer le 50\u00e8me anniversaire de la cr\u00e9ation du Royaume de Belgique. \r\n\r\nPlus de 300 v\u00e9hicules, carrosses et motos de diff\u00e9rentes origines retracent l\u2019histoire de l\u2019automobile et illustrent le d\u00e9veloppement spectaculaire des v\u00e9hicules sur plus d\u2019un si\u00e8cle. Les voitures les plus embl\u00e9matiques de chaque \u00e9poque permettent \u00e9galement de suivre l\u2019\u00e9volution du design automobile du d\u00e9but jusqu\u2019\u00e0 aujourd\u2019hui.  \r\nDes zones \u00e0 th\u00e8mes mettent en lumi\u00e8re des aspects sp\u00e9cifiques de cette histoire. La zone \u00ab Sport & Comp\u00e9tition \u00bb retrace les grandes \u00e9tapes de la comp\u00e9tition automobile (rallyes et courses) depuis 1906, et la zone \u00ab Belgium at Autoworld \u00bb rappelle que notre pays fut l\u2019un des principaux fabricants automobiles au d\u00e9but du 20\u00e8me si\u00e8cle. Dans la nouvelle \u00ab Media room \u00bb des films, vid\u00e9os et documents historiques relatent eux aussi cette histoire ainsi que l\u2019\u00e9volution automobile depuis les 30 derni\u00e8res ann\u00e9es.\r\nDes expositions temporaires sont r\u00e9guli\u00e8rement organis\u00e9es.\r\nPlus d\u2019infos et le calendrier des expositions sur : www.autoworld.be \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be\/home","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":"A menudo olvidamos que el autom\u00f3vil fue uno de los florones de la industria belga antes de la Segunda Guerra Mundial: Minerva, FN, Imperia, Nagant, Germanin y Vivinus, por citar solo los m\u00e1s importantes. La estructura met\u00e1lica fue dise\u00f1ada en 1880. Acogi\u00f3 el sal\u00f3n del autom\u00f3vil de 1902 a 1934. El museo puede ser considerado como uno de los m\u00e1s prestigiosos de su g\u00e9nero en Europa, incluso del mundo (aproximadamente 400 veh\u00edculos, todos en estado de funcionamiento). Podemos revivir la historia del autom\u00f3vil desde el a\u00f1o 1886 hasta los a\u00f1os 70, desde el Ford T hasta llegar al Citro\u00ebn 2CV, el Volkswagen Escarabajo, el Tatra checo y algunos modelos raros que han pertenecido a celebridades de nuestro siglo (a la familia real belga o tambi\u00e9n un veh\u00edculo especialmente dise\u00f1ado seg\u00fan las exigencias del Sha de Persia, pero jam\u00e1s entregado)","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Autoworld","address_street_name":"Jubelpark","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 11","address_line2":"1000 Brussel","description_web":"Autoworld, het nationale automuseum, is gelegen in het hart van Brussel, ondergebracht in een prestigieus gebouw in het Jubelpark. \r\n\r\nMeer dan 300 voertuigen (auto's, vrachtwagens en motorfietsen) worden er permanent tentoongesteld.  De bezoeker wordt er langs de fabelachtige geschiedenis van de auto van 1896 tot nu geleid, vanaf de oudste modellen uit een ver verleden tot hedendaagse auto's die ons een blik gunnen op  de voertuigen van morgen en zelfs van later. \r\nDe collectie werd onlangs aangevuld met een groot aantal voertuigen uit de spannendste jaren van de autogeschiedenis sinds 1960. In een licht en luchtig decor kan het publiek de tentoongestelde auto's van dichtbij bewonderen. \r\nHier en daar werden themazones ingericht, waar voertuigen van de openbare diensten, auto's die ooit aan de Koninklijke Familie toebehoorden, microcars en modellen onder het thema Design Story en Sport & Competition worden tentoongesteld.\r\nCentraal in het museum bevindt zich 'Belgium at Autoworld', een ruimte die volledig aan de bakermat en de geschiedenis van de Belgische auto-industrie tot op de dag van vandaag gewijd is. \r\nIn de 'Sport & Competition'-zone wordt een overzicht gegeven van de grote perioden in de geschiedenis van de autosport (rally en circuit) sinds 1906. \r\nAutoworld is een museum dat voortdurend evolueert. Het hele jaar door worden er tijdelijke tentoonstellingen georganiseerd over verschillende thema's die verband houden met de auto.\r\nMeer informatie over de kalender van de tentoonstellingen vindt u op www.autoworld.be \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":147,"location":{"lat":50.83992036,"lon":4.39340998},"region":"brussels","last_updated_at":"2023-11-10T09:31:48+01:00","published_at":"2013-10-19T01:13:18+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":734,"translations":{"de":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":"Autoworld ist ein au\u00dfergew\u00f6hnlicher Ort, einzigartig in seiner Architektur, seiner Sammlung und den dort organisierten Ausstellungen.\r\nDas Museum befindet sich in einem repr\u00e4sentativen Geb\u00e4ude des Parc du Cinquantenaire, welches  1880 anl\u00e4sslich des 50. Jahrestages der Gr\u00fcndung des K\u00f6nigreichs Belgien erbaut wurde.\r\n\r\nMehr als 300 Fahrzeuge, Reisebusse und Motorr\u00e4der unterschiedlicher Herkunft zeichnen die Geschichte des Automobils nach und veranschaulichen die spektakul\u00e4re Entwicklung von Fahrzeugen \u00fcber mehr als ein Jahrhundert. Die emblematischsten Autos jeder Epoche erm\u00f6glichen es au\u00dferdem, die Entwicklung des Autodesigns von Anfang an bis heute zu verfolgen.\r\nThemenbereiche beleuchten spezifische Aspekte dieser Geschichte. Der \u201eSport & Wettbewerb\u201c Abschnitt zeichnet die Meilensteine des Motorsport (Rallyes und Rennen) seit 1906. \r\n\u201eMan darf nicht vergessen, dass unser Land im fr\u00fchen 20. Jahrhundert eines der wichtigsten Automobilhersteller war\u201c.\r\nIm neuen \"Media Room\" erz\u00e4hlen Filme, Videos und historische Dokumente diese Geschichte ebenso wie die automobile Entwicklung der letzten 30 Jahre.\r\n\r\nTempor\u00e4re Ausstellungen werden regelm\u00e4\u00dfig organisiert.\r\n\r\nWeitere Informationen und den Messekalender finden Sie unter: www.autoworld.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":"Esquecemo-nos frequentemente que o autom\u00f3vel foi um dos baluartes da ind\u00fastria belga antes da Segunda Guerra Mundial: Minerva, FN, Imperia, Nagant, Germain, Vivinus, para citar alguns dos mais importantes. A estrutura met\u00e1lica do museu foi concebida em 1880. Abrigou o Sal\u00e3o Autom\u00f3vel de 1902 a 1934. O museu pode ser considerado como um dos mais prestigiosos do seu g\u00e9nero na Europa, ou mesmo no mundo (cerca de 400 ve\u00edculos, todos operacionais). Podemos a\u00ed reviver a hist\u00f3ria do autom\u00f3vel, de 1886 aos anos 70, da Ford T, passando pela 2CV da Citro\u00ebn, a Carocha alem\u00e3, a Tatra checoslovaca e alguns modelos raros que pertenceram a celebridades do nosso s\u00e9culo (\u00e0 fam\u00edlia real belga ou um ve\u00edculo especialmente concebido de acordo com as exig\u00eancias do X\u00e1 da P\u00e9rsia, mas nunca fornecido).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Brussels","description_web":"An impressive historic building in Brussels, linked with automotive history, is home to Autoworld, the Belgian National Automobile Museum. Situated in the \u2018Parc du Cinquantenaire\u2019, the neo-classical building commemorated the 50th anniversary of the Kingdom of Belgium in 1880. From 1902 to 1936 it hosted motor\u00accar and motorbike exhibitions. Since 1986 it has treasured the major part of Ghislain Mahy\u2019s renowned classic car collection. \r\n\r\nOver 300 vehicles, ranging from cars and trucks to motorcycles, are on permanent display. From the earliest models of the dis\u00actant past to contemporary cars that prefigure the automobile of tomorrow, visitors are guided through the motorcar\u2019s history dating as far back as 1896. \r\n\r\nVarious cars representing the most exciting years of the auto\u00acmobile history since 1960 can be approached and admired from close by, thanks to a brilliantly designed scenography.\r\nSpecial sections focus on sports and competition, cars owned by the Belgian Royal Family, micro and bubble cars, and car design. The Belgium at Autoworld section is dedicated to the roots and history of the Belgian car industry. \r\n\r\nAutoworld is a museum on the move, with temporary exhibi\u00actions taking on various automotive themes organised through\u00acout the year. \r\n\r\nMore detailed information on autoworld.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be\/home","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":"Autoworld, la collezione d'auto pi\u00f9 prestigiosa al mondo, inaugurata nel 1986 \u00e8 ospitata nel sontuoso edificio del Palais Mondial di Bruxelles.\r\nAutoworld \u00e8 pi\u00f9 di unmuseo, vi scoprirete una collezione di pi\u00f9 di 250 auto che raccontano la storia dell'automobile  dalle sue origini. Una zona interamente allestitata con la scenografia delle gare di auto , un altra zona dove si racconta il la storia dell'automobile e del Belgio. Il tutto situato nel Parco  Halle Sud del Cinquantenario a Bruxelles.\r\nAutoworld, un museo vivente\r\nAutoworld \u00e8 un museo vivente dove vi attende la nuova sezione Sport & Comp\u00e9tition che traccia le grandi tappe della competizione automobilistica in una scenografia originale e dinamica. \r\nSenza dimenticare la sezione pedagogica che rappresenta in maniera interattiva e ludica i vari aspetti del settore automobilistico. \r\nIl museo propone delle esposizioni dedicate al mondo dell'automobile, ai personaggi chiave della sua storia e all'evoluzione della mobilit\u00e0. \r\n\r\nSe le auto da corsa vi appassionano non perdete il laboratorio di restauroche ha luogo ogni domenica.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 11","address_line2":"1000 Bruxelles","description_web":"Autoworld est un lieu exceptionnel et unique tant par son architecture que par la collection qu\u2019il abrite et les expositions qui y sont organis\u00e9es.\r\nLe mus\u00e9e est situ\u00e9 dans un prestigieux \u00e9difice du Parc du Cinquantenaire, construit en 1880 pour c\u00e9l\u00e9brer le 50\u00e8me anniversaire de la cr\u00e9ation du Royaume de Belgique. \r\n\r\nPlus de 300 v\u00e9hicules, carrosses et motos de diff\u00e9rentes origines retracent l\u2019histoire de l\u2019automobile et illustrent le d\u00e9veloppement spectaculaire des v\u00e9hicules sur plus d\u2019un si\u00e8cle. Les voitures les plus embl\u00e9matiques de chaque \u00e9poque permettent \u00e9galement de suivre l\u2019\u00e9volution du design automobile du d\u00e9but jusqu\u2019\u00e0 aujourd\u2019hui.  \r\nDes zones \u00e0 th\u00e8mes mettent en lumi\u00e8re des aspects sp\u00e9cifiques de cette histoire. La zone \u00ab Sport & Comp\u00e9tition \u00bb retrace les grandes \u00e9tapes de la comp\u00e9tition automobile (rallyes et courses) depuis 1906, et la zone \u00ab Belgium at Autoworld \u00bb rappelle que notre pays fut l\u2019un des principaux fabricants automobiles au d\u00e9but du 20\u00e8me si\u00e8cle. Dans la nouvelle \u00ab Media room \u00bb des films, vid\u00e9os et documents historiques relatent eux aussi cette histoire ainsi que l\u2019\u00e9volution automobile depuis les 30 derni\u00e8res ann\u00e9es.\r\nDes expositions temporaires sont r\u00e9guli\u00e8rement organis\u00e9es.\r\nPlus d\u2019infos et le calendrier des expositions sur : www.autoworld.be \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Autoworld","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_street_box":null,"email":"info@autoworld.be","website":"http:\/\/www.autoworld.be\/home","phone_contact":"+32 2 736 41 65","phone_booking":"+32 2 736 41 65","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 