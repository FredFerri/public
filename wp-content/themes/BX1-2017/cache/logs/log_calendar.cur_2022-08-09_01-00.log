d":258125,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":537525,"date_start":"2022-08-14","date_end":"2022-08-14","date_next":"2022-08-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le cimeti\u00e8re de Bruxelles","shortdescr":"D\u00e9couvrez les techniques et courants artistiques de la statuaire et l'histoire des grands noms qui ont fait Bruxelles.","longdescr":"Cette visite nous am\u00e8ne \u00e0 porter un regard original sur le travail des bronziers,dontceux de la Compagnie des Bronzes.Les tombes et monumentsysont d\u2019une grande qualit\u00e9. Ellesledoivent beaucoup ausavoir-faire desfonderies et aux artistes bruxellois.Par la richesse de son patrimoine, ce cimeti\u00e8re permet d\u2019embrasser l\u2019\u00e9volution de la statuaire, selon les styles, les techniques et les choix des mat\u00e9riaux. Il constitue aussi une porte d\u2019entr\u00e9e originale pour d\u00e9couvrir l\u2019histoire de Bruxelles par les personnalit\u00e9s qui y sont enterr\u00e9es : CharlesBuls, JeanVolders, C\u00e9sar De Paepe, Charles Albert, HenriBeyaert, Th\u00e9odoreVerhaegen...\nTarif normal : 10 euros - tarif seniors, demandeurs d'emploi, \u00e9tudiants : 9 euros","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"parcours@lafonderie.be","phone_contact":null,"phone_booking":"+32 2 410 99 50","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537525.html"},"nl":{"name":"Le cimeti\u00e8re de Bruxelles","shortdescr":null,"longdescr":null,"performers":n