s":null,"boxoffice_url":null,"website":"http:\/\/www.lesnocturnesdusablon.com","email":"melanie@impactevents.be","phone_contact":"+32819999","phone_booking":"+32 471 89 54 40","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002505"},"pt":{"name":"Les Nocturnes du Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesnocturnesdusablon.com","email":"melanie@impactevents.be","phone_contact":"+32819999","phone_booking":"+32 471 89 54 40","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002505"},"en":{"name":"Les Nocturnes du Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesnocturnesdusablon.com","email":"melanie@impactevents.be","phone_contact":"+32819999","phone_booking":"+32 471 89 54 40","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002505"},"it":{"name":"Les Nocturnes du Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesnocturnesdusablon.com","email":"melanie@impactevents.be","phone_contact":"+32819999","phone_booking":"+32 471 89 54 40","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002505"},"cn":{"name":"Les Nocturnes du Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesnocturnesdusablon.com","email":"melanie@impactevents.be","phone_contact":"+32819999","phone_booking":"+32 471 89 54 40","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002505"},"fr":{"name":"Les Nocturnes du Sablon","shortdescr":"Les Nocturnes du Sablon sont un \u00e9v\u00e9nement embl\u00e9matique de Bruxelles, se d\u00e9roulant chaque ann\u00e9e \u00e0 la fin du mois de novembre. Pendant 4 jours, le quartier du Sablon s'anime autour de l'art, de la culture, de la gastronomie et du commerce, cr\u00e9ant une ambiance festive et f\u00e9erique. Les commer\u00e7ants, artisans et artistes  proposent des exp\u00e9riences uniques dans une atmosph\u00e8re conviviale et lumineuse.","longdescr":"Les Nocturnes du Sablon sont un \u00e9v\u00e9nement incontournable du calendrier bruxellois, se d\u00e9roulant chaque ann\u00e9e le dernier week-end du mois de novembre, pour lancer la p\u00e9riode festive et commerciale de fin d'ann\u00e9e. Pendant 4 jours et nuits, le quartier historique du Sablon se transforme en un lieu f\u00e9erique, illumin\u00e9 par des d\u00e9corations et anim\u00e9 par une multitude d'activit\u00e9s artistiques, gastronomiques et culturelles.\n\nCet \u00e9v\u00e9nement met en lumi\u00e8re les tr\u00e9sors cach\u00e9s de ce quartier embl\u00e9matique, reconnu pour ses galeries d'art, antiquaires, boutiques de luxe et restaurants renomm\u00e9s. Les commer\u00e7ants locaux participent activement en prolongeant leurs horaires d'ouverture et en proposant des stands attrayants sur la Place du Grand Sablon.\n\nLes Nocturnes du Sablon sont \u00e9galement l'occasion pour les visiteurs de d\u00e9couvrir de nouveaux produits, assister \u00e0 des expositions et profiter de concerts et animations de rue. En 2023, plus de 82 000 visiteurs ont \u00e9t\u00e9 accueillis, renfor\u00e7ant l'impact \u00e9conomique et touristique de l'\u00e9v\u00e9nement sur la r\u00e9gion bruxelloise. En 2024, l'\u00e9v\u00e9nement promet encore plus de moments magiques, avec une programmation enrichie et un accent particulier sur l'art, la culture, et l'int\u00e9gration sociale.","performers":"L'ASBL du Sablon, Quartier des Arts et du Commerce\nImpact Events SRL - Organisateur\nM\u00e9lanie Raquet - Cheffe de projet","boxoffice_url":null,"website":"http:\/\/www.lesnocturnesdusablon.com","email":"melanie@impactevents.be","phone_contact":"+32819999","phone_booking":"+32 471 89 54 40","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002505"},"sp":{"name":"Les Nocturnes du Sablo