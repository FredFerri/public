gs":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-03-29T04:05:25+02:00","published_at":"2022-03-29T03:30:14+02:00","backoffice_id":250402,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":529684,"date_start":"2022-05-29","date_end":"2022-05-29","date_next":"2022-05-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"\u00ab A la d\u00e9couverte \u00e0 v\u00e9lo des Cit\u00e9s-Jardins d\u2019Ixelles, d\u2019Auderghem, de Boitsfort, d'Etterbeek, de Woluwe-Saint-Lambert et de Woluwe-Saint-Pierre \u00bb","shortdescr":null,"longdescr":"\u00ab Aviez-vous d\u00e9j\u00e0 remarqu\u00e9 ces maisons \u00e0 l\u2019allure de campagne ? Saviez-vous qu\u2019elles f\u00eatent leurs 100 ans cette ann\u00e9e ? L\u2019aventure des cit\u00e9s-jardins a \u00e9t\u00e9 assez br\u00e8ve mais elle a laiss\u00e9 \u00e0 Bruxelles de tr\u00e8s beaux t\u00e9moignages. Imagin\u00e9 par un urbaniste anglais \u00e0 la fin du 19\u00e8me si\u00e8cle, le concept visait \u00e0 b\u00e2tir des cit\u00e9s, en bordure des villes, qui feraient la transition entre villes et campagnes. Permettant un meilleur contact entre la nature et les habitants, ces \u00ab villes \u00e0 la campagne \u00bb ont vu le jour \u00e0 Bruxelles peu apr\u00e8s la premi\u00e8re guerre mondiale. Tout en p\u00e9dalant \u00e0 travers les espaces verts de la r\u00e9gion, suivez le guide qui vous dira tout sur les cit\u00e9s-jardins et qui fera, lors de cette balade \u00e0 v\u00e9lo, un focus sur les Cit\u00e9s-Jardins de Volta, de Van Lindt, de Jouet-Rey, du Logis-Flor\u00e9al, de Kapelleveld & de Pins Noirs. \u00bb  \r\n\r\nLes heures de d\u00e9part sont les suivantes : d\u00e9part en fran\u00e7ais \u00e0 10h, d\u00e9part en n\u00e9erlandais \u00e0 12h et d\u00e9part en anglais \u00e0 15h. Toutes les balades durent 3h.","performers":null,"boxoffice_url":"http:\/\/agenda.brussels\/fr\/529684\/a-la-decouverte-a-velo-des-cites-jardins-d-ixelles-d-auderghem-de-boitsfort-d-etterbeek-de-woluwe-saint-lambert-et-de-woluwe-saint-pierre\/shop","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529684.html"},"nl":{"name":"\"Ontdekking van de tuinwijken van Elsene, Oudergem, Watermaal-Bosvoorde, Etterbeek, Sint-Lambrechts-Woluwe en Sint-Pieters-Woluwe per fiets\"","shortdescr":null,"longdescr":"\" Heb je ooit deze huizen in landelijke stijl opgemerkt? Wist je dat ze hun honderdste verjaardag vieren dit jaar? Het avontuur van de tuinwijken duurde vrij kort, maar het heeft Brussel een aantal zeer mooie getuigenissen opgeleverd. Het concept, bedacht door een Engelse stedenbouwkundige aan het eind van de 19e eeuw, hield in om wijken te bouwen aan de rand van de steden om de overgang tussen stad en platteland te maken. Deze \u2018plattelandswijken\u2019 ontstonden kort na de Eerste Wereldoorlog in Brussel. Ze brachten de bewoners dichter bij de natuur. \r\nTerwijl je door de groene ruimten van het gewest fietst, vertelt de gids alles over de volgende  tuinwijken: Volta, Van Lindt, Jouet-Rey, Le Logis-Flor\u00e9al, Kapelleveld en Pins Noirs.\"\r\n\r\nDe vertrektijden zijn als volgt: Frans om 10 uur, Nederlands om 12 uur en Engels om 15 uur. Alle tours duren 3 uur.","performers":null,"boxoffice_url":"http:\/\/agenda.brussels\/nl\/529684\/ontdekking-van-de-tuinwijken-van-elsene-oudergem-watermaal-bosvoorde-etterbeek-sint-lambrechts-woluwe-en-sint-pieters-woluwe-per-fiets\/shop","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529684.html"},"en":{"name":"\"Discover the Garden Cities of Ixelles, Auderghem, Boitsfort, Etterbeek, Woluwe-Saint-Lambert and Woluwe-Saint-Pierre by bike\"","shortdescr":null,"longdescr":"\"Have you ever noticed these country-style houses? Did you know that they are celebrating their 100th anniversary this year? The adventure of the garden cities was quite brief, but it has left behind some very fine examples in Brussels. Conceived by an English town planner at the end of the 19th century, the concept was to build cities on the outskirts of towns that would make the transition between town and country. Allowing for better contact between nature and the inhabitants, these \"country towns\" were created in Brussels shortly after the First World War. While cycling through the green spaces of the region, follow the guide who will tell you all about the garden cities and who will focus on the Garden Cities of Volta, Van Lindt, Jouet-Rey, Logis-Flor\u00e9al, Kapelleveld & Pins Noirs during this bike ride.\"\r\n\r\nDeparture times are as follows: French at 10am, Dutch at 12pm and English at 3pm. All tours last 3 hours.","performers":null,"boxoffice_url":"http:\/\/agenda.brussels\/en\/529684\/discover-the-garden-cities-of-ixelles-auderghem-boitsfort-etterbeek-woluwe-saint-lambert-and-woluwe-saint-pierre-by-bike\/shop","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529684.html"},"de":{"name":"\u00ab A la d\u00e9couverte \u00e0 v\u00e9lo des Cit\u00e9s-Jardins d\u2019Ixelles, d\u2019Auderghem, de Boitsfort, d'Etterbeek, de Woluwe-Saint-Lambert et de Woluwe-Saint-Pierre \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529684.html"},"it":{"name":"\u00ab A la d\u00e9couverte \u00e0 v\u00e9lo des Cit\u00e9s-Jardins d\u2019Ixelles, d\u2019Auderghem, de Boitsfort, d'Etterbeek, de Woluwe-Saint-Lambert et de Woluwe-Saint-Pierre \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529684.html"},"sp":{"name":"\u00ab A la d\u00e9couverte \u00e0 v\u00e9lo des Cit\u00e9s-Jardins d\u2019Ixelles, d\u2019Auderghem, de Boitsfort, d'Etterbeek, de Woluwe-Saint-Lambert et de Woluwe-Saint-Pierre \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529684.html"},"pt":{"name":"\u00ab A la d\u00e9couverte \u00e0 v\u00e9lo des Cit\u00e9s-Jardins d\u2019Ixelles, d\u2019Auderghem, de Boitsfort, d'Etterbeek, de Woluwe-Saint-Lambert et de Woluwe-Saint-Pierre \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529684.html"},"cn":{"name":"\u00ab A la d\u00e9couverte \u00e0 v\u00e9lo des Cit\u00e9s-Jardins d\u2019Ixelles, d\u2019Auderghem, de Boitsfort, d'Etterbeek, de Woluwe-Saint-Lambert et de Woluwe-Saint-Pierre \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529684.html"}},"place":{"id":228485,"translations":{"fr":{"name":"Pro Velo","address_street_name":"Rue de Londres","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres, 15","address_line2":"1050 Ixelles","description_web":"Pro V\u00e9lo est une association au guidon fermement dirig\u00e9 en faveur des cyclistes bruxellois. Elle propose des promenades guid\u00e9es sur deux roues en fran\u00e7ais, n\u00e9erlandais et anglais. Une id\u00e9e sympathique qui permet d\u2019appr\u00e9cier la petite reine ET les richesses multiples de l\u2019environnement bruxellois. Il n\u2019y a plus qu\u2019\u00e0 baisser la t\u00eate pour avoir l\u2019air d\u2019un coureur! Mais non, ce serait dommage, levez les yeux et appr\u00e9ciez le paysage...\r\nLangues: allemand - anglais - espagnol - fran\u00e7ais - n\u00e9erlandais - portugais","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Pro Velo","address_street_name":"Londenstraat","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Londenstraat, 15","address_line2":"1050 Elsene","description_web":"De vzw Pro V\u00e9lo streeft naar meer mobiliteit voor de Brusselse fietsers en organiseert gegidste fietstochten in het Nederlands, Frans en Engels. Kortom, een fijn idee voor wie graag met de haren in de wind de stad afschuimt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Pro Velo","address_street_name":"Rue de Londres","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres, 15","address_line2":"1050 Ixelles","description_web":"The Pro Velo non-profit association aims to improve mobility for cyclists in Brussels. It organises guided bicycle tours in Dutch, French, and English. A pleasant and active way of exploring the city with neither windscreen nor roof in your way, giving you a completely unimpeded view.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Pro Velo","address_street_name":"Rue de Londres","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres, 15","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Pro Velo","address_street_name":"Rue de Londres","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres, 15","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Pro Velo","address_street_name":"Rue de Londres","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres, 15","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Pro Velo","address_street_name":"Rue de Londres","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres, 15","address_line2":"1050 Ixelles","description_web":null,"descript