:[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"From Hit to Sublime or Not, by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tricoterie.fr\/fr\/agenda\/l-agenda-culturel\/escapades-from-hit-to-sublime?id_evenement=6364","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002123"},"pt":{"name":"From Hit to Sublime or Not, by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tricoterie.fr\/fr\/agenda\/l-agenda-culturel\/escapades-from-hit-to-sublime?id_evenement=6364","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002123"},"en":{"name":"From Hit to Sublime or Not, by Concerts Escapades","shortdescr":"\u201cFrom Hit to Sublime or Not\u201d explores a particular theme: from good taste to must-haves. Classic hits so well known that some music lovers may consider them to be in poor taste. And yet, these tunes continue to win the hearts and minds of all listeners. The Quiron Quartet ensemble will perform Bach, Pachelbel, Albinoni and Bart\u00f3k. ","longdescr":"\u201cFrom Hit to Sublime or Not\u201d explores a particular theme: from good taste to must-haves. Classic hits so well-known that some music lovers may consider them to be in poor taste. And yet, these tunes continue to win the hearts of everyone, including the Brussels prisoners who participate in the programming of our concerts. A real treat for listeners, during which the Quiron Quartet will perform \u201chits\u201d by Bach, Pachelbel, Albinoni and Bart\u00f3k. Here's the program : Aria by J. S. Bach, Canon by Pachelbel, Adagio by Albinoni and String Quartet n\u00b06 by B\u00e9la Bart\u00f3k. ","performers":"Quiron Quartet : Edgar Gomes, violon ; Ricardo Vieira, viola ; Jos\u00e9 Miguel Freitas, alto ; Maria Nabeiro, cello.","boxoffice_url":null,"website":"https:\/\/tricoterie.fr\/fr\/agenda\/l-agenda-culturel\/escapades-from-hit-to-sublime?id_evenement=6364","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002123"},"it":{"name":"From Hit to Sublime or Not, by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tricoterie.fr\/fr\/agenda\/l-agenda-culturel\/escapades-from-hit-to-sublime?id_evenement=6364","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002123"},"cn":{"name":"From Hit to Sublime or Not, by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tricoterie.fr\/fr\/agenda\/l-agenda-culturel\/escapades-from-hit-to-sublime?id_evenement=6364","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002123"},"fr":{"name":"From Hit to Sublime or Not, par Concerts Escapades","shortdescr":"\"From Hit to Sublime or Not\" explore une th\u00e9matique particuli\u00e8re : du bon go\u00fbt aux incontournables. Des tubes classiques tellement connus que certains m\u00e9lomanes peuvent les consid\u00e9rer comme \u00e9tant de mauvais go\u00fbt. Or ces morceaux continuent d'emporter l'adh\u00e9sion de tous, un vrai d\u00e9lice pour les auditeurs. L\u2019ensemble Quiron Quartet nous interpr\u00e8tera Bach, Pachelbel, Albinoni et Bart\u00f3k. ","longdescr":"\"From Hit to Sublime or Not\" explore une th\u00e9matique particuli\u00e8re : du bon go\u00fbt aux incontournables. Des tubes classiques tellement connus que certains m\u00e9lomanes peuvent les consid\u00e9rer comme \u00e9tant de mauvais go\u00fbt. Or ces morceaux continuent d'emporter l'adh\u00e9sion de tous, notamment des prisonniers bruxellois qui participent \u00e0 la programmation de nos concerts. Un vrai d\u00e9lice pour les auditeurs, au cours duquel l\u2019ensemble Quiron Quartet nous interpr\u00e8tera des \"tubes\" de Bach, Pachelbel, Albinoni et Bart\u00f3k. Au programme : Aria de J. S. Bach, Canon de Pachelbel, Adagio d'Albinoni et Quatuor \u00e0 cordes n\u00b06 de B\u00e9la Bart\u00f3k. ","performers":"Quiron Quartet : Edgar Gomes, violon ; Ricardo Vieira, alto ; Jos\u00e9 Miguel Freitas, alto ; Maria Nabeiro, violoncelle.","boxoffice_url":null,"website":"https:\/\/tricoterie.fr\/fr\/agenda\/l-agenda-culturel\/escapades-from-hit-to-sublime?id_evenement=6364","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002123"},"sp":{"name":"From Hit to Sublime or Not, by Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tricoterie.fr\/fr\/agenda\/l-agenda-culturel\/escapades-from-hit-to-sublime?id_evenement=6364","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002123"},"nl":{"name":"From Hit to Sublime or Not, door Concerts Escapades","shortdescr":"\u201cFrom Hit to Sublime or Not\u201d verkent een bepaald thema: van goede smaak tot must-haves. Klassieke hits die zo bekend zijn dat sommige muziekliefhebbers ze als smakeloos beschouwen. En toch blijven deze nummers de harten en geesten van alle luisteraars veroveren. Het Quiron Quartet zal Bach, Pachelbel, Albinoni en Bart\u00f3k ten gehore brengen. ","longdescr":"\u201cFrom Hit to Sublime or Not\" verkent een bepaald thema: van goede smaak tot must-haves tot ver erover. Klassieke hits die zo bekend zijn dat sommige muziekliefhebbers ze als smakeloos beschouwen. Toch blijven deze nummers de harten en geesten van iedereen veroveren, ook van de Brusselse gevangenen die deelnemen aan de programmering van onze concerten. Het Quiron Quartet brengt hits van Bach, Pachelbel, Albinoni en Bart\u00f3k. Op het programma : Aria van J. S. Bach, Canon van Pachelbel, Adagio van Albinoni en Strijkkwartet nr. 6 van B\u00e9la Bart\u00f3k. ","performers":"Quiron Quartet : Edgar Gomes, violon ; Ricardo Vieira, viola ; Jos\u00e9 Miguel Freitas, alto ; Maria Nabeiro, cello.","boxoffice_url":null,"website":"https:\/\/tricoterie.fr\/fr\/agenda\/l-agenda-culturel\/escapades-from-hit-to-sublime?id_evenement=6364","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002123"}},"place":{"id":252101,"translations":{"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie est un projet culturel fond\u00e9 en 2010 par une poign\u00e9e de citoyen\u00b7nes et situ\u00e9 dans une ancienne usine restaur\u00e9e avec des mat\u00e9riaux \u00e9cologiques. La Tricoterie propose une programmation culturelle tr\u00e8s diversifi\u00e9e et centr\u00e9e sur la rencontre entre les diff\u00e9rents publics et le m\u00e9lange des activit\u00e9s culturelles.\r\n\r\nPassez la porte et d\u00e9couvrez :\r\n- Des spectacles de th\u00e9\u00e2tre, de danse, de cirque...\r\n- Des concerts, des soir\u00e9es, des sc\u00e8nes ouvertes, des jam sessions, une chorale d'un soir...\r\n- Des ateliers z\u00e9ro d\u00e9chet, peinture, c\u00e9ramique, \u0153nologie, danse...\r\n- Des projections de films, conf\u00e9rences, d\u00e9bats...\r\n- Des couscous \"s\u00e9pharabes\", des soir\u00e9es jeux de soci\u00e9t\u00e9, des activit\u00e9s pour enfants...\r\n- Des march\u00e9s des cr\u00e9ateur\u00b7rices, des vide-dressings, des march\u00e9s de No\u00ebl durables...\r\n\r\nUn petit creux ? La Triciterie vous propose un brunch tous les dimanches et un concept \"live cooking\" tous les vendredis soirs. Tous les plats sont 100% artisanaux, et pr\u00e9par\u00e9s sur place par l'\u00e9quipe avec des ingr\u00e9dients bio, locaux et de saison.\r\n\r\nEnvie d'organiser votre \u00e9v\u00e9nement chez vous ? La Tricoterie met ses salles \u00e0 disposition pour tout type d'\u00e9v\u00e9nement priv\u00e9 ou professionnel et propose \u00e9galement un service traiteur, que ce soit dans ses murs ou \u00e0 l'ext\u00e9rieur. Rendez-vous sur www.tricoterie.be pour en savoir plus !\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl":["Sint-Gillis centrum"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":14176,"location":{"lat":50.83028735,"lon":4.33675871},"region":"brussels","last_updated_at":"2024-05-15T13:04:23+02:00","published_at":"2013-10-19T01:47:56+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276119,"translations":{"de":{"name":"Music Projects for Brussels","address_street_name":"Rue Albert Vanderkinderestraat","address_street_number":"24","address_street_box":null,"email":"info@mpfb.org","website":"www.mpfb.org","phone_contact":"+32 496 10 68 29","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Albert Vanderkinderestraat, 24","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Music Projects for Brussels","address_street_name":"Rue Albert Vanderkinderestraat","address_street_number":"24","address_street_box":null,"email":"info@mpfb.org","website":"www.mpfb.org","phone_contact":"+32 496 10 68 29","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Albert 