":"17:30:00"},{"day":"2022-10-08","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-10-15","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-10-22","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-10-29","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-11-05","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-11-12","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-11-19","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-11-26","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-12-03","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-12-10","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-12-17","doors":null,"start":"16:00:00","end":"17:30:00"}],"recurring":[{"day":"saturday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"16:00:00","time_end":"17:30:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier samedis du mois de 16:00 \u00e0 17:30","nl":"Open op de eerste, tweede, derde, vierde en laatste zaterdags van de maand van 16:00 tot 17:30","en":"Open the first, second, third, fourth and last saturdays of the month from 16:00 to 17:30"}}],"closing_days":["2022-10-01"],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":20}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[323],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-25T01:35:25+02:00","published_at":"2022-09-01T17:07:51+02:00","backoffice_id":260832,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.21129929348218},{"id":535582,"date_start":"2022-06-18","date_end":"2022-10-08","date_next":"2022-10-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[99],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Summer Menu Coffee Tours","shortdescr":"Soyez pr\u00eat.e \u00e0 d\u00e9couvrir des boissons cr\u00e9atives pour un vrai menu d\u2019\u00e9t\u00e9 lors de cette visite de 4 heures dans diff\u00e9rents quartiers de Bruxelles. Donn\u00e9 en FR & EN.","longdescr":"LES COFFEE TOURS\r\nLe caf\u00e9 de sp\u00e9cialit\u00e9 est en plein d\u00e9veloppement \u00e0 Bruxelles, avec l'\u00e9mergence de nouveaux caf\u00e9s et d'initiatives comme la Brussels Coffee Week, mais aussi gr\u00e2ce \u00e0 l\u2019impl\u00e9mentation de grains de qualit\u00e9 dans de plus en plus de lieux HoReCa, \u00e9piceries etc. Le caf\u00e9 de sp\u00e9cialit\u00e9 reste malgr\u00e9 tout encore bien trop m\u00e9connu, il est temps d'explorer ce que la capitale de l'Europe a \u00e0 offrir.\r\n\r\nCes explorations caf\u00e9\u00efn\u00e9es de la ville sont aussi inhabituelles, amusantes qu\u2019instructives et correspondent \u00e0 un cours de base complet sur le caf\u00e9, le fun et la marche en plus.\r\n\r\nPOUR QUI\r\nLes Brussels Coffee Tours s'adressent \u00e0 tout le monde, avec un focus sur l\u2019exp\u00e9rience consommateur\/coffee lovers d\u00e9sireu.x.ses de mieux comprendre leur boisson favorite.\r\n\r\nIl convient \u00e9galement aux professionnel.le.s de l\u2019HoReCa qui encore souvent ignorent ce qu\u2019est le caf\u00e9 de sp\u00e9cialit\u00e9, les aidant ainsi \u00e0 comprendre le parent pauvre de leur secteur mais aussi \u00e0 mieux appr\u00e9hender l\u2019exp\u00e9rience client li\u00e9e au caf\u00e9.\r\n\r\nJe suis l\u00e0 pour aider et esp\u00e8re combler le foss\u00e9 entre les amateurs et les professionnels. Aucun pr\u00e9requis n'est n\u00e9cessaire \u00e0 ce tour.\r\n\r\nOBJECTIF\r\nLe but des Brussels Coffee Tours est de faire d\u00e9couvrir les lieux innovants lorsqu\u2019il est question de caf\u00e9 de sp\u00e9cialit\u00e9, mais aussi de d\u00e9couvrir et comprendre comment consommer \/ go\u00fbter le caf\u00e9 sur base de crit\u00e8res de qualit\u00e9 objectifs.\r\n\r\nComprendre la cha\u00eene de production du champ \u00e0 la tasse, la diff\u00e9rence entre caf\u00e9 de sp\u00e9cialit\u00e9 et caf\u00e9 de commodit\u00e9 et apprendre \u00e0 mieux acheter son caf\u00e9 sont \u00e9galement au c\u0153ur des objectifs des Coffee Tours.\r\n\r\nSUMMER MENU TOUR, UN TOUR P\u00c9DAGOGIQUE ! \r\nLors des - SUMMER MENU TOURS - , nous explorerons la partie froide d\u2019un menu, en passant du Cold Brew - extraction de caf\u00e9 \u00e0 froid, tendance num\u00e9ro 1 dans les pays anglo-saxons - \u00e0 l\u2019Espresso on Ice, mais aussi en explorant d\u2019autres boissons parfois sans caf\u00e9ine, faisant preuve de beaucoup de cr\u00e9ativit\u00e9, pour enfin sortir du home made ice tea. Comme lors de chaque Coffee Tour, nous parlerons de caf\u00e9 de sp\u00e9cialit\u00e9 aussi, afin de mieux vous \u00e9clairer sur le sujet. Entre innovation, gourmandise et philosophie, l\u2019\u00e9t\u00e9 est l\u00e0 et \u00e7a fait du bien ! PS: vous ne payez pas d'extra pour vos boissons.\r\n\r\nLors de l'\u00e9dition MIDTOWN nous visitons 5 \u00e0 6 lieux entre le haut du Mont des Arts et le centre ville. Nous go\u00fbterons du Cold Brew mais aussi du Cold Drip ainsi que des boissons au poivre - de sp\u00e9cialit\u00e9!! - ou encore des d\u00e9lices \u00e0 la lavande, On Ice bien s\u00fbr.\r\n\r\nLors de l'\u00e9dition UPTOWN TRINIT\u00c9, nous visitons 6 lieux dans le haut de Saint-Gilles. Nous go\u00fbterons m\u00eame du caffe latte en canette, infus\u00e9 \u00e0 l\u2019azote, mais aussi une limonade de cerise de caf\u00e9 ou encore une horchata \u00e0 la mexicaine.\r\n\r\nNous vous sensibiliserons aux m\u00e9tiers du caf\u00e9 et aborderons diff\u00e9rents sujets tels que : les diff\u00e9rences de philosophies et les nouvelles vagues, les m\u00e9thodes de pr\u00e9paration, les habitudes de consommation, le m\u00e9tier de barista, les extractions \u00e0 froid, la cr\u00e9ativit\u00e9 dans les menus \u00e9t\u00e9, le go\u00fbt, la qualit\u00e9, le caf\u00e9 de sp\u00e9cialit\u00e9, les labels, les styles de torr\u00e9faction, les recettes etc\u2026 mais aussi les informations \u00e0 d\u00e9crypter sur les sachets de caf\u00e9 afin de mieux acheter et d\u00e9jouer le marketing global.\r\n\r\nGOOD TO KNOW\r\nLes tours se passent toujours en ext\u00e9rieur.\r\n\r\nNous marchons d'un endroit \u00e0 l'autre et jetons un \u0153il aux lieux, mais les groupes \u00e9tant grands par rapport \u00e0 la capacit\u00e9 des lieux, nous ne consommons pas assis \u00e0 l\u2019int\u00e9rieur.\r\n\r\nIl est pr\u00e9f\u00e9rable de se munir de chaussures confortables, de v\u00eatements CHAUDS en hiver (mieux vaut trop de couches que pas assez !!) et un parapluie en cas de pluie. De l\u2019eau est toujours recommand\u00e9e \u00e9galement. Masque et gel en temps de Covid.\r\n\r\nPetit d\u00e9jeunez avant la visite car nous n'avons pas le temps de manger lors des tours.\r\nPssst, rejoins-nous : INSTA @ok_coffee_tips","performers":"Thomas Wyngaard est fondateur de OK Coffee et un des rares experts en Caf\u00e9 de Sp\u00e9cialit\u00e9 en Belgique francophone. Il est consultant ind\u00e9pendant, enseignant (certifi\u00e9 par la Specialty Coffee Association de janvier 2018 \u00e0 avril 2021), tour-ist et broadcaster.","boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535582"},"nl":{"name":"Summer Menu Coffee Tours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535582"},"en":{"name":"Summer Menu Coffee Tours","shortdescr":"Be ready to discover and taste creative summer beverages, caffeinated or not, during this 4 hours tour in Brussels areas. Hosted in FR & EN.","longdescr":"THE COFFEE TOURS\r\nSpecialty coffee is booming in Brussels, with the emergence of new coffee shops and initiatives like the Brussels Coffee Week, but also thanks to the implementation of quality beans in more and more HoReCa places, grocery stores etc. However, specialty coffee is still far too unknown. Now is the time to explore what the capital city of Europe has to offer.\r\n\r\nThese caffeinated explorations of the city are unusual, fun as they are highly informative, and match a complete coffee basics course, with an extra sprinkle of fun and walking.\r\n\r\nFOR WHO\r\nThe Brussels Coffee Tours are for everyone, with a focus on the consumer\/coffee lover experience to better understand your favorite beverage!\r\n\r\nIt is also suitable for HoReCa professionals who are often still unaware of what specialty coffee is, helping them to understand the poor relation of their sector but also to better understand the customer experience related to coffee.\r\n\r\nI'm here to help and hope to bridge the gap between the amateurs and the professionals. No prerequisites are necessary for this tour.\r\n\r\nOBJECTIVE\r\nThe goal of the Brussels Coffee Tours is to discover innovative places when it comes to specialty coffee, but also to discover and understand how to consume\/taste coffee based on objective quality criteria.\r\n\r\nUnderstanding the production chain from field to cup, the difference between specialty and commodity coffee, and learning how to better buy coffee are also central to the objectives of the Coffee Tours.\r\n\r\nSUMMER MENU TOUR, AN EDUCATIONAL TOUR! \r\nDuring the SUMMER MENU TOURS, we will explore the cold part of a menu, from Cold Brew to Espresso on Ice, but also by exploring other drinks, sometimes without caffeine, showing a lot of creativity, to finally get out of the home made ice tea. As with every Coffee Tour, we will also talk about specialty coffee, to better enlighten you on the subject. Between innovation, gourmandise and philosophy, summer is here and it feels good! PS: you don't pay extra for your drinks.\r\n\r\nDuring the MIDTOWN edition, we visit 5 to 6 locations between the top of the Mont des Arts to Downtown. We will taste Cold Brew but also Cold Drip as well as pepper drinks - specialty pepper please! - or even lavender delights, On Ice of course.\r\n\r\nDuring the UPTOWN TRINIT\u00c9 edition, we visit 6 places in the upper Saint-Gilles. We'll even taste caffe latte in a can, infused with nitrogen, but also a coffee cherry lemonade or a Mexican-style horchata.\r\n\r\nWe will bring awareness on the coffee business and discuss different topics such as: the differences in philosophies and new waves, preparation methods, consumption habits, the barista's profession, cold extraction, creativity in summer menus, taste, quality, specialty coffee, labels, roasting styles, recipes etc... but also information to decipher on coffee bags in order to buy better and outsmart global marketing.\r\n\r\nGOOD TO KNOW\r\nThe tours always take place outdoors.\r\n\r\nWe walk from one place to another and have a look at the places, but the groups being large compared to the capacity of the places, we do not consume sitting inside.\r\n\r\nIt is best to bring comfortable shoes and an umbrella in case of rain. Water is always recommended as well. Mask and gel in Covid times.\r\n\r\nHave breakfast beforehand because we don't have time to eat during the tours.\r\nPssst, join us: INSTA @ok_coffee_tips","performers":"Thomas Wyngaard is the founder of OK Coffee and one of the few Specialty Coffee experts in French-speaking Belgium. He is an independent consultant, teacher (certified by the Specialty Coffee Association from January 2018 to April 2021), tour-ist and broadcaster.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535582"},"de":{"name":"Summer Menu Coffee Tours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535582"},"it":{"name":"Summer Menu Coffee Tours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535582"},"sp":{"name":"Summer Menu Coffee Tours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.535582"},"pt":{"name":"Summer Menu Coffee Tours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.535582"},"cn":{"name":"Summer Menu Coffee Tours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.535582"}},"place":{"id":275636,"translations":{"fr":{"name":"OK Coffee Tips","address_street_name":"Chauss\u00e9e de Forest","address_street_number":"254","address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Forest, 254","address_line2":"1060 Saint-Gilles","description_web":"OK COFFEE est une structure activiste \u0153uvrant \u00e0 la reconnaissance du Caf\u00e9 de Sp\u00e9cialit\u00e9 en Belgique francophone au travers de\r\n\r\n\u2022 COURS \u2022 TOURS \u2022 CONSULTANCE\r\n\r\n\u2014\r\n\r\nSa mission : informer, former, connecter - valoriser les nouvelles vagues du caf\u00e9 et d\u00e9monter les pratiques pass\u00e9istes d'une commodit\u00e9 en r\u00e9volution.\r\n\r\nFili\u00e8res Courtes, Producteurices, Transparence, Qualit\u00e9 et Go\u00fbt sont au c\u0153ur de nos pr\u00e9occupations\r\n\r\nLisez notre MANIFESTE pour mieux comprendre nos valeurs et nos partenaires.\r\n\r\n\u2014\r\n\r\nN\u2019h\u00e9sitez pas \u00e0 vous inscrire \u00e0 notre newsletter sur notre SITE, et \u00e0 nous rejoindre sur Instagram ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"OK Coffee Tips","address_street_name":"Chauss\u00e9e de Forest","address_street_number":"254","address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Chauss\u00e9e de Forest, 254","address_line2":"1060 Sint-Gillis","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"OK Coffee Tips","address_street_name":"Chauss\u00e9e de Forest","address_street_number":"254","address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Forest, 254","address_line2":"1060 Saint-Gilles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virt