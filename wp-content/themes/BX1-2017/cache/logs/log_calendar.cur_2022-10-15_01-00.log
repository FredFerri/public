_id":262255,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":542259,"date_start":"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Promenade guid\u00e9e : \u00e0 la d\u00e9couverte du Roodkloosterbeek et de ses sources","shortdescr":null,"longdescr":"D\u00e8s le 14\u00e8me si\u00e8cle, des moines vinrent s'installer dans la vall\u00e9e du Roodkloosterbeek, attir\u00e9s entre autre par l\u2019eau pr\u00e9sente en abondance sur ce site. Cela leur permit d\u2019y am\u00e9nager des \u00e9tangs, jardins et fontaines. Mais d'o\u00f9 vient toute cette eau? Au cours de cette promenade guid\u00e9e, nous partirons \u00e0 la recherche des sources sur le site du monast\u00e8re lui-m\u00eame, mais aussi dans le massif forestier. Peut-\u00eatre trouverons-nous encore plus de sources en cette Journ\u00e9e de la For\u00eat de Soignes...\r\nD\u00e9part de la promenade au stand de 'Coordination Senne' dans la cour du Rouge Clo\u00eetre. Sans inscription. En cas de trop grand int\u00e9r\u00eat, priorit\u00e9 sera donn\u00e9e aux premiers arriv\u00e9s.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coordinationsenne.be","email":"contact@coordinationsenne.be","phone_contact":"+32 2 206 12 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542259"},"nl":{"name":"Promenade guid\u00e9e : \u00e0 la d\u00e9couverte du Roodkloosterbeek et de ses sources","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542259"},"en":{"name":"Promenade guid\u00e9e : \u00e0 la d\u00e9couverte du Roodkloosterbeek et de ses sources","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542259"},"de":{"name":"Promenade guid\u00e9e : \u00e0 la d\u00e9couverte du Roodkloosterbeek et de ses sources","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542259"},"it":{"name":"Promenade guid\u00e9e : \u00e0 la d\u00e9couverte du Roodkloosterbeek et de ses sources","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542259"},"sp":{"name":"Promenade guid\u00e9e : \u00e0 la d\u00e9couverte du Roodkloosterbeek et de ses sources","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542259"},"pt":{"name":"Promenade guid\u00e9e : \u00e0 la d\u00e9couverte du Roodkloosterbeek et de ses sources","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542259"},"cn":{"name":"Promenade guid\u00e9e : \u00e0 la d\u00e9couverte du Roodkloosterbeek et de ses sources","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542259"}},"place":{"id":9517,"translations":{"fr":{"name":"Abbaye du Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre","address_line2":"1160 Auderghem","description_web":"Abbaye de renom jusqu\u2019\u00e0 la fin du XIXe si\u00e8cle, le Rouge-Clo\u00eetre est un lieu de promenade, d\u2019activit\u00e9s et de d\u00e9couverte de son patrimoine. Il fut l\u2019un des plus grands prieur\u00e9s de chanoines augustins du Brabant du XIVe au XVIIIe si\u00e8cles et un v\u00e9ritable paradis d\u2019artistes, qu\u2019il accueille encore aujourd\u2019hui.\r\n\r\nSon nom viendrait de la couleur rouge du mortier qui recouvrait ses murs ou de sa construction sur une partie d\u00e9frich\u00e9e de la for\u00eat de Soignes, roo de Roodclooster faisant r\u00e9f\u00e9rence \u00e0 rooien qui signifie d\u00e9terrer ou arracher.\r\n\r\nLe Rouge-Clo\u00eetre abrite des centres artistiques et culturels vous proposant des balades guid\u00e9es, des expositions, des spectacles, une d\u00e9monstration de ferrage de chevaux de trait\u2026 Observez des dentelliers, souffleurs de verre ou fabricants de jouets en tissus \u00e0 l\u2019\u0153uvre.\r\n\r\nAdmirez \u00e9galement le prieur\u00e9, la maison du Meunier et la porterie. Faites enfin une pause \u00e0 la taverne Le Relais Forestier pour y savourer des plats locaux, bio et \u00e9quitables mais aussi participer \u00e0 des ateliers de cuisine et \u00e0 la cueillette de plantes sauvages, fleurs et l\u00e9gumes anciens.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Abdij van het Roodklooster","address_street_name":"Roodkloosterstraat","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1160","address_city":"Oudergem","address_line1":"Roodkloosterstraat","address_line2":"1160 Oudergem","description_web":"Het Roodklooster is een fantastische plek om te wandelen. Je kan er ook erfgoed ontdekken. Er is altijd wel wat te doen. Tot het einde van de 19e eeuw was het Roodklooster een vermaarde abdij. Van de 14de tot 18de eeuw was het een van de grootste priorijen van Augustijner kanunniken in Brabant. Het was ook een echt kunstenaarsparadijs. En dat is het vandaag nog altijd.\r\n\r\nHet Roodklooster mag dan al wit zijn, ooit waren de muren rood van de mortel. De naam kan ook verwijzen naar een ontgonnen deel van het Zoni\u00ebnwoud. Rooien betekent namelijk opgraven.\r\n\r\nTegenwoordig worden de ruimten in het Roodklooster gebruikt voor kunst en cultuur. Er zijn rondleidingen, tentoonstellingen, voorstellingen,\u2026 Je kan er zelfs naar een demonstratie hoefsmeden. Of neem er eens een kijkje om kantklossers, glasblazers of speelgoedmakers aan het werk te zien.\r\n\r\nDe priorij, het molenaarshuis en het poortgebouw zijn ook meer dan de moeite waard. In Le Relais Forestier kan je iets lokaals, bio of fairtrade eten. Ze organiseren er ook kookworkshops en sessies wilde planten, bloemen en oude groenten plukken.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Rouge Clo\u00eetre Abbey","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre","address_line2":"1160 Auderghem","description_web":"A renowned abbey until the end of the 19th century, Rouge-Clo\u00eetre is a place for walks, activities and exploring its heritage. It was one of the largest priories of Augustinian canons in Brabant from the 14th to the 18th centuries and a veritable paradise for artists, whom it still welcomes today.\r\n\r\nIts name is said to come from the red colour of the mortar that covered its walls or from its construction on a cleared part of the Sonian Forest. The roo de Roodclooster referring to the Dutch word rooien which means to dig up or pull out.\r\n\r\nRouge-Clo\u00eetre Abbey is home to artistic and cultural centres offering guided walks, exhibitions, shows, a demonstration of horse shoeing... Watch lace makers, glass blowers or fabric toy makers at work.\r\n\r\nYou can also admire the priory, the miller's house and the gatehouse. Take a break at the tavern Le Relais Forestier to enjoy local, organic and fair-trade dishes, but also to take part in cooking workshops and the picking of wild plants, flowers and heirloom vegetables.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Abbaye du Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre","address_line2":"1160 Auderghem","description_web":"Das sch\u00f6ne architektonische Ensemble des ehemaligen Klosters Rouge-Clo\u00eetre ist gewisserma\u00dfen die Pforte zum Soignes-Wald. Seinen Namen \u2013 zu Deutsch das rote Kloster \u2013 verdankt das Rouge-Clo\u00eetre der Farbe des M\u00f6rtels des Augustinerklosters, das hier im 14. Jahrhundert und bis Ende des 19. Jahrhunderts von M\u00f6nchen bewohnt und betrieben wurde. Heute ist das Rouge-Clo\u00eetre der perfekte Ausgangspunkt f\u00fcr Spazierg\u00e4nge.\r\n\r\nDas Rouge-Cl\u00f4itre beherbergt zudem Kunst- und Kulturzentren, die nicht nur Ausstellungen und Darbietungen organisieren, sondern auch gef\u00fchrte Wanderungen. Wenn Sie m\u00f6chten, k\u00f6nnen Sie Hufschmieden, Kl\u00f6pplern, Glasbl\u00e4sern und Stoffspielzeugn\u00e4hern bei ihrer Arbeit \u00fcber die Schulter blicken.\r\n\r\nBesichtigen Sie auch das Priorat, das Haus des M\u00fcllers und das Pf\u00f6rtnerhaus. Legen Sie dann eine Pause in der Taverne Le Relais Forestier, wo Sie lokale, biologische und fair gehandelte Speisen genie\u00dfen oder aber an Kochworkshops teilnehmen und alte Wildpflanzen, Blumen und Gem\u00fcsesorten sammeln k\u00f6nnen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Abbaye du Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre","address_line2":"1160 Auderghem","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Abbaye du Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre","address_line2":"1160 Auderghem","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Abbaye du Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre","address_line2":"1160 Auderghem","description_web":"","description_print":"","