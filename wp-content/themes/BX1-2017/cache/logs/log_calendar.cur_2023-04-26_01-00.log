"],"it":["Highlight"],"sp":["Highlight"],"pt":[null],"cn":[null]}},"tags":["kids","annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":{"list":[255,263,265,266],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"],"de":["Barrierefrei","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC","Brussels Health Safety Label"],"it":["Accessibile","Accessibile ai pedoni con supporti","WC idoneo","Brussels Health Safety Label"],"sp":["Habilitado","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados","Brussels Health Safety Label"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-25T03:06:03+02:00","published_at":"2022-11-14T11:30:16+01:00","backoffice_id":265542,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.34548517720937},{"id":552482,"date_start":"2023-03-08","date_end":"2023-04-28","date_next":"2023-04-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36],"translations":{"fr":["Mus\u00e9es et art centers"],"nl":["Musea en kunstcentra"],"en":["Museums and art centers"],"de":["Museen & Kunstzentren"],"it":["Musei e centri artistici"],"sp":["Museos y centros de arte"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"364Elles\/Maternit\u00e9s","shortdescr":"2 expositions : \u201cBirth of a Mother\u201d de Julie Scheurweghs et \u201cD\u2019une histoire \u00e0 l\u2019autre\u201d, des t\u00e9moignages photographiques r\u00e9alis\u00e9s par le Centre Culturel autour de la grossesse et de la maternit\u00e9.","longdescr":"\"Birth of a Mother\"\r\nJulie Scheurweghs, photographe, s\u2019interroge sur l\u2019image de la femme. Toujours li\u00e9e aux \u00e9v\u00e9nements de sa propre vie, sa nouvelle s\u00e9rie porte sur le fait de devenir m\u00e8re. Pour \u201cBirth of a Mother\u201d, Julie Scheurweghs fait le choix de montrer explicitement la maternit\u00e9, sans l\u2019occulter ni la dramatiser, comme une \u00e9tape possible de la vie d\u2019une femme dans laquelle se cachent la transformation et la force. Son \u0153uvre offre diff\u00e9rentes perspectives sur ce que cela repr\u00e9sente d\u2019\u00eatre une femme, brisant ainsi les st\u00e9r\u00e9otypes et montrant que plusieurs identit\u00e9s peuvent \u00eatre associ\u00e9es. Elle remet en question notre vision rigide, guid\u00e9e par des clich\u00e9s reproduits \u00e0 l\u2019infini.\r\n\r\n\"D\u2019une histoire \u00e0 l\u2019autre\"\r\nC\u00e9line Bataille (charg\u00e9e de projet) et Paula Bouffioux (animatrice) du Centre Culturel ont rencontr\u00e9 et photographi\u00e9 des mamans schaerbeekoises et bruxelloises. Celles-ci ont partag\u00e9 leur v\u00e9cu d\u2019une ou de plusieurs grossesses et accouchements, ainsi que leur exp\u00e9rience de maternit\u00e9.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552482"},"nl":{"name":"364Elles\/Maternit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"webs