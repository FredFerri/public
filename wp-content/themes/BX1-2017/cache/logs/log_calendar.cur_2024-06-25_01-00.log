-02T08:19:28+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":297574,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.3466806371753174,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"La Grammaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/profile.php?id=100054260211795","email":"comediekapel@gmail.com","phone_contact":"+32 479 12 86 17","phone_booking":"+32 479 12 86 17","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009044"},"pt":{"name":"La Grammaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/profile.php?id=100054260211795","email":"comediekapel@gmail.com","phone_contact":"+32 479 12 86 17","phone_booking":"+32 479 12 86 17","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009044"},"en":{"name":"La Grammaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"http:\/\/ticket.visit.brussels\/en\/50009044\/la-grammaire\/shop","website":"https:\/\/www.facebook.com\/profile.php?id=100054260211795","email":"comediekapel@gmail.com","phone_contact":"+32 479 12 86 17","phone_booking":"+32 479 12 86 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009044"},"it":{"name":"La Grammaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/profile.php?id=100054260211795","email":"comediekapel@gmail.com","phone_contact":"+32 479 12 86 17","phone_booking":"+32 479 12 86 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009044"},"cn":{"name":"La Grammaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/profile.php?id=100054260211795","email":"comediekapel@gmail.com","phone_contact":"+32 479 12 86 17","phone_booking":"+32 479 12 86 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009044"},"fr":{"name":"La Grammaire","shortdescr":"Une com\u00e9die familiale, en plein air, sur l'orthographe.\n\nFran\u00e7ois nourrit des ambitions politiques. \nH\u00e9las, il est incapable d\u2019\u00e9crire deux mots sans faute. C\u2019est sa s\u0153ur qui r\u00e9dige ses discours \u2026 en secret. Et voil\u00e0 qu\u2019elle projette de le quitter pour un mari ! Que faire ?!?\nGaffes et quiproquos se succ\u00e8dent dans cette com\u00e9die qui ravira petits et grands.","longdescr":"Fran\u00e7ois Caboussat, n\u00e9gociant en bois, nourrit des ambitions politiques. \nH\u00e9las, il est incapable d\u2019\u00e9crire deux mots sans faute. C\u2019est sa s\u0153ur, Blanche qui r\u00e9dige sa correspondance et ses discours \u2026 en secret. Et voil\u00e0 qu\u2019elle projette de le quitter pour un mari ! Que faire ?!?\nLes accords de participes pass\u00e9s emp\u00eacheront-ils les deux amoureux de se marier ?\n\nGaffes, quiproquos, retournements de situations se succ\u00e8dent dans cette com\u00e9die familiale qui ravira petits et grands. \nVenez plonger dans un XIX\u00e8me si\u00e8cle onirique dans le cadre bucolique du Parc Parmentier. \nLes com\u00e9diens de la Com\u00e9die Kapel vous y attendent avec gags et trouvailles en cascade !\n\nAvec la participation d\u2019Albert Colla, anc\u00eatre de Marcel qui passait d\u00e9j\u00e0 en revue les v\u00e9lo(t !).","performers":"Mise en sc\u00e8ne par Bernard Lefrancq\nAvec Colette Sodoyez, Jacqueline Paquay, B\u00e9n\u00e9dicte Fromont, C\u00e9dric Lombard, Bernard Lefrancq et Beno\u00eet Strulus.\n","boxoffice_url":"http:\/\/ticket.