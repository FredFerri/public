"2022-06-24","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-25","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-06-26","doors":null,"start":"14:00:00","end":"17:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi et vendredi: de 10:00 \u00e0 17:00","samedi et dimanche: de 14:00 \u00e0 17:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag en vrijdag: van 10:00 tot 17:00","zaterdag en zondag: van 14:00 tot 17:00"],"en":["monday: closed","tuesday, wednesday, thursday and friday: from 10:00 to 17:00","saturday and sunday: from 14:00 to 17:00"]},"date_start":"2022-03-25","date_end":"2022-06-26","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-03-25","start":"18:30:00","timestamp":"2022-03-25T18:30:00+01:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T01:35:19+02:00","published_at":"2022-03-18T16:22:25+01:00","backoffice_id":249945,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.27808806426285},{"id":528423,"date_start":"2022-03-29","date_end":"2022-06-24","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,28],"translations":{"fr":["Galeries d'art","Arts graphiques"],"nl":["Galeries","Grafische kunst, vormgeving"],"en":["Art Galleries","Graphic art"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Mr.Brainwash : Editions","shortdescr":"Artiste d\u2019origine fran\u00e7aise mais d\u2019adoption am\u00e9ricaine - il vit et travaille \u00e0 Los\r\nAngeles - Thierry Guetta, sous son nom d'artiste Mr. Brainwash, repousse les\r\nlimites de l'art contemporain depuis plus de dix ans.","longdescr":"Mr.Brainwash, pseudonyme de Thierry Guetta, est l'un des street artistes les plus\r\nimportants de la sc\u00e8ne contemporaine internationale, connu pour avoir r\u00e9alis\u00e9 la\r\nparfaite synth\u00e8se entre Pop et Street Art. Entre les \u00e9claboussures de peinture, les\r\ncollages, les pochoirs et les coups de pinceau de ses \u0153uvres, \u00e9merge la phrase qui\r\nr\u00e9sume la po\u00e9tique de l'artiste : Life is Beautiful.\r\nCette philosophie fait en sorte que ses expositions sont attendues dans le monde\r\nentier, ses \u00e9ditions limit\u00e9es se vendent en quelques minutes et les salles de vente\r\nles plus prestigieuses s'arrachent ses pi\u00e8ces uniques.\r\nL\u2019exposition pr\u00e9sente certaines \u0153uvres embl\u00e9matiques de sa production en s\u00e9rie,\r\ntelles que la collection Rubik's, un jeu entre classique et moderne, Full Throttle,\r\nun hommage aux Mercedes d'\u00e9poque, et la plus r\u00e9cente We Are All in this\r\nTogether, un message d'espoir pour le monde post-pand\u00e9mie. Il y aura aussi des\r\nnouvelles \u0153uvres cr\u00e9\u00e9es par l'artiste pour l'occasion.\r\nUne exposition \u00e0 ne pas manquer: le lavage de cerveau est garanti","performers":"Thierry Guetta - Mr. Brainwash","boxoffice_url":null,"website":"https:\/\/deodato.be\/mr-brainwash\/","email":"galerie@deodato.be","phone_contact":"+32 2 808 74 43","phone_booking":"+32 2 808 74 43","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528423.html"},"nl":{"name":"Mr.Brainwash : Editions","shortdescr":"Thierry Guetta mag dan Franse roots hebben, het is Los Angeles, waar hij woont\r\nen werkt, en de Amerikaanse cultuur in het algemeen die bepalend zijn voor de\r\nmanier waarop hij al meer dan tien jaar lang de grenzen van de hedendaagse\r\nkunst verlegt.","longdescr":"Mr.Brainwash, pseudoniem van Thierry Guetta, is een van de belangrijkste\r\nstreetartkunstenaars van de internationale hedendaagse scene. Hij staat vooral\r\nbekend om de perfecte synthese die hij weet te maken tussen pop en streetart.\r\nTussen de verfspatten, collages, stencils en penseelstreken van zijn werken door,\r\nrijst de po\u00ebtische leuze op van deze uitzonderlijke artiest: \u2018Life is Beautiful.\u2019\r\nDie state of mind heeft ertoe geleid dat naar zijn tentoonstellingen wereldwijd\r\nwordt uitgekeken, zijn beperkte oplagen in enkele minuten zijn uitverkocht en de\r\nmeest prestigieuze veilinghuizen om zijn unieke stukken vechten.\r\nDe tentoonstelling toont enkele van de iconische werken uit zijn serieproducties,\r\nzoals de \u2018Rubik\u2019s Collection\u2019, een spel tussen klassiek en modern, \u2018Full Throttle\u2019,\r\neen eerbetoon aan de vintage Mercedes, en zijn recente boodschap van hoop voor\r\nde post-pandemische wereld, \u2018We Are All in this Together\u2019. Speciaal voor deze\r\ngelegenheid zal de kunstenaar ook nieuwe werken voorstellen.\r\nEen tentoonstelling die je niet mag missen: radical brainwash gegarandeerd.","performers":"Thierry Guetta - Mr. Brainwash","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528423.html"},"en":{"name":"Mr.Brainwash : Editions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528423.html"},"de":{"name":"Mr.Brainwash : Editions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528423.html"},"it":{"name":"Mr.Brainwash : Editions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528423.html"},"sp":{"name":"Mr.Brainwash : Editions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528423.html"},"pt":{"name":"Mr.Brainwash : Editions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528423.html"},"cn":{"name":"Mr.Brainwash : Editions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528423.html"}},"place":{"id":276327,"translations":{"fr":{"name":"Deodato Art","address_street_name":"Rue Saint-Jean","address_street_number":"28","address_street_box":null,"email":"galerie@deodato.be","website":"https:\/\/deodato.be\/","phone_contact":"+32 2 808 74 43","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Saint-Jean, 28","address_line2":"1000 Bruxelles","description_web":"Deodato Art est une galerie d\u2019Art Contemporain situ\u00e9e dans le centre de Bruxelles. Elle se sp\u00e9cialise dans le Pop Art et le Street Art.\r\n\r\nLe groupe Deodato Art poss\u00e8de plusieurs si\u00e8ges en Europe: deux \u00e0 Milan, un \u00e0 Porto Cervo, un \u00e0 Bruxelles, un \u00e0 Brusino Arsizio en Suisse, et est \u00e9galement en train de pr\u00e9parer l\u2019ouverture d\u2019autres si\u00e8ges sur le continent.  L\u2019entreprise a \u00e9t\u00e9 fond\u00e9e en 2010 s\u2019est distingu\u00e9e d\u00e8s ses d\u00e9buts par sa recherche d\u00e9velopp\u00e9e sur de nombreux artistes contemporains. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Deodato Art","address_street_name":"Sint-Jansstraat","address_street_number":"28","address_street_box":null,"email":"galerie@deodato.be","website":"https:\/\/deodato.be\/","phone_contact":"+32 2 808 74 43","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sint-Jansstraat, 28","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Deodato Art","address_street_name":"Rue Saint-Jean","address_street_number":"28","address_street_box":null,"email":"galerie@deodato.be","website":"https:\/\/deodato.be\/","phone_contact":"+32 2 808 74 43","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Saint-Jean, 28","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Deodato Art","address_street_name":"Rue Saint-Jean","address_street_number":"28","address_street_box":null,"email":"galerie@deodato.be","website":"https:\/\/deodato.be\/","phone_contact":"+32 2 808 74 43","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Saint-Jean, 28","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visi