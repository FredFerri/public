gu\u00eda"],"pt":[null],"cn":[null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-07T13:08:28+02:00","published_at":"2021-10-07T13:54:06+02:00","backoffice_id":240582,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10016722439176},{"id":531124,"date_start":"2022-01-01","date_end":"2025-01-01","date_next":"2025-01-01","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{"list":[99],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"],"it":["Cucina"],"sp":["Gastronom\u00eda"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Tram Experience","shortdescr":"Embarquez pour un voyage gastronomique unique \u00e0 travers Bruxelles !","longdescr":"Le Tram Experience f\u00eate ses 10 ans ! Tout au long de la derni\u00e8re d\u00e9cennie, nous avons eu la chance de partager cette exp\u00e9rience gastronomique hors-du-commun avec les amateurs de grande cuisine, de Bruxelles et d\u2019ailleurs. \r\nApr\u00e8s un relooking bien m\u00e9rit\u00e9 et un retour en fanfare en septembre dernier, le temps est venu de d\u00e9couvrir la nouvelle \u00e9dition du Tram Experience. \r\n\r\nAu rythme des saisons, chaque menu est l\u2019occasion pour nos chefs de vous pr\u00e9senter leur r\u00e9interpr\u00e9tation de la cuisine belge. De quoi ravir vos papilles ! Red\u00e9couvrez la gastronomie belge dans l\u2019atmosph\u00e8re unique et chaleureuse d\u2019un tram circulant \u00e0 travers Bruxelles. \r\n\r\nL\u2019incontournable Lionel Rigolet* nous fait, une nouvelle fois, le plaisir d\u2019\u00eatre le parrain du Tram Experience ! Sa rigueur et son expertise, en tant que chef du prestigieux Comme chez Soi, vous garantissent des menus savoureux \u00e0 l\u2019ex\u00e9cution parfaite.\r\n\r\nLes plats sont r\u00e9alis\u00e9s \u00e0 bord par notre chef traiteur, Thibault Granville - Taste Great.\r\n\r\nTARIFS\r\n\r\nTable de 2 personnes, menu 6 services : 210\u20ac\r\nTable de 2 personnes, menu 7 services : 260\u20ac\r\nTable de 4 personnes, menu 6 services : 420\u20ac\r\nTable de 4 personnes, menu 7 services : 520\u20ac","performers":null,"boxoffice_url":"https:\/\/ticketing.visit.brussels\/fr\/order\/init","website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":"+32 2 513 89 40","phone_booking":"+32 2 513 89 40","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.531124"},"nl":{"name":"Tram Experience","shortdescr":"Ga mee op een unieke gastronomische reis door Brussel!","longdescr":"De Tram Experience viert zijn 10e verjaardag! Al tien jaar lang mogen we deze buitengewone gastronomische ervaring delen met liefhebbers van lekker eten uit Brussel en daarbuiten.\r\nNa een welverdiende make-over en een geweldige comeback afgelopen september, is de Tram Experience toe aan een nieuwe editie, klaar om ontdekt te worden!\r\n\r\nElk seizoensgebonden menu is voor onze chefs een gelegenheid om hun herinterpretaties van de Belgische keuken voor te stellen en je smaakpapillen stevig te verwennen. Je herontdekt de Belgische gastronomie en dat in de unieke en gezellige sfeer van een tram die door Brussel rolt.\r\n\r\nDe onnavolgbare Lionel Rigolet*, chef van het prestigieuze Comme chez Soi, vereert ons door opnieuw peetvader te zijn van de Tram Experience. Zijn precisie en deskundigheid garanderen je overheerlijke menu\u2019s die tot in de puntjes uitgewerkt zijn. Aan boord worden de gerechten bereid door onze chef-kok Thibault Granville van Taste Great.\r\n\r\nPRIJZEN\r\n\r\nTafel voor 2 personen, 6-gangen menu: 210\u20ac.\r\nTafel voor 2 personen, 7-gangen menu: 260\u20ac.\r\nTafel voor 4 personen, 6-gangen menu: 420\u20ac.\r\nTafel voor 4 personen, 7-gangen menu: 520\u20ac.","performers":null,"boxoffice_url":"https:\/\/ticketing.visit.brussels\/nl\/order\/init","website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":"+32 2 513 89 40","phone_booking":"+32 2 513 89 40","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.531124"},"en":{"name":"Tram Experience","shortdescr":"Embark on a unique gastronomic journey through Brussels!","longdescr":"After a well-deserved rest, the completely redesigned Tram Experience offers you a brand-new contemporary adventure through Belgian gastronomy.\r\n\r\nOriginality, heritage and tingling taste buds are on the menu! \r\n\r\nThis new season, Belgian cuisine is being reinvented by great chefs from all three of the country's regions. Come and (re)discover Belgian gastronomy in the unique and warm atmosphere of a tram as it travels through Brussels.\r\nChef Lionel Rigolet** is once again doing us the honour of being the Tram Experience's patron! His rigour and his expertise as a chef, at the head of the prestigious Comme chez Soi, enable us to propose menus with perfect execution. \r\n\r\nOur chef caterer Thibault Granville (Taste Great) prepares and finishes the recipes on board.\r\nAll aboard!\r\n\r\nRATES\r\n\r\nTable for 2 persons, 6 course menu : 210\u20ac.\r\nTable for 2 people, 7 course menu : 260\u20ac (French)\r\nTable for 4 people, 6 course menu : 420\u20ac (French)\r\nTable for 4 people, 7 course menu : 520\u20ac (French)","performers":null,"boxoffice_url":"https:\/\/ticketing.visit.brussels\/en\/order\/init","website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":"+32 2 513 89 40","phone_booking":"+32 2 513 89 40","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.531124"},"de":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":"+32 2 513 89 40","phone_booking":"+32 2 513 89 40","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.531124"},"it":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":"+32 2 513 89 40","phone_booking":"+32 2 513 89 40","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.531124"},"sp":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":"+32 2 513 89 40","phone_booking":"+32 2 513 89 40","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.531124"},"pt":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":"+32 2 513 89 40","phone_booking":"+32 2 513 89 40","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.531124"},"cn":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":"+32 2 513 89 40","phone_booking":"+32 2 513 89 40","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.531124"}},"place":{"id":279379,"translations":{"fr":{"name":"Arr\u00eat STIB Poelaert","address_street_name":"Place Poelaert","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zi