:00"}]},"sunday":{"is_open":false}},"translations":{"en":["monday: closed","tuesday, wednesday, thursday, friday and saturday: from 12:00 to 18:00","sunday: closed"],"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi, vendredi et samedi: de 12:00 \u00e0 18:00","dimanche: ferm\u00e9"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 12:00 tot 18:00","zondag: gesloten"]},"date_start":"2024-09-12","date_end":"2024-11-30","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[255],"translations":{"de":["Barrierefrei"],"pt":[null],"en":["Accessible"],"it":["Accessibile"],"cn":[null],"fr":["Accessible"],"sp":["Habilitado"],"nl":["Toegankelijk"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50012220,"date_start":"2024-10-03","date_end":"2024-12-22","date_next":"2024-11-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:01:20+01:00","published_at":"2024-07-03T14:21:10+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303547,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.29119348824543295,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Ray K. Metzker - 'City Lux'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fondationastichting.com","email":"info@fondationastichting.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012220"},"pt":{"name":"Ray K. Metzker - 'City Lux'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fondationastichting.com","email":"info@fondationastichting.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012220"},"en":{"name":"Ray K. Metkzer - \u2018City Lux\u2019","shortdescr":"Discover the city as light through the lens of Ray K. Metzker this fall in the A Foundation","longdescr":"The city as light. Ray K. Metzker grew up in Milwaukee, Wisconsin, where he was born in 1931. At an early age, he developed an emotional affinity with light that remained with him for the duration of his career as a photographer. The major cities Chicago and Philadelphia offered him a host of opportunities for exploration that enabled him to shine in a realm where his peers and predecessors \u2013 in particular his teachers Harry Callahan and Aaron Siskind at the Institute of Design in Chicago \u2013 had left their mark in the 1950s and 1960s. Nevertheless, the training Metzker received at this school, founded as the New Bauhaus in 1937 by the Hungarian avant-garde artist and educator L\u00e1szl\u00f3 Moholy-Nagy, led him to emphasize experimentation and the interconnecting of disciplines. The Institute offered him a fertile environment in which to create, construct and explore photography at a more complex level than he had previously. The street became for him a place to experiment, to discover rhythms, relationships and concepts that inspired him throughout his life. From utterly silent images of a lone silhouette in a city street to large-scale compositions made up of multiple images and bands, Metzker\u2019s liberated visual approach allowed him to develop great visual mastery.  \n\nThis exhibition at A Foundation, the second large solo Metzker exhibition to be held in Europe (after Light Lines, at the Mus\u00e9e de l\u2019\u00c9lysee in Lausanne in 2008), celebrates the artist with 114 photographs ten years after his death on 9 October 2014. These black-and-white prints with tonal values of incomparable richness were executed by the photographer himself. They are from the Ray K. Metzker estate in Philadelphia, Pennsylvania, and Les Douches la Galerie in Paris, his exclusive representative in Europe. Several emblematic series are shown together here at A Foundation: The Loop (1957-1959), Europe (1960-1961), Early Philadelphia (1962-1964), Pictus Interruptus (1976-1980), City Whispers (1980-1983) and Composites, begun in 1964.","performers":null,"boxoffice_url":null,"website":"https:\/\/fondationastichting.com","email":"info@fondationastichting.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012220"},"it":{"name":"Ray K. Metzker - 'City Lux'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fondationastichting.com","email":"info@fondationastichting.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012220"},"cn":{"name":"Ray K. Metzker - 'City Lux'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fondationastichting.com","email":"info@fondationastichting.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012220"},"fr":{"name":"Ray K. Metkzer - \u2018City Lux\u2019","shortdescr":"D\u00e9couvrez la ville comme lumi\u00e8re \u00e0 travers l'objectif de Ray K. Metzker cet automne \u00e0 la Fondation A","longdescr":"La ville comme lumi\u00e8re. Ray K. Metzker, n\u00e9 en 1931 et \u00e9lev\u00e9 \u00e0 Milwaukee, dans le Wisconsin, a d\u00e9velopp\u00e9 tr\u00e8s t\u00f4t une affinit\u00e9 \u00e9motionnelle avec la lumi\u00e8re tout au long de sa carri\u00e8re photographique. Les vastes villes de Chicago et de Philadelphie ont offert \u00e0 Metzker un monde d\u2019opportunit\u00e9s \u00e0 explorer, et ont permis \u00e0 son astre de briller intens\u00e9ment dans un domaine o\u00f9 ses pairs et pr\u00e9d\u00e9cesseurs, notamment ses professeurs Harry Callahan et Aaron Siskind \u00e0 l\u2019Institute of Design de Chicago, avaient d\u00e9j\u00e0 laiss\u00e9 leur marque dans les ann\u00e9es 1950 et 60. N\u00e9anmoins, gr\u00e2ce \u00e0 la formation qu\u2019il a re\u00e7ue dans cette \u00e9cole, fond\u00e9e en 1937 \u00e0 Chicago sous le nom de New Bauhaus par l\u2019artiste et \u00e9ducateur d\u2019avant-garde hongrois L\u00e1szl\u00f3 Moholy-Nagy, il a mis l\u2019accent sur l\u2019exp\u00e9rimentation et l\u2019int\u00e9gration des disciplines. Elle a offert un environnement riche pour Metzker afin de cr\u00e9er, construire et explorer la photographie \u00e0 un niveau plus complexe qu\u2019il ne l\u2019avait fait auparavant. La rue est devenue pour lui un lieu d\u2019exp\u00e9rimentation, de d\u00e9couverte des rythmes, des relations et des concepts qui l\u2019ont inspir\u00e9 tout au long de sa vie. De l\u2019image la plus silencieuse d\u2019une seule silhouette dans une rue de la ville \u00e0 une composition \u00e0 grande \u00e9chelle de multiples images et bandes, l\u2019approche visuelle lib\u00e9r\u00e9e de Ray K. Metzker lui a permis de d\u00e9velopper une grande ma\u00eetrise visuelle.  \n\nCette exposition \u00e0 la Fondation A, la seconde grande exposition solo de Metzker en Europe apr\u00e8s Light Lines, organis\u00e9e par le Mus\u00e9e de l\u2019\u00c9lys\u00e9e \u00e0 Lausanne en 2008, nous permet de le c\u00e9l\u00e9brer dix ans apr\u00e8s sa disparition \u2013 le 9 octobre 2014 \u2013 en pr\u00e9sentant 114 photographies. Ces tirages en noir et blanc, avec des valeurs tonales d\u2019une richesse incomparable, ont \u00e9t\u00e9 r\u00e9alis\u00e9s par le photographe lui-m\u00eame. Ils proviennent de la succession de Ray K. Metzker \u00e0 Philadelphie, en Pennsylvanie, ainsi que de la Galerie les Douches \u00e0 Paris, qui le repr\u00e9sente exclusivement en Europe. Plusieurs s\u00e9ries embl\u00e9matiques sont rassembl\u00e9es ici, dans les espaces de la Fondation A : The Loop (1957-1959), Europe (1960-1961), Early Philadelphia (1962-1964), Pictus Interruptus (1976-1980), City Whispers (1980-1983) et Composites \u00e0 partir de 1964.","performers":null,"boxoffice_url":null,"website":"https:\/\/fondationastichting.com","email":"info@fondationastichting.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012220"},"sp":{"name":"Ray K. Metzker - 'City Lux'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fondationastichting.com","email":"info@fondationastichting.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012220"},"nl":{"name":"Ray K. Metkzer - \u2018City Lux\u2019","shortdescr":"Ontdek de stad als licht door de lens van Ray K. Metzker dit najaar in de A Stichting","longdescr":"De stad als licht. De Amerikaanse fotograaf Ray K. Metzker werd in 1931 geboren in Milwaukee (Wisconsin), waar hij ook opgroeide. Al vroeg ontwikkelde hij een gevoelsmatige affiniteit met licht, die hem zijn hele carri\u00e8re bijbleef. De grote steden Chicago en Philadelphia boden hem een wereld aan mogelijkheden om te verkennen. Al snel begon ster te stralen op het terrein waarop zijn tijdgenoten en voorgangers in de jaren vijftig en zestig reeds hun stempel hadden gedrukt. Met name zijn leermeesters Harry Callahan en Aaron Siskind aan het Institute of Design in Chicago, dat in 1937 onder de naam New Bauhaus was opgericht door de Hongaarse kunstenaar en kunstdidacticus L\u00e1szl\u00f3 Moholy-Nagy. Op deze opleiding leerde Metzker het accent te leggen op experiment en op het integreren van verschillende disciplines. Als aankomend fotograaf werd hij er uitdrukkelijk gestimuleerd om te cre\u00ebren, te construeren en te onderzoeken op een complexer niveau dan hij daarvoor had gedaan. De straat werd voor hem een plaats van experiment, van ontdekking van ritmes, verhoudingen en concepten die hem zijn hele leven zijn blijven inspireren. Van het uiterst verstilde beeld van een enkel silhouet op een straat in de stad tot een compositie op grote schaal bestaande uit meerdere beelden en stroken \u2013 zijn bevrijde blik stelde Ray K. Metzker in staat tot het bereiken van een groots visueel meesterschap.  \n\nDeze expositie bij de A Stichting, de tweede grote solotentoonstelling van Metzker in Europa na Light Lines in het Mus\u00e9e de l\u2019\u00c9lys\u00e9e in Lausanne in 2008, vormt tien jaar na zijn overlijden \u2013 op 9 oktober 2014 \u2013 een eerbetoon met een presentatie van 114 foto\u2019s. De zwart-witprints, met een onge\u00ebvenaarde rijkdom aan nuances in tonen, zijn door de fotograaf zelf gemaakt. Ze zijn afkomstig uit de Ray K. Metzker Estate in Philadelphia (Pennsylvania) en van Galerie Douches in Parijs, zijn alleenvertegenwoordiger in Europa. Meerdere iconische series zijn hier in de A Stichting bijeengebracht: The Loop (1957-1959), Europe (1960-1961), Early Philadelphia (1962-1964), Pictus Interruptus (1976-1980), City Whispers (1980-1983) en Composites (vanaf 1964).","performers":null,"boxoffice_url":null,"website":"https:\/\/fondationastichting.com","email":"info@fondationastichting.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012220"}},"place":{"id":251684,"translations":{"de":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Van Volxemlaan, 304","address_line2":"1190 Forest","description_web":"The Foundation is settled in a formerly industrial area of the town which has gradually been transformed into a residential neighborhood with many sites devoted to artistic creation. As a cultural actor, the Foundation\u2019s desire is to participate in the life of this neighborhood. A genuine platform devoted to the photographic image, the A Foundation also works toward forming partnerships for exhibition and book projects organized in collaboration with Belgian and international cultural institutions.\nIn October 2012, the A Foundation opened its doors in the south of Brussels on the site of the former Bata factories. Created upon the initiative of d\u2019Astrid Ullens de Schooten Whettnall, and recognized as promoting the public interest, it has a vocation to support the creation, knowledge, and preservation of the photographic image.\n","description_print":null,"booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null,"visit_url":null},"it":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"La Fondation s\u2019inscrit dans une zone de la ville anciennement vou\u00e9e \u00e0 l\u2019industrie qui s\u2019est progressivement transform\u00e9e en un quartier de logements avec de nombreux lieux consacr\u00e9s \u00e0 la cr\u00e9ation artistique. Elle s\u2019y inscrit avec le d\u00e9sir, en tant qu\u2019acteur culturel, de participer \u00e0 la vie de ce quartier. V\u00e9ritable plate-forme consacr\u00e9e \u00e0 l\u2019image photographique, la Fondation A Stichting se propose \u00e9galement de devenir partenaire de projets d\u2019expositions et d\u2019\u00e9ditions, organis\u00e9es en collaboration avec des institutions culturelles belges et \u00e9trang\u00e8res.\nEn octobre 2012, la Fondation A Stichting ouvre ses portes au sud de Bruxelles, sur le site des anciennes usines Bata. Cr\u00e9\u00e9e \u00e0 l\u2019initiative d\u2019Astrid Ullens de Schooten Whettnall, reconnue d\u2019utilit\u00e9 publique, elle a pour vocation de soutenir la cr\u00e9ation, la connaissance et la conservation de l\u2019image photographique.\n","description_print":null,"booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null,"visit_url":null},"sp":{"name":"Fundaci\u00f3n A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"En octubre de 2012, la Fundaci\u00f3n A stichting abri\u00f3 sus puertas en el sur de Bruselas en el lugar de la antigua f\u00e1brica Bata. Creada bajo la iniciativa de Astrid Ullens de Schooten, y reconocida por promover el inter\u00e9s p\u00fablico, tiene una vocaci\u00f3n para apoyar la creaci\u00f3n, el conocimiento y la preservaci\u00f3n de la imagen fotogr\u00e1fica. Ya no existe nada que no parezca haber sido atestiguado por la imagen. Sin embargo, la idea de dejar constancia sobre el uso real de la fotograf\u00eda no es necesaria. Lo que ocurre con nuestra capacidad de ver y percibir cuando en su abundancia y su inmediaci\u00f3n virtual, las im\u00e1genes que nos rodean se est\u00e1n convirtiendo r\u00e1pida y poderosamente m\u00e1s complicadas. El proyecto de la fundaci\u00f3n consiste en explorar las riesgos y contradicciones  de la imagen-documento, cuestionando un mundo en el que todo es visible. Organiza tres exhibiciones temporales cada a\u00f1o.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 304","address_line2":"1190 Vorst","description_web":"De Stichting bevindt zich in een stadsdeel waar vroeger industrie was en dat geleidelijk aan een wijk werd voor bewoning, met een heel aantal organisaties gewijd aan artistieke creatie. Als culturele actor wil de Stichting deel uitmaken van dat buurtleven. A Stichting, een platform gewijd aan de fotografie, wil zich tevens engageren als partner van tentoonstellings- en boekprojecten georganiseerd in samenwerking met Belgische en buitenlandse culturele instellingen.\nIn oktober 2012 opent A Stichting haar deuren in het zuiden van Brussel, op de site van de voormalige fabrieken van Bata. De stichting, een initiatief van d\u2019Astrid Ullens de Schooten Whettnall, is een vereniging van openbaar nut en stelt zich tot doel ondersteuning te bieden aan de creatie, de kennis en de conservatie van het fotografische beeld.\n","description_print":null,"booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"art_center","facebook_id":null,"backoffice_id":13764,"location":{"lat":50.8227478,"lon":4.3257667},"region":"brussels","last_updated_at":"2024-01-17T13:58:54+01:00","published_at":"2013-10-19T01:38:02+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":251684,"translations":{"de":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Van Volxemlaan, 304","address_line2":"1190 Forest","description_web":"The Foundation is settled in a formerly industrial area of the town which has gradually been transformed into a residential neighborhood with many sites devoted to artistic creation. As a cultural actor, the Foundation\u2019s desire is to participate in the life of this neighborhood. A genuine platform devoted to the photographic image, the A Foundation also works toward forming partnerships for exhibition and book projects organized in collaboration with Belgian and international cultural institutions.\nIn October 2012, the A Foundation opened its doors in the south of Brussels on the site of the former Bata factories. Created upon the initiative of d\u2019Astrid Ullens de Schooten Whettnall, and recognized as promoting the public interest, it has a vocation to support the creation, knowledge, and preservation of the photographic image.\n","description_print":null,"booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null,"visit_url":null},"it":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"La Fondation s\u2019inscrit dans une zone de la ville anciennement vou\u00e9e \u00e0 l\u2019industrie qui s\u2019est progressivement transform\u00e9e en un quartier de logements avec de nombreux lieux consacr\u00e9s \u00e0 la cr\u00e9ation artistique. Elle s\u2019y inscrit avec le d\u00e9sir, en tant qu\u2019acteur culturel, de participer \u00e0 la vie de ce quartier. V\u00e9ritable plate-forme consacr\u00e9e \u00e0 l\u2019image photographique, la Fondation A Stichting se propose \u00e9galement de devenir partenaire de projets d\u2019expositions et d\u2019\u00e9ditions, organis\u00e9es en collaboration avec des institutions culturelles belges et \u00e9trang\u00e8res.\nEn octobre 2012, la Fondation A Stichting ouvre ses portes au sud de Bruxelles, sur le site des anciennes usines Bata. Cr\u00e9\u00e9e \u00e0 l\u2019initiative d\u2019Astrid Ullens de Schooten Whettnall, reconnue d\u2019utilit\u00e9 publique, elle a pour vocation de soutenir la cr\u00e9ation, la connaissance et la conservation de l\u2019image photographique.\n","description_print":null,"booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null,"visit_url":null},"sp":{"name":"Fundaci\u00f3n A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"En octubre de 2012, la Fundaci\u00f3n A stichting abri\u00f3 sus puertas en el sur de Bruselas en el lugar de la antigua f\u00e1brica Bata. Creada bajo la iniciativa de Astrid Ullens de Schooten, y reconocida por promover el inter\u00e9s p\u00fablico, tiene una vocaci\u00f3n para apoyar la creaci\u00f3n, el conocimiento y la preservaci\u00f3n de la imagen fotogr\u00e1fica. Ya no existe nada que no parezca haber sido atestiguado por la imagen. Sin embargo, la idea de dejar constancia sobre el uso real de la fotograf\u00eda no es necesaria. Lo que ocurre con nuestra capacidad de ver y percibir cuando en su abundancia y su inmediaci\u00f3n virtual, las im\u00e1genes que nos rodean se est\u00e1n convirtiendo r\u00e1pida y poderosamente m\u00e1s complicadas. El proyecto de la fundaci\u00f3n consiste en explorar las riesgos y contradicciones  de la imagen-documento, cuestionando un mundo en el que todo es visible. Organiza tres exhibiciones temporales cada a\u00f1o.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+ 32 (0)2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 304","address_line2":"1190 Vorst","description_web":"De Stichting bevindt zich in een stadsdeel waar vroeger industrie was en dat geleidelijk aan een wijk werd voor bewoning, met een heel aantal organisaties gewijd aan artistieke creatie. Als culturele actor wil de Stichting deel uitmaken van dat buurtleven. A Stichting, een platform gewijd aan de fotografie, wil zich tevens engageren als partner van tentoonstellings- en boekprojecten georganiseerd in samenwerking met Belgische en buitenlandse culturele instellingen.\nIn oktober 2012 opent A Stichting haar deuren in het zuiden van Brussel, op de site van de voormalige fabrieken van Bata. De stichting, een initiatief van d\u2019Astrid Ullens de Schooten Whettnall, is een vereniging van openbaar nut en stelt zich tot doel ondersteuning te bieden aan de creatie, de kennis en de conservatie van het fotografische beeld.\n","description_print":null,"booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null,"visit_url":null}},"neca":"art_center","facebook_id":null,"region":"brussels","backoffice_id":13764,"location":{"lat":50.8227478,"lon":4.3257667},"last_updated_at":"2024-01-17T13:58:54+01:00","published_at":"2013-10-19T01:38:02+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/0dd38ceccf9ae48470150766cce6598e825c7b2f.jpg","width":3412,"height":2488,"ratio":1.37,"oEmbed_height":2488,"oEmbed_width":3412,"translations":{"de":{"title":"City Whispers, Philadelphia, 1980","copyright":"\u00a9 Estate Ray K. Metzker \/ Courtesy les Douches la Galerie, Paris."},"pt":{"title":"City Whispers, Philadelphia, 1980","copyright":"\u00a9 Estate Ray K. Metzker \/ Courtesy les Douches la Galerie, Paris."},"en":{"title":"City Whispers, Philadelphia, 1980","copyright":"\u00a9 Estate Ray K. Metzker \/ Courtesy les Douches la Galerie, Paris."},"it":{"title":"City Whispers, Philadelphia, 1980","copyright":"\u00a9 Estate Ray K. Metzker \/ Courtesy les Douches la Galerie, Paris."},"cn":{"title":"City Whispers, Philadelphia, 1980","copyright":"\u00a9 Estate Ray K. Metzker \/ Courtesy les Douches la Galerie, Paris."},"fr":{"title":"City Whispers, Philadelphia, 1980","copyright":"\u00a9 Estate Ray K. Metzker \/ Courtesy les Douches la Galerie, Paris."},"sp":{"title":"City Whispers, Philadelphia, 1980","copyright":"\u00a9 Estate Ray K. Metzker \