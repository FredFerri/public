la chanson po\u00e9tique.\nLe magazine \"Hexagone\", revue de la chanson, \u00e9crit : \"Ulysse Mars, placide mais profond, poursuit l'id\u00e9al d'une chanson qui ne fait pas de bruit pour rien, comme si Baudelaire avait chant\u00e9 les quelconques, les sans-grade\".\n-------------------------------------------------------------------\nAristide est un auteur-compositeur-interpr\u00e8te. Ses chansons parlent d\u2019amour, de politique mais aussi de ragots de comptoir. Il assume sur sc\u00e8ne une certaine maladresse et met en sc\u00e8ne ses concerts qui vont du guitare-voix aux bandes sonores comme de v\u00e9ritables spectacles. \n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012955"},"sp":{"name":"Concert Coplateau Ulysse Mars & Aristide Renard","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012955"},"nl":{"name":"Concert Coplateau Ulysse Mars & Aristide Renard","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012955"}},"place":{"id":247078,"translations":{"de":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":"\u2018Au B\u2019Izou\u2019 is the theatre for everyone. (It\u2019s an opportunity to discover artists, to abandon your TV and go out, laugh, be moved, reflect and return). The former workshop for upholstering armchairs has been transformed into a welcoming space. Jean busies himself behind the console and Izou writes songs. At \u2018Au B\u2019Izou\u2019, you are at Jean and Izou\u2019s; in other words, you are at home.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_p