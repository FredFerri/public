, c\u2019est sonancienne abbayequi va v\u00e9ritablement permettre au bas de Forest de se d\u00e9velopper gr\u00e2ce \u00e0 l\u2019agriculture et \u00e0 l\u2019\u00e9levage. \u00c0 l\u2019ombre de laspectaculaire maison communale Art D\u00e9co, un tr\u00e8s bel ensemble deb\u00e2timents n\u00e9oclassiques, construits \u00e0 la fin du XVIII\u00e8me si\u00e8cle par l\u2019architecte Laurent Beno\u00eet Dewez, t\u00e9moigne de la puissance pass\u00e9e de cette abbaye. Au-del\u00e0 de ce patrimoine magistral, certaines rues du quartier ont su conserver uncaract\u00e8re presque villageoisavec, au gr\u00e9 du parcours, des d\u00e9couvertes inattendues qui m\u00e9ritent le d\u00e9tour.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.530984"},"nl":{"name":"Au coeur de Forest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.530984"},"en":{"name":"Au coeur de Forest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.530984"},"de":{"name":"Au coeur de Forest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.530984"},"it":{"name":"Au coeur de Forest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/ev