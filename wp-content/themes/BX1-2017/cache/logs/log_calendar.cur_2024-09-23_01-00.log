,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-comics-saouta\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001079"},"it":{"name":"RDV Cosmics : Concert Saouta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-comics-saouta\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001079"},"cn":{"name":"RDV Cosmics : Concert Saouta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-comics-saouta\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001079"},"fr":{"name":"RDV Cosmics : Concert Saouta","shortdescr":"Saouta est une rencontre musicale o\u00f9 les fronti\u00e8res s\u2019effacent aux sons du saxophone soprano de Damien Brassart, du oud d\u2019Akram Ben Romdhane et des percussions de Simon Leleux, rythmant cette conversation musicale intime.","longdescr":"Vendredi 27 septembre \u00e0 20h @La Villa\n\nDans le cadre de la f\u00eate du 27 septembre de la F\u00e9d\u00e9ration Wallonie \/ Bruxelles \u2013 Avec le soutien de la Cocof\n\nSaouta est une rencontre musicale o\u00f9 les fronti\u00e8res s\u2019effacent aux sons du saxophone soprano de Damien Brassart, du oud d\u2019Akram Ben Romdhane et des percussions de Simon Leleux, rythmant cette conversation musicale intime.\n\nLeur musique, riche des influences du jazz et des m\u00e9lodies orientales, est un voyage o\u00f9 chaque note raconte une histoire. Les compositions originales de Saouta sont des paysages sonores dans lesquels les musiciens se r\u00e9pondent, se cherchent, se trouvent, explorant ensemble l\u2019instant pr\u00e9sent avec une complicit\u00e9 \u00e9vidente. Chaque performance est unique, une mosa\u00efque \u00e9ph\u00e9m\u00e8re de sons et de silences, o\u00f9 les instruments se fondent harmonieusement, comme s\u2019ils avaient toujours \u00e9t\u00e9 destin\u00e9s \u00e0 se rencontrer. Saouta n\u2019est pas simplement un groupe, c\u2019est une exp\u00e9rience sensorielle, une invitation \u00e0 \u00e9couter avec le c\u0153ur.\n\nInfos et r\u00e9servation : \n\nGRATUIT\n\n02 420 37 27 \u2013 info@lavillaculture.be","performers":"Damien Brassart\nAkram Ben Romdhane\nSimon Leleux","boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-comics-saouta\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001079"},"sp":{"name":"RDV Cosmics : Concert Saouta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-comics-saouta\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001079"},"nl":{"name":"RDV Cosmics : Concert Saouta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-comics-saouta\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001079"}},"place":{"id":220064,"translations":{"de":{"name":"Centre Culturel Ganshoren La Villa","address_street_name":"Place Guido Gezelle","address_street_number":"26","address_street_box":null,"email":"info@lavillaculture.be","website":"http:\/\/www.lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":null,"address_zip":"1083","ad