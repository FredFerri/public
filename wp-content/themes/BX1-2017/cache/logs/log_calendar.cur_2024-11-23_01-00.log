, dat zowel als uitbreiding van het oorspronkelijke huis als als huurhuis moest dienen, en een gebouw rechts van het huis, een klein bijgebouw bij het hoofdhuis. ","booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=NL","sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":4486,"location":{"lat":50.8472189,"lon":4.3803579},"last_updated_at":"2024-10-28T12:06:41+01:00","published_at":"2013-10-19T01:17:26+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/5a57aec10038e7d006f80575af38f8adfec8a2ab.jpg","width":3349,"height":2233,"ratio":1.5,"oEmbed_height":2233,"oEmbed_width":3349,"translations":{"de":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"pt":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"en":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"it":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"cn":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"fr":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"sp":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"nl":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null}}}],"dates":[{"day":"2024-01-01","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-06","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-07","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-08","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-13","doors":nu