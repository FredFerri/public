partoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{"list":[89],"translations":{"fr":["Litt\u00e9rature"],"nl":["Literatuur"],"en":["Litterature "]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Openingsavond Wereldkampioenschap Poetry Slam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540083"},"nl":{"name":"Openingsavond Wereldkampioenschap Poetry Slam","shortdescr":"Het Wereldkampioenschap Poetry Slam 2022 strijkt neer in Muntpunt en dat vraagt om een feestelijke kick-off!","longdescr":"Op maandagavond 26 september verwelkomen we de 40 slam-kampioenen en buitenlandse organisatoren van competities wereldwijd in Muntpunt in Brussel met een niet te missen openingsfeest.\u00a0\n\nVerwacht je aan een spetterende showcase waarbij we het beste van onze Belgische Slam Poetry-scene tonen aan de internationale slam-scene \u00e9n aan Brussel. Wil je meer te weten komen over hoe slam poetry in de wereld wordt beleefd? Wij voorzien de gelegenheid om uit te wisselen, connecteren of banden te smeden met de vertegenwoordigers van de internationale slam-scene.\u00a0\n\nZin om zelf voor te dragen? Dat kan! In het Muntpunt Caf\u00e9 kan je gedurende de hele avond deelnemen aan de Open Mic die door de Brusselse spoken word-podia wordt gehost.\n\nIn de week van 26 september strijkt het Wereldkampioenschap Poetry Slam 2022 neer in Brussel! Op 27, 28 en 29 september vinden de halve finales en de finale plaats in Kinepolis, Brussel. Doorheen de stad strijkt de rest van de week een po\u00ebtisch festival neer met allerlei activiteiten.\n\nOntdek het complete programma: https:\/\/www.worldpoetryslam.org\/program","performers":null,"boxoffice_url":null,"website":"https:\/\/icontact.muntpunt.be\/civicrm\/event\/register?reset=1&id=8496","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540083"},"en":{"name":"Openingsavond Wereldkampioenschap Poetry Slam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540083"},"de":{"name":"Openingsavond Wereldkampioenschap Poetry Slam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540083"},"it":{"name":"Openingsavond Wereldkampioenschap Poetry Slam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540083"},"sp":{"name":"Openingsavond Wereldkampioenschap Poetry Slam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540083"},"pt":{"name":"Openingsavond Wereldkampioenschap Poetry Slam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540083"},"cn":{"name":"Openingsavond Wereldkampioenschap Poetry Slam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking"