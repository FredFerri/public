},{"id":50012900,"date_start":"2024-09-29","date_end":"2024-09-29","date_next":"2024-09-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-07-26T15:52:03+02:00","published_at":"2024-07-26T15:39:38+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":304643,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"D\u00e9fense de stationner : une histoire des garages en ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012900"},"pt":{"name":"D\u00e9fense de stationner : une histoire des garages en ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012900"},"en":{"name":"D\u00e9fense de stationner : une histoire des garages en ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012900"},"it":{"name":"D\u00e9fense de stationner : une histoire des garages en ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012900"},"cn":{"name":"D\u00e9fense de stationner : une histoire des garages en ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012900"},"fr":{"name":"D\u00e9fense de stationner : une histoire des garages en ville","shortdescr":"A l\u2019heure o\u00f9 de nombreux projets immobiliers viennent remplacer et effacer une partie de ce patrimoine, l\u2019ARAU vous fera d\u00e9ambuler d\u2019\u00eelots en \u00eelots dans un quartier historiquement marqu\u00e9 par l\u2019implantation de nombreuses activit\u00e9s li\u00e9es \u00e0 la voiture.","longdescr":"A c\u00f4t\u00e9 des bouleversements urbanistiques caus\u00e9s par les infrastructures autorouti\u00e8res, la ville a aussi h\u00e9rit\u00e9 d\u2019un patrimoine b\u00e2ti remarquable directement li\u00e9 \u00e0 la g\u00e9n\u00e9ralisation de l\u2019usage de la voiture : garages, pompes \u00e0 essence, ateliers, parkings\u2026Bien qu\u2019apparemment ordinaire, ce patrimoine est loin d\u2019\u00eatre anodin : ces lieux nous renvoient \u00e0 un pass\u00e9 industrieux, \u00e0 une histoire sociale, et \u00e0 des innovations techniques qui m\u00e9ritent d\u2019\u00eatre r\u00e9v\u00e9l\u00e9es et document\u00e9es. A l\u2019heure o\u00f9 de nombreux projets immobiliers viennent remplacer et effacer une partie de ce patrimoine, l\u2019ARAU vous fera d\u00e9ambuler d\u2019\u00eelots en \u00eelots dans un quartier historiquement marqu\u00e9 par l\u2019implantation de nombreuses activit\u00e9s li\u00e9es \u00e0 la voiture. De la Bascule au Ch\u00e2telain, des garages du square des Milliardaires \u00e0 la tour de d\u2019Ieteren, nous partirons \u00e0 la d\u00e9couverte des multiples facettes de ces garages urbains et des projets actuels de r\u00e9novation. L\u2019impact de l\u2019automobile en ville n\u2019est donc pas qu\u2019une histoire de pression, mais aussi de conservation et de reconversion !\n\nDur\u00e9e : 2h\n\nLieu de d\u00e9part : Devant le square du Bois (lieu-dit square des milliardaires) \/ avenue Louise, au pied de la statue de lutte \u00e9questre","performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012900"},"sp":{"name":"D\u00e9fense de stationner : une histoire des garages en ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012900"},"nl":{"name":"D\u00e9fense de stationner : une histoire des garages en ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012900"}},"place":{"id":50002096,"translations":{"de":{"name":"Square des milliardaires","address_street_name":"square du bois","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"square du bois","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Square des milliarda