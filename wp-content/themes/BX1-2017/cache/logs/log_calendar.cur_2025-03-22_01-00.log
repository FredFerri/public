":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[52],"translations":{"de":["Musiktheater"],"pt":[null],"en":["Musical theatre"],"it":["Teatro musicale"],"cn":[null],"fr":["Th\u00e9\u00e2tre musical"],"sp":["Teatro musical"],"nl":["Muziektheater"]}}},"translations":{"de":{"name":"Musical Theatre: \"The Right to Childhood\" by Patrycja Jankowska based on Janusz Korczak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mjb-jmb.org\/le-droit-a-lenfance-une-creation-de-patricia-jankowska-en-hommage-a-janusz-korczak\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007345"},"pt":{"name":"Musical Theatre: \"The Right to Childhood\" by Patrycja Jankowska based on Janusz Korczak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mjb-jmb.org\/le-droit-a-lenfance-une-creation-de-patricia-jankowska-en-hommage-a-janusz-korczak\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007345"},"en":{"name":"Musical Theatre: \"The Right to Childhood\" by Patrycja Jankowska based on Janusz Korczak","shortdescr":"On March 27, 2025, at 7 pm, the Royal Conservatory of Brussels is organizing an event at the Jewish Museum of Belgium about Janusz Korczak, a champion of children's rights. Musical Theatre: \"Le droit \u00e0 l\u2019enfance\" by Patrycja Jankowska, with music by Piotr Moss and coordination by Jean-Marc Fessard, evokes the fate of this educator, doctor, and writer who was deported to Treblinka in 1942.","longdescr":"On Thursday, March 27, 2025, at 7 pm, the Royal Conservatory of Brussels invites you to a special event at the Jewish Museum of Belgium. This event will highlight the life and work of Janusz Korczak, an emblematic figure in the defense of children's rights, through a moving musical theater performance.\n\n\"Le droit \u00e0 l\u2019enfance\" (The Right to Childhood) by Patrycja Jankowska, inspired by Janusz Korczak, tells the story of this educator and his commitment to children. The music of Piotr Moss will be performed by a violin, a clarinet, a double bass or a cello, and four actors from the Domaine Th\u00e9\u00e2tre et Arts de la Parole. Jean-Marc Fessard provides the artistic coordination for this engaged musical creation. Korczak dedicated his life to children before being deported with them to Treblinka in 1942.\n\nJanusz Korczak was a Polish pedagogue, physician, and writer. He is best known for his dedication to children's rights and his work with Jewish orphans in Warsaw. His literary work and pedagogical ideas continue to inspire generations of educators and children's rights advocates.\n\nFree entry \u2013 Reservation required : https:\/\/le-droit-lenfance-p-jankowska.eventsquare.store\/fr\/atklnl8b0vyw\/zunywyoruays","performers":null,"boxoffice_url":null,"website":"https:\/\/www.mjb-jmb.org\/en\/le-droit-a-lenfance-une-creation-de-patricia-jankowska-en-hommage-a-janusz-korczak\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007345"},"it":{"name":"Musical Theatre: \"The Right to Childhood\" by Patrycja Jankowska based on Janusz Korczak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mjb-jmb.org\/le-droit-a-lenfance-une-creation-de-patricia-jankowska-en-hommage-a-janusz-korczak\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007345"},"cn":{"name":"Musical Theatre: \"The Right to Childhood\" by Patrycja Jankowska based on Janusz Korczak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mjb-jmb.org\/le-droit-a-lenfance-une-creation-de-patricia-jankowska-en-hommage-a-janusz-korczak\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007345"},"fr":{"name":"Th\u00e9\u00e2tre musical : \"Le droit \u00e0 l\u2019enfance\" de Patrycja Jankowska d\u2019apr\u00e8s Janusz Korczak","shortdescr":"Le 27 mars 2025 \u00e0 19h, le Conservatoire Royal de Bruxelles organise un \u00e9v\u00e9nement au Mus\u00e9e Juif de Belgique sur Janusz Korczak, d\u00e9fenseur des droits de l'enfant. Th\u00e9\u00e2tre musical : \"Le droit \u00e0 l\u2019enfance\" de Patrycja Jankowska, avec la musique de Piotr Moss et la coordination de Jean-Marc Fessard, \u00e9voque le destin de cet \u00e9ducateur, m\u00e9decin et \u00e9crivain, d\u00e9port\u00e9 \u00e0 Treblinka en 1942.","longdescr":"Le jeudi 27 mars 2025 \u00e0 19h, le Conservatoire Royal de Bruxelles vous invite \u00e0 un \u00e9v\u00e9nement exceptionnel au Mus\u00e9e Juif de Belgique. Cet \u00e9v\u00e9nement mettra en lumi\u00e8re la vie et l\u2019\u0153uvre de Janusz Korczak, une figure embl\u00e9matique de la d\u00e9fense des droits de l\u2019enfant, \u00e0 travers un th\u00e9\u00e2tre musical poignant.\n\n\"Le droit \u00e0 l\u2019enfance\" de Patrycja Jankowska, d\u2019apr\u00e8s Janusz Korczak, s\u2019inspire du parcours de cet \u00e9ducateur et de son engagement en faveur des enfants. La musique de Piotr Moss, interpr\u00e9t\u00e9e par un violon, une clarinette, une contrebasse ou un violoncelle, et quatre com\u00e9dien\u00b7nes du Domaine Th\u00e9\u00e2tre et Arts de la Parole, accompagnera cette \u00e9vocation \u00e9mouvante. Jean-Marc Fessard assure la coordination artistique de cette cr\u00e9ation musicale engag\u00e9e. Korczak a consacr\u00e9 sa vie aux enfants avant d\u2019\u00eatre d\u00e9port\u00e9 avec eux \u00e0 Treblinka en 1942.\n\nJanusz Korczak \u00e9tait un p\u00e9dagogue, m\u00e9decin et \u00e9crivain polonais. Il est surtout connu pour son d\u00e9vouement aux droits des enfants et pour son travail aupr\u00e8s des orphelins juifs de Varsovie. Son \u0153uvre litt\u00e9raire et ses id\u00e9es p\u00e9dagogiques continuent d'inspirer des g\u00e9n\u00e9rations d'\u00e9ducateurs et de d\u00e9fenseurs des droits de l'enfant.\n\nEntr\u00e9e gratuite \u2013 R\u00e9servation obligatoire : https:\/\/le-droit-lenfance-p-jankowska.eventsquare.store\/fr\/atklnl8b0vyw\/zunywyoruays","performers":"Patrycja Jankowska (mise en sc\u00e8ne) ; Jean-Marc Fessard (coordination) d\u2019apr\u00e8s Janusz Korczak sur la musique de Piotr Moss, interpr\u00e9t\u00e9 par un violon, une clarinette, une contrebasse ou un violoncelle et 4 com\u00e9dien\u00b7nes du Domaine Th\u00e9\u00e2tre et Arts de la Parole. . ","boxoffice_url":null,"website":"https:\/\/www.mjb-jmb.org\/le-droit-a-lenfance-une-creation-de-patricia-jankowska-en-hommage-a-janusz-korczak\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007345"},"sp":{"name":"Musical Theatre: \"The Right to Childhood\" by Patrycja Jankowska based on Janusz Korczak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mjb-jmb.org\/le-droit-a-lenfance-une-creation-de-patricia-jankowska-en-hommage-a-janusz-korczak\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007345"},"nl":{"name":"Muziektheater: \"Het recht op kinderjaren\" van Patrycja Jankowska naar Janusz Korczak","shortdescr":"Op 27 maart 2025 om 19u organiseert het Koninklijk Conservatorium van Brussel een evenement in het Joods Museum van Belgi\u00eb over Janusz Korczak. Muziektheater: \"Le droit \u00e0 l\u2019enfance\" van Patrycja Jankowska belicht het lot van deze kinderrechtenverdediger, die in 1942 naar Treblinka werd gedeporteerd.","longdescr":"Op donderdag 27 maart 2025 om 19u nodigt het Koninklijk Conservatorium van Brussel u uit voor een bijzonder evenement in het Joods Museum van Belgi\u00eb. Dit evenement belicht het leven en werk van Janusz Korczak, een emblematische figuur in de verdediging van de rechten van het kind, door middel van een ontroerend muziektheater.\n\n\"Le droit \u00e0 l\u2019enfance\" (Het recht op kinderjaren) van Patrycja Jankowska, ge\u00efnspireerd door Janusz Korczak, vertelt het verhaal van deze opvoeder en zijn inzet voor kinderen. De muziek van Piotr Moss wordt uitgevoerd door een viool, een klarinet, een contrabas of een cello, en vier acteurs van het Domaine Th\u00e9\u00e2tre et Arts de la Parole. Jean-Marc Fessard verzorgt de artistieke co\u00f6rdinatie van deze ge\u00ebngageerde muzikale creatie. Korczak wijdde zijn leven aan kinderen voordat hij in 1942 met hen werd gedeporteerd naar Treblinka.\n\nJanusz Korczak was een Poolse pedagoog, arts en schrijver. Hij staat vooral bekend om zijn toewijding aan de rechten van het kind en zijn werk met Joodse wezen in Warschau. Zijn literaire werk en pedagogische idee\u00ebn blijven generaties opvoeders en verdedigers van kinderrechten inspireren.\n\nGratis toegang \u2013 Reservatie verplicht : https:\/\/le-droit-lenfance-p-jankowska.eventsquare.store\/fr\/atklnl8b0vyw\/zunywyoruays])","performers":null,"boxoffice_url":null,"website":"https:\/\/www.mjb-jmb.org\/nl\/le-droit-a-lenfance-une-creation-de-patricia-jankowska-en-hommage-a-janusz-korczak\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007345"}},"place":{"id":209899,"translations":{"de":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Das J\u00fcdische Museum Belgiens im Sablon-Viertel wirft anhand von Ausstellungen und Aktivit\u00e4ten einen Blick auf die j\u00fcdische Geschichte und Kultur. \r\n\r\nAls lebendiger und dynamischer Ort der Kultur und der Kunst m\u00f6chte das Museum Wissen und Verst\u00e4ndnis f\u00fcr die Geschichte des j\u00fcdischen Glaubens und der Kulturen vermitteln. \r\n\r\nDie drei wichtigsten Missionen sind hierbei die Bewahrung des j\u00fcdischen Kulturguts in Belgien, Wechselausstellungen zu aktuellen Themen sowie Konferenzen, Konzerte, Workshops und Literaturabende.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Jewish Museum of Belgium","address_street_name":"Minimenstraat","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Minimenstraat, 21","address_line2":"1000 Brussels","description_web":"Located in the Sablon district of Brussels, the Jewish Museum of Belgium takes a fresh look at Jewish history and culture through exhibitions and activities focusing on sharing, discovery and accessibility for all sectors of the public. \r\n \r\nFirmly anchored in the present day, it is an artistic and cultural place that is lively, dynamic and multidisciplinary, led by a team that values openness, boldness and modernity, and whose goal is to promote a knowledge and understanding of Jewish history, religion and culture.\r\n \r\nThrough its three principal missions, namely the preservation of Jewish heritage in Belgium, temporary exhibitions reflecting topical subjects and educational activities for school groups, the team is gradually constructing the public face of the New Museum that will open its doors by 2025.\r\n \r\nPending the start of work, visitors can discover a selection of the permanent collection as well as several temporary exhibitions in two buildings covering a total area of five floors. At the same time, the Museum organises a wide range of activities such as conferences, concerts, workshops and literary evenings.","description_print":null,"booking_url":"https:\/\/ticket.visit.brussels\/en\/209899\/Musee-Juif-de-Belgique\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 \u00e0 Bruxelles, dans le quartier du Sablon, le Mus\u00e9e Juif de Belgique porte un regard novateur sur l\u2019histoire et la culture juive \u00e0 travers des expositions et des activit\u00e9s tourn\u00e9es vers le partage, la d\u00e9couverte et l\u2019accessibilit\u00e9 \u00e0 tous les publics. \r\n \r\nR\u00e9solument ancr\u00e9 dans le pr\u00e9sent, c\u2019est un lieu culturel et artistique vivant, dynamique, pluridisciplinaire, emmen\u00e9 par une \u00e9quipe qui porte haut les valeurs d\u2019ouverture avec audace et modernit\u00e9 dont l\u2019objectif est de promouvoir la connaissance et la compr\u00e9hension de l\u2019histoire, de la religion et des cultures juives.\r\n \r\nA travers ses trois missions principales que sont la conservation du patrimoine juif de Belgique, les expositions temporaires en \u00e9cho \u00e0 des sujets d\u2019actualit\u00e9 et les activit\u00e9s \u00e9ducatives \u00e0 destination des publics scolaires, l\u2019\u00e9quipe construit progressivement le visage du Nouveau Mus\u00e9e qui verra le jour d\u2019ici 2025.\r\n \r\nEn attendant le d\u00e9but des travaux les visiteurs peuvent d\u00e9couvrir, sur deux b\u00e2timents et cinq \u00e9tages, une s\u00e9lection de la collection permanente, et plusieurs expositions temporaires. En parall\u00e8le, le Mus\u00e9e organise pl\u00e9thore d\u2019activit\u00e9s comme des conf\u00e9rences, concerts, ateliers, soir\u00e9es litt\u00e9raires.","description_print":null,"booking_url":"https:\/\/ticket.visit.brussels\/fr\/209899\/Musee-Juif-de-Belgique\/shop","sort_order":"Jewish Museum of Belgium","virtual_visit":null,"visit_url":null},"sp":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Joods Museum van Belgi\u00eb","address_street_name":"Minimenstraat","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org\/?lang=nl","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Minimenstraat, 21","address_line2":"1000 Brussel","description_web":"Het Joods Museum van Belgi\u00eb, gelegen in de Brusselse Zavelwijk, biedt een vernieuwende kijk op de joodse geschiedenis en cultuur aan de hand van tentoonstellingen en activiteiten die gericht zijn op uitwisseling, kennismaking en toegankelijkheid voor alle mogelijke doelgroepen. \r\n \r\nDoor zijn stevige verankering in het heden is het Museum een levendige, dynamische en multidisciplinaire culturele en artistieke locatie, die wordt gedragen door een team dat de waarden van openheid op doortastende en eigentijdse wijze uitdraagt, met de bedoeling om kennis en inzicht in de joodse geschiedenis, godsdienst en culturen te bevorderen.\r\n \r\nVia zijn drie hoofdopdrachten - het behoud van het Belgische joodse erfgoed, tijdelijke tentoonstellingen die aansluiten bij actuele onderwerpen en educatieve activiteiten voor scholen - bouwt het team geleidelijk aan het gezicht uit van het Nieuwe Museum dat tegen 2025 tot stand zal komen.\r\n \r\nIn afwachting van de werken kunnen de bezoekers verspreid over twee gebouwen en vijf verdiepingen kennismaken met een selectie van de permanente collectie en enkele tijdelijke tentoonstellingen. Tegelijk organiseert het Museum een ruime keuze aan activiteiten, zoals lezingen, concerten, workshops en literaire avonden.","description_print":null,"booking_url":"https:\/\/ticket.visit.brussels\/nl\/209899\/Musee-Juif-de-Belgique\/shop","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":469,"location":{"lat":50.8407857,"lon":4.3532327},"region":"brussels","last_updated_at":"2025-02-06T08:24:34+01:00","published_at":"2013-10-19T01:13:33+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":209899,"translations":{"de":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Das J\u00fcdische Museum Belgiens im Sablon-Viertel wirft anhand von Ausstellungen und Aktivit\u00e4ten einen Blick auf die j\u00fcdische Geschichte und Kultur. \r\n\r\nAls lebendiger und dynamischer Ort der Kultur und der Kunst m\u00f6chte das Museum Wissen und Verst\u00e4ndnis f\u00fcr die Geschichte des j\u00fcdischen Glaubens und der Kulturen vermitteln. \r\n\r\nDie drei wichtigsten Missionen sind hierbei die Bewahrung des j\u00fcdischen Kulturguts in Belgien, Wechselausstellungen zu aktuellen Themen sowie Konferenzen, Konzerte, Workshops und Literaturabende.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Jewish Museum of Belgium","address_street_name":"Minimenstraat","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Minimenstraat, 21","address_line2":"1000 Brussels","description_web":"Located in the Sablon district of Brussels, the Jewish Museum of Belgium takes a fresh look at Jewish history and culture through exhibitions and activities focusing on sharing, discovery and accessibility for all sectors of the public. \r\n \r\nFirmly anchored in the present day, it is an artistic and cultural place that is lively, dynamic and multidisciplinary, led by a team that values openness, boldness and modernity, and whose goal is to promote a knowledge and understanding of Jewish history, religion and culture.\r\n \r\nThrough its three principal missions, namely the preservation of Jewish heritage in Belgium, temporary exhibitions reflecting topical subjects and educational activities for school groups, the team is gradually constructing the public face of the New Museum that will open its doors by 2025.\r\n \r\nPending the start of work, visitors can discover a selection of the permanent collection as well as several temporary exhibitions in two buildings covering a total area of five floors. At the same time, the Museum organises a wide range of activities such as conferences, concerts, workshops and literary evenings.","description_print":null,"booking_url":"https:\/\/ticket.visit.brussels\/en\/209899\/Musee-Juif-de-Belgique\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 \u00e0 Bruxelles, dans le quartier du Sablon, le Mus\u00e9e Juif de Belgique porte un regard novateur sur l\u2019histoire et la culture juive \u00e0 travers des expositions et des activit\u00e9s tourn\u00e9es vers le partage, la d\u00e9couverte et l\u2019accessibilit\u00e9 \u00e0 tous les publics. \r\n \r\nR\u00e9solument ancr\u00e9 dans le pr\u00e9sent, c\u2019est un lieu culturel et artistique vivant, dynamique, pluridisciplinaire, emmen\u00e9 par une \u00e9quipe qui porte haut les valeurs d\u2019ouverture avec audace et modernit\u00e9 dont l\u2019objectif est de promouvoir la connaissance et la compr\u00e9hension de l\u2019histoire, de la religion et des cultures juives.\r\n \r\nA travers ses trois missions principales que sont la conservation du patrimoine juif de Belgique, les expositions temporaires en \u00e9cho \u00e0 des sujets d\u2019actualit\u00e9 et les activit\u00e9s \u00e9ducatives \u00e0 destination des publics scolaires, l\u2019\u00e9quipe construit progressivement le visage du Nouveau Mus\u00e9e qui verra le jour d\u2019ici 2025.\r\n \r\nEn attendant le d\u00e9but des travaux les visiteurs peuvent d\u00e9couvrir, sur deux b\u00e2timents et cinq \u00e9tages, une s\u00e9lection de la collection permanente, et plusieurs expositions temporaires. En parall\u00e8le, le Mus\u00e9e organise pl\u00e9thore d\u2019activit\u00e9s comme des conf\u00e9rences, concerts, ateliers, soir\u00e9es litt\u00e9raires.","description_print":null,"booking_url":"https:\/\/ticket.visit.brussels\/fr\/209899\/Musee-Juif-de-Belgique\/shop","sort_order":"Jewish Museum of Belgium","virtual_visit":null,"visit_url":null},"sp":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Joods Museum van Belgi\u00eb","address_street_name":"Minimenstraat","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org\/?lang=nl","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Minimenstraat, 21","address_line2":"1000 Brussel","description_web":"Het Joods Museum van Belgi\u00eb, gelegen in de Brusselse Zavelwijk, biedt een vernieuwende kijk op de joodse geschiedenis en cultuur aan de hand van tentoonstellingen en activiteiten die gericht zijn op uitwisseling, kennismaking en toegankelijkheid voor alle mogelijke doelgroepen. \r\n \r\nDoor zijn stevige verankering in het heden is het Museum een levendige, dynamische en multidisciplinaire culturele en artistieke locatie, die wordt gedragen door een team dat de waarden van openheid op doortastende en eigentijdse wijze uitdraagt, met de bedoeling om kennis en inzicht in de joodse geschiedenis, godsdienst en culturen te bevorderen.\r\n \r\nVia zijn drie hoofdopdrachten - het behoud van het Belgische joodse erfgoed, tijdelijke tentoonstellingen die aansluiten bij actuele onderwerpen en educatieve activiteiten voor scholen - bouwt het team geleidelijk aan het gezicht uit van het Nieuwe Museum dat tegen 2025 tot stand zal komen.\r\n \r\nIn afwachting van de werken kunnen de bezoekers verspreid over twee gebouwen en vijf verdiepingen kennismaken met een selectie van de permanente collectie en enkele tijdelijke tentoonstellingen. Tegelijk organiseert het Museum een ruime keuze aan activiteiten, zoals lezingen, concerten, workshops en literaire avonden.","description_print":null,"booking_url":"https:\/\/ticket.visit.brussels\/nl\/209899\/Musee-Juif-de-Belgique\/shop","sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":469,"location":{"lat":50.8407857,"lon":4.3532327},"last_updated_at":"2025-02-06T08:24:34+01:00","published_at":"2013-10-19T01:13:33+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[],"dates":[{"day":"2025-03-27","doors":"18:30:00","start":"19:00:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[10,11],"translations":{"de":["Senioren","Familie"],"pt":[null,null],"en":["Seniors","Family"],"it":["Anziani","Famiglie"],"cn":[null,null],"fr":["Seniors","Famille"],"sp":["Personas de la tercera edad","Familias"],"nl":["Senioren","Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":5700007731,"date_start":"2025-03-27","date_end":"2025-03-27","date_next":"2025-03-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-17T13:22:04+01:00","published_at":"2025-03-17T13:10:09+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":320108,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Violoncelle et piano aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007731"},"pt":{"name":"Violoncelle et piano aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007731"},"en":{"name":"Violoncelle et piano aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007731"},"it":{"name":"Violoncelle et piano aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007731"},"cn":{"name":"Violoncelle et piano aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007731"},"fr":{"name":"Violoncelle et piano aux Concerts de Midi.","shortdescr":null,"longdescr":"La brillante violoncelliste Camille SEGHERS et le pianiste Alexis THIBAUT DE MAISI\u00c8RES forment un tr\u00e8s beau duo depuis la fin de leurs \u00e9tudes. Aux Concerts de Midi,  le duo jouera l\u2019impressionnante Sonate de Serge\u00ef Prokofiev, compos\u00e9e en 1949 pour le jeune Mstislav Rostropovitch. Au programme \u00e9galement l'inattendue Sonate de Fr\u00e9d\u00e9ric Chopin,  compos\u00e9e en 1846. Il s'agit du dernier opus publi\u00e9 de son vivant. Elle est d\u00e9di\u00e9e au virtuose  Auguste-Joseph Franchomme.\nVoici le programme de Camille SEGHERS, violoncelle, et Alexis THIBAUT DE MAISI\u00c8RES, piano.\nSerge\u00ef PROKOFIEV (1891-1953) \nCello Sonata in C major Op. 119 \nAndante grave -  Moderato -  Allegro, ma non troppo \nFr\u00e9d\u00e9ric CHOPIN (1810-1859) \nSonate pour violoncelle en sol mineur op. 65 \nAllegro moderato - Scherzo: Allegro con brio -  Largo - Finale: allegro. \n\n","performers":"Camille SEGHERS (violoncelle)  \nAlexis THIBAUT DE MAISI\u00c8RES  (piano)\n","boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007731"},"sp":{"name":"Violoncelle et piano aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007731"},"nl":{"name":"Cello en piano in de Middagconcerten.","shortdescr":null,"longdescr":"De briljante celliste Camille SEGHERS en pianist Alexis THIBAUT DE MAISI\u00c8RES vormen sinds het einde van hun studies een prachtig duo. In de Middagconcerten zal het duo de indrukwekkende Sonate van Serge\u00ef Prokofiev spelen, gecomponeerd in 1949 voor de jonge Mstislav Rostropovitch. Op het programma staat eveneens de onverwachte Sonate van Fr\u00e9d\u00e9ric Chopin, in 1846 gecomponeerd. Het is het laatste opus gepubliceerd tijdens zijn leven en is opgedragen aan virtuoos Auguste-Joseph Franchomme.\nZiehier het programma van Camille SEGHERS, cello, en Alexis THIBAUT DE MAISI\u00c8RES, piano.\nSerge\u00ef PROKOFIEV (1891-1953) \nCello Sonata in C major Op. 119 \nAndante grave -  Moderato -  Allegro, ma non troppo \nFr\u00e9d\u00e9ric CHOPIN (1810-1859) \nSonate pour violoncelle en sol mineur op. 65 \nAllegro moderato - Scherzo: Allegro con brio -  Largo - Finale: allegro. \n","performers":"Camille SEGHERS (cello)  \nAlexis THIBAUT DE MAISI\u00c8RES  (piano)","boxoffice_url":null,"website":"https:\/\/lunchconcerts-brussels.be\/nl\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007731"}},"place":{"id":100473,"translations":{"de":{"name":"MIM - Musikinstrumente-Museum (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Musikinstrumente-Museum mit 1200 ausgestellten Musikinstrumenten und vielf\u00e4ltigen Sammlungen (mit insgesamt 8000 Instrumenten!), untergebracht in einem bemerkenswerten Jugendstilgeb\u00e4ude, ist ein Paradies f\u00fcr Musikinteressierte.\r\n\r\nMusikgeschichte und Jugendstilarchitektur: Das Musikinstrumente-Museum befindet sich in den ehemaligen Geb\u00e4uden des \u201eOld England\u201c-Kaufhauses und gilt als eines der herausragenden Beispiele f\u00fcr die Br\u00fcsseler Jugendstilarchitektur.\r\n\r\nMusikalische Welt- und Zeitreise: Auf vier Ebenen pr\u00e4sentiert das Museum Musikinstrumente aus verschiedenen Kulturkreisen und Epochen \u2013 und so begibt sich der Besucher auf eine musikalische Welt- und Zeitreise. Die Ausstellungsgestaltung verkn\u00fcpft gekonnt klangliche und visuelle Dimensionen.\r\n\r\nKulinarischer H\u00f6hepunkt, im wahrsten Sinne des Wortes, ist das Restaurant im 6. Stock mit Dachterrasse.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MIM - Museu dos Instrumentos Musicais","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Todo o mundo admira a cole\u00e7\u00e3o do Museu dos Instrumentos Musicais, que pertence ao conjunto dos Museus Reais de Arte e da Hist\u00f3ria. Este museu assenta no cora\u00e7\u00e3o dos velhos edif\u00edcios Old England, um dos edif\u00edcios mais belos de estilo Art Nouveau de Bruxelas, datando de 1899. Este museu \u00e9 um dos mais ricos do mundo: cerca de 1200 instrumentos encontram-se a\u00ed expostos. Consta da programa\u00e7\u00e3o de interessantes anima\u00e7\u00f5es e in\u00fameros concertos.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MIM - Musical Instruments Museum (MRAH)","address_street_name":"Hofberg","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Hofberg, 2","address_line2":"1000 Brussels","description_web":"As soon as it opened at the end of the 19th century, the luxurious Old England department store earned an excellent reputation for its highly distinctive building. The entrance to the building is a jewel of the Art Nouveau style, while the rest is in perfect harmony with the neoclassical ensemble on the Place Royale, and just around the corner from the Grand-Place and Central Station, no less! \r\nWith a wealth of some 9.000 instruments, some 1.200 of which are on permanent exhibit, the museum's reputation is mainly built on its extraordinary collections.\r\nOnce inside, you'll embark on a true tour of the musical world. After your visit, the instruments and their history will no longer hold any secrets: from the viola da gamba from the Court of Brussels to the 20th century theremin, and even including the African kora!\r\nThe mim is nothing other than a place to experience music. A visitor's guidance system allows you to explore the thematic tours to the tune of the melodious sound of the instruments presented.\r\nA program packed with concerts, demonstrations and workshops for the young and the not so young makes the mim experience even better.\r\nThe mim has its own concert hall, specialized library, museum shop, workshop for restauration and conservation of musical instruments and is crowned by a restaurant with panoramic view over Brussels.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo degli Strumenti Musicali","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Il MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e...\r\n\r\nIl MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e diversificato dal Belgio e dall'estero. Presenta un'ampio panorama della musica antica, moderna, popolare e tradizionale.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Le monde entier admire la collection du Mus\u00e9e des instruments de musique qui fait partie du groupement des Mus\u00e9es Royaux d\u2019Art et d\u2019Histoire. Ce Mus\u00e9e est camp\u00e9 au c\u0153ur des anciens b\u00e2timents Old England, un des plus beaux b\u00e2timents de style Art Nouveau de Bruxelles, datant de 1899. Ce mus\u00e9e est l\u2019un des plus riches au monde : quelques 1.200 instruments y sont expos\u00e9s. D\u2019int\u00e9ressantes animations et de nombreux concerts y sont programm\u00e9s.","description_print":null,"booking_url":null,"sort_order":"MIM","virtual_visit":null,"visit_url":null},"sp":{"name":"El MIM, Museo de Instrumentos de M\u00fasica","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"El Museo MIM te invita a contemplar y escuchar 1.200 instrumentos de m\u00fasica en un edificio Art Nouveau de Bruselas. \r\n\r\nEl Museo de Instrumentos de M\u00fasica, que forma parte de los Museos Reales de Arte e Historia, abre sus puertas en las proximidades de la Place Royale, en el Mont des Arts, el barrio de los museos de Bruselas. \r\n\r\nEl MIM se encuentra en los antiguos almacenes de Art Nouveau, Old England, un aut\u00e9ntico tesoro arquitect\u00f3nico de finales del s. XIX.\r\n\r\nEl MIM debe su reputaci\u00f3n, sobre todo, a sus extraordinarias colecciones. Ven a dar la vuelta al mundo musical a trav\u00e9s de sus 1.200 piezas distribuidas por las 4 plantas de la exposici\u00f3n.\r\n\r\n\r\nComo es de suponer, el MIM es el lugar ideal para disfrutar de la m\u00fasica. Un sistema de cascos con infrarrojos permite explorar los recorridos tem\u00e1ticos al tiempo que se escucha el sonido melodioso de los instrumentos que se presentan.\r\n   \r\nEl MIM tambi\u00e9n es\u2026\r\n\r\n- Una sala de conciertos\r\n- Un espacio para talleres\r\n- Un Museumshop\r\n- Una biblioteca especializada\r\n- Y un restaurante con terraza, con unas vistas \u00fanicas al centro hist\u00f3rico de la capital europea\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MIM - Muziekinstrumentenmuseum (KMKG)","address_street_name":"Hofberg","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Hofberg, 2","address_line2":"1000 Brussel","description_web":"Het Muziekinstrumentenmuseum (MIM) bewaart een onschatbare collectie van muzikaal erfgoed en presenteert ze op een schitterende manier. Het MIM beschikt daarvoor over veel troeven. De intu\u00eftieve presentatie is aantrekkelijk en klantvriendelijk. De collectie huist bovendien in een schitterend gerestaureerd art-nouveaupand. Het MIM presenteert een honderdtal middagconcerten per jaar en biedt een waaier aan groepsactiviteiten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":359,"location":{"lat":50.8427438,"lon":4.3590245},"region":"brussels","last_updated_at":"2024-08-22T15:56:07+02:00","published_at":"2013-10-19T01:13:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":279466,"translations":{"de":{"name":"Concerts de Midi asbl","address_street_name":"Rue Lebeau","address_street_number":"39","address_street_box":null,"email":"info@concertsdemidi.be","website":"https:\/\/www.concertsdemidi.be\/nl\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 39","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Concerts de Midi asbl","address_street_name":"Rue Lebeau","address_street_number":"39","address_street_box":null,"email":"info@concertsdemidi.be","website":"https:\/\/www.concertsdemidi.be\/nl\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 39","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Concerts de Midi asbl","address_street_name":"Rue Lebeau",