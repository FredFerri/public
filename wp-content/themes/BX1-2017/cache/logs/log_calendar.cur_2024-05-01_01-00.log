2 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009911"},"en":{"name":"ONE PIECE : animation art show","shortdescr":"Welcome to Galerie de la Bande Dessinee. For the first time ever, an art gallery exhibits and offers for sale production drawings from the famous One Piece anime. ","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galeriebd.com\/artistes\/oda-eiichiro-one-piece\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009911"},"it":{"name":"ONE PIECE : animation art show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galeriebd.com\/artistes\/oda-eiichiro-one-piece\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009911"},"cn":{"name":"ONE PIECE : animation art show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galeriebd.com\/artistes\/oda-eiichiro-one-piece\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009911"},"fr":{"name":"ONE PIECE : Exposition-vente de dessins originaux","shortdescr":"C\u2019est une premi\u00e8re mondiale ! \nLa Galerie de la Bande Dessin\u00e9e est la premi\u00e8re galerie d\u2019art \u00e0 exposer et \u00e0 vendre des dessins originaux de production du c\u00e9l\u00e8bre anime One Piece. \nL\u2019occasion pour les fans, et ils sont nombreux, de d\u00e9couvrir pour la premi\u00e8re fois les dessins originaux r\u00e9alis\u00e9s par les animateurs de Toei Animation ayant r\u00e9alis\u00e9 cette palpitante s\u00e9rie t\u00e9l\u00e9vis\u00e9e d\u2019animation. \n","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galeriebd.com\/artistes\/oda-eiichiro-one-piece\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009911"},"sp":{"name":"ONE PIECE : animation art show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galeriebd.com\/artistes\/oda-eiichiro-one-piece\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009911"},"nl":{"name":"ONE PIECE - Tentoonstelling en verkoop van originele animatietekeningen","shortdescr":"Dit is een wereldprimeur!\nGalerie de la Bande Dessinee is de eerste kunstgalerie die originele productietekeningen van de beroemde anime One Piece tentoonstelt en verkoopt.\nDe kans voor fans, en dat zijn er velen, om voor het eerst de originele tekeningen te ontdekken die zijn gemaakt door de animators van Toei Animation die deze spannende geanimeerde televisieserie hebben gemaakt.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galeriebd.com\/artistes\/oda-eiichiro-one-piece\/","email":"info@galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009911"}},"place":{"last_updated_at":"2024-04-22T09:17:07+02:00","published_at":"2018-04-12T20:39:48+02:00","id":271230,"translations":{"de":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":"Based in the heart of Brussels, close to the European District, the gallery specializes in the exhibition, sale and purchase of original comic and illustration art.\r\nWhether you\u2019ve been fond of comic books since childhood or are just discovering this fantastic medium, we offer a selection of more than a thousand pieces from well-known and up-and-coming comic book artists, both European and American. We also showcase the art of children\u2019s book illustrators.","description_print":"Based in the heart of Brussels, close to the European District, the Comic Art Factory gallery specializes in the exhibition, sale and purchase of original comic and illustration art.\r\n\r\nWhether you\u2019ve been fond of comic books since childhood or are just discovering this fantastic medium, we offer a selection of more than a thousand pieces from well-known and up-and-coming comic book artists, both European and American. We also showcase the art of children\u2019s book illustrators.\r\nWe offer consulting services on how to build a collection, and are always interested in buying great pieces of art.\r\n\r\nIt would be a pleasure to have you at our gallery, where you can see our passion for sequential art firsthand. We\u2019re open Thursday through Saturday, 1 PM to 7 PM, as well as other days by appointment.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","address_street_number":"237","address_street_box":null,"email":"info@galeriebd.com","website":"https:\/\/www.galeriebd.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre , 237","address_line2":"1050 Ixelles","description_web":"Situ\u00e9e au c\u0153ur de Bruxelles, proche du Quartier Europ\u00e9en, La Galerie de la Bande Dessin\u00e9e est sp\u00e9cialis\u00e9e dans l\u2019exposition, l\u2019achat et la vente de dessins BD originaux, de planches originales de bande dessin\u00e9e, d\u2019illustrations originales, de cellulos de dessins anim\u00e9s et de crayonn\u00e9s d\u2019animation japonaise (layouts, dogas, gengas).\n  \nFr\u00e9d\u00e9ric Lorge, le directeur de la galerie, qu\u2019il a cr\u00e9\u00e9e en 2014, est membre de la Chambre belge des experts en bandes dessin\u00e9es.\n\nQue vous soyez passionn\u00e9s de bande dessin\u00e9e, lectrice ou lecteur occasionnel, fan de BD franco-belge, de comics am\u00e9ricains, ou de mangas, nous vous proposons plus d\u2019un millier d\u2019\u0153uvres d\u2019art disponibles \u00e0 la vente. Nous vous recevrons avec plaisir, et partagerons avec vous notre passion pour le neuvi\u00e8me art et l\u2019animation japonaise.\n","description_print":"Situ\u00e9e au c\u0153ur de Bruxelles, proche du Quartier Europ\u00e9en, la galerie d\u2019art Comic Art Factory est sp\u00e9cialis\u00e9e dans l\u2019exposition, l\u2019achat et la vente de planches originales de bande dessin\u00e9e et d\u2019illustrations originales.\r\n\r\nQue vous soyez passionn\u00e9s de bande dessin\u00e9e, lectrice ou lecteur occasionnel, fan de BD franco-belge ou de comics am\u00e9ricains, nous vous proposons d\u2019acheter les planches BD et les illustrations originales d\u2019autrices et d\u2019auteurs de bande dessin\u00e9e, prometteurs ou confirm\u00e9s.\r\nNous proposons \u00e9galement un service de conseil pour celles et ceux qui souhaitent commencer une collection ou l\u2019affiner.\r\n\r\nNous sommes ouverts du jeudi au samedi, de 13 \u00e0 19h. Les autres jours sur rendez-vous. Nous vous recevrons avec plaisir, et partagerons avec vous notre passion pour le neuvi\u00e8me art.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre ","ad