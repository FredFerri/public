ull,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":535911,"date_start":"2022-09-19","date_end":"2022-09-20","date_next":"2022-09-19","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"\u00c7a va saigner!","shortdescr":"\u00c7a commence par les excuses de l\u2019homme parce qu\u2019il est homme. Et \u00e7a vous m\u00eame loin. On rigole, on grince des dents, on prend du recul, et on est content d\u2019\u00eatre venu. On en redemande m\u00eame.","longdescr":"Le monde doit se d\u00e9construire. Comme les hommes quinquag\u00e9naires. Et un tas d\u2019autres choses en fin d\u2019usage. La jeune auteure am\u00e9ricaine pointe du doigt le relief de l\u2019\u00e9poque. Et elle pique la o\u00f9 \u00e7a fait mal.\r\nUn texte d\u2019un genre nouveau pour \u00c9ric Boschman, qu\u2019il s\u2019approprie en y ajoutant des coups de verve bien caract\u00e9ristiques d\u2019un des trublions les plus corrosifs de son \u00e9poque. On rigole, mais surtout on un se pose des questions.\r\nLylian Scott est une jeune auteure am\u00e9ricaine de la c\u00f4te Est, ses \u0153uvres arrivent \u00e0 peine en Europe depuis octobre 21. Elle raconte son \u00e9poque au scalpel, incisive, ironique, elle parle de l\u2019\u00e9rotisme des gens de sa g\u00e9n\u00e9ration, de ses envies, de ses d\u00e9rapages. De ses visites aux thermes naturistes de sa ville \u00e0 sa premi\u00e8re d\u00e9gustation de cuisses de grenouilles, tout y passe sans concessions.","performers":"SEUL EN SC\u00c8NE D'APR\u00c8S LYLIAN SCOTT - ADAPT. FR. DE LUDOVIC LECARRET\r\nD'apr\u00e8s Lylian Scott - Adapt. fr. de Ludovic LeCarret \u25aa Avec: \u00c9ric Boschman","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=FR","website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":null,"phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535911"},"nl":{"name":"\u00c7a va saigner!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=NL","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535911"},"en":{"name":"\u00c7a va saigner!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=EN","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535911"},"de":{"name":"\u00c7a va saigner!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535911"},"it":{"name":"\u00c7a va saigner!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535911"},"sp":{"name":"\u00c7a va saigner!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.535911"},"pt":{"name":"\u00c7a va saigner!","shortdescr":null,"longdescr":null,"performers":null,"