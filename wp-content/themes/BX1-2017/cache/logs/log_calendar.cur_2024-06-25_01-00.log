false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":252838,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.30867895949930413,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"La Renaissance \u00e0 la cath\u00e9drale des Saints-Michel-et-Gudule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.egliseetourisme.be","email":"etkt@skynet.be","phone_contact":"+32 2 219 75 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.532838"},"pt":{"name":"La Renaissance \u00e0 la cath\u00e9drale des Saints-Michel-et-Gudule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.egliseetourisme.be","email":"etkt@skynet.be","phone_contact":"+32 2 219 75 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.532838"},"en":{"name":"The Renaissance at the Cathedral of Saints Michael and Gudula","shortdescr":null,"longdescr":"The cathedral reached the height of its splendour in the 16th century, during the Renaissance, particularly during the reign of the Habsburgs and Charles V. The magnificent stained glass windows in the choir and the Blessed Sacrament Chapel are a testament to this. \r\n\r\nWith a guide, discover the richness of the Renaissance style through the works of art and furniture that decorate one of the most prestigious religious buildings in Brussels. \r\n\r\nDuration : +- 1h60 only on reservation (at least one week in advance). ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.egliseetourisme.be","email":"etkt@skynet.be","phone_contact":"+32 2 219 75 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.532838"},"it":{"name":"La Renaissance \u00e0 la cath\u00e9drale des Saints-Michel-et-Gudule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.egliseetourisme.be","email":"etkt@skynet.be","phone_contact":"+32 2 219 75 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.532838"},"cn":{"name":"La Renaissance \u00e0 la cath\u00e9drale des Saints-Michel-et-Gudule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.egliseetourisme.be","email":"etkt@skynet.be","phone_contact":"+32 2 219 75 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.532838"},"fr":{"name":"La Renaissance \u00e0 la cath\u00e9drale des Saints-Michel-et-Gudule","shortdescr":null,"longdescr":"C\u2019est au 16e si\u00e8cle, \u00e0 la Renaissance, que la cath\u00e9drale atteignit l\u2019apog\u00e9e de sa splendeur, particuli\u00e8rement sous le r\u00e8gne des Habsbourg et du c\u00e9l\u00e8bre Charles Quint. En t\u00e9moignent les magnifiques vitraux du ch\u0153ur et de la chapelle du Saint-Sacrement.\r\n\r\nD\u00e9couvrez en compagnie d'un guide toute la richesse du style Renaissance au travers des \u0153uvres d\u2019art et du mobilier qui d\u00e9corent l\u2019un des plus prestigieux \u00e9difices religieux de Bruxelles.\r\n\r\nDur\u00e9e :+- 1h60 uniquement sur r\u00e9servation (au minimum une semaine \u00e0 l\u2019avance). R\u00e9servation :obligatoire au minimum 1 semaine avant.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.egliseetourisme.be","email":"etkt@skynet.be","phone_contact":"+32 2 219 75 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.532838"},"sp":{"name":"El Renacimiento en la Catedral de San Miguel y Santa G\u00fadula","shortdescr":null,"longdescr":"Fue en el siglo XVI, durante el Renacimiento, cuando la catedral alcanz\u00f3 la cumbre de su esplendor, particularmente bajo el reinado de los Habsburgo y el famoso Carlos V. Las magn\u00edficas vidrieras del coro y la capilla del Sant\u00edsimo Sacramento dan testimonio de ello. \r\n\r\nDescubre en compa\u00f1\u00eda de un gu\u00eda toda la riqueza del estilo renacentista a trav\u00e9s de las obras de arte y mobiliario que decoran uno de los edificios religiosos m\u00e1s prestigiosos de Bruselas. \r\n\r\nDuraci\u00f3n: +- 1h60 s\u00f3lo con reserva (al menos con una semana de antelaci\u00f3n). ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.egliseetourisme.be","email":"etkt@skynet.be","phone_contact":"+32 2 219 75 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.532838"},"nl":{"name":"De renaissance in de Kathedraal van Sint-Michiel en Sint-Goedele","shortdescr":null,"longdescr":"In de 16de eeuw bereikte de kathedraal haar luisterlijke hoogtepunt, meer bepaald onder het bewind van de Habsburgers en de illustere Karel V. Aanschouw de schitterende glas-in-loodramen in het koor en de Heilige Sacramentskapel. Dankzij onze gidsen ontdek je de rijkdom van de renaissancestijl via de kunstwerken, het meubilair en de binneninrichting van een van de meest prestigieuze, religieuze gebouwen van Brussel.\r\n\r\nDuur: +- 1h60 enkel op reservatie (minstens een week op voorhand). ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.egliseetourisme.be","email":"etkt@skynet.be","phone_contact":"+32 2 219 75 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.532838"}},"place":{"id":478,"translations":{"de":{"name":"Kathedrale Saints Michel et Gudule","address_street_name":"Parvis Sainte Gudule","address_street_number":null,"address_street_box":null,"email":"arsincathedrali@gmail.com","website":"http:\/\/www.cathedralisbruxellensis.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parvis Sainte Gudule","address_line2":"1000 Bruxelles","description_web":"Die die auf einer Anh\u00f6he erbaute Br\u00fcsseler Kathedrale Saints-Michel-et-Gudule ragt nach den st\u00e4dtebaulichen Ver\u00e4nderungen des Br\u00fcsseler Nordens im 20. Jahrhunderts wie ein Monument aus der Br\u00fcsseler Skyline hervor.\r\n\r\nIhre heutige Gestalt veranschaulicht deutlich die drei aufeinanderfolgenden Bauphasen im gotischen Stil. In Angriff genommen wurde der Bau der Kathedrale bereits im 13. Jahrhundert, doch fertiggestellt wurde sie erst zwei Jahrhunderte sp\u00e4ter. Besonders eindrucksvoll sind die \u00dcberreste der romanischen Stiftskirche sowie die pr\u00e4chtigen Fenster aus dem 16. Jh., die Apostelstatuen im Schiff, die Kanzel im Barockstil, der Schatz und die gro\u00dfe Orgel.\r\n\r\nBei der Kathedrale handelt es sich um das wichtigste Gotteshaus der Stadt Br\u00fcssel, gleichzeitig dient sie als Sitz der Erzdi\u00f6zese Br\u00fcssel-Malines, der h\u00f6chstens Instanz der kirchlichen Hierarchie in Belgien. Desweiteren spielt sie eine wichtige Rolle im gesellschaftlichen, geistlichen und kulturellen Leben der Stadt und des Landes, denn hier finden auch die wichtigsten Zeremonien der K\u00f6nigsfamilie statt (Trauerfeiern, Hochzeiten, so auch die Hochzeit des derzeitigen K\u00f6nigs Philippe etc.).","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Cath\u00e9drale Saints Michel et Gudule","address_street_name":"Parvis Sainte-Gudule","address_street_number":null,"address_street_box":null,"email":"arsincathedrali@gmail.com","website":"http:\/\/www.cathedralisbruxellensis.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parvis Sainte-Gudule","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Cathedrale Saints Michel et Gudule","address_street_name":"Parvis Sainte Gudule","address_street_number":null,"address_street_box":null,"email":"arsincathedrali@gmail.com","website":"http:\/\/www.cathedralisbruxellensis.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Parvis Sainte Gudule","address_line2":"1000 Brussels","description_web":"A veritable juxtaposition of Brabant Gothic styles takes us back to the 13th century and the atmosphere of the great builders. Its two towers give it a very French appearance. Building of the cathedral started in 1226, whilst the facade dates from the 15th century. The prodigious stained-glass windows of the transept and of La Chapelle du Saint-Sacrement (Chapel of the Blessed Sacrament) were inspired by the drawings of Bernard Van Orley and donated by Charles V and his family. The chancel is the final resting place of Jean II, Duke of Brabant, his wife Margaret of York and the Archduke Ernest. The Archduke Albert and his wife Isabelle and Archduke Charles de Lorraine lie in the chapel of Saint-Sacrement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Cattedrale St-Michel e Gudule a Bruxelles","address_street_name":"Parvis Sainte Gudule","address_street_number":null,"address_street_box":null,"email":"arsincathedrali@gmail.com","website":"http:\/\/www.cathedralisbruxellensis.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parvis Sainte Gudule","address_line2":"1000 Bruxelles","description_web":"Costruita in cima ad una collina, la cattedrale riflette le tre fasi dello stile gotico della sua costruzione.\u00a0...\r\n\"Costruita in cima ad una collina, la cattedrale riflette le tre fasi dello stile gotico della sua costruzione.\r\nDa notare i resti della collegiata romanica, le sue vetrate del XVI secolo, le statue degli apostoli della navata, il pulpito in stile barocco, il suo tesoro, il suo grande organo.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Cath\u00e9drale Saints Michel et Gudule","address_street_name":"Parvis Sainte-Gudule","address_street_number":null,"address_street_box":null,"email":"arsincathedrali@gmail.com","website":"http:\/\/www.cathedralisbruxellensis.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parvis Sainte-Gudule","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Cath\u00e9drale Saints Michel et Gudule","address_street_name":"Parvis Sainte-Gudule","address_street_number":null,"address_street_box":null,"email":"arsincathedrali@gmail.com","website":"http:\/\/www.cathedralisbruxellensis.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parvis Sainte-Gudule","address_line2":"1000 Bruxelles","description_web":"Une v\u00e9ritable juxtaposition des styles du gothique braban\u00e7on nous plonge au 13e si\u00e8cle dans l'atmosph\u00e8re des grands b\u00e2tisseurs. Tr\u00e8s fran\u00e7aise gr\u00e2ce \u00e0 ses deux tours, elle fut commenc\u00e9e en 1226, tandis que la fa\u00e7ade date du 15e si\u00e8cle. Les prodigieux vitraux du transept et de la chapelle du Saint-Sacrement furent ex\u00e9cut\u00e9s d'apr\u00e8s les cartons de Bernard Van Orley et offerts par Charles Quint et sa famille. Dans le ch\u0153ur reposent Jean II, duc de Brabant, son \u00e9pouse Marguerite d'York et l'archiduc Ernest. Les archiducs Albert et Isabelle et Charles de Lorraine reposent dans la Chapelle du Saint-Sacrement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Catedral de San Miguel y Santa G\u00fadula en Bruselas","address_street_name":"Parvis Sainte Gudule","address_street_number":null,"address_street_box":null,"email":"arsincathedrali@gmail.com","website":"http:\/\/www.cathedralisbruxellensis.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parvis Sainte Gudule","address_line2":"1000 Bruxelles","description_web":"Construida en la cima de una colina, esta catedral refleja las tres fases del estilo g\u00f3tico.\u00a0...\r\n\"Construida en la cima de una colina, esta catedral refleja las tres fases del estilo g\u00f3tico.\u00a0\r\n\r\nEn su interior destacan los vestigios de la antigua colegiata rom\u00e1nica, las vidrieras del s. XVI, las estatuas de los ap\u00f3stoles de la nave, el p\u00falpito de estilo barroco y su mayor tesoro, el \u00f3rgano.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Sint-Michiel- en Sint-Goedelekathedraal","address_street_name":"Sinter-Goedelevoorplein","address_street_number":null,"address_street_box":null,"email":"arsincathedrali@gmail.com","website":"http:\/\/www.cathedralisbruxellensis.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sinter-Goedelevoorplein","address_line2":"1000 Brussel","description_web":"Een combinatie van de diverse stijlen van de Brabantse gotiek voert ons terug naar de 13de eeuw, de tijd van de grote kathedralenbouwers. De werken aan het gebouw, dat door zijn twee torens erg Frans aandoet, gingen van start in 1226, maar de gevel dateert uit de 15de eeuw. De prachtige glas-in-loodramen van de kruisbeuk en van de kapel van het Heilig Sacrament zijn een ontwerp van Bernard Van Orley en werden aan de kerk geschonken door Keizer Karel en zijn familie. In het koor rusten Jan II, hertog van Brabant, zijn vrouw Margaretha van York en aartshertog Ernest van Oostenrijk. De aartshertogen Albrecht en Isabella en Karel van Lotharingen liggen in de kapel van het Heilig Sacrament.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":114,"location":{"lat":50.84784907,"lon":4.35890193},"region":"brussels","last_updated_at":"2022-11-16T09:53:11+01:00","published_at":"2013-10-19T01:13:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":278049,"translations":{"de":{"name":"Eglise et tourisme Bruxelles","address_street_name":"Rue du Bois Sauvage","address_street_number":"15","address_street_box":null,"email":"etkt@skynet.be","website":"http:\/\/www.kerkentoerismebrussel.be\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Bois Sauvage, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Eglise et tourisme Bruxelles","address_street_name":"Rue du Bois Sauvage","address_street_number":"15","address_street_box":null,"email":"etkt@skynet.be","website":"http:\/\/www.kerkentoerismebrussel.be\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Bois Sauvage, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Eglise et tourisme Bruxelles","address_street_name":"Rue du Bois Sauvage","address_street_number":"15","address_street_box":null,"email":"etkt@skynet.be","website":"http:\/\/www.kerkentoerismebrussel.be\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Bois Sauvage, 15","address_line2":"1000 Brussels","description_web":"Throughout the year, the association offers guided tours of the churches of Brussels, tours of the city and a visit to the towers of the Cathedral of Saints Michael and Gudula. All these tours are free of charge, except for the tour of the towers.  The guided tour of the cathedral towers is only available with a specialised guide. These 69-metre high towers, which are almost 500 years old, will amaze you in many ways. It is advisable to book these guided tours in advance, especially the cathedral towers. Church and Tourism also offers a new system of pay-per-view tours via smartphone. These tours are conducted using a QR code.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Eglise et tourisme Bruxelles","address_street_name":"Rue du Bois Sauvage","address_street_number":"15","address_street_box":null,"email":"etkt@skynet.be","website":"http:\/\/www.kerkentoerismebrussel.be\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Bois Sauvage, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Eglise et tourisme Bruxelles","address_street_name":"Rue du Bois Sauvage","address_street_number":"15","address_street_box":null,"email":"etkt@skynet.be","website":"http:\/\/www.kerkentoerismebrussel.be\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Bois Sauvage, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Eglise et tourisme Bruxelles","address_street_name":"Rue du Bois Sauvage","address_street_number":"15","address_street_box":null,"email":"etkt@skynet.be","website":"http:\/\/www.kerkentoerismebrussel.be\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Bois Sauvage, 15","address_line2":"1000 Bruxelles","description_web":"L'association propose, tout au long de l\u2019ann\u00e9e, des visites guid\u00e9es dans les \u00e9glises de Bruxelles, des parcours dans la ville et une visite des tours de la cath\u00e9drale de Saints Michel-et-Gudule. Toutes ces visites sont enti\u00e8rement gratuites, \u00e0 l'exception de celle des tours.  La visite guid\u00e9e des tours de la cath\u00e9drale se font uniquement accompagn\u00e9e par un guide sp\u00e9cialis\u00e9. Ces tours de 69 m\u00e8tres de hauteur et qui datent de pr\u00e8s de 500 ans, vous \u00e9tonneront \u00e0 plus d\u2019un titre. Il est conseill\u00e9 de r\u00e9server \u00e0 l\u2019avance ces visites guid\u00e9es et plus particuli\u00e8rement celles des tours de la cath\u00e9drale. Eglise et tourisme propose \u00e9galement un nouveau syst\u00e8me de visites payantes \u00e0 la carte via smartphone. Ces visites se font \u00e0 l\u2019aide d\u2019un QR code.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Eglise et tourisme Bruxelles","address_street_name":"Rue du Bois Sauvage","address_street_number":"15","address_street_box":null,"email":"etkt@skynet.be","website":"http:\/\/www.kerkentoerismebrussel.be\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Bois Sauvage, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Kerk en Toerisme Brussel","address_street_name":"Wildewoudstraat","address_street_number":"15","address_street_box":null,"email":"etkt@skynet.be","website":"http:\/\/www.kerkentoerismebrussel.be\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Wildewoudstraat, 15","address_line2":"1000 Brussel","description_web":"Het hele jaar door biedt de vereniging rondleidingen in de kerken van Brussel, rondleidingen door de stad en een bezoek aan de torens van de kathedraal van de Heiligen Micha\u00ebl en Gudula. Al deze rondleidingen zijn gratis, behalve de rondleiding door de torens.  De rondleiding door de torens van de kathedraal is alleen mogelijk met een gespecialiseerde gids. Deze 69 meter hoge torens, die bijna 500 jaar oud zijn, zullen u in vele opzichten verbazen. Het is raadzaam deze rondleidingen vooraf te reserveren, vooral de torens van de kathedraal. Kerk en Toerisme biedt ook een nieuw systeem van pay-per-view rondleidingen via smartphone. Deze rondleidingen worden gegeven met behulp van een QR-code.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":38049,"location":{"lat":50.8480818,"lon":4.36136824},"last_updated_at":"2022-11-16T10:00:27+01:00","published_at":"2022-03-24T10:44:36+01:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/944ecfa0c246cdf7fde45c5d5fd294912f80d737.jpg","width":1920,"height":2560,"ratio":0.75,"oEmbed_height":2560,"oEmbed_width":1920,"translations":{"de":{"title":"La Renaissance \u00e0 la cath\u00e9drale des Saints-Michel-et-Gudule","copyright":"Cath\u00e9drale"},"pt":{"title":"La Renaissance \u00e0 la cath\u00e9drale des Saints-Michel-et-Gudule","copyright":"Cath\u00e9drale"},"en":{"title":"La Renaissance \u00e0 la cath\u00e9drale des Saints-Michel-et-Gudule","copyright":"Cath\u00e9drale"},"it":{"title":"La Renaissance \u00e0 la cath\u00e9dral