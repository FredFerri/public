1008825631569273,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[51],"translations":{"de":["Kabarett"],"pt":[null],"en":["Cabaret"],"it":["Cabaret"],"cn":[null],"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"sp":["Caf\u00e9 teatro"],"nl":["Cabaret"]}}},"translations":{"de":{"name":"La Pi\u00e8ce 100% improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lacompagniequipetille.com\/pieceimprovisee","email":"info@lacompagniequipetille.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001911"},"pt":{"name":"La Pi\u00e8ce 100% improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lacompagniequipetille.com\/pieceimprovisee","email":"info@lacompagniequipetille.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001911"},"en":{"name":"La Pi\u00e8ce 100% improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lacompagniequipetille.com\/pieceimprovisee","email":"info@lacompagniequipetille.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001911"},"it":{"name":"La Pi\u00e8ce 100% improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lacompagniequipetille.com\/pieceimprovisee","email":"info@lacompagniequipetille.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001911"},"cn":{"name":"La Pi\u00e8ce 100% improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lacompagniequipetille.com\/pieceimprovisee","email":"info@lacompagniequipetille.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001911"},"fr":{"name":"La Pi\u00e8ce de th\u00e9\u00e2tre 100% improvis\u00e9e - IMPRO","shortdescr":"Une pi\u00e8ce de th\u00e9\u00e2tre cr\u00e9\u00e9e devant toi, gr\u00e2ce \u00e0 tes suggestions, pendant une heure, c'est la soir\u00e9e exceptionnelle que nous te proposons !\u200b\n\nTout est possible, de l'amour, du drame, de la com\u00e9die, du policier... Tout ce qu'on vous promet c'est une histoire et des personnages que vous nous aiderez \u00e0 inventer, pour assister ensuite \u00e0 une pi\u00e8ce unique, \u00e9mouvante et dr\u00f4le.\n","longdescr":"Un moment inoubliable et unique o\u00f9 vous inspirez l'histoire en direct !\n\u2728 Une pi\u00e8ce de th\u00e9\u00e2tre cr\u00e9\u00e9e devant vous, gr\u00e2ce \u00e0 vos suggestions, pendant une heure : c'est la soir\u00e9e exceptionnelle que nous vous proposons !\nTout est possible, de l'amour, du drame, de la com\u00e9die, du policier...\nProposez-nous un lieu de d\u00e9part, un objet, et un petit plaisir de votre quotidien, et c'est parti pour une histoire unique, qui sera improvis\u00e9e en direct ce soir-l\u00e0, \u00e0 partir de ces 3 \u00e9l\u00e9ments que vous avez propos\u00e9s.\nCe seront 60 minutes, sans filet, d'une seule histoire cr\u00e9\u00e9e avec plaisir, humour et \u00e9motion par nos 4 improvisatrices\u00b7eurs.\nVenez donc vivre cette belle aventure \u00e9ph\u00e9m\u00e8re avec nous, chaque soir\u00e9e est unique !\n*La Pi\u00e8ce de th\u00e9\u00e2tre 100% improvis\u00e9e, un spectacle de La compagnie qui p\u00e9tille*\n\n- \u00e0 partir de 12 ans - ","performers":"Distribution, en alternance :\nAm\u00e9lie Verreydt, Cath Groslambert, Dan Gelbard, Gilles Delvaulx, Laurie Andrieu, Peggy Pexy Green, Perrine Pautr\u00e9, Valeria Roveda","boxoffi