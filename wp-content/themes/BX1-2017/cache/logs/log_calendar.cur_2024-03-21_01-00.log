alse,"is_soldout":false,"last_updated_at":"2024-03-20T01:00:52+01:00","published_at":"2024-01-09T09:38:11+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292192,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.5035212427755188,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[120],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Les BienVeilleuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/programmation-les-bienveilleuses","email":"CONTACT@THEATRELEPUBLIC.BE","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005904"},"pt":{"name":"Les BienVeilleuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/programmation-les-bienveilleuses","email":"CONTACT@THEATRELEPUBLIC.BE","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005904"},"en":{"name":"Les BienVeilleuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/programmation-les-bienveilleuses","email":"CONTACT@THEATRELEPUBLIC.BE","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005904"},"it":{"name":"Les BienVeilleuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/programmation-les-bienveilleuses","email":"CONTACT@THEATRELEPUBLIC.BE","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005904"},"cn":{"name":"Les BienVeilleuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/programmation-les-bienveilleuses","email":"CONTACT@THEATRELEPUBLIC.BE","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005904"},"fr":{"name":"Les BienVeilleuses","shortdescr":"Du 06 f\u00e9vrier et 23 mars 2024, le Th\u00e9\u00e2tre Le Public se r\u00e9invente pour aider \u00e0 faire la lumi\u00e8re sur un ph\u00e9nom\u00e8ne qui touche de nombreuses familles : les violences conjugales et intrafamiliales.\n\nTh\u00e9\u00e2tre \u00b7 Danse \u00b7 Slam \u00b7 Concerts \u00b7 Conf\u00e9rences \u00b7 D\u00e9bats \u00b7 Exposition \u00b7 Lectures \u00b7 Ateliers","longdescr":"Quels sont les m\u00e9canismes de l\u2019emprise ?\nPourquoi ces violences restent-elles dissimul\u00e9es ? Que r\u00e9v\u00e8lent-elles de notre soci\u00e9t\u00e9 ?\nQuelles sont les r\u00e9percussions sur l\u2019entourage et sur les enfants, victimes silencieuses ?\nComment en parler, comment prot\u00e9ger, comment r\u00e9parer ?\nPour r\u00e9pondre \u00e0 ces questions et \u00e0 tant d\u2019autres, autour d\u2019un cycle de 4 spectacles de th\u00e9\u00e2tre, nous avons fait appel aux BienVeilleuses.\n \nLes BienVeilleuses, ce sont les artistes, th\u00e9rapeutes, m\u00e9decins, anthropologues, commissaires, politiques, juristes\u2026 celles et ceux qui nous guideront vers une meilleure compr\u00e9hension de ces violences \u00e0 huis clos au travers de conf\u00e9rences, lectures comment\u00e9es, capsules audio, ateliers d\u2019\u00e9criture, concerts, exposition, tables de conversation\u2026\n \nTrop souvent taboues, ces violences qui traversent toutes les strates de la soci\u00e9t\u00e9 sont un v\u00e9ritable probl\u00e8me de sant\u00e9 publique. Pendant 7 semaines, dans une atmosph\u00e8re accueillante et bienveillante, nous accueillerons des femmes et hommes de terrain afin de mieux appr\u00e9hender les m\u00e9canismes de l\u2019emprise, les maltraitances minimis\u00e9es ou ignor\u00e9es, l\u2019importance des centres de prise en charge, la place des institutions. Et ainsi permettre aux publics de prendre la mesure du ph\u00e9nom\u00e8ne, d\u2019interroger et d\u2019\u00e9changer.\n \nL\u2019art r\u00e9pare. Ainsi, par l\u2019entremise de la sc\u00e8ne, et au travers de diff\u00e9rentes formes propos\u00e9es, mettre des mots sur les souffrances et les fa\u00e7ons d\u2019y r\u00e9pondre.\n \nPar le biais d\u2019histoires singuli\u00e8res, au travers d\u2019\u00e9critures g\u00e9n\u00e9reuses, raconter pour sensibiliser. Et comprendre comment rompre le cycle de la violence pour pouvoir ensuite emprunter les chemins de la reconstruction. Un pas apr\u00e8s l\u2019autre. \n \nVisitez notre site et composez vous-m\u00eame vos soir\u00e9es. Du mardi au samedi, d\u00e8s 18h30, vous pourrez participer \u00e0 des ateliers, assister \u00e0 des spectacles, des rencontres. La librairie sera partenaire, avec une s\u00e9lection d\u2019ouvrages et des s\u00e9ances de d\u00e9dicaces.\n \nNe laissons plus le silence taire la violence. Parlons-en !\n \nEN PARTENARIAT AVEC :\nAmnesty International, le Centre d\u2019Action La\u00efque, le CPVCF et les asbl PRAXIS, LA VOIX DES FEMMES, PREFER, SOF\u00c9LIA\u2026\n\nPROGRAMMATION :\nTh\u00e9\u00e2tre \u00b7 Danse \u00b7 Slam \u00b7 Concerts \u00b7 Conf\u00e9rences \u00b7 D\u00e9bats \u00b7 Exposition \u00b7 Lectures \u00b7 Ateliers\n\nLe programme et l\u2019agenda des intervenants est en cours d\u2019\u00e9laboration, nous le compl\u00e8terons au fur et \u00e0 mesure des disponibilit\u00e9s des interlocuteurs et interlocutrices. \nN\u2019h\u00e9sitez pas \u00e0 consulter notre site. \nNous vous pr\u00e9parons des soir\u00e9es de d\u00e9couvertes, hors normes, dans un th\u00e9\u00e2tre am\u00e9nag\u00e9 pour l\u2019occasion. \u200b\u200b\u200b\u200b\n\nTARIFS :\n\nTarifs au ticket pour la programmation Th\u00e9\u00e2tre :\n29\u20ac \/ 26\u20ac \/ 19\u20ac \/ 10\u20ac \/ 9\u20ac \/ 1,25\u20ac \n+ Tarif \u00e0 tout prix* entre 5 et 50 euros\n\nTarifs au ticket pour la programmation hors Th\u00e9\u00e2tre :\n10\u20ac \/ 5\u20ac \/ 1,25\u20ac\n+ Tarif \u00e0 tout prix* entre 5 et 50 euros\n\nNos Pass\nPass Les BienVeilleuses Abonn\u00e9** : gratuit\nPass Les BienVeilleuses -24 ans : 10 euros\nPass Les BienVeilleuses : 30 euros\nLes Pass donnent acc\u00e8s \u00e0 tous les \u00e9v\u00e9nements du focus et sont valables pour 1 personne.\n\nGratuit : Exposition, Bords de sc\u00e8ne, Restitution d\u2019atelier\n______________\n\n* Chaque personne \u00e0 la possibilit\u00e9 de participer \u00e0 hauteur de ses moyens, de son envie d\u2019engagement, lors de l\u2019achat d\u2019un billet de spectacle. Vous \u00eates libre de choisir votre tarif sans aucun justificatif.\n\n** Chaque abonn\u00e9 de la saison 2023-2024 b\u00e9n\u00e9ficie d\u2019un Pass gratuit, sur demande au 02 724 24 44.","performers":"\nJOURNAL D\u2019ASSISES DE JANINE BONAGGIUNTA\nBLESSURES DE FEMMES PAR CATHERINE CABROL\nR\u00c9ELS DE MARIE DARAH\nLA FEMME DU VENT D\u2019APR\u00c8S ANNE SYLVESTRE\nANNIE ERNAUX \/ ARR\u00caT SUR IMAGES DE MAGALI PINGLAUT ET PASCALE OUDOT\nLES YEUX NOIRS DE C\u00c9LINE DELBECQ\nPRIMA FACIE DE SUZIE MILLER\n.....","boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/programmation-les-bienveilleuses","email":"CONTACT@THEATRELEPUBLIC.BE","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005904"},"sp":{"name":"Les BienVeilleuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/programmation-les-bienveilleuses","email":"CONTACT@THEATRELEPUBLI