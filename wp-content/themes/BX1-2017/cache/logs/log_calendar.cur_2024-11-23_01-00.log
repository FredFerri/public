2024-11-06T10:41:02+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311072,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"party","ranking":0.7937005259840998,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":57,"translations":{"de":"Clubbing","pt":null,"en":"Clubbing","it":"Locali notturni","cn":null,"fr":"Clubbing","sp":"Ir de discoteca","nl":"Clubbing"}},"others":{}},"translations":{"de":{"name":"Catclub 22Y Birthday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/2308103252892164\/?ref=newsfeed","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003368"},"pt":{"name":"Catclub 22Y Birthday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/2308103252892164\/?ref=newsfeed","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003368"},"en":{"name":"Catclub 22Y Birthday","shortdescr":null,"longdescr":"It is Catclub time !\nCome and celebrate our 22nd Birthday and discover Bodies in Space at night.\n\nFresh line up :\nJezebel - Pole Dance Performance\nDaisy Ray - live\nOfra - dj\nElena Colombi - dj\n\nAt 10pm we will open the doors of the Showroom, where Daisy Ray and Jezebel will perform. Around 1, we go to the Club, where the sound is just a bit more intense, the lights a bit more shimmery and the energy a bit more explosive.\n\nEarly tickets via Yurplan\nhttps:\/\/ypl.me\/z8r\/t\nOr at the door, 20\u20ac\n\nFor those who joined us back in the days of Catclub, you know it was more than just a party\u2014it was a place where everyone could be themselves, where differences were celebrated, and where community came first.\nOver the years, as our gatherings took shape in hidden spots and abandoned buildings, we created a space free from many of the issues we see too often today.\nWe believe this was possible because our events stayed underground, and the \u201ccats\u201d who joined us were caring, genuine, and respectful.\nSince then, our mission has evolved into creating spaces like Bodies in Space and Mercerie, where emerging artists and performers can gather, create, and share freely. Our core values remain the same: fostering a community where respect, support, and acceptance are a given. At Bodies in Space, we hope to keep this spirit alive\u2014a place where everyone feels good, connected, and valued.\nOn this November 23 we\u2019re all inviting you to celebrate together the 22nd Birthday of Catclub and the opening of a new dancefloor where the dance of the individual blends with the collective, where everyone finds a place to move, be seen, and dream.\"\n","performers":"Jezebel - Pole Dance Performance\nDaisy Ray - live\nOfra - dj\nElena Colombi - dj","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/2308103252892164\/?ref=newsfeed","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003368"},"it":{"name":"Catclub 22Y Birthday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/2308103252892164\/?ref=newsfeed","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003368"},"cn":{"name":"Catclub 22Y Birthday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/2308103252892164\/?ref=newsfeed","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003368"},"fr":{