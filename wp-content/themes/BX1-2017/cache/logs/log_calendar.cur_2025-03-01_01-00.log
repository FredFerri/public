ntact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006733"},"pt":{"name":"Art Exhibition \u00ab Cheminements \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-cheminements","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006733"},"en":{"name":"Cheminements","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-cheminements","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006733"},"it":{"name":"Art Exhibition \u00ab Cheminements \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-cheminements","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006733"},"cn":{"name":"Art Exhibition \u00ab Cheminements \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-cheminements","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006733"},"fr":{"name":"Cheminements","shortdescr":"Cette expo trace des parcours abstraits o\u00f9 lignes et formes s\u2019entrem\u00ealent, o\u00f9 l\u2019organique et l\u2019\u00e9ph\u00e9m\u00e8re ont laiss\u00e9 comme des cartographies d\u2019un passage. Les deux artistes proposent plusieurs visions : C\u00e9dric De Lievre \u00e0 travers ses peintures acryliques et Posca, et Ir\u00e8ne de Groot avec ses monotypes, ses gravures et ses photographies. Dans cet espace propos\u00e9, leurs deux mondes cohabitent.","longdescr":"\u00ab Cheminements \u00bb trace des parcours abstraits o\u00f9 lignes et formes s\u2019entrem\u00ealent, o\u00f9 l\u2019organique \u2014 empreintes d\u2019animaux ou imaginaires \u2014 et l\u2019\u00e9ph\u00e9m\u00e8re ont laiss\u00e9 comme des cartographies d\u2019un passage. Les deux artistes proposent plusieurs visions : C\u00e9dric De Lievre \u00e0 travers ses peintures acryliques et Posca, et Ir\u00e8ne de Groot avec ses monotypes, ses gravures et ses photographies. Dans cet espace propos\u00e9, leurs deux mondes cohabitent.\n \n\n\u2139 INFOS PRATIQUES\n\nDates de l'exposition\nDu samedi 15 f\u00e9vrier au dimanche 2 mars 2025\n\nHoraires de l\u2019exposition\nMardi et vendredi (10h - 16h)\nSamedi et dimanche (11h - 18h)\n\nVernissage\nLe samedi 15 f\u00e9vrier de 17 \u00e0 21h\n\nPlus d'infos : https:\/\/montdepiete.be\/blogs\/news\/expo-cheminements","performers":"C\u00e9dric De Lievre (peinture) et Ir\u00e8ne de Groot (Artiste plasticienne pluridisciplinaire)","boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-cheminements","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006733"},"sp":{"name":"Art Exhibition \u00ab Cheminements \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-cheminements","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006733"},"nl":{"name":"Cheminements","shortdescr":"DE XPO schetst abstracte paden waar lijnen en vormen met elkaar vervlochten zijn, waar het organische en het vergankelijke als cartografie\u00ebn van een doorgang achterblijven. De twee kunstenaars bieden meerdere visies: C\u00e9dric De Lievre via zijn acryl- en Posca-schilderijen, en Ir\u00e8ne de Groot met haar monotypes, gravures en foto\u2019s. Deze expo laat hun werelden samenkomen.","longdescr":"\u00ab Cheminements \u00bb schetst abstracte paden waar lijnen en vormen met elkaar vervlochten zijn, waar het organische \u2014 dierlijke of imaginaire afdrukken \u2014 en het vergankelijke als cartografie\u00ebn van een doorgang achterblijven. De twee kunstenaars bieden meerdere visies: C\u00e9dric De Lievre via zijn acryl- en Posca-schilderijen, en Ir\u00e8ne de Groot met haar monotypes, gravures en foto\u2019s. Deze expo laat hun werelden samenkomen.\n \n\n\u2139 PRAKTISCHE INFORMATIE\n\nData van de tentoonstelling\nVan zaterdag 15 februari tot zondag 2 maart 2025\n\nOpeningsuren van de tentoonstelling\nDinsdag en vrijdag (10u - 16u)\nZaterdag en zondag (11u - 18u)\n\nVernissage\nZaterdag 15 februari van 17u tot 21u\n\nMeer info: https:\/\/montdepiete.be\/nl\/blogs\/news\/expo-cheminements","performers":" C\u00e9dric De Lievre (acrylverf) en Ir\u00e8ne de Groot (multidisciplinaire beeldend kunstenares)","boxoffice_url":null,"website":"https:\/\/montdepiete.be\/nl\/blogs\/news\/expo-cheminements","email":"info@bergvanbarmhartigheid.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006733"}},"place":{"id":221323,"translations":{"de":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Saint-Ghislain, 1923","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","add