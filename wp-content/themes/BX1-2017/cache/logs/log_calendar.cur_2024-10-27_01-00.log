ntren"],"pt":[null,null],"en":["Architecture ","Museums and art centers"],"it":["Architettura","Musei e centri artistici"],"cn":[null,null],"fr":["Architecture","Mus\u00e9es et art centers"],"sp":["Arquitectura","Museos y centros de arte"],"nl":["Architectuur","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Visit of the Van Eetvelde Hotel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@lab-an.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545804"},"pt":{"name":"Visit of the Van Eetvelde Hotel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@lab-an.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545804"},"en":{"name":"Visit of the Van Eetvelde Hotel","shortdescr":"Opening to the public of the Hotel van Eetvelde and his extension, a jewel of Brussels' Art Nouveau, classified as a Unesco World Heritage Site, with an offer of guided and free visits. Access is made possible through the LAB-An or Art Nouveau Laboratory, a space for the promotion of Art Nouveau that offers a contemporary look at this Belgian and Brussels heritage and the themes it encompasses. In addition, there is a reflection on the conservation of our Art Nouveau heritage through the rebirth of the Aubecq Hotel and an introduction to the links between Art Nouveau and Belgian colonization.","longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?module=ACTIVITYSERIEDETAILS&pos=LABAN&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=EN","website":null,"email":"info@lab-an.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545804"},"it":{"name":"Visit of the Van Eetvelde Hotel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@lab-an.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545804"},"cn":{"name":"Visit of the Van Eetvelde Hotel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@lab-an.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545804"},"fr":{"name":"Visite de l'H\u00f4tel Van Eetvelde","shortdescr":"Ouverture au public de l\u2019H\u00f4tel van Eetvelde et de son extension, joyau de l\u2019Art Nouveau bruxellois, class\u00e9 au patrimoine mondial de l\u2019Unesco avec une offre de visites guid\u00e9es et libres\r\nL\u2019acc\u00e8s se fait \u00e0 travers le LAB\u00b7An ou laboratoire Art nouveau, un espace de promotion de l'Art nouveau qui propose un regard contemporain autour de cet h\u00e9ritage belge et bruxellois et les th\u00e9matiques qu'il englobe. A ceci, s\u2019ajoute une r\u00e9flexion autour de la conservation de notre patrimoine Art nouveau \u00e0 travers la renaissance de l\u2019h\u00f4tel Aubecq ainsi qu\u2019une introduction sur les liens entre l\u2019Art nouveau et la colonisation belge. ","longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?module=ACTIVITYSERIEDETAILS&pos=LABAN&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=FR","website":null,"email":"info@lab-an.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545804"},"sp":{"name":"Visit of the Van Eetvelde Hotel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@lab-an.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545804"},"nl":{"name":"Bezoek van het Van Eetvelde Hotel","shortdescr":"Opening voor het publiek van het Hotel van Eetvelde en zijn extensie. Een juweel van de Brusselse Art Nouveau, geklasseerd als Unesco-werelderfgoed, met een aanbod van geleide en gratis bezoeken. De toegang is via het LAB-An of Art Nouveau Laboratorium, een plaats voor de promotie van Art Nouveau die een hedendaagse perspectief biedt op dit Belgische en Brusselse erfgoed en de thema's die het omvat. Daarnaast is er een reflectie over het behoud van ons Art Nouveau erfgoed door de wedergeboorte van het Aubecq Hotel en een inleiding over de banden tussen Art Nouveau en de Belgische kolonisatie.","longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?module=ACTIVITYSERIEDETAILS&pos=LABAN&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=NL","website":null,"email":"info@lab-an.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545804"}},"place":{"id":242040,"translations":{"de":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Av. Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Av. Palmerston, 2","address_line2":"1000 Bruxelles","description_web":"Das Maison van Eetvelde ist ein bemerkenswertes Jugendstilbauwerk aus der Feder von Victor Horta, das 1895-1898 im Auftrag des Diplomaten Edmond Van Eetvelde erbaut wurde. Das Geb\u00e4ude z\u00e4hlt zum UNESCO-Weltkulturerbe.\r\n\r\nDas Geb\u00e4ude wurde 1895 von Edmond Van Eetvelde, seinerzeit Diplomat und Generalsekret\u00e4r im Kongo, in Auftrag gegeben. Sehenswert sind die Eisentr\u00e4ger aus Flacheisen (wie im Industriebereich) statt aus Schmiedeeisen, die Mosaike, der glas\u00fcberdachte Innenhof und die Blumenmotive des Esszimmers.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Brussels","description_web":"According to Horta himself, the plans for this house, conceived in 1895, were the most audacious he ever drew. And he did so for a prominent figure, as the client, Baron Edmond van Eetvelde, was the Secretary General of the Independent State of Congo - in reality the unofficial 'Minister of the Congo' - and, therefore, a very close ally of King Leopold II. \r\n\r\nThe future owner asked the architect for a house 'for his family', but with as large a living room and dining room as possible, given his frequent social engagements. \r\n\r\nThe house is unusual in that it is flanked by two other buildings: a building to the left of it, which was intended to serve both as an extension to the original house and as a rental house and a building to the right of it, a small annex to the main house. ","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=EN","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Hotel van Eetvelde & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":"Selon les dires de Horta lui-m\u00eame, le plan de cette maison, con\u00e7u en 1895, est le plus audacieux qu\u2019il ait dessin\u00e9\u2026 Et c\u2019est encore au profit d\u2019une personnalit\u00e9 qu\u2019il le fait, puisque le commanditaire, le baron Edmond van Eetvelde, est le secr\u00e9taire g\u00e9n\u00e9ral de l\u2019\u00c9tat ind\u00e9pendant du Congo \u2014 dans les faits v\u00e9ritable \u00ab ministre du Congo \u00bb \u2014, et donc un tr\u00e8s proche collaborateur du roi L\u00e9opold II. \r\n\r\nLe futur propri\u00e9taire r\u00e9clame \u00e0 l\u2019architecte une maison \u00ab pour sa famille \u00bb, mais comportant, au vu de ses obligations mondaines, un salon et une salle \u00e0 manger aussi grands que possible. \r\n\r\nLa maison offre la particularit\u00e9 d\u2019\u00eatre flanqu\u00e9e de deux autres \u00e9difices, de part et d\u2019autre : un immeuble \u00e0 sa gauche, devant \u00e0 la fois servir d\u2019agrandissement \u00e0 la maison initiale et de maison de location ; un b\u00e2timent \u00e0 sa droite, petite annexe \u00e0 l\u2019habitation principale. ","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=FR","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Van Eetveldehotel & LAB\u00b7An","address_street_name":"Palmerstonlaan","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Palmerstonlaan, 2","address_line2":"1000 Brussel","description_web":"Volgens Victor Horta zelf was het plan voor dit huis in 1895 het meest gedurfde dat hij ooit had ontworpen. De opdrachtgever was ook niet de eerste de beste: baron Edmond van Eetvelde was de secretaris-generaal van de onafhankelijke staat Congo - de 'minister van Congo', zeg maar - en dus een zeer naaste medewerker van koning Leopold II. \r\n\r\nDe toekomstige eigenaar vroeg de architect om een huis \u2018voor zijn gezin,\u2019 maar met een zo groot mogelijke woonkamer en eetkamer met het oog op zijn sociale verplichtingen. \r\n\r\nBijzonder is dat het huis in feite een drie-eenheid is. Het wordt geflankeerd door twee andere gebouwen: een gebouw links van het huis, dat zowel als uitbreiding van het oorspronkelijke huis als als huurhuis moest dienen, en een gebouw rechts van het huis, een klein bijgebouw bij het hoofdhuis. ","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=NL","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":4486,"location":{"lat":50.84720217,"lon":4.38039568},"region":"brussels","last_updated_at":"2023-08-09T11:32:14+02:00","published_at":"2013-10-19T01:17:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":242040,"translations":{"de":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Av. Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Av. Palmerston, 2","address_line2":"1000 Bruxelles","description_web":"Das Maison van Eetvelde ist ein bemerkenswertes Jugendstilbauwerk aus der Feder von Victor Horta, das 1895-1898 im Auftrag des Diplomaten Edmond Van Eetvelde erbaut wurde. Das Geb\u00e4ude z\u00e4hlt zum UNESCO-Weltkulturerbe.\r\n\r\nDas Geb\u00e4ude wurde 1895 von Edmond Van Eetvelde, seinerzeit Diplomat und Generalsekret\u00e4r im Kongo, in Auftrag gegeben. Sehenswert sind die Eisentr\u00e4ger aus Flacheisen (wie im Industriebereich) statt aus Schmiedeeisen, die Mosaike, der glas\u00fcberdachte Innenhof und die Blumenmotive des Esszimmers.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Brussels","description_web":"According to Horta himself, the plans for this house, conceived in 1895, were the most audacious he ever drew. And he did so for a prominent figure, as the client, Baron Edmond van Eetvelde, was the Secretary General of the Independent State of Congo - in reality the unofficial 'Minister of the Congo' - and, therefore, a very close ally of King Leopold II. \r\n\r\nThe future owner asked the architect for a house 'for his family', but with as large a living room and dining room as possible, given his frequent social engagements. \r\n\r\nThe house is unusual in that it is flanked by two other buildings: a building to the left of it, which was intended to serve both as an extension to the original house and as a rental house and a building to the right of it, a small annex to the main house. ","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=EN","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Hotel van Eetvelde & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":"Selon les dires de Horta lui-m\u00eame, le plan de cette maison, con\u00e7u en 1895, est le plus audacieux qu\u2019il ait dessin\u00e9\u2026 Et c\u2019est encore au profit d\u2019une personnalit\u00e9 qu\u2019il le fait, puisque le commanditaire, le baron Edmond van Eetvelde, est le secr\u00e9taire g\u00e9n\u00e9ral de l\u2019\u00c9tat ind\u00e9pendant du Congo \u2014 dans les faits v\u00e9ritable \u00ab ministre du Congo \u00bb \u2014, et donc un tr\u00e8s proche collaborateur du roi L\u00e9opold II. \r\n\r\nLe futur propri\u00e9taire r\u00e9clame \u00e0 l\u2019architecte une maison \u00ab pour sa famille \u00bb, mais comportant, au vu de ses obligations mondaines, un salon et une salle \u00e0 manger aussi grands que possible. \r\n\r\nLa maison offre la particularit\u00e9 d\u2019\u00eatre flanqu\u00e9e de deux autres \u00e9difices, de part et d\u2019autre : un immeuble \u00e0 sa gauche, devant \u00e0 la fois servir d\u2019agrandissement \u00e0 la maison initiale et de maison de location ; un b\u00e2timent \u00e0 sa droite, petite annexe \u00e0 l\u2019habitation principale. ","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=FR","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Van Eetveldehotel & LAB\u00b7An","address_street_name":"Palmerstonlaan","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Palmerstonlaan, 2","address_line2":"1000 Brussel","description_web":"Volgens Victor Horta zelf was het plan voor dit huis in 1895 het meest gedurfde dat hij ooit had ontworpen. De opdrachtgever was ook niet de eerste de beste: baron Edmond van Eetvelde was de secretaris-generaal van de onafhankelijke staat Congo - de 'minister van Congo', zeg maar - en dus een zeer naaste medewerker van koning Leopold II. \r\n\r\nDe toekomstige eigenaar vroeg de architect om een huis \u2018voor zijn gezin,\u2019 maar met een zo groot mogelijke woonkamer en eetkamer met het oog op zijn sociale verplichtingen. \r\n\r\nBijzonder is dat het huis in feite een drie-eenheid is. Het wordt geflankeerd door twee andere gebouwen: een gebouw links van het huis, dat zowel als uitbreiding van het oorspronkelijke huis als als huurhuis moest dienen, en een gebouw rechts van het huis, een klein bijgebouw bij het hoofdhuis. ","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=NL","sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":4486,"location":{"lat":50.84720217,"lon":4.38039568},"last_updated_at":"2023-08-09T11:32:14+02:00","published_at":"2013-10-19T01:17:26+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/5a57aec10038e7d006f80575af38f8adfec8a2ab.jpg","width":3349,"height":2233,"ratio":1.5,"oEmbed_height":2233,"oEmbed_width":3349,"translations":{"de":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"pt":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"en":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"it":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"cn":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"fr":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"sp":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null},"nl":{"title":"Visite de l'H\u00f4tel Van Eetvelde","copyright":null}}}],"dates":[{"day":"2024-01-01","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-06","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-