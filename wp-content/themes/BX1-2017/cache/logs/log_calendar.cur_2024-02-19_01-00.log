mber":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Mommaertsstraat, 4","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Het Huis van Culturen en Sociale Samenhang is een initiatief van openbare dienstverlening van de gemeente Sint-Jans-Molenbeek, gelegen in het hart van het historische Molenbeek, aan de symbolische grens van de andere kant van het kanaal. Het Huis van Culturen is een artistieke ruimte die nauwe banden aanhaalt met de bewoners door onder meer workshops te organiseren voor volwassenen en kinderen, en activiteiten in Court'Echelle, de ruimte gewijd aan de allerkleinsten. In een wijk rijk aan diverse bevolkingsgroepen, wil het Huis een plek zijn voor ontmoetingen, uitwisselingen en dialoog, en met de programmatie inspelen op de dagelijkse behoeften en realiteit van de inwoners van Molenbeek.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":5940,"location":{"lat":50.85787224,"lon":4.33818532},"last_updated_at":"2023-09-21T15:13:36+02:00","published_at":"2013-10-19T01:19:34+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/9ebda69b05ed91aa8a32fd4567fdd7f5d42924a8.jpg","width":1080,"height":1080,"ratio":1,"oEmbed_height":1080,"oEmbed_width":1080,"translations":{"de":{"title":"Abdel Nasser #2024 Rodage nouveau spectacle","copyright":"\u00a9 Zakaria El Bakkali"},"pt":{"title":"Abdel Nasser #2024 Rodage nouveau spectacle","copyright":"\u00a9 Zakaria El Bakkali"},"en":{"title":"Abdel Nasser #2024 Rodage nouveau spectacle","copyright":"\u00a9 Zakaria El Bakkali"},"it":{"title":"Abdel Nasser 