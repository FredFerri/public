d":"2022-06-19","date_next":"2022-06-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Le Luizenmolen","shortdescr":null,"longdescr":"VISITE A 16H00 \r\nVenez d\u00e9couvrir un des derniers moulins de la R\u00e9gion Bruxelloise . \r\nLe Luizenmolen, projet d\u2019un groupe de passionn\u00e9s, a vu le jour en 1999 ; il s\u2019agit de la r\u00e9plique \u00e0 l\u2019identique du moulin original qui fut construit entre 1862 et 1864. Venez rencontrer les meuniers de l\u2019asbl Luizenmolen Anderlecht qui assurent la visite du moulin. La visite nous permettra de d\u00e9couvrir le cheminement du grain, l\u2019int\u00e9rieur du moulin, class\u00e9 en 2007, sa structure et \r\nson utilisation.","performers":null,"boxoffice_url":null,"website":null,"email":"tourisme@anderlecht.brussels","phone_contact":"+32 2 526 83 30","phone_booking":"+32 2 526 83 30","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534725.html"},"nl":{"name":"De Luizenmolen","shortdescr":null,"longdescr":"RONDLEIDING OM 15U00\r\nKom en ontdek een van de laatste molens in het Brussels Gewest. \r\nDe Luizenmolen, een project van een groep liefhebbers, zag het licht in 1999. Het is een identieke replica van de oorspronkelijke molen die tussen 1862 en 1864 werd gebouwd. Kom en ontmoet de molenaars van vzw Luizenmolen Anderlecht die u een rondleiding in de molen zullen geven.\r\nHet bezoek biedt de mogelijkheid om de reis van het graan ontdekken, het binnenwerk van de molen, beschermd sinds 2007, de structuur en het gebruik ervan.","performers":null,"boxoffice_url":null,"website":null,"email":"toerisme@anderlecht.brussels","phone_contact":"+32 2 526 83 51","phone_booking":"+32 2 526 83 51","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534725.html"},"en":{"name":"Le Luizenmolen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534725.html"},"de":{"name":"Le Luizenmolen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/534725.html"},"it":{"name":"Le Luizenmolen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/534725.html"},"sp":{"name":"Le Luizenmolen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/534725.html"},"pt":{"name":"Le Luizenmolen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/534725.html"},"cn":{"name":"Le Luizenmolen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/534725.html"}},"place":{"id":267884,"translations":{"fr":{"name":"Luizenmolen-Anderlecht asbl\/vzw","address_street_name":"Rue des Papillons","address_street_number":"192","address_street_box":null,"email":"ediederich@gmail.com","website":"http:\/\/users.skynet\/Luizenmolen\/","phone_contact":"+32 2 520 43 59","phone_booking":null,"address_