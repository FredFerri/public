nt":false,"backoffice_id":262867,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"expo","ranking":0.17581694345847967,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[40,36],"translations":{"de":["Grafische K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Graphic art","Museums and art centers"],"it":["Arti grafiche","Musei e centri artistici"],"cn":[null,null],"fr":["Arts graphiques","Mus\u00e9es et art centers"],"sp":["Artes gr\u00e1ficas","Museos y centros de arte"],"nl":["Grafische kunst, vormgeving","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Privat Livemont. Fleurs \u00e0 l'affiche ! Bloemenpracht!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542867"},"pt":{"name":"Privat Livemont et le r\u00e8gne du v\u00e9g\u00e9tal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542867"},"en":{"name":"Privat Livemont. Fleurs \u00e0 l'affiche! Bloemenpracht!","shortdescr":"The Autrique House presents the work and life of Privat Livemont, an emblematic Art Nouveau artist from Brussels.","longdescr":"From March 2023 to January 2024, the Autrique House presents the work and life of Privat Livemont, an emblematic Art Nouveau artist from Brussels. Working as a versatile artist, a craftsman, and a teacher at the Industrial Academy in Schaerbeek, Livemont seems to have been a tireless worker. He is best known for his posters and the sgraffiti on many facades in Brussels.\r\nThe delicacy of his line, his taste for decorative plant elements and their stylisation, his fertile imagination and his colourful palette make Privat Livemont an important figure that Maison Autrique has chosen to honour in 2023, the year of Art Nouveau.\r\n\r\nDiscover the programme of our discussions and lectures on the work and era of Livemont on autrique.be.\r\n\r\nWith the complicity of Galerie Le Tout Venant, ARCHistory & Commune de Schaerbeek\/Gemeente Schaarbeek\r\nIn collaboration with Mus\u00e9e d\u2019Ixelles\/Museum van Elsene, Archives de la Ville de Bruxelles\/Archief van de Stad Brussel, KBR, H\u00f4tel Solvay, Cauchie House & Jonathan Mangelinckx\r\nWith the support of urban.brussels, Loterie Nationale\/Nationale Loterij, Brussels Capital Region, Vlaamse Gemeenschapscommissie, F\u00e9d\u00e9ration Wallonie-Bruxelles & A Step Forward","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542867"},"it":{"name":"Privat Livemont et le r\u00e8gne du v\u00e9g\u00e9tal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542867"},"cn":{"name":"Privat Livemont et le r\u00e8gne du v\u00e9g\u00e9tal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542867"},"fr":{"name":"Privat Livemont. Fleurs \u00e0 l'affiche !","shortdescr":"La Maison Autrique pr\u00e9sente l'\u0153uvre et la vie de Privat Livemont, artiste bruxellois embl\u00e9matique de l\u2019Art nouveau.","longdescr":"De mars 2023 \u00e0 janvier 2024, la Maison Autrique pr\u00e9sente l'\u0153uvre et la vie de Privat Livemont, artiste bruxellois embl\u00e9matique de l\u2019Art nouveau. Artiste complet et polyvalent, artisan, enseignant \u00e0 l\u2019Acad\u00e9mie de dessin et d\u2019industrie de Schaerbeek... Livemont semble avoir \u00e9t\u00e9 un travailleur infatigable. Il est surtout reconnu pour ses affiches et les sgraffites pr\u00e9sents sur de nombreuses fa\u00e7ades \u00e0 Bruxelles.\r\nLa finesse de son trait, son go\u00fbt pour les \u00e9l\u00e9ments d\u00e9coratifs v\u00e9g\u00e9taux et leur stylisation, son imagination fertile et sa palette color\u00e9e font de Privat Livemont une figure importante que la Maison Autrique choisit de mettre \u00e0 l\u2019honneur en 2023, ann\u00e9e de l'Art nouveau.\r\n\r\nRetrouvez le programme du cycle de conversations et conf\u00e9rences autour de l\u2019\u0153uvre et l\u2019\u00e9poque de Livemont sur autrique.be.\r\n\r\nAvec la complicit\u00e9 de la Galerie Le Tout Venant, ARCHistory et la Commune de Schaerbeek\r\nEn collaboration avec le Mus\u00e9e d\u2019Ixelles, les Archives de la Ville de Bruxelles, la KBR, l\u2019H\u00f4tel Solvay, la Maison Cauchie et Jonathan Mangelinckx\r\nAvec le soutien d'urban.brussels, la Loterie Nationale, la F\u00e9d\u00e9ration Wallonie-Bruxelles, la R\u00e9gion de Bruxelles-Capitale, la Vlaamse Gemeenschapscommissie et A Step Forward","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542867"},"sp":{"name":"Privat Livemont et le r\u00e8gne du v\u00e9g\u00e9tal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542867"},"nl":{"name":"Privat Livemont. Bloemenpracht!","shortdescr":"Het Autrique Huis presenteert het werk en leven van Privat Livemont, een emblematische Brusselse art-nouveaukunstenaar.","longdescr":"Van maart 2023 tot januari 2024 presenteert het Autrique Huis het werk en leven van Privat Livemont, een emblematische Brusselse art-nouveaukunstenaar. Veelzijdige artiest, ambachtslied, leerkracht aan de Nijverheidsschool\u2026 Livemont lijkt een onvermoeibare werker te zijn geweest. Hij is vooral bekend om zijn affiches en de sgraffiti op vele voorgevels in Brussel.\r\nDe finesse van zijn lijn, zijn smaak voor decoratieve plantenelementen en hun stilering, zijn vruchtbare verbeelding en zijn kleurrijke palet maken van Privat Livemont een belangrijke figuur die het Autrique Huis in 2023, het jaar van de art nouveau, in de kijker wil zetten.\r\n\r\nOntdek het programma van de gesprekken en lezingen rond het oeuvre en de tijd van Livemont op autrique.be.\r\n\r\nMet hulp van de Galerie Le Tout Venant, ARCHistory en de Gemeente Schaarbeek\r\nIn samenwerking met het Museum van Elsene, het Archief van de Stad Brussel, KBR, H\u00f4tel Solvay, Cauchiehuis en Jonathan Mangelinckx\r\nMet steun van urban.brussels, de Nationale Loterij, F\u00e9d\u00e9ration Wallonie-Bruxelles, Brussel Hoofdstedelijk Gewest, de Vlaamse Gemeenschapscommissie en A Step Forward","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542867"}},"place":{"id":241931,"translations":{"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Autrique House","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaerbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":4383,"location":{"lat":50.86325398,"lon":4.37313664},"region":"brussels","last_updated_at":"2023-08-09T11:32:28+02:00","published_at":"2013-10-19T01:17:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":241931,"translations":{"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip"