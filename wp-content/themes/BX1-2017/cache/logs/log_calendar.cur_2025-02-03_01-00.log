"de":["Puppentheater"],"pt":[null],"en":["Puppet show"],"it":["Teatro delle marionette"],"cn":[null],"fr":["Th\u00e9\u00e2tre de marionnettes"],"sp":["Teatro de marionetas"],"nl":["Poppentheater"]}}},"translations":{"de":{"name":"Pouvoir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/pouvoir\/2025-02-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001604"},"pt":{"name":"Pouvoir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/pouvoir\/2025-02-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001604"},"en":{"name":"Pouvoir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/pouvoir\/2025-02-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001604"},"it":{"name":"Pouvoir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/pouvoir\/2025-02-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001604"},"cn":{"name":"Pouvoir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/pouvoir\/2025-02-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001604"},"fr":{"name":"Pouvoir","shortdescr":"Avez-vous d\u00e9j\u00e0 pens\u00e9 \u00e0 la vie d\u2019une marionnette ? Ne jamais prendre la moindre d\u00e9cision. Ne jamais penser. Ne jamais choisir. Toute une vie d\u00e9l\u00e9gu\u00e9e \u00e0 d\u2019autres : des manipulateur\u00b7ices.","longdescr":"Est-ce fantastique ou est-ce terrible ? Et que peut faire une marionnette qui joue sans cesse le m\u00eame spectacle, un spectacle qu\u2019elle n\u2019aime pas ? Que peut-elle faire pour changer les choses ?\n\nElle d\u00e9cide donc de tenter le tout pour le tout : prendre le pouvoir et commander \u00e0 son tour aux marionnettistes. Elle ne veut plus vivre par procuration et veut d\u00e9cider elle-m\u00eame de ce qui lui arrive. Mais pour \u00e7a, il va falloir convaincre les marionnettistes, qui elleux, tiennent \u00e0 leur emploi. La marionnette fait des promesses, mais chez les artistes, personne n\u2019y croit vraiment.\n\nAlors on demande l\u2019avis du public : \u00ab Peut-on r\u00eaver d\u2019un autre syst\u00e8me ? \u00bb.\n\nPRIX DE LA MINISTRE DE LA JEUNESSE AUX RENCONTRES TH\u00c9\u00c2TRE JEUNE PUBLIC DE HUY 2023\n\nPRIX DU JURY \"JUNIOR\" AU FESTIVAL MOMIX 2024\nDans le cadre des Rencontres Danse Cirque Th\u00e9\u00e2tre","performers":"Conception, mise en sc\u00e8ne, jeu et manipulation de la marionnette : C\u00e9cile Maidon, No\u00e9mie Vincart, Michel Vill\u00e9e\nCr\u00e9ateur lumi\u00e8re : Caspar Langhoff\nCr\u00e9atrice sonore \u2013 composition : Alice Hebborn (avec les sons de percussions de Thomas Giry et de vielle \u00e0 roue de Daniel Schmitz)\nAide \u00e0 la mise en sc\u00e8ne et \u00e0 l\u2019\u00e9criture : Marion Lory\nRegard dramaturgique et marionnettique : Pierre Tual","boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/pouvoir\/2025-02-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001604"},"sp":{"name":"Pouvoir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/pouvoir\/2025-02-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001604"},"nl":{"name":"Pouvoir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/pouvoir\/2025-02-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001604"}},"place":{"id":4,"translations":{"de":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Waterloo, 94","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Waterloo, 94","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","addres