:null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-10-31","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-01","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-02","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-03","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-04","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-05","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-06","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-07","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-08","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-09","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-10","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-11","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-12","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-13","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-14","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-15","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-16","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-17","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-18","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-19","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-20","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-21","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-22","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-23","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-24","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-25","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-26","doors":null,"start":"08:00:00","end":"22:00:00"},{"day":"2022-11-27","doors":null,"start":"08:00:00","end":"22:00:00