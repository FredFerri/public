y: from 11:00 to 18:00"]},"date_start":"2022-03-23","date_end":"2022-08-21","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":4},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":2},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-03-23","start":"17:00:00","timestamp":"2022-03-23T17:00:00+01:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[252,255,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T01:35:21+02:00","published_at":"2022-02-22T16:45:33+01:00","backoffice_id":248152,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23660160305392},{"id":529253,"date_start":"2022-03-24","date_end":"2022-09-04","date_next":"2022-08-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Portrait of a Lady","shortdescr":"Portrait of a Lady illustre \u00e0 travers une s\u00e9rie d\u2019\u0153uvres d\u2019art la repr\u00e9sentation de la femme depuis la pr\u00e9histoire jusqu\u2019\u00e0 aujourd\u2019hui, ainsi que le parcours de quelques femmes d\u2019exception. L\u2019exposition fera dialoguer diff\u00e9rentes cultures et civilisations d\u2019orient et d\u2019occident, en r\u00e9unissant une s\u00e9lection de pi\u00e8ces anciennes et contemporaines.","longdescr":"Portrait of a Lady illustre \u00e0 travers une s\u00e9rie d\u2019\u0153uvres d\u2019art la repr\u00e9sentation de la femme depuis la pr\u00e9histoire jusqu\u2019\u00e0 aujourd\u2019hui, ainsi que le parcours de quelques femmes d\u2019exception. L\u2019exposition fera dialoguer diff\u00e9rentes cultures et civilisations d\u2019orient et d\u2019occident, en r\u00e9unissant une s\u00e9lection de pi\u00e8ces anciennes et contemporaines.\r\n\r\nLe projet pr\u00e9sente ainsi les portraits de femmes inconnues et c\u00e9l\u00e8bres, des origines \u00e0 aujourd\u2019hui. Parmi les figures historiques, les \u0153uvres convoquent notamment la Gr\u00e8ce ou encore l\u2019Afrique, \u00e0 l\u2019instar de l\u2019histoire de la reine de Saba ou celle de Didon, Reine de Carthage. Depuis la personnification de la fertilit\u00e9 jusqu\u2019\u00e0 la repr\u00e9sentation des courtisanes, en passant par celle des imp\u00e9ratrices, l\u2019exposition a pour ambition d\u2019\u00e9clairer les diff\u00e9rents regards port\u00e9s sur les femmes \u00e0 travers les \u00e9poques.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.529253"},"nl":{"name":"Portrait of a Lady","shortdescr":"Portrait of a Lady laat aan de hand van een reeks kunstwerken zien hoe de vrouw sinds de prehistorie tot nu werd uitgebeeld. Speciale aandacht is er ook voor de levensloop van enkele uitzonderlijke vrouwen. De tentoonstelling cre\u00ebert een dialoog tussen verschillende oosterse en westerse culturen en beschavingen, via een selectie oude en hedendaagse stukken.","longdescr":"Portrait of a Lady laat aan de hand van een reeks kunstwerken zien hoe de vrouw sinds de prehistorie tot nu werd uitgebeeld. Speciale aandacht is er ook voor de levensloop van enkele uitzonderlijke vrouwen. De tentoonstelling cre\u00ebert een dialoog tussen verschillende oosterse en westerse culturen en beschavingen, via een selectie oude en hedendaagse stukken.\r\n\r\nWe krijgen portretten van beroemde en onbekende vrouwen te zien, vanaf het begin van de kunstgeschiedenis tot nu. Wat historische figuren betreft, zijn er werken uit onder meer Griekenland en Afrika. Zo is er het verhaal van de koningin van Seba en van Dido, de koningin van Carthago. De tentoonstelling wil laten zien hoe de kijk op vrouwen evolueerde in de loop der eeuwen, vanaf de personificatie van de vruchtbaarheid tot de uitbeelding van keizerinnen en courtisanes.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.529253"},"en":{"name":"Portrait of a Lady","shortdescr":"Through a series of artworks, Portrait of a Lady illustrates the various forms of representation of women from prehistoric times to today, as well as the more specific journeys of a few exceptional women. Grouping a selection of ancient and contemporary pieces, the exhibition will establish a dialogue between different cultures and civilizations from the East and the West.","longdescr":"Through a series of artworks, Portrait of a Lady illustrates the various forms of representation of women from prehistoric times to today, as well as the more specific journeys of a few exceptional women. Grouping a selection of ancient and contemporary pieces, the exhibition will establish a dialogue between different cultures and civilizations from the East and the West.\r\n\r\nThis project aims to honour the portraits of both renowned and unknown women from long ago to today. In addition to historical figures, the artworks convey images of Greece and Africa, with insights into the stories of the Queen of Sheba and Dido, Queen of Carthage. From the personification of fertility to the representations of courtesans and empresses, the exhibition endeavours to shed light on the different views and interpretations of women through the ages.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.529253"},"de":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.529253"},"it":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.529253"},"sp":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.529253"},"pt":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.529253"},"cn":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.529253"}},"place":{"id":248760,"translations":{"fr":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":" A l'initiative de la Fondation Boghossian, la c\u00e9l\u00e8bre Villa Empain a \u00e9t\u00e9 enti\u00e8rement restaur\u00e9e et a ouvert ses portes au public depuis le 23 avril 2010. Lieu de rencontres et de d\u00e9couvertes, d'\u00e9motions partag\u00e9es et d'\u00e9merveillement, la Villa Empain est aussi un remarquable t\u00e9moin de l'architecture Art D\u00e9co. En 1930, le baron Louis Empain, alors \u00e2g\u00e9 de 21 ans, fit \u00e9riger cet h\u00f4tel particulier de 2500 m2 sur la prestigieuse avenue des Nations qui fut rebaptis\u00e9e plus tard avenue Franklin Roosevelt. C'est \u00e0 l'architecte suisse Michel Polak qu'il confia la construction de cette splendide maison. Le projet con\u00e7u pour le baron Empain sur un terrain de 55 ares comprenait une villa monumentale \u00e0 quatre fa\u00e7ades en granit poli, un jardin entourant une piscine agr\u00e9ment\u00e9e d'une pergola, et une conciergerie. La diversit\u00e9 et la qualit\u00e9 des mat\u00e9riaux utilis\u00e9s (marbre, granit poli, bronze, fer forg\u00e9, vitraux et bois pr\u00e9cieux), le raffinement des d\u00e9tails et la coh\u00e9rence de l'ensemble imposant des lignes simples et imposantes, contribu\u00e8rent d'embl\u00e9e \u00e0 sa valeur patrimoniale.\r\n\r\n \r\n\r\nCette belle demeure situ\u00e9e au coeur de la capitale de l'Europe est devenu un Centre d'Art et de Dialogue entre les cultures d'Orient et d'Occident. Ce centre r\u00e9pond \u00e0 plusieurs objectifs compl\u00e9mentaires: culturels, artistiques, p\u00e9dagogiques, scientifiques, ainsi qu'\u00e0 toutes activit\u00e9s qui peuvent renforcer ce dialogue. C'est dans cet esprit d'ouverture culturelle que la Fondation Boghossian y pr\u00e9sente des expositions prestigieuses, accessibles au public du mardi au dimanche. Toutes les informations utiles sont reprises sur le site internet de la Villa Empain.\r\n\r\n  ","description_print":"Dans la prestigieuse villa Empain, cette fondation vise \u00e0 d\u00e9velopper \u00e0 Bruxelles un centre de cr\u00e9ation et de dialogue entre l\u2019Orient et l\u2019Occident. Une programmation vari\u00e9e d\u2019activit\u00e9s culturelles est pr\u00e9vue pour le public.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"nl":{"name":"Boghossian Stichting - Villa Empain","address_street_name":"Franklin Rooseveltlaan","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Franklin Rooseveltlaan, 67","address_line2":"1050 Elsene","description_web":"De Villa Empain is vanaf 2010 toegankelijk voor het grote publiek. Er worden verschillende activiteiten en evenementen georganiseerd (tentoonstellingen, concerten, conferenties enz.). De stichting Boghossian heeft zijn internationale zetel in de Villa Empain waarvan de restauratiewerkzaamheden in 2008 zijn gestart. Samen met het Paleis Stoclet, gebouwd door de Oostenrijkse architect Josef Hoffmann in 1911, is de Villa Empain zeker een van de mooiste meesterwerken van de art-decoarchitectuur in Brussel. In 1930 liet de toen 21-jarige baron Louis Empain dit bijzondere huis ontwerpen met een oppervlakte van 2.500 vierkante meter, gelegen op de Natielaan (later de Franklin Rooseveltlaan). De bouw van dit prachtige huis vertrouwde hij toe aan de Zwitserse architect Michel Polak, bijgestaan door zijn medewerker Alfred Hoch. Het project dat voor Baron Empain werd uitgedacht op een terrein van 55 are, bestaat uit een grote villa met vier gevels in gepolijst graniet, een tuin met een zwembad, een pergola en een portierswoning. Het moderne en luxueuze karakter van deze constructie wekte al heel snel enthousiasme en nieuwsgierigheid op. De verscheidenheid, de kwaliteit van de gebruikte materialen (marmer, gepolijst graniet, brons, gietijzer en fijne houtsoorten), de verfijnde details en de harmonie van het geheel, de eenvoudige, maar indrukwekkende lijnen? Dit alles zou meteen bijdragen tot de waarde van de villa ","description_print":"Een centrum voor kunst en dialoog tussen de oosterse en de westerse cultuur . E\u00e9n van de belangrijkste doelstellingen van de Boghossian-stichting is het oprichten van een centrum van culturele en artistieke dialoog tussen het Oosten en het Westen. Haar uitvalsbasis is de prestigieuze villa Empain, waarin ze allerhande culturele activiteiten organiseert voor het publiek.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"en":{"name":"Boghossian Foundation - Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"\r\nOpening of Villa Empain to the public according to several themes of organised activities and events (exhibitions, concerts, conferences, etc.) from 2010. La Fondation Boghossian has its international office in Villa Empain, on which restoration work began in 2008. With the Stoclet building, constructed by the Austrian architect Josef Hoffmann in 1911, Villa Empain is undoubtedly one of the finest masterpieces of Art Deco architecture in Brussels. In 1930, Baron Louis Empain, then aged 21 years, had this 2,500-metre-square mansion built on the prestigious Avenue des Nations, which was later renamed Avenue Franklin Roosevelt. He entrusted the building of this fine house to the Swiss architect Michel Polak, assisted by his colleague Alfred Hoch. The plan designed for Baron Empain on a 55-acre plot included a monumental villa with four fa\u00e7ades in polished granite, a garden surrounding a swimming pool ornamented with a pergola, and a caretaker's lodge. The modern and luxurious nature of this structure soon aroused enthusiasm and curiosity. It is true that the variety and quality of the materials used (marble, polished granite, bronze, wrought iron, stained-glass windows and precious woods), the sophistication of the details and the coherence of the whole thing with simple but imposing lines immediately contributed to its patrimonial value. \r\n  ","description_print":"A villa in Art Deco style which is now home to the Boghossion Foundation: a centre for art and dialogue between Oriental and Western culture.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"de":{"name":"Boghossian-Stiftung \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"Die Anfang der 1930er-Jahre erbaute Villa Empain ist ein bemerkenswertes Beispiel der Art D\u00e9co-Architektur. Sie geh\u00f6rte einst einer der reichsten Familien Europas, die heute fast vollst\u00e4ndig verarmt ist. Die Villa steht seit 2007 unter Denkmalschutz.\r\n\r\nJugendstil, Art D\u00e9co und Moderne: Ihr Architekt Michel Polak (1885\u20131948) kombinierte Zierelemente des Br\u00fcsseler Jugendstils mit Formen der Moderne: Ein Gesamtkunstwerk, bei dem Formen und edle Materialien der eleganten Ausstattung untrennbar zu einer ungew\u00f6hnlichen und imposanten Einheit verschmelzen.\r\n\r\nVom drohenden Verfall zur aufwendigen Restaurierung: Nach der zwischenzeitlichen Nutzung als sowjetische Botschaft und als Studio des Fernsehsenders RTL wurde die Villa nach aufwendiger Restaurierung zur imposanten Kulisse der Kulturstiftung Fondation Boghossian.","description_print":"","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"it":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente....\r\n\r\nLa Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente.\r\nVilla Empain \u00e8 anche la sede internazionale della Fondazione Boghossian, che opera in molti paesi dal 1992.\r\nEdificio classificato dal 2007, \u00e8 stata interamente restaurata seguendo scrupolosamente le strutture originali.\r\n\r\nDa non perdere.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Villa Empain, Fundaci\u00f3n Boghossian","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain es un testigo destacado de la arquitectura Art d\u00e9co.\r\nConstruida a principios de los a\u00f1os 1930 y ubicada en el centro de la capital europea, se ha convertido en un Centro de Arte y de Di\u00e1logo imprescindible.\u00a0\r\n\r\nEs igualmente la sede internacional de la Fundaci\u00f3n Boghossian, que trabaja en distintos pa\u00edses desde el a\u00f1o 1992. Declarado monumento en el a\u00f1o 2007, ha sido restaurando siguiendo los criterios del edificio original.\u00a0A fecha de hoy, alberga diferentes exposiciones y actividades.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Av