k":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"video","link":"https:\/\/www.youtube.com\/watch?v=rdyaWV52QQ8","oEmbed_title":"Visite Bruxelles, Grand-Place, maison du Roy d'Espagne : imp\u00e9riale !","oEmbed_author_name":"Visite Bruxelles","oEmbed_author_url":"https:\/\/www.youtube.com\/c\/VisiteBruxelles","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/rdyaWV52QQ8\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/rdyaWV52QQ8?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Visite Bruxelles, Grand-Place, maison du Roy d'Espagne : imp\u00e9riale !"},"nl":{"title":"Visite Bruxelles, Grand-Place, maison du Roy d'Espagne : imp\u00e9riale !"},"en":{"title":"Visite Bruxelles, Grand-Place, maison du Roy d'Espagne : imp\u00e9riale !"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/e1613a65ff6fd04fff0abf974a27bdfa221b78d6.png","width":1080,"height":1920,"ratio":0.56,"translations":{"fr":{"title":"La Grand-Place en famille","copyright":null},"nl":{"title":"La Grand-Place en famille","copyright":null},"en":{"title":"La Grand-Place en famille","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/9f37c7627382778b7b33d7ae247daebfc576341a.jpg","width":1441,"height":1080,"ratio":1.33,"translations":{"fr":{"title":"La Grand-Place en famille","copyright":null},"nl":{"title":"La Grand-Place en famille","copyright":null},"en":{"title":"La Grand-Place en famille","copyright":null}}}],"dates":[{"day":"2022-07-31","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-01T01:07:36+02:00","published_at":"2022-03-03T11:47:08+01:00","backoffice_id":248911,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":538205,"date_start":"2022-07-01","date_end":"2022-09-30","date_next":"2022-09-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,163],"translations":{"fr":["Activit\u00e9 sportive","Natation et sports nautiques"],"nl":["Sportieve activiteit","Zwemmen en watersport"],"en":["Sporting activity","Swimming and water sports"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Kayak cleanup - Let's Mingle","shortdescr":"\u00c7a vous dit de rencontrer une nouvelle personne cet \u00e9t\u00e9 tout en faisant une bonne action ? Avec sa campagne estivale \u00ab Let\u2019s Mingle \u00bb, Canal It Up vous aide \u00e0 faire une nouvelle rencontre pendant son activit\u00e9 de p\u00eache aux d\u00e9chets en kayak sur le canal de Bruxelles. Rendez-vous romantique ou sympathique, c\u2019est \u00e0 vous de voir !","longdescr":"Vos amis vous ont laiss\u00e9 \u00e0 Bruxelles pour faire des vacances en famille ? Vous ne partez pas cet \u00e9t\u00e9 et vous cherchez une alternative au verre en terrasse ? Les sites de rencontre ne vous proposent rien de bon ces derniers temps ? \r\n\r\nCanal It Up vous entend et lance une nouvelle campagne estivale \u00ab Let\u2019s Mingle \u00bb pour vous faire rencontrer une nouvelle personne. Pourquoi ? Simplement parce qu\u2019\u00e9changer avec quelqu\u2019un de nouveau peut nous aider \u00e0 lib\u00e9rer notre cr\u00e9ativit\u00e9, \u00e0 nous donner l\u2019\u00e9nergie pour monter un projet, \u00e0 \u00e9largir notre horizon \u2013 bref \u00e0 faire germer de belles id\u00e9es !\r\n\r\nEt quelle meilleure mani\u00e8re de briser la glace qu\u2019une p\u00eache aux d\u00e9chets en kayak ? Vous serez tous deux hors de votre zone de confort, vous devrez coop\u00e9rer pour avancer et les objets trouv\u00e9s dans l\u2019eau alimenteront la conversation.\r\n\r\nConcr\u00e8tement, l\u2019association a pr\u00e9par\u00e9 un formulaire pour r\u00e9colter quelques informations et pouvoir apparier les participants : https:\/\/www.canalitup.org\/letsmingle\/. Pour prendre part, il suffit donc de le compl\u00e9ter, d\u2019attendre que l\u2019on vous d\u00e9niche un partenaire et que l\u2019on vous propose une date et heure.\r\n\r\nL\u2019activit\u00e9 dure 1h30 et le rendez-vous se fait sur le quai \u00e0 hauteur du Quai des P\u00e9niches 10, 1000 Bruxelles. Rencontre romantique ou sympathique, \u00e0 vous de voir !","performers":"Canal It Up","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538205.html"},"nl":{"name":"Kayak cleanup - Let's Mingle","shortdescr":"Zin om iets goed te doen voor de planeet EN om iemand nieuw te leren kennen deze zomer? Met zijn actie \u201cLet\u2019s Mingle\u201d maakt Canal It Up het mogelijk voor je om met een nieuw persoon kennis te maken tijdens een afval clean up per kayak op het kanaal van Brussel. Romantisch of niet, dat kiest je zelf.","longdescr":"Zijn al je vrienden op vakantie en ben je alleen achtergebleven in Brussel? Ben je vrienden kwijt gespeeld in het web van corona lockdowns of hebben ze kinderen gemaakt en zijn te druk bezig? Ben je klaar voor een nieuw romantisch avontuur maar vind weinig interessants op de dating apps? \r\n\r\nCanal It Up heeft jullie signalen opgevangen en lanceert een zomer campagne  - \u00ab Let\u2019s Mingle \u00bb - om jullie een nieuw persoon te laten leren kennen. Waarom? Simpelweg omdat een uitwisseling met een nieuw persoon ons kan helpen onze creativiteit aan te wakkeren, ons de energie kan geven een project op te starten of onze horizon kan verruimen \u2013 veel nieuwe idee\u00ebn kunnen ontspruiten bij zulke ontmoetingen!\r\n\r\nEn welke betere manier bestaat er om het ijs te breken dan kajakken op het kanaal om afval uit het water te vissen? Jullie beide zullen zich buiten jullie comfortzone bevinden, jullie zullen moeten samenwerken om vooruit te geraken en de gevonden objecten (soms zeer merkwaardig) zullen het gesprek voorzien van genoeg gespreksstof.\r\n\r\nZin om mee te doen? We hebben een formulier opgesteld om wat informatie te verzamelen en de mensen te kunnen kopellen: https:\/\/www.canalitup.org\/letsmingle\/. Je moet dus gewoon het formulier invullen, wachten tot wanneer we de perfecte partner vinden en een datum en uur voorstellen voor de vaartocht.\r\n\r\nDe activiteit duurt 1,5u, is plezier verzekerd en kan romantisch zijn of niet, dat kiest iedereen zelf. Afspraak op de kade ter hoogte van Akenkaai 10, 1000 Brussels.","performers":"Canal It Up","boxoffice_url":null,"website":"https:\/\/www.canalitup.org\/letsmingle\/","email":"info@canalitup.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538205.html"},"en":{"name":"Kayak cleanup - Let's Mingle","shortdescr":"Would you like to meet someone new while doing a good deed? With its Summer action \u201cLet\u2019s Mingle\u201d, Canal It Up arranges for you to meet a new person while fishing for trash by kayak on Brussels canal. A friendly or a romantic encounter \u2013 it\u2019s up to you to decide!","longdescr":"Your friends have left you behind in Brussels to go on holiday? Or did some friendships not survive the corona lockdowns? Or maybe you\u2019re ready for a new romantic adventures but not very inspired by the dating apps?\r\n\r\nCanal It Up saw the signs and launched its Summer action \u201cLet\u2019s Mingle\u201d to help you meet someone new. Why? Because connecting with new people can help us unleash our creativity, give us the energy to start a project, broaden our world view \u2013 in short, because great ideas sprout out of new encounters!\r\n\r\nAnd can you think of something better to do to break the ice than kayaking? You\u2019ll both be out of your comfort zone, you won\u2019t have to feel self-conscious about your clothes because you\u2019ll be wearing a flashy life jacket anyway, you\u2019ll have to collaborate to move forward and the things you\u2019ll find in the water will fuel your conversation.\r\n\r\nWant to participate? We have prepared a form to collect some information that will allow us to find the right partner: https:\/\/www.canalitup.org\/letsmingle\/. So fill it in and then wait until we\u2019ve found you a match and we contact you to fix a date. \r\n\r\nThe activity lasts for one and a half hour and the meeting point is on the quay at Quai des P\u00e9niches 10, 1000 Brussels. A friendly or romantic encounter \u2013 it\u2019s up to you to decide!","performers":"Canal It Up","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538205.html"},"de":{"name":"Kayak cleanup - Let's Mingle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538205.html"},"it":{"name":"Kayak cleanup - Let's Mingle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_