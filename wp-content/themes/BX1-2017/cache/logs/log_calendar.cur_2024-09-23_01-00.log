lundi et mardi: ferm\u00e9","mercredi, jeudi, vendredi, samedi et dimanche: de 11:00 \u00e0 22:00"],"nl":["maandag en dinsdag: gesloten","woensdag, donderdag, vrijdag, zaterdag en zondag: van 11:00 tot 22:00"]},"date_start":"2024-05-23","date_end":"2024-11-30","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[265,261],"translations":{"de":["Barrierefreies WC","Barrierefreier Parkplatz"],"pt":[null,null],"en":["Adapted toilet","Accessible parking"],"it":["WC idoneo","Parcheggio accessibile"],"cn":[null,null],"fr":["WC adapt\u00e9","Parking accessible"],"sp":["Ba\u00f1os adaptados","Estacionamiento habilitado"],"nl":["Aangepast toilet","Toegankelijke parking"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["annee_art_nouveau"],"opening":{"day":"2024-05-23","is_only_by_appointment":false,"timestamp":"2024-05-23T00:00:00"}},{"id":50005975,"date_start":"2024-03-20","date_end":"2024-09-29","date_next":"2024-09-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-22T02:01:11+02:00","published_at":"2024-01-11T08:58:07+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292280,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.21764202359637289,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Folon unseen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005975"},"pt":{"name":"Folon unseen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005975"},"en":{"name":"Folon unseen","shortdescr":"This new, made-to-measure exhibition celebrates a passionate and overlooked Folon as a compulsive collector eager to explore his world through a multitude of mediums. Taking place in the majestic yet intimate spaces of one of Victor Horta's first houses, the exhibition presents around a hundred works and objects that reflect the endless, intriguing and abundant creativity of this Belgian artist.\n\n","longdescr":"Whether through his posters, illustrations, television animations or his numerous exhibitions, Folon left a deep impact on the collective imagination of the last third of the 20th century. The humanist Belgian artist, who died in 2005, left a figurative and poetic body of work, rooted in traditional techniques and atypical of the artistic panorama of his time.\n\nFOLON UNSEEN \n\nWhile many artists of his generation took the path of conceptual art, Jean-Michel Folon (1934-2005) enjoyed exploring traditional art techniques throughout his career, including watercolour, bronze sculpture, ceramics, etching, stained glass and even tapestry! He also collected all kinds of objects as starting points for future works. This new, made-to-measure exhibition celebrates a passionate and overlooked Folon as a compulsive collector eager to explore his world through a multitude of mediums. Taking place in the majestic yet intimate spaces of one of Victor Horta's first houses, the exhibition presents around a hundred works and objects that reflect the endless, intriguing and abundant creativity of this Belgian artist.\n\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005975"},"it":{"name":"Folon unseen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005975"},"cn":{"name":"Folon unseen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005975"},"fr":{"name":"Folon insolite","shortdescr":" Cette exposition in\u00e9dite et sur mesure, met \u00e0 l\u2019honneur un Folon m\u00e9connu et passionnant, collectionneur compulsif avide de confronter son univers \u00e0 une multitude de m\u00e9dias. Prenant place dans les espaces d\u2019une des premi\u00e8res maisons de Victor Horta, elle pr\u00e9sente une centaine d\u2019\u0153uvres et objets qui traduisent la cr\u00e9ativit\u00e9 sans fin, intrigante et foisonnante, de cet artiste belge.\n","longdescr":"Que ce soit par ses affiches, ses illustrations, ses animations t\u00e9l\u00e9visuelles et par ses nombreuses expositions, Folon a mondialement marqu\u00e9 l\u2019imaginaire collectif du dernier tiers du 20e si\u00e8cle. Humaniste, l\u2019artiste belge, d\u00e9c\u00e9d\u00e9 en 2005, laisse une \u0153uvre figurative et po\u00e9tique, ancr\u00e9e dans des techniques traditionnelles et, de ce fait, atypique dans le panorama artistique de son temps.\nFOLON INSOLITE\nAlors que de nombreux artistes de sa g\u00e9n\u00e9ration se lancent sur les voies de l\u2019art conceptuel, Jean- Michel Folon (1934-2005) explore avec bonheur et tout au long de sa carri\u00e8re les techniques traditionnelles de l\u2019art, comme l\u2019aquarelle, la sculpture en bronze, la c\u00e9ramique, la gravure \u00e0 l\u2019eau-forte, le vitrail et m\u00eame la tapisserie ! Il a aussi chin\u00e9 des objets en tout genre, comme autant de points de d\u00e9part pour des \u0153uvres futures. Cette exposition, in\u00e9dite et sur mesure, met \u00e0 l\u2019honneur un Folon m\u00e9connu et passionnant, collectionneur compulsif avide de confronter son univers \u00e0 une multitude de m\u00e9dias. Prenant place dans les espaces \u00e0 la fois majestueux et intimes d\u2019une des premi\u00e8res maisons de Victor Horta, elle pr\u00e9sente une centaine d\u2019\u0153uvres et objets qui traduisent la cr\u00e9ativit\u00e9 sans fin, intrigante et foisonnante, de cet artiste belge.\n","performers":"Jean-Michel Folon","boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005975"},"sp":{"name":"Folon unseen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005975"},"nl":{"name":"Folon insoliet","shortdescr":"Deze tentoonstelling op maat viert een gepassioneerde en miskende Folon als een verzamelaar die zijn wereld wilde verkennen door middel van een groot aantal mediums. De tentoonstelling vindt plaats van een van de eerste huizen van Victor Horta en presenteert een honderdtal werken en objecten die de eindeloze, intrigerende en overvloedige creativiteit van deze Belgische kunstenaar weerspiegelen.\n","longdescr":"Door zijn posters, illustraties, televisieanimaties en talrijke tentoonstellingen heeft Folon een diepe impact gehad op de collectieve verbeelding van het laatste derde deel van de 20e eeuw. De humanistische Belgische kunstenaar, die in 2005 overleed, liet een figuratief en po\u00ebtisch oeuvre na, geworteld in traditionele technieken en atypisch voor het artistieke panorama van zijn tijd.\n\nFOLON INSOLIET\n\nTerwijl veel kunstenaars van zijn generatie de richting van de conceptuele kunst volgden, verkende Jean-Michel Folon (1934-2005) tijdens zijn carri\u00e8re graag traditionele kunsttechnieken, zoals aquarel, bronzen beeldhouwwerk, keramiek, etsen, glas-in-lood en zelfs wandtapijten! Hij verzamelde ook allerlei voorwerpen als uitgangspunt voor toekomstige kunstwerken. Deze nieuwe tentoonstelling op maat viert een gepassioneerde en miskende Folon als een compulsieve verzamelaar die zijn wereld wilde verkennen door middel van een groot aantal mediums. De tentoonstelling vindt plaats in de majestueuze maar intieme ruimtes van een van de eerste huizen van Victor Horta en presenteert een honderdtal werken en objecten die de eindeloze, intrigerende en overvloedige creativiteit van deze Belgische kunstenaar weerspiegelen.\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005975"}},"place":{"id":241931,"translations":{"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Autrique House","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaarbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":4383,"location":{"lat":50.8632575,"lon":4.3731694},"region":"brussels","last_updated_at":"2024-09-10T13:09:05+02:00","published_at":"2013-10-19T01:17:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":241931,"translations":{"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Autrique House","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est 