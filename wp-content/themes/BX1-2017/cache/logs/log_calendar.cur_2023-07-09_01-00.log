,"copyright":null},"it":{"title":"Muntpunt Schaakclub","copyright":null},"sp":{"title":"Muntpunt Schaakclub","copyright":null},"pt":{"title":"Muntpunt Schaakclub","copyright":null},"cn":{"title":"Muntpunt Schaakclub","copyright":null}}}],"dates":[{"day":"2023-07-19","doors":null,"start":"16:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[3],"translations":{"fr":["Enfants 3-6 ans"],"nl":["Kinderen 3-6 j."],"en":["Children 3-6 yr."],"de":["Kinder 3-6 Jahre"],"it":["Bambini 3-6 anni"],"sp":["Ni\u00f1os de 3 a 6 a\u00f1os"],"pt":[null],"cn":[null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-05T13:05:39+02:00","published_at":"2023-06-23T18:00:15+02:00","backoffice_id":280308,"import_origin":"muntpunt","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":561249,"date_start":"2023-07-19","date_end":"2023-08-09","date_next":"2023-07-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"D\u00e9couverte des 4 vall\u00e9es d\u2019Anderlecht","shortdescr":null,"longdescr":"** La vall\u00e9e du VOGELZANG - Mercredi 19 JUILLET\r\nV\u00e9ritable \u00e9crin de verdure dans la ville, la balade vous guidera du parc du Vogelzang, en passant  le long de ses \u00e9tangs et mares, pour rejoindre les m\u00e9andres naturels de la R\u00e9serve Naturelle du Vogelzangbeek.  Vous aurez l\u2019occasion d\u2019observer divers am\u00e9nagements ainsi que la faune et la flore locales. \r\n\u2192 Transport en commun  - M\u00e9tro\u00a0:  ligne 5 (Erasme) \r\n\u2192 D\u00e9part : station \u00ab Erasme \u00bb Arriv\u00e9e : station \u00ab Ceria \u00bb\r\n\r\n** La vall\u00e9e de la SENNE - Mercredi 26 JUILLET\r\nVous d\u00e9couvrirez les derniers vestiges de la Senne, rivi\u00e8re \u00e0 ciel ouvert \u00e0 Anderlecht. La balade vous montrera au gr\u00e9 des chemins son pass\u00e9 industriel, son \u00e9cluse, son d\u00e9versoir, et le r\u00e9am\u00e9nagement de ses berges en une promenade aux aspects tant\u00f4t urbains tant\u00f4t champ\u00eatres, \u00e0 la rencontre de nouveaux quartiers, d\u2019oiseaux aquatiques, de batraciens et de flore sauvage.\r\n\u2192 Transport en commun Stib : bus 78 (Humanit\u00e9) - 73 (Ceria) - De Lijn: 153-154-155 (Bollinckx)\r\n\u2192 D\u00e9part : arr\u00eat Bollinckx \/ bvd International - Arriv\u00e9e : boulevard Paepsem  -  \u00abPont du Charroi\u00bb\r\n\r\n** La vall\u00e9e du BROECK - Mercredi 2 AOUT\r\nLa promenade d\u00e9bute o\u00f9 le ruisseau, le Broekbeek entre sur le territoire et longe la cit\u00e9-jardin du Bon Air. Vous prendrez la direction Neerpede \u00e0 travers les paysages ruraux du plateau de Scherdemael et aboutirez aux abords de l\u2019\u00e9tang r\u00e9gional de la Pede.  Vous emprunterez le sentier 116 pour rejoindre un espace bois\u00e9 pr\u00e9serv\u00e9 \u00ab La Boisette \u00bb. Diverses observations (quartier, environnement, nature,...) agr\u00e9menteront cette promenade.\r\n\u2192 Transport en commun Stib : bus 46 (Moortebeek) - 75 (Bon Air) \u2013 89 & 53 (Shopping Westland) - De Lijn: 116-117-118-571-572-810 (shopping Westland) \r\n\u2192 D\u00e9part & arriv\u00e9e : \u00e0 l\u2019angle de l\u2019avenue de la F\u00e9condit\u00e9 et de la rue de l\u2019Enthousiasme.\r\n\r\n** La vall\u00e9e de la PEDE - Mercredi 9 AOUT\r\nPorte d\u2019entr\u00e9e du Pajottenland, la balade vous d\u00e9voilera au fil des eaux de la Pede, du parc des Etangs au vallon du Koeivijver, en passant par l\u2019\u00e9tang r\u00e9gional de Neerpede, un paysage de campagne, bord\u00e9 de bocages, de p\u00e2tures, de champs, de fermettes.\r\n\u2192 Transport en commun Stib : tram 81 (Marius Renard) \r\n\u2192 D\u00e9part & arriv\u00e9e : arr\u00eat \u00ab Marius Renard \u00bb","performers":null,"boxoffice_url":null,"website":null,"email":"tourisme@anderlecht.brussels","phone_contact":"+32 2 526 83 65","phone_booking":"+32 2 526 83 51","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561249"},"nl":{"name":"Ontdek de 4 valleien van Anderlecht","shortdescr":null,"longdescr":"**De VOGELZANGvallei - Woensdag 19 JULI\r\nDe wandeling leidt je vanuit het Vogelzangpark, een groene parel in de stad, langs de vijvers en poelen, tot aan de natuurlijke meanders van het natuurreservaat  van de Vogelzangbeek. Je krijgt de gelegenheid om verschillende inrichtingen en de plaatselijke flora en fauna te bewonderen.\r\n\u2192 Openbaar vervoer : Metro Lijn 5 (Erasmus) \r\n\u2192 Vertrek: station \u00abErasmus\u00bb - Aankomst: station \u00ab\u00a0Coovi \u00bb\r\n\r\n** De ZENNEvallei - Woensdag 26 JULI\r\nOntdek de laatste overblijfselen van de Zenne, een rivier in open lucht in Anderlecht. Tijdens de  wandeling maak je kennis met het industri\u00eble verleden, de sluis, de overloop en de herinrichting  van de oevers, waarbij je zowel stedelijke als landelijke aspecten tegenkomt en nieuwe wijken, watervogels, amfibie\u00ebn en wilde flora leert kennen. \r\n\u2192 Openbaar vervoer Mivb : bus 78 (Humaniteit) - 73 (Coovi)\u00a0 - De Lijn: 153-154-155 (Bollinckx)\r\n\u2192 Vertrek: bushalte Bollinckx \/ Internationalelaan  - Aankomst: Paapsemlaan  -  \u00abGerijbrug\u00bb\r\n\r\n** De BROEKvallei - Woensadg 2 AUGUSTUS\r\nDe wandeling begint waar de Broekbeek het grondgebied binnenstroomt en langs de tuinwijk Goede Lucht loopt. Ze voert je richting Neerpede door het landelijke landschap van het plateau van Scherdemaal en eindigt bij de gewestelijke Pedevijver. Pad 116 leidt je naar een beschermde bosrijke ruimte, \u201cLa Boisette\u201d genaamd. Verschillende bezienswaardigheden in de wijken, de omgeving en de natuur vullen de wandeling perfect aan. \r\n\u2192  Openbaar vervoer Mivb : bus 46 (Moortebeek) - 75 (Goede Lucht) \u2013 89 & 53 (Shopping Westland) - De Lijn: 116-117-118-571-572-810 (shopping Westland) \r\n\u2192 Vertrek & aankomst: op de hoek van de Vruchtbaarheidslaan en de Geestdriftstraat \r\n\r\n** De PEDEvallei - Woensdag 9 AUGUSTUS\r\n Deze wandeling voert je langs het water van de Pede, de toegangspoort tot het Pajottenland, van het Vijverpark tot de vallei van de Koeivijver, via de gewestelijke vijver van Neerpede, door een landelijk landschap met boomgaarden, weiden, velden En boerderijtjes.\r\n\u2192 Openbaar vervoer Mivb : tram 81 (Marius Renard) \r\n\u2192 Vertrek & aankomst: bushalte \u00abMarius Renard\u00bb","performers":null,"boxoffice_url":null,"website":null,"email":"toerisme@anderlecht.brussels","phone_contact":"+32 2 526 83 65","phone_booking":"+32 2 526 83 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561249"},"en":{"name":"D\u00e9couverte des 4 vall\u00e9es d\u2019Anderlecht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"tourisme@anderlecht.brussels","phone_contact":"+32 2 526 83 65","phone_booking":"+32 2 526 83 51","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561249"},"de":{"name":"D\u00e9couverte des 4 vall\u00e9es d\u2019Anderlecht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"tourisme@anderlecht.brussels","phone_contact":"+32 2 526 83 65","phone_bo