,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"]}}},"languages":{"spoken":["fr","nl","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":"Ariane de Rosmorduc  reprend plaisir \u00e0 la terre ferme.\r\nTUMBLEWEED est le titre de sa nouvelle exposition.\r\nLes tumbleweeds, sont des boules v\u00e9g\u00e9tales l\u00e9g\u00e8res qui une fois ass\u00e9ch\u00e9es, se d\u00e9tachent de leur racine et roulent au gr\u00e9 du vent.\r\nAriane ne perd pas le fil, quand il s'agit d'interpr\u00e9ter ce ph\u00e9nom\u00e8ne en une m\u00e9taphore \r\ncontemporaine sur le sort d'une partie de l'humanit\u00e9.","longdescr":"Apr\u00e8s avoir c\u00e9l\u00e9br\u00e9 les myst\u00e8res et fantasmagories d'un monde sous-marin imaginaire, Ariane \r\nde Rosmorduc (Bruxelles, 1967) reprend plaisir \u00e0 la terre ferme.\r\nTUMBLEWEED est le titre de sa nouvelle exposition.\r\nLes tumbleweeds, typiques des d\u00e9serts de l'ouest am\u00e9ricain, sont des boules v\u00e9g\u00e9tales touffues \r\net l\u00e9g\u00e8res qui une fois ass\u00e9ch\u00e9es, se d\u00e9tachent de leur racine et roulent au gr\u00e9 du vent. Les \r\nwesterns et les m\u00e9dias visuels ont conduit \u00e0 une signification symbolique de cette plante \r\nmyst\u00e9rieuse qui s'agite et tourne sur elle-m\u00eame en toute l\u00e9g\u00e8ret\u00e9, dans des lieux d\u00e9sol\u00e9s, vid\u00e9s \r\nde leurs occupants.\r\nAriane ne perd pas le fil, quand il s'agit d'interpr\u00e9ter ce ph\u00e9nom\u00e8ne en une m\u00e9taphore \r\ncontemporaine sur le sort d'une partie de l'humanit\u00e9. Cette migration v\u00e9g\u00e9tale, l'artiste la \r\nsublime par des nuances chromatiques tr\u00e8s riches et par un travail de la mati\u00e8re \u00e9poustouflant. \r\nCes vibrations mati\u00e8re\/couleur jouent dans l'espace de la toile au point d'y insuffler le \r\nmouvement provoquant ainsi, la fuite en avant du \"virevoltant\"","performers":"Ariane de Rosmorduc","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531221.html"},"nl":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":"Na het vieren van mysteries en fantasmagorie van de onderwaterwereld, Ariane de Rosmorduc\r\n(Brussel, 1967) keert terug op de aarde.\r\nTUMBLEWEED is de titel van haar nieuwe tentoonstelling.\r\nTumbleweeds zijn typische planten van de woestijnen in het Westen America. Het zijn vegetal\r\nballen die eenmaal gedroogd, lost komen van hun wortels en meerollen met de wind. Westerns\r\nen visuele media hebben geleid tot een symbolische betekenis van deze mysterieuze plant dat\r\nzich in alle lichtheid, op verlaten en lege plaatsen beweegt en ronddraaien.\r\nAriane verliest de draad niet, als het gaat om het interpreteren van dit fenomeen in een\r\nhedendaagse metafoor over het lot van een deel van de mensheid. Deze plantenmigratie is\r\ngesublimeerd door de kunstenares door zeer rijke chromatische nuances en door een\r\nadembenemend materiaalwerk. Deze materie\/kleuren spelen in de ruimte van het doek tot het\r\npunt dat er een soort beweging in wordt geademd en zo een halsstarrige rush van de\r\n\"wervelende plant\" veroorzaakt.","performers":null,"boxoffice_url":null,"website":null,"email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531221.html"},"en":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":"","performers":null,"boxoffice_url":null,"website":null,"email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531221.html"},"de":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531221.html"},"it":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531221.html"},"sp":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531221.html"},"pt":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/531221.html"},"cn":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/531221.html"}},"place":{"id":260455,"translations":{"fr":{"name":"zedes art gallery","address_street_name":"Rue Paul Lauters","address_street_number":"36","address_street_box":null,"email":"zedes.art.gallery@gmail.com","website":"http:\/\/www.zedes-art-gallery.be","phone_contact":"+32 475 52 62 58","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Paul Lauters, 36","address_line2":"1050 Ixelles","description_web":null,"description_