al"}},"value":5},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":5},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":5},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[3,4,5,11],"translations":{"fr":["Enfants 3-6 ans","Enfants 6-9 ans","Enfants 9-12 ans","Famille"],"nl":["Kinderen 3-6 j.","Kinderen 6-9 j.","Kinderen 9-12 j.","Familie"],"en":["Children 3-6 yr.","Children 6-9 yr.","Children 9-12 yr.","Family"]}},"tags":["kids"],"accessibilities":{"list":[252,255,256,257,259,263],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-17T15:35:07+02:00","published_at":"2022-05-17T15:10:48+02:00","backoffice_id":253886,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":510572,"date_start":"2021-05-02","date_end":"2022-08-31","date_next":"2022-05-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":"Le tour \u00ab Art Nouveau : de la Source aux \u00c9tangs \u00bb vous emm\u00e8ne du quartier Defacqz jusqu\u2019aux \u00e9tangs d\u2019Ixelles, \u00e0 la d\u00e9couverte d\u2019architectes de la premi\u00e8re et de la seconde g\u00e9n\u00e9ration de l\u2019Art Nouveau.","longdescr":"Laissez-vous conter l\u2019histoire urbanistique de ces quartiers jouxtant l\u2019Avenue Louise et l\u2019Abbaye de La Cambre en (re-)d\u00e9couvrant de nombreuses fa\u00e7ades de maisons et h\u00f4tels particuliers.\r\n\r\nAbritant plusieurs \u0153uvres d\u2019architectes majeurs, le quartier Defacqz t\u00e9moigne des premiers \u00e9lans de l\u2019architecture Art Nouveau \u00e0 Bruxelles. Apr\u00e8s quelques arr\u00eats autour de la rue Defacqz et de l\u2019avenue Louise, la visite se poursuit dans le quartier plus paisible des \u00e9tangs d\u2019Ixelles \u00e0 la rencontre d\u2019autres tr\u00e9sors architecturaux.\r\n\r\nD\u00e9couvrez des bijoux insoup\u00e7onn\u00e9s dans des quartiers travers\u00e9s tous les jours par des milliers de personnes et qui ont vu, malgr\u00e9 les (r)\u00e9volutions urbaines, leur beaut\u00e9 et leurs richesses pr\u00e9serv\u00e9es !\r\n\r\nAu programme de la balade, entre autres\u2026\r\n\u2013 L\u2019H\u00f4tel Tassel, de Victor Horta ;\r\n\u2013 L\u2019H\u00f4tel Solvay, de Victor Horta ;\r\n\u2013 L\u2019H\u00f4tel Otlet, d\u2019Octave van Rysselberghe et Henry Van de Velde ;\r\n\u2013 L\u2019H\u00f4tel Ciamberlani, de Paul Hankar ;\r\n\u2013 D\u2019autres \u0153uvres d\u2019Albert Roosenboom, Ernest Delune, Ernest Blerot ;\r\n\u2013 Mais aussi de nombreuses petites histoires et anecdotes !\r\n\r\nNous ne rentrerons pas dans les maisons et h\u00f4tels (souvent habit\u00e9s), mais des supports photographiques sont pr\u00e9vus pour vous permettre de mieux vous rendre compte de l\u2019int\u00e9rieur des \u00e9difices. Parce que l\u2019Art Nouveau est un \u201cArt Total\u201d qui ne s\u2019arr\u00eate certainement pas aux fa\u00e7ades !\r\n\r\nINFORMATIONS Pratiques\r\ntours r\u00e9guliers en fran\u00e7ais et en anglais :\r\nPrix : Libre et conscient\r\nR\u00e9servation + que conseill\u00e9e\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : \u201cLouise Tower\u201d (devant l\u2019entr\u00e9e de la tour), avenue Louise 149 \u2013 1050 Bruxelles (en face de l\u2019arr\u00eat de tram Defacqz)\r\nFin de la visite : Au bord des \u00c9tangs d\u2019Ixelles\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais ou en anglais","performers":"Une visite guid\u00e9e originale de Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la-source-aux-etangs\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/510572.html"},"nl":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/510572.html"},"en":{"name":"Art Nouveau : From the Spring to the Ponds","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/510572.html"},"de":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/