rue,"ranking":0.31833136784577},{"id":538949,"date_start":"2022-07-26","date_end":"2022-08-31","date_next":"2022-08-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,161],"translations":{"fr":["Activit\u00e9 sportive","Sport de raquettes et ballon"],"nl":["Sportieve activiteit","Bal en racketsport"],"en":["Sporting activity","Racket sports"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Biestebroeck : Sports gratuits cet \u00e9t\u00e9 au \"Hangar Sud\"","shortdescr":"Biestebroeck : Sports gratuits cet \u00e9t\u00e9 au \"Hangar Sud\"","longdescr":"Un hangar vide, situ\u00e9 sur le quai Biestebroek \u00e0 Anderlecht, est ouvert au quartier et sera enti\u00e8rement d\u00e9di\u00e9 aux sports en salle. Cet \u00e9t\u00e9, petits et grands pourront venir s'amuser, en semaine de 12h00 \u00e0 18h00 et le week-end \u00e0 partir de 10h00. Les sports propos\u00e9s commenceront par le football et le badminton et seront \u00e9tendus \u00e0 d'autres sports et activit\u00e9s en salle dans les semaines \u00e0 venir.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538949"},"nl":{"name":"Biestebroeck: Gratis sporten deze zomer in \"Hangar Sud\"","shortdescr":"Biestebroeck: Gratis sporten deze zomer in \"Hangar Sud\"","longdescr":"Een leegstaande hangar, gelegen aan het Biestebroekdok in Anderlecht wordt deze zomer volledig gewijd aan indoorsporten. Op weekdagen kunnen jong en oud er zich komen uitleven van 12u. tot 18u. en tijdens het weekend al vanaf 10u. Het sportaanbod start met voetbal en badmintonnen en zal in de komende weken nog worden uitgebreid met andere indoorsporten en -activiteiten.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.entrakt.be\/hangar","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538949"},"en":{"name":"Biestebroeck: Free sports this summer in \"Hangar Sud","shortdescr":"Biestebroeck: Free sports this summer in \"Hangar Sud","longdescr":"A disused hangar, located at the Biestebroek dock in Anderlecht will be entirely dedicated to indoor sports during this summer. On weekdays, young and old can come and have fun there from 12 p.m. to 6 p.m. and during the weekend from 10 a.m. The sports on offer will start with football and badminton and will be extended to other indoor sports and activities in the coming weeks.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538949"},"de":{"name":"Biestebroeck: Gratis sporten deze zomer in \"Hangar Sud\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538949"},"it":{"name":"Biestebroeck: Gratis sporten deze zomer in \"Hangar Sud\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538949"},"sp":{"name":"Biestebroeck: Gratis sporten deze zomer in \"Hangar Sud\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538949"},"pt":{"name":"Biestebroeck: