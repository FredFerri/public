":["Puppet show"],"it":["Teatro delle marionette"],"cn":[null],"fr":["Th\u00e9\u00e2tre de marionnettes"],"sp":["Teatro de marionetas"],"nl":["Poppentheater"]}}},"translations":{"de":{"name":"Hamlet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009264"},"pt":{"name":"Hamlet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009264"},"en":{"name":"Hamlet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009264"},"it":{"name":"Hamlet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009264"},"cn":{"name":"Hamlet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009264"},"fr":{"name":"Hamlet","shortdescr":"Parodie pour marionnettes, en bruxellois fran\u00e7ais.","longdescr":"\"Toone be or not Toone be ?\"\n\nLors de l\u2019entr\u00e9e de la Grande-Bretagne dans le March\u00e9 Commun\n(maintenant Union europ\u00e9enne), Toone VII introduit dans le r\u00e9pertoire\ndes poechenelle (marionnettes) bruxelloises \u201cLa Trag\u00e9die de Hamlet, prince de Danemark\u201d, du c\u00e9l\u00e8bre dramaturge anglais William Shakespeare.\nAvec \u201cMacbeth\u201d, \u201cOthello\u201d et \u201cRom\u00e9o et Juliette\u201d, \u201cHamlet\u201d fait partie\ndes oeuvres du grand William jou\u00e9es \u00e0 l\u2019impasse Schuddeveld.\nIl s\u2019agit bien s\u00fbr d\u2019une parodie du drame de Hamlet par les auteurs\nf\u00e9tiches de Toone VII : Arthur et Elisabeth Fauquez\ndans les d\u00e9cors de Raymond Goffin.\nTir\u00e9 d\u2019une l\u00e9gende, le drame en cinq actes de l\u2019auteur\ndu th\u00e9\u00e2tre \u00e9lisab\u00e9thain est ramen\u00e9 en deux parties dans sa version bruxelloise.\nApparu sur les remparts du ch\u00e2teau d\u2019Elseneur au Danemark, le \u201cspuuk\u201d\n(le spectre) de Hamlet-le-Vieux apprend \u00e0 son fils Hamlet, qu\u2019il a p\u00e9ri\nassassin\u00e9 par son oncle Claudius. Ce dernier lui a \u201csprou\u00eft\u00e9\u201d (inject\u00e9) une bombe antimouche dans l\u2019oreille. Il a usurp\u00e9 le tr\u00f4ne.\nSon forfait commis, il a \u00e9pous\u00e9 la veuve, la reine Gertrude, sa complice.\nLe spuuk dit \u00e0 son fils :\n\u201cFiske, je grille mon pauvre derri\u00e8re tout nu sur le feu du Purgatoire !\u201d\nEt le jeune Hamlet de r\u00e9pondre : \u201cPoupa, je vais te venger terriblement.\u201d\nBien que le drame se d\u00e9roule \u00e0 Elseneur, sombre ch\u00e2teau perdu\ndans les marais profonds du Danemark, Toone, fid\u00e8le \u00e0 la tradition,\nplante les d\u00e9cors dans des lieux qui nous sont familiers\ncomme le port d\u2019Ostende avec la malle Ostende-Douvres,\nle cimeti\u00e8re d\u2019Ixelles et la place de Brouck\u00e8re.\nHamlet d\u00e9laisse sa fianc\u00e9e Oph\u00e9lie sur cet impromptu :\n\u201cLes ba\u00eeses, Oph\u00e9lieke, c\u2019est pour les com\u00e9dies z\u2019\u00e9rotiques\npas pour les trag\u00e9dies corn\u00e9liennes.\u201d\nSuite sur la sc\u00e8ne.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009264"},"sp":{"name":"Hamlet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009264"},"nl":{"name":"Hamlet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009264"}},"place":{"id":231143,"translations":{"de":{"name":"Marionettentheater - Th\u00e9\u00e2tre de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"W\u00e4hrend der spanischen Besetzung der Niederlande wurden zwangsweise s\u00e4mtliche Theater geschlossen, um Kritik - in Form von satirischen St\u00fccken - an den spanischen Herrschern zu unterbinden. Die Br\u00fcsseler haben alsdann die Schauspieler durch Marionetten (\"Poechenelles\" in Br\u00fcsseler Mundart) ersetzt, die in illegalen Theatern auftragen. \r\nAnfang des 19. Jahrhunderts z\u00e4hlten die Br\u00fcsseler Marionettentheater zu den beliebtesten Vergn\u00fcgungen f\u00fcr Erwachsene, denn sie boten eine enorme Freiheit, ben\u00f6tigen nur wenig finanzielle Mittel und konnten \u00fcberall aufgef\u00fchrt werden. Ihr Repertoire ist bis heute sehr vielf\u00e4ltig und reicht von volkst\u00fcmlichen Legenden \u00fcber Rittergeschichten bis hin zu religi\u00f6sen oder historischen St\u00fccken, die sehr frei interpretiert werden. \r\nSeit der Gr\u00fcndung des Theaters im Marollenviertel ist nun bereits die 9. Puppenspielergeneration der Toone-Dynastie am Werk. Der jeweils neue Toone (Br\u00fcsseler Kosename f\u00fcr \"Antoine\", so der Vorname des Gr\u00fcnders) muss sowohl von seinem Vorg\u00e4nger als auch von dem Publikum angenommen werden - und so ist es nicht unbedingt der jeweilige Sohn, der die Nachfolge antritt. \r\nDie Klassiker werden in Br\u00fcsseler Mundart und manchmal auch auf Niederl\u00e4ndisch oder Franz\u00f6sisch aufgef\u00fchrt. \r\nDas Th\u00e9\u00e2tre de Toone birgt auch ein urige Schenke und ein Marionettenmuseum.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Th\u00e9\u00e2tre de Toone","address_street_name":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussels","address_line1":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Brussels","description_web":"During the Spanish occupation of the Netherlands all theaters were closed to prevent the actors from raising satirical pieces against the Spanish rulers. As a result, doll shows came into play: it was easier to tolerate the fierce dialogues when pronounced by lifeless dolls. About 1830 Antoine \"Toone\" Genty opened  a puppet theater, then in the Marolles. More than 180 years later, this popular entertainment has grown into a Royal Puppet Theater. After Genty, his (unrelated) successors would also be called Toone (Antoine).\r\nThe classics are performed in the local Brussels dialect with wooden puppets (the so-called poechenel), sometimes in Dutch or in French. The puppet theater and museum has been located near the Grand Place for four decades. The theater is located on the upper floors of the building, on the ground floor there is a pub. The museum contains old dolls, including 19th century specimens.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Teatro di Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"Traditional Brussels\u2019 puppet theater & museum - Typical caf\u00e9\r\nBordering the Impasses Schuddeveld and Sainte-P\u00e9tronille, you will find one of the favourite places of Brussels citizens: Le th\u00e9\u00e2tre de Toone.\r\nTheater Toone is simultaneously a typical estaminet with its Spanish pink brick walls, blackened beams and tiled floor, a puppet theatre in the attic, with its wooden benches, festooned, multicoloured cushions nailed into the raw wood planks and a puppet museum. There, we find the characters who retired from the stage, these Toone heroes of the past and fetish characters of fellow puppeteers from around the world.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Th\u00e9\u00e2tre de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Th\u00e9\u00e2tre de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"Le Th\u00e9\u00e2tre Royal de Toone: un th\u00e9\u00e2tre original et authentique, impr\u00e9gn\u00e9 d\u2019histoire et de culture bruxelloise !\r\nId\u00e9alement situ\u00e9 \u00e0 c\u00f4t\u00e9 de la Grand-Place, dans une maison v\u00e9n\u00e9rable datant de 1696, le Th\u00e9\u00e2tre Royal de Toone poursuit la tradition s\u00e9culaire du th\u00e9\u00e2tre populaire de marionnettes depuis 1830. \r\nLa programmation est bas\u00e9e sur les grands classiques du th\u00e9\u00e2tre tels que \u00ab Les Trois Mousquetaires \u00bb d\u2019apr\u00e8s Alexandre Dumas ou encore \u00ab Rom\u00e9o et Juliette \u00bb d\u2019apr\u00e8s William Shakespeare.\r\nActuellement, le mus\u00e9e permanent de Toone situ\u00e9 au premier \u00e9tage du b\u00e2timent principal se visite gratuitement pendant l\u2019entracte.\r\nL\u2019estaminet folklorique au rez-de-chauss\u00e9e est ouvert tous les jours de 12h00 \u00e0 24h00, sauf le lundi (jour de fermeture).\r\nC\u2019est  un estaminet tricentenaire o\u00f9, dans une ambiance authentique de briques roses espagnoles, poutres noircies et sol dall\u00e9, vous pourrez appr\u00e9cier quelques bi\u00e8res, dont la c\u00e9l\u00e8bre gueuze. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Teatro Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Poppentheater Toone","address_street_name":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussel","address_line1":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Brussel","description_web":"Traditioneel marionettentheater Brusselse folklore - Typisch Staminee.\r\nMuseum van Toone: Gratis toegang voor het publiek tijdens de pauze.\r\nHet Koninklijk Theater Toone in Brussel is een origineel en authentiek poppentheater dat doorspekt is van Brusselse geschiedenis en cultuur! \r\nHet Koninklijk Theater Toone zet sinds 1830 de eeuwenoude traditie van het volkse Theater voort.\r\nDe programmatie is gebaseerd op grote toneelklassiekers zoals \"Cyrano de Bergerac\" van Edmond Rostand, \"De Drie Musketiers\" van Alexandre Dumas, \"Romeo en Julia\" van William Shakespeare en \"Tijl Uilenspiegel\" van Charles De Coster. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":913,"location":{"lat":50.8471135,"lon":4.3536487},"region":"brussels","last_updated_at":"2023-10-24T15:31:21+02:00","published_at":"2013-10-19T01:13:54+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231143,"translations":{"de":{"name":"Marionettentheater - Th\u00e9\u00e2tre de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"W\u00e4hrend der spanischen Besetzung der Niederlande wurden zwangsweise s\u00e4mtliche Theater geschlossen, um Kritik - in Form von satirischen St\u00fccken - an den spanischen Herrschern zu unterbinden. Die Br\u00fcsseler haben alsdann die Schauspieler durch Marionetten (\"Poechenelles\" in Br\u00fcsseler Mun