},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":5},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":9},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":9},{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"}},"value":0},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[321,349,337],"translations":{"fr":["Bande Dessin\u00e9e","Geek & pop culture","Highlight"],"nl":["Stripverhaal","Geek- & popcultuur","Highlight"],"en":["Comic strip","Geek & pop culture","Highlight"]}},"tags":[],"accessibilities":{"list":[252,255,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-30T01:35:59+02:00","published_at":"2022-06-29T14:32:57+02:00","backoffice_id":257315,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.62041419613207},{"id":536818,"date_start":"2022-09-15","date_end":"2022-10-22","date_next":"2022-09-30","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"ADN","shortdescr":"Papaoutai","longdescr":"Chez nous, on pense que 50 000 personnes sont n\u00e9es d\u2019une procr\u00e9ation m\u00e9dicalement assist\u00e9e. Combien parmi elles sont le fruit d\u2019un don de sperme anonyme ? On ne le sait pas. Les principaux int\u00e9ress\u00e9s ignorent souvent tout de leur filiation. Dans cette histoire, le secret est capital. Cette pi\u00e8ce documentaire tente de le lever, en donnant, pour la premi\u00e8re fois, la parole aux enfants.\r\n\r\nMyriam Leroy (prix de la critique 2017 de la meilleure autrice pour Cherche L\u2019amour, autrice de la pi\u00e8ce Les Yeux Rouges) signe ici un texte in\u00e9dit et puissant sur l\u2019identit\u00e9, la filiation et ce qui fait qu\u2019on est ce qu\u2019on est.\r\n\r\n\u00c0 partir de sa propre histoire, elle d\u00e9livre un propos universel et poignant hors des sentiers de l\u2019humour que le TTO emprunte habituellement mais o\u00f9 l\u2019on rit souvent, c\u2019est promis.","performers":"Mise en sc\u00e8ne Nathalie Uffner Assistanat \u00e0 la mise en sc\u00e8ne Aur\u00e9lie Trivillin Avec Julie Duroisin, Emmanuel Dell\u2019Erba, Sandy Duret, Antoine Cogniaux D\u00e9cor sonore Laurent Beumier Sc\u00e9nographie et Costumes Thibaut De Coster, Charly Kleinermann Cr\u00e9ation Lumi\u00e8res Alain Collet Chor\u00e9graphies  Cl\u00e9ment Thirion Illustrations Justin Lalieux Animations Gabriel Balaguera","boxoffice_url":null,"website":"http:\/\/www.ttotheatre.be","email":"info@ttotheatre.be","phone_contact":null,"phone_booking":"+32 2 510 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536818"},"nl":{"name":"ADN","shortdescr":null,"longdescr":null,"perform