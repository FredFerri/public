nd friday: from 13:00 to 19:00","saturday and sunday: from 12:00 to 18:00"],"sp":["monday and tuesday: closed","wednesday, thursday and friday: from 13:00 to 19:00","saturday and sunday: from 12:00 to 18:00"],"pt":["monday and tuesday: closed","wednesday, thursday and friday: from 13:00 to 19:00","saturday and sunday: from 12:00 to 18:00"],"cn":["monday and tuesday: closed","wednesday, thursday and friday: from 13:00 to 19:00","saturday and sunday: from 12:00 to 18:00"]},"date_start":"2023-04-14","date_end":"2023-09-24","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"},"de":{"name":"museumpassmus\u00e9es"},"it":{"name":"museumpassmus\u00e9es"},"sp":{"name":"museumpassmus\u00e9es"},"pt":{"name":"museumpassmus\u00e9es"},"cn":{"name":"museumpassmus\u00e9es"}},"value":0},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"},"de":{"name":"Studierende"},"it":{"name":"Studenti"},"sp":{"name":"Estudiantes"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":5},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"},"de":{"name":"Arbeitsuchende"},"it":{"name":"Disoccupati"},"sp":{"name":"Desempleados"},"pt":{"name":"Demandeurs d'emploi"},"cn":{"name":"Demandeurs d'emploi"}},"value":5},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Anziani"},"sp":{"name":"Mayores"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-04-14","start":"18:00:00","timestamp":"2023-04-14T18:00:00+02:00","is_only_by_appointment":false},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"],"de":["Highlight"],"it":["Highlight"],"sp":["Highlight"],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-24T02:36:15+02:00","published_at":"2022-10-24T16:28:41+02:00","backoffice_id":264635,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.29000493016763},{"id":552585,"date_start":"2023-03-24","date_end":"2023-05-06","date_next":"2023-04-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Jean Pierre M\u00fcller : Sspeechless","shortdescr":null,"longdescr":"Ce qui caract\u00e9rise Jean Pierre M\u00fcller, qui pourtant s\u2019\u00e9crit sans tiret, c\u2019est le trait d\u2019union, dit Bertrand Burgalat. Dans son rapport unique entre la musique et les arts plastiques, avec Aim\u00e9 Mpane, \u00e0 l'AfricaMuseum de Tervuren, ou lors de son travail p\u00e9dagogique \u00e0 La Cambre, il y a dans toute son \u0153uvre une volont\u00e9 de rapprocher litt\u00e9ralement les formes et les \u00eatres. Ses collaborations avec Sean O\u2019Hagan, Nile Rodgers, Archie Shepp, et les peintures sonores de la s\u00e9rie 7x7, en t\u00e9moignent.\" La pratique de Jean Pierre M\u00fcller, bruxellois de naissance, est travers\u00e9e par de multiples univers, celui de la musique, de la mythologie et de la culture urbaine. Pr\u00e9occup\u00e9 essentiellement par l'activit\u00e9 de l'homme, son travail color\u00e9 est tout autant rythm\u00e9 et son esth\u00e9tique se manifeste volontiers dans la surcharge, le d\u00e9bordement et l\u2019accumulation. Certains critiques le rapprochent des peintres fauves braban\u00e7ons. Alors que son \u0153uvre est rarement autobiographique, on d\u00e9tecte cependant, qu'elle s'ouvre aujourd'hui sur un regard infiniment intime, reflet d'un combat qui trouve son origine au plus profond de lui.","performers":"Jean Pierre M\u00fcller","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552585"},"nl":{"name":"Jean Pierre M\u00fcller : Sspeechless","shortdescr":null,"longdescr":"Wat kenmerkt Jean Pierre M\u00fcller, die zonder een streepje geschreven is, is precies het koppelteken. In zijn relatie tussen muziek en kunst, met Aim\u00e9 Mpane, in het AfricaMuseum in Tervueren, of tijdens zijn pedagogische missie in La Cambre, is er in al zijn werk een verlangen om vormen en wezens letterlijk samen te brengen. Zijn samenwerkingen met Sean O'Hagan, Archie Shepp, Nile Rodgers en de geluidsschilderijen van de 7x7-serie getuigen hiervan. De praktijk van Jean Pierre M\u00fcller, geboren in Brussel, wordt doorkruist met meerdere universums, die van muziek, mythologie en \"urban culture\". Eerst in beslag genomen door menselijke activiteit, zijn kleurrijke en ritmische werk manifesteert zich gewillig in de overbelasting, de overloop en accumulatie. Sommige critici brengen hem dichter bij de Brabantse fauvistische schilders. Terwijl zijn werk zelden autobiografisch is, merken we echter op dat het vandaag met een oneindig intiem blik geopend is, een soort weerspiegeling van een strijd die diep in hem ontstaan heeft.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552585"},"en":{"name":"Jean Pierre M\u00fcller : Sspeechless","shortdescr":null,"longdescr":"What characterizes Jean Pierre M\u00fcller, who is written without a hyphen, is precisely the hyphen. In his relationship between music and art with Aim\u00e9 Mpane, in the AfricaMuseum in Tervueren, or during his pedogogical mission in La Cambre, there is in all his work a desire to literally bring together forms and beings. His collaborations with Sean O'hagan, Archie Shepp, Nile Rodgers and the sound paintings of 7x7-series, bear witness to this. Born in Brussels, Jean Pierre M\u00fcller's practice is intersected with multiple universes,those of music, mythology and \"Urban Culture\".Initialy preoccupied with human activity, his colorful and rythmic work willingly manifests itself in overload, overflow and accumulation.Some critics bring him closer to the Brabant Fauvist painters. While his work is rarely auto biographical, we note  however that today it opens with an infinitely intimate gaze, a kind of reflection of a  struggle that has arisen deep within him.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552585"},"de":{"name":"Jean Pierre M\u00fcller","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","emai