/visitors\/agenda\/event-detail.50005306"},"pt":{"name":"Depuis que tu n'as pas tir\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/depuis-que-tu-nas-pas-tire\/?pr=18065&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005306"},"en":{"name":"Depuis que tu n'as pas tir\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/depuis-que-tu-nas-pas-tire\/?pr=18065&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005306"},"it":{"name":"Depuis que tu n'as pas tir\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/depuis-que-tu-nas-pas-tire\/?pr=18065&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005306"},"cn":{"name":"Depuis que tu n'as pas tir\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/depuis-que-tu-nas-pas-tire\/?pr=18065&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005306"},"fr":{"name":"Depuis que tu n'as pas tir\u00e9","shortdescr":"Je bosse dans un resto bobo \u00e0 c\u00f4t\u00e9 du bazar et de ses murs bariol\u00e9s style \u00e9chec et mat alcoolis\u00e9s.\nEn face, des jardins de Babylone et de leur garage en rouille perc\u00e9 de personnages de BD.","longdescr":"Je bosse dans un resto bobo \u00e0 c\u00f4t\u00e9 du bazar et de ses murs bariol\u00e9s style \u00e9chec et mat alcoolis\u00e9s.\nEn face, des jardins de Babylone et de leur garage en rouille perc\u00e9 de personnages de BD.\nComme tous les endroits de la ville qui sont trop tristes pour \u00eatre gais.\nUn coup de pinceau, ou de perceuse et on te reproduit une planche de ton enfance.\nAvec autod\u00e9rision, on te colle Saint-Pierre et Lucifer en train de faire leurs petites affaires en face de l\u2019\u00e9glise des Minimes.\nL\u00e0, c\u2019est Quick et Flupke en train de se faire courser par l\u2019agent 15.\nUne gentille mani\u00e8re de te rappeler qu\u2019ici, t\u2019es dans le quartier des racailles en devenir.\nLa BD dit vrai, mais Quick et Flupke ont bien chang\u00e9. Fini le petit blondinet, il est parti \u00e0 Uccle et porte des gilets, quant \u00e0 Flupke, il est plus noir que son bonnet.\n\nArtiste multidisciplinaire, Marie Darah nous livre une performance po\u00e9tique qui flirte avec les codes du slam, du conte, et du th\u00e9\u00e2tre musical. Un r\u00e9cit urbain parl\u00e9, dans\u00e9, port\u00e9 par la musique live et la cr\u00e9ation sonore originale de Clo\u00e9 du Tr\u00e8fle. Un voyage initiatique qui fait \u00e9merger les in\u00e9galit\u00e9s d\u2019une Bruxelles vacillante.","performers":"Distribution : Une cr\u00e9ation de Marie Darah, Clo\u00e9 du Tr\u00e8fle et Laure Chartier l Texte : Marie Darah ","boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/depuis-que-tu-nas-pas-tire\/?pr=18065&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005306"},"sp":{"name":"Depuis que tu n'as pas tir\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\