,"translations":{}},"tags":[]},{"id":50012648,"date_start":"2024-09-28","date_end":"2024-10-06","date_next":"2024-09-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-07-18T11:37:03+02:00","published_at":"2024-07-18T11:25:14+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":304270,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.4807498567691361,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"Brussels Biennale Neoclassic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012648"},"pt":{"name":"Brussels Biennale Neoclassic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012648"},"en":{"name":"Brussels Biennale Neoclassic","shortdescr":null,"longdescr":"On the traces of neoclassic architecture in Brussels!\n\nThe Neo-Classical style can be found all over Brussels, in grand public buildings and more modest private homes, and in statues, streetscapes and parks and open spaces. They all bear witness to the major changes to the cityscape in the eighteenth and nineteenth centuries. However, in many cases they have been abandoned, neglected and submerged in later developments, so that many of us no longer pay attention to them and have allowed them to fade into the background.\n\nThe Brussels Biennale - Neoclassic (BBN) aims to promote this often forgotten heritage over two weekends, every other year.\n\nAt the heart of the festival is a programme of guided tours of Neo-Classical interiors that are not normally open to the public, offering a unique opportunity to (re)discover some hidden architectural gems of Brussels and to put the Neo-Classical style centre stage.\n\nOther activities will support these guided tours: outdoor walking tours, seminars, events for reduced-mobility participants and school groups, etc.\n\nTwo weekends to gain an insight into an aspect of the city we often miss in our daily lives.\n\nThe third edition of the BBN will take place from 28 September to 6 October 2024.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012648"},"it":{"name":"Brussels Biennale Neoclassic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012648"},"cn":{"name":"Brussels Biennale Neoclassic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012648"},"fr":{"name":"Brussels Biennale Neoclassic","shortdescr":null,"longdescr":"Sur les traces du neo-classicisme bruxellois !\n\nOmnipr\u00e9sent \u00e0 Bruxelles, le n\u00e9oclassicisme, par ses b\u00e2timents de prestige et maisons particuli\u00e8res, sa statuaire publique, son traitement de la voirie, son architecture paysag\u00e8re, ... t\u00e9moigne de la mutation profonde de l'espace urbain aux XVIIIe et XIXe si\u00e8cles. Pourtant, abandonn\u00e9, d\u00e9laiss\u00e9, noy\u00e9 dans notre vie quotidienne, nous n'y faisons plus vraiment attention et il a \u00e9t\u00e9 rel\u00e9gu\u00e9 depuis plusieurs d\u00e9cennies \u00e0 l'arri\u00e8re-plan.\n\nLa Brussels Biennale - Neoclassic (BBN) souhaite mettre ce patrimoine quelque peu oubli\u00e9 \u00e0 l'honneur durant deux week-ends une ann\u00e9e sur deux.\n\nAu c\u0153ur du festival: des visites guid\u00e9es d'int\u00e9rieurs n\u00e9oclassiques habituellement ferm\u00e9s au public; une occasion unique de (re)d\u00e9couvrir des joyaux de notre architecture bruxelloise et de les placer au-devant de la sc\u00e8ne.\n\nD'autres activit\u00e9s compl\u00e8teront la d\u00e9couverte : parcours ext\u00e9rieurs guid\u00e9s, conf\u00e9rences, \u00e9v\u00e9nements , visites PMR, activit\u00e9s pour les \u00e9coles, ...\n\nDeux week-ends pour profiter de la ville de notre quotidien avec un autre regard.\n\nLa troisi\u00e8me \u00e9dition de la BBN aura lieu du 28 septembre au 6 octobre 2024.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012648"},"sp":{"name":"Brussels Biennale Neoclassic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012648"},"nl":{"name":"Brussels Biennale Neoclassic","shortdescr":null,"longdescr":"In de sporen van het Brusselse neoklassicisme!\n\nAls getuige van de ingrijpende verandering die de stedenbouwkundige ruimte in de 18de en 19de eeuw doormaakte is het neoclassicisme alomtegenwoordig in Brussel: prestigieuze gebouwen en huizen, openbare beeldhouwwerken, wegen, parken en landschapsarchitectuur. Doch, verlaten, vergeten en verwaarloosd hebben we geen aandacht meer voor deze stijl die zo prominent deel uitmaakt van ons dagelijkse leven. Al decennia wordt hij naar de achtergrond verdrongen.\n\nDe \"Brussels Bienniale \u2013 Neoclassic\" (BBN) wil dit in de vergetelheid gesukkelde erfgoed weer in de kijker zetten tijdens twee weekends, en dat om de twee jaar.\n\nCentraal tijdens dit festival staan geleide bezoeken aan neoclassicistische interieurs die gewoonlijk niet toegankelijk zijn voor het publiek. Het is een unieke kans om de pareltjes van onze Brusselse architectuur te (her)ontdekken en weer op de voorgrond te plaatsen.\n\nMaar er zijn nog andere activiteiten die deze ontdekkingstocht kleuren, zoals geleide wandelingen, conferenties, bezoeken voor personen met een beperkte mobiliteit en activiteiten voor scholen.\n\nKortom, twee weekends om deze stad eens in een heel ander licht te bewonderen!\n\nDe derde editie van de BBN vindt plaats van 28 september tot en met 6 oktober 2024.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012648"}},"place":{"id":267246,"translations":{"de":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels ist ein Zusammenschluss von Vereinen, die qualitativ hochwertige Stadtf\u00fchrungen in der Region Br\u00fcssel-Hauptstadt organisieren.\r\nDie Mitgliedsvereine sind ARAU, Pro Velo, Brussels Chatterguides und Arkadia. Im Jahr 2020 hat sich La Fonderie als Partnerverein angeschlossen.\r\nEntdecken Sie das UNESCO-Weltkulturerbe, Jugendstilarchitektur, die Bauwerke von Victoria Horta, Gem\u00e4lde von Magritte, Comic-Kunst von Herg\u00e9, Streetart, Europa, Bier, Schokolade oder besichtigen Sie architektonische Perlen des Jugendstils, des Art-d\u00e9co oder des Neoklassizismus, die normalerweise nicht f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich sind. Die F\u00fchrungen werden sowohl f\u00fcr Einzelbesucher als auch f\u00fcr Gruppen angeboten und reichen von klassischen \u00fcber originelle bis hin zu vollkommen neuen Konzepten und Formaten. Neben Stadtf\u00fchrungen zu Fu\u00df sind auch Besichtigungen per Fahrrad, Bus oder Boot m\u00f6glich.\r\nExplore.Brussels organisiert unter anderem auch das Jugendstil- und Art-d\u00e9co-Festival BANAD, die Brussels Biennale - Neoclassic (BBN) sowie weitere Projekte, darunter die Ausbildung von Stadtf\u00fchrern, der \u201eVerein der Freunde\u201c und der \u201eVerein der Eigent\u00fcmer\u201c. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of guided tour associations in Brussels. This organisation includes ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie and Korei. Events are organised in co-production with these 6 companies. Individual or group tours are available on foot, by bike, by bus and by boat.  Visitors discover UNESCO heritage, Magritte, art deco, chocolate and much more. Explore.Brussels also organises Brussels festivals and other large-scale projects.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels est un r\u00e9seau d'associations de visites guid\u00e9es \u00e0 Bruxelles. Cet organisme regroupe notamment ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie et Korei. les \u00e9v\u00e9nements sont organis\u00e9s en coproduction avec ces 6 entreprises  Les visites individuelles ou en groupe sont disponibles \u00e0 pied, \u00e0 v\u00e9lo, en car et en bateau.  Les visiteurs partent \u00e0 la d\u00e9couverte du patrimoine de l'UNESCO, de Magritte, de l'art d\u00e9co, du chocolat et bien plus encore. Explore.Brussels organise \u00e9galement des festivals bruxellois et d'autres projets de grande envergure.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Explore.brussels ","address_street_name":"Brugmannlaan","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Brugmannlaan, 405","address_line2":"1180 Ukkel","description_web":"Explore.Brussels is een netwerk van verenigingen voor geleide bezoeken in Brussel. Deze organisatie omvat ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie en Korei. De evenementen worden georganiseerd in coproductie met deze 6 bedrijven. Individuele of groepstochten zijn mogelijk te voet, per fiets, per bus en per boot.  Bezoekers ontdekken UNESCO erfgoed, Magritte, art deco, chocolade en nog veel meer. Explore.Brussels organiseert ook Brusselse festivals en andere grootschalige projecten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":27246,"location":{"lat":50.80795462,"lon":4.34397082},"region":"brussels","last_updated_at":"2024-05-29T15:24:29+02:00","published_at":"2017-02-27T10:05:49+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":240214,"translations":{"de":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.Brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of associations that organize top-quality guided tours in the Brussels-Capital Region. \r\nIts membre associations are ARAU, Pro Velo, Brussels Chatterguides and Arkadia. La Fonderie (in 2020) & Korei (in 2021) joined the network as a partner association.\r\n\r\nDiscover UNESCO\u2019s heritage, Art nouveau, Victoria Horta, Magritte, Herg\u00e9, Street art, Europe, beer, chocolate, or visit buildings built in Art Nouveau, Art Deco or neoclassical style that are usually closed for public visits. Tours are available for individual visitors and groups, and organized in a classical, exceptional or completely new way. Besides walking tours, visits can be organized by bike, bus or boat.\r\n\r\nExplore.Brussels organizes the Brussels Art Nouveau & Art Deco (BANAD) Festival and Brussels Biennale \u2013 Neoclassic (BBN), Brussels Biennale of Eclectic Architecture (BBEA) as well as other projects such as the visits of Art Nouveau Mansions, the formation of tour guides, the owners club and the friends club. ","description_print":null,"booking_url":null,"sort_order":