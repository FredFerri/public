:"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007366"},"pt":{"name":"J\u00e9rusalem","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/piece-de-theatre-jerusalem\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007366"},"en":{"name":"J\u00e9rusalem","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/piece-de-theatre-jerusalem\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007366"},"it":{"name":"J\u00e9rusalem","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/piece-de-theatre-jerusalem\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007366"},"cn":{"name":"J\u00e9rusalem","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/piece-de-theatre-jerusalem\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007366"},"fr":{"name":"J\u00e9rusalem","shortdescr":"\u00ab J\u00e9rusalem \u00bb, pi\u00e8ce de th\u00e9\u00e2tre \u00e9crite et mise en sc\u00e8ne par Isma\u00ebl Saidi, nous fait voyager du ghetto de Varsovie, en Pologne, \u00e0 la guerre entre les juifs et les arabes au Proche-Orient, en passant par le camp d\u2019extermination de Treblinka et les r\u00e9voltes arabes de Tib\u00e9riade.","longdescr":"Par les voix de Delphine et Shahid, comme celles de Ruth et Alqodsi, leurs a\u00efeux, nous d\u00e9couvrons les douleurs en miroir d\u2019un m\u00eame peuple devenu deux entit\u00e9s, d\u00e9sormais ennemies : les juifs et les arabes. L\u2019\u00e9motion nous \u00e9treint en \u00e9coutant Ruth et Alqodsi raconter leurs souffrances, oubli\u00e9es et tues sous le poids de la peur. Et l\u2019\u00e9criture fine et humoristique d\u2019Isma\u00ebl Saidi nous attrape alors pour \u00e9vacuer ces douleurs par le rire et l\u2019humour. Traitant de diff\u00e9rences et pourtant de ressemblances, de peurs et n\u00e9anmoins de courage,\n\n\u00ab J\u00e9rusalem \u00bb s\u2019inscrit comme une \u0153uvre phare dans le dialogue et la rencontre avec l\u2019autre. Empli d\u2019humanit\u00e9 et de lumi\u00e8re malgr\u00e9 les souffrances endur\u00e9es, ce spectacle est un trait d\u2019union entre les hommes et les femmes.","performers":"Texte et mise en sc\u00e8ne : Isma\u00ebl Saidi\nCom\u00e9diens : In\u00e8s Weill-Rochant et Isma\u00ebl Saidi\nLumi\u00e8re : S\u00e9bastien Roman\nSon : Alexandre Barthelemy\n\nDur\u00e9e : 1h15","boxoffice_url":null,"website":"https:\/\/cclj.be\/piece-de-theatre-jerusalem\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007366"},"sp":{"name":"J\u00e9rusalem","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/piece-de-theatre-jerusalem\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007366"},"nl":{"name":"J\u00e9rusalem","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/piece-de-theatre-jerusalem\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007366"}},"place":{"id":241622,"translations":{"de":{"name":"Centre Communautaire La\u00efc Juif David Susskind","address_street_name":"Rue H\u00f4tel des Monnaies","address_stre