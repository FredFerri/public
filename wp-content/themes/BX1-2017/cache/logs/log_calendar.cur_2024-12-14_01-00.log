y":"Brussel","address_line1":"Handelsstraat, 51","address_line2":"1000 Brussel","description_web":"Zegt de naam Marcel Hastir je wat? Hij was een Belgisch kunstschilder, theosoof en verzetsstrijder. Van 1935 tot aan zijn dood 76 jaar later woonde hij in de Handelsstraat in de Brusselse Leopoldwijk. Je kan er zijn doeken nog steeds bewonderen terwijl je geniet van klassieke muziek of theater. Al decennialang komen op deze bijzondere plek grote namen uit de muziekwereld over de vloer. De intieme en magische sfeer zal je niet onberoerd laten.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":"AtelierMarcelHastir","backoffice_id":4704,"location":{"lat":50.8420134,"lon":4.3685574},"region":"brussels","last_updated_at":"2024-10-24T10:12:29+02:00","published_at":"2013-10-19T01:17:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":242272,"translations":{"de":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":"Das Atelier Marcel Hastir ist ein Ort der Kunst, der kulturellen und k\u00fcnstlerischen Begegnungen, der 1935 von dem Maler Marcel Hastir in seinem K\u00fcnstleratelier in der Rue du Commerce 51 ein