"date_end":"2022-05-29","date_next":"2022-05-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[55],"translations":{"fr":["Th\u00e9\u00e2tre de marionnettes"],"nl":["Poppentheater"],"en":["Puppet show"]}}},"languages":{"spoken":["it","fr"],"subtitles":[]},"translations":{"fr":{"name":"Pinocchio","shortdescr":"Pinocchio, morceau de bois? Marionnette de bois? Morceau de carton ici. Avec toute la po\u00e9sie d'un th\u00e9\u00e2tre de papier ou du th\u00e9\u00e2tre pauvre, Maurizio Gioco revisite le mythe de la marionnette.  Accompagn\u00e9 d'un musicien qui joue du bandon\u00e9on.","longdescr":"Spectacle en Italien et en Fran\u00e7ais \u00e0 partir de 4-5 ans. \r\nDans le cadre du JEM festival de marionnettes au Peruchet","performers":"Maurizio Gioco et le Teatro Giochetta di Verona (Italie)","boxoffice_url":null,"website":"https:\/\/theatreperuchet.be\/home\/festival-2022\/","email":"info@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533889.html"},"nl":{"name":"Pinocchio","shortdescr":"Pinokkio, stuk hout? Houten marionet? Kartonnen marionet hier. Maurizio Gioco herneemt de mythe van de marionet met alle po\u00ebzie van een papieren theater of een armzalig theater. Begeleid door een muzikant die de bandoneon bespeelt.","longdescr":"Voorstelling in het Italiaans en Frans van 4-5 jaar oud. \r\nAls onderdeel van het YWAM poppenfestival in Peruchet","performers":"Maurizio Gioco en il teatro Giochetta di Verona (Itali\u00ebn)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533889.html"},"en":{"name":"Pinocchio","shortdescr":"Pinocchio, piece of wood? Wooden puppet? Cardboard puppet here. Maurizio Gioco revisits the myth of the puppet with all the poetry of a paper theatre or poor theatre. Accompanied by a musician who plays the bandoneon.","longdescr":"Show in Italian and French from 4-5 years old. \r\nAs part of the JEM puppet festival in Peruchet","performers":"Maurizio Gioco and Teatro di Giochetta di Verona (Italy)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533889.html"},"de":{"name":"Pinocchio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533889.html"},"it":{"name":"Pinocchio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533889.html"},"sp":{"name":"Pinocchio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533889.html"},"pt":{"name":"Pinocchio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533889.html"},"cn":{"name":"Pinocchio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533889.html"}},"place":{"id":241472,"translations":{"fr":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":"Fond\u00e9 en 1929 par Carlo Speder, le P\u00e9ruchet est un th\u00e9\u00e2tre de marionnettes \u00e0 fils qui propose un r\u00e9pertoire unique de contes traditionnels (Andersen, les fr\u00e8res Grimm, Charles Perrault, Daudet, Lafontaine, Kipling, Hoffman...) pour les petits et les grands enfants. Il est situ\u00e9 \u00e0 Ixelles depuis 1968, dans une fermette du 19\u00e8me si\u00e8cle. La l\u00e9gende raconte qu'elle aurait abrit\u00e9 Charles Decoster, l'auteur de Till Ulenspiegel. En 1983, le th\u00e9\u00e2tre s'est dot\u00e9 d'un lieu pour son Mus\u00e9e International de la Marionnette (fond\u00e9 en 1938 et accessible au public jusqu'en 1968), qui poss\u00e8de une collection des plus vari\u00e9es et des plus riches parmi les Mus\u00e9es europ\u00e9ens de la Marionnette. Les spectacles s'adressent aux enfants \u00e0 partir de 3 ans et vous pouvez visiter le mus\u00e9e pendant l'entracte des spectacles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Woudlaan","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Woudlaan, 50","address_line2":"1050 Elsene","description_web":"Het marionettentheater werd in 1929 opgericht in Brussel door Carlo Speder. Le P\u00e9ruchet speelt een uniek repertoire van traditionele sprookjes (Andersen, de gebroeders Grimm, Charles Perrault, Daudet, Lafontaine, Kipling, Hoffman...) voor kinderen... en voor hen die hun kinderhart hebben weten te bewaren. Het theater is sinds 1968 gevestigd in de gemeente Elsene, in een 19e-eeuwse boerderij waar volgens de legende Charles Decoster heeft gewoond (de schrijver van Tijl Ulenspiegel!). In 1983 vond het theater P\u00e9ruchet de middelen om zijn internationaal poppenmuseum in te richten, een van de rijkste en meest gevarieerde collecties in Europa. Je kan het museum bezoeken tijdens de pauzes van de voorstellingen. De voorstellingen zijn geschikt voor kinderen vanaf 3 jaar. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50",