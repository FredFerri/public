 Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"MAD \u2013 Home of Creators","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":12629,"location":{"lat":50.85116098,"lon":4.34417688},"region":"brussels","last_updated_at":"2022-10-24T01:36:57+02:00","published_at":"2013-10-19T01:34:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/fa8c5bda7cda0d3a829c0434df5d7507f20f49db.jpg","width":3750,"height":2500,"ratio":1.5,"translations":{"fr":{"title":"Graduation Show","copyright":"Maxime Trassebot \u2014 Photography by Th\u00e9o Desmaizi\u00e8res"},"nl":{"title":"Graduation Show","copyright":"Maxime Trassebot \u2014 Photography by Th\u00e9o Desmaizi\u00e8res"},"en":{"title":"Graduation Show","copyright":"Maxime Trassebot \u2014 Photography by Th\u00e9o Desmaizi\u00e8res"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/132fe36b35a51fb5eabbac3590888d8730db9cbf.png","width":1008,"height":1516,"ratio":0.66,"translations":{"fr":{"title"