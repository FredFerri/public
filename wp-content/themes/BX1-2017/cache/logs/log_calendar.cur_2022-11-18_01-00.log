oldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"\u2018La Catalogne avec l\u2019Europe : 1982 - 2022\u2019","shortdescr":"Exposition \u2018La Catalogne avec l\u2019Europe : 1982 - 2022\u2019 organis\u00e9e pour la D\u00e9l\u00e9gation du Gouvernement de la Catalogne aupr\u00e8s de l'Union europ\u00e9enne et le Palau Robert pour f\u00eater les 40 ans de pr\u00e9sence catalane \u00e0 Bruxelles.","longdescr":"L\u2019Espai Catalunya Europa, de la D\u00e9l\u00e9gation du Gouvernement de la Catalogne, accueille l\u2019exposition \u2018La Catalogne avec l\u2019Europe : 1982 \u2013 2022\u2019. L\u2019exposition a \u00e9t\u00e9 organis\u00e9e par le Palau Robert et la D\u00e9l\u00e9gation du Gouvernement pour f\u00eater les 40 ans de pr\u00e9sence catalane \u00e0 Bruxelles.\r\n\r\n\u2018La Catalogne avec l\u2019Europe : 1982 \u2013 2022\u2019  montre le long parcours proeurop\u00e9en de la Catalogne. L\u2019exposition commence en 1982 lorsque le Gouvernement de la Catalogne, pr\u00e9sid\u00e9 par le pr\u00e9sident Jordi Pujol, cr\u00e9e le Patronat Catal\u00e0 Pro Europa, un consortium pour promouvoir et coordonner les activit\u00e9s d\u2019information sur l\u2019Union Europ\u00e9enne. Le Patronat est l\u2019embryon de l\u2019actuelle D\u00e9l\u00e9gation, cr\u00e9\u00e9e en 2006 par le Gouvernement de la Catalogne alors pr\u00e9sid\u00e9 par le pr\u00e9sident Pasqual Maragall.\r\n\r\nPour plus d\u2019informations, veuillez contacter la D\u00e9l\u00e9gation \u00e0 l\u2019addresse : events_eu@gencat.cat.","performers":null,"boxoffice_url":null,"website":"http:\/\/eu.gencat.cat","email":"eu@gencat.cat","phone_contact":"+32 2 231 03 30","phone_booking":"+32 2 231 03 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541159"},"nl":{"name":"\u2018La Catalogne avec l\u2019Europe : 1982 - 2022\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541159"},"en":{"name":"'Catalonia with Europe: 1982-2022\u2019","shortdescr":"Exhibition 'Catalonia with Europe: 1982-2022' organised by the Delegation of the Government of Catalonia to the EU and the Palau Robert to mark Catalonia's 40 years of presence in Brussels.","longdescr":"The Espai Catalunya Europa of the Delegation of the Government of Catalonia hosts the exhibition 'Catalonia with Europe: 1982-2022'. The exhibition has been organised by the Palau Robert and the Delegation of the Government to mark Catalonia's 40 years of presence in Brussels. \r\n\r\n\u2018Catalonia with Europe: 1982-2022\u2019 shows Catalonia's long-standing Europeanist trajectory in Brussels. The exhibition begins in 1982 when the Government of Catalonia headed by President Jordi Pujol created the Patronat Catal\u00e0 Pro Europa, a consortium that promoted information activities about the EU. The Patronat is the embryo of the Delegation of the Government of Catalonia to the EU that the Catalan Government led by President Pasqual Maragall created in 2006.\r\n\r\nThe content of the exhibition is available in Catalan, English, French, and Dutch.\r\n\r\nFor more information, please contact events_eu@gencat.cat.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541159"},"de":{"name":"Exposition \u2018La Catalunya avec l\u2019Europe : 1982 - 2022\u2019","shortdescr":nul