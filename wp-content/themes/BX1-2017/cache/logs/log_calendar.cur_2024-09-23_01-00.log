king":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000860"},"it":{"name":"RDV Facettes \u2013 Exposition textur\u00e9e: Habiter","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-facettes-exposition-texturee-habiter\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000860"},"cn":{"name":"RDV Facettes \u2013 Exposition textur\u00e9e: Habiter","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-facettes-exposition-texturee-habiter\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000860"},"fr":{"name":"RDV Facettes \u2013 Exposition textur\u00e9e: Habiter","shortdescr":"La Villa a accueilli cet \u00e9t\u00e9 trois artistes textiles en r\u00e9sidence : Amandine David, Louise Danhaive et Kemy Obafemi. L\u2019exposition vous propose de d\u00e9couvrir leurs r\u00e9alisations entre patchwork, broderie et tissage !","longdescr":"La Villa a accueilli cet \u00e9t\u00e9 trois artistes textiles en r\u00e9sidence : Amandine David, Louise Danhaive et Kemy Obafemi. L\u2019exposition vous propose de d\u00e9couvrir leurs r\u00e9alisations entre patchwork, broderie et tissage !\n\nAmandine David est une designer et chercheuse qui d\u00e9veloppe une pratique m\u00ealant savoir-faire traditionnels et fabrication digitale. \n\nLouise Danhaive est architecte et urbaniste de formation mais c\u2019est \u00e0 travers l\u2019utilisation du textile qu\u2019elle cartographie les relations humains-animaux. \n\nKemy Obafemi est une artiste tout juste dipl\u00f4m\u00e9e de l\u2019Acad\u00e9mie des Beaux-arts de Bruxelles. La r\u00e9cup\u00e9ration de linge de maison est au centre de ses recherches plastiques, un h\u00e9ritage familial qu\u2019elle a d\u00e9cid\u00e9 de rendre commun et public.\n\nKemy Obafemi, vous propose de vous initier au patchwork le samedi 21 septembre de 14h \u00e0 17h de sur le th\u00e8me \u00ab des images : souvenirs de chez soi \u00bb, vous pourrez alors repartir avec votre petit format textur\u00e9 ! Atelier : A partir de 15 ans\n\nAvec le soutien de la F\u00e9d\u00e9ration Wallonie \u2013 Bruxelles","performers":"Amandine Petit, Louise Danhaive et Kemy Obafemi","boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-facettes-exposition-texturee-habiter\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000860"},"sp":{"name":"RDV Facettes \u2013 Exposition textur\u00e9e: Habiter","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-facettes-exposition-texturee-habiter\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000860"},"nl":{"name":"RDV Facettes \u2013 Exposition textur\u00e9e: Habiter","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/rdv-facettes-exposition-texturee-habiter\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000860"}},"place":{"id":220064,"translations":{"de":{"name":"Centre Culturel Ganshoren La Villa","address_street_name":"Place Guido Gezelle","address_street_number":"26","address_street_box":null,"email":"info@lavillaculture.be","website":"http:\/\/www.lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":null,"address_