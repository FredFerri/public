l"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50001734,"date_start":"2023-09-14","date_end":"2023-10-01","date_next":"2023-09-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T08:45:04+02:00","published_at":"2023-09-04T08:36:18+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284630,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.4807498567691361,"languages":{"spoken":["hu","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"EXHIBITION \u00b7 B\u00daCS\u00da, a farewell to Hungarian summer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/12NlZfEZi","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001734"},"pt":{"name":"EXHIBITION \u00b7 B\u00daCS\u00da, a farewell to Hungarian summer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/12NlZfEZi","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001734"},"en":{"name":"B\u00daCS\u00da, a farewell to Hungarian summer","shortdescr":"On 14th of September, the MedexMuseum reopens its doors with an exhibition mixing feelings about \"homeland\" while tackling the politics of nostalgia that spread from Hungary to other European countries. ","longdescr":"It\u2019s September and we are back in Brussels, quite abruptly saying goodbye to summer vibes. Is nostalgia invading the Ephemeral Museum of Exile? A sense of spleen with past moments of joy, or is it something else? A distorted memory of what we thought was our best summers ?\n\nFor the occasion, the photograph L\u00e9a Fiterman will exhibit a series of pictures expressing her discomfort during her stays in Hungary, at Lake Balaton, between nostalgia, good times of yesterday and today and then the more difficult side of current Hungary.\n\nExhibition opening on Thursday 14th September (18:00 - 22:00)\nFree entrance \n\n\nThis exhibition was co-created by the team of MedexMuseum and members of the Hungarian community who participated in regular cultural mediation meetings. In September, a number of events will invite you to discover more of the Hungarian culture and subcultures, its cultural diversity that deserve to be celebrated.\n\nMore info on the event page : https:\/\/fb.me\/e\/12NlZfEZi ","performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/12NlZfEZi","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001734"},"it":{"name":"EXHIBITION \u00b7 B\u00daCS\u00da, a farewell to Hungarian summer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/12NlZfEZi","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001734"},"cn":{"name":"EXHIBITION \u00b7 B\u00daCS\u00da, a farewell to Hungarian summer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/12NlZfEZi","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001734"},"fr":{"name":"B\u00daCS\u00da, adieu \u00e0 l'\u00e9t\u00e9 hongrois","shortdescr":"Le 14 septembre, le MedexMuseum r\u00e9-ouvre ses portes avec une exposition qui m\u00e9lange les sentiments que l'on \u00e9prouve pour sa \"patrie\" tout en s'attaquant frontalement aux politiques de la nostalgie qui essaiment depuis la Hongrie \u00e0 d'autres pays europ\u00e9ens. ","longdescr":"L'\u00e9t\u00e9 est derri\u00e8re nous, et un sentiment de nostalgie envahit le Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil. Est-ce la m\u00e9lancolie de ces moments de joie pass\u00e9es ... ou autre chose ? Un souvenir lointain et d\u00e9form\u00e9 de ce que l'on pensait \u00eatre nos meilleures ann\u00e9es? \n\nPour l'occasion, la photographe L\u00e9a Fiterman exposera une s\u00e9rie de photos exprimant son incomfort pendant ses vacances en Hongrie, sur les bords du Lac Balaton. Entre nostalgie des bons moments pass\u00e9s hier et aujourd'hui et le revers plus difficile de la vie actuelle en Hongrie. \n\nCette exposition a \u00e9t\u00e9 co-cr\u00e9\u00e9e par l'\u00e9quipe du MedexMuseum et de jeunes Hongrois\u00b7e\u00b7s ayant particip\u00e9 \u00e0 des rencontres de m\u00e9diation culturelle. En septembre, une s\u00e9rie d'\u00e9v\u00e8nements vous invitera \u00e0 d\u00e9couvrir les culture et sous-cultures hongroises, dont la diversit\u00e9 m\u00e9rite d'\u00eatre c\u00e9l\u00e9br\u00e9e. \n\nVernissage le jeudi 14 septembre (18:00 - 22:00) \u00b7 entr\u00e9e gratuite  \n\nPlus d'infos sur la page de l'\u00e9v\u00e8nement : https:\/\/fb.me\/e\/12NlZfEZi \n\n","performers":"MedexMuseum ; L\u00e9a Fiterman (photo)","boxoffice_url":null,"website":"https:\/\/fb.me\/e\/12NlZfEZi","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001734"},"sp":{"name":"EXHIBITION \u00b7 B\u00daCS\u00da, a farewell to Hungarian summer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/12NlZfEZi","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001734"},"nl":{"name":"B\u00daCS\u00da, a farewell to Hungarian summer","shortdescr":null,"longdescr":"It\u2019s September and we are back in Brussels, quite abruptly saying goodbye to summer vibes. Is nostalgia invading the Ephemeral Museum of Exile? A sense of spleen with past moments of joy, or is it something else? A distorted memory of what we thought was our best summers ?\n\nMore info on the event page : https:\/\/fb.me\/e\/12NlZfEZi \n\nFor the occasion, the photograph L\u00e9a Fiterman will exhibit a series of pictures expressing her discomfort during her stays in Hungary, at Lake Balaton, between nostalgia, good times of yesterday and today and then the more difficult side of current Hungary.\n\nExhibition opening on Thursday 14th September (18:00 - 22:00)\nFree entrance \n\n\nThis exhibition was co-created by the team of MedexMuseum and members of the Hungarian community who participated in regular cultural mediation meetings. In September, a number of events will invite you to discover more of the Hungarian culture and subcultures, its cultural diversity that deserve to be celebrated.","performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/12NlZfEZi","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001734"}},"place":{"id":265418,"transl