:null,"website":"https:\/\/lejacquesfranck.be\/event\/informations\/2024-01-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003973"},"en":{"name":"Z&T : Beat\u2019ume","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/informations\/2024-01-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003973"},"it":{"name":"Z&T : Beat\u2019ume","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/informations\/2024-01-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003973"},"cn":{"name":"Z&T : Beat\u2019ume","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/informations\/2024-01-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003973"},"fr":{"name":"Z&T Beat\u2019ume + Ruthless","shortdescr":"Z&T se r\u00e9approprient le Mic dans une verve jouissive et un flow cisel\u00e9. Z&T, deux parmi mille, une g\u00e9n\u00e9ration de meufs qui s'associent, s\u2019interrogent, encaissent mais rendent les coups au Mic, ramassent mais n\u2019en font pas un drame.","longdescr":"Beat\u2019ume est un voyage au sein de l\u2019urbain par deux jeunes femmes en qu\u00eate de sens. Dans une forme m\u00ealant Slam, th\u00e9\u00e2tralit\u00e9, musique Hip-Hop et Rap, Beat\u2019ume nous confronte \u00e0 deux jeunes femmes qui errent dans les rues de la ville et d\u00e9noncent \u00e0 coups de punchlines, sillonnant les milieux, bousculant les codes. Deux voix tr\u00e8s immerg\u00e9es dans le parler urbain : un parler imag\u00e9, dr\u00f4le, \"cash\", cynique, qui remue, entrecoup\u00e9 de fulgurances po\u00e9tiques.\n\nEn premi\u00e8re partie, Familly Ties une performance de Ruthless. Ruthless est un collectif exclusivement f\u00e9minin qui a vu le jour en septembre 2022 \u00e0 l'initiative d'Hendrick Ntela et de Roxane Hardy. Ce groupe dynamique r\u00e9unit des danseuses passionn\u00e9es issues du mouvement krump et hip-hop. Fort d'une quinzaine de membres, majoritairement bas\u00e9es \u00e0 Li\u00e8ge et \u00e0 Bruxelles, Ruthless incarne la puissance et l'authenticit\u00e9 f\u00e9minine \u00e0 travers les rythmes et les mouvements captivants des danses street.","performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/informations\/2024-01-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003973"},"sp":{"name":"Z&T : Beat\u2019ume","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/informations\/2024-01-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003973"},"nl":{"name":"Z&T : Beat\u2019ume","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/informations\/2024-01-26\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003973"}},"place":{"id":4,"translations":{"de":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","a