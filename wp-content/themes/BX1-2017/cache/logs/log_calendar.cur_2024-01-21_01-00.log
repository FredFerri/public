2 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006093"},"it":{"name":"Exposition \"Ne meurent que ceux que l'on oublie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006093"},"cn":{"name":"Exposition \"Ne meurent que ceux que l'on oublie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006093"},"fr":{"name":"Ne meurent que ceux que l'on oublie","shortdescr":"\u201cNe meurent que ceux que l\u2019on oublie\u201d est une exposition m\u00e9morielle sur la rafle du Pensionnat Gatti de Gamond. Elle a \u00e9t\u00e9 r\u00e9alis\u00e9e \u00e0 l\u2019initiative de Guy Marchand, avec le soutien de Fr\u00e9d\u00e9ric Dambreville, auteur du livre \"Les disparus de Gatti de Gamond\", et avec la participation active des \u00e9l\u00e8ves de Molenbeek-Saint-Jean et de leurs enseignants. \n","longdescr":"Le 12 juin 1943, 14 enfants et plusieurs adultes juifs ainsi qu\u2019Odile Henri-Ovart, directrice du Pensionnat, son mari et leur fille, furent arr\u00eat\u00e9s par la Gestapo suite \u00e0 une d\u00e9nonciation. La plupart d\u2019entre eux seront d\u00e9port\u00e9s et assassin\u00e9s \u00e0 Auschwitz-Birkenau. Parmi les personnes d\u00e9port\u00e9es, H\u00e9l\u00e8ne Gancarska (18 ans au moment de la rafle) et Fajga Warman sont les seules survivantes.\n\nVisite gratuite avec inscription obligatoire.\n\nVous \u00eates enseignant.e et vous voulez aborder cette histoire encore trop peu connue avec vos \u00e9l\u00e8ves?\nNous vous proposons une offre p\u00e9dagogique, et gratuite, \u00e0 destination des \u00e9l\u00e8ves de 5e et 6e primaire et de secondaire. Sur rendez-vous.","performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006093"},"sp":{"name":"Exposition \"Ne meurent que ceux que l'on oublie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006093"},"nl":{"name":"Ne meurent que ceux que l'on oublie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006093"}},"place":{"id":229360,"translations":{"de":{"name":"CCLJ","address_street_name":"Rue H\u00f4tel des Monnaies","address_street_number":"52","address_street_box":null,"email":"info@cclj.be","website":"http:\/\/www.cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue H\u00f4tel des Monnaies, 52","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"CCLJ","address_street_name":"Rue H\u00f4tel des Monnaies","address_street_number":"52","address_street_box":null,"email":"info@cclj.be","website":"http:\/\/www.cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"address_zip":"1