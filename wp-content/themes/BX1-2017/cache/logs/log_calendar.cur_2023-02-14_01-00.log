,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{"list":[95],"translations":{"fr":["Patrimoine"],"nl":["Erfgoed"],"en":["Heritage"],"de":["Kulturerbe"],"it":["Patrimonio culturale"],"sp":["Patrimonio"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":"TAI CHI  \r\nDiscipline corporelle et spirituelle","longdescr":"REDEMARRAGE TAI CHI\r\nLe Tai Chi est \u00e0 l\u2019origine un art martial chinois souvent pratiqu\u00e9 comme discipline corporelle et spirituelle utilisant l'\u00e9nergie Chi. Les mouvements lents et fluides sont ex\u00e9cut\u00e9s dans un ordre pr\u00e9cis. Le Tai Chi d\u00e9tend les muscles et les articulations, assure une meilleure circulation sanguine et un m\u00e9tabolisme plus efficient et rend plus r\u00e9sistant au stress.\u00a0\r\n\r\nTenue\u00a0: v\u00eatements amples, chaussures souples ou pantoufles.\r\n\r\nDates :\r\nles vendredis de 10h \u00e0 11h30\r\n13-20-27.01.2023\r\n3-10-17.02.2023\r\n10-17-24-31.03.2023\r\n\r\nPossibilit\u00e9 de participer \u00e0\u00a0une session gratuite sur r\u00e9servation aupr\u00e8s de\u00a0:\r\nFemigra vzw asbl\r\nDiliara 0478\/13 94 39 ou femigrada@gmail.com\r\nInformations sur le prix \u00e9galement aupr\u00e8s de l'accompagnateur.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 478 13 94 39","phone_booking":"+32 478 13 94 39","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547625"},"nl":{"name":"TAI CHI - Beweging in Museum","shortdescr":"TAI CHI  \r\nInnerlijke bewegingskunst","longdescr":"HEROPSTART\u00a0 TAI CHI\u00a0\r\nTai Chi is een van oorsprong Chinese vechtkunst vaak beoefend als innerlijke bewegingskunst opgebouwd rond de energie Chi. Traag vloeiende bewegingen worden in patronen uitgevoerd. Tai chi ontspant de spieren en gewrichten, zorgt voor een betere bloedcirculatie en effici\u00ebntere stofwisseling en maakt stressbestendiger.\r\n\r\nOutfit\u00a0: Losse kleding, zachte schoenen of pantoffels.\r\n\r\nDatums\u00a0:\r\nop vrijdagen van 10u tot 11u30\r\n13-20-27.01.2023\r\n3-10-17.02.2023\r\n10-17-24-31.03.2023\r\n\r\nMogelijkheid om deel te nemen aan een gratis sessie op reservatie bij\u00a0:\r\nFemigra vzw asbl\r\nDiliara 0478\/13 94 39 of femigrada@gmail.com\r\nInlichtingen over de prijs ook bij de begeleider.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 478 13 94 39","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547625"},"en":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547625"},"de":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547625"},"it":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547625"},"sp":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547625"},"pt":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547625"},"cn":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547625"}},"place":{"id":753,"translations":{"fr":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le mus\u00e9e, inaugur\u00e9 en 1928, est comme un tableau d\u2019\u00e9poque\u2026 on se retrouve au temps de La Libre Esth\u00e9tique et du Groupe des 20. Les collections sont expos\u00e9es dans les salons, riches en mobilier et objets d\u2019art d\u00e9coratifs d\u2019\u00e9poque Louis XV, Louis XVI et Empire.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Charliermuseum","address_street_name":"Kunstlaan","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Kunstlaan, 16","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"Het museum, geopend in 1928, is gevestigd in het prive-herenhuis van de beeldhouwer Guillaume Charlier, dat dateert uit de 19e eeuw. Het richt zich op de Belgische schilderkunst van eind 19e tot begin 20e eeuw. De collecties worden getoond in de salons, rijkelijk voorzien van decoratieve stukken uit de Louis XV, Louis XVI en Empire periodes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Charlier Museum","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The museum is based in the private mansion, dating from the 19th century, of the sculptor Guillaume Charlier. It focuses on Belgian painting from the late 19th to the early 20th century. Its art exhibitions take place in a setting of lavish furnishings, with numerous decorative pieces from the Louis XV, Louis XVI, and Empire periods.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Das 1928 eingeweihte Museum ist wie ein Gem\u00e4lde der Epoche... man findet sich in der Zeit der La Libre Est\u00e9tique und der Groupe des 20 wieder. Die Sammlungen werden in den reich mit Mobiliar und historischen Dekorationsgegenst\u00e4nden (Louis XV, Louis XV und Empire) best\u00fcckten Salons ausgestellt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"El Museo Charlier, una mansi\u00f3n del siglo XIX obra de Horta durante sus a\u00f1os de juventud, te sumergir\u00e1 en la atm\u00f3sfera de un lujoso sal\u00f3n de arte: la Belle Epoque te invita a so\u00f1ar, a pasear entre las esculturas de Charlier, Hager y Wouters, las pinturas de Smits, Fr\u00e9d\u00e9ric, Oleffe, Laermans, Van Strydonck, Ensor... Este ambiente \u00edntimo se completa con los muebles de los ebanistas Chapuis, Sen\u00e9, Nadal l'A\u00een\u00e9, numerosos objetos de arte decorativo de estilos Luis XIV, XV, XVI y estilo Imperio, tapices de Bruselas y Audenaerde, as\u00ed como excepcionales un excepcional sal\u00f3n chino. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":n