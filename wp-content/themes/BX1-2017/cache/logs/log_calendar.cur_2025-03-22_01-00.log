,"address_line1":"Brugmannlaan, 405","address_line2":"1180 Ukkel","description_web":"Explore.Brussels is een netwerk van verenigingen voor geleide bezoeken in Brussel. Deze organisatie omvat ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie en Korei. De evenementen worden georganiseerd in coproductie met deze 6 bedrijven. Individuele of groepstochten zijn mogelijk te voet, per fiets, per bus en per boot.  Bezoekers ontdekken UNESCO erfgoed, Magritte, art deco, chocolade en nog veel meer. Explore.Brussels organiseert ook Brusselse festivals en andere grootschalige projecten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":27246,"location":{"lat":50.80795462,"lon":4.34397082},"last_updated_at":"2024-05-29T15:24:29+02:00","published_at":"2017-02-27T10:05:49+01:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/b382294d881bf391b992eb66d6325e1aec75fe8d.jpg","width":1500,"height":1000,"ratio":1.5,"oEmbed_height":1000,"oEmbed_width":1500,"translations":{"de":{"title":"Maison Winnens ","copyright":"\u00a9EB- Admirables Fa\u00e7ades"},"pt":{"title":"Maison Winnens ","copyright":"\u00a9EB- Admirables Fa\u00e7ades"},"en":{"title":"Maison Winnens ","copyright":"\u00a9EB- Admirables Fa\u00e7ades"},"it":{"title":"Maison Winnens ","copyright":"\u00a9EB- Admirables Fa\u00e7ades"},"cn":{"title":"Maison Winnens ","copyright":"\u00a9EB- Admirables Fa\u00e7ades"},"fr":{"title":"Maison Winnens ","copyright":"\u00a9EB- Admirables Fa\u00e7ades"},"sp":{"title":"Maison Winnens ","copyright":"\u00a9EB- Admirables Fa\u00e7ades"},"nl":{"title":"Maison Winnens ","copyright":"\u00a9EB- Admirables Fa\u00e7ades"}}}],"dates":[{"day":"2025-03-29","doors":"11:00:00","start":"11:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is