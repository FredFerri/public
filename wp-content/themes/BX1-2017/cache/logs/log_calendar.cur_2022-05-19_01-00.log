":"07:00:00","end":"21:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 07:00 \u00e0 21:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 07:00 tot 21:00"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 07:00 to 21:00"]},"date_start":"2021-06-29","date_end":"2022-12-31","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":24}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[266],"translations":{"fr":["Brussels Health Safety Label"],"nl":["Brussels Health Safety Label"],"en":["Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T01:06:16+02:00","published_at":"2021-06-29T16:05:40+02:00","backoffice_id":234634,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.12197836292507},{"id":526413,"date_start":"2022-02-24","date_end":"2022-05-20","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,25],"translations":{"fr":["Galeries d'art","Arts audiovisuels"],"nl":["Galeries","Audiovisuele kunst"],"en":["Art Galleries","Audiovisual art"]}}},"languages":{"spoken":["fr","es","nl"],"subtitles":[]},"translations":{"fr":{"name":"Jes\u00fas Azogue : #WeTheArtists","shortdescr":"Nouvelle \u00e9dition de Les Midis de l\u2019Ambassade avec le vernissage de l'exposition transm\u00e9dia de Jes\u00fas Azogue.","longdescr":"La biblioth\u00e8que Josep Carner et le LAB SPAIN arts & science de l'ambassade d\u2019Espagne en Belgique accueillent l'exposition #WeTheArtists, de Jes\u00fas Azogue, de S\u00e9ville. L'exposition cherche \u00e0 d\u00e9contextualiser l'\u00e9cosyst\u00e8me artistique, en mettant l'accent sur les artistes qui vivent de l'art dans un environnement contemporain, en pr\u00eatant attention \u00e0 des notions telles que la transversalit\u00e9 et la pr\u00e9carit\u00e9.  \r\n\r\nAzogue explore le processus de cr\u00e9ation et la vie de l'artiste, s'interrogeant sur les nouvelles limites de l'art et sur des questions telles que la paternit\u00e9, le march\u00e9 de l'art et la relation avec le public. Il le fait par le biais d\u2019une grande vari\u00e9t\u00e9 de langues et de m\u00e9dias qui illustrent des concepts li\u00e9s \u00e0 sa trajectoire personnelle et professionnelle, notamment son installation en Belgique il y a dix ans.  \r\n\r\nSa maturit\u00e9 en tant qu'artiste transm\u00e9dia et son exp\u00e9rimentation des langages g\u00e9n\u00e9ratifs offrent dans #WeTheArtists des parcours multiples qui ne sont pas lin\u00e9aires, qui manquent de points de d\u00e9part et d'arriv\u00e9e pr\u00e9cis, qui font des allers-retours et recommencent, brouillant d\u00e9lib\u00e9r\u00e9ment les fronti\u00e8res entre les disciplines, les m\u00e9dias et les formats.\r\n\r\nL'exposition, qui sera bient\u00f4t pr\u00e9sent\u00e9e en Espagne, comprend divers \u00e9l\u00e9ments visuels et num\u00e9riques, dont des performances qui g\u00e9n\u00e8rent des synergies avec les mod\u00e8les auxquels elles font r\u00e9f\u00e9rence, une installation num\u00e9rique d\u00e9velopp\u00e9e \u00e0 partir d'un hologramme, une \"fen\u00eatre\" sur une exposition virtuelle, l'utilisation de lunettes de r\u00e9alit\u00e9 virtuelle et un documentaire.\r\n\r\nJes\u00fas a \u00e9t\u00e9 cofondateur du groupe artistique The blind man dans les ann\u00e9es 1990 et a particip\u00e9 au programme TRANSMEDIA de la Hogeschool Sint Lukas \u00e0 Bruxelles. Dans ses pi\u00e8ces (installations vid\u00e9o, performances, projets de design et multim\u00e9dia), il laisse toujours une trace \u00e0 suivre, la trace de quelque chose qui semble s'\u00eatre d\u00e9j\u00e0 produit ou qui semble se produire et, m\u00eame si nous ne le voyons pas, nous n'y croyons pas tout \u00e0 fait. Il a organis\u00e9 de nombreuses expositions et performances et a \u00e9t\u00e9 publi\u00e9 dans divers catalogues et articles. Depuis plus d'une d\u00e9cennie, il vit et travaille \u00e0 Bruxelles. Sa vie d'artiste s'est d\u00e9velopp\u00e9e entre deux paradigmes fondamentaux : l'humanisme et le datisme, fruit de la r\u00e9volution num\u00e9rique.","performers":"Jes\u00fas Azogue","boxoffice_url":null,"website":"https:\/\/www.spainculture.be\/fr\/region\/bruxelles\/exposition-transmedia-wetheartists\/","email":"emb.bruselas.rsvp@maec.es","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/526413.html"},"nl":{"name":"Jes\u00fas Azogue: #WeTheArtists","shortdescr":"Nieuwe editie van de Middagen van de Ambassade met de opening van de transmediale tentoonstelling van Jes\u00fas Azogue.","longdescr":"De Josep Carner Bibliotheek en het LAB voor Kunst en Wetenschap van de Ambassade van Spanje in Belgi\u00eb organiseren de tentoonstelling #We the artists, van de Sevilliaanse kunstenaar Jes\u00fas Azogue. De tentoonstelling wil het artistieke ecosysteem decontextualiseren, met speciale aandacht voor de kunstenaars die van de kunst leven in een hedendaagse omgeving, met aandacht voor begrippen als transversaliteit en precariteit.\r\n \r\nAzogue verkent het creatieve proces en het leven van de kunstenaar en stelt vragen over de nieuwe grenzen van de kunst en kwesties als auteurschap, de kunstmarkt en de relatie met het publiek. Hij doet dit door middel van een verscheidenheid aan artistieke taal en support die concepten illustreren die verband houden met zijn persoonlijke en professionele traject, met inbegrip van zijn vestiging in Belgi\u00eb een tientaljaar geleden.  \r\n\r\nZijn rijpheid als transmedia kunstenaar en zijn experimenteren met generatieve talen bieden in #WeTheArtists meerdere routes die niet lineair zijn, die precieze vertrek- en aankomstpunten missen, die heen en weer gaan en opnieuw beginnen, waarbij de grenzen tussen disciplines, media en formats opzettelijk vervagen.\r\n \r\nDe tentoonstelling, die binnenkort naar Spanje zal reizen, omvat verschillende visuele en digitale elementen, met performances die synergie\u00ebn genereren met de modellen waarnaar ze verwijzen, een digitale installatie ontwikkeld op basis van een hologram, een \"venster\" naar een virtuele tentoonstelling, het gebruik van een virtual reality-bril en een documentaire.\r\n \r\nJes\u00fas was in de jaren negentig medeoprichter van de kunstgroep De Blinde Man en maakte deel uit van het TRANSMEDIA-programma aan de Hogeschool Sint Lukas in Brussel. In zijn stukken (video-installaties, performances, design en multimediaprojecten) laat hij altijd een spoor na dat gevolgd kan worden, het spoor van iets dat al gebeurd lijkt te zijn of lijkt te gebeuren en dat we, ook al zien we het niet, niet helemaal geloven. Hij heeft talrijke tentoonstellingen en performances gehouden en hij is vermeld in diverse catalogi en artikelen. Sinds meer dan tien jaar woont en werkt hij in Brussel. Zijn leven als kunstenaar heeft zich ontwikkeld tussen twee fundamentele paradigma's: het humanisme en het datisme, de vrucht van de digitale revolutie.","performers":"Jes\u00fas Azogue","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/526413.html"},"en":{"name":"Jes\u00fas Azogue: #WeTheArtists","shortdescr":"New edition of the \"Embassy Noons\" with the opening of the transmedia exhibition by Jes\u00fas Azogue.","longdescr":"The Josep Carner Library and the Embassy's Spain Arts and Science LAB in Belgium are hosting the exhibition #We the artists, by the Sevillian artist Jes\u00fas Azogue. The exhibition seeks to decontextualise the artistic ecosystem, with special emphasis on those artists who make a living from art in a contemporary environment, paying attention to notions such as transversality and precariousness. \r\n \r\nAzogue explores the creative process and the life of the artist, questioning the new confines of art and issues such as authorship, the art market and the relationship with the public. It does so through a variety of languages and media that illustrate concepts related to his personal and professional trajectory, including his installation in Belgium a decade ago.  \r\n \r\nHis maturity as a transmedia artist and his experimentation with generative languages offer in #WeTheArtists multiple routes that are not linear, that lack precise points of departure and arrival, that go back and forth and start again, deliberately blurring the boundaries between disciplines, media and formats.\r\n \r\nThe exhibition, which will soon travel to Spain, includes various visual and digital elements, with performances that generate synergies with the models they reference, a digital installation developed from a hologram, a 'window' to a virtual exhibition, the use of virtual reality glasses and a documentary.\r\n \r\nJes\u00fas was co-founder of the art group The blind man in the 1990s and part of the TRANSMEDIA programme at the Hogeschool Sint Lukas in Brussels. In his pieces (video installations, performances, design and multimedia projects) he always leaves a trace to be followed, the trace of something that seems to have already happened or seems to be happening and, even if we don't see it, we don't quite believe it. He has held numerous exhibitions and performances and has been published in various catalogues and articles. For more than a decade he has been living and working in Brussels. His life as an artist has developed between two fundamental paradigms: humanism and datism, the fruit of the digital revolution.","performers":"Jes\u00fas Azogue","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/526413.html"},"de":{"name":"Exposition transm\u00e9dia #WeTheArtists","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/526413.html"},"it":{"name":"Exposition transm\u00e9dia #WeTheArtists","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/526413.html"},"sp":{"name":"Exposition transm\u00e9dia #WeTheArtists","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/526413.html"},"pt":{"name":"Exposition transm\u00e9dia #WeTheArtists","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/526413.html"},"cn":{"name":"Exposition transm\u00e9dia #WeTheArtists","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/526413.html"}},"place":{"id":266806,"translations":{"fr":{"name":"Spain Arts & Culture \/ Services Culturels de l'Ambassade d'Espagne","address_street_name":"Rue de la Science","address_street_number":"19"