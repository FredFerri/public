origin":null,"sub_type":"foire","show_in_agenda":true,"ranking":1},{"id":551213,"date_start":"2023-03-18","date_end":"2023-03-19","date_next":"2023-03-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":57,"translations":{"fr":"Clubbing","nl":"Clubbing","en":"Clubbing","de":"Clubbing","it":"Locali notturni","sp":"Ir de discoteca","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"C12 Nite","shortdescr":"C12 Nite","longdescr":"SAT 18.03.2023\r\n\u24b8\u2460\u2461 \r\nEgyptian Lover\r\nDTM Funk \r\nChris Ferreira\r\n\r\n\u24b8\u2460\u2460 \r\nSan Soda \r\nKong DJ\r\n\r\nGood to know\r\n\u2594\u2594\u2594\r\nDoors open: 23h\r\n\u2014\u2014\u2014\u2014\u2014\u2014\r\nAge limit : + 21\r\n\u2014\u2014\u2014\u2014\u2014\u2014\r\nIn = In \/\/ Out = Out\r\n\u2014\u2014\u2014\u2014\u2014\u2014\r\nFor all kinds of people.\r\n\r\nTickets\r\n\u2594\u2594\u2594\r\nLimited amount of presale tickets : https:\/\/c12space.com\/presale-tickets\/\r\nDoor sale starts at 23h.\r\nLockers : 2\u20ac\r\nToilets : Free\r\n\r\nAddress\r\n\u2594\u2594\u2594\u2594\r\n116 rue marche aux herbes\r\n1000 Brussels\r\n\r\n\ufeff\r\nWhat we stand for\r\n\u2594\u2594\u2594\r\nC12 is a pluridisciplinary space where art & clubbing collide. It\u2019s a place where freedom, diversity, creativity and alternative cultures are protected from the outside world and its norms and restrictions. By doing this, we wish to establish a place owned by artists, musicians and every individual who comes through our door.\r\n\r\nNO!\r\n\u2014\u2014-\r\nIn order to protect our space, we will not tolerate any discriminating comportment (racism, sexism, homophobia, \u2026), shaming, violence, consumption of drugs and any kind of intrusive behaviour, even in its most passive form.\r\n\r\nRESPECT!\r\n\u2014\u2014\u2014\u2014-\r\nBetween these walls, we look out for each other and respect and tolerance are key. Everyone among us is treated equally, regardless of who they are, where they come from and what they do. The space belongs to everyone and to no group or no community in particular.\r\n\r\nIN OR NOT?\r\n\u2014\u2014\u2014\u2014-\r\nC12 is a private space and reserves the right to decide which visitors are allowed to enter. Represented by our door staff, we reserve the right to deny entry to every person deemed unable to respect the values connected to the project.\r\n\r\nNEED HELP?\r\n\u2014\u2014\u2014\u2014-\r\nC12\u2019s staff has been trained to act against any disputative situation or behavior. We have a help desk located near the entrance of the main room, where you can talk to a staff member any time of the night. We have staff present on the dance floor and in every corner of the club, functioning as our eyes and ears. We encourage anyone who witnesses a violation of the rules to contact a C12 staff member. In case of indictment, C12 reserves the right to contact the authorities. Respect yourself, the audience, the artists and the staff, stay hydrated and have a pleasant time.\r\nWe wish you an incredible night of clubbing.","performers":"SAT 18.03.2023\r\n\u24b8\u2460\u2461 \r\nEgyptian Lover\r\nDTM Funk \r\nChris Ferreira\r\n\r\n\u24b8\u2460\u2460 \r\nSan Soda \r\nKong DJ","boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":"+32 471 86 59 12","phone_booking":"+32 471 86 59 12","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551213"},"nl":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":"+32 471 86 59 12","phone_booking":"+32 471 86 59 12","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551213"},"en":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":"+32 471 86 59 12","phone_booking":"+32 471 86 59 12","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551213"},"de":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":"+32 471 86 59 12","phone_booking":"+32 471 86 59 12","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551213"},"it":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":"+32 471 86 59 12","phone_booking":"+32 471 86 59 12","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551213"},"sp":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":"+32 471 86 59 12","phone_booking":"+32 471 86 59 12","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551213"},"pt":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":"+32 471 86 59 12","phone_booking":"+32 471 86 59 12","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551213"},"cn":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":"+32 471 86 59 12","phone_booking":"+32 471 86 59 12","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551213"}},"place":{"id":270712,"translations":{"fr":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":"C12 est une nouvelle plateforme multidisciplinaire du collectif Deep in House. Situ\u00e9e au c\u0153ur de Bruxelles, la C12 est nich\u00e9e dans les profondeurs de la Galerie Horta \u00e0 c\u00f4t\u00e9 de la Grand Place et de la Gare Centrale. C12 est un endroit s\u00fbr o\u00f9 la libert\u00e9, la diversit\u00e9, la cr\u00e9ativit\u00e9 et la culture alternative sont prot\u00e9g\u00e9es du monde ext\u00e9rieur restrictif et normatif. C'est un endroit s\u00fbr o\u00f9 la passion pour l'art et la musique sous toutes ses formes unit toutes les identit\u00e9s. Le projet comprendra des concerts, des installations artistiques, des vies, des soir\u00e9es club et le dernier mais non le moindre, un march\u00e9 local.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Brussel","description_web":"Sinds begin 2018 is Brussel een nieuwe club en multidisciplinaire projectruimte rijker en we kunnen ons het nachtleven zonder al niet meer voorstellen. C12 ligt verborgen onder het Centraal Station in wat voorheen bekend stond als de Hortagalerij. Aan het roer staat \u2018Deep in House\u2019, een technocollectief dat lang niet meer aan zijn proefstuk toe is. Naast stomende house- en technofeesten is er ook plaats voor concerten, tentoonstellingen en performance. C12 is een vrijplaats waar vrijheid, diversiteit, creativiteit en alternatieve cultuur beschermd en gevierd worden. Een absolute aanrader. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Brussels","description_web":"C12 is a new multidisciplinary platform run by the Deep in House collective. Located at the heart of Brussels, C12 is tucked in the depths of the Horta Gallery next to the Grand Place and the Central Station. C12 is a safe place where freedom, diversity, creativity and alternative culture are protected from the restrictive and normative outside world. It is a safe place where the passion for art & music in all its forms unites all identities. The project will include concerts, art installations, lives, club nights and last but by no means least, a local market.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address