ull,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012649"},"sp":{"name":"Dave Gisler Trio (CH)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":"roskambrussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012649"},"nl":{"name":"Dave Gisler Trio (CH)","shortdescr":null,"longdescr":"Dave Gisler enjoys an excellent reputation as an idiosyncratic architect of sound on the electric guitar. With the trio, he presents a dazzling array of possibilities for genre-bending music that is at home in jazz, but also draws on rock, punk and noise.\nThe trio's first recording, \"Rabbits on the Run,\" was released in 2018 on Intakt Records. It laid the track for a musical departure that on the one hand intensified the trio and on the other hand also expanded it to a quartet or quintet.","performers":"Dave Gisler - guitar\nRaffaele Bossard - bass\nLionel Friedl - drums","boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":"roskambrussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012649"}},"place":{"id":243287,"translations":{"de":{"name":"Caf\u00e9 Roskam","address_street_name":"Rue de Flandre","address_street_number":"9","address_street_box":null,"email":"roskambrussels@gmail.com","website":"http:\/\/www.cafe-roskam.be","phone_contact":"+32 2 503 51 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 9","address_line2":"1000 Bruxelles","description_web":"Ein Caf\u00e9, das insbesondere f\u00fcr seine erlesene Auswahl an Bier und Gin Tonic, die hier herrschende gute Stimmung und die Sonntagabend stattfindenden hochkar\u00e4tigen Jazzkonzerte bekannt ist.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit