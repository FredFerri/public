appareill\u00e9s"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to people with intellectual disabilities","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen.","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile alle persone con difficolt\u00e0 di comprensione","Disposizioni per persone non udenti e ipoudenti","Cane guida","Accessibile ai pedoni con supporti"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n","Equipos para personas sordas y con problemas de audici\u00f3n","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-06T02:35:54+01:00","published_at":"2023-01-13T10:32:14+01:00","backoffice_id":269434,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.22232392577062},{"id":539470,"date_start":"2022-11-06","date_end":"2023-07-16","date_next":"2023-04-02","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":"R\u00eaver, tout \u00e9veill\u00e9s !","longdescr":"Twig, Splash et Scratch viennent tout droit de la Lune, plan\u00e8te des r\u00eaves !\r\nQuand les enfants terriens dorment, ils leur rendent visite et vivent ensemble plein d\u2019aventures !\r\nMais lorsque les enfants se r\u00e9veillent, souvent, ils ne se souviennent pas de leurs r\u00eaves, et jamais des trois petites cr\u00e9atures. \u2028Attrist\u00e9s de cela, \u2028Twig, Splash et Scratch d\u00e9cident de venir sur la Terre, \u2028avec leurs marionnettes, en pleine journ\u00e9e afin de pouvoir r\u00eaver avec les enfants tout \u00e9veill\u00e9s.\r\nPour cela, ils leur font dessiner des d\u00e9cors incroyables et les projettent sur sc\u00e8ne afin de jouer dedans.\r\n\u00ab Maintenant, ils se souviendront de nous ! \u00bb","performers":"M\u00e9lissa Motheu, Thierry Maerschalk, Hicham El Hamouri","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539470"},"nl":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539470"},"en":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539470"},"de":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_