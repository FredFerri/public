llation, performance","Museums and art centers"],"it":["Installazioni, performance","Musei e centri artistici"],"cn":[null,null],"fr":["Installation, performance","Mus\u00e9es et art centers"],"sp":["Instalaci\u00f3n, performance","Museos y centros de arte"],"nl":["Installatie, performance","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Cuivre infus\u00e9 de b\u00e9n\u00e9diction: Exploration de la Techno-d\u00e9sob\u00e9issance et de bols apaisants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":"+32 2 539 24 67","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.557798"},"pt":{"name":"Cuivre infus\u00e9 de b\u00e9n\u00e9diction: Exploration de la Techno-d\u00e9sob\u00e9issance et de bols apaisants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":"+32 2 539 24 67","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.557798"},"en":{"name":"Copper Infused with Blessing : Exploring Techno-disobedience and Soothing Bowls","shortdescr":"The Fear Healing Bowls are part of the arts of protection in Islamic tradition, practiced in different cultures across time We will explore the different traditions possible through this installation and a workshop.","longdescr":"Opening: Thursday 1 June 2023 from 17:30 on\r\nWorkshop: Saturday 24 June 2023 from 11:00 to 17:00\r\n\r\nThe Fear Healing Bowls are part of the arts of protection in Islamic tradition, practiced in different cultures across time. Through many layers such as written prayers, ornamental elements representing beauty and locality, symbols of Divinity, craft knowledge(s), water and sound: this bowl is seen as a medicinal ritualistic tradition of soothing.\r\n\r\n    Growing up in Deir-Ezzour, I remember my grandmother would offer the bowl filled with blessed water to someone experiencing fear or anxiety, reciting verses of the Quran with the intention to calm and sooth.\r\n\r\nDuring the opening of the installation in the window of Constant on the 1st of June and in the company of the artist Joud Toamah, we will have an open discussion that will feed the hands-on workshop that follows:\r\n\r\nhttps:\/\/constantvzw.org\/site\/Copper-Infused-with-Blessing-hands-on-workshop.html?lang=en\r\n\r\nWe will explore the different traditions possible through the healing bowls. We will invite participants to use the healing bowls as a starting point to activate collective rituals and embodied knowledge through printmaking, carving and sewing.\r\n\r\nJoud\u2019s intention is to remember, honor and share this soothing practice to open up a discussion to different soothing languages that could be expressed, remembered and honored through the bowls.","performers":"Joud Toamah (artist)","boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":"+32 2 539 24 67","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557798"},"it":{"name":"Cuivre infus\u00e9 de b\u00e9n\u00e9diction: Exploration de la Techno-d\u00e9sob\u00e9issance et de bols apaisants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":"+32 2 539 24 67","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.557798"},"cn":{"name":"Cuivre infus\u00e9 de b\u00e9n\u00e9diction: Exploration de la Techno-d\u00e9sob\u00e9issance et de bols apaisants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":"+32 2 539 24 67","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.557798"},"fr":{"name":"Cuivre infus\u00e9 de b\u00e9n\u00e9diction: Exploration de la Techno-d\u00e9sob\u00e9issance et de bols apaisants","shortdescr":"Les bols de gu\u00e9rison de la peur font partie des arts de la protection dans la tradition islamique, pratiqu\u00e9s dans diff\u00e9rentes cultures \u00e0 travers le temps. Nous explorerons les diff\u00e9rentes traditions possibles par le biais de cette installation et d'un atelier.","longdescr":"Vernissage : jeudi 1 Juin 2023 de 17:30 on\r\nAtelier : samedi 24 Juin 2023 de 11:00 \u00e0 17:00\r\n\r\nLes bols de gu\u00e9rison de la peur font partie des arts de la protection dans la tradition islamique, pratiqu\u00e9s dans diff\u00e9rentes cultures \u00e0 travers le temps. Par le biais de nombreuses couches telles que des pri\u00e8res \u00e9crites, des \u00e9l\u00e9ments ornementaux repr\u00e9sentant la beaut\u00e9 et la localit\u00e9, des symboles de la divinit\u00e9, des connaissances artisanales, de l\u2019eau et du son, ce bol est consid\u00e9r\u00e9 comme une tradition rituelle m\u00e9dicinale d\u2019apaisement.\r\n\r\n    Ayant grandi \u00e0 Deir-Ezzour, je me souviens que ma grand-m\u00e8re offrait le bol rempli d\u2019eau b\u00e9nite \u00e0 une personne ayant peur ou de l\u2019anxi\u00e9t\u00e9, en r\u00e9citant des versets du Coran dans l\u2019intention de la calmer et de l\u2019apaiser.\r\n\r\nLors du vernissage de l\u2019installation dans la fen\u00eatre de Constant le 1er juin, en compagnie de l\u2019artiste Joud Toamah, nous aurons une discussion ouverte qui alimentera l\u2019atelier pratique qui suivra :\r\n\r\nhttps:\/\/constantvzw.org\/site\/Copper-Infused-with-Blessing-hands-on-workshop.html?lang=fr\r\n\r\nNous explorerons les diff\u00e9rentes traditions possibles par le biais des bols de gu\u00e9rison. Nous inviterons les participant\u00b7e\u00b7s \u00e0 prendre les bols de gu\u00e9rison comme point de d\u00e9part pour activer des rituels collectifs et des connaissances incarn\u00e9es par la gravure, la sculpture et la couture.\r\n\r\nL\u2019intention de Joud est de rappeler, d\u2019honorer et de partager cette pratique apaisante afin d\u2019ouvrir une discussion sur les diff\u00e9rents langages apaisants qui pourraient \u00eatre exprim\u00e9s, rappel\u00e9s et honor\u00e9s \u00e0 travers les bols.","performers":"Joud Toamah (artiste)","boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":"+32 2 539 24 67","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557798"},"sp":{"name":"Cuivre infus\u00e9 de b\u00e9n\u00e9diction: Exploration de la Techno-d\u00e9sob\u00e9issance et de bols apaisants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":"+32 2 539 24 67","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.557798"},"nl":{"name":"Koper doordrenkt met zegen: Het verkennen van Technologische ongehoorzaamheid en Kalmerende Schalen","shortdescr":"De Angst helenden schalen maken deel uit van de kunst van bescherming in de Islamitische traditie, beoefend in verschillende culturen door de tijd heen. We zullen de verschillende tradities verkennen die mogelijk zijn door deze installatie en een workshop.","longdescr":"Opening: Donderdag 1 juni 2023 vanaf 17:30\r\nWorkshop: Zaterdag 24 juni 2023 tussen 11:00 en 17:00\r\n\r\nDe Angst helenden schalen maken deel uit van de kunst van bescherming in de Islamitische traditie, beoefend in verschillende culturen door de tijd heen. Doorheen vele lagen zoals geschreven gebeden, ornamentele elementen die schoonheid en plaats vertegenwoordigen, symbolen van Goddelijkheid, ambachtelijke kennis, water en geluid: deze kom wordt gezien als een medicinale rituele traditie van verzachting.\r\n\r\n    Toen ik opgroeide in Deir-Ezzour, herinner ik me dat mijn grootmoeder de kom gevuld met gezegend water aanbood aan iemand die angst of vrees had, en verzen uit de Koran reciteerde met de bedoeling te kalmeren en te verzachten.\r\n\r\nTijdens de opening van de installatie in het raam van constant op 1 juni, samen met de kunstenares Joud Toamah, houden we een open discussie die de basis zal vormen voor de praktische workshop die erop volgt:\r\n\r\nhttps:\/\/constantvzw.org\/site\/Copper-Infused-with-Blessing-hands-on-workshop.html?lang=nl\r\n\r\nWe zullen de verschillende tradities verkennen die mogelijk zijn via de helenden schalen. We zullen de deelnemers uitnodigen de helenden schalen te gebruiken als uitgangspunt om collectieve rituelen en belichaamde kennis te activeren door middel van drukwerk, houtsnijwerk en naaiwerk.\r\n\r\nDe bedoeling van Joud is om deze rustgevende praktijk te herinneren, te eren en te delen om een discussie te openen over verschillende rustgevende talen die kunnen worden uitgedrukt, herinnerd en ge\u00eberd via de schalen.","performers":"Joud Toamah (kunstenares)","boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":"+32 2 539 24 67","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557798"}},"place":{"id":243917,"translations":{"de":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Constant","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":"Constant est une association sans but lucratif bas\u00e9e \u00e0 Bruxelles, active depuis 1997 dans les domaines de l\u2019art et des m\u00e9dias.\r\nConstant est un atelier interdisciplinaire qui se concentre sur la culture et l\u2019\u00e9thique du web. La pratique artistique de Constant est inspir\u00e9e par la fa\u00e7on avec laquelle les infrastructures technologiques, les \u00e9changes de donn\u00e9es et les logiciels d\u00e9terminent nos vies quotidiennes. Quelques chantiers importants sont le logiciel libre, les alternatives au copyright et le (cyber)f\u00e9minisme.\r\nDe fa\u00e7on r\u00e9guli\u00e8re Constant organise des ateliers, des print-parties, des balades, des performances, des lectures et des rencontres \u2018Verbindingen\/Jonctions\u2019 pour un public qui aime l\u2019exp\u00e9rimentation, la discussion et des \u00e9changes de toutes sortes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Constant vzw","address_street_name":"Fortstraat","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Fortstraat, 5","address_line2":"1060 Saint-Gilles","description_web":"Constant is een vereniging zonder winstoogmerk werkzaam in het gebied tussen kunst en media.\r\nHet is een interdisciplinaire werkplaats die zich bezighoudt met de cultuur en ethiek van het web. De artistieke praktijk van Constant wordt ge\u00efnspireerd door de manier waarop technologische infrastructuren, data-uitwisseling en software ons dagelijkse leven bepalen. Belangrijke werkterreinen zijn vrije software, alternatieven op auteursrecht en (cyber)feminisme.\r\nConstant organiseert regelmatig workshops, print-parties, wandelingen en \u2018Verbindingen\/Jonctions\u2019-bijeenkomsten voor een publiek dat houdt van experimenten, discussies en uitwisselingen allerhande.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl":["Sint-Gillis centrum"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":6251,"location":{"lat":50.829913,"lon":4.34345951},"region":"brussels","last_updated_at":"2022-05-30T12:22:16+02:00","published_at":"2013-10-19T01:19:59+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":243917,"translations":{"de":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{