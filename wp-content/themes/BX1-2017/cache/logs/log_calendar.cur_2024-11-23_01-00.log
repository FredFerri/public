"cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[104],"translations":{"de":["Jugendstil, Art d\u00e9co"],"pt":[null],"en":["Art Nouveau, Art D\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"cn":[null],"fr":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"L'Art nouveau pour tous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002828"},"pt":{"name":"L'Art nouveau pour tous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002828"},"en":{"name":"L'Art nouveau pour tous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002828"},"it":{"name":"L'Art nouveau pour tous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002828"},"cn":{"name":"L'Art nouveau pour tous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002828"},"fr":{"name":"L'Art nouveau pour tous","shortdescr":null,"longdescr":"Le style Art nouveau est le plus souvent associ\u00e9 \u00e0 la construction d\u2019habitations bourgeoises, aux d\u00e9cors fastueux r\u00e9serv\u00e9s \u00e0 une \u00e9lite. Mais savez-vous qu\u2019\u00e0 Bruxelles, certains architectes ont choisi d\u2019utiliser les formes et les motifs de ce style pour dessiner des b\u00e2timents publics et des logements modestes ? Parmi eux, l\u2019architecte Henri Jacobs s\u2019est particuli\u00e8rement illustr\u00e9. Il est l\u2019auteur de nombreuses \u00e9coles, mais aussi de plusieurs ensembles de logements publics.\n\nCette visite, dans le quartier Plasky \u00e0 Schaerbeek, part \u00e0 la d\u00e9couverte de l\u2019\u0153uvre de celui qui choisit de mettre son talent au service de la collectivit\u00e9 en faisant de l\u2019Art nouveau un \u00ab art pour tous \u00bb. L\u2019Art nouveau est, par ailleurs, tr\u00e8s pr\u00e9sent dans les d\u00e9cors de fa\u00e7ades de maisons bruxelloises plus modestes et souvent anonymes. Certains architectes y font parfois preuve, avec peu de moyens, d\u2019une extraordinaire cr\u00e9ativit\u00e9.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002828"},"sp":{"name":"L'Art nouveau pour tous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002828"},"nl":{"name":"L'Art nouveau pour tous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002828"}},"place":{"id":50002557,"translations":{"de":{"name":"Devant le n\u00b055 de la rue Victor Hugo"