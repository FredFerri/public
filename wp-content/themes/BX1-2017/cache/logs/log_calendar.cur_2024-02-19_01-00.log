.3684031498640387,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[43,36],"translations":{"de":["Dekorative K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Decorative art","Museums and art centers"],"it":["Arti decorative","Musei e centri artistici"],"cn":[null,null],"fr":["Arts D\u00e9coratifs","Mus\u00e9es et art centers"],"sp":["Artes decorativas","Museos y centros de arte"],"nl":["Decoratieve kunsten","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Hinamatsuri","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.be.emb-japan.go.jp\/itpr_en\/culture_event_jicc.html","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007247"},"pt":{"name":"Hinamatsuri","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.be.emb-japan.go.jp\/itpr_en\/culture_event_jicc.html","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007247"},"en":{"name":"Hinamatsuri","shortdescr":"Let's come together to celebrate Hina Matsuri, where the echoes of the Edo period tradition continue to ward off evil spirits, bringing charm and goodwill. \nThe members of the cultural section have done their best to bring this celebration to you so join us for a unique chance to discover the beauty of hina dolls adorned in colorful kimonos! ","longdescr":"Dive into the enchanting world of Hina Matsuri at our cultural center! \n\nOn March 3rd, Japan celebrates this beautiful Doll Festival, a day dedicated to wishing girls good health and future happiness.\nFamilies set up displays featuring imperial couples, court musicians, and guards on tiered platforms covered in vibrant red felt. \n\nLet's come together to celebrate Hina Matsuri, where the echoes of the Edo period tradition continue to ward off evil spirits, bringing charm and goodwill. \nThe members of the cultural section have done their best to bring this celebration to you so join us for a unique chance to discover the beauty of hina dolls adorned in colorful kimonos! ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.be.emb-japan.go.jp\/itpr_en\/culture_event_jicc.html","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007247"},"it":{"name":"Hinamatsuri","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.be.emb-japan.go.jp\/itpr_en\/culture_event_jicc.html","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007247"},"cn":{"name":"Hinamatsuri","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.be.emb-japan.go.jp\/itpr_en\/culture_event_jicc.html","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007247"},"fr":{"name":"Hinamatsuri","shortdescr":"R\u00e9unissons-nous pour c\u00e9l\u00e9brer le Hina Matsuri, o\u00f9 les \u00e9chos de la tradition de la p\u00e9riode Edo continuent d'\u00e9loigner les mauvais esprits, apportant charme et bonne volont\u00e9. \nLes membres de la section culturelle ont fait de leur mieux pour vous pr\u00e9senter cette c\u00e9l\u00e9bration, alors rejoignez-nous pour une chance unique de d\u00e9couvrir la beaut\u00e9 des poup\u00e9es hina par\u00e9es de kimonos color\u00e9s ! ","longdescr":"Plongez dans le monde enchanteur du Hina Matsuri dans notre centre culturel ! \n\nLe 3 mars, le Japon c\u00e9l\u00e8bre ce magnifique festival des poup\u00e9es, une journ\u00e9e consacr\u00e9e aux v\u0153ux de sant\u00e9 et de bonheur des jeunes filles.\nLes familles installent des expositions repr\u00e9sentant des couples imp\u00e9riaux, des musiciens de la cour et des gardes sur des plates-formes en gradins recouvertes de feutre rouge vif. \n\nR\u00e9unissons-nous pour c\u00e9l\u00e9brer le Hina Matsuri, o\u00f9 les \u00e9chos de la tradition de la p\u00e9riode Edo continuent d'\u00e9loigner les mauvais esprits, apportant charme et bonne volont\u00e9. \nLes membres de la section culturelle ont fait de leur mieux pour vous pr\u00e9senter cette c\u00e9l\u00e9bration, alors rejoignez-nous pour une chance unique de d\u00e9couvrir la beaut\u00e9 des poup\u00e9es hina par\u00e9es de kimonos color\u00e9s ! ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.be.emb-japan.go.jp\/itpr_en\/culture_event_jicc.html","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007247"},"sp":{"name":"Hinamatsuri","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.be.emb-japan.go.jp\/itpr_en\/culture_event_jicc.html","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007247"},"nl":{"name":"Hinamatsuri","shortdescr":"Laten we samenkomen om Hina Matsuri te vieren, waar de echo's van de traditie uit de Edo-periode boze geesten blijven afweren en charme en goodwill brengen. \nHet personeel van de culturele sectie hebben hun best gedaan om dit feest met jullie te delen, dus kom naar ons voor een unieke kans om de schoonheid van hina poppen, getooid in kleurrijke kimono's, te ontdekken! ","longdescr":"Duik in de betoverende wereld van Hina Matsuri in ons cultureel centrum! \n\nOp 3 maart viert Japan dit prachtige poppenfestival, een dag die is gewijd aan het wensen van meisjes voor een goede gezondheid en toekomstig geluk.\nFamilies zetten displays op met keizerlijke paren, hofmuzikanten en wachters op platforms die bedekt zijn met levendig rood vilt. \n\nLaten we samenkomen om Hina Matsuri te vieren, waar de echo's van de traditie uit de Edo-periode boze geesten blijven afweren en charme en goodwill brengen. \nHet personeel van de culturele sectie hebben hun best gedaan om dit feest met jullie te delen, dus kom naar ons voor een unieke kans om de schoonheid van hina poppen, getooid in kleurrijke kimono's, te ontdekken! ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.be.emb-japan.go.jp\/itpr_en\/culture_event_jicc.html","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007247"}},"place":{"id":272251,"translations":{"de":{"name":"Japan Information and Cultural Centre","address_street_name":"Rue Van Maerlant","address_street_number":"1","address_street_box":null,"email":"info@bx.mofa.go.jp","website":"https:\/\/www.be.emb-japan.go.jp\/itprtop_en\/index.html","phone_contact":"+32 2 513 23 40","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue Van Maerlant, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Japan Information and Cultural Centre","address_street_name":"Rue Van Maerlant","address_street_number":"1","address_street_box":null,"email":"info@bx.mofa.go.jp","website":"https:\/\/www.be.emb-japan.go.jp\/itprtop_en\/index.html","phone_contact":"+32 2 513 23 40","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue Van Maerlant, 1","address_line2":"1040 Etterbeek","description_web"