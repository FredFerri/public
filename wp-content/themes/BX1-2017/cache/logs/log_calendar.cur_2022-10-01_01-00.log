t":"16:00:00","end":"18:00:00"},{"start":"20:30:00","end":"22:30:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi et dimanche: ferm\u00e9","jeudi et vendredi: de 20:30 \u00e0 22:30","samedi: de 16:00 \u00e0 18:00 et de 20:30 \u00e0 22:30"],"nl":["maandag, dinsdag, woensdag en zondag: gesloten","donderdag en vrijdag: van 20:30 tot 22:30","zaterdag: van 16:00 tot 18:00 en van 20:30 tot 22:30"],"en":["monday, tuesday, wednesday and sunday: closed","thursday and friday: from 20:30 to 22:30","saturday: from 16:00 to 18:00 and from 20:30 to 22:30"]},"date_start":"2022-09-15","date_end":"2022-10-08","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":10},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":10},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":10},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-30T02:06:06+02:00","published_at":"2022-09-14T16:44:30+02:00","backoffice_id":261840,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.43679023236815},{"id":539247,"date_start":"2022-09-27","date_end":"2022-10-08","date_next":"2022-09-30","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La Fille du Sacrifice - R\u00e9hab Mehal","shortdescr":"La Fille du Sacrifice est le r\u00e9cit de cette m\u00e9tamorphose intime.","longdescr":"Un beau jour d\u2019\u00e9t\u00e9, alors qu\u2019elle visite la Galerie des Offices \u00e0 Florence, Ibra tombe par hasard sur Le Sacrifice d\u2019Isaac , l\u2019un des chefs-d\u2019\u0153uvre du Caravage. Pour cette jeune femme croyante et pieuse, arri\u00e8re-arri\u00e8re-petite-fille d\u2019Abraham, ce tableau agit comme une fl\u00e8che, qui vient la transpercer.\r\nBoulevers\u00e9e, Ibra entame alors sa \u00ab d\u00e9-conversion \u00bb.\r\nPetit \u00e0 petit, elle va remettre en question ses croyances dogmatiques, pour d\u00e9couvrir les ressorts intimes de sa spiritualit\u00e9.\r\nLib\u00e9r\u00e9e des carcans qui lui dictaient sa foi, elle va puiser son essence divine en elle-m\u00eame, et reconqu\u00e9rir son ind\u00e9pendance, avant de s\u2019engager sur le chemin de la reconversion.\r\n\r\nRacont\u00e9e sous la forme d\u2019une \u00e9pop\u00e9e intime, La Fille du Sacrifice est une enqu\u00eate sur les origines de la croyance. La ville de J\u00e9rusalem y joue un r\u00f4le important. Au confluent de deux mondes, l\u2019Orient et l\u2019Occident, elle incarne ce que R\u00e9hab M\u00e9hal cherche \u00e0 faire \u00e9merger dans son th\u00e9\u00e2tre : des rencontres et des frictions entre les deux h\u00e9ritages, les deux civilisations qui constituent sa propre identit\u00e9. \u00c0 travers ce conte contemporain, elle invente et partage sa vision singuli\u00e8re du monde, dans laquelle le rapport de l\u2019humain au divin engendre de nouvelles dialectiques, envisag\u00e9es d\u2019un point de vue r\u00e9solument f\u00e9minin.\r\n\r\n La Fille du Sacrifice est le troisi\u00e8me volet du triptyque LA R\u00c9CONCILIATION, qui aborde la question de l\u2019unit\u00e9 au sein des identit\u00e9s multiples, \u00e0 travers le prisme de l\u2019interculturalit\u00e9. \r\n\r\nLes deux premiers volets du triptyque (El-Kouds \u2013 Ma J\u00e9rusalem et Sur Le Chemin) ont \u00e9t\u00e9 repr\u00e9sent\u00e9s une cinquantaine de fois, en Belgique et en France, aussi bien dans l\u2019espace public que dans des th\u00e9\u00e2tre : Festival de Li\u00e8ge, Festival XS-Th\u00e9\u00e2tre National Wallonie-Bruxelles, Propulse-Halles de Schaerbeek, Th\u00e9\u00e2tre Le Public, Festival Voix de Femmes, BRASS, BOZAR, Centre culturel de Schaerbeek, La Filature de Mulhouse, Festival Premiers Actes, Un Festival \u00e0 Viller\u00e9al, Festival Bouillon Cube, Th\u00e9\u00e2tre de Pierres\u2026","performers":"\u00c9criture et mise en sc\u00e8ne R\u00e9hab Mehal \u2013 Avec Elisa Firouzfar \u2013 Assistant \u00e0 la mise en sc\u00e8ne Jean-Gabriel Vidal-Vandroy \u2013 R\u00e9gie g\u00e9n\u00e9rale Gaspard Samyn \u2013 Cr\u00e9ation vid\u00e9o et lumi\u00e8res Damien Petitot \u2013 Cr\u00e9ation sonore Eloi Baudimont \u2013 Costumes Fabienne Mainguet","boxoffice_url":null,"website":"http:\/\/www.oceannord.org","email":"info@oceannord.org","phone_contact":"+32 2 242 96 89","phone_booking":"+32 2 216 75 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539247"},"nl":{"name":"La Fille du Sacrifice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539247"},"en":{"name":"La Fille du Sacrifice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/v