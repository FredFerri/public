:false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-10T15:52:22+01:00","published_at":"2025-02-06T15:40:15+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317748,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"tour","ranking":0.7937005259840998,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the St. Augustin Church","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006295"},"pt":{"name":"BANAD Festival - Guided tour of the St. Augustin Church","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006295"},"en":{"name":"BANAD Festival - St. Augustin Church","shortdescr":null,"longdescr":"Built between 1932 and 1936 and designed by the architects L\u00e9on Guianotte and Andr\u00e9 Watteyne, this Art Deco church in the form of a Greek cross boasts a reinforced concrete structure and a bell tower at the exact convergence of the eight streets which extend from the Altitude Cent square. Dilapidated and threatened with demolition, it was fortunately listed in 1988 and restored in 1996-97. Moreover, further work to reinforce and restore the building is planned. The interior, bathed in yellow-orange light, is striking due to its unusual volumes and slender bell tower. The visit gives access to the top of the tower (by stairs) which offers an exceptional view of Brussels and its surrounding area.\n\nArch. L\u00e9on GUIANNOTTE & Andr\u00e9 WATTEYNE, 1932-1935","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006295"},"it":{"name":"BANAD Festival - Guided tour of the St. Augustin Church","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006295"},"cn":{"name":"BANAD Festival - Guided tour of the St. Augustin Church","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006295"},"fr":{"name":"BANAD Festival - Eglise Saint-Augustin","shortdescr":null,"longdescr":"Construite entre 1932 et 1936 par les architectes L\u00e9on Guiannotte et Andr\u00e9 Watteyne, cette \u00e9glise Art D\u00e9co \u00e0 la structure en b\u00e9ton arm\u00e9, en croix grecque, est domin\u00e9e par une tour-clocher \u00e0 la convergence exacte des huit rues rayonnantes. V\u00e9tuste et menac\u00e9e de d\u00e9molition, elle est heureusement class\u00e9e et restaur\u00e9e en 1996-1997. L'int\u00e9rieur, baign\u00e9 d'une lumi\u00e8re jaune-orange, frappe par ses volumes peu traditionnels et par l'\u00e9lancement de la tour. La visite donnera acc\u00e8s au sommet de la tour clocher (acc\u00e8s par un escalier) d'o\u00f9 s'offre une vue exceptionnelle sur Bruxelles et ses environs.\n\nArch. L\u00e9on GUIANNOTTE & Andr\u00e9 WATTEYNE, 1932-1935","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006295"},"sp":{"name":"BANAD Festival - Guided tour of the St. Augustin Church","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006295"},"nl":{"name":"BANAD Festival - Sint-Augustinus Kerk","shortdescr":null,"longdescr":"Deze art deco-kerk werd tussen 1932 en 1936 gebouwd door de architecten L\u00e9on Guianotte en Andr\u00e9 Watteyne. De kerk heeft een structuur van gewapend beton in de vorm van een Grieks kruis en wordt gedomineerd door een klokkentoren die zich precies op het middelpunt van een ster van acht straten bevindt. De kerk was bouwvallig en werd met afbraak bedreigd, maar werd gelukkig beschermd en in 1996-1997 gerestaureerd. Het interieur dat baadt in geel-oranje licht, raakt de bezoeker dankzij zijn weinig traditionele volumes en de hoogte van de toren. Tijdens het bezoek is de top van de klokkentoren toegankelijk (via een trap), van waar er een uitzonderlijk zicht is op Brussel en omgeving.\n\nArch. L\u00e9on GUIANNOTTE & Andr\u00e9 WATTEYNE, 1932-1935","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006295"}},"place":{"id":251246,"translations":{"de":{"name":"Eglise Saint Augustin","address_street_name":"Place de l'Altitude Cent","address_street_number":"100","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Place de l'Altitude Cent, 100","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Eglise Saint Augustin","address_street_name":"Place de l'Altitude Cent","address_street_number":"100","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Place de l'Altitude Cent, 100","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Eglise Saint Augustin","address_street_name":"Place de l'Altitude Cent","address_street_number":"100","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Place de l'Altitude Cent, 100","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Eglise Saint Augustin","address_street_name":"Place de l'Altitude Cent","address_street_number":"100","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Place de l'Altitude Cent, 100","address_line2":"1190 Forest","description_web":null,"description_print":null,"