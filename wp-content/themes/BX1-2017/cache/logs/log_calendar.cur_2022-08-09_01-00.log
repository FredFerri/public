,"value":4},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":8}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,257,259,261,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T01:08:13+02:00","published_at":"2022-03-08T17:28:19+01:00","backoffice_id":249253,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23017706561203},{"id":536329,"date_start":"2022-05-22","date_end":"2022-09-04","date_next":"2022-08-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,32],"translations":{"fr":["Galeries d'art","Design"],"nl":["Galeries","Design"],"en":["Art Galleries","Design"]}}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Spazio Nobile & Cor Unum","shortdescr":null,"longdescr":"About Cor Unum\r\n\r\nThe cross fertilization between professional designers of our time, the knowledge of the craft of ceramic art center Cor Unum and the talent trained on art schools in the Netherlands, results increasingly in innovative products, new design traditions and fruitful collaboration between independent artists and the ceramic production process. Implicity this is the ambition of Cor Unum and it illustrates how designers of our time prefer to work: in co-creation in order to inspire new shapes and designs. This results in Cor Unum being the linking pin of a movement that guarantees a meaningful role for the traditional ceramic craft in state-of-the-art design. Cor Unum is founded and based in The Netherlands, we produce ceramics designed by leading international designers, ar-chitects and visual artists. We take social and cultural responsibility for the legacy of the ceramic crafts. Our mission is brought to the market through a team consisting of professionals, students, people with distance from the labour market, designers and volunteers. We share one common passion: everyone deserves a place, everyone has got a talent and anyone can contribute to make the world somewhat nicer.\r\n\r\n\r\n\r\n\r\nSpazio Nobile Studiolo\r\n\r\nSpazio Nobile & Cor Unum: Le Quattro Stagioni di Tom\r\n\r\n22.5-4.9.2022\r\n\r\nRue Franz Merjay 142 & 169 - 1050 Brussels\r\n\r\nspazionobile.com\r\n\r\n@spazionobilegallery","performers":"Spazio Nobile Studiolo & Cor Unum: Le Quattro Stagioni di Tom\r\n\r\n\u00c9ditions limit\u00e9es de vases artistiques\u00a0 \/Limited editions of artistic ceramic vases: \u201cQuattro Stazione di Tom\u201d \u2013 Vases de style Memphis par les ma\u00eetres italiens & hollandais \/ Memphis style vases by Italian & Dutch Masters","boxoffice_url":null,"website":"http:\/\/www.spazionobilegallery.com","email":"lc@spazionobile.com","phone_contact":null,"phone_booking":"+32 475 53 19 88","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536329"},"nl":{"name":"Spazio Nobile & Cor Unum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.536329"},"en":{"name":"Spazio Nobile & Cor Unum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.536329"},"de":{"name":"Spazio Nobile & Cor Unum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.536329"},"it":{"name":"Spazio Nobile & Cor Unum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.536329"},"sp":{"name":"Spazio Nobile & Cor Unum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.536329"},"pt":{"name":"Spazio Nobile & Cor Unum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.536329"},"cn":{"name":"Spazio Nobile & Cor Unum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.536329"}},"place":{"id":265998,"translations":{"fr":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"http:\/\/www.spazionobilegallery.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":"Spazio Nobile Gallery, la galerie d\u2019arts appliqu\u00e9s, de design et de photographie.\r\nUn espace d\u00e9di\u00e9 \u00e0 la culture de la cr\u00e9ation\r\n\r\nMettant \u00e0 l\u2019honneur la cr\u00e9ation et le savoir-faire tant dans le design et les arts appliqu\u00e9s (verre, m\u00e9tal, bois, c\u00e9ramique\u2026) que dans la photographie, Spazio Nobile a pour ambition de faire dialoguer ces diff\u00e9rentes disciplines en m\u00ealant harmonieusement la contemporan\u00e9it\u00e9 et le sensde l\u2019histoire.\r\n\r\nSpazio Nobile Gallery, c\u2019est tout d\u2019abord le projet partag\u00e9 d\u2019un couple d\u2019historiens de l\u2019art aux parcours on ne peut plus compl\u00e9mentaires. Active depuis plus de 20 ans dans le domaine du design et de la cr\u00e9ation, Lise Coirier s\u2019investit depuis le d\u00e9but de sa carri\u00e8re pour mettre en \u00e9vidence ces cr\u00e9ateurs qui insufflent forme et vie \u00e0 la mati\u00e8re. Son mari, Gian Giuseppe Simeone, suit une voie parall\u00e8le, ax\u00e9e davantage sur la sauvegarde et la mise en valeur du patrimoine culturel et artistique, ainsi que leur diffusion vers les publics.\r\n\r\n","description_print":"Spazio Nobile Gallery, la galerie d\u2019arts appliqu\u00e9s, de design et de photographie.\r\nUn espace d\u00e9di\u00e9 \u00e0 la culture de la cr\u00e9ation\r\n\r\nMettant \u00e0 l\u2019honneur la cr\u00e9ation et le savoir-faire tant dans le design et les arts appliqu\u00e9s (verre, m\u00e9tal, bois, c\u00e9ramique\u2026) que dans la photographie, Spazio Nobile a pour ambition de faire dialoguer ces diff\u00e9rentes disciplines en m\u00ealant harmonieusement la contemporan\u00e9it\u00e9 et le sensde l\u2019histoire.\r\n\r\nSpazio Nobile, c\u2019est tout d\u2019abord le projet partag\u00e9 d\u2019un couple d\u2019historiens de l\u2019art aux parcours on ne peut plus compl\u00e9mentaires. Active depuis plus de 20 ans dans le domaine du design et de la cr\u00e9ation, Lise Coirier s\u2019investit depuis le d\u00e9but de sa carri\u00e8re pour mettre en \u00e9vidence ces cr\u00e9ateurs qui insufflent forme et vie \u00e0 la mati\u00e8re. Son mari, Gian Giuseppe Simeone, suit une voie parall\u00e8le, ax\u00e9e davantage sur la sauvegarde et la mise en valeur du patrimoine culturel et artistique, ainsi que leur diffusion vers les publics.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Franz Merjaystraat","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"http:\/\/www.spazionobilegallery.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Elsene","address_line1":"Franz Merjaystraat, 142","address_line2":"1050 Elsene","description_web":"Spazio Nobile Gallery, de Galerij voor toegepaste kunst, design en fotografie.\r\nEen oase gewijd aan de cultuur van het cre\u00ebren. \r\n\r\nSpazio Nobile Gallery ambieert een oord van kruisbestuiving en dialoog tussen de verschillende\r\ndisciplines design, toegepaste kunst ( metaal, glas, hout en keramiek ) en fotografie, waarbij het accent gelegd wordt op creatie en know-how, en heden en verleden harmonieus samenvloeien.\r\n\r\nSpazio Nobile Gallery is in de eerste plaats het gezamenlijke project van een uiterst complementair koppel kunsthistorici. Lise Coirier is reeds meer dan 20 jaar actief in de wereld van design en creatie. Sinds het begin van haar carri\u00e8re ijvert ze om de ontwerpers, die de materie vorm en leven inblazen, in het voetlicht te plaatsen. Haar echtgenoot Gian Giuseppe Simeone volgt een gelijkaardig traject, maar richt zich eerder op het behoud en de waardering van het artistieke en culturele patrimonium, en hun publieke verspreiding. \r\n","description_print":"Spazio Nobile Gallery, de Galerij voor toegepaste kunst, design en fotografie.\r\nEen plek gewijd aan de cultuur van het cre\u00ebren. \r\n\r\nSpazio Nobile ambieert een oord van kruisbestuiving en dialoog tussen de verschillende\r\ndisciplines design, toegepaste kunst ( metaal, glas, hout en keramiek ) en fotografie, waarbij het accent gelegd wordt op creatie en know-how, en heden en verleden harmonieus samenvloeien.\r\n\r\nSpazio Nobile is in de eerste plaats het gezamenlijke project van een uiterst complementair koppel kunsthistorici. Lise Coirier is reeds meer dan 20 jaar actief in de wereld van design en creatie. Sinds het begin van haar carri\u00e8re ijvert ze om de ontwerpers, die de materie vorm en leven inblazen, in het voetlicht te plaatsen. Haar echtgenoot Gian Giuseppe Simeone volgt een gelijkaardig traject, maar richt zich eerder op het behoud en de waardering van het artistieke en culturele patrimonium, en hun publieke verspreiding. \r\n\r\nMeer dan een \u201cgalerij\u201d in de gewone zin van het woord, wenst Spazio Nobile een plaats te worden waar werk en leven in elkaar overvloeien, waar kennis wordt uitgewisseld, een\r\nesthetische confrontatie opgevat als een volwaardige culturele en zintuigelijke ervaring.","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"http:\/\/www.spazionobilegallery.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":"Spazio Nobile Gallery for applied art, design and photography..\r\nA space dedicated to culture and creation\r\n\r\nHighlighting expertise in design and the applied arts (glass, metal, wood, ceramic, etc.) as well as in photography, Spazio Nobile Gallery aims to create a dialogue between diverse disciplines; a harmonious melange of contemporaneity and sense of history.\r\n\r\nSpazio Nobile Gallery is the shared project of a couple made up of two art historians who have taken complementary paths in their own lives. With more than 20-years in the field of art and design, Lise Coirier has focussed her career on spotlighting designers who infuse matter with form and life. Her husband, Gian Giuseppe Simeone, followed a parallel journey, concentrating on the preservation of cultural and artistic heritage but also public awareness.\r\n","description_print":"Spazio Nobile Gallery for applied art, design and photography opens its doors.\r\nA space dedicated to culture and creation\r\n\r\nHighlighting expertise in design and the applied arts (glass, metal, wood, ceramic, etc.) as well as in photography, Spazio Nobile aims to create a dialogue between diverse disciplines; a harmonious melange of contemporaneity and sense of history.\r\n\r\nSpazio Nobile is the shared project of a couple made up of two art historians who have taken complementary paths in their own lives. With more than 20-years in the field of art and design, Lise Coirier has focussed her career on spotlighting designers who infuse matter with form and life. Her husband, Gian Giuseppe Simeone, followed a parallel journey, concentrating on the preservation of cultural and artistic heritage but also public awareness.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_numbe