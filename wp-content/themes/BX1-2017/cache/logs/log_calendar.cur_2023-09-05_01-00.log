:null,"performers":null,"boxoffice_url":null,"website":"https:\/\/evere.brussels\/fr","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 16","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001494"},"pt":{"name":"Foodtruck Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/evere.brussels\/fr","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 16","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001494"},"en":{"name":"Foodtruck Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/evere.brussels\/fr","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 16","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001494"},"it":{"name":"Foodtruck Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/evere.brussels\/fr","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 16","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001494"},"cn":{"name":"Foodtruck Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/evere.brussels\/fr","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 16","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001494"},"fr":{"name":"Foodtruck Festival","shortdescr":null,"longdescr":"Nous vous attendons le samedi 23 septembre 2023 lors de la premi\u00e8re \u00e9dition du Foodtrucks Festival d\u2019Evere qui aura lieu sur la place Saint-Vincent entre 10h00 et 20h00.\nEn parall\u00e8le de la brocante, organis\u00e9e par l\u2019association des commer\u00e7ant Evere-55-Paix, qui compte des centaines de brocanteurs, ainsi que du Village cr\u00e9atif organis\u00e9 par l\u2019Entrela, vous pourrez retrouver, le Foodtrucks festival pour le plus grand plaisir de vos papilles gustatives.\nUn vaste choix de saveurs vous fera vivre un r\u00e9el tour du monde en vous offrant une exp\u00e9rience culinaire authentique et inoubliable. L\u2019ambiance promet d\u2019y \u00eatre festive dans le cadre magnifique de la place Saint-Vincent.\nCe sera aussi une excellente occasion de profiter, avant sa cl\u00f4ture, de la guinguette du parc Saint-Vincent !","performers":null,"boxoffice_url":null,"website":"https:\/\/evere.brussels\/fr","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 16","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001494"},"sp":{"name":"Foodtruck Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/evere.brussels\/fr","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 16","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001494"},"nl":{"name":"Foodtruck Festival","shortdescr":null,"longdescr":"Wij verwachten u op zaterdag 23 september 2023 op de eerste editie van het Foodtruck Festival van Evere, dat plaatsvindt op het Sint-Vincentiusplein, tussen 10 en 20 uur.\nParallel met de rommelmarkt, georganiseerd door de vereniging van handelaars Evere-55-Paix, die honderden deelnemers telt, en het Creatief dorp, georganiseerd door l\u2019Entrela, kunt u uw smaakpapillen laten verwennen op het Foodtruck Festival.\nEen authentieke en onvergetelijke culinaire ervaring dankzij een ruime keuze van smaken uit de hele wereld. Het schitterende kader van het Sint-Vincentiusplein zorgt voor een feestelijke sfeer.\nEen uitstekende gelegenheid om te genieten van La Guinguette van het Sint-Vincentiuspark, vooraleer dit initiatief de deuren sluit!","performers":null,"boxoffice_url":null,"website":"https:\/\/evere.brussels\/fr","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 16","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001494"}},"place":{"id":206581,"translations":{"de":{"name":"Administration communale d'Evere","address_street_name":"Sq Servaas Hoedemaekers","address_street_number":"10","address_street_box":null,"email":"info@evere.brussels","website":"http:\/\/www.evere.brussels","phone_contact":"+32 2 247 62 62","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Sq Servaas Hoedemaekers, 10","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Administration communale d'Evere","address_street_name":"Sq Servaas Hoedemaekers","address_street_number":"10","address_street_box":null,"email":"info@evere.brussels","website":"http:\/\/www.evere.brussels","phone_contact":"+32 2 247 62 62","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Sq Servaas Hoedemaekers, 10","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Municipality of Evere","address_street_name":"Square Hoedemaekers","address_street_number":"10","address_street_box":null,"email":"info@evere.brussels","website":"http:\/\/www.evere.brussels","phone_contact":"+32 2 247 62 62","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Square Hoedemaekers, 10","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Administration communale d'Evere","address_street_name":"Sq Servaas Hoedemaekers","address_street_number":"10","address_street_box":null,"email":"info@evere.brussels","website":"http:\/\/www.evere.brussels","phone_contact":"+32 2