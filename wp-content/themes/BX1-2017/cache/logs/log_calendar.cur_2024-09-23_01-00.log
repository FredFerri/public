accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["annee_art_nouveau"],"opening":{"day":"2024-05-24","timestamp":"2024-05-24T00:00:00"}},{"id":50011325,"date_start":"2024-05-25","date_end":"2024-12-31","date_next":"2024-09-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-22T02:02:47+02:00","published_at":"2024-06-04T18:28:17+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":301397,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.20839113529372486,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"A Sore Calamity","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lab-an.be\/","email":"info@lab-an.be","phone_contact":"+32 2 303 48 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011325"},"pt":{"name":"A Sore Calamity","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lab-an.be\/","email":"info@lab-an.be","phone_contact":"+32 2 303 48 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011325"},"en":{"name":"A Sore Calamity, by Max Pinckers & Victoria Gonzalez-Figueras","shortdescr":"Taking as their starting point the interweaving of Art Nouveau and colonialism, Max Pinckers and Victoria Gonzalez-Figueras are presenting a photographic exhibition inspired by Mark Twain's pamphlet \u00ab Le soliloque du roi L\u00e9opold \u00bb. Accompanied by the sound work \"Soliloquy in Edmond's Office\" conceived by Wiet Lengeler, the installation takes place in the Hotel van Eetvelde building.","longdescr":"In the pamphlet \"King Leopold\u2019s Soliloquy\", Mark Twain assumes the persona of King Leopold II\nbemoaning the arrival of the camera, the \"incorruptible kodak\", the only witness he \"couldn\u2019t bribe\". To the\nKing\u2019s horror, this new technology was able to bear witness to the atrocities he was committing in Congo, exposing the lies that he\u2019d been able to maintain via the press. To deal with the shocking images of the violent management of Congo Free State, the teams working for van Eetvelde and Leopold II installed one of the first large-scale propaganda operations in the history of tyrannies. Photography became a\nveritable weapon against the Congo Reform Association. A secret service was set up to censor photographers who denounced crimes, torture or rape perpetrated by Belgians in Congo,\nand to bribe others to produce \"good photographs\".\n\nH\u00f4tel van Eetvelde, with its lavish interiors full of imported materials and references to Congo is an excellent example of the link between colonialism and Art Nouveau. This site, where Edmond van Eetvelde, the \u2018minister of Congo\u2019, orchestrated plans and lobbied for the colonization and administration of the Congo Free State, serves as a loaded backdrop.\n\nInspired by Twain and departing from Art Nouveau\u2019s entanglement with colonialism for this in-situ installation, Max Pinckers & Victoria Gonzalez-Figueras made photographs with a Kodak Brownie camera from the early 1900s, not of colonial atrocities in Congo but of locations in the city of Brussels that served as places of power during Leopold II\u2019s ruling of Congo Free State, which facilitated the development of Art Nouveau in Belgium.\n\nSOLILOQUY IN EDMOND'S OFFICE\nHere, photography is not approached as a weapon of imperialism, but as a mechanism for revealing the foundations of colonial exploitation embedded in our immediate surroundings, reminding us of the work that still needs to be done to confront our colonial past.\n\nThis narration is an excerpt of Mark Twain\u2019s King Leopold\u2019s Soliloquy that is digitally played back and re-recorded in Edmond van Eetvelde\u2019s office. Each iteration incorporates the distinctive acoustics of the room. Mirroring the canonical sound art piece I Am Sitting In A Room (1969) by Alvin Lucier, the space gradually shapes the sound of the voice, distorting the original text, rendering it unintelligible and reshaping the characteristics of the soliloquy. Ultimately, the room\u2019s acoustics take over the narrator\u2019s speech, reflecting the specific sonic qualities of the office, located on the second floor of the building.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lab-an.be\/","email":"info@lab-an.be","phone_contact":"+32 2 303 48 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011325"},"it":{"name":"A Sore Calamity","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lab-an.be\/","email":"info@lab-an.be","phone_contact":"+32 2 303 48 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011325"},"cn":{"name":"A Sore Calamity","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lab-an.be\/","email":"info@lab-an.be","phone_contact":"+32 2 303 48 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011325"},"fr":{"name":"A Sore Calamity, by Max Pinckers & Victoria Gonzalez-Figueras","shortdescr":"Prenant comme point de d\u00e9part l\u2019imbrication entre Art nouveau et colonialisme, Max Pinckers et Victoria Gonzalez-Figueras proposent une exposition photographique inspir\u00e9e par le pamphlet \u00ab Le soliloque du roi L\u00e9opold \u00bb de Mark Twain. Accompagn\u00e9e par l\u2019\u0153uvre sonore \"Soliloquy in Edmond\u2019s Office\" con\u00e7ue par Wiet Lengeler, l'installation prend place au sein du b\u00e2timent de l'h\u00f4tel van Eetvelde.","longdescr":"A SORE CALAMITY \nDans le pamphlet \u00ab Le soliloque du roi L\u00e9opold \u00bb, Mark Twain incarne le roi L\u00e9opold II d\u00e9plorant l\u2019apparition de l\u2019appareil photo \u00ab le kodak incorruptible \u00bb, unique t\u00e9moin qu\u2019il ne pourrait soudoyer.\n\nAu grand dam du roi, cette nouvelle technologie permettait de t\u00e9moigner des atrocit\u00e9s qu\u2019il commettait au Congo, en exposant les mensonges pr\u00e9sent\u00e9s par l\u2019interm\u00e9diaire de la presse \u00e0 sa merci. Pour faire face aux images choquantes qui t\u00e9moignent d\u2019une gestion violente de l\u2019EIC, les \u00e9quipes qui travaillent pour van Eetvelde et L\u00e9opold II vont mettre en place l\u2019une des premi\u00e8res op\u00e9rations de propagande d\u2019envergure de l\u2019histoire des tyrannies. La photographie devint une v\u00e9ritable arme contre la Congo Reform Association. Un service secret fut cr\u00e9\u00e9 pour censurer les photographes d\u00e9non\u00e7ant les meurtres, tortures et viols perp\u00e9tr\u00e9s par les Belges du Congo et pour en soudoyer d\u2019autres charg\u00e9s de produire de \u00ab bonnes photographies \u00bb.\n\nL\u2019h\u00f4tel van Eetvelde, avec ses int\u00e9rieurs somptueux faits de mat\u00e9riaux import\u00e9s et pr\u00e9sentant des r\u00e9f\u00e9rences au Congo est un excellent exemple du lien entre le colonialisme et l\u2019Art nouveau. Ce lieu o\u00f9 Edmond van Eetvelde, le \u00ab Ministre du Congo \u00bb, a orchestr\u00e9 la colonisation et l\u2019administration de l\u2019Etat Ind\u00e9pendant du Congo, sert de d\u00e9cor au projet.\n\nPour cette installation in situ, inspir\u00e9s par Twain et prenant comme point de d\u00e9part l\u2019imbrication entre Art nouveau et colonialisme, Max Pinckers et Victoria Gonzalez-Figueras ont r\u00e9alis\u00e9 avec un appareil Kodak Brownie du d\u00e9but des ann\u00e9es 1900, des photographies, non pas des atrocit\u00e9s coloniales commises\nau Congo, mais de lieux de la R\u00e9gion bruxelloise qui ont servi d\u2019espaces de pouvoir durant le r\u00e8gne de L\u00e9opold II au Congo, facilitant le d\u00e9veloppement de l\u2019Art nouveau en Belgique.\n\nIci, les photographies ne sont plus des armes de l\u2019imp\u00e9rialisme, mais servent de m\u00e9canismes pour r\u00e9v\u00e9ler les fondations de l\u2019exploitation coloniale ancr\u00e9s dans notre environnement imm\u00e9diat, nous rappelant le travail qui reste \u00e0 faire pour affronter notre pass\u00e9 colonial.\n\nSOLILOQUY IN EDMOND'S OFFICE\nCette narration est un extrait du King Leopold\u2019s Soliloquy de Mark Twains qui est diffus\u00e9 et r\u00e9enregistr\u00e9 plusieurs fois dans le bureau d\u2019Edmond van Eetvelde, int\u00e9grant l\u2019acoustique particuli\u00e8re de la pi\u00e8ce. \u00c0 l\u2019image de l\u2019\u0153uvre d\u2019art sonore canonique I Am Sitting In A Room (1969) d\u2019Alvin Lucier, l\u2019espace fa\u00e7onne progressivement le son de la voix, d\u00e9formant le texte original, le rendant inintelligible et remodelant les caract\u00e9ristiques du soliloque. L\u2019acoustique de la pi\u00e8ce finit par remplacer le discours du narrateur, refl\u00e9tant les sp\u00e9cificit\u00e9s sonores du bureau situ\u00e9 au deuxi\u00e8me \u00e9tage de ce b\u00e2timent.","performers":"Max Pinckers (documentariste sp\u00e9culatif, enseignant et chercheur)\nVictoria Gonzalez-Figueras (chercheuse et productrice)\nWiet Lengeler (artiste audiovisuel et musicien)","boxoffice_url":null,"website":"https:\/\/www.lab-an.be\/","email":"info@lab-an.be","phone_contact":"+32 2 303 48 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011325"},"sp":{"name":"A Sore Calamity","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lab-an.be\/","email":"info@lab-an.be","phone_contact":"+32 2 303 48 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011325"},"nl":{"name":"A Sore Calamity, by Max Pinckers & Victoria Gonzalez-Figueras","shortdescr":"Met als uitgangspunt de vervlechting van Art Nouveau en kolonialisme presenteren Max Pinckers en Victoria Gonzalez-Figueras een fototentoonstelling ge\u00efnspireerd op Mark Twains pamflet \u00ab Le soliloque du roi L\u00e9opold \u00bb. Begeleid door het geluidswerk \"Soliloquy in Edmond's Office\", bedacht door Wiet Lengeler, vindt de installatie plaats in het gebouw van Hotel van Eetvelde.","longdescr":"In het pamflet King Leopold\u2019s Soliloquy\" kruipt Mark Twain in de huid van Koning Leopold II die zich beklaagt over de komst van de camera, de \"onomkoopbare kodak\", de enige getuige die hij \"niet kon omkopen\".\n\nTot grote ergernis van de koning maakte deze nieuwe technologie het mogelijk om te getuigen van de wreedheden die hij beging in Congo, door de leugens te ontmaskeren die via de pers aan hem werden gepresenteerd. Om het hoofd te bieden aan de schokkende beelden die getuigden van het gewelddadige beheer van de EIC, zetten de teams die voor van Eetvelde en Leopold II werkten een van de eerste grootschalige propaganda-operaties op in de geschiedenis van tirannie\u00ebn. Fotografie werd een echt wapen tegen de Congo Reform Association. Er werd een geheime dienst opgericht om fotografen te censureren die de moorden, martelingen en verkrachtingen door de Belgen in Congo aan de kaak stelden en om anderen om te kopen om \"goede foto's\" te produceren.\n\nHuis van Eetvelde, met zijn weelderige interieur van ge\u00efmporteerde materialen en verwijzingen naar Congo, is een uitstekend voorbeeld van de link tussen kolonialisme en Art Nouveau. De plaats waar Edmond van Eetvelde, de 'Minister van Congo', de kolonisatie en het bestuur van de Onafhankelijke Staat Congo organiseerde, dient als decor voor het project.\n\nGe\u00efnspireerd door Twain en vertrekkend van de verstrengeling van Art Nouveau met kolonialisme maakten Pinckers & Gonzalez-Figueras voor deze in situ installatie foto\u2019s met een Kodak Brownie camera uit het begin van 1900, niet van koloniale wreedheden in Congo maar van locaties in de stad Brussel die dienst\ndeden als machtscentra tijdens Leopold II\u2019s bewind over de Onafhankelijke Congostaat, die de ontwikkeling van Art Nouveau in Belgi\u00eb bevorderde.\n\nFotografie wordt hier niet benaderd als een wapen van het imperialisme, maar als een mechanisme om de fundamenten van koloniale uitbuiting te onthullen die vandaag nog in onze onmiddellijke omgeving verankerd liggen en ons herinneren aan het werk nodig om ons koloniale verleden te confronteren.\n\nSOLILOQUY IN EDMOND'S OFFICE\nEen fragment uit Mark Twain\u2019s King Leopold\u2019s Soliloquy wordt digitaal afgespeeld en opnieuw opgenomen in het kantoor van Edmond van Eetvelde. Bij elke herhaling draagt de akoestiek van de kamer de kenmerken en resonantie over op de tekst. In navolging van het canonieke geluidskunstwerk I Am Sitting In A Room (1969) van Alvin Lucier geeft de ruimte geleidelijk aan vorm aan het geluid van de stem, waardoor de oorspronkelijke tekst vervormd, onverstaanbaar wordt en de karakteristieken van de soliloquy\nveranderen bij elke heropname. Uiteindelijk verdringt de akoestiek van de kamer de stem van de verteller en weergalmt nog slechts de specifieke geluidskwaliteit van het kantoor dat zich op de tweede verdieping\nvan het gebouw bevindt.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lab-an.be\/","email":"info@lab-an.be","phone_contact":"+32 2 303 48 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011325"}},"place":{"id":242040,"translations":{"de":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Av. Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Av. Palmerston, 2","address_line2":"1000 Bruxelles","description_web":"Das Maison van Eetvelde ist ein bemerkenswertes Jugendstilbauwerk aus der Feder von Victor Horta, das 1895-1898 im Auftrag des Diplomaten Edmond Van Eetvelde erbaut wurde. Das Geb\u00e4ude z\u00e4hlt zum UNESCO-Weltkulturerbe.\r\n\r\nDas Geb\u00e4ude wurde 1895 von Edmond Van Eetvelde, seinerzeit Diplomat und Generalsekret\u00e4r im Kongo, in Auftrag gegeben. Sehenswert sind die Eisentr\u00e4ger aus Flacheisen (wie im Industriebereich) statt aus Schmiedeeisen, die Mosaike, der glas\u00fcberdachte Innenhof und die Blumenmotive des Esszimmers.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Brussels","description_web":"According to Horta himself, the plans for this house, conceived in 1895, were the most audacious he ever drew. And he did so for a prominent figure, as the client, Baron Edmond van Eetvelde, was the Secretary General of the Independent State of Congo - in reality the unofficial 'Minister of the Congo' - and, therefore, a very close ally of King Leopold II. \r\n\r\nThe future owner asked the architect for a house 'for his family', but with as large a living room and dining room as possible, given his frequent social engagements. \r\n\r\nThe house is unusual in that it is flanked by two other buildings: a building to the left of it, which was intended to serve both as an extension to the original house and as a rental house and a building to the right of it, a small annex to the main house. ","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=EN","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Hotel van Eetvelde & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":"Selon les dires de Horta lui-m\u00eame, le plan de cette maison, con\u00e7u en 1895, est le plus audacieux qu\u2019il ait dessin\u00e9\u2026 Et c\u2019est encore au profit d\u2019une personnalit\u00e9 qu\u2019il le fait, puisque le commanditaire, le baron Edmond van Eetvelde, est le secr\u00e9taire g\u00e9n\u00e9ral de l\u2019\u00c9tat ind\u00e9pendant du Congo \u2014 dans les faits v\u00e9ritable \u00ab ministre du Congo \u00bb \u2014, et donc un tr\u00e8s proche collaborateur du roi L\u00e9opold II. \r\n\r\nLe futur propri\u00e9taire r\u00e9clame \u00e0 l\u2019architecte une maison \u00ab pour sa famille \u00bb, mais comportant, au vu de ses obligations mondaines, un salon et une salle \u00e0 manger aussi grands que possible. \r\n\r\nLa maison offre la particularit\u00e9 d\u2019\u00eatre flanqu\u00e9e de deux autres \u00e9difices, de part et d\u2019autre : un immeuble \u00e0 sa gauche, devant \u00e0 la fois servir d\u2019agrandissement \u00e0 la maison initiale et de maison de location ; un b\u00e2timent \u00e0 sa droite, petite annexe \u00e0 l\u2019habitation principale. ","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=FR","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Van Eetveldehotel & LAB\u00b7An","address_street_name":"Palmerstonlaan","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Palmerstonlaan, 2","address_line2":"1000 Brussel","description_web":"Volgens Victor Horta zelf was het plan voor dit huis in 1895 het meest gedurfde dat hij ooit had ontworpen. De opdrachtgever was ook niet de eerste de beste: baron Edmond van Eetvelde was de secretaris-generaal van de onafhankelijke staat Congo - de 'minister van Congo', zeg maar - en dus een zeer naaste medewerker van koning Leopold II. \r\n\r\nDe toekomstige eigenaar vroeg de architect om een huis \u2018voor zijn gezin,\u2019 maar met een zo groot mogelijke woonkamer en eetkamer met het oog op zijn sociale verplichtingen. \r\n\r\nBijzonder is dat het huis in feite een drie-eenheid is. Het wordt geflankeerd door twee andere gebouwen: een gebouw links van het huis, dat zowel als uitbreiding van het oorspronkelijke huis als als huurhuis moest dienen, en een gebouw rechts van het huis, een klein bijgebouw bij het hoofdhuis. ","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=NL","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":4486,"location":{"lat":50.84720217,"lon":4.38039568},"region":"brussels","last_updated_at":"2023-08-09T11:32:14+02:00","published_at":"2013-10-19T01:17:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":247371,"translations":{"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Brussels","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi...\r\nLe Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi. Sotto il patrocinio della regione di Bruxelles Capitale.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Remarquable t\u00e9moin de l\u2019architecture des march\u00e9s couverts, les Halles Saint-G\u00e9ry  contribuent \u00e0 valoriser le patrimoine de la R\u00e9gion de Bruxelles-Capitale. Centre d\u2019exposition et de manifestation bas\u00e9 en plein coeur du pentagone, elles ont pour vocation de mettre en valeur les traits de d\u00e9marcation du cadre de vie bruxellois et de son identit\u00e9 urbaine par le biais d'une programmation hybride, allant des expositions, aux conf\u00e9rences, concerts, rencontres et performances \u2026\r\nLe Centre Urbain (guichet d\u2019information r\u00e9gional, pour mieux vous conseiller sur l\u2019habitat durable en R\u00e9gion de Bruxelles-Capitale) est \u00e9galement situ\u00e9 au sein des Halles.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Verdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio...\r\nVerdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio y al marco de vida de los bruselenses.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Sint-Gorikshallen","address_street_name":"Sint-Goriksplein","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sint-Goriksplein","address_line2":"1000 Brussel","description_web":"De Sint-Gorikshallen zijn een prachtig architecturaal staaltje van openbare markthallen in het 19de-eeuwse Brussel. Het gebouw werd een aantal jaren geleden volledig gerestaureerd en doet tegenwoordig dienst als permanente informatie-, tentoonstellings- en evenementenruimte gewijd aan het erfgoed en de levenswijzen in de hoofdstad. Op amper twee minuten stappen van de Beurs vormen de Sint-Gorikshallen een gezellige plek om te ontspannen en nieuwe dingen te ontdekken, zowel overdag als bij het vallen van de nacht.\r\nDe hallen herbergen ook de Stadswinkel, een vereniging die de inwoners van het Brussels Hoofdstedelijk Gewest  wil informeren over het leefmilieu en een kwaliteitsvolle leefomgeving, huisvesting, stadsrenovatie, stedenbouw en ruimtelijke ordening, en rationeel energiegebruik. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":9562,"location":{"lat":50.84801328,"lon":4.34683241},"last_updated_at":"2024-05-08T15:56:31+02:00","published_at":"2013-10-19T01:26:22+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/6c62551ef6db736c6e524876afbbe1b2f688c7aa.jpg","width":7018,"height":4714,"ratio":1.49,"oEmbed_height":4714,"oEmbed_width":7018,"translations":{"de":{"title":"A Sore Calamity","copyright":"\u00a9 Maxime Baldewyns"},"pt":{"title":"A Sore Calamity","copyright":"\u00a9 Maxime Baldewyns"},"en":{"title":"A Sore Calamity","copyright":"\u00a9 Maxime Baldewyns"},"it":{"title":"A Sore Calamity","copyright":"\u00a9 Maxime Baldewyns"},"cn":{"title":"A Sore Calamity","copyright":"\u00a9 Maxime Baldewyns"},"fr":{"title":"A Sore Calamity","copyright":"\u00a9 Maxime Baldewyns"},"sp":{"title":"A Sore Calamity","copyright":"\u00a9 Maxime Baldewyns"},"nl":{"title":"A Sore Calamity","copyright":"\u00a9 Maxime Baldewyns"}}}],"dates":[{"day":"2024-05-25","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-05-26","doors":null,"start":"10:00:00","end":"17:00:00","end_night_li