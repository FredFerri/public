3:00:00","end":"17:30:00"}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":4},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":2},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":2},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Jobseekers"}},"value":2},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[4,5,16,11,10,7,8,19],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Ecoles","Famille","Seniors","Jeunes 12-15 ans","Jeunes 15-18 ans","Enseignants"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Scholen","Familie","Senioren","Jongeren 12-15 j.","Jongeren 15-18 j.","Leerkrachten"],"en":["Children 6-9 yr.","Children 9-12 yr.","Schools","Family","Seniors","Youth 12-15  yr.","Youth 15-18  yr.","Teachers"]}},"educational_targets":{"list":[2,3],"translations":{"fr":["Primaire","Secondaire"],"nl":["Lagere school","Secundair onderwijs"],"en":["Primary school","Secondary school"]}},"tags":["kids"],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:07:55+02:00","published_at":"2021-09-01T13:05:55+02:00","backoffice_id":238227,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.17912254476758},{"id":512748,"date_start":"2022-05-11","date_end":"2022-06-25","date_next":"2022-06-10","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le bon Docteur Gasparri","shortdescr":null,"longdescr":"\u00c9t\u00e9 1932. La crise \u00e9conomique mondiale cons\u00e9cutive au krach boursier de 1929 fait rage. L\u2019Europe assiste, impuissante, \u00e0 la mont\u00e9e des extr\u00e9mismes. Les tensions sociales et politiques mettent la Belgique sens dessus dessous. Dans ce contexte chahut\u00e9, le brave docteur Gasparri, modeste m\u00e9decin de quartier \u00e0 Bruxelles, re\u00e7oit un couple de jeunes immigr\u00e9s italiens, originaires de la m\u00eame r\u00e9gion que lui. Une succession d\u2019\u00e9v\u00e9nements et de rencontres inattendues vont, s\u2019encha\u00eener, bousculant cet homme discret hors de sa zone de confort, l\u2019obligeant \u00e0 faire des choix. Lui qui n\u2019aspirait qu\u2019\u00e0 venir en aide \u00e0 son prochain, le voil\u00e0 pris dans les mensonges et les manipulations, les filets de la grande Histoire. Pourtant, il ne s\u2019int\u00e9ressait pas aux bruits du monde, alors pourquoi alors est-il interrog\u00e9 par la police ? De quoi l\u2019accuse-t-on ? \r\n\r\nAdapt\u00e9 du roman, plusieurs fois prim\u00e9, L\u2019audition du docteur Fernando Gasparri, avec Fabrizio Rongione dans le r\u00f4le-titre, entour\u00e9 d\u2019une galerie de personnages troubles ou bienveillants, le spectacle relate en un v\u00e9ritable suspens, quelques \u00e9pisodes sombres de notre Histoire. il s\u2019interroge sur notre capacit\u00e9 de discernement et sur la vigilance \u00e0 avoir face \u00e0 la manipulation et aux mensonges qui nous entourent.\r\n\r\nUne production du Th\u00e9\u00e2tre Le Public. Avec le soutien du Tax Shelter de L\u2019\u00c9tat F\u00e9d\u00e9ral Belge via Belga Films Fund et de la Communaut\u00e9 Fran\u00e7aise.","performers":"De et Mise en sc\u00e8ne Gabriel Alloing et Michelangelo Marchese | Avec Othmane Moumen, Mathilde Rault et Fabrizio Rongione | Assistante \u00e0 la mise en sc\u00e8ne Claire Beugnies | Sc\u00e9nographie et costumes Gabriel Alloing et Alain Collet | Lumi\u00e8re Alain Collet  | \r\nD'apr\u00e8s \"L'Audition du Docteur Fernando Gasparri\" de Giuseppe Santoliquido","boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 80 09 44 44","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/512748.html"},"nl":{"name":"Le bon Docteur Gasparri","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/512748.html"},"en":{"name":"Le bon Docteur Gasparri","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/512748.html"},"de":{"name":"Le bon Docteur Gasparri","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/512748.html"},"it":{"name":"Le bon Docteur Gasparri","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/512748.html"},"sp":{"name":"Le bon Docteur Gasparri