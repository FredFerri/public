d":"2024-12-22","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700001723,"date_start":"2024-09-21","date_end":"2024-10-31","date_next":"2024-10-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-26T03:01:07+02:00","published_at":"2024-09-24T17:12:52+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":308373,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2900049301676267,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Damien Bassez : \"A Swim Through Summer\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.art-yi.com\/fr","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001723"},"pt":{"name":"Damien Bassez : \"A Swim Through Summer\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.art-yi.com\/fr","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001723"},"en":{"name":"Damien Bassez : \"A Swim Through Summer\"","shortdescr":"\u2022 In the heart of Brussels, where art meets enchantment, the Art Yi Gallery proudly presents an extraordinary journey into a unique dream of a summer. \"Blue Horizons: A Swim through Summer\" invites you to step into the captivating world of French artist Damien Bassez, where imagination knows no bounds, and the wonder of feminity and freedom is reborn in magnificent swimming paintings.","longdescr":"\u2022 Damien Bassez's contemporary portrayal of women is a harmonious blend of artistic innovation and cultural reverence. Through a meticulous interplay of color, form, and cultural symbolism, the artist invites viewers to explore a world where tradition meets modernity, and where the strength and grace of femininity are celebrated with every brushstroke.\n \n\u2022 The gaze of each subject in Damien Bassez's paintings is an entry point into a world of depth and emotion. The eyes, profound and expressive, are windows to the soul, conveying a fiery confidence that resonates with the viewer. It is as if the artist has captured not only the external beauty but also the internal strength and spirit of these women. Their collective presence on canvas exudes an aura of empowerment, each figure standing as a testament to the resilience and grace embedded in the cultural fabric they represent.\n\n\u2022 Born in 1976 in Valenciennes, where he lives and works, Damien Bassez studied fine arts at Lille. As a self-taught artist, he dedicates his energy to painting. This enchanting exhibition unveils remarkable paintings of swim and summer, showcasing the latest creations in 2024 by the artist. With tender craftsmanship, he breathes life into beloved women. Each painting is a testament to the artist's remarkable skill and his profound connection with the natural world.\n\n\u2022 HOW TO COME: \nStation (Train\/Subway) : Brussels Central \nPark : Interparking Albertine Square (100m)  \n3 Rue des Sols | 1000 | Brussels","performers":"Damien Bassez (French painter)","boxoffice_url":null,"website":"http:\/\/www.art-yi.com","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001723"},"it":{"name":"Damien Bassez : \"A Swim Through Summer\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.art-yi.com\/fr","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001723"},"cn":{"name":"Damien Bassez : \"A Swim Through Summer\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.art-yi.com\/fr","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001723"},"fr":{"name":"Damien Bassez : \u00ab Une nage \u00e0 travers l'\u00e9t\u00e9 \u00bb","shortdescr":"Au c\u0153ur de Bruxelles, l\u00e0 o\u00f9 l'art rencontre l'enchantement, la Galerie Art Yi pr\u00e9sente fi\u00e8rement des cr\u00e9atures fantasques qui nous font retrouver dans un r\u00eave d'\u00e9t\u00e9 unique. \u00ab Horizons bleus : une baignade \u00e0 travers l'\u00e9t\u00e9 \u00bb vous invite \u00e0 p\u00e9n\u00e9trer dans l\u2019univers captivant de l'artiste fran\u00e7aise Damien Bassez, univers dans lequel  l'imagination ne conna\u00eet pas de limites.  Laissons-nous \u00e9merveiller !","longdescr":"\u2022 La repr\u00e9sentation contemporaine par Damien Bassez des femmes  est un m\u00e9lange harmonieux d'innovation artistique et de r\u00e9v\u00e9rence culturelle. \u00c0 travers une interaction m\u00e9ticuleuse de couleur, de forme et de symbolisme culturel, l'artiste invite les spectateurs \u00e0 explorer un monde o\u00f9 la tradition rencontre la modernit\u00e9, et o\u00f9 la force et la gr\u00e2ce de la f\u00e9minit\u00e9 sont c\u00e9l\u00e9br\u00e9es \u00e0 chaque coup de pinceau.\n \n\u2022 Le regard de chaque sujet dans les tableaux de Bassez est une porte d'entr\u00e9e vers un monde de profondeur et d'\u00e9motion. Les yeux, profonds et expressifs, sont des fen\u00eatres vers l'\u00e2me, transmettant une confiance ardente qui r\u00e9sonne avec le spectateur. C'est comme si l'artiste avait captur\u00e9 non seulement la beaut\u00e9 externe, mais aussi la force interne et l'esprit de ces femmes. Leur pr\u00e9sence collective sur la toile \u00e9mane une aura d'autonomisation, chaque figure servant de t\u00e9moignage \u00e0 la r\u00e9silience et \u00e0 la gr\u00e2ce inscrites dans le tissu culturel qu'elles repr\u00e9sentent.\n\n\u2022 N\u00e9 en 1976 \u00e0 Valenciennes o\u00f9 il vit et travaille, Damien Bassez a fait des \u00e9tudes en facult\u00e9 d\u2019arts \u00e0 Lille. Artiste autodidacte, il consacre son \u00e9nergie \u00e0 la peinture.  Cette exposition enchanteresse d\u00e9voile les nouvelle peintures remarquables, pr\u00e9sentant les derni\u00e8res cr\u00e9ations de l'artiste en 2024. Avec une parfaite ma\u00eetrise de son art, il insuffle la vie \u00e0 ses femmes. Chaque oeuvre t\u00e9moigne du talent exceptionnel de l'artiste et de sa profonde connexion avec le monde contemporain.\n\n\u2022 COMMENT VENIR :\nGare (Train\/M\u00e9tro) : Bruxelles-Central\nParking : Interparking Albertine Square (\u00e0 100m)\n3 Rue des Sols | 1000 | Bruxelles","performers":"Damien Bassez (peintre fran\u00e7ais)","boxoffice_url":null,"website":"http:\/\/www.art-yi.com\/fr","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001723"},"sp":{"name":"Damien Bassez : \"A Swim Through Summer\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.art-yi.com\/fr","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001723"},"nl":{"name":"Damien Bassez: \"Een duik door de zomer\"","shortdescr":"\u2022 In het hart van Brussel, presenteert de Art Yi Gallery met trots een buitengewone reis in een unieke zomerdroom. \"Blauwe Horizonten: Een Zwemtocht door de Zomer\" nodigt je uit om binnen te stappen in de betoverende wereld van de Franse kunstenaar Damien Bassez, waar de verbeelding geen grenzen kent en de verwondering van vrouwelijkheid en vrijheid herboren wordt in prachtige zwemschilderijen.","longdescr":"\u2022 De eigentijdse weergave van vrouwen door Damien Bassez is een harmonieuze mix van artistieke innovatie en culturele eerbied. Via een nauwgezette interactie van kleur, vorm en cultureel symbolisme nodigt de kunstenaar kijkers uit om een wereld te verkennen waar traditie moderne invloeden ontmoet, en waar de kracht en gratie van de vrouwelijkheid worden gevierd met elke penseelstreek.\n \n\u2022 De blik van elk onderwerp in de schilderijen van Damien Bassez is een toegangspoort tot een wereld van diepte en emotie. De ogen, diep en expressief, zijn vensters naar de ziel en stralen een vurig zelfvertrouwen uit dat resoneert met de kijker. Het is alsof de kunstenaar niet alleen de externe schoonheid, maar ook de interne kracht en geest van deze vrouwen heeft vastgelegd. Hun gezamenlijke aanwezigheid op het doek straalt een aura van empowerment uit, waarbij elke figuur een getuigenis is van de veerkracht en gratie die verweven zijn in het culturele weefsel dat ze vertegenwoordigen.\n\n\u2022 Geboren in 1976 in Valenciennes, waar hij woont en werkt, studeerde Damien Bassez schone kunsten in Lille. Als autodidactische kunstenaar wijdt hij zijn energie aan schilderen. Deze betoverende tentoonstelling onthult opmerkelijke schilderijen van zwemmen en zomer, waarin de nieuwste creaties van 2024 door de kunstenaar worden getoond. Met tedere vakmanschap brengt hij geliefde vrouwen tot leven. Elk schilderij is een getuigenis van het opmerkelijke talent van de kunstenaar en zijn diepe verbondenheid met de natuur.\n\n\u2022 HOE TE BEREIKEN:\nStation (Trein\/Metro): Brussel-Centraal\nParkeerplaats: Interparking Albertine Square (100m)\n3 Rue des Sols | 1000 | Brussel","performers":"Damien Bassez (Franse schilder)","boxoffice_url":null,"website":"http:\/\/www.art-yi.com\/nl","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001723"}},"place":{"id":279896,"translations":{"de":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Brussels","description_web":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","description_print":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com","visit_url":null},"it":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","description_print":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com\/fr\/","visit_url":null},"sp":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Art Yi","address_street_name":"Magdalenasteenweg","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Magdalenasteenweg, 59","address_line2":"1000 Brussel","description_web":" Gelegen in het Monts des Arts Museum gebied en vlakbij het Brussel-Centraal station en de Grote Markt, is Art Y\u012b een hedendaagse kunstgalerie die jaarlijks miljoenen internationale toeristen ontvangt en kunstverzamelaars van over de hele wereld bedient.\r\n \r\n\u2022 Art Y\u012b biedt een unieke ervaring van hedendaagse kunst uit verschillende culturen. De galerie presenteert een brede selectie van beeldhouwwerken en schilderijen uit Europa en Azi\u00eb. Opgericht door Shuo LIU, heeft Art Y\u012b een rijke erfenis van 40 jaar Belgische galerie.\r\n\r\nOnze 5 categorie\u00ebn\r\n\u2022 Beeldhouwwerken\r\n\u2022 Schilderijen\r\n\u2022 Installatie kunst\r\n\u2022 Keramiek\r\n\u2022 Antiek\r\n\r\n\u2022 Een vorm van samensmelting in de kunst, een reis van traditie naar hedendaags, van oost naar west, leidend tot diversiteit die buiten tijd en ruimte leeft. We bieden een unieke versie van hedendaagse kunst die spreekt tot iedereen in een universele taal. \r\n\r\n\u2022 Of u nu een ervaren verzamelaar bent of pas begint met het verkennen van de kunstwereld, voor professionele doeleinden of priv\u00e9verzameling, we hebben iets te bieden. Onze collectie omvat een diverse selectie van hoogwaardige kunstwerken, vari\u00ebrend van hedendaagse tot traditionele stukken. We stellen elke kunstwerk zorgvuldig samen om ervoor te zorgen dat het voldoet aan onze hoge normen van kwaliteit en excellentie.\r\n \r\n\u2022 Bij Art Y\u012b, naast onze uitzonderlijke collectie, zijn we toegewijd aan het bieden van een onge\u00ebvenaarde ervaring aan onze klanten. Het verwerven van een kunstwerk is een uniek moment. Om deze magie mogelijk te maken, biedt Art Y\u012b verschillende financieringsoplossingen zoals Art Leasing en\/of Art Renting met een koopoptie die het best past bij het professionele profiel en voordelen biedt om kunst te verwerven. Ons team van experts staat altijd klaar om persoonlijke begeleiding en ondersteuning te bieden, van het selecteren van het perfecte stuk tot het vinden van de beste financi\u00eble oplossingen.\r\n \r\n\u2022 Bij Art Y\u012b zijn we gepassioneerd door kunst en toegewijd om onze klanten het allerbeste te bieden. Sluit u aan bij ons op onze missie om kunst naar de wereld te brengen en ontdek de exclusieve voordelen van het verzamelen van kunst bij ons:\r\n- Ontvang ons gepersonaliseerde lidmaatschapsaanbod voor uw 1e collectie!\r\n- Geniet van gratis wereldwijde kunstverzending\r\n- Heb als eerste toegang tot onze nieuwe kunstwerken & tentoonstellingen\r\n- Woon onze Vernissages & Kunstbeurzen bij met VIP-toegang","description_pr