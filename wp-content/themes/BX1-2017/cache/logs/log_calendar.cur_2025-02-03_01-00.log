,"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"Exposition Art Eleonor Soler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005586"},"pt":{"name":"Exposition Art Eleonor Soler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005586"},"en":{"name":"Exposition Art Eleonor Soler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005586"},"it":{"name":"Exposition Art Eleonor Soler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005586"},"cn":{"name":"Exposition Art Eleonor Soler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005586"},"fr":{"name":"Exposition Art El\u00e9onore Soler","shortdescr":"KALAMITY VINTAGE pr\u00e8s de la place Fernand Cocq, est heureuse de pr\u00e9senter une exposition de l\u2019artiste fran\u00e7aise El\u00e9onore Soler du 7 au 13 f\u00e9vrier 2025 au sein de sa boutique.\nLe vernissage aura lieu le vendredi 7 f\u00e9vrier \u00e0 partir 17h jusque 22h et est ouvert au public.\n","longdescr":"El\u00e9onore Soler est une jeune artiste qui aborde fr\u00e9quemment des questionnements relatifs \u00e0 l\u2019enfance, \u00e0 l\u2019identit\u00e9 ou encore au territoire et \u00e0 sa m\u00e9moire. \nNow, I have been an adult longer than I have been a child est une exposition qui vient explorer \u00e0 travers diff\u00e9rents travaux, principalement des dessins, les th\u00e9matiques \u00e9nonc\u00e9es ci-dessus. \nLes dessins au graphite ou aux crayons de couleurs sont r\u00e9alis\u00e9s d\u2019apr\u00e8s des photos de famille ; La narration entre ces diff\u00e9rents r\u00e9cits vient tisser des liens fictifs ou r\u00e9els qui nous plongent dans des souvenirs, des lieux, des visages. Sommes-nous habitants des lieux o\u00f9 l\u2019on vit ou habit\u00e9s par ces lieux et les souvenirs qui en d\u00e9coulent ? Les premi\u00e8res ann\u00e9es de vie s\u2019\u00e9loignent, peut-\u00eatre que les contours se troublent mais quelque part reste enfoui l\u2019enfant que l\u2019on a \u00e9t\u00e9.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005586"},"sp":{"name":"Exposition Art Eleonor Soler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_cont