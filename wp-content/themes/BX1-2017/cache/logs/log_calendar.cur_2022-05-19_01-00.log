":0.15021939019982},{"id":533031,"date_start":"2022-05-06","date_end":"2022-05-29","date_next":"2022-05-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,35],"translations":{"fr":["Galeries d'art","Bande dessin\u00e9e"],"nl":["Galeries","Stripverhaal"],"en":["Art Galleries","Comicstrip"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"\u00ab 4 regards \u00bb de Jo\u00eblle Duli\u00e8re, Laurent Carpentier, Louis-Michel Carpentier & Natacha De Locht","shortdescr":"4 artistes tant\u00f4t peintres, dessinateurs, illustrateurs et infographistes vous pr\u00e9sentent 4 univers artistiques qui tournent en partie autour du monde de la BD mais pas seulement... \r\nCette exposition regroupe des tableaux humoristiques dont certains r\u00e9tro-\u00e9clair\u00e9s, des tableaux, des photos, des sculptures dr\u00f4les et d\u00e9cal\u00e9es, des livres pour enfants et des BD.","longdescr":"4 artistes tant\u00f4t peintres, dessinateurs, illustrateurs et infographistes vous pr\u00e9sentent 4 univers artistiques qui tournent en partie autour du monde de la BD mais pas seulement... \r\nCette exposition regroupera des tableaux humoristiques dont certains r\u00e9tro-\u00e9clair\u00e9s, des tableaux sur toile et sur carton, des photos, des sculptures dr\u00f4les et d\u00e9cal\u00e9es, des livres pour enfants et des bandes dessin\u00e9es. \r\n\r\nLe weekend du 21 \u2013 22 mai, une rencontre avec les artistes et des s\u00e9ances de d\u00e9dicaces seront au programme.  \r\n\u2139 D\u00e9tails concernant le weekend du 21-22 mai :\r\nJo\u00eblle vous d\u00e9dicacera le recueil de po\u00e9sie \"Abysses\" que j'elle a illustr\u00e9 et le jeu de cartes \"petits bonheurs simples\".\r\nLouis-Michel vous d\u00e9dicacera ses bandes dessin\u00e9es.\r\nNatacha et Laurent vous d\u00e9dicaceront leurs livres p\u00e9dagogiques pour enfants\r\nEt, ils seront tous ravis de r\u00e9pondre \u00e0 toutes vos questions concernant le processus cr\u00e9atif.","performers":"Jo\u00eblle Duli\u00e8re (tableaux), Laurent Carpentier (BD, illustrations et sculptures), Louis-Michel Carpentier (BD) & Natacha De Locht (livres pour enfants et tableaux)","boxoffice_url":null,"website":"https:\/\/www.montdepiete.be\/expo-4-regards","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":"+32 2 512 13 85","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533031.html"},"nl":{"name":"\u00ab 4 visies \u00bb door Jo\u00eblle Duli\u00e8re, Laurent Carpentier, Louis-Michel Carpentier & Natacha De Locht","shortdescr":"4 kunstenaars, zowel schilders, tekenaars, illustratoren als computergrafici stellen 4 artistieke werelden voor die deels, zij het niet uitsluitend, over het stripverhaal gaan\u2026 \r\nDeze tentoonstelling brengt humoristische prenten waarvan sommigen gepresenteerd als een lichtreclame, andere geschilderd, maar ook foto's, grappige en eigenzinnige beeldhouwwerken, kinderboeken en strips","longdescr":"4 kunstenaars, zowel schilders, tekenaars, illustratoren als computergrafici stellen 4 artistieke werelden voor die deels, zij het niet uitsluitend, over het stripverhaal gaan\u2026 \r\nDeze tentoonstelling brengt humoristische prenten waarvan sommigen gepresenteerd als een lichtreclame, andere geschilderd op doek en karton, maar ook foto's, grappige en eigenzinnige beeldhouwwerken, kinderboeken en strips. \r\n \r\nTijdens het weekend van 21 en 22 mei staan een ontmoeting met de kunstenaars en signeersessies op het programma.  \r\n\r\n\u2139 In verband met het weekend van 21-22 mei: \r\nJo\u00eblle signeert de door haar ge\u00efllustreerde dichtbundel \"Abysses\" en het kaartspel \"petits bonheurs simples\".\r\nLouis-Michel zal zijn strips signeren.\r\nNatacha en Laurent zullen hun educatieve boeken voor kinderen signeren.\r\nBovendien zullen zij graag op al uw vragen antwoorden over het creatieve proces.","performers":"Jo\u00eblle Duli\u00e8re (schilderijen), Laurent Carpentier (strips, illustraties en beeldhouwwerken), Louis-Michel Carpentier (strips) & Natacha De Locht (kinderboeken en schilderijen)","boxoffice_url":null,"website":"https:\/\/www.bergvanbarmhartigheid.be\/nl\/tentoonstelling-4-visies","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533031.html"},"en":{"name":"\u00ab 4 regards \u00bb de Jo\u00eblle Duli\u00e8re, Laurent Carpentier, Louis-Michel Carpentier & Natacha De Locht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533031.html"},"de":{"name":"Expo \u00ab 4 regards \u00bb de Jo\u00eblle Duli\u00e8re, Laurent Carpentier, Louis-Michel Carpentier & Natacha De Locht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533031.html"},"it":{"name":"Expo \u00ab 4 regards \u00bb de Jo\u00eblle Duli\u00e8re, Laurent Carpentier, Louis-Michel Carpentier & Natacha De Locht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533031.html"},"sp":{"name":"Expo \u00ab 4 regards \u00bb de Jo\u00eblle Duli\u00e8re, Laurent Carpentier, Louis-Michel Carpentier & Natacha De Locht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":nul