sitors\/agenda\/event-detail.50011580"},"pt":{"name":"Mrs Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/mrs-jenkins-et-son-pianiste\/","email":"info@ttotheatre.be","phone_contact":null,"phone_booking":"+32 2 510 05 10","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011580"},"en":{"name":"Mrs Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/mrs-jenkins-et-son-pianiste\/","email":"info@ttotheatre.be","phone_contact":null,"phone_booking":"+32 2 510 05 10","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011580"},"it":{"name":"Mrs Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/mrs-jenkins-et-son-pianiste\/","email":"info@ttotheatre.be","phone_contact":null,"phone_booking":"+32 2 510 05 10","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011580"},"cn":{"name":"Mrs Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/mrs-jenkins-et-son-pianiste\/","email":"info@ttotheatre.be","phone_contact":null,"phone_booking":"+32 2 510 05 10","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011580"},"fr":{"name":"Mrs Jenkins et son pianiste","shortdescr":"\u00c7a vous fera les tympans !","longdescr":"En tant qu\u2019organisateur responsable, le TTO d\u00e9cline toutes responsabilit\u00e9s mais pr\u00e9f\u00e8re pr\u00e9venir. Cette pi\u00e8ce expose le spectateur \u00e0 deux types d\u2019accident grave : la d\u00e9chirure du tympan et\/ou le d\u00e9crochage de la m\u00e2choire.\n\n\u00c0 toutes fins utiles (par exemple, pour votre assurance), voici les conditions du sinistre : le pianiste Cosme Mac Moon (Achille Ridolfi) raconte le destin aussi strident qu\u2019hilarant de Florence Foster Jenkins (Julie Duroisin), riche h\u00e9riti\u00e8re am\u00e9ricaine devenue c\u00e9l\u00e8bre en s\u2019improvisant soprano colorature et en\u2026 massacrant les airs les plus c\u00e9l\u00e8bres des ann\u00e9es 30. Entre ses approximations m\u00e9lodiques et ses costumes d\u00e9conseill\u00e9s aux \u00e9pileptiques, on dira pudiquement qu\u2019on a achev\u00e9 des chevaux pour moins que \u00e7a\u2026\n\nUne chose est s\u00fbre : la cantatrice \u00ab qui chantait divinement faux \u00bb, qui avait d\u00e9j\u00e0 inspir\u00e9 deux films (l\u2019un avec Catherine Frot, l\u2019autre avec Meryl Streep), ainsi que la Castafiore \u00e0 Herg\u00e9, ne va pas vous laisser indemne !","performers":"De Stephen Temperley Texte fran\u00e7ais St\u00e9phane Laporte Mise en sc\u00e8ne Emmanuel Dell\u2019Erba Avec Achille Ridolfi et Julie Duroisin Direction musicale Daphn\u00e9 D\u2019Heur Costumes Chandra Vellut Cr\u00e9ation lumi\u00e8res Alain Collet Production Th\u00e9\u00e2tre de la Toison d\u2019Or Photo \u00a9 Lou Verschueren","boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/mrs-jenkins-et-son-pianiste\/","email":"info@ttotheatre.be","phone_contact":null,"phone_booking":"+32 2 510 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011580"},"sp":{"name":"Mrs Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/mrs-jenkins-et-son-pianiste\/","email":"info@ttotheatre.be","phone_contact":null,"phone_booking":"+32 2 510 05 10","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011580"},"nl":{"name":"Mrs Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/mrs-jenkins-et-son-pianiste\/","email":"in