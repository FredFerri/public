n":["Family"],"it":["Famiglie"],"cn":[null],"fr":["Famille"],"sp":["Familias"],"nl":["Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":5700007166,"date_start":"2025-03-29","date_end":"2025-03-29","date_next":"2025-03-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-28T08:52:06+01:00","published_at":"2025-02-28T08:50:40+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":319107,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"DAS HAUS presents Carine Tinney, Franco Pavan & Jo\u00e3o Freitas \u2018Cross Pollination\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/cross-pollination","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007166"},"pt":{"name":"DAS HAUS presents Carine Tinney, Franco Pavan & Jo\u00e3o Freitas \u2018Cross Pollination\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/cross-pollination","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007166"},"en":{"name":"DAS HAUS presents Carine Tinney, Franco Pavan & Jo\u00e3o Freitas \u2018Cross Pollination\u2019","shortdescr":"Join us for a DAS HAUS evening\u2014where music and art strip down to their essence.\nIn Cross Pollination, three artists meet for the first time, creating something unrepeatable\u2014part performance, part experiment, part fleeting moment that will never happen the same way again.\n","longdescr":"Join us for a DAS HAUS evening\u2014where music and art strip down to their essence.\nIn Cross Pollination, three artists meet for the first time, creating something unrepeatable\u2014part performance, part experiment, part fleeting moment that will never happen the same way again.\n\nImagine stepping into a modern-day Parisian salon, where artists and thinkers once mingled and sparked new ideas. Cross Pollination brings that spirit back, uniting live music with visual art in a space where anything can happen. It's an experience that explores themes like fragility, decay, sleep and the passage of time, all unfolding right before your eyes.\n\nA voice that feels like it belongs to another time\u2014pure, weightless, with a melancholy that lingers, Scottish-Maltese soprano Carine Tinney is celebrated for her performances spanning oratorio, early music, lieder recitals and opera. With appearances at prestigious venues like the Berlin Philharmonie and collaborations with conductors such as Helmuth Rilling and Emmanuelle Ha\u00efm, Carine's angelic voice brings a profound depth to early music. \n\nItalian lutenist and theorbist Franco Pavan is a master of musical archeology, known for his expertise in Renaissance and Baroque repertoires. As the founder of the ensemble Laboratorio '600, Franco has dedicated his career to unearthing and revitalising hidden gems of early music.\n\nPortuguese visual and spatial artist Jo\u00e3o Freitas is a sculptor of absence. His process of removal\u2014peeling away layers, exposing textures\u2014mirrors the way memory and time shape what we see and hear. For this performance, his work becomes a live conversation with sound.\n\nNot just a concert. Not just an exhibition. Something in between. \nBe part of this transformation at DAS HAUS, where music is reconstructed, deconstructed, and reborn. Where art is felt, dismantled and remade in the moment.\n","performers":"Carine Tinney (soprano); Franco Pavan (lutenist); Jo\u00e3o Freitas (visual artist)","boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/cross-pollination","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007166"},"it":{"name":"DAS HAUS presents Carine Tinney, Franco Pavan & Jo\u00e3o Freitas \u2018Cross Pollination\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/cross-pollination","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007166"},"cn":{"name":"DAS HAUS presents Carine Tinney, Franco Pavan & Jo\u00e3o Freitas \u2018Cross Pollination\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/cross-pollination","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007166"},"fr":{"name":"DAS HAUS presents Carine Tinney, Franco Pavan & Jo\u00e3o Freitas \u2018Cross Pollination\u2019","shortdescr":"Rejoignez-nous pour une soir\u00e9e DAS HAUS, o\u00f9 musique et art se d\u00e9pouillent jusqu'\u00e0 leur essence. Pour Cross Pollination, trois artistes se rencontrent pour la premi\u00e8re fois et donnent naissance \u00e0 quelque chose d\u2019in\u00e9dit\u2014une performance qui oscille entre concert, exp\u00e9rimentation et instant fugace, impossible \u00e0 reproduire.\n","longdescr":"Rejoignez-nous pour une soir\u00e9e DAS HAUS, o\u00f9 musique et art se d\u00e9pouillent jusqu'\u00e0 leur essence. Pour Cross Pollination, trois artistes se rencontrent pour la premi\u00e8re fois et donnent naissance \u00e0 quelque chose d\u2019in\u00e9dit\u2014une performance qui oscille entre concert, exp\u00e9rimentation et instant fugace, impossible \u00e0 reproduire.\n\nImaginez un salon parisien contemporain, un lieu o\u00f9 artistes et penseurs se croisent et s\u2019inspirent. Cross Pollination anime cet esprit, fusionnant musique vivante et art visuel dans un espace o\u00f9 tout peut arriver. Un voyage au c\u0153ur de la fragilit\u00e9, de la disparition, du sommeil et du passage du temps\u2014le tout se r\u00e9v\u00e9lant sous vos yeux.\n\nUne voix venue d\u2019un autre temps. Carine Tinney chante comme si elle portait l\u2019histoire dans son souffle\u2014pure, a\u00e9rienne, empreinte d\u2019une m\u00e9lancolie qui s\u2019attarde. La soprano \u00e9cossaise-maltaise est reconnue pour son interpr\u00e9tation de l\u2019oratorio, de la musique ancienne, du lied et de l\u2019op\u00e9ra. Invit\u00e9e sur les plus grandes sc\u00e8nes, comme la Philharmonie de Berlin, elle collabore avec des chefs d\u2019orchestre tels que Helmuth Rilling et Emmanuelle Ha\u00efm. Sa voix ang\u00e9lique insuffle une profondeur rare \u00e0 la musique ancienne.\n\nUn arch\u00e9ologue du son. Luthiste et th\u00e9orbiste italien, Franco Pavan explore et redonne vie aux r\u00e9pertoires oubli\u00e9s de la Renaissance et du Baroque. Fondateur de l\u2019ensemble Laboratorio '600, il d\u00e9voile avec pr\u00e9cision et po\u00e9sie des tr\u00e9sors enfouis de la musique ancienne.\nUn sculpteur de l\u2019absence. Jo\u00e3o Freitas, artiste visuel et spatial portugais, cr\u00e9e en retirant\u2014d\u00e9pouillant la mati\u00e8re pour r\u00e9v\u00e9ler textures et histoires cach\u00e9es. Son processus, inspir\u00e9 par la m\u00e9moire et le temps, entre en dialogue direct avec la musique. Pour cette performance, son travail devient un \u00e9change vivant avec le son, \u00e9voluant \u00e0 chaque instant.\n\nNi un concert. Ni une exposition. Quelque chose entre les deux.\nVenez vivre cette transformation \u00e0 DAS HAUS\u2014o\u00f9 la musique se d\u00e9construit et rena\u00eet, o\u00f9 l\u2019art se ressent, se d\u00e9fait et se r\u00e9invente sous vos yeux.\n","performers":"Carine Tinney (soprano); Franco Pavan (luthiste); Jo\u00e3o Freitas (artiste visuel)","boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/cross-pollination","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007166"},"sp":{"name":"DAS HAUS presents Carine Tinney, Franco Pavan & Jo\u00e3o Freitas \u2018Cross Pollination\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/cross-pollination","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007166"},"nl":{"name":"DAS HAUS presents Carine Tinney, Franco Pavan & Jo\u00e3o Freitas \u2018Cross Pollination\u2019","shortdescr":"Beleef een avond bij DAS HAUS\u2014waar muziek en kunst worden teruggebracht tot hun essentie. In Cross Pollination ontmoeten drie kunstenaars elkaar voor het eerst. Wat hier ontstaat, zal nooit meer precies zo gebeuren\u2014een samensmelting van performance, experiment en een vluchtig moment dat slechts \u00e9\u00e9n keer bestaat.\n","longdescr":"Beleef een avond bij DAS HAUS\u2014waar muziek en kunst worden teruggebracht tot hun essentie. In Cross Pollination ontmoeten drie kunstenaars elkaar voor het eerst. Wat hier ontstaat, zal nooit meer precies zo gebeuren\u2014een samensmelting van performance, experiment en een vluchtig moment dat slechts \u00e9\u00e9n keer bestaat.\n\nStel je een hedendaags salon voor, zoals in het Parijs van weleer, waar kunstenaars en denkers samenkwamen om idee\u00ebn uit te wisselen. Cross Pollination blaast die geest nieuw leven in, met live muziek en beeldende kunst die samensmelten in een ruimte waar alles mogelijk is. Thema\u2019s als vergankelijkheid, verval, slaap en tijd vloeien door de voorstelling, zich ontvouwend voor je ogen.\nEen stem die uit een andere tijd lijkt te komen\u2014puur, gewichtloos, met een melancholie die blijft hangen. De Schots-Maltese sopraan Carine Tinney beweegt zich moeiteloos tussen oratorium, oude muziek, liedrecitals en opera. Ze trad op in prestigieuze zalen zoals de Berliner Philharmonie en werkte samen met dirigenten als Helmuth Rilling en Emmanuelle Ha\u00efm. Met haar etherische stem geeft ze vroege muziek een nieuwe diepte.\n\nDe Italiaanse luitist en theorbist Franco Pavan is een meester in muzikale archeologie, gespecialiseerd in de renaissance- en barokmuziek. Als oprichter van het ensemble Laboratorio '600 wijdt hij zich aan het ontdekken en tot leven brengen van verborgen parels uit het verleden.\n\nDe Portugese beeldend en ruimtelijk kunstenaar Jo\u00e3o Freitas is een beeldhouwer van afwezigheid. Zijn kunst ontstaat door lagen weg te nemen en texturen bloot te leggen, als een reflectie op hoe tijd en herinnering ons waarnemen be\u00efnvloedt. Tijdens deze voorstelling gaat zijn werk een directe dialoog aan met klank\u2014levend, veranderlijk, in het moment.\n\nNiet zomaar een concert. Niet zomaar een expositie. Iets daartussenin.\nMaak deel uit van deze transformatie bij DAS HAUS, waar muziek wordt opgebouwd, afgebroken en opnieuw geboren. Waar kunst wordt gevoeld, ontmanteld en in het moment opnieuw ontstaat.\n","performers":"Carine Tinney (sopraan); Franco Pavan (luitist); Jo\u00e3o Freitas (beeldend kunstenaar)","boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/cross-pollination","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007166"}},"place":{"id":277267,"translations":{"de":{"name":"Palazzo","address_street_name":"Th\u00e9odore Verhaegenstraat ","address_street_number":"190","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Th\u00e9odore Verhaegenstraat , 190","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Palazzo","address_street_name":"Th\u00e9odore Verhaegenstraat ","address_street_number":"190","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Th\u00e9odore Verhaegenstraat , 190","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Palazzo","address_street_name":"Th\u00e9odore Verhaegenstraat ","address_street_number":"190","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Th\u00e9odore Verhaegenstraat , 190","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Palazzo","address_street_name":"Th\u00e9odore Verhaegenstraat ","address_street_number":"190","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Th\u00e9odore Verhaegenstraat , 190","address_line2":"1060 Saint-Gilles"