ent-detail.50005684"},"it":{"name":"Second Souffle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005684"},"cn":{"name":"Second Souffle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005684"},"fr":{"name":"Second Souffle","shortdescr":"Comment se reconstruire quand le sort s\u2019acharne sur soi?\n\nMorgane Raoux est clarinettiste. Passionn\u00e9e. Et promise \u00e0 un bel avenir : op\u00e9ras nationaux, grands orchestres symphoniques. \u00c0 25 ans, un pneumothorax stoppe net sa trajectoire fulgurante et sa grande carri\u00e8re \u00e0 peine entam\u00e9e. Morgane a perdu le souffle\u2026","longdescr":"Avec Second Souffle, elle traite de sa r\u00e9silience heureuse et profitable. De l\u2019optimisme galopant qu\u2019elle utilise comme un bazooka. Finalement, il n\u2019est question ici que d\u2019espoir. De vivre plut\u00f4t que de survivre. D\u2019entendre le sang bouillir dans les veines et de sentir la belle sant\u00e9 nous traverser. A l\u2019instar de la pierre philosophale, Morgane a su transformer la mis\u00e8re en joyau.\n\nAuteur : Morgane Raoux selon une adaptation de son roman autobiographique \u00ab Je ne souffle pas, je chante \u00bb (\u00e9ditions Michalon)\nInterpr\u00e8tes : Morgane Raoux, Nicolas Wanczycki\nMise en sc\u00e8ne : Julie-Anne Roth\nUne coproduction de Madame Clarinette (France) et Pony Production. Spectacle cr\u00e9\u00e9 en r\u00e9sidence avec le soutien de la ville de Villeneuve-la-Garenne et du CENTQUATRE-PARIS. Avec le soutien du Th\u00e9\u00e2tre de Poche de Bruxelles.","performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005684"},"sp":{"name":"Second Souffle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005684"},"nl":{"name":"Second Souffle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005684"}},"place":{"id":276400,"translations":{"de":{"name":"Escale du Nord (Antenne Scheut)","address_street_name":"Avenue de Scheut","address_street_number":"147","address_street_box":null,"email":"info@escaledunord.brussels","website":"http:\/\/www.escaledunord.brussels","phone_contact":"+32 496 94 43 18","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Avenue de Scheut, 147","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Escale du Nord (Antenne Scheut)","address_street_name":"Avenue de Scheut","address_street_number":"147","address_street_box":null,"email":"info@escaledunord.brussels","website":"http:\/\/www.escaledunord.brussels","phone_contact":"+32 496 94 43 18","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Avenue de Scheut, 147","address_line2":"1070 Anderlecht","description_