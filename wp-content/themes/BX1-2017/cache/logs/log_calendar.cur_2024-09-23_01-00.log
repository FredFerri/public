a_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001268"},"en":{"name":"The Sassy Cabaret: Le Bal des D\u00e9butant.e.s (& Confirm\u00e9.e.s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/wordpress\/","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001268"},"it":{"name":"The Sassy Cabaret: Le Bal des D\u00e9butant.e.s (& Confirm\u00e9.e.s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/wordpress\/","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001268"},"cn":{"name":"The Sassy Cabaret: Le Bal des D\u00e9butant.e.s (& Confirm\u00e9.e.s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/wordpress\/","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001268"},"fr":{"name":"The Sassy Cabaret: Le Bal des D\u00e9butant.e.s (& Confirm\u00e9.e.s)","shortdescr":null,"longdescr":"Ce soir, c'est la deuxi\u00e8me \u00e9dition du grand bal des d\u00e9butant.e.s et des confirm\u00e9.e.s orchestr\u00e9 par Lili MirezMoi !\n\nImaginez-vous : des artistes en herbe d\u00e9voilant leurs tenues les plus \u00e9poustouflantes, leurs talents les plus \u00e9blouissants et leurs punchlines les plus percutantes. \nVous \u00eates convi\u00e9s \u00e0 un spectacle unique, o\u00f9 l'absurdit\u00e9 rencontre le g\u00e9nie, o\u00f9 le talent \u00e9clate dans toute sa splendeur.\nC'est \u00e7a, l'esprit MirezMoi et de ses \u00e9l\u00e8ves : vous r\u00e9veiller, vous bousculer, et vous laisser des \u00e9toiles plein les yeux.\nApr\u00e8s une ann\u00e9e de travail acharn\u00e9 \u00e0 la BrusselsArtPole, il est enfin temps de d\u00e9couvrir leurs cr\u00e9ations. Entre danses endiabl\u00e9es, performances sportives, duos improbables et instants po\u00e9tiques, ce bal promet d'\u00eatre une v\u00e9ritable montagne russe d'\u00e9motions.\n\nGuest: Ch\u00e9ri.e Chapstick & Blanket La Goulue","performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/wordpress\/","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001268"},"sp":{"name":"The Sassy Cabaret: Le Bal des D\u00e9butant.e.s (& Confirm\u00e9.e.s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/wordpress\/","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001268"},"nl":{"name":"The Sassy Cabaret: Le Bal des D\u00e9butant.e.s (& Confirm\u00e9.e.s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/wordpress\/","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001268"}},"place":{"id":224842,"translations":{"de":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"bookin