019importance de Bruxelles dans la vie et l\u2019\u0153uvre du jeune Ensor. Tout au long du parcours, vous pourrez dialoguer avec les \u0153uvres et votre guide via des mat\u00e9riaux tactiles et de la musique. D\u00e9couvrez le meilleur de James Ensor tout en utilisant des sens diff\u00e9rents !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.kbr.be\/fr\/agenda\/visite-ensor-aveugles-malvoyants\/2024-05-17\/","email":"educdien@kbr.be","phone_contact":"+32 2 519 53 11","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006465"},"sp":{"name":"Visite guid\u00e9e pour les aveugles et les malvoyants : James Ensor. Inspired by Brussels:","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.kbr.be\/fr\/agenda\/visite-ensor-aveugles-malvoyants\/2024-05-17\/","email":"educdien@kbr.be","phone_contact":"+32 2 519 53 11","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006465"},"nl":{"name":"Visite guid\u00e9e pour les aveugles et les malvoyants : James Ensor. Inspired by Brussels:","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.kbr.be\/fr\/agenda\/visite-ensor-aveugles-malvoyants\/2024-05-17\/","email":"educdien@kbr.be","phone_contact":"+32 2 519 53 11","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006465"}},"place":{"id":981,"translations":{"de":{"name":"KBR museum","address_street_name":"Mont des Arts","address_street_number":"28","address_street_box":null,"email":"info@kbr.be","website":"http:\/\/www.kbr.be","phone_contact":"+32 2 519 53 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Mont des Arts, 28","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"KBR m