 9 a 12 a\u00f1os","Familias","J\u00f3venes de 12 a 15 a\u00f1os","J\u00f3venes de 15 a 18 a\u00f1os"],"pt":[null,null,null,null,null],"cn":[null,null,null,null,null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-26T04:08:35+02:00","published_at":"2023-03-07T16:39:12+01:00","backoffice_id":273006,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.35962828892923},{"id":551755,"date_start":"2023-03-02","date_end":"2023-05-28","date_next":"2023-03-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"Family Matters","shortdescr":"Au travers de nombreuses vid\u00e9os, des installations, sculptures, peintures et photographies, 'Family Matters' invite les visiteurs \u00e0 vivre une succession d\u2019exp\u00e9riences sur le th\u00e8me de la famille, l\u2019enfance, le couple, la sororit\u00e9.","longdescr":"\u00ab Toutes les familles heureuses le sont de la m\u00eame mani\u00e8re, les familles malheureuses le sont chacune \u00e0 leur fa\u00e7on. \u00bb L\u00e9on Tolsto\u00ef, Anna Kar\u00e9nine, 1877\r\n\r\nLa Fondation Boghossian est heureuse de pr\u00e9senter Family Matters, l\u2019exposition qui r\u00e9unit une vingtaine d\u2019artistes contemporains de tous horizons et g\u00e9n\u00e9rations \u00e0 la Villa Empain.\r\n\r\nFamily Matters propose un r\u00e9cit construit sur le dialogue entre des \u0153uvres qui explorent successivement les sujets de l\u2019enfance, du couple, des parents et des grands-parents, de la fraternit\u00e9, de la sororit\u00e9, de la sexualit\u00e9 ou de la transmission interg\u00e9n\u00e9rationnelle. Au travers des vid\u00e9os, installations, sculptures, peintures et photographies, Family Matters invite les visiteurs \u00e0 vivre une succession d\u2019exp\u00e9riences individuelles et collectives sur le th\u00e8me de la famille.\r\n\r\n\u00c0 l\u2019instar de nombreux \u00e9crivains qui ont consacr\u00e9 leurs \u0153uvres \u00e0 la description de leurs familles, les artistes r\u00e9unis ici donnent une place constitutive et d\u00e9terminante dans leur travail \u00e0 leur cercle familial. Certains r\u00e9alisent pr\u00e9cis\u00e9ment leur corpus avec leurs proches. Certaines \u0153uvres expriment les souvenirs d\u2019enfance et le sentiment affectueux tandis que d\u2019autres convoquent les violences domestiques, capturant ou rejouant des sc\u00e8nes de couple ou de crispations familiales.\r\n\r\nParce que le sujet appelle sans doute une temporalit\u00e9 sp\u00e9cifique, l\u2019art vid\u00e9o a une place importante dans l\u2019exposition. Diff\u00e9rentes formes narratives sont pr\u00e9sent\u00e9es, entre fiction, documentaire, essai vid\u00e9o, performance film\u00e9e, exp\u00e9rience immersive ou encore \u00e0 l\u2019intersection entre ces genres.","performers":"Avec Agathe Bokanowski, Elke Andreas Boon, Elodie Antoine, Danielle Arbid, Am\u00e9lie Berrodier, Paul G\u00e9rard, Sandra Heremans, Sandra Lecoq, Ariane Loze, Henry Moore, Val\u00e9rie Mr\u00e9jen, Bruce Nauman, Kika Nicolela, Hans Op de Beeck, Anne-Marie Schneider, Franck Scurti, Zineb Sedira, Sophie Whettnall et Maha Yammine.","boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551755"},"nl":{"name":"Family Matters","shortdescr":"Aan de hand van video's, installaties, sculpturen, schilderijen en foto's nodigt 'Family Matters' bezoekers uit voor ervaringen rond het thema familie, de kindertijd, het koppel, broeder- en zusterschap\u2026","longdescr":"\u201cAlle gelukkige gezinnen zijn gelukkig op dezelfde manier, ongelukkige gezinnen zijn ongelukkig op hun eigen manier.\u201d Leo Tolstoj, Anna Karenina, 1877\r\n\r\nDe Boghossianstichting presenteert Family Matters, een tentoonstelling die twintig hedendaagse kunstenaars van verschillende achtergronden en generaties samenbrengt in de Villa Empain.\r\n\r\nFamily Matters brengt een dialoog gebaseerd op werken die de kindertijd, het koppel, ouders en grootouders, broeder- en zusterschap, seksualiteit of overdracht tussen generaties onderzoeken. Aan de hand van video\u2019s, installaties, sculpturen, schilderijen en foto\u2019s nodigt Family Matters bezoekers uit voor individuele en collectieve ervaringen rond het thema familie.\r\n\r\nZoals vele schrijvers hun oeuvre wijdden aan de beschrijving van hun familie, geven ook de kunstenaars op deze tentoonstelling hun familiekring een centrale plaats. Sommige cre\u00ebren hun kunst samen met familieleden. Sommige werken roepen jeugdherinneringen en affectie op, terwijl andere huiselijk geweld en sc\u00e8nes van familiale spanningen weerspiegelen.\r\n\r\nVideokunst krijgt een belangrijke plaats in de tentoonstelling.  Omdat het onderwerp wellicht een zekere tijdelijkheid vraagt? Verschillende vertelvormen komen aan bod: fictie, documentaire, video-essay, gefilmde performance, immersieve ervaring of een combinatie van deze genres.","performers":"Met Agathe Bokanowski, Elke Andreas Boon, Elodie Antoine, Danielle Arbid, Am\u00e9lie Berrodier, Paul G\u00e9rard, Sandra Heremans, Sandra Lecoq, Ariane Loze, Henry Moore, Val\u00e9rie Mr\u00e9jen, Bruce Nauman, Kika Nicolela, Hans Op de Beeck, Anne-Marie Schneider, Franck Scurti, Zineb Sedira, Sophie Whettnall en Maha Yammine.","boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551755"},"en":{"name":"Family Matters","shortdescr":"Through a series of videos, installations, sculptures, paintings, and photographs, 'Family Matters' will take visitors on a journey of experiences on the topic of the family, the childhood, the couple, brotherhood, sisterhood\u2026","longdescr":"\u201cAll happy families are alike; every unhappy family is unhappy in its own way.\u201d Leon Tolstoy, Anna Karenina, 1877\r\n\r\nThe Boghossian Foundation is delighted to host Family Matters, an exhibition at the Villa Empain featuring some twenty contemporary artists from all backgrounds and generations.\r\n\r\nFamily Matters presents a narrative built on a dialogue between artworks that successively broach the themes of childhood, the couple, parents and grandparents, brotherhood, sisterhood, sexuality, and intergenerational transmission. Through a series of videos, installations, sculptures, paintings, and photographs, Family Matters will take visitors on a journey of personal and group experiences on the topic of the family.\r\n\r\nFollowing the footsteps of the many writers who devoted their writings to portraying their families, the artists presented in this exhibition give a central place to their family circle in their own oeuvre. Indeed, some produce their artworks with their own relatives. Some of the artworks draw on childhood memories and loving feelings, while others summon up domestic violence, capturing or re-enacting intimate situations or family tensions.\r\n\r\nDue to the specific temporality of the subject matter, video art prominently figures in the exhibition. A variety of narrative forms are presented, ranging from fiction, documentary, video essay, filmed performance, immersive experience, or a combination of these genres.","performers":"With Agathe Bokanowski, Elke Andreas Boon, Elodie Antoine, Danielle Arbid, Am\u00e9lie Berrodier, Paul G\u00e9rard, Sandra Heremans, Sandra Lecoq, Ariane Loze, Henry Moore, Val\u00e9rie Mr\u00e9jen, Bruce Nauman, Kika Nicolela, Hans Op de Beeck, Anne-Marie Schneider, Franck Scurti, Zineb Sedira, Sophie Whettnall and Maha Yammine.","boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551755"},"de":{"name":"Family Matters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551755"},"it":{"name":"Family Matters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551755"},"sp":{"name":"Family Matters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551755"},"pt":{"name":"Family Matters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551755"},"cn":{"name":"Family Matters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551755"}},"place":{"id":248760,"translations":{"fr":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":" A l'initiative de la Fondation Boghossian, la c\u00e9l\u00e8bre Villa Empain a \u00e9t\u00e9 enti\u00e8rement restaur\u00e9e et a ouvert ses portes au public depuis le 23 avril 2010. Lieu de rencontres et de d\u00e9couvertes, d'\u00e9motions partag\u00e9es et d'\u00e9merveillement, la Villa Empain est aussi un remarquable t\u00e9moin de l'architecture Art D\u00e9co. En 1930, le baron Louis Empain, alors \u00e2g\u00e9 de 21 ans, fit \u00e9riger cet h\u00f4tel particulier de 2500 m2 sur la prestigieuse avenue des Nations qui fut rebaptis\u00e9e plus tard avenue Franklin Roosevelt. C'est \u00e0 l'architecte suisse Michel Polak qu'il confia la construction de cette splendide maison. Le projet con\u00e7u pour le baron Empain sur un terrain de 55 ares comprenait une villa monumentale \u00e0 quatre fa\u00e7ades en granit poli, un jardin entourant une piscine agr\u00e9ment\u00e9e d'une pergola, et une conciergerie. La diversit\u00e9 et la qualit\u00e9 des mat\u00e9riaux utilis\u00e9s (marbre, granit poli, bronze, fer forg\u00e9, vitraux et bois pr\u00e9cieux), le raffinement des d\u00e9tails et la coh\u00e9rence de l'ensemble imposant des lignes simples et imposantes, contribu\u00e8rent d'embl\u00e9e \u00e0 sa valeur patrimoniale.\r\n\r\n \r\n\r\nCette belle demeure situ\u00e9e au coeur de la capitale de l'Europe est devenu un Centre d'Art et de Dialogue entre les cultures d'Orient et d'Occident. Ce centre r\u00e9pond \u00e0 plusieurs objectifs compl\u00e9mentaires: culturels, artistiques, p\u00e9dagogiques, scientifiques, ainsi qu'\u00e0 toutes activit\u00e9s qui peuvent renforcer ce dialogue. C'est dans cet esprit d'ouverture culturelle que la Fondation Boghossian y pr\u00e9sente des expositions prestigieuses, accessibles au public du mardi au dimanche. Toutes les informations utiles sont reprises sur le site internet de la Villa Empain.\r\n\r\n  ","description_print":"Dans la prestigieuse villa Empain, cette fondation vise \u00e0 d\u00e9velopper \u00e0 Bruxelles un centre de cr\u00e9ation et de dialogue entre l\u2019Orient et l\u2019Occident. Une programmation vari\u00e9e d\u2019activit\u00e9s culturelles est pr\u00e9vue pour le public.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"nl":{"name":"Boghossian Stichting - Villa Empain","address_street_name":"Franklin Rooseveltlaan","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Franklin Rooseveltlaan, 67","address_line2":"1050 Elsene","description_web":"De Villa Empain is vanaf 2010 toegankelijk voor het grote publiek. Er worden verschillende activiteiten en evenementen georganiseerd (tentoonstellingen, concerten, conferenties enz.). De stichting Boghossian heeft zijn internationale zetel in de Villa Empain waarvan de restauratiewerkzaamheden in 2008 zijn gestart. Samen met het Paleis Stoclet, gebouwd door de Oostenrijkse architect Josef Hoffmann in 1911, is de Villa Empain zeker een van de mooiste meesterwerken van de art-decoarchitectuur in Brussel. In 1930 liet de toen 21-jarige baron Louis Empain dit bijzondere huis ontwerpen met een oppervlakte van 2.500 vierkante meter, gelegen op de Natielaan (later de Franklin Rooseveltlaan). De bouw van dit prachtige huis vertrouwde hij toe aan de Zwitserse architect Michel Polak, bijgestaan door zijn medewerker Alfred Hoch. Het project dat voor Baron Empain werd uitgedacht op een terrein van 55 are, bestaat uit een grote villa met vier gevels in gepolijst graniet, een tuin met een zwembad, een pergola en een portierswoning. Het moderne en luxueuze karakter van deze constructie wekte al heel snel enthousiasme en nieuwsgierigheid op. De verscheidenheid, de kwaliteit van de gebruikte materialen (marmer, gepolijst graniet, brons, gietijzer en fijne houtsoorten), de verfijnde details en de harmonie van het geheel, de eenvoudige, maar indrukwekkende lijnen? Dit alles zou meteen bijdragen tot de waarde van de villa ","description_print":"Een centrum voor kunst en dialoog tussen de oosterse en de westerse cultuur . E\u00e9n van de belangrijkste doelstellingen van de Boghossian-stichting is het oprichten van een centrum van culturele en artistieke dialoog tussen het Oosten en het Westen. Haar uitvalsbasis is de prestigieuze villa Empain, waarin ze allerhande culturele activiteiten organiseert voor het publiek.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"en":{"name":"Boghossian Foundation - Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"\r\nOpening of Villa Empain to the public according to several themes of organised activities and events (exhibitions, concerts, conferences, etc.) from 2010. La Fondation Boghossian has its international office in Villa Empain, on which restoration work began in 2008. With the Stoclet building, constructed by the Austrian architect Josef Hoffmann in 1911, Villa Empain is undoubtedly one of the finest masterpieces of Art Deco architecture in Brussels. In 1930, Baron Louis Empain, then aged 21 years, had this 2,500-metre-square mansion built on the prestigious Avenue des Nations, which was later renamed Avenue Franklin Roosevelt. He entrusted the building of this fine house to the Swiss architect Michel Polak, assisted by his colleague Alfred Hoch. The plan designed for Baron Empain on a 55-acre plot included a monumental villa with four fa\u00e7ades in polished granite, a garden surrounding a swimming pool ornamented with a pergola, and a caretaker's lodge. The modern and luxurious nature of this structure soon aroused enthusiasm and curiosity. It is true that the variety and quality of the materials used (marble, polished granite, bronze, wrought iron, stained-glass windows and precious woods), the sophistication of the details and the coherence of the whole thing with simple but imposing lines immediately contributed to its patrimonial value. \r\n  ","description_print":"A villa in Art Deco style which is now home to the Boghossion Foundation: a centre for art and dialogue between Oriental and Western culture.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"de":{"name":"Boghossian-Stiftung \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"Die Anfang der 1930er-Jahre erbaute Villa Empain ist ein bemerkenswertes Beispiel der Art D\u00e9co-Architektur. Sie geh\u00f6rte einst einer der reichsten Familien Europas, die heute fast vollst\u00e4ndig verarmt ist. Die Villa steht seit 2007 unter Denkmalschutz.\r\n\r\nJugendstil, Art D\u00e9co und Moderne: Ihr Architekt Michel Polak (1885\u20131948) kombinierte Zierelemente des Br\u00fcsseler Jugendstils mit Formen der Moderne: Ein Gesamtkunstwerk, bei dem Formen und edle Materialien der eleganten Ausstattung untrennbar zu einer ungew\u00f6hnlichen und imposanten Einheit verschmelzen.\r\n\r\nVom drohenden Verfall zur aufwendigen Restaurierung: Nach der zwischenzeitlichen Nutzung als sowjetische Botschaft und als Studio des Fernsehsenders RTL wurde die Villa nach aufwendiger Restaurierung zur imposanten Kulisse der Kulturstiftung Fondation Boghossian.","description_print":"","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"it":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente....\r\n\r\nLa Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente.\r\nVilla Empain \u00e8 anche la sede internazionale della Fondazione Boghossian, che opera in molti paesi dal 1992.\r\nEdificio classificato dal 2007, \u00e8 stata interamente restaurata seguendo scrupolosamente le strutture originali.\r\n\r\nDa non perdere.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Villa Empain, Fundaci\u00f3n Boghossian","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain es un testigo destacado de la arquitectura Art d\u00e9co.\r\nConstruida a principios de los a\u00f1os 1930 y ubicada en el centro de la capital europea, se ha convertido en un Centro de Arte y de Di\u00e1logo imprescindible.\u00a0\r\n\r\nEs igualmente la sede internacional de la Fundaci\u00f3n Boghossian, que trabaja en distintos pa\u00edses desde el a\u00f1o 1992. Declarado monumento en el a\u00f1o 2007, ha sido restaurando siguiendo los criterios del edificio original.\u00a0A fecha de hoy, alberga diferentes exposiciones y actividades.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"],"de":["S\u00fcden"],"it":["Sud"],"sp":["Sur"],"pt":[null],"cn":[null]}},"neca":"art_center","facebook_id":null,"backoffice_id":10918,"location":{"lat":50.80750954,"lon":4.38436842},"region":"brussels","last_updated_at":"2023-03-26T04:05:38+02:00","published_at":"2013-10-19T01:29:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":248760,"translations":{"fr":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":" A l'initiative de la Fondation Boghossian, la c\u00e9l\u00e8bre Villa Empain a \u00e9t\u00e9 enti\u00e8rement restaur\u00e9e et a ouvert ses portes au public depuis le 23 avril 2010. Lieu de rencontres et de d\u00e9couvertes, d'\u00e9motions partag\u00e9es et d'\u00e9merveillement, la Villa Empain est aussi un remarquable t\u00e9moin de l'architecture Art D\u00e9co. En 1930, le baron Louis Empain, alors \u00e2g\u00e9 de 21 ans, fit \u00e9riger cet h\u00f4tel particulier de 2500 m2 sur la prestigieuse avenue des Nations qui fut rebaptis\u00e9e plus tard avenue Franklin Roosevelt. C'est \u00e0 l'architecte suisse Michel Polak qu'il confia la construction de cette splendide maison. Le projet con\u00e7u pour le baron Empain sur un terrain de 55 ares comprenait une villa monumentale \u00e0 quatre fa\u00e7ades en granit poli, un jardin entourant une piscine agr\u00e9ment\u00e9e d'une pergola, et une conciergerie. La diversit\u00e9 et la qualit\u00e9 des mat\u00e9riaux utilis\u00e9s (marbre, granit poli, bronze, fer forg\u00e9, vitraux et bois pr\u00e9cieux), le raffinement des d\u00e9tails et la coh\u00e9rence de l'ensemble imposant des lignes simples et imposantes, contribu\u00e8rent d'embl\u00e9e \u00e0 sa valeur patrimoniale.\r\n\r\n \r\n\r\nCette belle demeure situ\u00e9e au coeur de la capitale de l'Europe est devenu un Centre d'Art et de Dialogue entre les cultures d'Orient et d'Occident. Ce centre r\u00e9pond \u00e0 plusieurs objectifs compl\u00e9mentaires: culturels, artistiques, p\u00e9dagogiques, scientifiques, ainsi qu'\u00e0 toutes activit\u00e9s qui peuvent renforcer ce dialogue. C'est dans cet esprit d'ouverture culturelle que la Fondation Boghossian y pr\u00e9sente des expositions prestigieuses, accessibles au public du mardi au dimanche. Toutes les informations utiles sont reprises sur le site internet de la Villa Empain.\r\n\r\n  ","description_print":"Dans la prestigieuse villa Empain, cette fondation vise \u00e0 d\u00e9velopper \u00e0 Bruxelles un centre de cr\u00e9ation et de dialogue entre l\u2019Orient et l\u2019Occident. Une programmation vari\u00e9e d\u2019activit\u00e9s culturelles est pr\u00e9vue pour le public.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"nl":{"name":"Boghossian Stichting - Villa Empain","address_street_name":"Franklin Rooseveltlaan","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Franklin Rooseveltlaan, 67","address_line2":"1050 Elsene","description_web":"De Villa Empain is vanaf 2010 toegankelijk voor het grote publiek. Er worden verschillende activiteiten en evenementen georganiseerd (tentoonstellingen, concerten, conferenties enz.). De stichting Boghossian heeft zijn internationale zetel in de Villa Empain waarvan de restauratiewerkzaamheden in 2008 zijn gestart. Samen met het Paleis Stoclet, gebouwd door de Oostenrijkse architect Josef Hoffmann in 1911, is de Villa Empain zeker een van de mooiste meesterwerken van de art-decoarchitectuur in Brussel. In 1930 liet de toen 21-jarige baron Louis Empain dit bijzondere huis ontwerpen met een oppervlakte van 2.500 vierkante meter, gelegen op de Natielaan (later de Franklin Rooseveltlaan). De bouw van dit prachtige huis vertrouwde hij toe aan de Zwitserse architect Michel Polak, bijgestaan door zijn medewerker Alfred Hoch. Het project dat voor Baron Empain werd uitgedacht op een terrein van 55 are, bestaat uit een grote villa met vier gevels in gepolijst graniet, een tuin met een zwembad, een pergola en een portierswoning. Het moderne en luxueuze karakter van deze constructie wekte al heel snel enthousiasme en nieuwsgierigheid op. De verscheidenheid, de kwaliteit van de gebruikte materialen (marmer, gepolijst graniet, brons, gietijzer en fijne houtsoorten), de verfijnde details en de harmonie van het geheel, de eenvoudige, maar indrukwekkende lijnen? Dit alles zou meteen bijdragen tot de waarde van de villa ","description_print":"Een centrum voor kunst en dialoog tussen de oosterse en de westerse cultuur . E\u00e9n van de belangrijkste doelstellingen van de Boghossian-stichting is het oprichten van een centrum van culturele en artistieke dialoog tussen het Oosten en het Westen. Haar uitvalsbasis is de prestigieuze villa Empain, waarin ze allerhande culturele activiteiten organiseert voor het publiek.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"en":{"name":"Boghossian Foundation - Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"\r\nOpening of Villa Empain to the public according to several themes of organised activities and events (exhibitions, concerts, conferences, etc.) from 2010. La Fondation Boghossian has its international office in Villa Empain, on which restoration work began in 2008. With the Stoclet building, constructed by the Austrian architect Josef Hoffmann in 1911, Villa Empain is undoubtedly one of the finest masterpieces of Art Deco architecture in Brussels. In 1930, Baron Louis Empain, then aged 21 years, had this 2,500-metre-square mansion built on the prestigious Avenue des Nations, which was later renamed Avenue Franklin Roosevelt. He entrusted the building of this fine house to the Swiss architect Michel Polak, assisted by his colleague Alfred Hoch. The plan designed for Baron Empain on a 55-acre plot included a monumental villa with four fa\u00e7ades in polished granite, a garden surrounding a swimming pool ornamented with a pergola, and a caretaker's lodge. The modern and luxurious nature of this structure soon aroused enthusiasm and curiosity. It is true that the variety and quality of the materials used (marble, polished granite, bronze, wrought iron, stained-glass windows and precious woods), the sophistication of the details and the coherence of the whole thing with simple but imposing lines immediately contributed to its patrimonial value. \r\n  ","description_print":"A villa in Art Deco style which is now home to the Boghossion Foundation: a centre for art and dialogue between Oriental and Western culture.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"de":{"name":"Boghossian-Stiftung \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"Die Anfang der 1930er-Jahre erbaute Villa Empain ist ein bemerkenswertes Beispiel der Art D\u00e9co-Architektur. Sie geh\u00f6rte einst einer der reichsten Familien Europas, die heute fast vollst\u00e4ndig verarmt ist. Die Villa steht seit 2007 unter Denkmalschutz.\r\n\r\nJugendstil, Art D\u00e9co und Moderne: Ihr Architekt Michel Polak (1885\u20131948) kombinierte Zierelemente des Br\u00fcsseler Jugendstils mit Formen der Moderne: Ein Gesamtkunstwerk, bei dem Formen und edle Materialien der eleganten Ausstattung untrennbar zu einer ungew\u00f6hnlichen und imposanten Einheit verschmelzen.\r\n\r\nVom drohenden Verfall zur aufwendigen Restaurierung: Nach der zwischenzeitlichen Nutzung als sowjetische Botschaft und als Studio des Fernsehsenders RTL wurde die Villa nach aufwendiger Restaurierung zur imposanten Kulisse der Kulturstiftung Fondation Boghossian.","description_print":"","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"it":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente....\r\n\r\nLa Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente.\r\nVilla Empain \u00e8 anche la sede internazionale della Fondazione Boghossian, che opera in molti paesi dal 1992.\r\nEdificio classificato dal 2007, \u00e8 stata interamente restaurata seguendo scrupolosamente le strutture originali.\r\n\r\nDa non perdere.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Villa Empain, Fundaci\u00f3n Boghossian","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain es un testigo destacado de la arquitectura Art d\u00e9co.\r\nConstruida a principios de los a\u00f1os 1930 y ubicada en el centro de la capital europea, se ha convertido en un Centro de Arte y de Di\u00e1logo imprescindible.\u00a0\r\n\r\nEs igualmente la sede internacional de la Fundaci\u00f3n Boghossian, que trabaja en distintos pa\u00edses desde el a\u00f1o 1992. Declarado monumento en el a\u00f1o 2007, ha sido restaurando siguiendo los criterios del edificio original.\u00a0A fecha de hoy, alberga diferentes exposiciones y actividades.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":"art_center","facebook_id":null,"backoffice_id":10918,"location":{"lat":50.80750954,"lon":4.38436842},"region":"brussels","last_updated_at":"2023-03-26T04:05:38+02:00","published_at":"2013-10-19T01:29:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/75c13acb4b84af9e6b8a521e262418cafd533663.jpg","width":2048,"height":867,"ratio":2.36,"translations":{"fr":{"title":"Family Matters","copyright":null},"nl":{"title":"Family Matters","copyright":null},"en":{"title":"Family Matters","copyright":null},"de":{"title":"Family Matters","copyright":null},"it":{"title":"Family Matters","copyright":null},"sp":{"title":"Family Matters","copyright":null},"pt":{"title":"Family Matters","copyright":null},"cn":{"title":"Family Matters","copyright":null}}}],"dates":[{"day":"2023-03-02","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-03-03","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-03-04","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-03-05","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-03-07","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-03-08","door