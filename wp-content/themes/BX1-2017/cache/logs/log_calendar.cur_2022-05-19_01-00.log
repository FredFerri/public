0"},{"day":"2022-06-22","doors":null,"start":"10:30:00","end":"18:30:00"},{"day":"2022-06-23","doors":null,"start":"10:30:00","end":"18:30:00"},{"day":"2022-06-24","doors":null,"start":"10:30:00","end":"18:30:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:30:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:30:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:30:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:30:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:30:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi et dimanche: ferm\u00e9","mardi, mercredi, jeudi, vendredi et samedi: de 10:30 \u00e0 18:30"],"nl":["maandag en zondag: gesloten","dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 10:30 tot 18:30"],"en":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 10:30 to 18:30"]},"date_start":"2022-03-29","date_end":"2022-06-24","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T01:35:29+02:00","published_at":"2022-02-25T14:38:13+01:00","backoffice_id":248423,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28325816747135},{"id":526799,"date_start":"2022-03-27","date_end":"2022-06-05","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Marek Kus - 'a monographic approach'","shortdescr":"L\u2019Atelier 34z\u00e9ro a le plaisir de vous annoncer la tenue de sa nouvelle exposition r\u00e9trospective d\u00e9di\u00e9e \u00e0 l\u2019artiste peintre polonais Marek Kus ! Venez f\u00eater l\u2019ouverture de l\u2019exposition avec nous le samedi 26 mars \u00e0 12h00. L\u2019exposition se d\u00e9roulera ensuite du dimanche 27 mars au lundi 13 juin 2022. N\u2019h\u00e9sitez pas \u00e0 venir d\u00e9couvrir l\u2019univers de cet artiste si particuli\u00e8re \u00e0 nos c\u00f4t\u00e9s.","longdescr":"L\u2019Atelier 34z\u00e9ro a le plaisir de vous annoncer la tenue de sa nouvelle exposition r\u00e9trospective d\u00e9di\u00e9e \u00e0 l\u2019artiste peintre polonais Marek Kus ! Venez f\u00eater l\u2019ouverture de l\u2019exposition avec nous le samedi 26 mars \u00e0 12h00. L\u2019exposition se d\u00e9roulera ensuite du dimanche 27 mars au lundi 13 juin 2022. N\u2019h\u00e9sitez pas \u00e0 venir d\u00e9couvrir l\u2019univers de cet artiste si particuli\u00e8re \u00e0 nos c\u00f4t\u00e9s.\r\nOriginaire de la r\u00e9gion de Katowice, il occupe actuellement la place de directeur de la galerie BWA de Katowice. Plusieurs fois expos\u00e9es \u00e0 l\u2019Atelier 34z\u00e9ro Muzeum par le pass\u00e9, les \u0153uvres de Marek Kus pr\u00e9sentaient un int\u00e9r\u00eat tout particulier pour notre institution, notamment de par la notion de libert\u00e9 s\u2019en d\u00e9gageant. L\u2019artiste se pla\u00eet, au travers de ses tableaux, \u00e0 peindre et reproduire des formes compos\u00e9es de petites figure anthropomorphes, questionnant alors les notions d\u2019unit\u00e9, de communaut\u00e9 mais surtout de libert\u00e9. \r\nL\u2019exposition est \u00e0 voir tous les jours de 11h00 \u00e0 23h00 \u00e0 l\u2019Atelier 34z\u00e9ro Muzeum. \r\n\r\nVernissage : samedi 26 mars 2022 d\u00e8s 12h00.\r\n\r\nPlus d\u2019informations : \r\n\r\n02.428.33.06\r\ninfo@atelier34zero.be","performers":null,"boxoffice_url":null,"website":"http:\/\/www.atelier34zero.be","email":"info@atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/526799.html"},"nl":{"name":"Marek Kus - 'a monographic approach'","shortdescr":"Het Atelier 34zero is verheugd een nieuwe retrospectieve tentoonstelling aan te kondigen, gewijd aan de Poolse schilder Marek Kus! Kom de opening van de tentoonstelling met ons vieren op zaterdag 26 maart om 12.00 uur. De tentoonstelling loopt dan van zondag 27 maart tot maandag 13 juni 2022. Aarzel niet en kom met ons de wereld van deze zeer bijzondere artiest ontdekken.","longdescr":"Het Atelier 34zero is verheugd een nieuwe retrospectieve tentoonstelling aan te kondigen, gewijd aan de Poolse schilder Marek Kus! Kom de opening van de tentoonstelling met ons vieren op zaterdag 26 maart om 12.00 uur. De tentoonstelling loopt dan van zondag 27 maart tot maandag 13 juni 2022. Aarzel niet en kom met ons de wereld van deze zeer bijzondere artiest ontdekken.\r\nHij komt oorspronkelijk uit de regio Katowice en is momenteel directeur van de galerie BWA in Katowice. De werken van Marek Kus, die in het verleden meermaals in het Atelier 34z\u00e9ro Muzeum werden tentoongesteld, waren voor onze instelling van bijzonder belang, met name vanwege de notie van vrijheid die eruit spreekt. In zijn schilderijen schildert en reproduceert de kunstenaar graag vormen bestaande uit kleine antropomorfe figuren, waarbij hij de begrippen eenheid, gemeenschap en vooral vrijheid in twijfel trekt. \r\nDe tentoonstelling is elke dag van 11 tot 23 uur te bezichtigen in Atelier 34z\u00e9ro Muzeum. \r\n\r\nOpening : Zaterdag 26 maart 2022 vanaf 12h00.\r\n\r\nVoor meer informatie kunt u contact opnemen met \r\n\r\n02.428.33.06\r\ninfo@atelier34zero.be","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/526799.html"},"en":{"name":"Marek Kus - 'a monographic approach'","shortdescr":"The Atelier 34zero is pleased to announce its new retrospective exhibition dedicated to Polish painter Marek Kus! Come celebrate the opening of the exhibition with us on Saturday, March 26 at 12:00 pm. The exhibition will then run from Sunday March 27 to Monday June 13, 2022. Don't hesitate to come and discover the universe of this very special artist with us.","longdescr":"The Atelier 34zero is pleased to announce its new retrospective exhibition dedicated to Polish painter Marek Kus! Come celebrate the opening of the exhibition with us on Saturday, March 26 at 12:00 pm. The exhibition will then run from Sunday March 27 to Monday June 13, 2022. Don't hesitate to come and discover the universe of this very special artist with us.\r\nOriginally from the Katowice region, he is currently the director of the BWA gallery in Katowice. Several times exhibited at Atelier 34z\u00e9ro Muzeum in the past, Marek Kus' works were of particular interest to our institution, especially because of the notion of freedom that emerges from them. In his paintings, the artist likes to paint and reproduce forms composed of small anthropomorphic figures, questioning the notions of unity, community, but above all freedom. \r\nThe exhibition can be seen every day from 11:00 am to 11:00 pm at the Atelier 34z\u00e9ro Muzeum. \r\n\r\nOpening : Saturday march 26th from 12:00 am.\r\n\r\nFor more information: \r\n\r\n02.428.33.06\r\ninfo@atelier34zero.be","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/526799.html"},"de":{"name":"Marek Kus - 'a monographic approach'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/526799.html"},"it":{"name":"Marek Kus - 'a monographic approach'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/526799.html"},"sp":{"name":"Marek Kus - 'a monographic approach'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/526799.html"},"pt":{"name":"Marek Kus - 'a monographic approach'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/526799.html"},"cn":{"name":"Marek Kus - 'a monographic approach'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/526799.html"}},"place":{"id":554,"translations":{"fr":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"Les b\u00e2timents et le parc accueillent les salles d\u2019exposition, un centre de documentation, une librairie sp\u00e9cialis\u00e9e, des projections de films, un jardin d\u2019exposition et un caf\u00e9. La collection abrite des \u0153uvres d\u2019Ado Hamelrijck, Wladyslaw Hasior, Pal Horvath, Jem, Roman Karalus, Walter Leblanc, Jean-Philippe Lecharlier, Waclaw Szpakowski, Guy Stukens, Bernar Venet, Bob Verschueren, Bernard Villers et Christine Wilm\u00e8s. ","description_print":"","booking_url":null,"sort_order":"ATELIER 34ZERO MUZEUM","virtual_visit":null},"nl":{"name":"Atelier 34zero Muzeum","address_street_name":"de Rivierendreef","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"de Rivierendreef, 334","address_line2":"1090 Jette","description_web":"Het Atelier 34zero Muzeum is een onafhankelijk kunstencentrum dat in 2014 opgericht is. Het herrees uit de as van het Atelier 340 Muzeum. Zijn belangrijkste roeping is de studie en promotie van de beeldhouwkunst en de driedimensionale kunst, zowel in Belgi\u00eb als in het buitenland.\r\nAtelier 34zero Muzeum organiseert 3 tot 4 tentoonstellingen per jaar in eigen ruimtes evenals evenementen extra muros. Drie types tentoonstellingen worden gerealiseerd: thematische, vergelijkende of confronterende, en persoonlijke (retrospectieven). Deze gaan gepaard met de uitgave van kwaliteitsvolle, viertalige, rijk ge\u00efllustreerde catalogen evenals postkaarten. Parallel met de tentoonstellingen bouwt Atelier 34zero Muzeum een kunstcollectie op als geheugen van voorbije activiteiten en als handleiding bij verder onderzoek. Zo bevat de collectie o.a. werk van Ado Hamelrijck, Wladyslaw Hasior, Pal Horvath, Jem, Roman Karalus, Walter Leblanc, Jean-Philippe Lecharlier, Waclaw Szpakowski, Guy Stukens, Bernar Venet, Bob Verschueren, Bernard Villers et Christine Wilm\u00e8s. ","description_print":"","booking_url":null,"sort_order":"ATELIER 34ZERO MUZEUM","virtual_visit":null},"en":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"Atelier 34zero Muzeum is an independent art centre, created in 2014. Born from the ashes of the Atelier 340 Muzeum, its main mission is the study and promotion of sculpture and three-dimensional art in Belgium and abroad.\r\nAtelier 34zero Muzeum organises 3 to 4 exhibitions a year in its own spaces as well as several events extra muros. Three types of exhibitions are organised: thematic, confrontational or comparative, and personal (retrospectives). These are accompanied by quality publications; quadrilingual and richly illustrated catalogues, and postcards. \r\nAlong with its exhibitions, Atelier 34zero Muzeum is building up a collection of artworks as a memory of past activities and a tool for further questioning. It contains work of Ado Hamelrijck, Wladyslaw Hasior, Pal Horvath, Jem, Roman Karalus, Walter Leblanc, Jean-Philippe Lecharlier, Waclaw Szpakowski, Guy Stukens, Bernar Venet, Bob Verschueren, Bernard Villers and  Christine Wilm\u00e8s, among others.","description_print":"","booking_url":null,"sort_order":"ATELIER 34ZERO MUZEUM","virtual_visit":null},"de":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"Die Geb\u00e4ude und der Park bergen einen Ausstellungraum, ein Dokumentationszentrum, eine Fachbuchhandlung, einen Ausstellungsgarten und ein Caf\u00e9. Die Sammlung umfasst Werke von Ado Hamelrijck, Wladyslaw Hasior, Pal Horvath, Jem, Roman Karalus, Walter Leblanc, Jean-Philippe Lecharlier, Waclaw Szpakowski, Guy Stukens, Bernar Venet, Bob Verschueren, Bernard Villers und Christine Wilm\u00e8s. ","description_print":"","booking_url":null,"sort_order":"ATELIER 34ZERO MUZEUM","virtual_visit":null},"it":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2