ronne, 227","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"UR Square","address_street_name":"Avenue de la Couronne","address_street_number":"227","address_street_box":null,"email":"hello@wondermei.be","website":"https:\/\/usquare.brussels\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la Couronne, 227","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"UR Square","address_street_name":"Avenue de la Couronne","address_street_number":"227","address_street_box":null,"email":"hello@wondermei.be","website":"https:\/\/usquare.brussels\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la Couronne, 227","address_line2":"1050 Ixelles","description_web":"UR Square, une occupation transitoire port\u00e9e par la communaut\u00e9, transformant les anciennes casernes Fritz Toussaint en un p\u00f4le durable, innovant et culturel.\n\nUn lieu d'innovation sociale, culturelles et durable. Initi\u00e9 par la SAU et g\u00e9r\u00e9 par Wonder Mei ASBL, UR square soutient 80 porteurs de projet au du site Usqaure \u00e0 Ixelles. EN mettant \u00e0 disposition des espaces d\u00e9di\u00e9s aux atelier, formations, activit\u00e9 culinaires, expositions et conf\u00e9rences, UR square cr\u00e9e des opportunit\u00e9s d'\u00e9changes entre cr\u00e9ateurs, entrepreneurs, \u00e9tudiants, professeurs, scientifiques, chercheurs, familles et voisins. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"UR Square","address_street_name":"Avenue de la Couronne","address_street_number":"227","address_street_box":null,"email":"hello@wondermei.be","website":"https:\/\/u