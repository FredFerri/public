,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"In the dark","shortdescr":"Un spectacle dans le noir complet, un voyage sensoriel.","longdescr":"\u00c0 travers l\u2019ou\u00efe, le go\u00fbt, le toucher et l\u2019odorat vous percevrez un spectacle comme vous n\u2019en avez jamais vu ! D\u00e8s son arriv\u00e9e le public est plong\u00e9 dans l\u2019obscurit\u00e9 la plus totale, les com\u00e9diens se chargeant de les conduire \u00e0 leurs si\u00e8ges. Une fois assis confortablement, les sens se r\u00e9veillent et le spectacle commence. Les com\u00e9diens demandent un mot \u00e0 l\u2019auditoire, un mot qui sera le fil rouge\u2026 invisible du spectacle. C\u2019est parti pour plus d\u2019une heure de saveurs, d\u2019histoires, de chansons, de parfums, de voix, de sons, de mati\u00e8res, de musiques\u2026 dans des tableaux et des sc\u00e8nes tiss\u00e9s \u00e0 partir du fil rouge de la soir\u00e9e.","performers":"Dominique Pattuelli, Na\u00efma Ostrowski, Gregory Bracco, Nicolas Baras, Gilles Delvaulx, Philippe Rasse","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/In-The-Dark.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539262"},"nl":{"name":"In the dark","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visit