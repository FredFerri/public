 op. Het is niet erg als je er als eens naast zit, zolang er maar ambiance is!\r\n\r\nVoor de nieuwe editie kunnen we terecht in het 1030 Caf\u00e9, in de J. Stobbaertslaan 100, 1030 Schaarbeek . GRAAF ons muzikaal begeleiden.\r\n\r\nNoteer alvast deze woensdagavonden in je agenda: 26 oktober, 30 november, 25 januari en 1 maart. We zingen telkens vanaf 20u30, maar kom gerust eerder de kelen smeren. 1030 Caf\u00e9 is open vanaf 16.00 uur. Zingen, dat is uiteraard gratis.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.1030cultuur.be\/nl\/event\/581\/schaarbeekvoix","email":"rpeeters@1030.be","phone_contact":"+32 472 85 71 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544156"},"en":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rpeeters@1030.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544156"},"de":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544156"},"it":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544156"},"sp":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544156"},"pt":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/v