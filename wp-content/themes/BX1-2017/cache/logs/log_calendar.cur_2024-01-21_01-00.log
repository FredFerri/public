cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-01-20T01:03:25+01:00","published_at":"2023-12-15T14:55:21+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":290529,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.29744417462950146,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"The Wells Run Dry de Fabiola Ferrero","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005242"},"pt":{"name":"The Wells Run Dry de Fabiola Ferrero","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005242"},"en":{"name":"The Wells Run Dry de Fabiola Ferrero","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005242"},"it":{"name":"The Wells Run Dry de Fabiola Ferrero","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005242"},"cn":{"name":"The Wells Run Dry de Fabiola Ferrero","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005242"},"fr":{"name":"The Wells Run Dry. Exposition sur le Venezuela de Fabiola Ferrero","shortdescr":"M\u00ealant images d\u2019archives, vid\u00e9os et photographies, l\u2019exposition The Wells Run Dry (\u00ab Les puits sont \u00e0 sec \u00bb) pr\u00e9sente les 6 mois de reportage de Fabiola Ferrero au V\u00e9n\u00e9zuela. La photojournaliste retourne sur les lieux symboliques du grand d\u00e9labrement, du lac de Maraca\u00efbo aux mines de sel d\u2019Araya, pour creuser le pass\u00e9 \u00e0 la recherche d\u2019un pays qui a exist\u00e9 avant l\u2019effondrement. ","longdescr":"Douzi\u00e8me laur\u00e9ate du Prix Carmignac du photojournalisme, Fabiola Ferrero s\u2019immerge dans les r\u00e9alit\u00e9s inexplor\u00e9es de sa patrie, le Venezuela. Elle y traque les vestiges d\u2019une gloire perdue et d\u2019une promesse de prosp\u00e9rit\u00e9 qui n\u2019existent plus que dans les m\u00e9moires. Depuis les ann\u00e9es 1960 et 1970, la rente p\u00e9troli\u00e8re et la paix d\u00e9mocratique semblaient pareillement soutenables dans ce pays de tous les possibles, jusqu\u2019\u00e0 ce qu\u2019une crise \u00e9conomique et politique colossale les balaie ensemble, en 2013.\nFabiola Ferrero, comme 7 millions de ses concitoyens \u2014 un quart de la population \u2014 avait quitt\u00e9 son pays pour suivre sa famille et ses amis. Elle retourne sur les lieux symboliques du grand d\u00e9labrement, du lac de Maraca\u00efbo aux mines de sel d\u2019Araya, pour creuser le pass\u00e9 \u00e0 la recherche d\u2019un pays qui a exist\u00e9 avant l\u2019effondrement.\n\nM\u00ealant images d\u2019archives, vid\u00e9os et photographies, l\u2019exposition The Wells Run Dry (\u00ab Les puits sont \u00e0 sec \u00bb) pr\u00e9sente ses 6 mois de reportage.\n\nDeux parcours, deux r\u00e9cits sont possibles, entre pass\u00e9 et pr\u00e9sent : suivre le cours de l\u2019histoire v\u00e9n\u00e9zu\u00e9lienne des grandes ann\u00e9es d\u2019abondance \u00e0 la disparition de la classe moyenne, ou prendre un chemin inverse empreint de nostalgie, de l\u2019\u00ab enfer \u00bb d\u2019aujourd\u2019hui au \u00ab paradis \u00bb enfui.\n\nSur r\u00e9servation \u00e0 partir du 11 d\u00e9cembre.\n","performers":"Fabiola Ferrero (n\u00e9e en 1991) est une journaliste et photographe n\u00e9e \u00e0 Caracas, au Venezuela. Utilisant sa formation en \u00e9criture et en journalisme d\u2019investigation, elle d\u00e9veloppe des projets visuels \u00e0 long terme en Am\u00e9rique du Sud, et plus particuli\u00e8rement sur la crise du Venezuela.","boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005242"},"sp":{"name":"The Wells Run Dry de Fabiola Ferrero","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005242"},"nl":{"name":"The Wells Run Dry de Fabiola Ferrero","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":"+32 485 32 8