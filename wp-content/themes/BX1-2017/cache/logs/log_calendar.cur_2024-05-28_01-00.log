aars die de laatste veertig jaar hun stempel hebben gedrukt. Vlakbij het Stefaniaplein beschikt de galerie over twee verschillende, maar bijna tegenover elkaar liggende ruimtes: de hoofdgalerie bevindt zich in de Isidore Verheydenstraat en het bijgebouw in de Eendrachtsstraat. ","description_print":null,"booking_url":null,"sort_order":"Baronian ","virtual_visit":null,"visit_url":null}},"neca":"gallery","facebook_id":null,"region":"brussels","backoffice_id":1917,"location":{"lat":50.83305444,"lon":4.36110166},"is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/91e48aec0095656dd450d5134d97cf463db8b247.jpg","width":1800,"height":1200,"ratio":1.5,"oEmbed_height":1200,"oEmbed_width":1800,"translations":{"de":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"pt":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"en":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"it":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"cn":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"fr":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"sp":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"nl":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/1657e2ad8947de4d5af17e1ffded95d6399a7a01.jpg","width":1800,"height":1200,"ratio":1.5,"oEmbed_height":1200,"oEmbed_width":1800,"translations":{"de":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"pt":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"en":{"title":"Baronian invites Parliament Gallery","copyright":"Isabelle Arthuis"},"it":{"title":"Baronian invites Parli