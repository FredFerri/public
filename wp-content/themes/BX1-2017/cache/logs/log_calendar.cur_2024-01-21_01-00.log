d_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-01-20T01:03:10+01:00","published_at":"2022-11-21T14:43:25+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":265985,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"expo","ranking":0.25,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[44,36],"translations":{"de":["Design","Museen & Kunstzentren"],"pt":[null,null],"en":["Design","Museums and art centers"],"it":["Design","Musei e centri artistici"],"cn":[null,null],"fr":["Design","Mus\u00e9es et art centers"],"sp":["Dise\u00f1o","Museos y centros de arte"],"nl":["Design","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Jaime Hayon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545985"},"pt":{"name":"Jaime Hayon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545985"},"en":{"name":"Jaime Hayon","shortdescr":null,"longdescr":"MAD Brussels \u2013 the center of fashion and design \u2013 focuses on contemporary design and looked for an international designer who embodies the essence of the Art Nouveau movement today. Someone who is not afraid to experiment with different disciplines: from design to furniture making, from painting to the total interior.\r\n\r\nSpanish artist & designer Jaime Hayon (Madrid, \u00b01974), sometimes referred to as the contemporary Antoni Gaudi, embodies all of these aspects: from mysterious ceramic creatures and finely crafted objects to colourful interiors and intriguing paintings. Working the boundaries between art, decoration and design, Hayon's creations are not only full of optimism, but also show the hand of a true craftsman. Hayon has been awarded the National Design Award in 2022.\r\n\r\nAfter founding Hayon Studio in 2001, he established a wide client base encompassing different functions and media, including furniture and household objects for B.D. Barcelona (ES), Cassina (IT), Fritz Hansen (DK), &Tradition (DK), Paola C. (IT) and Magis (IT); ceramic objects for Bosa (IT) and Lladro (ES); crystal creations for Baccarat (FR) and rugs for Nanimarquina (ES). \r\n\r\nNot only does he work for international furniture companies, Jaime Hayon also worked on total projects such as the Pompidou Caf\u00e9 in Paris, The Standard Hotel in Bangkok and the Moka Garden in Seoul. In recent years he focused on a more artistic course, working together with galleries as Kreo in Paris, creating public sculptures and treading new paths like painting and drawing. \r\n\r\nAfter exhibitions at the Groninger Museum in the Netherlands, the Holon Design Museum in Tel Aviv, The Daelim Museum in Seoul, The High Museum in Atlanta, and the Milwaukee design Museum and a major exhibition at the Centre del Carme in Valencia in 2022, his oeuvre will be on show for the first time in Brussels. The exhibition at MAD Brussels focusses on the diversity of his oeuvre, the innovative craftmanship he brings to the industry and the colourful aspects of his artistic approach.\r\n\r\nThe exhibition is part of the Brussels' Art Nouveau year, the Spanish presidency of the European Union and Design September. The exhibition is produced with support of the Spanish Embassy in Brussels and the AECID (Agencia Espa\u00f1ola de Cooperaci\u00f3n Internacional al Desarrollo).\r\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545985"},"it":{"name":"Jaime Hayon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545985"},"cn":{"name":"Jaime Hayon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545985"},"fr":{"name":"NUEVO NOUVEAU by artist & designer Jaime Hayon","shortdescr":null,"longdescr":"MAD Brussels - le centre de la mode et du design - se concentre sur le design contemporain et a cherch\u00e9 un designer international qui incarne l'essence du mouvement Art nouveau aujourd'hui. Quelqu'un qui n'a pas peur d'exp\u00e9rimenter diff\u00e9rentes disciplines : du design \u00e0 la fabrication de meubles, de la peinture \u00e0 l'ensemble de l'int\u00e9rieur.\r\n\r\nL'artiste et designer espagnol Jaime Hayon (Madrid, \u00b01974), parfois appel\u00e9 le Antoni Gaudi contemporain, incarne tous ces aspects : des myst\u00e9rieuses cr\u00e9atures en c\u00e9ramique et des objets d\u00e9licatement r\u00e9alis\u00e9s, des int\u00e9rieurs color\u00e9s et des peintures fascinantes. Travaillant les fronti\u00e8res entre l'art, la d\u00e9coration et le design, les cr\u00e9ations de Hayon sont non seulement pleines d'optimisme, mais montrent aussi la main d'un v\u00e9ritable artisan. \r\n\r\nApr\u00e8s avoir fond\u00e9 Hayon Studio en 2001, il a \u00e9tabli une large base de clients englobant diff\u00e9rentes fonctions et m\u00e9dias, y compris des meubles et des objets domestiques pour B.D. Barcelona (ES), Cassina (IT), Fritz Hansen (DK), &Tradition (DK), Paola C. (IT) et Magis (IT) ; des objets en c\u00e9ramique pour Bosa (IT) et Lladro (ES) ; des cr\u00e9ations en cristal pour Baccarat (FR) et des tapis pour Nanimarquina (ES). Hayon a re\u00e7u le National Design Award en 2022. \r\n\r\nIl travaille non seulement pour des entreprises internationales, Jaime Hayon a \u00e9galement travaill\u00e9 sur des projets totaux tels que le Caf\u00e9 Pompidou \u00e0 Paris, l'h\u00f4tel Standard \u00e0 Bangkok et le Moka Garden \u00e0 S\u00e9oul. Ces derni\u00e8res ann\u00e9es, il s'est concentr\u00e9 sur un parcours plus artistique, collaborant avec des galeries comme Kreo \u00e0 Paris, cr\u00e9er des sculptures publiques et emprunter de nouvelles voies comme la peinture et le dessin.\r\n\r\nApr\u00e8s des expositions au Groninger Museum aux Pays-Bas, Holon Design Museum \u00e0 Tel Aviv, Le mus\u00e9e Daelim de S\u00e9oul, le High Museum d'Atlanta, le Milwaukee Design Museum et une grande exposition au Centre del Carme \u00e0 Valence en 2022, son \u0153uvre sera pr\u00e9sent\u00e9e pour la premi\u00e8re fois \u00e0 Bruxelles. L'exposition au MAD Brussels met l'accent sur la diversit\u00e9 de son \u0153uvre, l'innovation artisanale qu'il apporte au secteur industriel et les aspects color\u00e9s de sa d\u00e9marche artistique.\r\n\r\nL'exposition s'inscrit dans le cadre de l'ann\u00e9e Art Nouveau de Bruxelles, de la pr\u00e9sidence espagnole de l'Union europ\u00e9enne et de Design September. L'exposition est r\u00e9alis\u00e9e avec le soutien de l'ambassade d'Espagne \u00e0 Bruxelles et de l'AECID (Agencia Espa\u00f1ola de Cooperaci\u00f3n Internacional al Desarrollo).","performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545985"},"sp":{"name":"Jaime Hayon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545985"},"nl":{"name":"Jaime Hayon","shortdescr":null,"longdescr":"MAD Brussels - het centrum voor mode en design - richt zich op hedendaags design en zocht een internationale ontwerper die de essentie van de Art Nouveau beweging vandaag belichaamt. Iemand die niet bang is om te experimenteren met verschillende disciplines: van design tot het maken van meubels, van schilderkunst tot het totaalinterieur.\r\n\r\nDe Spaanse artiest & ontwerper Jaime Hayon (Madrid, \u00b01974), ook wel de hedendaagse Antoni Gaudi genoemd, belichaamt al deze aspecten: van mysterieuze keramische wezens en fijn bewerkte objecten tot kleurrijke interieurs en intrigerende schilderijen. Hayons creaties, die de grenzen tussen kunst, decoratie en design opzoeken, zitten niet alleen vol optimisme, maar tonen ook het kunnen van een echte vakman. \r\n\r\nNa de oprichting van Hayon Studio in 2001 bouwde hij een breed en uiteenlopen klantenbestand op, waaronder meubels en huishoudelijke objecten voor B.D. Barcelona (ES), Cassina (IT), Fritz Hansen (DK), &Tradition (DK), Paola C. (IT) en Magis (IT); keramische objecten voor Bosa (IT) en Lladro (ES); kristallen creaties voor Baccarat (FR) en tapijten voor Nanimarquina (ES). Hayon heeft de National Design Award gekregen in 2022. \r\n\r\nNiet alleen werkt hij voor internationale meubelbedrijven, Jaime Hayon werkte ook aan totaalprojecten zoals het Caf\u00e9 Pompidou in Parijs, The Standard Hotel in Bangkok en de Moka Garden in Seoul. De laatste jaren richtte hij zich op een meer artistiek parcours, hij werkte samen met galeries als Kreo in Parijs, ontwierp publieke  sculpturen en bewandelde nieuwe paden zoals schilderen en tekenen. \r\n\r\nNa tentoonstellingen in het Groninger Museum in Nederland, het Holon Design Museum in Tel Aviv, Het Daelim Museum in Seoul, Het High Museum in Atlanta, het Milwaukee design Museum en een grote tentoonstelling in het Centre del Carme in Valencia in 2022, zal zijn oeuvre voor het eerst in Brussel te zien zijn. De tentoonstelling in MAD Brussels richt zich op de diversiteit van zijn oeuvre, het innovatieve vakmanschap dat hij de industrie bijbrengt en de kleurrijke aspecten van zijn artistieke aanpak.\r\n\r\nDe tentoonstelling maakt deel uit van het Brusselse Art Nouveau-jaar, het Spaanse voorzitterschap van de Europese Unie en Design September. De tentoonstelling komt tot stand met steun van de Spaanse ambassade in Brussel en de AECID (Agencia Espa\u00f1ola de Cooperaci\u00f3n Internacional al Desarrollo).\r\n\r\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545985"}},"place":{"id":250516,"translations":{"de":{"name":"MAD \u2013 Home of Creators ","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels ist eine Br\u00fcsseler Mode- und Designplattform, die sich der F\u00f6rderung, Unterst\u00fctzung und Begleitung der Br\u00fcsseler Modesch\u00f6pfer und Designern verschrieben hat, um sowohl landesweit als auch international ihre Reichweite zu erh\u00f6hen.\r\n\r\nDie Er\u00f6ffnung des neuen, komplett in Wei\u00df gehaltenen Geb\u00e4udes hat dem MAD Brussels noch einmal frischen Wind in den Segeln beschert. Hier befinden sich nicht nur Ressourcen f\u00fcr Vertreter der Kreativindustrie und damit zusammenh\u00e4ngenden Metiers, sondern auch vielf\u00e4ltig nutzbare Arbeitspl\u00e4tze und Orte der Begegnung. Modesch\u00f6pfer und Designer haben hier eine Anlaufstelle, gleichzeitig finden in den R\u00e4umen Ateliers, Workshops, Seminare, Ausstellungen, Modeschauen, Kunst-Performances statt\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MAD \u2013 Home of Creators ","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MAD \u2013 Home of Creators ","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels is a Brussels\u2019 platform for gathering expertise from the city\u2019s Fashion and Design sectors. It aims to help with the promotion and development of Brussels stylists and designers and improve their exposure nationally and abroad.\r\n\r\nThe opening in April 2017 of their brand new, sparkling white headquarters marked something of a renaissance for the non-profit organisation, which can now multiply and combine its campaigns. It houses a ressource centre for professionals of the creative industries and related sectors, along with adaptable workspaces, meeting spaces, workshops, seminar rooms and a large space dedicated to public activities where multiple events are organised every year: exhibitions, fashion shows, artistic performances\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"MAD \u2013 Home of Creators ","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"MAD \u2013 Home of Creators ","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MAD \u2013 Home of Creators ","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels est la plateforme bruxelloise d\u2019expertise dans les secteurs de la Mode et du Design.   Elle s\u2019emploie \u00e0 renforcer la promotion, \u00e0 accompagner le d\u00e9veloppement des stylistes et designers bruxellois et \u00e0 accro\u00eetre leur rayonnement (inter )national.  \r\n\r\nL\u2019ouverture en avril 2017 du nouveau b\u00e2timent enti\u00e8rement blanc a marqu\u00e9 une renaissance pour l\u2019asbl, qui dans ce lieu unique multiplie et combine ses actions. Il h\u00e9berge le centre de ressources pour les professionnels des industries cr\u00e9atives aux fili\u00e8res de m\u00e9tiers d\u00e9riv\u00e9es, des espaces de travail polyvalents, lieux de rencontres, d\u2019accueil de cr\u00e9ateurs, d\u2019ateliers, de s\u00e9minaires, ainsi qu\u2019un grand espace d\u00e9di\u00e9 aux activit\u00e9s publiques o\u00f9 sont organis\u00e9es chaque ann\u00e9e de multiples \u00e9v\u00e8nements: expositions, d\u00e9fil\u00e9s, performances artistiques,\u2026\r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"MAD \u2013 Home of Creators ","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels es una plataforma de Bruselas que reune expertos del los sectores de la moda y el dise\u00f1o. Tiene como objetivo ayudar en la promoci\u00f3n y el desarrollo de los dise\u00f1adores y estilistas de Bruselas y mejorar su imagen nacional e internacional.\r\nLa apertura de su novedosa y chispeante sede en abril de 2017 marc\u00f3 algo as\u00ed como el renacimiento para la organizaci\u00f3n sin \u00e1nimo de lucro, que ahora puede multiplicar y combinar sus campa\u00f1as. Posee un centro de recursos para profesionales de industrias culturales y sectores relacionados, junto con espacios de trabajo adaptados, lugares de reuni\u00f3n, talleres, seminarios y un gran espacio dedicado a actividades p\u00fablicas donde se organizan diversos eventos cada a\u00f1o: exhibiciones, desfiles de moda, representaciones art\u00edsticas\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MAD \u2013 Home of Creators ","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels is het Brussels kennisplatform voor de mode- en designsectoren.  Het zet zich in voor de promotie en begeleiding van Brusselse stylisten en ontwerpers en de vergroting van hun (inter)nationale uitstraling. \r\n\r\nDe opening van hun nieuwe, volledig witte gebouw in april 2017 betekende een belangrijke impuls voor de vzw die op die unieke plek zijn verschillende doelstellingen kan uitbreiden en combineren. Het gebouw herbergt het onderzoekscentrum voor professionals uit de creatieve sectoren en aanverwante beroepsgroepen, multifunctionele werkruimtes, ontmoetingsplekken, ontvangstruimtes voor ontwerpers, workshops en seminaries en daarbij ook nog een grote ruimte waarin elk jaar verschillende activiteiten voor het grote publiek plaatsvinden, zoals tentoonstellingen, modeshows of artistieke performances.  \r\n","descr