king_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":42029,"location":{"lat":50.8480832,"lon":4.3552506},"region":"brussels","last_updated_at":"2024-03-06T15:27:52+01:00","published_at":"2024-03-06T15:27:52+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":241348,"translations":{"de":{"name":"Fondation Folon","address_street_name":"Dr\u00e8ve de la Ram\u00e9e","address_street_number":"6 A","address_street_box":null,"email":"fondation.folon@skynet.be","website":"http:\/\/www.fondationfolon.be","phone_contact":"+32 2 653 34 56","phone_booking":null,"address_zip":"1310","address_city":"La Hulpe","address_line1":"Dr\u00e8ve de la Ram\u00e9e, 6 A","address_line2":"1310 La Hulpe","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation Folon","address_street_name":"Dr\u00e8ve de la Ram\u00e9e","address_street_number":"6 A","address_street_box":null,"email":"fondation.folon@skynet.be","website":"http:\/\/www.fondationfolon.be","phone_contact":"+32 2 653 34 56","phone_booking":null,"address_zip":"1310","address_city":"La Hulpe","address_line1":"Dr\u00e8ve de la Ram\u00e9e, 6 A","address_line2":"1310 La Hulpe","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Folon Foundation","address_street_name":"Dr\u00e8ve de la Ram\u00e9e","address_street_number":"6 A","address_street_box":null,"email":"fondation.folon@skynet.be","website":"http:\/\/www.fondationfolon.be","phone_contact":"+32 2 653 34 56","phone_booking":null,"address_zip":"1310","address_city":"La Hulpe","address_line1":"Dr\u00e8ve de la Ram\u00e9e, 6 A","address_line2":"1310 La Hulpe","description_web":"The famous Belgian artist Jean-Michel Folon put more than five hundred works just twenty minutes outside of Brussels, in the farm of the castle of La Hulpe. This charming and characteristic building in the middle of the marvellous Solvay Park is home to more than forty years of creation.nWatercolours, engravings, posters and sculptures are presented in an original and lively setting, creating a dialogue between the works of art and the poetic place that houses them. Music, films and optical effects enliven the route. The result is a strong, magical and astonishing exhibition.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondation Folon","address_street_name":"Dr\u00e8ve de la Ram\u00e9e","address_street_number":"6 A","address_street_box":null,"email":"fondation.folon@skynet.be","website":"http:\/\/www.fondationfolon.be","phone_contact":"+32 2 653 34 56","phone_booking":null,"address_zip":"1310","address_city":"La Hulpe","address_line1":"Dr\u00e8ve de la Ram\u00e9e, 6 A","address_line2":"1310 La Hulpe","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Folon","address_street_name":"Dr\u00e8ve de la Ram\u00e9e","address_street_number":"6 A","address_street_box":null,"email":"fondation.folon@skynet.be","website":"http:\/\/www.fondationfolon.be","phone_contact":"+32 2 653 34 56","phone_booking":null,"address_zip":"1310","address_city":"La Hulpe","address_line1":"Dr\u00e8ve de la Ram\u00e9e, 6 A","address_line2":"1310 La Hulpe","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Folon","address_street_name":"Dr\u00e8ve de la Ram\u00e9e","address_street_number":"6 A","address_street_box":null,"email":"fondation.folon@skynet.be","website":"http:\/\/www.fondationfolon.be","phone_contact":"+32 2 653 34 56","phone_booking":null,"address_zip":"1310","address_city":"La Hulpe","address_line1":"Dr\u00e8ve de la Ram\u00e9e, 6 A","address_line2":"1310 La Hulpe","description_web":"L\u2019artiste belge Jean-Michel Folon a d\u00e9pos\u00e9 plus de cinq cents \u0153uvres \u00e0 vingt minutes de Bruxelles, dans la Ferme du Ch\u00e2teau de La Hulpe. Ce b\u00e2timent de charme et de caract\u00e8re, situ\u00e9 au c\u0153ur du merveilleux Parc Solvay, rec\u00e8le plus de quarante ans de cr\u00e9ation.nAquarelles, gravures, affiches et sculptures sont pr\u00e9sent\u00e9es dans une sc\u00e9nographie originale et vivante, cr\u00e9ant un vrai dialogue entre les \u0153uvres et le lieu po\u00e9tique qui les abrite. Musique, films et effets d\u2019optique animent le parcours. Il en r\u00e9sulte une exposition forte, magique, \u00e9tonnante.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Fondation Folon","address_street_name":"Dr\u00e8ve de la Ram\u00e9e","address_street_number":"6 A","address_street_box":null,"email":"fondation.folon@skynet.be","website":"http:\/\/www.fondationfolon.be","phone_contact":"+32 2 653 34 56","phone_booking":null,"address_zip":"1310","address_city":"La Hulpe","address_line1":"Dr\u00e8ve de la Ram\u00e9e, 6 A","address_line2":"1310 La Hulpe","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Stichting Folon","address_street_name":"Dr\u00e8ve de la Ram\u00e9e","address_street_number":"6 A","address_street_box":null,"email":"fondation.folon@skynet.be","website":"http:\/\/www.fondationfolon.be","phone_contact":"+32 2 653 34 56","phone_booking":null,"address_zip":"1310","address_city":"La Hulpe","address_line1":"Dr\u00e8ve de la Ram\u00e9e, 6 A","address_line2":"1310 La Hulpe","description_web":"In de hoeve van het kasteel van Terhulpen, op een boogscheut van Brussel, stelt de Belgische kunstenaar Jean-Michel Folon meer dan 500 werken tentoon.nDit authentieke gebouw ligt temidden het prachtige Solvay park en herbergt meer dan 40 jaar creatie.nAquarellen, etsen, affiches, en beeldhouwwerken worden gepresenteerd in een levendige en originele scenografie, die een dialoog tot stand brengt tussen de kunstwerken en de po\u00cc\u00c7tische plek waarin ze vertoeven. Muziek, films en optische effecten animeren het parcours. Het resultaat is een sterke, magische en wonderlijke tentoonstelling.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"wallonia","backoffice_id":3839,"location":{"lat":50.7303658,"lon":4.4514264},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:16:42+02:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/e11442cbef93021106178a6173fb647b41c4fa89.jpg","width":4160,"height":6240,"ratio":0.67,"oEmbed_height":6240,"oEmbed_width":4160,"translations":{"de":{"title":"Sculptures walk - Folon. A journey in Brussels","copyright":"\u00a9 Xavier Janssens \u00a9 Fondation Folon\/ADAGP"},"pt":{"title":"Sculptures walk - Folon. A journey in Brussels","copyright":"\u00a9 Xavier Janssens \u00a9 Fondation Folon\/ADAGP"},"en":{"title":"Sculptures walk - Folon. A journey in Brussels","copyright":"\u00a9 Xavier Janssens \u00a9 Fondation Folon\/ADAGP"},"it":{"title":"Sculptures walk - Folon. A journey in Brussels","copyright":"\u00a9 Xavier Janssens \u00a9 Fondation Folon\/ADAGP"},"cn":{"title":"Sculptures walk - Folon. A journey in Brussels","copyright":"\u00a9 Xavier Janssens \u00a9 Fondation Folon\/ADAGP"},"fr":{"title":"Sculptures walk - Folon. A journey in Brussels","copyright":"\u00a9 Xavier Janssens \u00a9 Fondation Folon\/ADAGP"},"sp":{"title":"Sculptures walk - Folon. A journey in Brussels","copyright":"\u00a9 Xavier Janssens \u00a9 Fondation Folon\/ADAGP"},"nl":{"title":"Sc