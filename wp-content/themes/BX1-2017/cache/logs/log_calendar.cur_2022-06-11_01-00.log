:"21:00:00"},{"day":"2022-12-21","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-22","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-23","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-24","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-25","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-26","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-27","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-28","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-29","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-30","doors":null,"start":"07:00:00","end":"21:00:00"},{"day":"2022-12-31","doors":null,"start":"07:00:00","end":"21:00:00"}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 07:00 \u00e0 21:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 07:00 tot 21:00"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 07:00 to 21:00"]},"date_start":"2021-06-29","date_end":"2022-12-31","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":24}],"child_events":[],"parent_events":[],"targets":{"list":[16,19,11,12,10],"translations":{"fr":["Ecoles","Enseignants","Famille","LGTBQIA","Seniors"],"nl":["Scholen","Leerkrachten","Familie","LGTBQIA","Senioren"],"en":["Schools","Teachers","Family","LGTBQIA","Seniors"]}},"educational_targets":{"list":[3],"translations":{"fr":["Secondaire"],"nl":["Secundair onderwijs"],"en":["Secondary school"]}},"visit_profile":{"list":[322,320],"translations":{"fr":["Art Nouveau & Art D\u00e9co","Classique"],"nl":["Art Nouveau & Art D\u00e9co","Klassiek"],"en":["Art Nouveau &  Art D\u00e9co","Classic"]}},"tags":["exterior","kids"],"accessibilities":{"list":[266],"translations":{"fr":["Brussels Health Safety Label"],"nl":["Brussels Health Safety Label"],"en":["Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:06:30+02:00","published_at":"2021-06-29T16:06:00+02:00","backoffice_id":234631,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.12197836292507},{"id":533838,"date_start":"2022-05-10","date_end":"2022-09-04","date_next":"2022-06-10","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,47],"translations":{"fr":["Mus\u00e9es et art centers","Bande dessin\u00e9e"],"nl":["Musea en kunstcentra","Stripverhaal"],"en":["Museums and art centers","Comicstrip"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Le clan de la rivi\u00e8re sauvage - L'oeil du serpent","shortdescr":"Avertissement au lecteur : ce que vous avez sous les yeux n\u2019est pas un livre. C\u2019est une porte. L\u2019une des portes d\u2019entr\u00e9e d\u2019un monde fabuleux, un monde d\u2019aventure et de magie, un monde d\u2019\u00e9motions, de rires et d\u2019\u00e9pouvante : le monde des Grands Conteurs.","longdescr":"Dans le petit village de Saint-Isidore, la vie est tranquille. Un peu trop d\u2019ailleurs pour le jeune Zaki, qui r\u00eave de vivre en vrai les aventures qu\u2019il trouve dans les livres. Jusqu\u2019au jour o\u00f9 Anacharsis, Grand Conteur itin\u00e9rant, arrive et raconte aux habitants une histoire de pirates. Lorsque Zaki et son copain Choco apprennent que le vieil homme va repartir sans achever son r\u00e9cit, ils d\u00e9cident d\u2019en d\u00e9couvrir la fin par eux-m\u00eames. Ils s\u2019introduisent alors dans la chambre du conteur pour lire son gigantesque recueil, et sont surpris par cette peste de M\u00e9lie et sa petite s\u0153ur Loulou. Les quatre enfants sont loin d\u2019imaginer le pouvoir du livre qu\u2019ils vont feuilleter, ou les convoitises qu\u2019il peut attirer\u2026\r\n\r\nLes \u00e9ditions de la Goutti\u00e8re\r\n \r\n\r\nUne confr\u00e9rie de Grands Conteurs, un livre magique, des passages possibles entre plusieurs mondes, une chasse au tr\u00e9sor\u2026autant d\u2019\u00e9l\u00e9ments fascinants qui promettent une aventure extraordinaire ! Aux c\u00f4t\u00e9s des personnages attachants du \u00ab Clan de la rivi\u00e8re sauvage \u00bb, le r\u00e9cit riche en rebondissements \u00e9crit par R\u00e9gis Hauti\u00e8re entra\u00eene le lecteur dans un monde imaginaire captivant. Ce voyage en terre de contes se dessine sous les traits sensibles et d\u00e9licats de Renaud Dillies dont le travail graphique expressif, accentu\u00e9 par la mise en couleur dynamique de Christophe Bouchard, alterne les styles et les ambiances pour porter le r\u00e9cit. Apr\u00e8s avoir unis leurs talents sur les tr\u00e8s po\u00e9tiques titres Ab\u00e9lard et Alvin (Dargaud), le duo d\u2019auteurs complices s\u2019associe de nouveau pour proposer une s\u00e9rie jeunesse originale. Avec cette exposition, le CBBD invite petits et grands \u00e0 d\u00e9couvrir une aventure plac\u00e9e sous le signe de l\u2019amiti\u00e9 et du suspense, qui c\u00e9l\u00e8bre la magie des mots, des livres et des histoires\u2026\r\n\r\nM\u00e9lanie Andrieu, Centre Belge de la Bande Dessin\u00e9e\r\nAvec le soutien de la r\u00e9gion Bruxelles-Capitale","performers":null,"boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/la-gallery\/le-clan-de-la-riviere-sauvage","email":"visit@cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533838.html"},"nl":{"name":"Le clan de la rivi\u00e8re sauvage","shortdescr":"Waarschuwing aan de lezer: wat voor u ligt is geen boek. Het is een deur. Een van de deuren naar een fabelachtige wereld, een wereld vol avontuur en magie, vol gevoelens, schaterlachen en afgrijzen: de wereld van de Grote Verhalenvertellers.","longdescr":"In het kleine dorpje Saint-Isidore is het leven rustig. Een beetje te rustig voor de jonge Zaki, die ervan droomt avonturen te beleven zoals in de boeken die hij leest. Tot op een dag Anacharsis aankomt, de Grote Reizende Verteller, die de bewoners een verhaal vertelt over piraten. Wanneer Zaki en zijn vriend Choco vernemen dat de oude man zal verder trekken zonder zijn verhaal af te maken, besluiten ze zelf het einde te achterhalen. Ze breken in in de kamer van de verhalenverteller om zijn gigantische verzameling te lezen, en worden verrast door M\u00e9lie, een echte lastpost, en haar kleine zusje Loulou. De vier kinderen kunnen niet vermoeden dat het boek dat ze gaan doorbladeren geheime krachten heeft, en dat ze niet de enigen zijn die er hun oog op lieten vallen...\r\n\r\nUitgeverij la Goutti\u00e8re\r\n\r\n\r\nEen genootschap van Grote Verhalenvertellers, een magisch boek, geheime doorgangen tussen verschillende werelden, een schattenjacht... het zijn stuk voor stuk fascinerende elementen die een buitengewoon avontuur beloven! In het spoor van de vertederende personages van de \"Clan van de Wilde Rivier\" voert het verhaal van R\u00e9gis Hauti\u00e8re, dat rijk is aan verrassende wendingen, de lezer mee in een boeiende fantasiewereld. Deze reis in het land der verhalen wordt verbeeld door de gevoelige en delicate streken van Renaud Dillies, wiens expressieve lijn, geaccentueerd door de dynamische inkleuring van Christophe Bouchard, stijlen en stemmingen afwisselt om het verhaal te ondersteunen. Nadat ze hun talenten eerder al bundelden voor de zeer po\u00ebtische titels Ab\u00e9lard en Alvin (Dargaud), slaan de twee auteurs de handen opnieuw in mekaar om een originele jeugdreeks aan te bieden. Met deze tentoonstelling nodigt het Stripcentrum jong en oud uit om een avontuur te ontdekken in het teken van vriendschap en spanning, dat de magie van woorden, boeken en verhalen viert...\r\n\r\nBelgisch Stripcentrum\r\nMet de steun van het Brussels Hoofdstedelijk Gewest","performers":null,"boxoffice_url":null,"website":"https:\/\/www.stripmuseum.be\/nl\/tentoonstellingen\/de-gallery\/le-clan-de-la-riviere-sauvage","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533838.html"},"en":{"name":"Le clan de la rivi\u00e8re sauvage","shortdescr":"Warning to the reader : what you are looking at is not a book. It is a door. One of the doors to a fabulous world, a world of adventure and magic, a world of emotions, laughter and horror : the world of the Great Storytellers.","longdescr":"In the small village of Saint-Isidore, life is quiet. A little too quiet for young Zaki, who dreams of living the adventures he finds in books. Until the day when Anacharsis, the Great Travelling Storyteller, arrives and tells the inhabitants a story about pirates. When Zaki and his friend Choco learn that the old man is going to leave without finishing his story, they decide to find out the end by themselves. They break into the storyteller's room to read his gigantic collection, and are surprised by that pest Melie and her little sister Loulou. The four children are far from imagining the power of the book they are about to leaf through, or the envy it may attract...\r\n\r\nLes \u00e9ditions de la Goutti\u00e8re\r\n\r\n\r\nA brotherhood of Great Storytellers, a magical book, possible passages between several worlds, a treasure hunt... all fascinating elements that promise an extraordinary adventure ! Alongside the endearing characters of the \"Clan of the Wild River\", the story, rich in twists and turns, written by R\u00e9gis Hauti\u00e8re, takes the reader into a captivating imaginary world. This journey into the land of tales is drawn under the sensitive and delicate strokes of Renaud Dillies whose expressive graphic work, accentuated by the dynamic colouring of Christophe Bouchard, alternates styles and moods to carry the story. After having combined their talents on the very poetic titles Ab\u00e9lard and Alvin (Dargaud), the two authors are once again teaming up to offer an original youth series. With this exhibition, the BCSC invites young and old to discover an adventure placed under the sign of friendship and suspense, which celebrates the magic of words, books and stories...\r\n\r\nThe Belgian Comic Strip Center\r\nWith the support of the Brussels Capital Region","performers":null,"boxoffice_url":null,"website":"https:\/\/www.comicscenter.net\/en\/exhibitions\/the-gallery\/le-clan-de-la-riviere-sauvage","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533838.html"},"de":{"name":"GALLERY - Le clan de la rivi\u00e8re sauvage - L'oeil du serpent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533838.html"},"it":{"name":"GALLERY - Le clan de la rivi\u00e8re sauvage - L'oeil du serpent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533838.html"},"sp":{"name":"GALLERY - Le clan de la rivi\u00e8re sauvage - L'oeil du serpent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533838.html"},"pt":{"name":"GALLERY - Le clan de la rivi\u00e8re sauvage - L'oeil du serpent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533838.html"},"cn":{"name":"GALLERY - Le clan de la rivi\u00e8re sauvage - L'oeil du serpent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533838.html"}},"place":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Attraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur depuis plus de 25 ans auteurs et h\u00e9ros du 9\u00e8me Art. \r\n\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Tintin et les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite. \r\n\r\nMagnifi\u00e9 par un exceptionnel cadre Art Nouveau con\u00e7u par Victor Horta, le Mus\u00e9e de la Bande Dessin\u00e9e est tout autant un hommage aux pionniers qu'un regard sur la BD actuelle.\r\n\r\n\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stripmuseum","address_street_name":"Zandstraat","address_street_number":"20","address_street_box":null,"email":"visit@stripmuseum.be","website":"http:\/\/www.stripmuseum.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zandstraat, 20","address_line2":"1000 Brussel","description_web":"Het Stripmuseum is voor al wie Brussel bezoekt een \u2018must\u2019 in het hartje van de stad. Al meer dan 25 jaar richt het museum de spots op de auteurs en de helden van de Negende Kunst. \r\n\r\nAan de hand van permanente tentoonstellingen \u2013 die regelmatig vernieuwd worden \u2013 en een afwisselend programma van tijdelijke exposities kan je er als bezoeker kennismaken met de talrijke facetten van het stripverhaal. Kuifje en de Smurfen nemen je mee naar avonturenland, een wereld waar de creativiteit geen grenzen kent. \r\n\r\nHet uitzonderlijke art nouveau-gebouw van Victor Horta geeft een bezoek nog een extra dimensie. Het Stripmuseum is tegelijk een hommage aan de pioniers van het medium als een blik op het hedendaagse stripverhaal.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"http:\/\/www.comicscenter.net\/en\/home","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Sables, 20","address_line2":"1000 Brussels","description_web":"An accomplished attraction located in the heart of Brussels, the Belgian Comic Strip Center has been honouring the creators and heroes of the 9th Art for more than 25 years.\r\n\r\nThe regularly renewed permanent exhibitions and a diversified programme of temporary exhibitions enable visitors to discover the countless aspects of comics art. Tintin and the Smurfs lead the way towards further adventures, an encounter with a world where creativity has no limits. \r\n\r\nEnhanced by an exceptional Art Nouveau home designed by Victor Horta, the Belgian Comic Strip Center is just as much a tribute to the pioneers as a glimpse of contemporary comics art.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Comic-Museum - Centre Belge de la Bande Dessin\u00e9e","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo del Fumetto","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Il Museo del Fumetto CBBD, situato nel cuore storico di Bruxelles, riunisce su pi\u00f9 di 4.000 m\u00b2 tutto ci\u00f2 che riguarda il fumetto. Ospitato in un edificio tempio dell'Art Nouveau disegnato da Victor Horta, il museo \u00e8 il regno di celebri eroi dei fumetti belgi: Tintin, i Puffi, Lucky Luke, Gaston Lagaffe, Blake et Mortimer, Marsupilami... Le esposizioni organizzate, la biblioteca e il centro di documentazione, non solo rendono il museo vivo e dinamico, ma sono veri e propri centri di documentazione sul fumetto il cuicatalogo \u00e8 accessibile on-line. Il centro belga del fumetto organizza conferenze, laboratori creativi ed animazioni, ecc.\r\n\r\n\r\nAperto i giorni festivi eccetto il 25\/12 e 01\/01. Il Centro Belga del Fumetto diverse formule di visita: la visita guidata del museo, quella del Percorso del Fumetto o quella del museo Marc Sleen. Il museo, anzi il centro belga del fumetto-CBBD ospita anche una brasserie dove potete respirare l'inconfondibile atmosfera di Bruxelles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centro belga del c\u00f3mic (CBBD)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Ubicado en el centro de Bruselas, en un edificio Art Nouveau construido por Victor Horta en 1906, el CBBD abri\u00f3 sus puertas el 6 de octubre de 1989. \r\n\r\nEn pocos a\u00f1os, este museo se ha convertido en una de las principales atracciones de Bruselas. \r\n\r\nCada a\u00f1o, m\u00e1s de 200.000 visitantes recorren las exposiciones permanentes y temporales que se celebran en m\u00e1s de 4.000 m 2. \r\n\r\nAunque las exposiciones contribuyen a convertir este templo en un lugar viviente, din\u00e1mico y atrayente, esta herramienta al servicio de la promoci\u00f3n del c\u00f3mic constituye un centro de documentaci\u00f3n moderno, con un cat\u00e1logo accesible online. \r\n\r\nTambi\u00e9n se llevan a cabo conferencias y talleres creativos.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"O Centro Belga da Banda Desenhada","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Atra\u00e7\u00e3o incontorn\u00e1vel situada no centro de Bruxelas, o museu da BD comemora mais de 25 anos de autores e her\u00f3is da 9.\u00aa arte.\r\nAs exposi\u00e7\u00f5es permanentes regularmente renovadas e um vasto programa de exposi\u00e7\u00f5es tempor\u00e1rias levam os visitantes a descobrir as in\u00fameras facetas da banda desenhada. Tintim e os Estrumpfes abrem a porta a outras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":405,"location":{"lat":50.85107181,"lon":4.36006874},"region":"brussels","last_updated_at":"2022-06-10T01:07:43+02:00","published_at":"2013-10-19T01:13:30+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Attraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur depuis plus de 25 ans auteurs et h\u00e9ros du 9\u00e8me Art. \r\n\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Tintin et les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite. \r\n\r\nMagnifi\u00e9 par un exceptionnel cadre Art Nouveau con\u00e7u par Victor Horta, le Mus\u00e9e de la Bande Dessin\u00e9e est tout autant un hommage aux pionniers qu'un regard sur la BD actuelle.\r\n\r\n\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stripmuseum","address_street_name":"Zandstraat","address_street_number":"20","address_street_box":null,"email":"visit@stripmuseum.be","website":"http:\/\/www.stripmuseum.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zandstraat, 20","address_line2":"1000 Brussel","description_web":"Het Stripmuseum is voor al wie Brussel bezoekt een \u2018must\u2019 in het hartje van de stad. Al meer dan 25 jaar richt het museum de spots op de auteurs en de helden van de Negende Kunst. \r\n\r\nAan de hand van permanente tentoonstellingen \u2013 die regelmatig vernieuwd worden \u2013 en een afwisselend programma van tijdelijke exposities kan je er als bezoeker kennismaken met de talrijke facetten van het stripverhaal. Kuifje en de Smurfen nemen je mee naar avonturenland, een wereld waar de creativiteit geen grenzen kent. \r\n\r\nHet uitzonderlijke art nouveau-gebouw van Victor Horta geeft een bezoek nog een extra dimensie. Het Stripmuseum is tegelijk een hommage aan de pioniers van het medium als een blik op het hedendaagse stripverhaal.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"http:\/\/www.comicscenter.net\/en\/home","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Sables, 20","address_line2":"1000 Brussels","description_web":"An accomplished attraction located in the heart of Brussels, the Belgian Comic Strip Center has been honouring the creators and heroes of the 9th Art for more than 25 years.\r\n\r\nThe regularly renewed permanent exhibitions and a diversified programme of temporary exhibitions enable visitors to discover the countless aspects of comics art. Tintin and the Smurfs lead the way towards further adventures, an encounter with a world where creativity has no limits. \r\n\r\nEnhanced by an exceptional Art Nouveau home designed by Victor Horta, the Belgian Comic Strip Center is just as much a tribute to the pioneers as a glimpse of contemporary comics art.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Comic-Museum - Centre Belge de la Bande Dessin\u00e9e","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo del Fumetto","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Il Museo del Fumetto CBBD, situato nel cuore storico di Bruxelles, riunisce su pi\u00f9 di 4.000 m\u00b2 tutto ci\u00f2 che riguarda il fumetto. Ospitato in un edificio tempio dell'Art Nouveau disegnato da Victor Horta, il museo \u00e8 il regno di celebri eroi dei fumetti belgi: Tintin, i Puffi, Lucky Luke, Gaston Lagaffe, Blake et Mortimer, Marsupilami... Le esposizioni organizzate, la biblioteca e il centro di documentazione, non solo rendono il museo vivo e dinamico, ma sono veri e propri centri di documentazione sul fumetto il cuicatalogo \u00e8 accessibile on-line. Il centro belga del fumetto organizza conferenze, laboratori creativi ed animazioni, ecc.\r\n\r\n\r\nAperto i giorni festivi eccetto il 25\/12 e 01\/01. Il Centro Belga del Fumetto diverse formule di visita: la visita guidata del museo, quella del Percorso del Fumetto o quella del museo Marc Sleen. Il museo, anzi il centro belga del fumetto-CBBD ospita anche una brasserie dove potete respirare l'inconfondibile atmosfera di Bruxelles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centro belga del c\u00f3mic (CBBD)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Ubicado en el centro de Bruselas, en un edificio Art Nouveau construido por Victor Horta en 1906, el CBBD abri\u00f3 sus puertas el 6 de octubre de 1989. \r\n\r\nEn pocos a\u00f1os, este museo se ha convertido en una de las principales atracciones de Bruselas. \r\n\r\nCada a\u00f1o, m\u00e1s de 200.000 visitantes recorren las exposiciones permanentes y temporales que se celebran en m\u00e1s de 4.000 m 2. \r\n\r\nAunque las exposiciones contribuyen a convertir este templo en un lugar viviente, din\u00e1mico y atrayente, esta herramienta al servicio de la promoci\u00f3n del c\u00f3mic constituye un centro de documentaci\u00f3n moderno, con un cat\u00e1logo accesible online. \r\n\r\nTambi\u00e9n se llevan a cabo conferencias y talleres creativos.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"O Centro Belga da Banda Desenhada","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Atra\u00e7\u00e3o incontorn\u00e1vel situada no centro de Bruxelas, o museu da BD comemora mais de 25 anos de autores e her\u00f3is da 9.\u00aa arte.\r\nAs exposi\u00e7\u00f5es permanentes regularmente renovadas e um vasto programa de exposi\u00e7\u00f5es tempor\u00e1rias levam os visitantes a descobrir as in\u00fameras facetas da banda desenhada. Tintim e os Estrumpfes abrem a porta a outras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":405,"location":{"lat":50.85107181,"lon":4.36006874},"region":"b