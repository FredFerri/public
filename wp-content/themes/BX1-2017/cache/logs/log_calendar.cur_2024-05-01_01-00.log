ranslations":{"de":{"name":"Kermesse 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.evere.brussels","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 32","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007770"},"pt":{"name":"Kermesse 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.evere.brussels","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 32","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007770"},"en":{"name":"Kermesse 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.evere.brussels","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 32","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007770"},"it":{"name":"Kermesse 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.evere.brussels","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 32","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007770"},"cn":{"name":"Kermesse 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.evere.brussels","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 32","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007770"},"fr":{"name":"Kermesse 2024","shortdescr":"Du vendredi 26 avril au dimanche 05 mai, Evere organisera la 3\u00e8me \u00e9dition de sa Kermesse. Elle vous accueillera sur le parvis du cimeti\u00e8re de Bruxelles, tous les jours de 16h00 \u00e0 22h00. Le week-end de 12h00 \u00e0 22h00.\n!!! Brocante dimanche 28\/04 & 05\/05 - 08:00 > 16:00 - Rue de l\u2019Arbre Unique ","longdescr":"Les forains proposeront la traditionnelle p\u00eache aux canards, des trampolines, un carrousel pour les plus petits, des man\u00e8ges, du tir \u00e0 la carabine et bien d\u2019autres attractions pour les grands comme les petits. Evidemment, barbes \u00e0 papa, pommes d\u2019amour, croustillons et autres friteries ne manqueront pas de vous r\u00e9galer !\nRejoignez-nous donc au parvis du cimeti\u00e8re de Bruxelles du 26 avril au 05 mai pour passer un moment festif entre ami\u00b7e\u00b7s ou en famille.\nLieu : Parvis du cimeti\u00e8re de Bruxelles - Avenue du Cimeti\u00e8re de Bruxelles 159 - 1140 Evere\n\nDates : du vendredi 26 avril au dimanche 05 mai. Heures semaine : de 16h00 \u00e0 22h00. Heures week-end : de 12h00 \u00e0 22h00\nInfo : 02 247 63 16 - 02 247 63 32 \u2013 promeco@evere.brussels","performers":"La kermesse fait son grand retour !","boxoffice_url":null,"website":"http:\/\/www.evere.brussels","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 32","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007770"},"sp":{"name":"Kermesse 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.evere.brussels","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 32","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007770"},"nl":{"name":"Kermis 2024","shortdescr":"Van vrijdag 26 april tot zondag 05 mei organiseert Evere de derde editie van de \u2018Kermis van Evere\u2019. Iedereen is welkom op het voorplein van het Kerkhof van Brussel, elke dag van 16.00 tot 22.00 uur. Weekend van 12.00 tot 22.00 uur.\nRommelmarkt zondag 28\/04 & 05\/05 - 08:00 > 16:00 - Eenboomstraat ","longdescr":"De foorkramers voorzien voor de kleinsten het traditionele eendjes vissen, trampolines en een draaimolen, terwijl de groteren hun gading zullen vinden in de andere molens, het arabijnschieten en de vele overige attracties.\nEn uiteraard mogen suikerspinnen, gekarameliseerde appels, smoutebollen en andere frituursnacks niet ontbreken, zodat iedereen kan smullen! Kom dus zeker langs op het voorplein van het Kerkhof van Brussel, van 26 april tot 05 mei om samen met vrienden of met het hele gezin feest te vieren.\n\nPlaats: Voorplein van het Kerkhof van Brussel - Kerkhof van Brussellaan 159 - 1140 Evere\nData: van 26 april tot 05 mei. Tijdstip week: van 16.00 tot 22.00 uur. Tijdstip weekend: van 12.00 tot 22.00 uur\nInfo: 02 247 63 16 - 02 247 63 32 \u2013 promeco@evere.brussels","performers":"De kermis is terug!","boxoffice_url":null,"website":"http:\/\/www.evere.brussels","email":"promeco@evere.brussels","phone_contact":"+32 2 247 63 16","phone_booking":"+32 2 247 63 32","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007770"}},"place":{"last_updated_at":"2022-03-24T10:13:21+01:00","published_at":"2013-10-19T01:13:32+02:00","id":206581,"translations":{"de":{"name":"Administration communale d'Evere","address_street_name":"Sq Servaas Hoedemaekers","address_street_number":"10","address_street_box":null,"email":"info@evere.brussels","website":"http:\/\/www.evere.brussels","phone_contact":"+32 2 247 62 62","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Sq Servaas Hoedemaekers, 10","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Administration communale d'Evere","address_street_name":"Sq Servaas Hoedemaekers","address_street_number":"10","address_street_box":null,"email":"info@evere.brussels","website":"http:\/\/www.evere.brussels","phone_contact":"+32 2 247 62 62","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Sq Servaas Hoedemaekers, 10","address_line2":"1140 Evere","description_web":null,"description_