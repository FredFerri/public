"date_start":"2025-02-26","date_end":"2025-06-29","date_next":"2025-03-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T12:22:45+01:00","published_at":"2025-02-05T12:02:36+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317645,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.25265977409642826,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Research in Residence #3: Stefaan Vervoort Marcel Broodthaers \u2013 The Architect is Absent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006212"},"pt":{"name":"Research in Residence #3: Stefaan Vervoort Marcel Broodthaers \u2013 The Architect is Absent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006212"},"en":{"name":"Research in Residence #3: Stefaan Vervoort Marcel Broodthaers \u2013 The Architect is Absent","shortdescr":"Marcel Broodthaers \u2013 The Architect is Absent explores Belgian artist Marcel Broodthaers\u2019s (1924\u20131976) engagements with architecture, design, and the city, between 1957 and 1967. During this decade, Broodthaers took up journalism and photography, made his first artworks, and established the key orientations for his emerging practice as an artist and writer.","longdescr":"Marcel Broodthaers \u2013 The Architect is Absent, the third exhibition in CIVA\u2019s Research in Residence program, explores Belgian artist Marcel Broodthaers\u2019s (1924\u20131976) engagements with architecture, design, and the city, between 1957 and 1967. During this decade, Broodthaers took up journalism and photography, made his first artworks, and established the key orientations for his emerging practice as an artist and writer.\n\nThe exhibition pivots around Monument Public n\u00ba4 (1963), Broodthaers\u2019s earliest exhibited artwork. This exhibition contextualizes this early work, examining its formal and referential proximity to the urban and architectural frameworks of postwar Brussels. Whereas Broodthaers\u2019s burgeoning art practice is typically codified as a transfer from poetry to art making, The Architect is Absent speculates instead on its close relation to architecture and the built environment.\n\nUsing newspaper and journal articles, photographs, documents, and publications from CIVA\u2019s collections and others, the exhibition explores Broodthaers\u2019s critique of modern architecture, industrial design, and built heritage, notably in his collaborations with architect Constantin Brodzki (1924\u20132021), artist-designer Corneille Hannoset (1926\u20131997), and poet, architect, and critic Pierre Puttemans (1933\u20132013).\n\nBroodthaers was reflecting on architecture right at a time when its functionalist principles and social and utopian qualities were being widely challenged \u2013 a scepticism underscored by a bon mot he shared in 1967: \u201cL\u2019architecte est absent.\u201d Although the sentence is evocative of a flawed society, it is the very absence of architectural organisation and semantic control which opens up the possibility of another life. ","performers":null,"boxoffice_url":null,"website":"http:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006212"},"it":{"name":"Research in Residence #3: Stefaan Vervoort Marcel Broodthaers \u2013 The Architect is Absent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006212"},"cn":{"name":"Research in Residence #3: Stefaan Vervoort Marcel Broodthaers \u2013 The Architect is Absent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006212"},"fr":{"name":"Research in Residence #3: Stefaan Vervoort Marcel Broodthaers \u2013 The Architect is Absent","shortdescr":"Marcel Broodthaers \u2013 The Architect is Absent explore les liens qu\u2019entretenait l'artiste belge Marcel Broodthaers avec l'architecture, le design et la ville entre 1957 et 1967. Au cours de cette d\u00e9cennie, Broodthaers s'est initi\u00e9 au journalisme et \u00e0 la photographie, a r\u00e9alis\u00e9 ses premi\u00e8res \u0153uvres d'art et a d\u00e9fini les principales orientations de sa pratique naissante en tant qu'artiste et \u00e9crivain.","longdescr":"L\u2019exposition Marcel Broodthaers \u2013 The Architect is Absent, la troisi\u00e8me du programme Research in Residence du CIVA, explore les liens qu\u2019entretenaient l'artiste belge Marcel Broodthaers (1924-1976) avec l'architecture, le design et la ville entre 1957 et 1967. Au cours de cette d\u00e9cennie, Broodthaers s'est initi\u00e9 au journalisme et \u00e0 la photographie, a r\u00e9alis\u00e9 ses premi\u00e8res \u0153uvres d'art et a d\u00e9fini les principales orientations de sa pratique naissante en tant qu'artiste et \u00e9crivain.\n\nL'exposition s'articule autour de l\u2019\u0153uvre Monument Public n\u00ba 4 (1963), la premi\u00e8re expos\u00e9e par Broodthaers. L'exposition contextualise ce travail pr\u00e9curseur, en examinant sa proximit\u00e9 formelle et r\u00e9f\u00e9rentielle avec les cadres urbains et architecturaux du Bruxelles d'apr\u00e8s-guerre. Alors que la pratique artistique naissante de Broodthaers est g\u00e9n\u00e9ralement per\u00e7ue comme un passage de la po\u00e9sie \u00e0 la cr\u00e9ation artistique, The Architect is Absent sp\u00e9cule plut\u00f4t sur la relation \u00e9troite de ses assemblages avec l\u2019architecture et l\u2019environnement construit.\n\n\u00c0 partir d'articles, de photographies, de documents et de publications provenant des collections du CIVA et d'autres sources, l'exposition explore la critique de Broodthaers \u00e0 l'\u00e9gard de l'architecture moderne, du design industriel et du patrimoine b\u00e2ti, notamment dans ses collaborations avec l'architecte Constantin Brodzki (1924-2021), l'artiste-designer Corneille Hannoset (1926-1997) et le po\u00e8te, architecte et critique Pierre Puttemans (1933-2013).\n\nBroodthaers a d\u00e9velopp\u00e9 une r\u00e9flexion sur l\u2019architecture au moment o\u00f9 les principes fonctionnalistes et les dimensions sociales et utopiques de celle-ci \u00e9taient largement remis en question \u2013 un scepticisme illustr\u00e9 par un bon mot qu\u2019il a partag\u00e9 en 1967: \"L\u2019architecte est absent.\" Bien que la phrase soit \u00e9vocatrice d\u2019une soci\u00e9t\u00e9 en panne, c\u2019est l\u2019absence m\u00eame d\u2019organisation architecturale et de contr\u00f4le s\u00e9mantique qui ouvre la possibilit\u00e9 d\u2019une autre vie. ","performers":null,"boxoffice_url":null,"website":"http:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006212"},"sp":{"name":"Research in Residence #3: Stefaan Vervoort Marcel Broodthaers \u2013 The Architect is Absent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006212"},"nl":{"name":"Research in Residence #3: Stefaan Vervoort Marcel Broodthaers \u2013 The Architect is Absent","shortdescr":"Marcel Broodthaers \u2013 The Architect is Absent peilt naar het engagement van de Belgische kunstenaar Marcel Broodthaers met architectuur, design en de stad tussen ruwweg 1957 en 1967. In dat decennium begon Broodthaers zich in te laten met journalistiek en fotografie, maakte hij zijn eerste kunstwerken en zette hij de lijnen uit voor zijn opkomende praktijk als kunstenaar en schrijver.","longdescr":"Deze tentoonstelling, de derde in het kader van het Research in Residence programma van CIVA, peilt naar het engagement van de Belgische kunstenaar Marcel Broodthaers (1924-1976) met architectuur, design en de stad tussen ruwweg 1957 en 1967. In dat decennium begon Broodthaers zich in te laten met journalistiek en fotografie, maakte hij zijn eerste kunstwerken en zette hij de lijnen uit voor zijn opkomende praktijk als kunstenaar en schrijver.\n\nDe tentoonstelling is opgebouwd rond Monument Public n\u00ba 4 (1963), het eerste kunstwerk van Broodthaers dat werd tentoongesteld. De tentoonstelling probeert dit vroege werk in zijn context te plaatsen en onderzoekt de formele en referenti\u00eble verwantschap met de stedelijke en architecturale kaders van het naoorlogse Brussel. Waar Broodthaers\u2019 ontluikende kunstpraktijk meestal wordt gecodeerd als een overgang van het schrijven van po\u00ebzie naar het maken van kunst, belicht The Architect is Absent in plaats daarvan de nauwe relatie van deze assemblagekunst met architectuur, design en de stad.\n\nAan de hand van artikels, foto's, documenten en publicaties uit collecties van CIVA en andere bronnen, wordt Broodthaers\u2019 kritiek op de moderne architectuur, het industrieel ontwerp en het gebouwd erfgoed onderzocht, meer specifiek in zijn samenwerkingen met architect Constantin Brodzki (1924-2021), kunstenaar-ontwerper Corneille Hannoset (1926-1997) en dichter, architect en criticus Pierre Puttemans (1933-2013).\n\nBroodthaers reflecteerde over architectuur precies op het moment waarop haar functionalistische principes en haar sociale en utopische kwaliteiten op grote schaal ter discussie werden gesteld \u2013 een scepticisme dat wordt benadrukt door een bon mot dat hij in 1967 deelde: 'L'architecte est absent'. Hoewel die zin doet denken aan een slecht functionerende samenleving, is het net de afwezigheid van architecturale organisatie en semantische controle die de mogelijkheid van een ander leven opent. ","performers":null,"boxoffice_url":null,"website":"http:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006212"}},"place":{"id":235577,"translations":{"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"region":"brussels","last_updated_at":"2024-03-19T12:49:53+01:00","published_at":"201