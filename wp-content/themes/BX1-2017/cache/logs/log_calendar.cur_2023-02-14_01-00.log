:{"name":"Vorverkauf"},"it":{"name":"Prevendita"},"sp":{"name":"Preventa"},"pt":{"name":"Pr\u00e9vente"},"cn":{"name":"Pr\u00e9vente"}},"value":13}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,259,263],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-10T18:06:56+01:00","published_at":"2022-08-26T14:23:21+02:00","backoffice_id":260491,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.20107818794899},{"id":518575,"date_start":"2021-10-09","date_end":"2023-11-11","date_next":"2023-03-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"],"it":["Cucina"],"sp":["Gastronom\u00eda"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Espresso Lover Coffee Tour","shortdescr":"Lors de ce Espresso Lover Coffee Tour, vous appr\u00e9henderez la plan\u00e8te espresso dans toute sa splendeur et sa diversit\u00e9. Donn\u00e9 en FR & EN.","longdescr":"ESPRESSO LOVER COFFEE TOUR\r\n\r\nLors de ce Espresso Lover Coffee Tour, vous appr\u00e9henderez la plan\u00e8te espresso dans toute sa splendeur et sa diversit\u00e9. \r\n\r\nDe shots en shots, vous allez d\u00e9couvrir l\u2019espresso et sa palette gustative complexe, mais aussi mieux comprendre les baristas et le mat\u00e9riel d\u00e9di\u00e9 \u00e0 sa r\u00e9alisation\u2026 soyez pr\u00eat.e !\r\n\r\n- 6 lieux innovants (parfois un peu plus ou un peu moins selon le quartier)\r\n- 4h de conseils et de fun\r\n- 1 exp\u00e9rience de quartier unique autour de l\u2019espresso dans toute sa diversit\u00e9\r\n\r\n\u00c0 la fin du Espresso Lover Coffee Tour, vous en saurez un peu plus sur\r\n- le Caf\u00e9 de Sp\u00e9cialit\u00e9, ses terroirs et ses valeurs\r\n- comment go\u00fbter et appr\u00e9cier un espresso\r\n- l\u2019importance du m\u00e9tier de barista\r\n- les machines et moulins qui font la diff\u00e9rence\r\n- o\u00f9 consommer dans votre quartier pr\u00e9f\u00e9r\u00e9\r\n- investir ou pas dans une machine pour la maison\r\n\r\nPour qui ?\r\nLes Espresso Lover Coffee Tours s\u2019adressent aux amateur.ices d\u2019espresso, mais aussi aux professionnel.les de l\u2019horeca.\r\n\r\nLes Coffee Tours durent en moyenne 4h, se passent totalement en ext\u00e9rieur (bien s\u2019habiller en cons\u00e9quence!!) et ne se terminent pas au point de d\u00e9part. \r\n\r\nPlus d\u2019infos pratiques lors de la r\u00e9servation.\r\n\r\nD\u00e9couvrez, go\u00fbtez, appr\u00e9ciez\u2026 recommencez !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.518575"},"nl":{"name":"Espresso Lover Coffee Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.518575"},"en":{"name":"Espresso Lover Coffee Tour","shortdescr":"During this Espresso Lover Coffee Tour, you will learn about the espresso world in all its splendor and diversity. Hosted in EN & FR.","longdescr":"ESPRESSO LOVER COFFEE TOUR\r\n\r\nDuring this Espresso Lover Coffee Tour, you will learn about the espresso world in all its splendor and diversity. \r\n\r\nFrom shot to shot, you will discover espresso and its complex taste palette, but also better understand the baristas and the equipment dedicated to its preparation... Be ready!\r\n\r\n- 6 innovative places (sometimes a little more or a little less depending on the area)\r\n- 4 hours of advice and fun\r\n- 1 unique neighborhood experience around espresso in all its diversity\r\n\r\nAt the end of the Espresso Lover Coffee Tour, you'll know a little more about\r\n- Specialty coffee, its terroirs and its values\r\n- how to taste and appreciate an espresso\r\n- the importance of the baristas\r\n- the machines and grinders that make the difference\r\n- where to drink in your favorite neighborhood\r\n- whether or not to invest in a machine for your home\r\n\r\nWho is it for?\r\nThe Espresso Lover Coffee Tours are aimed at espresso lovers, but also at professionals in the hospitality industry.\r\n\r\nThe Coffee Tours last on average 4 hours, are totally outdoor (dress accordingly!!) and do not end at the starting point. \r\n\r\nMore practical information when you make your reservation.\r\n\r\nDiscover, taste, enjoy... do it again!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.518575"},"de":{"name":"ESPRESSO EX