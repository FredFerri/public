6 01","address_zip":"1050","address_city":"Ixelles","address_line1":"rue des Grenadiers, 48","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":"lefourire","backoffice_id":11226,"location":{"lat":50.80969533,"lon":4.39147475},"region":"brussels","last_updated_at":"2022-09-12T13:05:12+02:00","published_at":"2013-10-19T01:30:00+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/339c1167ffdecb76a14fe831529598eb020bac5a.jpg","width":5008,"height":7063,"ratio":0.71,"translations":{"fr":{"title":"Kevin le forain","copyright":null},"nl":{"title":"Kevin le forain","copyright":null},"en":{"title":"Kevin le forain","copyright":null}}}],"dates":[{"day":"2022-09-30","doors":"19:15:00","start":"20:15:00","end":"21:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-01","doors":"19:15:00","start":"20:15:00","end":"21:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":25},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":12.5},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":22},{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groep"},"en":{"name":"Group"}},"value":20}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-12T13:05:12+02:00","published_at":"2022-09-12T12:17:13+02:00","backoffice_id":261596,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1},{"id":536376,"date_start":"2022-09-20","date_end":"2022-10-07","date_next":"2022-09-30","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le proc\u00e8s","shortdescr":"Quelqu'un avait bien d\u00fb calomnier Josef K., car un matin, sans qu'il ait rien fait de mal, il fut arr\u00eat\u00e9.\r\n\r\nEntre jeu et narration, les labyrinthes de Franz Kafka se referment sur Josef K. comme un cauchemar.","longdescr":"Au matin de son trenti\u00e8me anniversaire, Josef K. rencontre pour la premi\u00e8re fois un redoutable adversaire : la Loi. Sans savoir ni par qui ni pourquoi, K. est arr\u00eat\u00e9, c\u2019est le d\u00e9but d\u2019un cauchemar de proc\u00e9dures paradoxales au c\u0153ur d\u2019un labyrinthe administratif sans porte de sortie. Durant une ann\u00e9e, l\u2019homme tente de lever le voile sur un syst\u00e8me d\u2019apparences vertigineux et improbable qui ne cache en r\u00e9alit\u00e9 aucune v\u00e9rit\u00e9, mais bien une multitude de faux-semblants. Accus\u00e9 de rien, mais jug\u00e9 pour ce qu\u2019il est, Josef K. joue au jeu le plus dangereux, celui d\u2019accepter les r\u00e8gles d\u2019une machinerie administrative et judiciaire qui n\u2019aura de cesse de le broyer.\r\nS\u2019emparant des dix cahiers \u00e9crits par Franz Kafka, H\u00e9l\u00e8ne Theunissen pose un regard neuf sur ce casse-t\u00eate tentaculaire au centre duquel les femmes prennent une place h\u00e9ro\u00efque, tentant de retenir les parois qui se resserrent sur la destin\u00e9e d\u2019un Josef K. un temps arrogant puis d\u00e9pass\u00e9. Une lecture du Proc\u00e8s oscillant entre narration et incarnation, dans laquelle les sensations troublent, la r\u00e9alit\u00e9 \u00e9chappe, l\u2019humour et le monstrueux fusionnent pour cr\u00e9er une atmosph\u00e8re cauchemardesque.\r\nT\u00e9moins du proc\u00e8s, nous sortons de l\u2019innocence et devenons les complices de notre propre perdition face aux pouvoirs qui oppriment l\u2019humanit\u00e9.","performers":"texte Franz Kafka \u2022 traduction fran\u00e7aise Jean-Pierre Lefebvre \u2022 jeu Maxime Anselin, Jean-Pierre Baudson, Jacqueline Bollen, C\u00e9dric Cerbara, Isabelle De Beir, Dolor\u00e8s Delahaut, Bernard Gahide, Julie Lenain, St\u00e9phane Ledune, Romain Mathelart, Sylvie Perederejew, Laurent Tisseyre, Aur\u00e9lien Vandenbeyvanghe.","boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536376"},"nl":{"name":"Le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.536376"},"en":{"name":"Le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.536376"},"de":{"name":"Le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.536376"},"it":{"name":"Le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.536376"},"sp":{"name":"Le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.536376"},"pt":{"name":"Le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.536376"},"cn":{"name":"Le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.536376"}},"place":{"id":231711,"translations":{"fr":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":"Plac\u00e9 aujourd\u2019hui sous la direction artistique de Philippe Sireuil, le Th\u00e9\u00e2tre des Martyrs se d\u00e9finit aujourd\u2019hui comme un th\u00e9\u00e2tre mais pluriel, une sc\u00e8ne et des artistes.\r\nIl affirme ainsi le m\u00e9tissage des origines de cet art n\u00e9 \u00e0 c\u00f4t\u00e9 du forum grec ou sur le parvis de l\u2019\u00e9glise m\u00e9di\u00e9vale et dont il est l\u2019un des multiples h\u00e9ritiers, reprenant le t\u00e9moin de cet art qui, de tout temps, a rec\u00e9l\u00e9 toutes les peines et toutes les joies, tous les conflits et tous les d\u00e9bats de notre condition humaine, rires et larmes m\u00eal\u00e9s.\r\nIl comporte deux salles de spectacles : la grande salle, dite \u00e0 l\u2019italienne entre 255 (parterre) et 356 places (avec le balcon) et la petite salle destin\u00e9e \u00e0 des projets plus intimistes.","description_print":"Plac\u00e9 aujourd\u2019hui sous la direction artistique de Philippe Sireuil, le Th\u00e9\u00e2tre des Martyrs se d\u00e9finit aujourd\u2019hui comme un th\u00e9\u00e2tre mais pluriel, une sc\u00e8ne et des artistes.\r\nIl affirme ainsi le m\u00e9tissage des origines de cet art n\u00e9 \u00e0 c\u00f4t\u00e9 du forum grec ou sur le parvis de l\u2019\u00e9glise m\u00e9di\u00e9vale et dont il est l\u2019un des multiples h\u00e9ritiers, reprenant le t\u00e9moin de cet art qui, de tout temps, a rec\u00e9l\u00e9 toutes les peines et toutes les joies, tous les conflits et tous les d\u00e9bats de notre condition humaine, rires et larmes m\u00eal\u00e9s.\r\nIl comporte deux salles de spectacles : la grande salle, dite \u00e0 l\u2019italienne de 366 places, et la petite salle destin\u00e9e \u00e0 des projets plus intimistes.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Martelaarsplein","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Brussel","address_line1":"Martelaarsplein, 22","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Brussels","address_line1":"Place des Martyrs, 22","address_line2":"1000