 y aura \u00e9galement de la pratique : reconnaissance de plantes, plantations, tests de l\u2019eau, et notre activit\u00e9 phare : la p\u00eache \u00e0 l\u2019\u00e9puisette ! (Les poissons sont ensuite rel\u00e2ch\u00e9s). Ambiance convivale garantie m\u00eame en hiver ! :-)","performers":"Laurence Vanneyre (chef de projets aquaponie, biologiste, co-fondatrice de l'asbl)","boxoffice_url":null,"website":"http:\/\/www.aquaponiebxl.be","email":"aquaponiebxl@gmail.com","phone_contact":null,"phone_booking":"+32 470 17 45 50","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/522403.html"},"nl":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"aquaponiebxl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/522403.html"},"en":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"aquaponiebxl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/522403.html"},"de":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/522403.html"},"it":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/522403.html"},"sp":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/522403.html"},"pt":{"name":"Initiation \u00e0 l'aquaponie","shortdescr":nul