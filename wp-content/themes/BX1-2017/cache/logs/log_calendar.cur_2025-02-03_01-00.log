se,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-27T17:37:14+01:00","published_at":"2025-01-27T14:22:00+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":316972,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr","nl","pt","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[6,4],"translations":{"de":["Worldmusic, Folk & Country","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"it":["Worldmusic, Folk e Country","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"sp":["Worldmusic, folk y country","Pop, rock, jazz\u2026"],"nl":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"A New Experience Tour, Adriano Trindade.  Brazilian concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005856"},"pt":{"name":"A New Experience Tour, Adriano Trindade.  Brazilian concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005856"},"en":{"name":"A New Experience Tour, Adriano Trindade.  Brazilian concert","shortdescr":"Adriano Trindade lives in Berlin, Germany, and is considered the precursor of samba rock on the European continent, and one of the most important representatives of Brazilian Jazz in the world. \n","longdescr":"The wonderfull musician,Brazilian, that played in the total 58 countries, Trindade has 8 cds in his career and 4 dvds. Check this jazz Brazilian and continental musician. Trindade normally plays in many jazz famous places and festivals around the world, like Ronnie Scott (London),North Sea Jazz (Amsterdam), Reduta Jazz (Prague), Grezz Jazz (Brazil), Jambalaya Festival (New Zealand),Munich Jazz Festival, Edinburgh Jazz Festival.\n","performers":"Adriano Trindade","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005856"},"it":{"name":"A New Experience Tour, Adriano Trindade.  Brazilian concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005856"},"cn":{"name":"A New Experience Tour, Adriano Trindade.  Brazilian concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005856"},"fr":{"name":"A New Experience Tour, Adriano Trindade.  Concert Br\u00e9silien","shortdescr":"Adriano Trindade vit \u00e0 Berlin, en Allemagne. Il est consid\u00e9r\u00e9 comme le pr\u00e9curseur du samba rock sur le continent europ\u00e9en et comme l'un des plus importants repr\u00e9sentants du jazz br\u00e9silien dans le monde. ","longdescr":"Le musicien br\u00e9silien qui a le plus jou\u00e9 hors de son pays ces 4 derni\u00e8res ann\u00e9es, dans un total de 58 pays, Trindade a 8 CD dans sa carri\u00e8re et 4 DVD. C'est le bon moment pour d\u00e9couvrir ce musicien de jazz br\u00e9silien et continental. Trindade joue habituellement dans de nombreux lieux et festivals de jazz c\u00e9l\u00e8bres dans le monde entier, comme Ronnie Scott (Londres), North Sea Jazz (Amsterdam), Reduta Jazz (Prague), Grezz Jazz (Br\u00e9sil), Jambalaya Festival (Nouvelle-Z\u00e9lande), Munich Jazz Festival, Edinburgh Jazz Festival, par exemple.\nProfitons ensemble de ce concert. Nous vous attendons.","performers":"Adriano Trindade","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005856"},"sp":{"name":"A New Experience Tour, Adriano Trindade.  Brazilian concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005856"},"nl":{"name":"A New Experience Tour, Adriano Trindade. Braziliaans concert","shortdescr":"Adriano Trindade woont in Berlijn, Duitsland, en wordt beschouwd als de voorloper van sambarock op het Europese continent en als een van de belangrijkste vertegenwoordigers van Braziliaanse jazz ter wereld. ","longdescr":"\nDe Braziliaanse muzikant die de afgelopen 4 jaar het meest buiten zijn land heeft gespeeld, in een totaal van 58 landen, Trindade heeft 8 cd's in zijn carri\u00e8re en 4 dvd's. Dit is het juiste moment om deze Braziliaanse en continentale jazzmuzikant te ontdekken. Trindade speelt meestal in veel beroemde jazzpodia en -festivals over de hele wereld, zoals Ronnie Scott (Londen), North Sea Jazz (Amsterdam), Reduta Jazz (Praag), Grezz Jazz (Brazili\u00eb), Jambalaya Festival (Nieuw-Zeeland), Munich Jazz Festival, Edinburgh Jazz Festival.\nLaten we samen genieten van dit concert. We kijken uit naar je komst.","performers":"Adriano Trindade","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005856"}},"place":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard, 3","address_line2":"1000 Brussels","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https