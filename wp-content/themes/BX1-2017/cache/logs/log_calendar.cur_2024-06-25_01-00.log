event-detail.510880"},"en":{"name":"Foundation Frison Horta daily guided Visit","shortdescr":null,"longdescr":"130 Year Time Capsule of Horta Maison Frison Is the Only Living Museum of Horta Built in 1894 and the only Horta House in the City Centre Connecting us with a By Gone Era Between 19th Century Europe and India. \n\"A Living Cultural Bridge Between East and West\"","performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.510880"},"it":{"name":"Fondation Frison Horta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.510880"},"cn":{"name":"Fondation Frison Horta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.510880"},"fr":{"name":"Fondation Frison Horta","shortdescr":"Seule Maison Musee de Victor Horta dans Centre ville","longdescr":"La Maison Frison est le seul mus\u00e9e vivant d'Horta. Construite en 1894, elle est la seule maison d'Horta au centre de la ville et nous relie \u00e0 une \u00e9poque r\u00e9volue entre l'Europe et l'Inde du 19\u00e8me si\u00e8cle. \r\n\"Un pont culturel vivant entre l'Est et l'Ouest\".","performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.510880"},"sp":{"name":"Fondation Frison Horta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.510880"},"nl":{"name":"Fondation Frison Horta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.510880"}},"place":{"id":271767,"translations":{"de":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\n\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\n\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.\n\nF\u00fchrung nur nach Vereinbarung\n39 Euro (F\u00fchrung+Exposition)","description_print":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Foundation Frison Horta","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Lebeaustraat, 37","address_line2":"1000 Brussels","description_web":"RESTORATION. PRESERVATION. SHARING.\nFoundation Frison Horta is an Active Cultural Bridge Between East & West Restoring, Preserving and Sustaining Rich Art & Craft of the By-Gone Era, in an Artistic Art-de-Vivre form. \u201cExcellence in Craftsmanship and M\u00e9tiers d\u2019Art\u201d. The Foundation Aims to Foster Greater Understanding and Appreciation of the Rich Heritage & Cultural Traditions of the East particularly of Indian Sub-continent In Europe and vice versa.\n\nFoundation Frison Horta is working Extensively in Restoring the image of Brussels with Art Nouveau as its National Identity to a Global Audience.\n\nMaison Frison is the Only one of a kind house of Victor Horta that was Constructed for Double Function Maurice Frison ( Lawyer of the Court of Belgium) office and living space. Foundation frison Has Continued the double function of Horta with Foundation museum activities and the living space making it a One of a kind in the world \u201cA Living Museum\u201d an Exceptional Unique Time capsule of 19th Century Total Art, Art Nouveau Gem of Victor Horta!\nFounder: Nupur Tron\n\nGuided visit by appointment only\nEntry Fee: 39 Euros (Visit+Exposition)","description_print":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURATION. PR\u00c9SERVATION. PARTAGE.\nLa Fondation Frison Horta est un pont culturel actif entre l'Orient et l'Occident qui restaure, pr\u00e9serve et soutient les riches arts et artisanats d'une \u00e9poque r\u00e9volue, sous une forme d'art de vivre artistique. \u00ab Excellence en Artisanat et M\u00e9tiers d\u2019Art \u00bb. La Fondation vise \u00e0 favoriser une meilleure compr\u00e9hension et appr\u00e9ciation du riche patrimoine et des traditions culturelles de l'Est, en particulier du sous-continent indien, en Europe et vice versa.\n\nLa Fondation Frison Horta travaille intensivement \u00e0 restaurer l'image de Bruxelles avec l'Art nouveau comme identit\u00e9 nationale aupr\u00e8s d'un public mondial.\n\nLa Maison Frison est la seule maison en son genre de Victor Horta qui a \u00e9t\u00e9 construite pour la double fonction de Maurice Frison (avocat \u00e0 la Cour de Belgique) bureau et espace de vie. La Fondation Frison a poursuivi la double fonction de Horta avec les activit\u00e9s mus\u00e9ales de la Fondation et l'espace de vie, ce qui en fait un \u00ab mus\u00e9e vivant \u00bb unique au monde, une capsule temporelle unique et exceptionnelle de l'art total du 19e si\u00e8cle, joyau de l'Art nouveau de Victor Horta !\nFondateur : Nupur Tron\n\nVisite guid\u00e9e uniquement sur rendez-vous\nEntr\u00e9e: 39 Eur (visite + exposition)\n","description_print":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\n \nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.\n\nVisita guiada s\u00f3lo con cita previa\nEntrada: 39 Eur (Visita+Exposici\u00f3n)","description_print":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Fondation Frison Horta","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Lebeaustraat, 37","address_line2":"1000 Brussel","description_web":"RESTAUREREN. BEHOUDEN. DELEN.\nStichting Frison Horta is een actieve culturele brug tussen Oost en West die rijke kunst en ambacht uit vervlogen tijden herstelt, behoudt en in stand houdt, in een artistieke Art-de-Vivre-vorm. \"Excellentie in vakmanschap en M\u00e9tiers d'Art\". De stichting streeft naar een beter begrip en waardering van het rijke erfgoed en de culturele tradities van het Oosten, met name van het Indiase subcontinent in Europa, en vice versa.\n\nStichting Frison Horta werkt intensief aan het herstel van het imago van Brussel met art nouveau als nationale identiteit voor een mondiaal publiek.\n\nMaison Frison is het enige unieke huis van Victor Horta dat werd gebouwd voor de dubbele functie van Maurice Frison (advocaat van de rechtbank van Belgi\u00eb), kantoor en woonruimte. Stichting Frison heeft de dubbele functie van Horta voortgezet met de museumactiviteiten van de Stichting en de woonruimte, waardoor het een uniek exemplaar in de wereld is geworden. \u201cEen levend museum\u201d, een uitzonderlijk unieke tijdscapsule van 19e-eeuwse totale kunst, een juweel van de art nouveau van Victor Horta!\nOprichter: Nupur Tron\n\nGeleid bezoek enkel op afspraak\nToegang: 39 Eur (bezoek + tentoonstelling)","description_print":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":31767,"location":{"lat":50.8425461,"lon":4.3540203},"region":"brussels","last_updated_at":"2024-04-17T14:24:48+02:00","published_at":"2018-08-21T10:28:33+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":271767,"translations":{"de":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\n\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\n\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.\n\nF\u00fchrung nur nach Vereinbarung\n39 Euro (F\u00fchrung+Exposition)","description_print":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Foundation Frison Horta","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Lebeaustraat, 37","address_line2":"1000 Brussels","description_web":"RESTORATION. PRESERVATION. SHARING.\nFoundation Frison Horta is an Active Cultural Bridge Between East & West Restoring, Preserving and Sustaining Rich Art & Craft of the By-Gone Era, in an Artistic Art-de-Vivre form. \u201cExcellence in Craftsmanship and M\u00e9tiers d\u2019Art\u201d. The Foundation Aims to Foster Greater Understanding and Appreciation of the Rich Heritage & Cultural Traditions of the East particularly of Indian Sub-continent In Europe and vice versa.\n\nFoundation Frison Horta is working Extensively in Restoring the image of Brussels with Art Nouveau as its National Identity to a Global Audience.\n\nMaison Frison is the Only one of a kind house of Victor Horta that was Constructed for Double Function Maurice Frison ( Lawyer of the Court of Belgium) office and living space. Foundation frison Has Continued the double function of Horta with Foundation museum activities and the living space making it a One of a kind in the world \u201cA Living Museum\u201d an Exceptional Unique Time capsule of 19th Century Total Art, Art Nouveau Gem of Victor Horta!\nFounder: Nupur Tron\n\nGuided visit by appointment only\nEntry Fee: 39 Euros (Visit+Exposition)","description_print":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURATION. PR\u00c9SERVATION. PARTAGE.\nLa Fondation Frison Horta est un pont culturel actif entre l'Orient et l'Occident qui restaure, pr\u00e9serve et soutient les riches arts et artisanats d'une \u00e9poque r\u00e9volue, sous une forme d'art de vivre artistique. \u00ab Excellence en Artisanat et M\u00e9tiers d\u2019Art \u00bb. La Fondation vise \u00e0 favoriser une meilleure compr\u00e9hension et appr\u00e9ciation du riche patrimoine et des traditions culturelles de l'Est, en particulier du sous-continent indien, en Europe et vice versa.\n\nLa Fondation Frison Horta travaille intensivement \u00e0 restaurer l'image de Bruxelles avec l'Art nouveau comme identit\u00e9 nationale aupr\u00e8s d'un public mondial.\n\nLa Maison Frison est la seule maison en son genre de Victor Horta qui a \u00e9t\u00e9 construite pour la double fonction de Maurice Frison (avocat \u00e0 la Cour de Belgique) bureau et espace de vie. La Fondation Frison a poursuivi la double fonction de Horta avec les activit\u00e9s mus\u00e9ales de la Fondation et l'espace de vie, ce qui en fait un \u00ab mus\u00e9e vivant \u00bb unique au monde, une capsule temporelle unique et exceptionnelle de l'art total du 19e si\u00e8cle, joyau de l'Art nouveau de Victor Horta !\nFondateur : Nupur Tron\n\nVisite guid\u00e9e uniquement sur rendez-vous\nEntr\u00e9e: 39 Eur (visite + exposition)\n","description_print":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Fondation Frison Horta","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\n \nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.\n\nVisita guiada s\u00f3lo con cita previa\nEntrada: 39 Eur (Visita+Exposici\u00f3n)","description_print":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Fondation Frison Horta","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Lebeaustraat, 37","address_line2":"1000 Brussel","description_web":"RESTAUREREN. BEHOUDEN. DELEN.\nStichting Frison Horta is een actieve culturele brug tussen Oost en West die rijke kunst en ambacht uit vervlogen tijden herstelt, behoudt en in stand houdt, in een artistieke Art-de-Vivre-vorm. \"Excellentie in vakmanschap en M\u00e9tiers d'Art\". De stichting streeft naar een beter begrip en waardering van het rijke erfgoed en de culturele tradities van het Oosten, met name van het Indiase subcontinent in Europa, en vice versa.\n\nStichting Frison Horta werkt intensief aan het herstel van het imago van Brussel met art nouveau als nationale identiteit voor een mondiaal publiek.\n\nMaison Frison is het enige unieke huis van Victor Horta dat werd gebouwd voor de dubbele functie van Maurice Frison (advocaat van de rechtbank van Belgi\u00eb), kantoor en woonruimte. Stichting Frison heeft de dubbele functie van Horta voortgezet met de museumactiviteiten van de Stichting en de woonruimte, waardoor het een uniek exemplaar in de wereld is geworden. \u201cEen levend museum\u201d, een uitzonderlijk unieke tijdscapsule van 19e-eeuwse totale kunst, een juweel van de art nouveau van Victor Horta!\nOprichter: Nupur Tron\n\nGeleid bezoek enkel op afspraak\nToegang: 39 Eur (bezoek + tentoonstelling)","description_print":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":31767,"location":{"lat":50.8425461,"lon":4.3540203},"last_updated_at":"2024-04-17T14:24:48+02:00","published_at":"2018-08-21T10:28:33+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/79cec86692ab6858062c2d0e46f2fbc0e8b719f1.jpg","width":568,"height":851,"ratio":0.67,"oEmbed_height":851,"oEmbed_width":568,"translations":{"de":{"title":"Fondation Frison Horta","copyright":null},"pt":{"title":"Fondation Frison Horta","copyright":null},"en":{"title":"Fondation Frison Horta","copyright":null},"it":{"title":"Fondation Frison Horta","copyright":null},"cn":{"title":"Fondation Frison Horta","copyright":null},"fr":{"title":"Fondation Frison Horta","copyright":null},"sp":{"title":"Fondation Frison Horta","copyright":null},"nl":{"title":"Fondation Frison Horta","copyright":null}}}],"dates":[],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":39}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"sunday":{"is_open":false}},"translations":{"en":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:00 to 17:00","sunday: closed"],"fr":["lundi, mardi, mercredi, jeudi, vendredi et samedi: de 10:00 \u00e0 17:00","dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 10:00 tot 17:00","zondag: gesloten"]},"date_start":"2021-04-22","date_end":"2029-01-06","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":549228,"date_start":"2024-01-03","date_end":"2024-12-31","date_next":"2024-06-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-22T03:01:41+02:00","published_at":"2023-01-11T14:26:20+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":269228,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.1400552969868338,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Belexpo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belexpo.brussels\/","email":"info@belexpo.brussels","phone_contact":"+32 485 20 25 00","phone_booking":"+32 485 20 25 00","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.549228"},"pt":{"name":"Belexpo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belexpo.brussels\/","email":"info@belexpo.brussels","phone_contact":"+32 485 20 25 00","phone_booking":"+32 485 20 25 00","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.549228"},"en":{"name":"Belexpo","shortdescr":"Become climate heroes thanks to BELEXPO, the fun and interactive parcours about climate and the cities of tomorrow, created by Brussels Environment.","longdescr":"Take up challenges and imagine a better life ! In this experience, try out a different kind of mobility, grow vegetables virtually, learn how to consume in a more sustainable way, discover jobs related to the environment or reduce energy consumption at home.\nIn addition, Clim' Avatar, BELEXPO's artificial intelligence, helps visitors to understand climate change and to better grasp the challenges of the missions to be accomplished thanks to a brand new animation.\nDesigned for young people aged 10 to 16 and their families, BELEXPO can be experienced alone or in groups (schools, youth movements, families, birthday parties). Learning and fun guaranteed!\n\nOpen first weekend of the month: 10am-6pm.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.belexpo.brussels\/","email":"info@belexpo.brussels","phone_contact":"+32 485 20 25 00","phone_booking":"+32 485 20 25 00","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549228"},"it":{"name":"Belexpo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belexpo.brussels\/","email":"info@belexpo.brussels","phone_contact":"+32 485 20 25 00","phone_booking":"+32 485 20 25 00","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.549228"},"cn":{"name":"Belexpo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belexpo.brussels\/","email":"info@belexpo.brussels","phone_contact":"+32 485 20 25 00","phone_booking":"+32 485 20 25 00","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.549228"},"fr":{"name":"Belexpo","shortdescr":"Devenez des h\u00e9ros climatiques gr\u00e2ce \u00e0 BELEXPO, le parcours ludique et interactif sur le climat et les villes de demain, cr\u00e9\u00e9 par Bruxelles Environnement.","longdescr":"Relevez des d\u00e9fis et imaginez une vie\/ ville meilleure ! Dans ce parcours, exp\u00e9rimentez une autre mobilit\u00e9, faites pousser des l\u00e9gumes virtuellement, apprenez \u00e0 consommer de mani\u00e8re plus durable, d\u00e9couvrez des m\u00e9tiers li\u00e9s \u00e0 l\u2019environnement ou encore diminuez les consommations \u00e9nerg\u00e9tiques chez vous.\nEn outre, Clim\u2019 Avatar, l\u2019intelligence artificielle de BELEXPO, aide les visiteurs \u00e0 comprendre le changement climatique et \u00e0 mieux cerner les enjeux des missions \u00e0 accomplir gr\u00e2ce \u00e0 une toute nouvelle animation.\nCon\u00e7u pour les jeunes de 10 \u00e0 16 ans et leur famille, BELEXPO se vit seul ou en groupe (\u00e9coles, mouvements de jeunesse, famille, f\u00eate d\u2019anniversaire). Apprentissage et amusement garanti !\n\nOuverture le le premier week-end du mois :10h-18h.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.belexpo.brussels\/","email":"info@belexpo.brussels","phone_contact":"+32 485 20 25 00","phone_booking":"+32 485 20 25 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549228"},"sp":{"name":"Belexpo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belexpo.brussels\/","email":"info@belexpo.brussels","phone_contact":"+32 485 20 25 00","phone_booking":"+32 485 20 25 00","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.549228"},"nl":{"name":"Belexpo","shortdescr":"Word klimaathelden dankzij BELEXPO, de ludieke en interactieve parcours over het klimaat en de steden van morgen, gecre\u00eberd door Leefmilieu Brussel.","longdescr":"Ga uitdagingen aan en stel je een beter leven voor! In dit parcours kan je een ander soort mobiliteit uitproberen, virtueel groenten kweken, leren hoe je duurzamer kan consumeren, beroepen ontdekken die verband houden met het milieu of het energieverbruik thuis verminderen.\nBovendien helpt Clim' Avatar, de artifici\u00eble intelligentie van BELEXPO, de bezoekers de klimaatverandering te begrijpen en de uitdagingen van de te volbrengen missies beter te begrijpen dankzij een gloednieuwe animatie.\nOntworpen voor jongeren van 10 tot 16 jaar en hun familie, kan BELEXPO alleen of in groepen (scholen, jeugdbewegingen, families, verjaardagsfeestjes) worden ervaren. Leren en plezier gegarandeerd!\n\nGeopend het eerste weekend van de maand: 10.00-18.00 uur.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.belexpo.brussels\/","email":"info@belexpo.brussels","phone_contact":"+32 485 20 25 00","phone_booking":"+32 485 20 25 00","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549228"}},"place":{"id":262448,"translations":{"de":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Brussels","description_web":"The architecture of the new Brussels Environment building, next to the historic Royal Warehouse, could not be called inconspicuous. The building had to be passive, given that the Brussels regional institution advocates energy savings on a day-to-day basis, particularly where construction in Brussels is concerned. It therefore unites all the characteristics of a modern, highly energy-efficient building, open to the surrounding green setting and the Tour & Taxis site. Opened in late 2014, the Brussels Environment head office is largely triple-glazed to capture the sun\u2019s light and heat. Its design also includes areas for relaxation and socialising around a south-facing atrium. It is intended to serve as a model in terms of both energy use and integration into the environment.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":"L\u2019architecture du nouveau b\u00e2timent de Bruxelles Environnement ne passe pas inaper\u00e7ue, \u00e0 c\u00f4t\u00e9 de l\u2019historique Entrep\u00f4t Royal. L\u2019immeuble se devait d\u2019\u00eatre passif, puisque cette institution r\u00e9gionale bruxelloise pr\u00e9conise au quotidien les \u00e9conomies d\u2019\u00e9nergie, notamment au niveau de la construction \u00e0 Bruxelles. L\u2019\u00e9difice rassemble donc toutes les caract\u00e9ristiques d\u2019un b\u00e2timent moderne, tr\u00e8s \u00e9conome en \u00e9nergie, ouvert sur la nature environnante et sur le site de Tour et Taxis. Inaugur\u00e9 fin 2014, le si\u00e8ge administratif de Bruxelles Environnement est en grande partie vitr\u00e9 \u2013 triple vitrage \u2013 pour r\u00e9cup\u00e9rer la lumi\u00e8re et la chaleur du soleil. Mais il est aussi con\u00e7u pour proposer des lieux de convivialit\u00e9, rassembl\u00e9s autour d\u2019un atrium orient\u00e9 vers le sud. Il se veut un mod\u00e8le, tant en mati\u00e8re \u00e9nerg\u00e9tique qu\u2019en termes d\u2019int\u00e9gration dans son environnement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":"La arquitectura del nuevo edificio Bruxelles Environnement, al lado de la hist\u00f3rica Royal Warehouse, no puede pasar desapercibida. El edificio tuvo que ser pasivo, dado que la instituci\u00f3n regional de Bruselas aboga por el ahorro de energ\u00eda diario, que es particularmente el inter\u00e9s de la construcci\u00f3n en Bruselas. De esta manera une todas las caracter\u00edsticas de un edificio moderno y de alta eficiencia energ\u00e9tica abierto a las zonas verdes y Tour & Taxis. Abierto a finales de 2014, la oficina principal del Bruxelles Environnement est\u00e1 triplemente acristalada para dejar pasar la luz y el calor. Su dise\u00f1o tambi\u00e9n incluye \u00e1reas de descanso para relacionarse en el vest\u00edbulo al sur del edificio. La intenci\u00f3n es que sirva como modelo en t\u00e9rminos tanto energ\u00e9ticos como de integraci\u00f3n en el medio ambiente.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Leefmilieu Brussel","address_street_name":"Havenlaan","address_street_number":"86 C","address_street_box":"3000","email":"info@leefmilieu.brussels","website":"https:\/\/leefmilieu.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Havenlaan, 86 C \/ 3000","address_line2":"1000 Brussel","description_web":"De architectuur van het nieuwe gebouw van Leefmilieu Brussel gaat niet onopgemerkt voorbij, naast het historische Koninklijke Pakhuis. Het moest wel een passiefgebouw zijn, aangezien deze Brusselse instantie elke dag advies geeft over energiebesparing, onder meer voor gebouwen in Brussel. Het heeft dus alle kenmerken van een modern en zeer energiezuinig gebouw, dat openstaat naar de omringende natuur en naar de site van Thurn & Taxis. Het hoofdkantoor van Leefmilieu Brussel werd eind 2014 geopend. Het bestaat voor een groot deel uit raampartijen \u2013 met driedubbel glas \u2013 om het licht en de zonnewarmte binnen te laten. Maar het is ook ontworpen met het oog op de gebruiker, met gezellige ruimtes die zijn gegroepeerd rond een naar het zuiden gericht atrium. Dit gebouw heeft een voorbeeldfunctie, zowel in het energieverbruik als in de integratie in de omgeving.\r\n\r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":22448,"location":{"lat":50.86573978,"lon":4.3509828},"region":"brussels","last_updated_at":"2023-04-13T11:47:09+02:00","published_at":"2015-10-01T09:52:00+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":262448,"translations":{"de":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Brussels","description_web":"The architecture of the new Brussels Environment building, next to the historic Royal Warehouse, could not be called inconspicuous. The building had to be passive, given that the Brussels regional institution advocates energy savings on a day-to-day basis, particularly where construction in Brussels is concerned. It therefore unites all the characteristics of a modern, highly energy-efficient building, open to the surrounding green setting and the Tour & Taxis site. Opened in late 2014, the Brussels Environment head office is largely triple-glazed to capture the sun\u2019s light and heat. Its design also includes areas for relaxation and socialising around a south-facing atrium. It is intended to serve as a model in terms of both energy use and integration into the environment.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":"L\u2019architecture du nouveau b\u00e2timent de Bruxelles Environnement ne passe pas inaper\u00e7ue, \u00e0 c\u00f4t\u00e9 de l\u2019historique Entrep\u00f4t Royal. L\u2019immeuble se devait d\u2019\u00eatre passif, puisque cette institution r\u00e9gionale bruxelloise pr\u00e9conise au quotidien les \u00e9conomies d\u2019\u00e9nergie, notamment au niveau de la construction \u00e0 Bruxelles. L\u2019\u00e9difice rassemble donc toutes les caract\u00e9ristiques d\u2019un b\u00e2timent moderne, tr\u00e8s \u00e9conome en \u00e9nergie, ouvert sur la nature environnante et sur le site de Tour et Taxis. Inaugur\u00e9 fin 2014, le si\u00e8ge administratif de Bruxelles Environnement est en grande partie vitr\u00e9 \u2013 triple vitrage \u2013 pour r\u00e9cup\u00e9rer la lumi\u00e8re et la chaleur du soleil. Mais il est aussi con\u00e7u pour proposer des lieux de convivialit\u00e9, rassembl\u00e9s autour d\u2019un atrium orient\u00e9 vers le sud. Il se veut un mod\u00e8le, tant en mati\u00e8re \u00e9nerg\u00e9tique qu\u2019en termes d\u2019int\u00e9gration dans son environnement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Bruxelles Environnement","address_street_name":"Avenue du Port","address_street_number":"86 C","address_street_box":"3000","email":"info@environnement.brussels","website":"http:\/\/www.environnement.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 C \/ 3000","address_line2":"1000 Bruxelles","description_web":"La arquitectura del nuevo edificio Bruxelles Environnement, al lado de la hist\u00f3rica Royal Warehouse, no puede pasar desapercibida. El edificio tuvo que ser pasivo, dado que la instituci\u00f3n regional de Bruselas aboga por el ahorro de energ\u00eda diario, que es particularmente el inter\u00e9s de la construcci\u00f3n en Bruselas. De esta manera une todas las caracter\u00edsticas de un edificio moderno y de alta eficiencia energ\u00e9tica abierto a las zonas verdes y Tour & Taxis. Abierto a finales de 2014, la oficina principal del Bruxelles Environnement est\u00e1 triplemente acristalada para dejar pasar la luz y el calor. Su dise\u00f1o tambi\u00e9n incluye \u00e1reas de descanso para relacionarse en el vest\u00edbulo al sur del edificio. La intenci\u00f3n es que sirva como modelo en t\u00e9rminos tanto energ\u00e9ticos como de integraci\u00f3n en el medio ambiente.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Leefmilieu Brussel","address_street_name":"Havenlaan","address_street_number":"86 C","address_street_box":"3000","email":"info@leefmilieu.brussels","website":"https:\/\/leefmilieu.brussels\/","phone_contact":"+32 2 775 75 75","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Havenlaan, 86 C \/ 3000","address_line2":"1000 Brussel","description_web":"De architectuur van het nieuwe gebouw van Leefmilieu Brussel gaat niet onopgemerkt voorbij, naast het historische Koninklijke Pakhuis. Het moest wel een passiefgebouw zijn, aangezien deze Brusselse instantie elke dag advies geeft over energiebesparing, onder meer voor gebouwen in Brussel. Het heeft dus alle kenmerken van een modern en zeer energiezuinig gebouw, dat openstaat naar de omringende natuur en naar de site van Thurn & Taxis. Het hoofdkantoor van Leefmilieu Brussel werd eind 2014 geopend. Het bestaat voor een groot deel uit raampartijen \u2013 met driedubbel glas \u2013 om het licht en de zonnewarmte binnen te laten. Maar het is ook ontworpen met het oog op de gebruiker, met gezellige ruimtes die zijn gegroepeerd rond een naar het zuiden gericht atrium. Dit gebouw heeft een voorbeeldfunctie, zowel in het energieverbruik als in de integratie in de omgeving.\r\n\r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":22448,"location":{"lat":50.86573978,"lon":4.3509828},"last_updated_at":"2023-04-13T11:47:09+02:00","published_at":"2015-10-01T09:52:00+02:00","is_in_address_book":false,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/9af499ffeb2af94d2a8e5c3021924cdfa4d73045.jpg","width":800,"height":800,"ratio":1,"oEmbed_height":800,"oEmbed_width":800,"translations":{"de":{"title":"Belexpo","copyright":null},"pt":{"title":"Belexpo","copyright":null},"en":{"title":"Belexpo","copyright":null},"it":{"title":"Belexpo","copyright":null},"cn":{"title":"Belexpo","copyright":null},"fr":{"title":"Belexpo","copyright":null},"sp":{"title":"Belexpo","copyright":null},"nl":{"title":"Belexpo","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/9899a9864ab86376ff79712208d99de83db9d01f.jpg","width":1080,"height":1080,"ratio":1,"oEmbed_height":1080,"oEmbed_width":1080,"translations":{"de":{"title":"Belexpo","copyright":null},"pt":{"title":"Belexpo","copyright":null},"en":{"title":"Belexpo","copyright":null},"it":{"title":"Belexpo","copyright":null},"cn":{"title":"Belexpo","copyright":null},"fr":{"title":"Belexpo","copyright":null},"sp":{"title":"Belexpo","copyright":null},"nl":{"title":"Belexpo","copyright":null}}}],"dates":[{"day":"2024-01-03","doors":null,"start":"09:00:00","end":"16:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-04","doors":null,"start":"09:00:00","end":"16:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-05","doors":null,"start":"09:00:00","end":"16:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-08","doors":null,"sta