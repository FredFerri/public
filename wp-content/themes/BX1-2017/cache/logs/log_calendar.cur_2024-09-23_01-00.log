l,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/modernisme-et-art-deco-watermael-boitsfort","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008035"},"it":{"name":"Modernisme et Art D\u00e9co \u00e0 Watermael-Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/modernisme-et-art-deco-watermael-boitsfort","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008035"},"cn":{"name":"Modernisme et Art D\u00e9co \u00e0 Watermael-Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/modernisme-et-art-deco-watermael-boitsfort","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008035"},"fr":{"name":"Modernisme et Art D\u00e9co \u00e0 Watermael-Boitsfort","shortdescr":null,"longdescr":"Watermael-Boitsfort regorge de quelques p\u00e9pites Art D\u00e9co et modernistes que vous d\u00e9couvrirez pendant cette promenade.\n\nLorsque Watermael-Boitsfort se d\u00e9tache d\u2019Auderghem en 1863, le concept de \u00ab site naturel \u00bb est \u00e0 l\u2019ordre du jour. La proximit\u00e9 de la For\u00eat de Soignes, avec ses vues et ses possibilit\u00e9s de promenades, attirera commanditaires et architectes \u00e0 Watermael-Boitsfort. Les d\u00e9nominations des rues t\u00e9moignent de cet environnement verdoyant : rue du Pinson, avenue des Bouleaux, square du Castel Fleuri,... Les hautes b\u00e2tisses \u00e9clectiques seront bient\u00f4t rejointes par des maisons Art D\u00e9co et modernistes sign\u00e9es par d\u2019importants protagonistes de l\u2019architecture belge de l\u2019entre-deux-guerres : Antoine Pompe, Gaston Brunfaut, Louis Tenaerts, Stanislas Jasinski, Jean Jules Eggerickx ou encore Gaston Eysselinck.\n\nNb : certaines avenues sont un peu en pente!","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/modernisme-et-art-deco-watermael-boitsfort","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008035"},"sp":{"name":"Modernisme et Art D\u00e9co \u00e0 Watermael-Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/modernisme-et-art-deco-watermael-boitsfort","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008035"},"nl":{"name":"Modernisme et Art D\u00e9co \u00e0 Watermael-Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/modernisme-et-art-deco-watermael-boitsfort","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008035"}},"place":{"id":276653,"translations":{"de":{"name":"square du Castel Fleuri","address_street_name":"Square du Castel Fleuri","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Square du Castel Fleuri, 3","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"square du Castel Fleuri","address_street_name":"Square du Castel Fleuri","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"