par mois \u00e0 venir voir, \u00e9couter et faire de la musique dans le cadre unique et rempli de magie qu\u2019est notre joli cabaret.\n\nUne Jam est un rassemblement libre de musiciens dans lequel tout le monde peut monter sur sc\u00e8ne pour jouer ou chanter en live dans le respect de tous et la bonne humeur\u2026\n\n \n\nEt ce n\u2019est pas tout, en plus d\u2019\u00eatre une Jam pas comme les autres Mad Jam est une Jam masqu\u00e9e ! Si tu as toujours voulu jouer de ta voix ou de ton instrument accompagn\u00e9 d\u2019autres musiciens mais que tu n\u2019es pas \u00e0 l\u2019aise de monter sur sc\u00e8ne et bien VIENS QUAND M\u00caME, nous aurons des masques de cabaret \u00e0 te pr\u00eater histoire de passer incognito","performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000826"},"sp":{"name":"Mad Jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000826"},"nl":{"name":"Mad Jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000826"}},"place":{"id":1078,"translations":{"de":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":"Opened in spring 1960, \u2018l\u2019Os \u00e0 Moelle\u2019 is the oldest cabaret in Brussels. This cellar with its indefinable charm, located under Jacques Brel\u2019s Birth House, has always been keen to open its doors to artists of all horizons. Singers, actors, comedians; many have stepped onto the cabaret stage!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":"Bienvenue dans le plus ancien cabaret de Bruxelles !\u202fCela m\u00e9rite en soi un hommage. De plus, c\u2019est aussi la cave de la maison natale de notre fiert\u00e9 bruxelloise, Jacques Brel. Depuis les ann\u00e9es 60, de grandes stars sont pass\u00e9es par ici\u202f; pensez \u00e0 Toots Thielemans, Philippe Lafontaine, Barbara et Arno. D\u00e9sormais, vous pouvez venir ici chaque semaine pour profiter d'un solide programme allant du th\u00e9\u00e2tre d'improvisation, des spectacles de com\u00e9die et d'auteurs-compositeurs-interpr\u00e8tes aux soir\u00e9es de po\u00e9sie, au th\u00e9\u00e2tre de marionnettes et aux f\u00eates dans le style \u00ab\u202fann\u00e9es folles\u202f\u00bb. \r\n\r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue