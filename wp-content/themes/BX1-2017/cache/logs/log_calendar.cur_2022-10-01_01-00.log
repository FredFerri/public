erdag, vrijdag en zaterdag: van 14:00 tot 18:00"],"en":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 14:00 to 18:00"]},"date_start":"2022-09-15","date_end":"2022-10-29","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-30T01:36:46+02:00","published_at":"2022-08-30T13:10:27+02:00","backoffice_id":260671,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.35421952306087},{"id":538992,"date_start":"2022-09-20","date_end":"2022-11-04","date_next":"2022-09-30","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[255],"translations":{"fr":["Visites d'expositions"],"nl":["Tentoonstelling"],"en":["Exhibition guided tours"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Expo \u00ab Couleur\/Lumi\u00e8re \u00bb: Activit\u00e9s pour les \u00e9coles & groupes \u00e0 vis\u00e9e p\u00e9dagogique","shortdescr":"Dans le cadre de l'exposition \"Couleur\/Lumi\u00e8re\", la Maison des Arts propose des activit\u00e9s \u00e0 destination des \u00e9coles et groupes \u00e0 vis\u00e9e p\u00e9dagogique.","longdescr":"Avec votre classe, votre cours d\u2019apprentissage du fran\u00e7ais ou votre atelier d\u2019art plastique, soyez les bienvenu.e.s ! \r\n\r\nDans le cadre de l'exposition \"Couleur\/Lumi\u00e8re\", la Maison des Arts propose une visite guid\u00e9e de l'exposition pouvant \u00eatre suivie d'un atelier de votre choix, \u00e0 destination des \u00e9coles et groupes \u00e0 vis\u00e9e p\u00e9dagogique. \r\n\r\n\r\nAtelier 1 : COLORS + 3 ans\r\n\r\nD\u00e9couvrons le fascinant m\u00e9lange des couleurs en confectionnant un mini livre aux couleurs changeantes\u2026\r\n\r\nAtelier 2 : SHADOWS + 6 ans\r\n\r\nEn cr\u00e9ant de petites figurines de papier articul\u00e9es, explorons ensemble le monde myst\u00e9rieux des ombres.\r\n\r\nPour tous, aucun niveau requis !\r\n\r\n \r\nINFOS PRATIQUES\r\nR\u00e9servation obligatoire\r\n\r\nQuand? Du mardi au vendredi de 9h \u00e0 16h \r\nR\u00e9servations: 3 semaines \u00e0 l\u2019avance. \r\nAnnulation: Dans un d\u00e9lai de 15 jours avant la date r\u00e9serv\u00e9e sinon la facture sera due. \r\nNombre de personnes: min.10 - max. 20\r\nLangue: FR\/NL \r\nTarif : Visite : 2\u20ac par personne\r\n          Visite + atelier : 3\u20ac par personne\r\n          Article 27 accept\u00e9s\r\n\r\nPour r\u00e9server, merci d\u2019envoyer un mail \u00e0 reservationsma@1030.be avec les informations suivantes :\r\n\r\n    Nom de l\u2019\u00e9cole + classe, association ou groupe\r\n    Langue de la visite\r\n    Gsm\r\n    Date + heure souhait\u00e9e\r\n    Nombre d\u2019adultes et d\u2019enfants + \u00e2ges des enfants\r\n    Activit\u00e9 souhait\u00e9e : visite simple (1h), visite + atelier (2h) \u2013 pr\u00e9ciser l\u2019atelier \r\n\r\n\r\nPhoto: Lieven De Boeck, Sunbeam , 2017 (c) Philippe De Gobert","performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/activites-pour-les-ecoles-groupes-a-visee-pedagogique-3\/","email":"reservationsma@1030.be","phone_contact":"+32 2 240 34 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538992"},"nl":{"name":"Tentoonstelling \u201cKleur\/Licht\u201d: activiteiten voor scholen & groepen met een pedagogisch doel","shortdescr":"Activiteiten voor scholen & groepen met een pedagogisch doel in het kader van de tentoonstelling \"Kleur\/Licht\" in la Maison des Arts","longdescr":"Kom meedoen met je klas, je opleiding beeldende kunsten, je taalcursus Nederlands\u2026 \r\n\r\nIn het kader van de tentoonstelling \"Kleur\/Licht\" biedt het Maison des Arts voor scholen en educatieve groepen een rondleiding door de tentoonstelling aan, die kan worden gevolgd door een workshop naar keuze. \r\n\r\n\r\nAtelier 1 : COLORS + 3 jaar\r\n\r\nMaak een boekje met veranderende kleuren en ontdek een fascinerende kleurenmix.\r\n\r\nAtelier 2 : SHADOWS + 6 jaar\r\n\r\nWe maken bewegende papieren figuurtjes en verkennen samen de mysterieuze wereld van schaduwen.\r\n\r\n \r\n\r\nVoor iedereen, geen voorkennis vereist.\r\n\r\n \r\n\r\nINFO\r\nReservatie verplicht\r\n\r\nWanneer? Dinsdag tot vrijdag van 9u tot 16u \r\nReservatie: 3 weken op voorhand \r\nAnnulatie: Binnen 15 dagen voor de geboekte datum, anders is de factuur verschuldigd \r\nAantal personen: min.10 - max. 20\r\nTaal: FR\/NL \r\nTarief : Bezoek: 2\u20ac per persoon\r\n           Bezoek + workshop: 3\u20ac per persoon\r\n           Artikel 27\r\n\r\nOm te reserveren, stuur een e-mail naar reservationsma@1030.be  met de volgende informatie :\r\n\r\n\u2013 Naam van de school + klas, vereniging of groep\r\n\u2013 Taal\r\n\u2013 Gsm\r\n\u2013 Datum + gewenste tijd\r\n\u2013 Aantal volwassenen en kinderen + leeftijd van de kinderen\r\n\u2013 Gewenste activiteit: Rondleiding (1u), rondleiding + creatieve workshop (2u)\r\n\r\n\r\nFoto: Lieven De Boeck, Sunbeam , 2017 (c) Philippe De Gobert","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538992"},"en":{"name":"Expo \u00ab Couleur\/Lumi\u00e8re \u00bb: Activit\u00e9s pour les \u00e9coles & groupes \u00e0 vis\u00e9e p\u00e9dagogique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538992"},"de":{"name":"Expo \u00ab Couleur\/Lumi\u00e8re \u00bb: Activit\u00e9s pour les \u00e9coles & groupes \u00e0 vis\u00e9e p\u00e9dagogique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538992"},"it":{"name":"Expo \u00ab Couleur\/Lumi\u00e8re \u00bb: Activit\u00e9s pour les \u00e9coles & groupes \u00e0 vis\u00e9e p\u00e9dagogique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538992"},"sp":{"name":"Expo \u00ab Couleur\/Lumi\u00e8re \u00bb: Activit\u00e9s pour les \u00e9coles & groupes \u00e0 vis\u00e9e p\u00e9dagogique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538992"},"pt":{"name":"Expo \u00ab Couleur\/Lumi\u00e8re \u00bb: Activit\u00e9s pour les \u00e9coles & groupes \u00e0 vis\u00e9e p\u00e9dagogique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.538992"},"cn":{"name":"Expo \u00ab Couleur\/Lumi\u00e8re \u00bb: Activit\u00e9s pour les \u00e9coles & groupes \u00e0 vis\u00e9e p\u00e9dagogique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.538992"}},"place":{"id":222932,"translations":{"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, anim\u00e9e par le Service Culture fran\u00e7aise de la Commune de Schaerbeek, est un espace singulier dont les activit\u00e9s sont principalement ax\u00e9es sur la cr\u00e9ation contemporaine dans le domaine des arts plastiques avec un important programme de m\u00e9diation permettant l\u2019acc\u00e8s de l\u2019art contemporain \u00e0 tous.\r\n\r\nLa MA conna\u00eet une riche activit\u00e9 artistique depuis les ann\u00e9es \u201950, \u00e9poque \u00e0 laquelle la commune rach\u00e8te le b\u00e2timent. En 2005, elle se voit prendre un premier tournant en proposant aux artistes de travailler in situ, afin d\u2019\u00e9tablir une r\u00e9elle coh\u00e9rence entre l\u2019\u0153uvre et la Maison.\r\nEt finalement, c\u2019est en 2016 que la Commune de Schaerbeek d\u00e9cide de la positionner dans le domaine des arts plastiques, contemporains et num\u00e9riques comme un lieu de cr\u00e9ation, de diffusion et de rayonnement culturel.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaarbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"The MdA is run and staffed by the Francophone Cultural Service of Schaerbeek Council and is a unique place whose activities are mainly concerned with the creation of works of contemporary art with a significant partnership programme that promotes access for all to contemporary art.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chau