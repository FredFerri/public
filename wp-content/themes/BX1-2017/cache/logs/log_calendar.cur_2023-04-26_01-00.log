oe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,27],"translations":{"fr":["Galeries d'art","Photographie"],"nl":["Galeries","Fotografie"],"en":["Art Galleries","Photography"],"de":["Kunstgalerien","Fotografie"],"it":["Gallerie d'arte","Fotografia"],"sp":["Galer\u00edas de arte","Fotograf\u00eda"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261","shortdescr":"Une mise en lumi\u00e8re de la beaut\u00e9 du durag et des gens qui le portent, en contraste avec leur perception n\u00e9gative dans la soci\u00e9t\u00e9 occidentale.","longdescr":"Suite \u00e0 son exposition Hooyo en 2021 dans laquelle il c\u00e9l\u00e8bre le port du voile, l\u2019artiste Rami Hara pr\u00e9sente Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261 , un projet dirig\u00e9 autour du durag, morceau de tissu et embl\u00e8me de la communaut\u00e9 noire utilis\u00e9 pour prendre soin des cheveux cr\u00e9pus.\r\nSymbole de la diaspora afro-descendante le durag appara\u00eet il y a plusieurs si\u00e8cles mais c\u2019est aux \u00c9tats-Unis que le terme fait son apparition. Il est d\u2019abord utilis\u00e9 comme un objet de self-care pour les cheveux mais devient avec le temps un accessoire de mode et un symbole d\u2019\u00e9mancipation. Le durag, comme bien d\u2019autres figures de repr\u00e9sentation de la communaut\u00e9 noire, souffre des st\u00e9r\u00e9otypes qui lui sont impos\u00e9s. Il est souvent associ\u00e9 \u00e0 la violence de gang et aux crimes, et plus pr\u00e9cis\u00e9ment \u00e0 la fa\u00e7on dont les hommes noirs sont per\u00e7us \u00e0 travers l\u2019histoire. \u00c0 travers ce projet photographique Rami Hara sublime l\u2019image du durag en s\u2019inspirant de la photographie de mode et en mettant en lumi\u00e8re leurs couleurs vives au sein d\u2019environnements \u00e9pur\u00e9s. Il cr\u00e9e des images douces en contraste avec les clich\u00e9s qui leurs sont associ\u00e9s. Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261 est une fa\u00e7on pour l\u2019artiste de magnifier la simplicit\u00e9 et la d\u00e9licatesse de cette objet, et d\u2019offrir de nouvelles histoires allant \u00e0 l\u2019encontre des pr\u00e9jug\u00e9s.\r\nPhotographe belgo-somalien, Rami Hara vit et travaille \u00e0 Bruxelles. Dipl\u00f4m\u00e9 d\u2019un master en art de la LUCA School of Arts, il ne se s\u00e9pare jamais de son appareil photo qui lui permet de capturer avec sensibilit\u00e9 son entourage et par lequel il s\u2019attaque \u00e0 diff\u00e9rentes probl\u00e9matiques qui l\u2019entourent. L\u2019humain est au c\u0153ur de son processus cr\u00e9atif. Le travail de Rami Hara met en valeur les facettes d\u2019une soci\u00e9t\u00e9 multiculturelle et cosmopolite, sans cesse enrichie d\u2019apports ext\u00e9rieurs. Associant la photographie d\u2019art au style documentaire, ses compositions t\u00e9moignent de son int\u00e9r\u00eat pour la narration et les r\u00e9cits. Il a pour habitude d\u2019explorer la ville et d\u2019y travailler ; il \u00e9dite ses photos au coin d\u2019une table de caf\u00e9 et chine d\u2019anciens objectifs dans des march\u00e9s aux puces.","performers":"Rami Hara (artiste)","boxoffice_url":null,"website":"http:\/\/www.thatswhatxsaid.com","email":"contact@thatswhatxsaid.com","phone_contact":"+32 2 646 37 19","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553180"},"nl":{"name":"Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thatswhatxsaid.com","email":"contact@thatswhatxsaid.com","phone_contact":"+32 2 646 37 19","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553180"},"en":{"name":"Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261","shortdescr":"Contrasting the beauty of the durag and the people who wear them, with their negative perception within Western society.","longdescr":"Following on from his 2021 exhibition Hooyo which celebrated headscarves, Rami Hara presents his latest project to date; Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261. For this body of work, the artist\u2019s focal point is the durag, a piece of cloth (or wave cap) that is used as a tool for self-care and as a cultural emblem.\r\nThe durag has been around for centuries, the term originating in the United States but appearing all over the African Diaspora. Its primary function has always been self-care. Gradually, it has also taken on an important role as a cultural symbol and as a fashion accessory. Like many other representations of black culture, it has been subjected to prejudice. The durag is often associated with gang violence and crime, and more specifically with the way black men have been perceived negatively throughout history. This discrimination was the starting point for Rami Hara, whose aim with this series is to bring attention to the sheer beauty of the durag and its culture. Often inspired by fashion photography, their bright colours and uncluttered environments, this series carries a softness that contrasts with the negative perception of durags and the people who wear them, forcing the viewers to question their own biases. Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261 is a way for Rami Hara to highlight the everyday simplicity and delicacy of the object, and to reclaim these harmful narratives.\r\nRami Hara is a Belgian Somalian artist, living and working in Brussels. Self-taught photographer, he graduated from the LUCA School of Arts with a masters degree in Visual Arts. Rami Hara never goes anywhere without his camera, ready to capture his surroundings in an instant. Through his lens, he wants to tell stories and tackle various socio-political issues. Humans are at the heart of Rami Hara\u2019s creative process. Rami Hara\u2019s work brings to light a multicultural cosmopolitan society, enriched by outside contributions. Combining artistic and documentary photography, his work is a testimony to his underlying interest in storytelling. The city is his playground, where he edits his photos in the back of a coffee shop and scour markets for cameras or lenses.","performers":"Rami Hara (artist)","boxoffice_url":null,"website":"http:\/\/www.thatswhatxsaid.com","email":"contact@thatswhatxsaid.com","phone_contact":"+32 2 646 37 19","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553180"},"de":{"name":"Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thatswhatxsaid.com","email":"contact@thatswhatxsaid.com","phone_contact":"+32 2 646 37 19","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.553180"},"it":{"name":"Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thatswhatxsaid.com","email":"contact@thatswhatxsaid.com","phone_contact":"+32 2 646 37 19","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.553180"},"sp":{"name":"Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thatswhatxsaid.com","email":"contact@thatswhatxsaid.com","phone_contact":"+32 2 646 37 19","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.553180"},"pt":{"name":"Do-rag (\u02c8du\u02d0\u02ccr\u00e6\u0261","shortdescr":null,"longdescr"