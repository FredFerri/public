igh_capacity":false,"is_not_major_event":false,"backoffice_id":279917,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Un pr\u00e9sident ne devrait pas dire \u00e7a","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.559917"},"pt":{"name":"Un pr\u00e9sident ne devrait pas dire \u00e7a","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.559917"},"en":{"name":"Un pr\u00e9sident ne devrait pas dire \u00e7a","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559917"},"it":{"name":"Un pr\u00e9sident ne devrait pas dire \u00e7a","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559917"},"cn":{"name":"Un pr\u00e9sident ne devrait pas dire \u00e7a","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559917"},"fr":{"name":"Un pr\u00e9sident ne devrait pas dire \u00e7a","shortdescr":"Lui esp\u00e8re que ce livre assurera sa r\u00e9\u00e9lection \u00e0 L\u2019\u00c9lys\u00e9e. Eux sont l\u00e0 pour r\u00e9v\u00e9ler des secrets d\u2019\u00c9tat. Ils se verront \u00e0 61 reprises.\r\n","longdescr":" \r\nLeur livre fut un tsunami. Il interroge sur les rapports entre la politique et les journalistes. Jusqu\u2019o\u00f9 ces derniers peuvent aller dans leur qu\u00eate de v\u00e9rit\u00e9 ? \u00c0 quel moment trahissent-ils leur source ? Dans cette pi\u00e8ce haletante, digne d\u2019une s\u00e9rie, c\u2019est une lutte sans merci que se livrent les journalistes Fabrice Lhomme et G\u00e9rard Davet et le Pr\u00e9sident de la R\u00e9publique fran\u00e7aise, Fran\u00e7ois Hollande. Ceux qui aiment le journalisme adoreront ces jeux de pouvoir et l\u2019envers du d\u00e9cor. Ceux qui aiment la politique seront combl\u00e9s de confidences, d\u2019astuces et de r\u00e9flexions. Une plong\u00e9e au c\u0153ur du pouvoir, un coup de projecteur sur l\u2019investigation et la fabrique de l\u2019information. Un affrontement salutaire, vieux comme la d\u00e9mocratie : celui qui oppose pouvoir et contre-pouvoir. Car m\u00eame au th\u00e9\u00e2tre, un pr\u00e9sident ne devrait pas dire \u00e7a\u2026 \r\n","performers":"De G\u00e9rard Davet et Francis Lhomme\r\nDialogue Fran\u00e7ois P\u00e9rache\r\nMise en sc\u00e8ne\u202f Charles Templon assist\u00e9 d\u2019Alexandre Paradis\r\nAvec Thibault de Montalembert, H\u00e9l\u00e8ne Babu, Scali Delpeyrat, Lison Daniel","boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559917"},"sp":{"name":"Un pr\u00e9sident ne devrait pas dire \u00e7a","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559917"},"nl":{"name":"Un pr\u00e9sident ne devrait pas dire \u00e7a","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559917"}},"place":{"id":7929,"translations":{"de":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"Le Centre culturel d\u2019Uccle est contemporain de l\u2019Atomium. Con\u00e7u pour se trouver dans un \u00e9crin de verdure, face au Parc de Wolvendael, la premi\u00e8re pierre fut pos\u00e9e le 30 novembre 1957. Le Centre Culturel et Artistique d\u2019Uccle fut inaugur\u00e9 le 5 octobre 1958.\r\nLe CCU est une \u0153uvre de l\u2019architecte L\u00e9on Stynen, qui avait aussi con\u00e7u les casinos de Knokke, Blankenberge et Ostende.\r\nCe nouveau Centre Culturel permit aux soci\u00e9t\u00e9s et associations int\u00e9ress\u00e9es d\u2019organiser des bals, des conf\u00e9rences, des concerts, des projections de films, des d\u00e9bats et toutes autres manifestations culturelles et artistiques (ballets, concerts, expositions, r\u00e9ceptions, \u2026). Il proposait aussi des repr\u00e9sentations th\u00e9\u00e2trales, un cycle de conf\u00e9rences et des spectacles musicaux.\r\nL'ensemble du b\u00e2timent abrite principalement un hall d\u2019entr\u00e9e donnant acc\u00e8s \u00e0 une grande Salle de Spectacle de 800 fauteuils, un Grand Foyer pouvant accueillir jusqu'\u00e0 400 personnes assises, ainsi qu'un Petit Foyer pouvant contenir 120 personnes.\r\nPlus de cinquante ans apr\u00e8s sa cr\u00e9ation, le Centre Culturel d\u2019Uccle r\u00e9nov\u00e9 a un look \u00e0 la fois contemporain et chaleureux. Pleinement actif, il r\u00e9pond aux d\u00e9fis culturels de son si\u00e8cle en accueillant les plus grands noms du th\u00e9\u00e2tre, de la danse, de la chanson et de la musique ainsi que des artistes et des conf\u00e9renciers de renom. Il s\u2019est constamment modernis\u00e9 pour offrir \u00e0 son public une vie culturelle de qualit\u00e9 au c\u0153ur de la commune d\u2019Uccle.\r\nDirig\u00e9 par une \u00e9quipe dynamique, le CCU met tout en \u0153uvre pour fid\u00e9liser sa client\u00e8le et conqu\u00e9rir sans cesse un public nouveau.\r\nLe Centre Culturel d\u2019Uccle en quelques chiffres, c\u2019est\u2026\r\n-\tUn des plus grands centres culturels \u00e0 Bruxelles et ses environs\r\n-\tUn rendez-vous des professionnels du spectacle\r\n-\t4 espaces bien distincts (Hall, Grand Foyer, Petit Foyer, Salle de Spectacle)\r\n-\tUne salle de spectacle de 800 places\r\n-\tUn gradin r\u00e9tractable de 172 places\r\n-\t200 activit\u00e9s par an\r\n-\t600 artistes par saison\r\n-\t60.000 spectateurs par an\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47