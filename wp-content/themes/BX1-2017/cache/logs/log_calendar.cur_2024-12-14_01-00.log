cr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/apps.ticketmatic.com\/widgets\/flagey\/addtickets?product=578664896368&l=fr&_gl=1*qgejzb*_ga*NTkwMjc2MDUzLjE3MzI3ODg1MzI.*_ga_EJ4NZJ0RP7*MTczMjc4ODUzMC4xLjEuMTczMjc4ODY5Mi4wLjAuMA..#!\/addtickets","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004053"},"pt":{"name":"Dans les coulisses de Tour & Taxis & concert Also Sprach Zarathustra Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/apps.ticketmatic.com\/widgets\/flagey\/addtickets?product=578664896368&l=fr&_gl=1*qgejzb*_ga*NTkwMjc2MDUzLjE3MzI3ODg1MzI.*_ga_EJ4NZJ0RP7*MTczMjc4ODUzMC4xLjEuMTczMjc4ODY5Mi4wLjAuMA..#!\/addtickets","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004053"},"en":{"name":"Dans les coulisses de Tour & Taxis & concert Also Sprach Zarathustra Flagey","shortdescr":null,"longdescr":null,"performers":"Flagey; Korei Guided Tours","boxoffice_url":null,"website":"https:\/\/apps.ticketmatic.com\/widgets\/flagey\/addtickets?product=578664896368&l=fr&_gl=1*qgejzb*_ga*NTkwMjc2MDUzLjE3MzI3ODg1MzI.*_ga_EJ4NZJ0RP7*MTczMjc4ODUzMC4xLjEuMTczMjc4ODY5Mi4wLjAuMA..#!\/addtickets","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004053"},"it":{"name":"Dans les coulisses de Tour & Taxis & concert Also Sprach Zarathustra Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/apps.ticketmatic.com\/widgets\/flagey\/addtickets?product=578664896368&l=fr&_gl=1*qgejzb*_ga*NTkwMjc2MDUzLjE3MzI3ODg1MzI.*_ga_EJ4NZJ0RP7*MTczMjc4ODUzMC4xLjEuMTczMjc4ODY5Mi4wLjAuMA..#!\/addtickets","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004053"},"cn":{"name":"Dans les coulisses de Tour & Taxis & concert Also Sprach Zarathustra Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/apps.ticketmatic.com\/widgets\/flagey\/addtickets?product=578664896368&l=fr&_gl=1*qgejzb*_ga*NTkwMjc2MDUzLjE3MzI3ODg1MzI.*_ga_EJ4NZJ0RP7*MTczMjc4ODUzMC4xLjEuMTczMjc4ODY5Mi4wLjAuMA..#!\/addtickets","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004053"},"fr":{"name":"Visite Tour & Taxis & concert Brussels Philharmonic","shortdescr":"Nous sommes heureux de vous emmener dans les coulisses d\u2019un site en constante \u00e9volution : Tour & Taxis. Ensuite vous pourrez profiter de l\u00b4orchestre Brussels Philharmonic \u00e0 Flagey. Achetez un combi-ticket!","longdescr":"Nous partons \u00e0 l\u2019Entrep\u00f4t Royal o\u00f9 nous d\u00e9couvrons l\u2019\u00e9norme site, son histoire et ses fonctions au fil du temps \u00e0 l\u2019aide d\u2019une maquette. Le guide nous donnera \u00e9galement un aper\u00e7u des nouvelles \u00e9volutions : quels projets ont d\u00e9j\u00e0 \u00e9t\u00e9 r\u00e9alis\u00e9s et quels sont ceux qui sont encore en cours ?\n\nNous visitons ensuite la Maison de la Poste qui, au d\u00e9but du XXe si\u00e8cle, a servi de centre administratif de Tour & Taxis et plus tard de bureau de poste. Le b\u00e2timent est devenu, depuis sa restauration r\u00e9cente un magnifique lieu pour organiser des \u00e9v\u00e9nements.\n\nEt enfin, nous d\u00e9couvrons la Gare Maritime, b\u00e2timent monumental et \u00e9poustouflant, r\u00e9cemment restaur\u00e9e : une ville dans la ville o\u00f9 il ne pleut jamais. Les gigantesques salles, d\u2019une profondeur de 175 m\u00e8tres, reposent sur de minces piliers en fonte avec des \u00e9l\u00e9ments Art Nouveau. La gare, construite entre 1902 et 1908, \u00e9tait \u00e0 l\u2019\u00e9poque la plus grande gare de fret d\u2019Europe. L\u2019architecte Jan De Moffarts (JDMA) a r\u00e9alis\u00e9 la restauration en collaboration avec le Bureau Bouwtechniek. Neutelings Riedijk Architects, connu du MAS d\u2019Anvers, y a ajout\u00e9 de nouveaux \u00e9l\u00e9ments qui s\u2019int\u00e8grent merveilleusement bien.","performers":"Flagey; Korei Guided Tours","boxoffice_url":null,"website":"https:\/\/apps.ticketmatic.com\/widgets\/flagey\/addtickets?product=578664896368&l=fr&_gl=1*qgejzb*_ga*NTkwMjc2MDUzLjE3MzI3ODg1MzI.*_ga_EJ4NZJ0RP7*MTczMjc4ODUzMC4xLjEuMTczMjc4ODY5Mi4wLjAuMA..#!\/addtickets","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004053"},"sp":{"name":"Dans les coulisses de Tour & Taxis & concert Also Sprach Zarathustra Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/apps.ticketmatic.com\/widgets\/flagey\/addtickets?product=578664896368&l=fr&_gl=1*qgejzb*_ga*NTkwMjc2MDUzLjE3MzI3ODg1MzI.*_ga_EJ4NZJ0RP7*MTczMjc4ODUzMC4xLjEuMTczMjc4ODY5Mi4wLjAuMA..#!\/addtickets","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004053"},"nl":{"name":"Dans les coulisses de Tour & Taxis & concert Also Sprach Zarathustra Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/apps.ticketmatic.com\/widgets\/flagey\/addtickets?product=578664896368&l=fr&_gl=1*qgejzb*_ga*NTkwMjc2MDUzLjE3MzI3ODg1MzI.*_ga_EJ4NZJ0RP7*MTczMjc4ODUzMC4xLjEuMTczMjc4ODY5Mi4wLjAuMA..#!\/addtickets","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004053"}},"place":{"id":50001244,"translations":{"de":{"name":"Tour et Taxis"