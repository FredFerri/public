7"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,265,266],"translations":{"fr":["Accessible","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T01:08:08+02:00","published_at":"2022-05-06T13:47:06+02:00","backoffice_id":253274,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.32737967507804},{"id":535783,"date_start":"2022-07-03","date_end":"2022-08-28","date_next":"2022-08-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,161],"translations":{"fr":["Activit\u00e9 sportive","Sport de raquettes et ballon"],"nl":["Sportieve activiteit","Bal en racketsport"],"en":["Sporting activity","Racket sports"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Tournois des sportifs du dimanche","shortdescr":"Tournois des sportifs du dimanche","longdescr":"See U vous invite \u00e0 participer aux tournois des Sportifs du Dimanche qui auront lieux tous les dimanches de juillet et ao\u00fbt !\r\n\r\n\u00c0 la cl\u00e9 de chaque tournoi: un paquet surprise made in See U !\r\n\r\nCOMMENT CA MARCHE ?\r\nVous pouvez d\u00e9sormais vous inscrire en solo ou en \u00e9quipe ci-dessous et choisir votre sport favori !\r\nNotez qu'en cas de nombre trop \u00e9lev\u00e9 d'inscriptions, nous serons contraints de faire une s\u00e9lection d'\u00e9quipes par un tirage au sort.\r\n\r\nOn esp\u00e8re vous voir nombreux et nombreuses ! \r\n\r\nQUAND PUIS-JE VENIR M'ENTRA\u00ceNER ?\r\n- Du mercredi au dimanche\r\n- Pendant les horaires d'ouverture de la guinguette\r\n- \u00c0 partir du 15 juin 2022\r\n- Mat\u00e9riel disponible \u00e0 la guinguette\r\n\r\nDATES DES TOURNOIS: \r\n03\/07 - Tennis de table 1 (deadline pour s'inscrire: 27 juin \u00e0 12h)\r\n10\/07 - P\u00e9tanque 1 (deadline pour s'inscrire: 27 juin \u00e0 12h)\r\n17\/07 - Fl\u00e9chettes (deadline pour s'inscrire: 04 juillet \u00e0 12h)\r\n24\/07 - Molkky 1 (deadline pour s'inscrire: 11 juillet \u00e0 12h)\r\n31\/07 - Beach Volley 1 (deadline pour s'inscrire: 18 juillet \u00e0 12h)\r\n07\/08 - Tennis de table 2 (deadline pour s'inscrire: 25 juillet \u00e0 12h)\r\n14\/08 - P\u00e9tanque 2 (deadline pour s'inscrire: 01 aout \u00e0 12h)\r\n21\/08 - Molkky 2 (deadline pour s'inscrire: 08 aout \u00e0 12h)\r\n28\/08 - Beach Volley 2 (deadline pour s'inscrire: 15 aout \u00e0 12h)\r\n\r\nDATE LIMITE pour s'inscrire: 2 semaines avant le tournoi (deadline le dimanche \u00e0 23h)\r\n\r\nINSCRIPTION","performers":null,"boxoffice_url":null,"website":"https:\/\/www.see-u.brussels\/","email":"see-u@pali-pali.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535783"},"nl":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535783"},"en":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535783"},"de":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535783"},"it":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535783"},"sp":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.535783"},"pt":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.535783"},"cn":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.535783"}},"place":{"id":273506,"translations":{"fr":{"name":"See U","address_street_name":"Rue Fritz Toussaint","address_street_number":"8","address_street_box":"1050","email":"contact@see-u.brussels","website":"https:\/\/www.see-u.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Fritz Toussaint, 8\/1050","address_line2":"1050 Ixelles","description_web":"Inscrit dans une d\u00e9marche d\u2019occupation temporaire, See U accueille depuis le printemps 2019 plus de cinquante porteurs de projets pour faire vivre et revivre ce lieu historique unique et lui apporter une nouvelle lumi\u00e8re. Les projets qui animent le site s\u2019inscrivent dans une logique de d\u00e9couverte, sous l\u2019angle d\u2019un avenir social et durable. L\u2019objectif est que See U fasse r\u00e9f\u00e9rence \u00e0 l\u2019occupation finale du site et devienne ainsi une invitation \u00e0 d\u00e9couvrir le projet d\u00e9finitif Usquare.brussels.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"See U","address_street_name":"Fritz Toussaintstraat","address_street_number":"8","address_street_box":"1050","email":"contact@see-u.brussels","website":"https:\/\/www.see-u.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Fritz Toussaintstraat, 8\/1050","address_line2":"1050 Elsene","description_web":"See U is het programma voor de nieuwe tijdelijke bezetting van de voormalige Fritz Toussaintkazerne in Elsene, volledig in het teken van duurzame ontwikkeling.\r\nSee U verwelkomt een veertigtal projecten om deze unieke historische site nieuw leven in te blazen. Deze projecten vertrekken vanuit het perspectief van een sociale en duurzame toekomst. De bedoeling is dat See U een uitnodiging wordt om het definitieve project Usquare.brussels te ontdekken.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"See U","address_street_name":"Rue Fritz Toussaint","address_street_number":"8","address_street_box":"1050","email":"contact@see-u.brussels","website":"https:\/\/www.see-u.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Fritz Toussaint, 8\/1050","address_line2":"1050 Ixelles","description_web":"As part of a temporary occupation approach, See U has welcomed more than fifty project leaders since spring 2019 to breathe new life into this unique historical site. The projects that animate the former Fritz Toussaint barracks in Ixelles are part of a discovery process, in line with the perspective of a social and sustainable future. See U is an invitation to discover