0","end":"22:30:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"17:30:00","end":"22:30:00"}]},"thursday":{"is_open":true,"hours":[{"start":"17:30:00","end":"22:30:00"}]},"friday":{"is_open":true,"hours":[{"start":"17:30:00","end":"22:30:00"}]},"saturday":{"is_open":true,"hours":[{"start":"17:30:00","end":"22:30:00"}]},"sunday":{"is_open":true,"hours":[{"start":"17:30:00","end":"22:30:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 17:30 \u00e0 22:30"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 17:30 tot 22:30"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 17:30 to 22:30"]},"date_start":"2022-05-12","date_end":"2022-07-31","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:35:51+02:00","published_at":"2022-05-12T08:49:51+02:00","backoffice_id":253546,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.46224084956709},{"id":536160,"date_start":"2022-07-02","date_end":"2022-07-22","date_next":"2022-07-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,29],"translations":{"fr":["Galeries d'art","Installation"],"nl":["Galeries","Installatiekunst"],"en":["Art Galleries","Installation"]}}},"languages":{"spoken":["fr","en","nl","pt"],"subtitles":[]},"translations":{"fr":{"name":"Jus Sanguinis","shortdescr":"Jus Sanguinis","longdescr":"JUS SANGUINIS est le r\u00e9sultat final du processus de la r\u00e9sidence artistique de la po\u00e9te Aline Yasmin en collaboration avec le producteur artistique Renzo Dalvi. Il s'agit d'installations construites en recherche et co-cr\u00e9ation avec l'approche sur la violation des droits de l'homme, en se concentrant particuli\u00e8rement sur l'immigration, ses parcours et ses m\u00e9saventures.\r\nAvec des images fortes qui font r\u00e9f\u00e9rence \u00e0 la guerre, \u00e0 l'emprisonnement, en utilisant des m\u00e9dias visuels, et des mots qui configurent l'exposition de la po\u00e9sie exp\u00e9rimentale.\r\nL'exposition invoque le seul droit du sang : celui de l'humanit\u00e9 elle-m\u00eame. Elle reformule le postulat initial, r\u00e9affirmant que les fronti\u00e8res ne doivent pas briser nos liens en tant qu'\u00eatres humains, tout simplement.\r\n**\r\nJUS SANGUINIS (latin : \"droit du sang\") est un principe du droit de la nationalit\u00e9 selon lequel la citoyennet\u00e9 est d\u00e9termin\u00e9e ou acquise par la nationalit\u00e9 ou l'ethnicit\u00e9 d'un ou des deux parents.","performers":"Aline Yasmin, po\u00e8te\r\nRenzo Dalvi, producteur artistique","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/757572802085873\/757572805419206","email":"espiritomundo.asbl@gmail.com","phone_contact":"+32 466 04 43 53","phone_booking":"+32 485 55 80 35","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/536160.html"},"nl":{"name":"Jus Sanguinis","shortdescr":"Jus Sanguinis","longdescr":"JUS SANGUINIS is het eindresultaat van het artistieke residentieproces van de dichteres Aline Yasmin in samenwerking met de artistieke producent Renzo Dalvi. Het gaat om installaties die zijn opgebouwd uit onderzoek en co-creatie met als invalshoek de schending van de mensenrechten, met bijzondere aandacht voor de immigratie, haar trajecten en tegenslagen.\r\nMet sterke beelden die verwijzen naar oorlog, gevangenschap, met behulp van visuele media, en woorden die de tentoonstelling van experimentele po\u00ebzie configureren.\r\nDe tentoonstelling beroept zich op het enige recht van bloed: dat van de mensheid zelf. De oorspronkelijke premisse wordt geherformuleerd, waarbij opnieuw wordt bevestigd dat grenzen onze banden als mensen niet mogen verbreken, heel eenvoudig.\r\n**\r\nJUS SANGUINIS (Latijn: \"recht van bloed\") is een beginsel van het nationaliteitsrecht volgens hetwelk het burgerschap wordt bepaald of verkregen door de nationaliteit of de etnische afstamming van een of beide ouders.","performers":"Aline Yasmin, experimental poetry\r\nRenzo Dalvi, artistic producer","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/536160.html"},"en":{"name":"Jus Sanguinis","shortdescr":"Jus Sanguinis","longdescr":"JUS SANGUINIS is the \ufb01nal result of the poet Aline Yasmin\u2019s artistic residence in collaboration with Renzo Dalvi, the artistic producer.\r\n\r\nThese installations were conceived in research and co-creation with the approach on human rights violations, focusing particularly on immigration, its paths and misadventures.\r\n\r\nWith strong images making references to wars, imprisonment, using visual media, and words that con\ufb01gures the exhibition of an experimental poetry.\r\n\r\nIt invokes the right of blood: we are all members of the human race - humanity itself. It ressigni\ufb01es the initial postulate, reaffirming that borders should not break our bonds as human beings, quite simply.\r\n\r\n...\r\n\r\nJUS SANGUINIS (Latin: \"right of blood\") is a principle of nationality law according to which citizenship is determined or acquired by the nationality or ethnicity of one or both parents.","performers":"Aline Yasmin, experimenteel dichteres \r\nRenzo Dalvi, artistiek producent","boxoffice_url":null,"website":null,"email":"renzovmelo@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/536160.html"},"de":{"name":"Jus Sanguinis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/536160.html"},"it":{"name":"Jus Sanguinis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/536160.html"},"sp":{"name":"Jus Sanguinis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/536160.html"},"pt":{"name":"Jus Sanguinis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/536160.html"},"cn":{"name":"Jus Sanguinis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/536160.html"}},"place":{"id":272355,"translations":{"fr":{"nam