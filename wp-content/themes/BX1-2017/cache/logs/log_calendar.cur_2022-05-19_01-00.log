ate":"public","last_updated_at":"2022-05-12T12:35:04+02:00","published_at":"2022-05-12T12:06:36+02:00","backoffice_id":253611,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.19689872388277},{"id":516124,"date_start":"2021-09-02","date_end":"2022-06-29","date_next":"2022-05-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,164],"translations":{"fr":["Activit\u00e9 sportive","Fitness, gymnastique, danse et sports de combats"],"nl":["Sportieve activiteit","Fitness, gymnastiek, dans en vechtsport"],"en":["Sporting activity","Fitness, gymnastics, dance and combat sports"]}}},"languages":{"spoken":["fr","en","it"],"subtitles":[]},"translations":{"fr":{"name":"Cours de taekwondo pour les enfants de 6-13 ans","shortdescr":"L'association Red Force propose des cours de taekwondo pour les enfants de 6-13 ans. Cet art martial cor\u00e9en vise \u00e0 utiliser avec un maximum d\u2019efficacit\u00e9 toutes les parties du corps humain servant \u00e0 se d\u00e9fendre ou \u00e0 attaquer. Il se pratique essentiellement sans armes.","longdescr":"Les techniques de coups de pied et les techniques de bras sont l\u2019apanage de l\u2019entra\u00eenement de Taekwondo. Le Taekwondo constitue une pratique physique id\u00e9ale qui permet d\u2019harmoniser l\u2019ensemble du corps. Cette pratique saine am\u00e9liore la sant\u00e9 et le bien-\u00eatre.\r\n\r\nLes objectifs de ces cours sont:\r\n- D\u00e9velopper l'agilit\u00e9 pour pouvoir s'adapter \u00e0 tous types de situation\r\n- Am\u00e9liorer la souplesse pour limiter les risques d'accidents physiques\r\n- Le progress de la concentration et du contr\u00f4le des emotions et des r\u00e9