der":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Atelier 210","address_street_name":"Chauss\u00e9e Saint-Pierre","address_street_number":"210","address_street_box":null,"email":"info@atelier210.be","website":"http:\/\/www.atelier210.be","phone_contact":"+32 2 732 25 98","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e Saint-Pierre, 210","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Atelier 210","address_street_name":"Chauss\u00e9e Saint-Pierre","address_street_number":"210","address_street_box":null,"email":"info@atelier210.be","website":"http:\/\/www.atelier210.be","phone_contact":"+32 2 732 25 98","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e Saint-Pierre, 210","address_line2":"1040 Etterbeek","description_web":"L'atelier 210 est un lieu de cr\u00e9ation, de diffusion et de r\u00e9flexion, un espace qui s\u2019associe \u00e0 des projets artistiques multidisciplinaires; musique, danse, th\u00e9\u00e2tre, performance, rencontres, d\u00e9bats, etc. L\u2019h\u00e9t\u00e9rog\u00e9n\u00e9it\u00e9 des formes propos\u00e9es fonde le caract\u00e8re des lieux. Il tente d\u2019offrir une exp\u00e9rience live unique aux spectacteur.rice.s.\r\n\r\nOuvert \u00e0 tou.te.s sans chercher l\u2019unanimit\u00e9, il s\u2019associe \u00e0 des projets artistiques audacieux, parfois fragiles, qui n\u00e9cessitent la bienveillance et le soutien solide d\u2019une \u00e9quipe, la curiosit\u00e9 des spectateur.rice.s et l\u2019ambiance chaleureuse et inclusive des lieux.\r\n\r\nC'est un lieu sensible aux bruits du monde, attentif aux narrations qui se construisent et aux repr\u00e9sentations en mouvement. C\u2019est un lieu du lien qui favorise les collaborations entre organisations culturelles, \u00e9ducatives et associatives et valorise les temps et les espaces de rencontres et de f\u00eates..\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Atelier 210","address_street_name":"Chauss\u00e9e Saint-Pierre","address_street_number":"210","address_street_box":null,"email":"info@atelier210.be","website":"http:\/\/www.atelier210.be","phone_contact":"+32 2 732 25 98","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e Saint-Pierre, 210","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Atelier 210","address_street_name":"Sint-Pieterssteenweg","address_street_number":"210","address_street_box":null,"email":"info@atelier210.be","website":"http:\/\/www.atelier210.be","phone_contact":"+32 2 732 25 98","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Sint-Pieterssteenweg, 210","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":"163824988877","backoffice_id":4376,"location":{"lat":50.83708517,"lon":4.39159259},"region":"brussels","last_updated_at":"2024-04-19T13:11:59+02:00","published_at":"2013-10-19T01:17:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":241923,"translations":{"de":{"name":"Atelier 210","address_street_name":"Chauss\u00e9e Saint-Pierre","address_s