2 2 218 79 35","phone_booking":"+32 2 218 79 35","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Pierre de Lune","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"contact@pierredelune.be","website":"https:\/\/www.pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Pierre de Lune","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"contact@pierredelune.be","website":"https:\/\/www.pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Pierre de Lune, le Centre Sc\u00e9nique Jeunes Publics de Bruxelles fond\u00e9 en 1979, suscite et organise une activit\u00e9 suivie et structur\u00e9e dans le domaine du th\u00e9\u00e2tre Jeunes Publics. Install\u00e9 depuis 1984 au Botanique, Pierre de Lune d\u00e9ploie ses activit\u00e9s dans la plupart des th\u00e9\u00e2tres de la R\u00e9gion bruxelloise. Il s\u2019agit d\u2019offrir aux jeunes publics les spectacles les plus riches et les plus vari\u00e9s possibles. \n\nPierre de Lune propose un espace d\u2019ouverture et de cr\u00e9ation o\u00f9 les jeunes de tous \u00e2ges peuvent trouver des r\u00e9ponses artistiques et humanistes \u00e0 leurs besoins d\u2019expression. D\u00e9cloisonnant les disciplines et genres artistiques, Pierre de Lune \u00e9largit les horizons et ouvre sa programmation \u00e0 la danse contemporaine, aux arts du cirque, \u00e0 la musique ainsi qu\u2019\u00e0 l\u2019exploration des synergies entre arts de la sc\u00e8ne et arts plastiques. Les spectacles sont accessibles pendant le temps scolaire ainsi qu\u2019en s\u00e9ance tout public, en famille. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Pierre de Lune","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"contact@pierredelune.be","website":"https:\/\/www.pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Pierre de Lune","address_street_name":"Koningsstraat","address_street_number":"236","address_street_box":null,"email":"contact@pierredelune.be","website":"https:\/\/www.pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Koningsstraat, 236","address_line2":"1210 Sint-Joost-Ten-Node","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":2342,"location":{"lat":50.85461438,"lon":4.36620044},"last_updated_at":"2023-11-14T16:30:47+01:00","published_at":"2013-10-19T01:15:08+02:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/01301946a688bcc93c55573c2653f948c2fa96a1.jpg","width":1200,"height":800,"ratio":1.5,"oEmbed