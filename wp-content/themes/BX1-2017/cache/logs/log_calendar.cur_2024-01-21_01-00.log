","website":"http:\/\/www.cafe-roskam.be","phone_contact":"+32 2 503 51 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 9","address_line2":"1000 Bruxelles","description_web":"From cocktails to authentic Belgian beers: you\u2019ll find it all in this cosy and unpretentious pub in the Sainte-Catherine area. And a typical Belgian pub too: very loud and lively! They have a excellent programmation of free jazz concerts, usually on Sundayevenings, so take a look at their website for the upcoming events.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Caf\u00e9 Roskam","address_street_name":"Rue de Flandre","address_street_number":"9","address_street_box":null,"email":"roskambrussels@gmail.com","website":"http:\/\/www.cafe-roskam.be","phone_contact":"+32 2 503 51 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 9","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Caf\u00e9 Roskam","address_street_name":"Rue de Flandre","address_street_number":"9","address_street_box":null,"email":"roskambrussels@gmail.com","website":"http:\/\/www.cafe-roskam.be","phone_contact":"+32 2 503 51 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 9","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Caf\u00e9 Roskam","address_street_name":"Rue de Flandre","address_street_number":"9","address_street_box":null,"email":"roskambrussels@gmail.com","website":"http:\/\/www.cafe-roskam.be","phone_contact":"+32 2 503 51 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 9","addre