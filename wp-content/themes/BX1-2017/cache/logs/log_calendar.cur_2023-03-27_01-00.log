\/agenda\/event-detail.550944"}},"place":{"id":554,"translations":{"fr":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"Les b\u00e2timents et le parc accueillent les salles d\u2019exposition, un centre de documentation, une librairie sp\u00e9cialis\u00e9e, des projections de films, un jardin d\u2019exposition et un caf\u00e9. La collection abrite des \u0153uvres d\u2019Ado Hamelrijck, Wladyslaw Hasior, Pal Horvath, Jem, Roman Karalus, Walter Leblanc, Jean-Philippe Lecharlier, Waclaw Szpakowski, Guy Stukens, Bernar Venet, Bob Verschueren, Bernard Villers et Christine Wilm\u00e8s. ","description_print":"","booking_url":null,"sort_order":"ATELIER 34ZERO MUZEUM","virtual_visit":null},"nl":{"name":"Atelier 34zero Muzeum","address_street_name":"de Rivierendreef","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"de Rivierendreef, 334","address_line2":"1090 Jette","description_web":"Het Atelier 34zero Muzeum is een onafhankelijk kunstencentrum dat in 2014 opgericht is. Het herrees uit de as van het Atelier 340 Muzeum. Zijn belangrijkste roeping is de studie en promotie van de beeldhouwkunst en de driedimensionale kunst, zowel in Belgi\u00eb als in het buitenland.\r\nAtelier 34zero Muzeum organiseert 3 tot 4 tentoonstellingen per jaar in eigen ruimtes evenals evenementen extra muros. Drie types tentoonstellingen worden gerealiseerd: thematische, vergelijkende of confronterende, en persoonlijke (retrospectieven). Deze gaan gepaard met de uitgave van kwaliteitsvolle, viertalige, rijk ge\u00efllustreerde catalogen evenals postkaarten. Parallel met de tentoonstellingen bouwt Atelier 34zero Muzeum een kunstcollectie op als geheugen van voorbije activiteiten en als handleiding bij verder onderzoek. Zo bevat de collectie o.a. werk van Ado Hamelrijck, Wladyslaw Hasior, Pal Horvath, Jem, Roman Karalus, Walter Leblanc, Jean-Philippe Lecharlier, Waclaw Szpakowski, Guy Stukens, Bernar Venet, Bob Verschueren, Bernard Villers et Christine Wilm\u00e8s. ","description_print":"","booking_url":null,"sort_order":"ATELIER 34ZERO MUZEUM","virtual_visit":null},"en":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"Atelier 34zero Muzeum is an independent art centre, created in 2014. Born from the ashes of the Atelier 340 Muzeum, its main mission is the study and promotion of sculpture and three-dimensional art in Belgium and abroad.\r\nAtelier 34zero Muzeum organises 3 to 4 exhibitions a year in its own spaces as well as several events extra muros. Three types of exhibitions are organised: thematic, confrontational or comparative, and personal (retrospectives). These are accompanied by quality publications; quadrilingual and richly illustrated catalogues, and postcards. \r\nAlong with its exhibitions, Atelier 34zero Muzeum is building up a collection of artworks as a memory of past activities and a tool for further questioning. It contains work of Ado Hamelrijck, Wladyslaw Hasior, Pal Horvath, Jem, Roman Karalus, Walter Leblanc, Jean-Philippe Lecharlier, Waclaw Szpakowski, Guy Stukens, Bernar Venet, Bob Verschueren, Bernard Villers and  Christine Wilm\u00e8s, among others.","description_print":"","booking_url":null,"sort_order":"ATELIER 34ZERO MUZEUM","virtual_visit":null},"de":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"Die Geb\u00e4ude und der Park bergen einen Ausstellungraum, ein Dokumentationszentrum, eine Fachbuchhandlung, einen Ausstellungsgarten und ein Caf\u00e9. Die Sammlung umfasst Werke von Ado Hamelrijck, Wladyslaw Hasior, Pal Horvath, Jem, Roman Karalus, Walter Leblanc, Jean-Philippe Lecharlier, Waclaw Szpakowski, Guy Stukens, Bernar Venet, Bob Verschueren, Bernard Villers und Christine Wilm\u00e8s. ","description_print":"","booking_url":null,"sort_order":"ATELIER 34ZERO MUZEUM","virtual_visit":null},"it":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Atelier 34zero Muzeum","address_street_name":"Dr\u00e8ve de Rivieren","address_street_number":"334","address_street_box":null,"email":"info@atelier34zero.be","website":"http:\/\/www.atelier34zero.be","phone_contact":"+32 2 428 33 06","phone_booking":"+32 2 428 33 06","address_zip":"1090","address_city":"Jette","address_line1":"Dr\u00e8ve de Rivieren, 334","address_line2":"1090 Jette","description_web":"","descripti