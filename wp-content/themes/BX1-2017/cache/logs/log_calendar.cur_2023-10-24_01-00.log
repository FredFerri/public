\/de\/steigenberger-hotels-resorts","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002329"},"it":{"name":"Exposition de Michel Bassompierre au Steigenberger Wiltcher icon's","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/de\/steigenberger-hotels-resorts","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002329"},"cn":{"name":"Exposition de Michel Bassompierre au Steigenberger Wiltcher icon's","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/de\/steigenberger-hotels-resorts","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002329"},"fr":{"name":"Exposition Fragiles Colosses","shortdescr":null,"longdescr":"Fid\u00e8le \u00e0 ce qui est devenu une tradition mais aussi et avant tout, une volont\u00e9 d\u2019associer l\u2019art et le luxe, la culture et l\u2019\u00e9v\u00e9nementiel dans la Capitale de l\u2019Europe, l\u2019H\u00f4tel Steigenberger Icon Wiltcher\u2019s Brussels accueille les \u0153uvres animali\u00e8res monumentales du sculpteur Michel BASSOMPIERRE.  \nD\u00e8s le 4 octobre prochain et jusque fin janvier 2024, plusieurs sculptures animali\u00e8res embl\u00e9matiques de Michel BASSOMPIERRE seront install\u00e9es dans la Cour int\u00e9rieur du complexe Wiltcher\u2019s de l\u2019Avenue Louise. Quartier et h\u00f4tel luxueux pour \u0153uvres prestigieuses, le lieu \u00e9tait id\u00e9al pour inviter cet artiste et ses \u0153uvres connues bien au-del\u00e0 de l\u2019Hexagone. \nApr\u00e8s Paris et avant Monaco ou encore New-York, c\u2019est au c\u0153ur de la Capitale de l\u2019Europe, que seront expos\u00e9s en exclusivit\u00e9 au Wiltcher\u2019s Hotel, ours polaires et gorilles g\u00e9ants durant ces 4 prochains mois. \nAutre invit\u00e9 de marque, le notoire dessinateur-caricaturiste belge, Philippe GELUCK, papa du plus c\u00e9l\u00e8bre chat de Belgique sera le parrain de l\u2019exposition ! \nQuand l\u2019Art alerte et d\u00e9fend la plan\u00e8te\nUne exposition en plein air qui alerte de fa\u00e7on douce et subtile, aussi artistique qu\u2019esth\u00e9tique, qui interpelle autant qu\u2019elle \u00e9merveille, sur la beaut\u00e9, voire l\u2019intimit\u00e9, de ces animaux r\u00e9ellement mis en p\u00e9ril. Une fa\u00e7on aussi d\u2019\u00e9voquer l\u2019implication engag\u00e9e de cet artiste pour, \u00e0 sa fa\u00e7on, la d\u00e9fense de l\u2019environnement, la sauvegarde de la faune et de la flore de notre plan\u00e8te tellement mise \u00e0 mal. \nMichel BASSOMPIERRE, mais aussi son ami le photographe, Yann ARTHUS-BERTRAND repr\u00e9sentent aujourd\u2019hui, tous deux, de v\u00e9ritables ambassadeurs de la cause environnementale. Leurs arts respectifs servent d\u00e9j\u00e0 \u00e0 merveille leur discours conjoint. \n","performers":"Michel Bassompierre (Sculpteur, artiste de l'exposition), Philippe Gueluck (Parrain de l'exposition)","boxoffice_url":null,"website":"https:\/\/hrewards.com\/de\/steigenberger-hotels-resorts","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002329"},"sp":{"name":"Exposition de Michel Bassompierre au Steigenberger Wiltcher icon's","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/de\/steigenberger-hotels-resorts","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002329"},"nl":{"name":"Exposition Fragiles Colosses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/de\/steigenberger-hotels-resorts","email":null,"phone_contact":null,"phone_booking"