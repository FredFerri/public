t":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-05T11:52:07+02:00","published_at":"2024-09-05T11:43:10+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307226,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Guided Tour of the Dewez House (Belgian Museum of Freemasonry) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000970"},"pt":{"name":"Guided Tour of the Dewez House (Belgian Museum of Freemasonry) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000970"},"en":{"name":"Guided Tour of the Dewez House (Belgian Museum of Freemasonry) - BBN 2024","shortdescr":null,"longdescr":"This elegant Neoclassical building, erected between 1760 and 1770, has long been regarded as the personal residence of Laurent-Beno\u00eet Dewez, the first architect of Charles of Lorraine, Governor of the Austrian Netherlands. Trained in Rome and London by great masters of Neoclassicism, Dewez is behind many public and religious edifices, among which the Palace of Charles of Lorraine in Brussels, the Castle of Seneffe and several abbeys such as those in Orval, Affligem, Floreffe, Forest, Ninove, Ghent, Gembloux, etc. Between 2008 and 2011, the Dewez House underwent significant restoration works to re-establish its Neoclassical unity and its original decorations. The listed salons and the former stables on the ground floor currently house the Belgian Museum of Freemasonry. In the attic at the top of the monumental staircase, the visitors will exceptionally see the museum's reserves as well as the building's original timber framework.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000970"},"it":{"name":"Guided Tour of the Dewez House (Belgian Museum of Freemasonry) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000970"},"cn":{"name":"Guided Tour of the Dewez House (Belgian Museum of Freemasonry) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000970"},"fr":{"name":"Visite Guid\u00e9e de la Maison Dewez (Mus\u00e9e belge de la Franc-Ma\u00e7onnerie) - BBN 2024","shortdescr":null,"longdescr":"\u00c9rig\u00e9 entre 1760 et 1770, cet \u00e9l\u00e9gant h\u00f4tel n\u00e9oclassique a longtemps \u00e9t\u00e9 consid\u00e9r\u00e9 comme la r\u00e9sidence personnelle de Laurent-Beno\u00eet Dewez, premier architecte de Charles de Lorraine, Gouverneur des Pays-Bas autrichiens. Form\u00e9 \u00e0 Rome et \u00e0 Londres par des grands ma\u00eetres du n\u00e9oclassicisme, Dewez est l'auteur de nombreux \u00e9difices publiques et religieux, dont le palais de Charles de Lorraine \u00e0 Bruxelles, le ch\u00e2teau de Seneffe et plusieurs abbayes dont Orval, Affligem, Floreffe, Forest, Ninove, Gand, Gembloux, etc. Entre 2008 et 2011, l'h\u00f4tel Dewez fut l'objet d'une campagne de restauration significative pour retrouver son unit\u00e9 n\u00e9oclassique et ses d\u00e9cors originels. Les salons class\u00e9s et les anciennes \u00e9curies du rez-de-chauss\u00e9e sont d\u00e9sormais occup\u00e9es par le Mus\u00e9e belge de la franc-ma\u00e7onnerie. Exceptionnellement, et au sommet de l'escalier monumental, les visiteurs pourront d\u00e9couvrir, dans les greniers, les r\u00e9serves du mus\u00e9e ainsi que la charpente d'origine.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000970"},"sp":{"name":"Guided Tour of the Dewez House (Belgian Museum of Freemasonry) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000970"},"nl":{"name":"Rondleiding van het Dewez Herenhuis (Belgisch Museum van de Vrijmetselarij) - BBN 2024","shortdescr":null,"longdescr":"Deze elegante neoklassieke residentie, gebouwd tussen 1760 en 1770, werd lange tijd beschouwd als de persoonlijke woning van Laurent-Beno\u00eet Dewez, hofarchitect van Karel van Lotharingen, gouverneur der Oostenrijkse Nederlanden. Dewez was de ontwerper van tal van publieke en religieuze bouwwerken uit zijn tijd, waaronder het paleis van Karel van Lotharingen te Brussel, het kasteel van Seneffe en verscheidene abdijen zoals die van Orval, Affligem, Floreffe, Vorst, Ninove, Gent, Gembloux, etc. Tussen 2008 en 2011 onderging Huis Dewez een grondige restauratie waarbij de neoklassieke eenheid en de oude interieurs in ere werden hersteld. De beschermde salons en de voormalige stallen op de benedenverdieping vormen nu het decor van het Belgisch Museum voor de Vrijmetselarij. Voor de gelegenheid krijgen bezoekers via de monumentale trap uitzonderlijk ook toegang tot de museumreserves op de zolderverdieping, waar het oorspronkelijke gebinte nog zichtbaar is.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000970"}},"place":{"id":243784,"translations":{"de":{"name":"Belgisches Museum der Freimaurerei","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"Das Museum befindet sich in den Geb\u00e4uden des Grand Orient de Belgique, der \u00e4ltesten und gr\u00f6\u00dften Freimaurerloge Belgiens. Es birgt zahlreiche historische Sammlungen: Gem\u00e4lde, thematische Vitrinen mit Dokumenten, Schmuck, Geschirr und freimaurerischen Schriften.\n\n\nAu\u00dfergew\u00f6hnliche \u00d6ffnungszeiten:\nErster Sonntag im Monat: 13.00 - 17.00 Uhr freier Eintritt","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museo Belga de la Francmasoner\u00eda","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Belgian Museum of Freemasonry","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Laeken, 73","address_line2":"1000 Brussels","description_web":"Historic and thematic overview of the history of freemasonry in Belgium.\nThe Belgian Museum of Freemasonry is a gesture of openness, an invitation by an institution renowned for it\u2019s discretion and veiled in mystery, to get acquainted with its history. The museum, situated in an exquisitely restored neoclassical townhouse (house Dewez, late 18th century), presents artworks, ritual objects, jewellery, textiles, documents and books from the 18th century and on. They illustrate the origins, historic evolution, workings, ideas and present structures of freemasonry. \n\nExceptional opening:\nFirst Sunday of the month: 13.00 - 17.00 free admission","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Belga della Massoneria","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Belge de la Franc-Ma\u00e7onnerie","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Belge de la Franc-Ma\u00e7onnerie","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"Aper\u00e7u historique et th\u00e9matique de la franc-ma\u00e7onnerie en Belgique.\nLe Mus\u00e9e Belge de la Franc-Ma\u00e7onnerie correspond \u00e0 une volont\u00e9 d\u2019ouverture de la part d\u2019une association entour\u00e9e de myst\u00e8re. Situ\u00e9 dans un b\u00e2timent n\u00e9oclassique (H\u00f4tel Dewez, fin 18\u00e8me si\u00e8cle), les visiteurs ont la possibilit\u00e9 de d\u00e9couvrir l\u2019histoire, la symbolique et les valeurs d\u00e9fendues par les francs\u2013ma\u00e7ons. Le mus\u00e9e pr\u00e9sente des objets d\u2019art, des d\u00e9corations, des bijoux, de la vaisselle, des documents et des livres datant du 18\u00e8me si\u00e8cle \u00e0 nos jours qui t\u00e9moignent de l\u2019\u00e9volution historique, du fonctionnement, des id\u00e9es et des structures de la franc-ma\u00e7onnerie.\n\n\nOuverture exceptionnelle:\nPremier dimanche du mois : 13.00 \u2013 17.00 entr\u00e9e gratuite","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Belga de la Francmasoner\u00eda","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"El Museo Belga de la Francmasoner\u00eda responde a un deseo de apertura por parte de una asociaci\u00f3n conocida por su discreci\u00f3n. Intenta explicar el enfoque mas\u00f3nico a trav\u00e9s de vitrinas tem\u00e1ticas y did\u00e1cticas, con el fin de informar y estimular la reflexi\u00f3n. Las piezas presentadas \u2014decoraciones, joyas, vajillas, libros... desde el siglo XVIII hasta nuestros d\u00edas\u2014 son muestras, marcas de la memoria que ilustran la evoluci\u00f3n hist\u00f3rica, el funcionamiento, las ideas y las estructuras actuales de la francmasoner\u00eda. \n\nApertura excepcional:\nPrimer domingo de mes: 13.00 - 17.00 entrada gratuita","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Belgisch Museum van de Vrijmetselarij","address_street_name":"Lakensestraat","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Lakensestraat, 73","address_line2":"1000 Brussel","description_web":"Historisch en thematisch overzicht van de vrijmetselarij in Belgi\u00eb.\nHet Belgisch Museum van de Vrijmetselarij is een gebaar van openheid, een uitnodiging van een vereniging die bekend staat voor haar discretie, om haar geschiedenis beter te leren kennen. Het museum, gelegen in een prachtig gerestaureerd, neo-classicistisch gebouw (Huis Dewez, eind 18de eeuw), stelt ma\u00e7onnieke kunstwerken, gebruiksvoorwerpen, boeken en documenten van de 18de eeuw tot heden tentoon. Het zijn stille getuigen van de oorsprong, historische evolutie, de werking, de idee\u00ebn en de hedendaagse structuren van de vrijmetselarij.\n\n\nUitzonderlijke opening:\nEerste zondag van de maand: 13.00 - 17.00 uur gratis toegang","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoff