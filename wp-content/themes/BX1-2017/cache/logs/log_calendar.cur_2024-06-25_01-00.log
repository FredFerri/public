is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-24T02:00:47+02:00","published_at":"2024-06-18T17:32:46+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":302443,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.24871131731971627,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[41,36],"translations":{"de":["Installation, Performance","Museen & Kunstzentren"],"pt":[null,null],"en":["Installation, performance","Museums and art centers"],"it":["Installazioni, performance","Musei e centri artistici"],"cn":[null,null],"fr":["Installation, performance","Mus\u00e9es et art centers"],"sp":["Instalaci\u00f3n, performance","Museos y centros de arte"],"nl":["Installatie, performance","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Crossroads - The Price of Choice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.basilicakoekelberg.be","email":"rectoraat.rectorat@basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 75","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011681"},"pt":{"name":"Crossroads - The Price of Choice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.basilicakoekelberg.be","email":"rectoraat.rectorat@basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 75","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011681"},"en":{"name":"Crossroads - The Price of Choice","shortdescr":"With \"Crossroads\", the Bulgarian artist & icon painter Dian Kostov brings a contemporary perspective to tradition with an exceptional exhibition at the National Basilica, the world's largest Art Deco church. This one-of-a kind collaboration transforms the church inside and out with custom installations and modern icon paintings, creating an immersive experience for visitors. ","longdescr":"Dian Kostov, a Bulgarian icon painter and leading artist in his field, brings a fresh interpretation to centuries-old tradition. For the exhibition \u201cCrossroads \u2013 The Price of Choice\u201d, he created immersive experience in the Basilica that begins from the moment you approach the exterior. 17-metre-high images depicting scenes from the lives of Jesus Christ and the Virgin Mary decorates the facade of one of the largest churches in the world.  \n\nThe unique combination of the grandness of scale and the intimacy of personal experience is continued by the works inside the basilica. Viewers will be challenged to walk a path that represents our search and wanderings in achieving spirituality and harmony. Do temptations, material achievements, haste and consumerism really make us happier? Go on a contemplative journey, through this modern interpretations of traditional icons. \n","performers":"Dian Kostov (artist & icon painter) ","boxoffice_url":null,"website":"http:\/\/www.basilicakoekelberg.be","email":"rectoraat.rectorat@basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 75","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011681"},"it":{"name":"Crossroads - The Price of Choice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.basilicakoekelberg.be","email":"rectoraat.rectorat@basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 75","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011681"},"cn":{"name":"Crossroads - The Price of Choice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.basilicakoekelberg.be","email":"rectoraat.rectorat@basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 75","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011681"},"fr":{"name":"Crossroads - Le Prix du Choix","shortdescr":"L'exposition \"Crossroads\", de l'artiste bulgare et peintre d'ic\u00f4nes modernes Dian Kostov, apporte une perspective contemporaine \u00e0 la tradition. Cette exposition exceptionnelle a lieu \u00e0 la Basilique Nationale, la plus grande \u00e9glise Art D\u00e9co du monde. Cette collaboration unique offre une exp\u00e9rience immersive aux visiteurs, avec des installations sur mesure et des peintures d'ic\u00f4nes modernes. ","longdescr":"Dian Kostov, un peintre d'ic\u00f4nes et artiste bulgare de renom, offre une nouvelle interpr\u00e9tation \u00e0 une tradition s\u00e9culaire. Pour l'exposition \"Crossroads - Le Prix du Choix\", il cr\u00e9e une exp\u00e9rience immersive pour les visiteurs, qui commence d\u00e8s qu\u2019ils s\u2019approchent de la Basilique : des images de 17 m\u00e8tres de haut repr\u00e9sentant des sc\u00e8nes de la vie de J\u00e9sus-Christ et de la Vierge Marie ornent la fa\u00e7ade de l'une des plus grandes \u00e9glises du monde.\n\nL'alliance singuli\u00e8re entre la grandeur de l'\u00e9chelle et l'intimit\u00e9 de l'exp\u00e9rience personnelle se prolonge \u00e0 l'int\u00e9rieur de la Basilique. Les visiteurs sont convi\u00e9s \u00e0 suivre un chemin symbolisant la qu\u00eate et les errances dans la recherche de spiritualit\u00e9 et d'harmonie. Sommes-nous plus heureux ou plus \u00e9panouis en c\u00e9dant aux tentations, aux r\u00e9alisations mat\u00e9rielles, \u00e0 la h\u00e2te et la consommation ? ","performers":"Dian Kostov (artiste & iconographe)","boxoffice_url":null,"website":"http:\/\/www.basilicakoekelberg.be","email":"rectoraat.rectorat@basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 75","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011681"},"sp":{"name":"Crossroads - The Price of Choice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.basilicakoekelberg.be","email":"rectoraat.rectorat@basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 75","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011681"},"nl":{"name":"Crossroads - De Prijs van Keuze","shortdescr":"Met \"Crossroads\" brengt de Bulgaarse kunstenaar Dian Kostov een eigentijds perspectief op traditie met een uitzonderlijke tentoonstelling in de Nationale Basiliek, 's werelds grootste Art Deco-kerk. Deze unieke samenwerking transformeert de kerk van binnen en van buiten met op maat gemaakte installaties en moderne icoonschilderijen, en cre\u00ebert zo een \"immersive experience\" voor bezoekers. ","longdescr":"Dian Kostov, een vooraanstaande Bulgaarse icoonschilder en kuntenaar, biedt een eigentijdse interpretatie van eeuwenoude tradities met zijn tentoonstelling \"Crossroads - De Prijs van Keuze\". Zodra bezoekers de Basiliek naderen, 's werelds grootste Art Deco-kerk, worden ze onmiddellijk ondergedompeld in de unieke wereld van de kunstenaar. Op de gevels van de Basiliek prijken doeken van maar liefst 17 meter hoog, die levendige sc\u00e8nes uit het leven van Jezus Christus en de Heilige Maagd uitbeelden.\n\nDe unieke combinatie van grootschaligheid en de persoonlijke ervaring wordt voortgezet binnen de basiliek. Bezoekers worden uitgenodigd om een reis te maken die de zoektocht naar spiritualiteit en harmonie weerspiegelt. Bieden verleidingen, materi\u00eble succes, haast en consumentisme echt diepgaande voldoening of geluk? ","performers":"Dian Kostov (kunstenaar & iconograaf) ","boxoffice_url":null,"website":"http:\/\/www.basilicakoekelberg.be","email":"rectoraat.rectorat@basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 75","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011681"}},"place":{"id":270598,"translations":{"de":{"name":"Nationalbasilika des Heiligen Herzens - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":"Die Nationalbasilika ist die f\u00fcnftgr\u00f6\u00dfte Kirche der Welt. Gr\u00f6\u00dfer noch sind nur die Basilique de Notre-Dame de la Paix in Yamoussoukro in der Elfenbeink\u00fcste, die Peterskirche in Rom, die St.-Pauls-Kathedrale in London und die Kathedrale Santa Maria del Fiore in Florenz.\r\nHeutzutage ist die Kirche vor allem ein Gebetsort f\u00fcr den Frieden. Die Kirche wird benutzt f\u00fcr Pfarrzelebrierungen und gro\u00dfe nationale Zelebrierungen. Die Nationalbasilika zu Koekelberg hat aber viel mehr zu bieten: Sie hat eine wichtige kulturelle Funktion. Sie ist ein wunderbares Art Deco Denkmal, Sie umfasst zwei Museen; jedes Jahr finden in ihre R\u00e4ume verschiedene Ausstellungen statt; letztlich kann man dank ihrem Kuppels die sch\u00f6nste Aussicht \u00fcber Br\u00fcssel genie\u00dfen.\r\nWir hoffen, Sie schnell begr\u00fc\u00dfen zu k\u00f6nnen in diesem pr\u00e4chtigen Art Deco Denkmal!\r\nAchtung : Im Winter (Ende Oktober bis Ende M\u00e4rz) schlie\u00dft die Basilika um 17 Uhr.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Bas\u00edlica Nacional de Sacr\u00e9-C\u0153ur - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":"A Bas\u00edlica de Koekelberg \u00e9 a quinta maior igreja do mundo, ap\u00f3s a Bas\u00edlica de Nossa Senhora da Paz de Yamoussoukro na Costa do Marfim, a Bas\u00edlica de S\u00e3o Pedro em Roma, a Catedral de S\u00e3o Paulo em Londres e a Catedral de Santa Maria del Fiore em Floren\u00e7a. Hoje, a bas\u00edlica consiste, em primeiro lugar, num local de ora\u00e7\u00e3o pela paz. \u00c9 utilizada para celebra\u00e7\u00f5es paroquiais e nacionais. A Bas\u00edlica de Koekelberg tem tamb\u00e9m muito mais a oferecer. Tem, igualmente, uma fun\u00e7\u00e3o cultural importante. \u00c9 um monumento Art D\u00e9co espl\u00eandido, com dois museus com v\u00e1rias exposi\u00e7\u00f5es durante o ano, onde pode gozar de uma vista extraordin\u00e1ria de Bruxelas. Esperemos poder acolh\u00ea-lo brevemente neste magn\u00edfico monumento!\r\nAten\u00e7\u00e3o : no inverno (do final de outubro ao final de mar\u00e7o) a basilica fecha \u00e0s 17 h","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"National Basilica of the Sacred Heart - Koekelbeg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":"The Koekelberg Basilica ranks fifth among the world's largest churches, after the Basilica of Notre-Dame de la Paix in Yamoussokro on the Ivory Coast, St Peter's in Rome, St Paul's in London and Santa Maria Dei Fiori in Florence. \r\nToday, the church is in the first place a place of prayer for peace. The church is still used for celebrations of the parish or for big national celebrations. But the basilica is more than that. The basilica has also an important cultural function. It\u2019s a magnificent Art Deco monument, there are two museums, there are yearly different expositions and you can enjoy a wonderful view over Brussels!\r\nWe're looking forward to welcoming you soon in this fantastic Art Deco Monument!\r\nWarning : in winter (late October to late March) the basilica closes at 5 pm.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Basilique Nationale du Sacr\u00e9 Coeur - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Basilique Nationale du Sacr\u00e9 Coeur - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Basilique Nationale du Sacr\u00e9 Coeur - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":"La Basilique de Koekelberg est la cinqui\u00e8me \u00e9glise la plus grande du monde, apr\u00e8s la Basilique de Notre-Dame de la Paix de Yamoussoukro en C\u00f4te d'Ivoire, l\u2019\u00e9glise Saint Pierre \u00e0 Rome, la cath\u00e9drale Saint Paul \u00e0 Londres et l\u2019 \u00e9glise Santa Maria Dei Fiori \u00e0 Florence.\r\nAujourd\u2019hui, la basilique est en premier lieu un lieu de pri\u00e8re pour la paix. Elle est utilis\u00e9e pour des c\u00e9l\u00e9brations paroissiales et nationales. Mais la basilique de Koekelberg a beaucoup plus \u00e0 offrir. Elle a \u00e9galement une fonction culturelle importante. C\u2019est un monument Art D\u00e9co splendide, il y a deux mus\u00e9es, chaque ann\u00e9e il y a plusieurs expositions et vous pouvez y jouir d\u2019un panorama extraordinaire sur Bruxelles.\r\nNous esp\u00e9rons pouvoir vous accueillir prochainement dans ce monument magnifique !\r\nAttention : en hiver (de fin octobre \u00e0 fin mars), la basilique ferme ses portes \u00e0 17 h.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Basilique Nationale du Sacr\u00e9 Coeur - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Nationale Basiliek van het Heilig Hart - Koekelberg","address_street_name":"Basiliekvoorplein","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Basiliekvoorplein","address_line2":"1083 Ganshoren","description_web":"Wat de oppervlakte betreft, is de Basiliek van Koekelberg de vijfde grootste kerk ter wereld, na de Basilique de Notre-Dame de la Paix te Yamoussoukro in Ivoorkust, de Sint-Pieterskerk in Rome, de Sint Paulskathedraal in Londen en de Santa Maria Dei Fiori kerk in Firenze.\r\nVandaag is de kerk in de eerste plaats een bidplaats voor de vrede. \r\nDe basiliek wordt nog steeds gebruikt voor parochiale vieringen en grote nationale vieringen.\r\nMaar de Basiliek van Koekelberg is meer dan dat. Ze vervult ook een belangrijke culturele functie. Het is een prachtig Art Deco monument, er zijn twee musea, er worden jaarlijks verschillende tentoonstellingen georganiseerd en u kunt er genieten van een prachtig panorama over Brussel!\r\nWaarschuwing : in de winter (eind oktober tot eind maart) sluit de basiliek om 17 uur.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":30598,"location":{"lat":50.86758279,"lon":4.31529967},"region":"brussels","last_updated_at":"2022-10-17T13:34:18+02:00","published_at":"2018-01-15T14:02:01+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":270598,"translations":{"de":{"name":"Nationalbasilika des Heiligen Herzens - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":"Die Nationalbasilika ist die f\u00fcnftgr\u00f6\u00dfte Kirche der Welt. Gr\u00f6\u00dfer noch sind nur die Basilique de Notre-Dame de la Paix in Yamoussoukro in der Elfenbeink\u00fcste, die Peterskirche in Rom, die St.-Pauls-Kathedrale in London und die Kathedrale Santa Maria del Fiore in Florenz.\r\nHeutzutage ist die Kirche vor allem ein Gebetsort f\u00fcr den Frieden. Die Kirche wird benutzt f\u00fcr Pfarrzelebrierungen und gro\u00dfe nationale Zelebrierungen. Die Nationalbasilika zu Koekelberg hat aber viel mehr zu bieten: Sie hat eine wichtige kulturelle Funktion. Sie ist ein wunderbares Art Deco Denkmal, Sie umfasst zwei Museen; jedes Jahr finden in ihre R\u00e4ume verschiedene Ausstellungen statt; letztlich kann man dank ihrem Kuppels die sch\u00f6nste Aussicht \u00fcber Br\u00fcssel genie\u00dfen.\r\nWir hoffen, Sie schnell begr\u00fc\u00dfen zu k\u00f6nnen in diesem pr\u00e4chtigen Art Deco Denkmal!\r\nAchtung : Im Winter (Ende Oktober bis Ende M\u00e4rz) schlie\u00dft die Basilika um 17 Uhr.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Bas\u00edlica Nacional de Sacr\u00e9-C\u0153ur - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":"A Bas\u00edlica de Koekelberg \u00e9 a quinta maior igreja do mundo, ap\u00f3s a Bas\u00edlica de Nossa Senhora da Paz de Yamoussoukro na Costa do Marfim, a Bas\u00edlica de S\u00e3o Pedro em Roma, a Catedral de S\u00e3o Paulo em Londres e a Catedral de Santa Maria del Fiore em Floren\u00e7a. Hoje, a bas\u00edlica consiste, em primeiro lugar, num local de ora\u00e7\u00e3o pela paz. \u00c9 utilizada para celebra\u00e7\u00f5es paroquiais e nacionais. A Bas\u00edlica de Koekelberg tem tamb\u00e9m muito mais a oferecer. Tem, igualmente, uma fun\u00e7\u00e3o cultural importante. \u00c9 um monumento Art D\u00e9co espl\u00eandido, com dois museus com v\u00e1rias exposi\u00e7\u00f5es durante o ano, onde pode gozar de uma vista extraordin\u00e1ria de Bruxelas. Esperemos poder acolh\u00ea-lo brevemente neste magn\u00edfico monumento!\r\nAten\u00e7\u00e3o : no inverno (do final de outubro ao final de mar\u00e7o) a basilica fecha \u00e0s 17 h","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"National Basilica of the Sacred Heart - Koekelbeg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":"The Koekelberg Basilica ranks fifth among the world's largest churches, after the Basilica of Notre-Dame de la Paix in Yamoussokro on the Ivory Coast, St Peter's in Rome, St Paul's in London and Santa Maria Dei Fiori in Florence. \r\nToday, the church is in the first place a place of prayer for peace. The church is still used for celebrations of the parish or for big national celebrations. But the basilica is more than that. The basilica has also an important cultural function. It\u2019s a magnificent Art Deco monument, there are two museums, there are yearly different expositions and you can enjoy a wonderful view over Brussels!\r\nWe're looking forward to welcoming you soon in this fantastic Art Deco Monument!\r\nWarning : in winter (late October to late March) the basilica closes at 5 pm.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Basilique Nationale du Sacr\u00e9 Coeur - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Basilique Nationale du Sacr\u00e9 Coeur - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Basilique Nationale du Sacr\u00e9 Coeur - Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":null,"address_street_box":null,"email":"info@basilicakoekelberg.be","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 421 16 60","phone_booking":"+32 2 421 16 67","address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique","address_line2":"1083 Ganshoren","description_web":"La Basilique de K