 particuli\u00e8rement soign\u00e9e tout comme celle des nombreuses maisons bourgeoises qui l\u2019entourent. Cette visite part \u00e0 la d\u00e9couverte d\u2019un quartier au riche pass\u00e9 industriel et qui a conserv\u00e9 un patrimoine architectural extraordinaire mais aussi de nombreuses traces d\u2019entreprises qui s\u2019y d\u00e9velopp\u00e8rent et qui firent de Bruxelles la premi\u00e8re ville industrialis\u00e9e du continent.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530799.html"},"nl":{"name":"Le quartier des v\u00e9t\u00e9rinaires \u00e0 Anderlecht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530799.html"},"en":{"name":"Le quartier des v\u00e9t\u00e9rinaires \u00e0 Anderlecht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530799.html"},"de":{"name":"Le quartier des v\u00e9t\u00e9rinaires \u00e0 Anderlecht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530799.html"},"it":{"name":"Le quartier des v\u00e9t\u00e9rinaires \u00e0 Anderlecht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530799.html"},"sp":{"name":"Le quartier des v\u00e9t\u00e9rinaires \u00e0 Anderlecht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"pho