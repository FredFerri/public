 et des r\u00e9actions\r\n- Accro\u00eetre la vitesse d'ex\u00e9cution et de r\u00e9p\u00e9tition des blocages et des frappes\r\n- Coordination par l'ex\u00e9cution simultan\u00e9e de techniques de poings et de jambes\r\n- Perfectionner les capacites cognitives \u00e0 travers des encha\u00eenements de techniques\r\n\r\nPour plus d'informations et inscriptions, veuillez visiter notre site internet","performers":null,"boxoffice_url":null,"website":"https:\/\/www.redforce.be","email":"contact@redforce.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545044"},"nl":{"name":"Cours taekwon-do enfants 7-13 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.redforce.be","email":"contact@redforce.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545044"},"en":{"name":"Cours taekwon-do enfants 7-13 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.redforce.be","email":"contact@redforce.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545044"},"de":{"name":"Cours taekwon-do enfants 7-13 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.redforce.be","email":"contact@redforce.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545044"},"it":{"name":"Cours taekwon-do enfants 7-13 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.redforce.be","email":"contact@redforce.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545044"},"sp":{"name":"Cours taekwon-do enfants 7-13 ans","shortdescr":null,"longdescr":null,"performers":n