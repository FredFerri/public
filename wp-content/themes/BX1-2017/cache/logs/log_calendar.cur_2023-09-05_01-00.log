che huizen, bewaart het Mode & Kant Museum ongeveer 15.000 voorwerpen die dateren van de 16e eeuw tot vandaag. Het bezit de belangrijkste collecties ter wereld rond de Brusselse ontwerpen en kleding, die het in een Belgische en internationale context wil plaatsen.\r\nDe collecties leggen getuigenis af over de evolutie van de mode, maar ook over een tijdperk, onze cultuur en onze maatschappij.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":197,"location":{"lat":50.84577733,"lon":4.35198995},"last_updated_at":"2023-05-16T12:16:17+02:00","published_at":"2013-10-19T01:13:21+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/2a0bdf739fca9b96c4a925a5fef57c04cf16f1de.jpg","width":750,"height":1000,"ratio":0,"oEmbed_height":1000,"oEmbed_width":750,"translations":{"de":{"title":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","copyright":null},"pt":{"title":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","copyright":null},"en":{"title":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","copyright":null},"it":{"title":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","copyright":null},"cn":{"title":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","copyright":null},"fr":{"title":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","copyright":null},"sp":{"title":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","copyright":null},"nl":{"title":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","copyright":null}}}],"dates":[{"day":"2023-06-04","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-07-02","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"