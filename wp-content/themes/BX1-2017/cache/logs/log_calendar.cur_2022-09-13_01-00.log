el et \u00e9ducatif pour comprendre la soci\u00e9t\u00e9 dans laquelle on vit, et devenir un acteur \u00e0 part enti\u00e8re de celle-ci. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Centre \u00c9ducatif et Culturel L\u2019Epicerie","address_street_name":"Beekstraat","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"http:\/\/www.ras-el-hanout.be","phone_contact":"+32 487 01 42 61","phone_booking":"+32 487 01 42 61","address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Beekstraat, 17-19","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre \u00c9ducatif et Culturel L\u2019Epicerie","address_street_name":"rue du ruisseau","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"http:\/\/centrelepicerie.be\/","phone_contact":"+32 487 01 42 61","phone_booking":"+32 487 01 42 61","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue du ruisseau, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre \u00c9ducatif et Culturel L\u2019Epicerie","address_street_name":"rue du ruisseau","address_street_number":"17-19","address_street_box":null,"email":"info@ras-el-hanout.be","website":"http:\/\/centrelepicerie.be\/","phone_contact":"+32 487 01 42 61","phone_booking":"+32 487 01 42 61","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue du ruisseau, 17-19","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Centre \u00c9ducatif et Culturel L\u2019Epicerie","address_street_name":"rue du ruisseau","address_street_number":"17