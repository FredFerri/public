ull,"start":"10:00:00","end":"17:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 17:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 17:00"],"en":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 17:00"]},"date_start":"2022-09-17","date_end":"2022-11-27","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":5},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":3},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":3},{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"}},"value":0},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":3},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T01:36:49+02:00","published_at":"2022-09-30T15:50:26+02:00","backoffice_id":262865,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.43679023236815},{"id":539105,"date_start":"2022-10-01","date_end":"2022-10-30","date_next":"2022-10-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"],"de":["Museen & Kunstzentren","Fotografie"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Palestine, de la NAKBA \u00e0 la NAKSA \u00e0 aujourd\u2019hui","shortdescr":"En Belgique les Palestiniens sont le deuxi\u00e8me plus grand groupe de r\u00e9fugi\u00e9s reconnus en 2021.\r\nLe temps pour le MigratieMuseumMigration de faire une r\u00e9flexion sur l'histoire des Palestiniens.  Le groupe Paix Juste au Proche-Orient Ittre a r\u00e9alis\u00e9 une remarquable exposition \u00ab Palestine, de la NAKBA \u00e0 la NAKSA \u00e0 aujourd\u2019hui \u00bb.","longdescr":"En 2017, le groupe Paix juste au Proche-Orient de Ittre, \u00e0 l\u2019occasion des 50 ans de la Guerre de Juin 1967, appel\u00e9e aussi \u00ab Guerre des Six jours \u00bb, a mis sur pied une exposition de photographies qui retrace l\u2019histoire du Proche-Orient. L\u2019exposition commence par le partage de la Palestine en 1947 et la d\u00e9claration d\u2019ind\u00e9pendance de l\u2019\u00c9tat d\u2019Isra\u00ebl en 1948. Lors de la NAKBA ou catastrophe, plus de 750.000 Palestiniens ont \u00e9t\u00e9 expuls\u00e9s et 615 villages d\u00e9truits. Ensuite, pendant la guerre de juin 1967, une seconde expulsion massive de 300.000 Palestiniens a eu lieu : la NAKSA ou rechute. Depuis lors, la colonisation et l\u2019occupation militaire de la Cisjordanie, de J\u00e9rusalem-Est et le bouclage complet de la bande de Gaza, qui est aussi la cible d\u2019op\u00e9rations militaires, sont pour les Palestiniens synonymes de r\u00e9pression sanglante, d\u2019\u00e9touffement de toute vie sociale et \u00e9conomique. L\u2019exposition de photographes belges, fran\u00e7ais et palestinien explique l\u2019histoire, et t\u00e9moigne des cons\u00e9quences de l\u2019id\u00e9ologie sioniste sur les conditions de vie des Palestiniens. Le but de cette exposition est de contribuer a\u0300 une meilleure compr\u00e9hension du conflit du Proche-Orient et de relayer un appel a\u0300 une paix  pour les Palestiniens.\r\n\r\nLes photographes de l\u2019exposition :\r\n\r\n\u2022Vincent Verhaeren a voyag\u00e9 pendant 33 ans pour la RTBF, a \u00e9t\u00e9 11 fois en Palestine. Il \u00e9tait en reportage lors de la Guerre des 6 Jours. \r\n\u2022Charles Henneghien a r\u00e9alis\u00e9 plusieurs reportages en Palestine et en Isra\u00ebl entre 1996 et 2013.\r\n\u2022Anne Paq est une photographe fran\u00e7aise ind\u00e9pendante et membre d'Activestills, un collectif de photographes engag\u00e9s, bas\u00e9 en Palestine\/Isra\u00ebl : activestills.org \r\n\u2022V\u00e9ronique Vercheval a r\u00e9alis\u00e9 de nombreux reportages en Palestine, et a notamment publi\u00e9 le livre \u00ab Palestine, Carnet de notes \u00bb aux Editions Labor.\r\n\u2022Virginie Nguyen Hoang est co-fondatrice du Collectif HUMA et membre du Studio Hans Lucas. Elle a r\u00e9alis\u00e9 de 2014 \u00e0 2016 le reportage \u00abGaza, the aftermath\u00bb, et s\u2019est rendue \u00e0 Gaza lors de la \u00ab Marche du retour \u00bb en mai 2018.\r\n\u2022Ahmad Al-Bazz est un photographe palestinien membre du collectif Activestills. Il est aussi journaliste et r\u00e9alisateur de documentaires.\r\n\u2022Raymond Saublains a accompagn\u00e9 plusieurs missions de solidarit\u00e9 en Palestine et en Isra\u00ebl, et a photographi\u00e9 des groupes de militants en Belgique.\r\n\u2022Et Fran\u00e7ois Sivine, auteur d\u2019une sculpture repr\u00e9sentant Handala.\r\n.","performers":"Le groupe Paix Juste au Proche-Orient Ittre. Sept photographes belges, fran\u00e7ais et palestinien t\u00e9moignent : Vincent Verhaeren, Charles Henneghien, Anne Paq, V\u00e9ronique Vercheval, Virginie Nguyen Hoang, Ahmad Al-Bazz, Raymond Saublains. Fran\u00e7ois Sivine est l\u2019auteur d\u2019une sculpture repr\u00e9sentant Handala, figure satirique palestinienne.","boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539105"},"nl":{"name":"Palestina, van NAKBA tot NAKSA tot vandaag","shortdescr":"Palestina piekte op de tweede plaats in ons land  in 2021 als gebied van waaruit mensen het beschermd statuut ontvingen in Brussel als  vluchteling. Tijd voor het MigratieMuseumMigration om stil te staan bij het verhaal van de Palestijnen.  De groep Paix Juste au Proche-Orient Ittre maakte een indrukwekkende tentoonstelling \"Palestina, van NAKBA tot NAKSA tot vandaag\".","longdescr":"In 2017 heeft de groep \u201cPaix juste au Proche-Orient de Ittre\u201d ter gelegenheid van de 50e verjaardag van de oorlog van juni 1967, ook bekend als de \"Zesdaagse Oorlog\", een fototentoonstelling samengesteld die de geschiedenis van het Midden-Oosten schetst. De tentoonstelling begint met de deling van Palestina in 1947 en de onafhankelijkheidsverklaring van de staat Isra\u00ebl in 1948. Tijdens de NAKBA of catastrofe werden meer dan 750.000 Palestijnen verdreven en 615 dorpen verwoest. Daarna, tijdens de oorlog van juni 1967, vond een tweede massale verdrijving van 300.000 Palestijnen plaats: de NAKSA of terugval. Sindsdien zijn de kolonisatie en de militaire bezetting van de Westelijke Jordaanoever, Oost-Jeruzalem en de volledige afsluiting van de Gazastrook, die ook het doelwit is van militaire operaties, voor de Palestijnen synoniem met bloedige repressie en verstikking van elk sociaal en economisch leven. De tentoonstelling van Belgische, Franse en Palestijnse fotografen licht het verhaal toe en getuigt van de levensomstandigheden van de Palestijnen. Het doel van deze tentoonstelling is bij te dragen tot een beter begrip van het conflict in het Midden-Oosten en op te roepen voor een vreedzame oplossing voor de Palestijnen.\r\n\r\nDe fotografen van de tentoonstelling :\r\n\r\n- Vincent Verhaeren reist al 33 jaar voor de RTBF en is 11 keer in Palestina geweest. Hij deed verslag van de 6-daagse oorlog. \r\n- Charles Henneghien heeft tussen 1996 en 2013 verschillende reportages gemaakt in Palestina en Isra\u00ebl.\r\n- Anne Paq is een Franse freelance fotograaf en lid van Activestills, een collectief van ge\u00ebngageerde fotografen gevestigd in Palestina\/Isra\u00ebl: activestills.org \r\n- V\u00e9ronique Vercheval heeft talrijke reportages gemaakt in Palestina, en heeft met name het boek \"Palestine, Carnet de notes\" (Editions Labor) gepubliceerd.\r\n- Virginie Nguyen Hoang is medeoprichtster van het Collectif HUMA en lid van Studio Hans Lucas. Van 2014 tot 2016 regisseerde ze de reportage \"Gaza, the aftermath\", en in mei 2018 ging ze naar Gaza tijdens de \"Mars van de Terugkeer\".\r\n- Ahmad Al-Bazz is een Palestijnse fotograaf en lid van het collectief Activestills. Hij is ook journalist en documentairemaker.\r\n- Raymond Saublains begeleidde verschillende solidariteitsmissies naar Palestina en Isra\u00ebl, en fotografeerde groepen activisten in Belgi\u00eb.\r\n- En Fran\u00e7ois Sivine, auteur van een beeld dat Handala voorstelt.","performers":"Le groupe Paix Juste au Proche-Orient Ittre. \r\nZeven Belgische, Franse en Palestijnse fotografen getuigen: Vincent Verhaeren, Charles Henneghien, Anne Paq, V\u00e9ronique Vercheval, Virginie Nguyen Hoang, Ahmad Al-Bazz, Raymond Saublains. Fran\u00e7ois Sivine is de auteur van een beeldhouwwerk dat Handala voorstelt, een Palestijnse satirische figuur","boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539105"},"en":{"name":"Palestine, de la NAKBA \u00e0 la NAKSA \u00e0 aujourd\u2019hui","shortdescr":"In Belgium Palestinians are on the second place of recognised refugees in 2021.\r\nTime for the MigratieMuseumMigration to reflect on the story of the Palestinians.  The group Paix Juste au Proche-Orient Ittre created an impressive exhibition \"Palestine, from NAKBA to NAKSA to today\".","longdescr":"In 2017, on the occasion of the 50th anniversary of the June 1967 war, also known as the \"Six Day War\", the group \"Paix juste au Proche-Orient de Ittre\" put together a photographic exhibition outlining the history of the Middle East. The exhibition begins with the partition of Palestine in 1947 and the declaration of independence of the State of Israel in 1948. During the NAKBA or catastrophe, more than 750,000 Palestinians were expelled and 615 villages destroyed. Then, during the war in June 1967, a second mass expulsion of 300,000 Palestinians took place: the NAKSA or relapse. Since then, the colonisation and military occupation of the West Bank, East Jerusalem and the complete closure of the Gaza Strip, which is also the target of military operations, have been synonymous for the Palestinians with bloody repression and the stifling of every social and economic life. The exhibition of Belgian, French and Palestinian photographers explains the story and bears witness to the living conditions of the Palestinians. The aim of this exhibition is to contribute to a better understanding of the conflict in the Middle East and  to call for a peaceful solution for the Palestinians.\r\n\r\nThe photographers of the exhibition :\r\n\r\n- Vincent Verhaeren has been travelling for the RTBF for 33 years and has been to Palestine 11 times. He reported on the 6-day war. \r\n- Charles Henneghien made several reports in Palestine and Israel between 1996 and 2013.\r\n- Anne Paq is a French freelance photographer and member of Activestills, a collective of committed photographers based in Palestine\/Israel: activestills.org \r\n- V\u00e9ronique Vercheval has done numerous reportages in Palestine, notably publishing the book \"Palestine, Carnet de notes\" (Editions Labor).\r\n- Virginie Nguyen Hoang is co-founder of the Collectif HUMA and a member of Studio Hans Lucas. From 2014 to 2016 she directed the reportage \"Gaza, the aftermath\", and in May 2018 she went to Gaza during the \"March of Return\".\r\n- Ahmad Al-Bazz is a Palestinian photographer and member of the Activestills collective. He is also a journalist and documentary filmmaker.\r\n- Raymond Saublains accompanied several solidarity missions to Palestine and Israel, and photographed groups of activists in Belgium.\r\n- And Fran\u00e7ois Sivine, author of a sculpture representing Handala.","performers":"Le groupe Paix Juste au Proche-Orient Ittre. Seven Belgian, French and Palestinian photographers testify: Vincent Verhaeren, Charles Henneghien, Anne Paq, V\u00e9ronique Vercheval, Virginie Nguyen Hoang, Ahmad Al-Bazz, Raymond Saublains. Fran\u00e7ois Sivine is the author of a sculpture representing Handala, a Palestinian satirical figure.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539105"},"de":{"name":"Palestine, de la NAKBA \u00e0 la NAKSA \u00e0 aujourd\u2019hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539105"},"it":{"name":"Palestine, de la NAKBA \u00e0 la NAKSA \u00e0 aujourd\u2019hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539105"},"sp":{"name":"Palestine, de la NAKBA \u00e0 la NAKSA \u00e0 aujourd\u2019hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539105"},"pt":{"name":"Palestine, de la NAKBA \u00e0 la NAKSA \u00e0 aujourd\u2019hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539105"},"cn":{"name":"Palestine, de la NAKBA \u00e0 la NAKSA \u00e0 aujourd\u2019hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539105"}},"place":{"id":274307,"translations":{"fr":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Aujourd'hui, plus de 180 nationalite\u0301s vivent ensemble a\u0300 Bruxelles. Le MigratieMuseumMigration raconte l\u2019histoire de la premie\u0300re ge\u0301ne\u0301ration de travailleurs immigre\u0301s invite\u0301s, des premiers arrivants au Petit Cha\u0302teau, des expatrie\u0301s, des re\u0301fugie\u0301s de guerre, des Europe\u0301ens qui se sont de\u0301place\u0301s librement au sein de l\u2019UE et de tous les autres. C\u2019est un muse\u0301e chaleureux ou\u0300 les visiteurs peuvent de\u0301couvrir la ville et la vie des autres a\u0300 travers des souvenirs, mais aussi, et avant tout, un lieu accueillant pour y partager sa propre histoire.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"MigratieMuseumMigration","address_street_name":"Werkhuizenstraat","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Werkhuizenstraat, 17","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Vandaag de dag wonen meer dan 180 nationaliteiten samen in Brussel. Het MigratieMuseumMigration geeft de verhalen van de eerste generatiegastarbeiders, van de vroegste bewoners van het Klein Kasteeltje, van de expats, de oorlogsvluchtelingen, de Europeanen die zich vrij bewegen binnen de EU en vele anderen een permanente thuis. Het is een warme omgeving waar bezoekers via herinneringen en kunst op ontdekking gaan in Brussel en in het leven van anderen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Today, more than 180 nationalities live together in Brussels. The MigratieMuseumMigration gives a permanent home to the stories of the first generation of guest workers, of the earliest inhabitants of the Petit-Cha\u0302teau, of the expats, the war refugees, the Europeans who move freely within the EU and many others. It is a warm environment where visitors can discover Brussels and the lives of others through memories and souvenirs. Above all, it is a museum with plenty of room to share your own story.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","addres