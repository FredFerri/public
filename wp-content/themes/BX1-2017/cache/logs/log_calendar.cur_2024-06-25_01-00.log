cle27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-19T14:52:00+02:00","published_at":"2024-06-19T14:38:15+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":302526,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2770984186529621,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"Expo - \"Big guns, only smaller\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011725"},"pt":{"name":"Expo - \"Big guns, only smaller\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011725"},"en":{"name":"Expo - \"Big guns, only smaller\"","shortdescr":"\nExpo - Big guns, only smaller\nNot for Kids only\nThis summer at the Royal Military Museum!\n","longdescr":"\n\nThis summer, the Military Museum welcomes a new temporary exhibition! A series of miniature artillery, illustrating a military history spanning 25 centuries, makes its appearance in the Bordiau Hall. This magnificent collection of more than 500 miniatures in lead, wood, metal and plastic shows a long evolution through time, starting with the Greek catapult in the 4th century and ending with the cannons and missiles still in use today. The small guns reflect reality as accurately as possible and give a nice overview of the types of weapons that existed throughout time.\n\nDiscover this wonderful exhibition through an elaborate trail full of fun questions and interesting anecdotes! \nFree tour, with a booklet available at the museum reception desk\nIncluded in a ticket to the Royal Military Museum\n\nReady to travel through time?!\n","performers":null,"boxoffice_url":null,"website":"https:\/\/militarymuseum.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011725"},"it":{"name":"Expo - \"Big guns, only smaller\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011725"},"cn":{"name":"Expo - \"Big guns, only smaller\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011725"},"fr":{"name":"Expo - \"Des mod\u00e8les r\u00e9duits... canon\"","shortdescr":"\nExpo - \"Des mod\u00e8les r\u00e9duits... canon\"\nNot for Kids only\nCet \u00e9t\u00e9 au Mus\u00e9e de l'Arm\u00e9e !\n","longdescr":"\n\nCet \u00e9t\u00e9, le mus\u00e9e de l'Arm\u00e9e accueille une nouvelle exposition temporaire ! Une s\u00e9rie de petits mod\u00e8les de pi\u00e8ces d\u2019artillerie illustrant 25 si\u00e8cles d'histoire militaire fait son apparition dans la halle Bordiau. Cette magnifique collection de plus de 500 miniatures en plomb, bois, m\u00e9tal et plastique montre une longue \u00e9volution dans le temps, depuis la catapulte grecque du IVe si\u00e8cle jusqu'aux canons et missiles encore utilis\u00e9s aujourd'hui. Les petits canons reproduisent la r\u00e9alit\u00e9 aussi fid\u00e8lement que possible et donnent un bel aper\u00e7u des types d'armes qui existent (ou qui ont exist\u00e9) \u00e0 travers le temps.\n\nD\u00e9couvrez cette merveilleuse exposition \u00e0 travers un parcours fait de questions amusantes et d'anecdotes int\u00e9ressantes !\nParcours gratuit avec livret disponible \u00e0 l'accueil du mus\u00e9e\nCompris dans le ticket d'entr\u00e9e du Mus\u00e9e de l'Arm\u00e9e\n\nPr\u00eat \u00e0 voyager dans le temps ?!\n","performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011725"},"sp":{"name":"Expo - \"Big guns, only smaller\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011725"},"nl":{"name":"Expo - \"Knallende Kleine Kanonnen\"","shortdescr":"\nExpo - \"Knallende Kleine Kanonnen\"\nNot for Kids only\nDeze zomer in het Legermuseum!\n","longdescr":"\n\nDeze zomer ontvangt het Legermuseum een nieuwe tijdelijke tentoonstelling! Een reeks kanonnen op schaal die een militaire geschiedenis van 25 eeuwen illustreert maakt zijn opwachting in de Bordiauzaal. Deze prachtige collectie van meer dan 500 miniaturen in lood, hout, metaal en plastiek toont een lange evolutie doorheen de tijd, te beginnen bij de Griekse katapult in de 4de eeuw tot de kanonnen en raketten die vandaag nog worden gebruikt. De kleine kanonnen geven de werkelijkheid zo getrouw mogelijk weer en geven een mooi overzicht van de soorten wapens die doorheen de tijd bestaan (hebben).\n\nOntdek deze prachtige tentoonstelling aan de hand van een uitgewerkt parcours vol leuke vragen en interessante anekdotes! \nGratis parcours, met opdrachtenboekje te verkrijgen aan de onthaalbalie van het museum\nInbegrepen in een ticket voor het Legermuseum\n\nKlaar om in de tijd te reizen?!\n","performers":null,"boxoffice_url":null,"website":"https:\/\/legermuseum.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011725"}},"place":{"id":555,"translations":{"de":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Mais de dez s\u00e9culos de hist\u00f3ria e de t\u00e9cnicas militares passaram em revista por este museu. A\u00ed encontramos toda a pan\u00f3plia de guerra, da Idade M\u00e9dia \u00e0 \u00e9poca contempor\u00e2nea: armaduras medievais, armas de fogo, avi\u00f5es, carros blindados contempor\u00e2neos, uniformes e penteados militares\u2026\r\nDesde 1 de maio de 2017, o Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar pertence ao War Heritage Institute, a nova institui\u00e7\u00e3o de refer\u00eancia para o patrim\u00f3nio militar e a mem\u00f3ria na B\u00e9lgica.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"War Heritage Institute (Royal Military Museum)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Brussels","description_web":"Here you\u2019ll find medieval armour and souvenirs from the Napoleonic campaigns, as well as a hundred or so aircraft and armoured vehicles from the two Great Wars. A breathtaking panoramic view awaits you at the top of the Arcade.\r\n\r\nSince May 1, 2017 the Royal Military Museum is part of the War Heritage Institute, the new reference institution for military heritage and remembrance in Belgium. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"War Heritage Institute (Mus\u00e9e Royal de l\u2019Arm\u00e9e)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Plus de dix si\u00e8cles d\u2019histoire et de techniques militaires sont pass\u00e9s en revue dans ce mus\u00e9e. On y trouve toute la panoplie de guerre, du Moyen \u00c2ge \u00e0 l\u2019\u00e9poque contemporaine: armures m\u00e9di\u00e9vales, armes \u00e0 feu, avions, blind\u00e9s contemporains, uniformes et coiffures militaires\u2026\r\n\r\nDepuis le 1er mai 2017, le Mus\u00e9e royal de l\u2019Arm\u00e9e appartient au War Heritage Institute, la nouvelle institution de r\u00e9f\u00e9rence pour le patrimoine militaire et la m\u00e9moire en Belgique. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Real de la Armada e Historia militar (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"El museo posee alrededor de 100.000 objetos(armas, uniformes, maquetas, documentos...), siendo as\u00ed unos de los museos militares m\u00e1s grandes del mundo. Encontrar\u00e1s: una secci\u00f3n de armas y armaduras de la Edad Media, una preciosa colecci\u00f3n del Imperio franc\u00e9s, la Armada belga desde 1831 a 1914 con vitrinas dedicadas al rey Leopoldo l y Leopoldo ll, el desarrollo de la tecnolog\u00eda armament\u00edstica(hacia la mitad del s.XX), la Primera y Segunda Guerra Mundial(uniformes, materiales fotos y documentos), veh\u00edculos armados y barcos de guerra. La secci\u00f3n \"a\u00e9rea\" del museo ofrece una gama completa de aviones, alrededor de 80 son expuestos.\u00a1Y no te pierdas nuestros juegos educativos para todas las \u00e9pocas!. \r\n\r\nLos centros de documentaci\u00f3n est\u00e1n abiertos al p\u00fablico.\r\n\r\nEspectacular vista panor\u00e1mica de la ciudad desde la galer\u00eda.\r\n\r\nLas exposiciones temporales pueden ser de varios temas.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"War Heritage Institute (Koninklijk Legermuseum)","address_street_name":"Jubelpark","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 3","address_line2":"1000 Brussel","description_web":"Meer dan tien eeuwen militaire geschiedenis passeren de revue in dit museum. Je krijgt er een overzicht van de ingrijpende veranderingen die door de jaren heen hebben plaatsgegrepen op het gebied van bewapening en militaire technologie, van de middeleeuwen tot op heden: wapens, harnassen, pantsers, vliegtuigen, uniformen, \u2026\r\n\r\nSinds 1 mei 2017 is het Koninklijk Legermuseum onderdeel van het War Heritage Institute, de nieuwe instelling voor militair erfgoed en herinnering in Belgi\u00eb. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":127,"location":{"lat":50.84086428,"lon":4.39335612},"region":"brussels","last_updated_at":"2023-04-13T11:45:06+02:00","published_at":"2013-10-19T01:13:18+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":555,"translations":{"de":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Mais de dez s\u00e9culos de hist\u00f3ria e de t\u00e9cnicas militares passaram em revista por este museu. A\u00ed encontramos toda a pan\u00f3plia de guerra, da Idade M\u00e9dia \u00e0 \u00e9poca contempor\u00e2nea: armaduras medievais, armas de fogo, avi\u00f5es, carros blindados contempor\u00e2neos, uniformes e penteados militares\u2026\r\nDesde 1 de maio de 2017, o Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar pertence ao War Heritage Institute, a nova institui\u00e7\u00e3o de refer\u00eancia para o patrim\u00f3nio militar e a mem\u00f3ria na B\u00e9lgica.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"War Heritage Institute (Royal Military Museum)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Brussels","description_web":"Here you\u2019ll find medieval armour and souvenirs from the Napoleonic campaigns, as well as a hundred or so aircraft and armoured vehicles from the two Great Wars. A breathtaking panoramic view awaits you at the top of the Arcade.\r\n\r\nSince May 1, 2017 the Royal Military Museum is part of the War Heritage Institute, the new reference institution for military heritage and remembrance in Belgium. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"War Heritage Institute (Mus\u00e9e Royal de l\u2019Arm\u00e9e)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Plus de dix si\u00e8cles d\u2019histoire et de techniques militaires sont pass\u00e9s en revue dans ce mus\u00e9e. On y trouve toute la panoplie de guerre, du Moyen \u00c2ge \u00e0 l\u2019\u00e9poque contemporaine: armures m\u00e9di\u00e9vales, armes \u00e0 feu, avions, blind\u00e9s contemporains, uniformes et coiffures militaires\u2026\r\n\r\nDepuis le 1er mai 2017, le Mus\u00e9e royal de l\u2019Arm\u00e9e appartient au War Heritage Institute, la nouvelle institution de r\u00e9f\u00e9rence pour le patrimoine militaire et la m\u00e9moire en Belgique. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Real de la Armada e Historia militar (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"El museo posee alrededor de 100.000 objetos(armas, uniformes, maquetas, documentos...), siendo as\u00ed unos de los museos militares m\u00e1s grandes del mundo. Encontrar\u00e1s: una secci\u00f3n de armas y armaduras de la Edad Media, una preciosa colecci\u00f3n del Imperio franc\u00e9s, la Armada belga desde 1831 a 1914 con vitrinas dedicadas al rey Leopoldo l y Leopoldo ll, el desarrollo de la tecnolog\u00eda armament\u00edstica(hacia la mitad del s.XX), la Primera y Segunda Guerra Mundial(uniformes, materiales fotos y documentos), veh\u00edculos armados y barcos de guerra. La secci\u00f3n \"a\u00e9rea\" del museo ofrece una gama completa de aviones, alrededor de 80 son expuestos.\u00a1Y no te pierdas nuestros juegos educativos para todas las \u00e9pocas!. \r\n\r\nLos centros de documentaci\u00f3n est\u00e1n abiertos al p\u00fablico.\r\n\r\nEspectacular vista panor\u00e1mica de la ciudad desde la galer\u00eda.\r\n\r\nLas exposiciones temporales pueden ser de varios temas.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"War Heritage Institute (Koninklijk Legermuseum)","address_street_name":"Jubelpark","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 3","address_line2":"1000 Brussel","description_web":"Meer dan tien eeuwen militaire geschiedenis passeren de revue in dit museum. Je krijgt er een overzicht van de ingrijpende veranderingen die door de jaren heen hebben plaatsgegrepen op het gebied van bewapening en militaire technologie, van de middeleeuwen tot op heden: wapens, harnassen, pantsers, vliegtuigen, uniformen, \u2026\r\n\r\nSinds 1 mei 2017 is het Koninklijk Legermuseum onderdeel van het War Heritage Institute, de nieuwe instelling voor militair erfgoed en herinnering in Belgi\u00eb. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":127,"location":{"lat":50.84086428,"lon":4.39335612},"last_updated_at":"2023-04-13T11:45:06+02:00","published_at":"2013-10-19T01:13:18+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/dafc8e6e6ebf8443e7c50b6d1c498b3fedcafde2.jpg","width":1240,"height":1240,"ratio":1,"oEmbed_height":1240,"oEmbed_width":1240,"translations":{"de":{"title":"Expo - \"Des mod\u00e8les r\u00e9duits... canon\"","copyright":null},"pt":{"title":"Expo - \"Des mod\u00e8les r\u00e9duits... canon\"","copyright":null},"en":{"title":"Expo - \"Des mod\u00e8les r\u00e9duits... canon\"","copyright":null},"it":{"title":"Expo - \"Des mod\u00e8les r\u00e9duits... canon\"","copyright":null},"cn":{"title":"Expo - \"Des mod\u00e8les r\u00e9duits... canon\"","copyright":null},"fr":{"title":"Expo - \"Des mod\u00e8les r\u00e9duits... canon\"","copyright":null},"sp":{"title":"Expo - \"Des mod\u00e8les r\u00e9duits... canon\"","copyright":null},"nl":{"title":"Expo - \"Des mod\u00e8les r\u00e9duits... canon\"","copyright":null}}}],"dates":[{"day":"2024-06-28","doors":null,"start":"09:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-29","doors":null,"start":"09:00:00","end":"17:00:00","end_night