":"Brussels Design Market","copyright":null},"nl":{"title":"Brussels Design Market","copyright":null},"en":{"title":"Brussels Design Market","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/e09f55237dc6db585996bd87fa46883ac02dc36e.jpg","width":6000,"height":4000,"ratio":1.5,"translations":{"fr":{"title":"Brussels Design Market","copyright":null},"nl":{"title":"Brussels Design Market","copyright":null},"en":{"title":"Brussels Design Market","copyright":null}}}],"dates":[{"day":"2022-09-24","doors":"09:00:00","start":"09:00:00","end":"12:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-24","doors":"12:00:00","start":"12:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-25","doors":"09:00:00","start":"09:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"VIP"},"nl":{"name":"VIP"},"en":{"name":"VIP"}},"value":25},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":["major_event"],"accessibilities":{"list":[255,261,263,265],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-09T16:05:09+02:00","published_at":"2022-08-22T15:18:00+02:00","backoffice_id":260095,"import_origin":null,"sub_type":"foire","show_in_agenda":true,"ranking":1.2599210498949},{"id":539863,"date_start":"2022-09-24","date_end":"2022-09-24","date_next":"2022-09-24","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Iphig\u00e9nie \u00e0 Splott","shortdescr":null,"longdescr":"Effie habite \u00e0 Splott, un quartier de Cardiff -capitale du Pays de Galles-, min\u00e9 par la fermeture des usines, le ch\u00f4mage et la pr\u00e9carit\u00e9.\r\n\r\nEffie, c\u2019est le genre de fille qu\u2019on \u00e9vite de regarder dans les yeux quand on la croise dans la rue car on a l\u2019impression qu\u2019elle va nous exploser au visage. Effie, on croit la conna\u00eetre, alors on la juge l\u2019air de rien, mais on n\u2019en conna\u00eet pas la moiti\u00e9\u2026\r\n\r\nTous les lundis, elle picole comme une sauvage, se came \u00e0 fond et \u00e9merge au bout de trois jours \"d'une gueule de bois pire que la mort\" pour mieux recommencer. Un personnage de d\u00e9mesure, jusqu\u2019au-boutiste et qu\u2019on croirait sorti d\u2019une trag\u00e9die grecque.\r\n\r\nEt puis, un soir, l\u2019occasion lui est offerte d\u2019\u00eatre autre chose que \u00e7a\u2026\r\n\r\nIphig\u00e9nie \u00e0 Splott a gagn\u00e9 le prix de la meilleure pi\u00e8ce en 2015 aux prestigieux Theatre Awards (Londres). Le texte a \u00e9t\u00e9 lu \u00e0 la Com\u00e9die fran\u00e7aise.\r\n\r\nGeorges Lini signe la mise en sc\u00e8ne de ce texte organique. Trois musiciens rock entourent la com\u00e9dienne et offriront un d\u00e9cor tr\u00e8s \u00ab Guinness and punk are not dead \u00bb.\r\n\r\nTexte de Gary Owen|Traduction Blandine P\u00e9lissier et Kelly Rivi\u00e8re | Mise en sc\u00e8ne Georges Lini | Avec Gwendoline Gauthier | Collaboration artistique S\u00e9bastien Fernandez | Direction musicale Fran\u00e7ois Sauveur | Musiciens Pierre Constant, Julien Lemonnier et Fran\u00e7ois Sauveur | Cr\u00e9ation lumi\u00e8res J\u00e9r\u00f4me Dejean | Costumes Charly Kleinermann et Thibaut De Coster\r\n\r\nPhotographies : Debby Termonia\r\n\r\n\r\nTexte traduit avec le soutien de la Maison Antoine Vitez, Centre international de la traduction th\u00e9\u00e2trale. L\u2019auteur est repr\u00e9sent\u00e9 par MCR Agence Litt\u00e9raire.\r\n\r\nHoraires\r\n\r\nSamedi 24 septembre - 18.00\r\n\r\nInformations\r\n\r\nDur\u00e9e : 1h30\r\n\r\nA partir de 16 ans\r\n\r\nTarifs\r\n\r\nPrix libre et solidaire \u00e0 partir de 3,5 euros. Nous acceptons aussi les Art.27.\r\n\r\nOptez pour une \u00ab impression \u00e0 domicile \u00bb ou t\u00e9l\u00e9chargez votre e-ticket sur votre Smartphone : vous \u00e9viterez les files gr\u00e2ce \u00e0 votre QR Code.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejacquesfranck.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539863"},"nl":{"name":"Iphig\u00e9nie \u00e0 Splott","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539863"},"en":{"name":"Iphig\u00e9nie \u00e0 Splott","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539863"},"de":{"name":"Iphig\u00e9nie \u00e0 Splott","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539863"},"it":{"n