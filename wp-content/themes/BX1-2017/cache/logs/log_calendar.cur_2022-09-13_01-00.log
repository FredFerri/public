yright":null},"nl":{"title":"La Fille du Sacrifice - R\u00e9hab Mehal ","copyright":null},"en":{"title":"La Fille du Sacrifice - R\u00e9hab Mehal ","copyright":null}}}],"dates":[{"day":"2022-09-27","doors":"19:15:00","start":"20:30:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-28","doors":"18:15:00","start":"19:30:00","end":"21:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-29","doors":"13:00:00","start":"13:30:00","end":"15:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-30","doors":"19:15:00","start":"20:30:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-01","doors":"19:30:00","start":"20:30:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-04","doors":"19:15:00","start":"20:30:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-05","doors":"18:15:00","start":"19:30:00","end":"21:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-06","doors":"19:15:00","start":"20:30:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-07","doors":"19:15:00","start":"20:30:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-08","doors":"19:15:00","start":"20:30:00","end":"22:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":12},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":7.5},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":7.5},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":7.5},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":7.5},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"}},"value":7.5},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-04T11:05:05+02:00","published_at":"2022-08-03T13:03:32+02:00","backoffice_id":259247,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.43679023236815},{"id":485238,"date_start":"2022-09-28","date_end":"2022-09-28","date_next":"2022-09-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"The Dears - Perfect Son","shortdescr":"Un r\u00e9sultat \u00e9patant : m\u00e9lange de britpop et de rock aux influences soul et gospel","longdescr":"The Dears: \r\n\r\nPr\u00e8s de 20 ans apr\u00e8s leur formation et 16 ans apr\u00e8s leur premier album, The Dears reprend la route. Habitu\u00e9 \u00e0 assurer la premi\u00e8re partie de Morrissey, \u00e0 la demande sp\u00e9ciale du leader de \u200bThe Smith, le chanteur du groupe dont la voix rappelle celle d\u2019un certain Damon Albarn s\u2019est forg\u00e9 une solide r\u00e9putation en live. Ses musiciens ne sont pas en reste et assurent le show, comme en atteste leur m\u00e9morable passage chez David Letterman en 2011. Quand la britpop fait des petits \u00e0 Montr\u00e9al et que ceux-ci ins\u00e8rent au genre une pointe de gospel, on fr\u00f4le peut-\u00eatre le surr\u00e9alisme mais le r\u00e9sultat est \u00e9patant. \r\n\r\nPerfect Son:\r\n\r\nPerfect Son est le groupe de Tobiasz Bili\u0144ski, musicien polonais faisant anciennement partie de la formation de synthpop, Coldair. Il se lance aujourd\u2019hui en solo et nous pr\u00e9sente \u00ab Cast \u00bb, un premier album sorti chez Sub Pop. Un album de pop sombre et m\u00e9ditatif, sublim\u00e9 par la voix de Tobiasz, expressive et puissante.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.botanique.be","email":"info@botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":"+32 2 218 37 32","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.485238"},"nl":{"name":"The Dears - Perfect Son","shortdescr":"Fijnzinnige indierock met donker stemgeluid","longdescr":"The Dears:\r\n\r\n20 jaar na hun oprichting en 16 jaar na hun eerste album gaan The Dears terug op tourn\u00e9e. Dankzij de stem van de zanger (denk aan Damon Albarn) bouwden ze een stevige live-reputatie waar ook Morrissey van The Smiths voor viel zijn voorprogramma voor openstelde. Deze muzikanten rusten niet op hun lauweren en maken altijd de show, net als bij hun memorable passage in 2011 bij David Letterman. Wanneer de britpop nakomelingen maakt in Montr\u00e9al en er een vleugje gospel in verwerkt, grenst het aan surrealisme maar het resultaat is indrukwekkend.\r\n\r\nPerfect Son :\r\n\r\nPerfect Son is de groep van de Poolse muzikant Tobiasz Bilinski, een gewezen lid van de synthpopgroep Coldair. Voor zijn soloproject tekende hij bij Sub Pop, dat 's mans eerste langspeler 'Cast' uitbrengt. Daarop horen we donkere en meditatieve pop, gedragen door de sterke en expressieve stem van Tobiasz.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.botanique.be","email":"info@botanique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.485238"},"en":{"name":"The Dears - Perfect Son","shortdescr":"Intricate indie rock, carried by intense vocals","longdescr":"The Dears :\r\n\r\nThe  Dears, a critically acclaimed  \u201corchestral-pop-noir-romantique\u201d rock\u2019n\u2019roll band from Montr\u00e9al, is the lifework of Murray A. Lightburn.  Son  of  a  jazzman-turned-preacher, Lightburn\u2019s  attunement  to  songwriting  was  shaped  equally  by nineties rock and a broad tableau of gospel, soul, and pop music. The  band  formed  in  1995  and  released  their  first album, End  of  a  Hollywood Bedtime  Story,  in  2000.  Their  orchestral,  dark  pop  sound  and  dramatic  live shows  cemented  The  Dears  at  the  foundation  of  the  then-emerging Canadian indie renaissance. In 2001 and 2002, they released the EPs Orchestral Pop Noir Romantique and Protest,  respectively,  as  well  as  a  collection  of  unreleased songs, Nor the Dahlias. In 2003 they released their second full-length album No Cities Left, and a string of highly anticipated shows at SxSW \u201904 launched their international career. Gang of Losers was released in 2006, and was well received by the press. \r\n\r\nThe Dears\u2019 music has been described as a cross between The Smiths and Serge Gainsbourg with Lightburn\u2019s singing voice being likened to Morrissey as well as Blur\u2019s Damon Albarn. The complexity of the music and arrangements has also been  compared  to  Radiohead,  Jethro  Tull  and  early  Genesis.  The  Dears\u2019 powerful live shows have been described as: \u201c\u2026the sonic equivalent of seeing the face of God.\u201d Gang  of  Losers was  named  to  the  Short  List  for  the  2007  Polaris  Music  Prize, and  the  follow-up Missiles was  released  in  2008. The  Dears\u2019  fifth  studio album, Degeneration Street, was a Long List nominee for the 2011 Polaris Music Prize. \r\n\r\nPerfect Son:\r\n\r\nSometime in 2016, just as the Polish singer and producer Tobiasz Bili\u0144ski began to find success through the dim and fractured electropop of Coldair, he knew it was time for a radical change. The songs on The Provider, Coldair\u2019s much-lauded third album, had been an exorcism of sorts. Laced with songs about early death, chronic disappointment, and clouded minds, the record was, as he puts it now, his earnest attempt to \u201cget all this old shit out.\u201d That mission accomplished, he needed something new, a restart\u2014the unabashedly radiant and unapologetically complex pop of Perfect Son, delivered in 10 perfect shots on Bili\u0144ski\u2019s Sub Pop debut, Cast.\r\n\r\nPerfect Son, it should be said, is Sub Pop\u2019s first Polish artist, the result of an extended interest in Bili\u0144ski\u2019s work and the country itself from label co-founder Jonathan Poneman. Several years ago, Bili\u0144ski applied to play at South by Southwest as Coldair. Poneman saw his performance, and was impressed. The two stayed in touch, with Poneman eventually signing Coldair to a publishing deal. \u201cI bugged him about releasing my stuff constantly,\u201d Bili\u0144ski admits with a laugh. \u201cAnd I guess he admired my persistence.\u201d","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.485238"},"de":{"name":"The Dears","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.485238"},"it":{"name":"The Dears","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.485238"},"sp":{"name":"The Dears","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.485238"},"pt":{"name":"The Dears","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.485238"},"cn":{"name":"The Dears","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.485238"}},"place":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"L\u2019\u00e9l\u00e9gant Centre Culturel de la Communaut\u00e9 fran\u00e7aise est joliment situ\u00e9 dans les anciens jardins botaniques pr\u00e8s de la petite ceinture de Bruxelles. Vous pouvez assister \u00e0 des concerts dans les espaces intimes \u00e0 l\u2019ambiance chaleureuse, dont  les plus connus sont l\u2019Orangerie, la Rotonde, le Mus\u00e9e et le Witloof Bar. \r\n\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"nl":{"name":"Botanique","address_street_name":"Koningsstraat","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Koningsstraat, 236","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"In de voormalige botanische tuinen aan de kleine ring, thans het klassevolle cultuurcentrum van de Franse Gemeenschap, is het goed toeven. Concerten vinden er plaats op een unieke locatie, in sfeervolle en intieme ruimtes. De kwalitatieve eclectische programmatie staat zeer open voor nieuwe trends.","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"en":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The former botanical gardens provide the unique location for the stylish cultural centre of the French community and are a great place to relax. Concerts are held in the intimate surroundings of its eight spaces and multipurpose halls, of which the most famous are the Orangerie, the Rotonde, the Museum, and the Witloof Bar.\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"de":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le Botanique z\u00e4hlt ohne Zweifel zu den sch\u00f6nsten und spektakul\u00e4rsten Veranstaltungsorten Br\u00fcssels. Das von 1826 bis 1829 von der \u201eSoci\u00e9t\u00e9 Royale d'Horticulture\u201c erbaute, ehemalige Gew\u00e4chshaus im neoklassizistischen Stil mit Eisen- und Glasarchitektur beherbergt seit 1984 einen hochkar\u00e4tigen Veranstaltungsort.\r\n\r\nInmitten des botanischen Gartens von Saint-Josse-ten-Noode, einer der 19 Br\u00fcsseler Gemeinden, w\u00e4chst und gedeiht heute ein quicklebendiger Ort der Kultur, der vor allem f\u00fcr Musikveranstaltungen, als Galerie und Caf\u00e9 genutzt wird. H\u00f6hepunkt des Jahres bildet im Fr\u00fchling das Musikfestival \u201eLes Nuits Botaniques\".","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Questo grande edificio, che doveva ospitare le collezioni di un precedente giardino botanico, \u00e8 stato costruito fra il 1826 ed il 1829. L'artista-arredatore Pierre-Fran\u00e7ois Gineste diresse i lavori secondo progetto dell'architetto Tilman-Fran\u00e7ois Suys. Rispettando la struttura tradizionale degli aranceti, ha immaginato un'imponente cupola rotonda centrale, affiancata da due ali ciascuna delle quali terminante in un padiglione leggermente sporgente. Grazie alla sua regolarit\u00e0 e semplicit\u00e0, la costruzione illustra perfettamente i principi dello stile neoclassico. Alle vetrate che riempiono gli spazi tra le colonne della sala circolare e che coprono il portico delimitato dal colonnato stesso, si aggiungono le serre adiacenti alle ali laterali. Inizialmente si era pensato di organizzare feste all'interno di questo ambiente magico, e a questo scopo venne allestita una grande sala fra l'aranceto orientale e la sala rotonda, ma questa diventer\u00e0 poi la sala degli erbari dal 1870. Fino al 1939, l'edificio verr\u00e0 utilizzato per il suo scopo originale. Riacquistato dallo Stato nel 1970, il locale diventer\u00e0 il Centro Culturale della Federazione Vallonia-Bruxelles e verr\u00e0 inaugurato come tale nel 1984. Oggi ospita numerosi eventi culturali dedicati all'arte contemporanea e vi si svolgono festival, tra i quali il famoso Nuits du Botanique, che hanno contribuito ad affermare la sua reputazione. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Este enorme edificio, pensado para albergar las colecciones de un antiguo jard\u00edn bot\u00e1nico, fue construido entre 1826 y 1829. El artista-decorador Pierre-Fran\u00e7ois Gineste dirigi\u00f3 las obras a partir de los planos del arquitecto Tilman-Fran\u00e7ois Suys. Respetando la estructura tradicional de los invernaderos de naranjas, imagin\u00f3 una imponente rotonda central con c\u00fapula flanqueada por dos pasillos que terminaban en un pabell\u00f3n ligeramente en relieve. Gracias a su regularidad y simplicidad, la elevaci\u00f3n ilustra a la perfecci\u00f3n los principios del estilo neocl\u00e1sico. Las vidrieras situadas en los intercolumnios de la rotonda y que cubren el p\u00f3rtico delimitado por esta misma columnata se suman a los invernaderos adosados a los pasillos laterales. Pronto se pens\u00f3 en organizar fiestas en este lugar m\u00e1gico, para lo cual se acondicion\u00f3 una sala entre el invernadero de naranjas oriental y la rotonda, pero a partir de 1870 se convirti\u00f3 en la sala de los herbarios. Hasta 1939 cumpli\u00f3 las funciones teniendo en cuenta su vocaci\u00f3n inicial. Recomprado por el Estado en 1970, el lugar se convirti\u00f3 en el centro cultural de la Federaci\u00f3n Valonia-Bruselas y se inaugur\u00f3 como tal en 1984. A d\u00eda de hoy este lugar alberga numerosas manifestaciones culturales dedicadas a la creaci\u00f3n contempor\u00e1nea y se ha vuelto prestigioso por los festivales que se celebran en \u00e9l, tales como las \u00abNoches del bot\u00e1nico\u00bb. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[15],"translations":{"fr":["Rogier"],"nl":["Rogier"],"en":["Rogier"]}},"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":"art_center","facebook_id":null,"backoffice_id":5,"location":{"lat":50.85461438,"lon":4.36620044},"region":"brussels","last_updated_at":"2022-08-10T20:36:07+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","a