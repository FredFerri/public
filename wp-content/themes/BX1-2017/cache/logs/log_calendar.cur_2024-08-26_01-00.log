"sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Hors-jeu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011601"},"pt":{"name":"Hors-jeu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011601"},"en":{"name":"Hors-jeu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011601"},"it":{"name":"Hors-jeu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011601"},"cn":{"name":"Hors-jeu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011601"},"fr":{"name":"Hors-jeu","shortdescr":null,"longdescr":"La sc\u00e8ne comme terrain de jeu id\u00e9al pour parler d\u2019amiti\u00e9, d\u2019engagement, de f\u00e9minisme, de foot et de th\u00e9\u00e2tre !\n \nElles se connaissent depuis trente-quatre ans. L\u2019une dit qu\u2019elle est la meilleure amie de l\u2019autre, l\u2019autre juste une bonne copine. L\u2019une est autrice, l\u2019autre est com\u00e9dienne. L\u2019une est fan de foot, l\u2019autre coupe la t\u00e9l\u00e9vision d\u00e8s qu\u2019elle aper\u00e7oit un ballon rond. L\u2019une fait du th\u00e9\u00e2tre pour s\u2019\u00e9vader, l\u2019autre pour d\u00e9noncer. L\u2019une veut r\u00e9aliser le spectacle de sa vie, l\u2019autre le fait en attendant mieux. L\u2019une r\u00eave de Kevin De Bruyne, l\u2019autre de sauver le monde. Aucune des deux ne fera ce qu\u2019elle imaginait.\n \nUn spectacle o\u00f9 on ne sait pas bien ce qui est vrai et ce qui est faux.\nUn spectacle avec Eden Hazard et Michel Lecomte dans leur propre r\u00f4le.\nUn spectacle o\u00f9 Eden parle du sens de la vie et donne des conseils de lecture.\nUn spectacle o\u00f9 Michel sauve le monde en g\u00e9n\u00e9ral et le foot en particulier. Un spectacle qui se passe en Arabie Saoudite lors de la coupe du monde de football 2034.\nUne histoire qui se construit peu \u00e0 peu sous les yeux des spectateurs\nUne odyss\u00e9e qui parle d\u2019amiti\u00e9, d\u2019engagement et, bien s\u00fbr, de foot !\n__________\n\nDe Genevi\u00e8ve Damas \/ Regard ext\u00e9rieur : Aurelio Mergola \/ Avec : Isabelle Defoss\u00e9, Genevi\u00e8ve Damas, et Michel Lecomte \/ Assistant \u00e0 la mise en sc\u00e8ne : Pablo Ministru \/ Sc\u00e9nographie et costumes : Charly Kleinermann et Thibaut De Coster \/ Dramaturgie : Guillemette Laurent \/ Mouvement : Sophie Leso \/ Photos : V\u00e9ronique Wielemans \/ Vid\u00e9o : Hubert Amiel \/ Lumi\u00e8re : Mathieu Bastyns\n__________\n\nUN SPECTACLE DE LA COMPAGNIE ALBERTINE, EN COPRODUCTION AVEC LE TH\u00c9\u00c2TRE LES TANNEURS, LA COOP ASBL ET SHELTER PROD, AVEC LE SOUTIEN DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES, SERVICE DU TH\u00c9\u00c2TRE ET DE LA ROYAL BELGIAN FOOTBALL ASSOCIATION. UN PRODUCTION D\u00c9L\u00c9GU\u00c9E DU TH\u00c9\u00c2TRE LES TANNEURS. AVEC L'AIDE DU TAXSHELTER.BE, ING ET DU TAX SHELTER DU GOUVERNEMENT F\u00c9D\u00c9RAL BELGE. \/ GENEVI\u00c8VE DAMAS EST ARTISTE ASSOCI\u00c9E AU TH\u00c9\u00c2TRE LES TANNEURS.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011601"},"sp":{"name":"Hors-jeu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011601"},"nl":{"name":"Hors-jeu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011601"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Sain