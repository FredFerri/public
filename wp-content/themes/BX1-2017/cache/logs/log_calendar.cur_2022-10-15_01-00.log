0","backoffice_id":262817,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":1},{"id":543043,"date_start":"2022-10-15","date_end":"2022-10-16","date_next":"2022-10-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[55],"translations":{"fr":["Th\u00e9\u00e2tre de marionnettes"],"nl":["Poppentheater"],"en":["Puppet show"],"de":["Puppentheater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Petite Histoire Mordante","shortdescr":"Il faut avoir du chien pour r\u00e9ussir dans ce monde cruel.\r\nGr\u00e2ce \u00e0 une amiti\u00e9 f\u00e9roce, Billy le chien ne baisse jamais les pattes.\r\nDes silhouettes blanches sur fond noir. Un va-et-vient cocasse entre marionnettes et marionnettistes.","longdescr":"L'histoire raconte le v\u00e9cu d\u2019un chien abandonn\u00e9, qui fait tout pour plaire \u00e0 ses ma\u00eetres successifs : l\u2019un maniaque, l\u2019autre violent, une grand-m\u00e8re m\u00e8re-poule... Rien de tr\u00e8s r\u00e9jouissant \u00e0 premi\u00e8re vue, mais le canid\u00e9 a plus d\u2019un tour dans son sac ! Un th\u00e8me s\u00e9rieux dans un univers dr\u00f4le, un va-et-vient amusant entre marionnettes et marionnettistes","performers":"Clair de Lune Th\u00e9\u00e2tre. Com\u00e9diens marionnetttistes Paulo Ferreira, L\u00e9a Brooking","boxoffice_url":null,"website":"http:\/\/www.theatreperuchet.be","email":"info@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543043"},"nl":{"name":"Petite Histoire Mordante","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543043"},"en":{"name":"Petite Histoire Mordante","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543043"},"de":{"name":"Petites Histoires Mordantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543043"},"it":{"name":"Petites Histoires Mordantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543043"},"sp":{"name":"Petites Histoires Mordantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543043"},"pt":{"name":"Petites Histoires Mordantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543043"},"cn":{"name":"Petites Histoires Mordantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543043"}},"place":{"id":241472,"translations":{"fr":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":"Fond\u00e9 en 1929 par Carlo Speder, le P\u00e9ruchet est un th\u00e9\u00e2tre de marionnettes \u00e0 fils qui propose un r\u00e9pertoire unique de contes traditionnels (Andersen, les fr\u00e8res Grimm, Charles Perrault, Daudet, Lafontaine, Kipling, Hoffman...) pour les petits et les grands enfants. Il est situ\u00e9 \u00e0 Ixelles depuis 1968, dans une fermette du 19\u00e8me si\u00e8cle. La l\u00e9gende raconte qu'elle aurait abrit\u00e9 Charles Decoster, l'auteur de Till Ulenspiegel. En 1983, le th\u00e9\u00e2tre s'est dot\u00e9 d'un lieu pour son Mus\u00e9e International de la Marionnette (fond\u00e9 en 1938 et accessible au public jusqu'en 1968), qui poss\u00e8de une collection des plus vari\u00e9es et des plus riches parmi les Mus\u00e9es europ\u00e9ens de la Marionnette. Les spectacles s'adressent aux enfants \u00e0 partir de 3 ans et vous pouvez visiter le mus\u00e9e pendant l'entracte des spectacles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Woudlaan","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Woudlaan, 50","address_line2":"1050 Elsene","description_web":"Het marionettentheater werd in 1929 opgericht in Brussel door Carlo Speder. Le P\u00e9ruchet speelt een uniek repertoire van traditionele sprookjes (Andersen, de gebroeders Grimm, Charles Perrault, Daudet, Lafontaine, Kipling, Hoffman...) voor kinderen... en voor hen die hun kinderhart hebben weten te bewaren. Het theater is sinds 1968 gevestigd in de gemeente Elsene, in een 19e-eeuwse boerderij waar volgens de legende Charles Decoster heeft gewoond (de schrijver van Tijl Ulenspiegel!). In 1983 vond het theater P\u00e9ruchet de middelen om zijn internationaal poppenmuseum in te richten, een van de rijkste en meest gevarieerde collecties in Europa. Je kan het museum bezoeken tijdens de pauzes van de voorstellingen. De voorstellingen zijn geschikt voor kinderen vanaf 3 jaar. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","desc