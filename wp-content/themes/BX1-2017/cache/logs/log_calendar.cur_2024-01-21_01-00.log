ty":false,"is_not_major_event":false,"backoffice_id":278463,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1.0626585691826111,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Juste la fin du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"contact@rideaudebruxelles.be","phone_contact":null,"phone_booking":"+32 2 737 16 00","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558463"},"pt":{"name":"Juste la fin du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"contact@rideaudebruxelles.be","phone_contact":null,"phone_booking":"+32 2 737 16 00","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558463"},"en":{"name":"Juste la fin du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"contact@rideaudebruxelles.be","phone_contact":null,"phone_booking":"+32 2 737 16 00","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558463"},"it":{"name":"Juste la fin du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"contact@rideaudebruxelles.be","phone_contact":null,"phone_booking":"+32 2 737 16 00","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558463"},"cn":{"name":"Juste la fin du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"contact@rideaudebruxelles.be","phone_contact":null,"phone_booking":"+32 2 737 16 00","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558463"},"fr":{"name":"Juste la fin du monde","shortdescr":"La M\u00e8re. - Ils veulent te parler, tout \u00e7a, je les ai entendus mais aussi je les connais, je sais, comment est-ce que je ne saurais pas ?","longdescr":"Le Rideau au Marni\n\nDUREE - 1h50\n\n_______________________________________________________\n\nApr\u00e8s des ann\u00e9es d\u2019absence, Louis, un jeune auteur, revient.\n\nIl veut avertir de sa mort imminente sa m\u00e8re, sa s\u0153ur, son fr\u00e8re et sa belle-s\u0153ur : \"ceux-l\u00e0\" qui habitent toujours la petite ville de son enfance. Mais on devient parfois un \u00e9tranger pour les siens, et les retrouvailles t\u00e2tonnent avec brutalit\u00e9. Volubiles, les personnages tentent difficilement mais r\u00e9solument de s\u2019exprimer un amour immense, parasit\u00e9s par l\u2019indicible d\u2019une fracture sociale, g\u00e9ographique et sexuelle.\n\nJean-Luc Lagarce est mort du sida \u00e0 38 ans. Sa pi\u00e8ce Juste la fin du monde, tout \u00e0 la fois pudique et politique, aborde la maladie en n\u00e9gatif, sans jamais la nommer.\n\nAmoureux de ce texte depuis des lustres, Hugo Favier l\u2019embrasse pour sa premi\u00e8re mise en sc\u00e8ne. Il nous convie \u00e0 une rencontre charnelle avec l\u2019\u00e9criture th\u00e9\u00e2trale. Entre mutisme et lyrisme d\u00e9complex\u00e9, nous assistons \u00e0 une tentative bouleversante et illusoire, la qu\u00eate d\u2019une emprise sur le r\u00e9el avec les mots.\n\nRevenir \u00e0 cette premi\u00e8re soci\u00e9t\u00e9, la famille, cette faune ambivalente que nous connaissons toustes, et en tirer un spectacle dr\u00f4le et \u00e9mouvant sur la difficult\u00e9 de communiquer une \u00e9motion.\n\n_______________________________________________________\n\nAFTER SCENE - Je 25.01 apr\u00e8s la repr\u00e9sentation. Avec l\u2019\u00e9quipe du spectacle.\n\n_______________________________________________________\n\nTexte Jean-Luc Lagarce - Mise en sc\u00e8ne Hugo Favier - Avec Aminata Abdoulaye Hama, Aliz\u00e9e Gaie, Louis Oudenot, Silvio Palomo, Aymeric Trionfo et M\u00e9lanie Zucconi. Assistanat \u00e0 la mise en sc\u00e8ne Annah Schaeffer et Louis Viste \u2013 Lumi\u00e8re et direction technique Alice De Cat - Sc\u00e9nographie Zouzou Leyens - Costumes Laura Ughetto - Composition Louis Oudenot - Cr\u00e9ation son Kevin A.L.F. Jaspar - Mouvement Habib Ben Tanfous - Coaching vocal Rapha\u00eble Gemser - Collaboration dramaturgique Jennifer Cousin - Accompagnatrice Marine Haulot - R\u00e9alisation des costumes et de la sc\u00e9nographie Ateliers du Th\u00e9\u00e2tre de Li\u00e8ge - Photo visuel Elie Carp.\n\nLes Solitaires Intempestifs. 2020\n\nProduction Th\u00e9\u00e2tre de Li\u00e8ge et DC&J Cr\u00e9ation.\nCoproduction facettes asbl, le Rideau et la Filature - sc\u00e8ne nationale de Mulhouse.\nAvec le soutien du Service G\u00e9n\u00e9ral de la Cr\u00e9ation Artistique du minist\u00e8re de la F\u00e9d\u00e9ration Wallonie-Bruxelles, du minist\u00e8re de la Culture (Direction r\u00e9gionale des affaires culturelles du Grand Est), du Tax Shelter du Gouvernement F\u00e9d\u00e9ral de Belgique, Inver Tax Shelter, et L\u2019Organisation.\n\nIncubation via le dispositif SUITCASE par Artist Project d'ILES asbl.\nAccueils en r\u00e9sidences aupr\u00e8s de la compagnie [e]utopia, du Th\u00e9\u00e2tre Oc\u00e9an Nord, du BAMP, de la Maison Qui Chante, du Th\u00e9\u00e2tre Varia et du Rideau.\nRemerciements Camille Bono, Aline Dufour, Edith Depaule, Christine Gr\u00e9goire, H\u00e9lo\u00efse Jadoul, Natacha Nicora, Cl\u00e9ment Thirion, Martine Wijckaert, Isabelle Bats, Simon Pons-Rotbardt.\n\n\n","performers":"Jean-Luc Lagarce \/ Hugo Favier \nLe Rideau au Marni\nCr\u00e9ation - \u00c0 partir de 14 ans ","boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"contact@rideaudebruxelles.be","phone_contact":null,"phone_booking":"+32 2 737 16 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558463"},"sp":{"name":"Juste la fin du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"contact@rideaudebruxelles.be","phone_contact":null,"phone_booking":"+32 2 737 16 00","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558463"},"nl":{"name":"Juste la fin du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"contact@rideaudebruxelles.be","phone_contact":null,"phone_booking":"+32 2 737 16 00","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558463"}},"place":{"id":230487,"translations":{"de":{"name":"Th\u00e9\u00e2tre Marni","address_street_name":"Rue de Vergnies","address_street_number":"25","address_street_box":null,"email":"info@theatremarni.com","website":"http:\/\/www.theatremarni.com","phone_contact":"+32 2 639 09 80","phone_booking":"+32 2 639 09 82","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Vergnies, 25","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre Marni","address_street_name":"Rue de Vergnies","address_street_number":"25","address_street_box":null,"email":"info@theatremarni.com","website":"http:\/\/www.theatremarni.com","phone_contact":"+32 2 639 09 80","phone_booking":"+32 2 639 09 82","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Vergnies, 25","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Marni","address_street_name":"Rue de Vergnies","address_street_number":"25","addr