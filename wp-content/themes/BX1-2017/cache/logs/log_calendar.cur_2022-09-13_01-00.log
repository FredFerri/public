[4,5,7,8,11],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Jeunes 12-15 ans","Jeunes 15-18 ans","Famille"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Jongeren 12-15 j.","Jongeren 15-18 j.","Familie"],"en":["Children 6-9 yr.","Children 9-12 yr.","Youth 12-15  yr.","Youth 15-18  yr.","Family"]}},"tags":["kids"],"accessibilities":{"list":[255,265],"translations":{"fr":["Accessible","WC adapt\u00e9"],"nl":["Toegankelijk","Aangepast toilet"],"en":["Accessible","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-31T18:05:05+02:00","published_at":"2022-06-28T09:33:27+02:00","backoffice_id":257157,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":541135,"date_start":"2022-09-17","date_end":"2022-09-18","date_next":"2022-09-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,37],"translations":{"fr":["Mus\u00e9es et art centers","Arts audiovisuels"],"nl":["Musea en kunstcentra","Audiovisuele kunst"],"en":["Museums and art centers","Audiovisual art"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Tango ya bakoko","shortdescr":"Voyage sonore et photographique au c\u0153ur de l\u2019histoire belgo-congolaise","longdescr":"\"Tango ya bakoko\"\r\n\r\nVoyage sonore et photographique au c\u0153ur de l\u2019histoire belgo-congolaise\r\nEntre r\u00e9cits personnels et m\u00e9moire collective, le podcast Tango ya bakoko, r\u00e9alis\u00e9 par Mansuela Nguizani, vous plongera au temps des a\u00een\u00e9\u00b7es, des Bakokos, pour un voyage sonore et musical dans leurs souvenirs de la p\u00e9riode coloniale et du tournant historique des ind\u00e9pendances africaines des ann\u00e9es 1960. Une immersion dans des voies de transmission singuli\u00e8res\u2026 Pour compl\u00e9ter l\u2019exp\u00e9rience, la photographe Leila Lahbi M expose sa s\u00e9rie de portraits de ces a\u00een\u00e9es qui ont inspir\u00e9 et\/ou ont particip\u00e9 \u00e0 ce podcast.\r\n\r\nQuand ? : Les samedi 17 et dimanche 18 septembre, de 10h \u00e0 17h\r\nVisite libre de l\u2019exposition et \u00e9coute libre des podcasts\r\nO\u00f9 ? : A la Ferme Rose, avenue de Fr\u00e9 44","performers":"Mansuela Nguizani et Leila Lahbi M","boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":"+32 2 605 15 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541135"},"nl":{"name":"Tango ya bakoko","shortdescr":null,"longdescr":"\"Tango ya bakoko\"\r\n\r\nTENTOONSTELLING \"Tango ya bakoko\" \u2b2a\u2b2a\u2b2a\r\n\r\n\"Een klank- en fotografische reis naar het hart van de Belgisch-Congolese geschiedenis\". Van persoonlijke verhalen tot het collectief geheugen dompelt de podcast Tangoya bakoko van Mansuela Nguizani u onder in de tijd van de ouderen, de Bakoko, voor een gesproken en muzikale reis door hun herinneringen aan het koloniaal tijdperk en de historische ommekeer van de Afrikaanse onafhankelijkheden in de jaren '60. Om de ervaring te vervolledigen stelt fotografe Leila Lahbi M haar reeks portretten van deze ouderen voor die deze podcast ge\u00efnspireerd hebben en\/of eraan meegewerkt hebben.\r\n\r\nWanneer? Zaterdag 17 en zondag 18 september 2022 van 10 tot 17 uur\r\nVrij bezoek aan de tentoonstelling en vrij beluisteren van de podcasts.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541135"},"en":{"name":"Tango ya bakoko","shortdescr":null,"longdescr":null,"performers":nul