 le Mus\u00e9e d\u2019Art Fantastique proposera l\u2019exposition collective Balade Reptilienne. De nombreux artistes ont r\u00e9interpr\u00e9t\u00e9 graphiquement des crocodiles en r\u00e9sine mis \u00e0 leur disposition pour l\u2019occasion. Du Crokot\u2019Frit au Croco-timbr\u00e9 venez d\u00e9couvrir ces dr\u00f4les de cr\u00e9atures et visiter la collection atypique du Mus\u00e9e d\u2019Art Fantastique. Un voyage au sein d\u2019un univers fantasque et unique au pays des reptiles f\u00e9\u00e9riques.\r\n\r\nR\u00e9servation ici : https:\/\/www.billetweb.fr\/exposition-balade-reptilienne\r\n\r\nDerni\u00e8re entr\u00e9e 16h.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fantastic-museum.be","email":"infomafcaf@gmail.com","phone_contact":null,"phone_booking":"+32 475 41 29 18","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541459"},"nl":{"name":"Visite du Mus\u00e9e + Exposition Balade Reptilienne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541459"},"en":{"name":"Visite du Mus\u00e9e + Exposition Balade Reptilienne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541459"},"de":{"name":"Visite du Mus\u00e9e + Exposition Balade Reptilienne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541459"},"it":{"name":"Visite du Mus\u00e9e + Exposition Balade Reptilienne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_