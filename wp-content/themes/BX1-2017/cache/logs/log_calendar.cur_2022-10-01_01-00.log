0159ov\u00e1"},"nl":{"title":"#EU2022CZ","copyright":"(c) Dagmar Kne\u0159ov\u00e1"},"en":{"title":"#EU2022CZ","copyright":"(c) Dagmar Kne\u0159ov\u00e1"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/cc9e566ce3c0c1270f614e23171d4054f9b248a7.jpg","width":1500,"height":1000,"ratio":1.5,"translations":{"fr":{"title":"#EU2022CZ","copyright":"(c) Brno"},"nl":{"title":"#EU2022CZ","copyright":"(c) Brno"},"en":{"title":"#EU2022CZ","copyright":"(c) Brno"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/6a25c6e78fb8c308f25394dd461572a6df489125.jpg","width":3456,"height":4608,"ratio":0.75,"translations":{"fr":{"title":"#EU2022CZ","copyright":"(c) Czech Centre Brussels"},"nl":{"title":"#EU2022CZ","copyright":"(c) Czech Centre Brussels"},"en":{"title":"#EU2022CZ","copyright":"(c) Czech Centre Brussels"}}}],"dates":[],"prices":[],"child_events":[536050,536150,536151,536152,536153,536158,536159],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":["major_event"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-22T05:35:22+02:00","published_at":"2022-06-15T11:54:27+02:00","backoffice_id":256045,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.22151546799152},{"id":540191,"date_start":"2022-09-09","date_end":"2023-01-05","date_next":"2023-01-05","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"AND...CUT ! - Spectacle D'improvisation de Catherine Lembr\u00e9e & Alexandre Valancin \u2702\ufe0f","shortdescr":null,"longdescr":"\" AND...CUT !  \"\r\nQu'est ce qu'il se cache derri\u00e8re nos histoires improvis\u00e9es ?\r\n\r\nPour une soir\u00e9e, laissez vous immerger dans l'univers d'une metteuse en sc\u00e8ne proposant au public et aux com\u00e9diennes de lui faire confiance pour proposer une histoire dans un style qui lui est cher.\r\n\r\nLe ou la metteur.euse en sc\u00e8ne, ainsi que le.la r\u00e9gisseur.euse accompagnera les com\u00e9dien.nes par petite touche, proposant mises en sc\u00e8nes formant une grande histoire de 2*40 min.\r\n\r\nEt le pari suppl\u00e9mentaire : certain.nes com\u00e9dien.nes ne se connaissent pas ou n'ont jamais jou\u00e9 ensemble !\r\n\r\n\r\n\r\nAvec Alexandre Valentin & Catherine Lembr\u00e9e\r\n\r\n-------\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\n- Sur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\n- Sur place : 15\u20ac\/personne","performers":"Alexandre Valancin, Catherin Lembr\u00e9e et des invit\u00e9.e.s MAGIQUES !","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540191"},"nl":{"name":"AND...CUT ! - Spectacle D'improvisation de Catherine Lembr\u00e9e & Alexandre Valancin \u2702\ufe0f","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":nul