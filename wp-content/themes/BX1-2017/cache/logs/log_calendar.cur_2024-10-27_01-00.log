":"contact@collauctions.com","phone_contact":"+32 470 82 51 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003029"},"cn":{"name":"Exposition BARA - Max l'explorateur, les aquarelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.collauctions.com","email":"contact@collauctions.com","phone_contact":"+32 470 82 51 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003029"},"fr":{"name":"Exposition BARA - Max l'explorateur, les aquarelles","shortdescr":"Auteur de milliers de comic-strips,  Guy BARA (1923-2003) est surtout connu gr\u00e2ce \u00e0 ses gags muets mettant en sc\u00e8ne l'inimitable Max l\u2019explorateur.\n Max l'explorateur, c\u2019est \u00ab un sourire \u00e0 chaque dessin \u00bb !\nCette exposition est une occasion unique pour d\u00e9couvrir de rares oeuvres in\u00e9dites de cet artiste de g\u00e9nie,  qui sut si bien manier un humour insolite qui se nourrit d'autod\u00e9rision et de po\u00e9sie.","longdescr":"Auteur de milliers de comic-strips, caricaturiste, peintre, Guy BARA (1923-2003) est surtout connu gr\u00e2ce \u00e0 ses gags muets mettant en sc\u00e8ne un petit personnage singulier et malicieux, le fameux Max l\u2019explorateur.\nDepuis sa naissance en 1954 et pendant de tr\u00e8s nombreuses ann\u00e9es, Max \u00e9gaya la presse du monde entier par son humour absurde. \nOn le retrouve, avec la m\u00eame verve, dans des dessins publicitaires, magazines, albums, expositions, animations... \nMax, c\u2019est \u00ab un sourire \u00e0 chaque dessin \u00bb !\nCette exposition organis\u00e9e parall\u00e8lement \u00e0 la vente aux ench\u00e8res online sur Drouot.com est une occasion unique de d\u00e9couvrir cette collection d'exception dont de rares tableaux \u00e0 l'acrylique de cet artiste de g\u00e9nie, inventif et pittoresque, qui sut si bien manier un humour insolite qui se nourrit d'autod\u00e9rision et de po\u00e9sie.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.collauctions.com","email":"contact@collauctions.com","phone_contact":"+32 470 82 51 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003029"},"sp":{"name":"Exposition BARA - Max l'explorateur, les aquarelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.collauctions.com","email":"contact@collauctions.com","phone_contact":"+32 470 82 51 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003029"},"nl":{"name":"Exposition BARA - Max l'explorateur, les aquarelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.collauctions.com","email":"contact@collauctions.com","phone_contact":"+32 470 82 51 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003029"}},"place":{"id":50002573,"translations":{"de":{"name":"Collauctions SRL","address_street_name":"Rue Dejoncker","address_street_number":"34","address_street_box":null,"email":"contact@collauctions.com","website":"www.collauctions.com","phone_contact":"+32 470 82 51 54","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Dejoncker, 34","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Collauctions SRL","address_street_name":"Rue Dejoncker","address_street_number":"34","address_street_box":null,"email":"contact@collauctions.com","website":"www.collauctions.com","phone_contact":"+32 470 82 51 54","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Dejoncker, 34","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_ord