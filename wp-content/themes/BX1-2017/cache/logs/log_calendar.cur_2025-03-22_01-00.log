:57+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317519,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"other","ranking":0.3684031498640387,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Les reliures Art D\u00e9co, entre tradition et modernit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/exposition-capsule-2\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006189"},"pt":{"name":"Les reliures Art D\u00e9co, entre tradition et modernit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/exposition-capsule-2\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006189"},"en":{"name":"Les reliures Art D\u00e9co, entre tradition et modernit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/exposition-capsule-2\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006189"},"it":{"name":"Les reliures Art D\u00e9co, entre tradition et modernit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/exposition-capsule-2\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006189"},"cn":{"name":"Les reliures Art D\u00e9co, entre tradition et modernit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/exposition-capsule-2\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006189"},"fr":{"name":"Les reliures Art D\u00e9co, entre tradition et modernit\u00e9","shortdescr":"Dans cette exposition capsule la Wittockiana met en lumi\u00e8re les reliures Art D\u00e9co de sa collection, comme t\u00e9moins des bouleversements esth\u00e9tiques, culturels et sociaux de leur \u00e9poque, offrant une r\u00e9flexion sur l\u2019\u00e9volution du livre au sein d\u2019un monde en mutation.","longdescr":"\n\nL\u2019Art D\u00e9co, mouvement artistique international n\u00e9 au d\u00e9but du XX si\u00e8cle, s\u2019\u00e9panouit dans les ann\u00e9es 1920 en investissant une multitude de disciplines, de l\u2019architecture aux arts graphiques. H\u00e9ritier des avanc\u00e9es techniques et esth\u00e9tiques du tournant des XIX et XX si\u00e8cles, il se caract\u00e9rise par des motifs g\u00e9om\u00e9triques, des mat\u00e9riaux raffin\u00e9s et une qu\u00eate d\u2019\u00e9quilibre entre tradition et modernit\u00e9.\n\nDans ce contexte de transformation, la place du livre bibliophilique d\u2019inspiration Art D\u00e9co intrigue. Ces reliures luxueuses, qui mobilisent des savoir-faire artisanaux et des mat\u00e9riaux rares, se dressent en contraste avec l\u2019essor de la culture de masse et l\u2019industrialisation croissante de l\u2019\u00e9dition. Elles traduisent une tension entre le statut de l\u2019objet livre comme bien de consommation et sa valorisation en tant qu\u2019\u0153uvre d\u2019art unique.\n\nCette exposition explore ces paradoxes en mettant en lumi\u00e8re les reliures Art D\u00e9co comme t\u00e9moins des bouleversements esth\u00e9tiques, culturels et sociaux de leur \u00e9poque, offrant une r\u00e9flexion sur l\u2019\u00e9volution du livre au sein d\u2019un monde en mutation.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/exposition-capsule-2\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006189"},"sp":{"name":"Les reliures Art D\u00e9co, entre tradition et modernit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/exposition-capsule-2\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006189"},"nl":{"name":"Les reliures Art D\u00e9co, entre tradition et modernit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/exposition-capsule-2\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006189"}},"place":{"id":142,"translations":{"de":{"name":"Wittockiana: Msueum f\u00fcr Buch- und Buchbindekunst","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":"Die Wittockiana wurde 1983 von dem renommierten Buchkenners Michel Wittock gegr\u00fcndet und ist sowohl Buchmuseum a