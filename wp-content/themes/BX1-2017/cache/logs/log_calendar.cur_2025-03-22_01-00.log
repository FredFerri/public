is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T01:01:20+01:00","published_at":"2024-07-03T15:56:26+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303565,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5108729549290354,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Snow th\u00e9rapie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012238"},"pt":{"name":"Snow th\u00e9rapie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012238"},"en":{"name":"Snow th\u00e9rapie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012238"},"it":{"name":"Snow th\u00e9rapie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012238"},"cn":{"name":"Snow th\u00e9rapie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012238"},"fr":{"name":"Snow th\u00e9rapie","shortdescr":null,"longdescr":"Devinette : c\u2019est les vacances, vous \u00eates en famille, en terrasse, au soleil, quand soudain un terrible \u00e9v\u00e9nement risque de vous an\u00e9antir en quelques secondes. Comment r\u00e9agiriez-vous ? D\u2019embl\u00e9e on se dit \u00ab je sauve tout le monde ! \u00bb. Aie ! Rien n\u2019est moins s\u00fbr. O\u00f9 est le sauveur en nous ? Et ce petit moment de panique, a-t-il r\u00e9ellement exist\u00e9 ? Qui l\u2019a remarqu\u00e9 ? Tout le monde aimerait se voir en h\u00e9ros, non ? Mais personne ne peut jurer de rien.\n\nPendant leurs vacances, un incident extraordinaire va venir \u00e9branler une petite famille apparemment fort sympathique.\n\nVoici un thriller en montagne qui entraine dans les m\u00e9andres de l\u2019\u00e2me des protagonistes comme on suivrait l\u2019assassin. Suspens sur fond de relations bourgeoises bien \u00e9duqu\u00e9es, mais terriblement \u00e9branl\u00e9es, car quelque chose est apparu qui n\u2019aurait jamais d\u00fb apparaitre. Une fois pass\u00e9e la stup\u00e9faction, il faut assumer et reprendre la vie\u2026 mais plus jamais comme avant. Et la tension va monter d\u2019un cran.\n\nQuatre artistes, deux femmes, deux hommes vont se pr\u00eater au jeu de la mise \u00e0 nu pour nous offrir le spectacle de nos d\u00e9nis, de nos petites l\u00e2chet\u00e9s et de nos grandes impuissances. Et la fin\u2026 vous appartient.\n__________\n\nDe Ruben \u00d6stlund \/ Adaptation : Jeanne Le Guillou et Bruno Dega \/ Mise en sc\u00e8ne : Val\u00e9rie Lema\u00eetre et Michelangelo Marchese \/ Avec : Val\u00e9rie Lema\u00eetre, Michelangelo Marchese, Fr\u00e9d\u00e9ric Nyssen et Nicole Oliver \/ Assistant \u00e0 la mise en sc\u00e8ne : Pierre Lognay \/ Sc\u00e9nographie : Sofia Dilinos \/ Costumes : Patty Eggerickx \/ Lumi\u00e8re : Alain Collet\n__________\n\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC L'AIDE DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES - DIRECTION DU TH\u00c9\u00c2TRE, ET LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE. Pr\u00e9sent\u00e9 en accord avec Marie C\u00e9cile Renauld, MCRP et Nordiska ApS \u2013 www.nordiska.dk.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012238"},"sp":{"name":"Snow th\u00e9rapie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012238"},"nl":{"name":"Snow th\u00e9rapie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012238"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":nul