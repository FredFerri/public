te_end":"2022-06-26","date_next":"2022-06-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Mus\u00e9e comme chez soi VII \u2013 Quartier Blyckaerts-Malibran","shortdescr":"Mus\u00e9e comme chez soi VII - 10 \u0153uvres s'invitent chez les voisins","longdescr":"Les 25 et 26 juin 2022, 10 habitants de la place Blyckaerts et des rues adjacentes pr\u00e9senteront chez eux une \u0153uvre qu\u2019ils auront choisie parmi les collections du Mus\u00e9e d\u2019Ixelles.\r\nSave the date !\r\n\r\nParcours accessible au public, le dimanche 26 juin de 13 \u00e0 18h.\r\nPoint d\u2019info \u00e0 la Place Blyckaerts : distribution de plans du parcours.\r\n\r\nUn projet du Mus\u00e9e d\u2019Ixelles et de Patrimoine \u00e0 roulettes.\r\n\r\n* Liste des rues participant \u00e0 cette \u00e9dition : www.museedixelles.be","performers":null,"boxoffice_url":null,"website":"https:\/\/www.museedixelles.irisnet.be","email":"musee@ixelles.brussels","phone_contact":null,"phone_booking":"+32 2 515 64 21","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529608.html"},"nl":{"name":"Museum aan huis VII \u2013 Blyckaerts-Malibran-Wijk","shortdescr":"Op 25 en 26 juni 2022 stellen 10 bewoners uit de buurt van het Blyckaertsplein bij hen thuis een kunstwerk uit de collectie van het Museum van Elsene voor.","longdescr":"Op 25 en 26 juni 2022 stellen 10 bewoners uit de buurt van het Blyckaertsplein bij hen thuis een kunstwerk uit de collectie van het Museum van Elsene voor.\r\nSave the date!\r\n\r\nHet Museum aan huis-parcours is voor het publiek toegankelijk op zondag 26 juni van 13 tot 18 uur. \r\nInfopunt: Blyckaertsplein waar u de plattegrond van het parcours ontvangt.\r\n\r\nEen project van het Museum van Elsene en Patrimoine \u00e0 roulettes.\r\n\r\n* Lijst van de straten en huisnummers die voor deze editie in aanmerking komen: www.museumvanelsene.be","performers":null,"boxoffice_url":null,"website":"https:\/\/www.museumvanelsene.irisnet.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529608.html"},"en":{"name":"Mus\u00e9e comme chez soi VII \u2013 Quartier Blyckaerts-Malibran","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529608.html"},"de":{"name":"Mus\u00e9e comme chez soi VII \u2013 25-26.06.2022  Quartier Blyckaerts-Malibran","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529608.html"},"it":{"name":"Mus\u00e9e comme chez soi VII \u2013 25-26.06.2022  Quartier Blyckaerts-Malibran","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529608.html"},"sp":{"name":"Mus\u00e9e comme chez soi VII \u2013 25-26.06.2022  Quartier Blyckaerts-Malibran","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529608.html"},"pt":{"name":"Mus\u00e9e comme chez soi VII \u2013 25-26.06.2022  Quartier Blyckaerts-Malibran","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529608.html"},"cn":{"name":"Mus\u00e9e comme chez soi VII \u2013 25-26.06.2022  Quartier Blyckaerts-Malibran","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529608.html"}},"place":{"id":218736,"translations":{"fr":{"name":"Mus\u00e9e d'Ixelles","address_street_name":"Rue Jean Van Volsem","address_street_number":"71","address_street_box":null,"email":"musee@ixelles.brussels","website":"http:\/\/www.museedixelles.be","phone_contact":"+32 2 515 64 21","phone_booking":"+32 2 515 64 21","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Jean Van Volsem, 71","address_line2":"1050 Ixelles","description_web":"Le Mus\u00e9e d\u2019Ixelles compte une riche collection constitu\u00e9e de plus de 10.000 \u0153uvres datant du XVIe au XXIe si\u00e8cle. Le mus\u00e9e propose un focus particulier sur les XIXe, XXe et XXIe si\u00e8cles, une p\u00e9riode qui correspond \u00e0 celle de l\u2019histoire de la Belgique moderne, avec des artistes comme Rik Wouters, Paul Delvaux, Ren\u00e9 Magritte ou encore Panamarenko. Enfin, relevons la belle collection d\u2019affiches du mus\u00e9e, qui est le seul au monde avec celui d\u2019Albi \u00e0 poss\u00e9der la totalit\u00e9 des affiches du c\u00e9l\u00e8bre Henri de Toulouse-Lautrec. \r\n\r\n\r\n\r\nActuellement ferm\u00e9 pour travaux d'agrandissement et r\u00e9novation:\r\nLe Mus\u00e9e d'Ixelles s'agrandit, se r\u00e9nove, et en profite pour lancer d'importants chantiers d'envergure: inventaire et num\u00e9risation compl\u00e8te des collections, lancement d'un nouveau site internet et reconceptualisation compl\u00e8te du mus\u00e9e en vue de sa r\u00e9ouverture pr\u00e9vue en 2024.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van Elsene","address_street_name":"Jean Van Volsemstraat","address_street_number":"71","address_street_box":null,"email":"musee@ixelles.brussels","website":"http:\/\/www.museumvanelsene.be","phone_contact":"+32 2 515 64 21","phone_booking":"+32 2 515 64 21","address_zip":"1050","address_city":"Elsene","address_line1":"Jean Van Volsemstraat, 71","address_line2":"1050 Elsene","description_web":"Het Museum van Elsene heeft een waardevolle collectie van meer dan 10.000 kunstwerken van de 16de tot de 21ste eeuw. Het museum biedt een bijzondere kijk op de 19de, 20ste en 21ste eeuw, een periode die samenvalt met de geschiedenis van het moderne Belgi\u00eb, met kunstenaars als Rik Wouters, Paul Delvaux, Ren\u00e9 Magritte of Panamarenko. Tot slot bezit het museum ook een mooie collectie affiches, waarvan de volledige collectie affiches van de befaamde Henri de Toulouse-Lautrec.\r\n\r\n\r\n\r\nMomenteel gesloten wegens grote renovatie- en uitbreidingswerkzaamheden:\r\nHet Museum van Elsene breidt uit en renoveert. Het zal van deze gelegenheid gebruik maken om belangrijke en omvangrijke projecten te lanceren: een volledige inventarisatie en digitalisering van de collecties, de lancering van een nieuwe website en een complete reconceptualisering van het museum. \r\nHeropening voorzien in 2024.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of Ixelles","address_street_name":"Rue Jean Van Volsem","address_street_number":"71","address_street_box":null,"email":"musee@ixelles.brussels","website":"http:\/\/www.museumofixelles.be","phone_contact":"+32 2 515 64 21","phone_booking":"+32 2 515 64 21","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Jean Van Volsem, 71","address_line2":"1050 Ixelles","description_web":"The Museum of Ixelles has a unique collection of more than 10.000 works of art from the 16th to the 21st century, with a focus on art of the 19th, the 20st and the 21st century. This period covers the history of modern Belgium, with artists such as Rik Wouters, Paul Delvaux, Ren\u00e9 Magritte or Panamarenko. Last but not least, the museum owns the entire production of lithographic works by the famous artist Henri de Toulouse-Lautrec.\r\nThrough permanent and temporary exhibitions, publications, and educational activities, the Ixelles Museum,\r\nfounded in 1892, pursues a public service mission with the aim of prioritising education and access to its collections. These testify to the artistic and multidisciplinary vocation of the Museum, which is open to any form of creative work. \r\n\r\n\r\n\r\nClosed for renovation:\r\nThe Museum of Ixelles is expanding and renovating, and taking this opportunity to launch major projects: a complete inventory and digitisation of the collections, the launch of a new website and a complete reconceptualisation of the museum in view of its reopening in 2024.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e d'Ixelles","address_street_name":"Rue Jean Van Volsem","address_street_number":"71","address_street_box":null,"email":"musee@ixelles.brussels","website":"http:\/\/www.museumofixelles.be","phone_contact":"+32 2 515 64 21","phone_booking":"+32 2 515 64 21","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Jean Van Volsem, 71","address_line2":"1050 Ixelles","description_web":"Das Museum bietet eine reiche Sammlung mit mehr als 10 000 Werken aus der Zeit zwischen dem 16. und 21. Jahrhundert. Das Museum legte einen besonderen Schwerpunkt auf das 19., 20. und 21. Jahrhundert, d. h. die Zeit der Geschichte des modernen Belgiens mit K\u00fcnstlern wie Rik Wouters, Paul Delvaux, Ren\u00e9 Magritte oder auch Panamarenko. Weiterer H\u00f6hepunkt ist die sch\u00f6ne Plakatsammlung des Museums, die neben Albi als einzige s\u00e4mtliche Plakate des ber\u00fchmten Henri de Toulouse-Lautrec ihr eigen nennen kann.\r\n\r\n\r\n\r\nGeschlossen wegen Renovierung bis 2024","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e d'Ixelles","address_street_name":"Rue Jean Van Volsem","address_street_number":"71","address_street_box":null,"email":"musee@ixelles.brussels","website":"http:\/\/www.museedixelles.be","phone_contact":"+32 2 515 64 21","phone_booking":"+32 2 515 64 21","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Jean Van Volsem, 71","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo de Ixelles","address_street_name":"Rue Jean Van Volsem","address_street_number":"71","address_street_box":null,"email":"musee@ixelles.be","website":"http:\/\/www.museumofixelles.be","phone_contact":"+32 2 515 64 21","phone_booking":"+32 2 515 64 21","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Jean Van Volsem, 71","address_line2":"1050 Ixelles","description_web":"El museo tiene una de las mayores colecciones de p\u00f3steres art\u00edsticos del s. XlX, as\u00ed como casi todos los carteles de Toulouse Lautrec. Esta colecci\u00f3n es completada con exhibiciones del s. XX(Art Deco, Surrealismo...etc). Dos de las salas est\u00e1n dedicadas al arte del s. XVl hasta el s. XVlll. Sin embargo, el museo es m\u00e1s bien conocido por sus colecciones del s. XlX y XX, que ofrecen una visi\u00f3n bastante completa de las diferentes escuelas art\u00edsticas: pre-impresonismo, impresionismo, neo-impresionismo, luminismo, fovismo, simbolismo, expresionismo, surrealismo, constructivismo, j\u00f3venes artistas belgas, el movimiento CoBrA y arte pop.\r\n\r\n\r\n\r\n\r\nCerrado por reformas hasta 2024","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e d'Ixelles","address_street_name":"Rue Jean Van Volse