id":267824,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32363786536193},{"id":538987,"date_start":"2023-01-19","date_end":"2023-03-19","date_next":"2023-01-19","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Ceci n'est pas une histoire","shortdescr":"La version in\u00e9dite !","longdescr":"Au d\u00e9part de ce concept, quelques personnages perdus sur le plateau. C\u2019est qu\u2019ils voudraient bien jouer mais ils ont oubli\u00e9 de prendre avec eux le plus important : une histoire \u00e0 raconter !\r\n\r\nVoil\u00e0 donc qu\u2019ils demandent au public de leur donner le r\u00e9sum\u00e9 d\u2019une histoire bien connue de tous, un conte, une pi\u00e8ce de th\u00e9\u00e2tre, un roman\u2026\r\n\r\nEt puis de l\u00e0\u2026 alternant entre moments de narration et sc\u00e8nes jou\u00e9es, ils vous feront revivre ce r\u00e9cit, dans leur propre style, le temps d\u2019une soir\u00e9e. Enfin\u2026 ce qu\u2019ils en auront compris. Car de toute fa\u00e7on, \u201cCeci n\u2019est pas une Histoire\u201d !","performers":"David Dumont, India Jonckheere, Lo\u00efc Vanden Bemden, Laura Zanatta","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Ceci-n-est-pas-une-Histoire.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538987"}