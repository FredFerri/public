,"end":"14:00:00","is_only_by_appointment":false},"tags":["kids"],"accessibilities":{"list":[252],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking"],"en":["Accessible to people with intellectual disabilities"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten"],"it":["Accessibile alle persone con difficolt\u00e0 di comprensione"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n"],"pt":[null],"cn":[null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T02:36:40+02:00","published_at":"2023-03-14T14:03:55+01:00","backoffice_id":273368,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.15377619196573},{"id":551944,"date_start":"2023-02-17","date_end":"2023-12-31","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{"list":[99],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"],"it":["Cucina"],"sp":["Gastronom\u00eda"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Incroyable experience dans un avion (sans ailes)","shortdescr":"Venez vivre une exp\u00e9rience hors du commun dans un ancien Avion de ligne recycl\u00e9 en salle \u00e9v\u00e8nementielle. Exp\u00e9rience visuelle, gustative et humaine avec un \u00e9quipage aux petits soins.","longdescr":"Cette offre est un forfait particuli\u00e8rement qualitatif cumulant le repas gastronomique 5 services, 3 verres de vins par personne, les caf\u00e9s\/infusions et une s\u00e9ance de 15 minutes au simulateur de vol situ\u00e9 dans le cockpit. Seule le montage vid\u00e9o est en option.\r\n\r\n Le repas se d\u00e9roule \u00e0 bord de l\u2019avion Flylounge qui est \u00e9quip\u00e9 de 6 tables pour 2 \u00e0 6 personnes. Une premi\u00e8re mondiale avec le soutien de la R\u00e9gion de Bruxelles-Capitale et de visit.brussels. Le simulateur de vol est accessible en passant la porte du cockpit.\r\n\r\nPr\u00eat pour partager une exp\u00e9rience inoubliable entre amis? Ne ratez pas cette offre particuli\u00e8rement originale dans un ancien Airbus A319. Lumi\u00e8re l\u00e9g\u00e8rement tamis\u00e9e, ambiance sonore, service premi\u00e8re classe... De quoi combler les plus exigeants et vous faire oublier la morosit\u00e9 ambiante en survolant la terre \u00e0 39.000ft!","performers":"Alain Loiseau, fondateur du Flylounge, concept unique au monde","boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551944"},"nl":{"name":"Ongelooflijke ervaring in een vliegtuig (zonder vleugels)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551944"},"en":{"name":"Incredible experience in a plane (without wings)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551944"},"de":{"name":"Incroyable experience dans un avion (s