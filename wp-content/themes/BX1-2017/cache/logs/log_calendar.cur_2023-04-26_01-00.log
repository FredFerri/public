_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"],"it":["Cabaret"],"sp":["Caf\u00e9 teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"MOJITUS : IMPRO JAM - Jam d'improvisation Organis\u00e9 par les Motus","shortdescr":null,"longdescr":"* MOJITUS : IMPRO JAM *\r\n\r\n\r\nVous \u00caTES improvisateur.ices et vous tournez en rond comme des jouteur.euses au vestiaire en attendant que la saison recommence ?\r\n\r\nVous n'\u00eates PAS improvisateur.ices et vous voulez siroter un spectacle exceptionnel en assistant \u00e0 quelques mojitos maison bien frais?\r\n\r\nLes Motus ont rev\u00eatu leur tenue d'\u00e9t\u00e9 et sont devenus, sous le soleil, LES MOJITUS ! Ils ont cr\u00e9\u00e9 pour vous un concept exclusif: L'IMPROJAM !\r\n\r\nIci, pas besoin de guitare ou de saxophone, juste votre bagage d'impro (confirm\u00e9 ou d\u00e9butant).\r\nComme dans un b\u0153uf musical, vous jouterez avec des personnes que vous ne connaissez probablement pas et venues de tous les horizons, durant des phases de 20 minutes orchestr\u00e9es par un ma\u00eetre de jeu. Impros longues, courtes, libres, cat\u00e9gories... Il y en aura pour tous les go\u00fbts.\r\n\r\nVenez tenter l'exp\u00e9rience ce mercredi 31 ao\u00fbt !\r\nPour les non-improvisateur.ices, venez assister \u00e0 ce spectacle de cl\u00f4ture estival unique !\r\n\r\nHoraire : de 18h30 \u00e0 23h","performers":"Tous les improvisateurs le d\u00e9sirant !","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":null,"phone_contact":"+32 470 50 04 75","phone_booking