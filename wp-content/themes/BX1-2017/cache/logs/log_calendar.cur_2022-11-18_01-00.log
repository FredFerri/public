itle":"Voices of Matongray","copyright":null},"en":{"title":"Voices of Matongray","copyright":null}}}],"dates":[{"day":"2022-11-18","doors":null,"start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":13},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[10,12,8,7,11],"translations":{"fr":["Seniors","LGTBQIA","Jeunes 15-18 ans","Jeunes 12-15 ans","Famille"],"nl":["Senioren","LGTBQIA","Jongeren 15-18 j.","Jongeren 12-15 j.","Familie"],"en":["Seniors","LGTBQIA","Youth 15-18  yr.","Youth 12-15  yr.","Family"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-02T18:05:06+01:00","published_at":"2022-11-02T17:35:43+01:00","backoffice_id":265091,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":539033,"date_start":"2022-11-18","date_end":"2022-11-18","date_next":"2022-11-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,8],"translations":{"fr":["Pop, rock, jazz\u2026","Chanson"],"nl":["Pop, rock, jazz\u2026","Chanson"],"en":["Pop, rock, jazz\u2026","Song"],"de":["Pop, Rock, Jazz...","Chanson"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les Superluettes \u2013 Il est temps de rallumer les \u00e9toiles \u2013 BXL sur Sc\u00e8nes","shortdescr":"Les Superluettes sont de retour de leur tourn\u00e9e intersid\u00e9rale et donnent aujourd\u2019hui leur dernier concert ! Elles entonnent un air h\u00e9ro\u00efque et festif pour galvaniser leur public et surtout... elles-m\u00eames. R\u00e9pertoire issu du patrimoine collectif du rock au classique en passant par le jazz, la pop et les musiques du monde.","longdescr":"Les Superluettes sont de retour de leur tourn\u00e9e intersid\u00e9rale et donnent aujourd\u2019hui leur dernier concert ! Elles entonnent un air h\u00e9ro\u00efque et festif pour galvaniser leur public et surtout... elles-m\u00eames. Lors de leur voyage, elles ont rencontr\u00e9 des mondes et des \u00e9toiles tant\u00f4t \u00e9teintes, tant\u00f4t anim\u00e9es par le feu sacr\u00e9 et baign\u00e9es d\u2019un son magique... LE son de LA source, cet amour infini et inconditionnel duquel tout se cr\u00e9e et se transforme. Fascin\u00e9es par le diapason qui donne le fameux LA, quel ne fut pas leur d\u00e9sarroi quand celui-ci est \u00e9gar\u00e9. Sont-elles perdues ? Entre danse haka, rituel, yoga, gestes sacr\u00e9s et pa\u00efens, elles inventent pas-\u00e0-pas avec le public la \u00ab danse des p\u00e9pites galactiques \u00bb, une danse vivifiante et transformatrice qui ne manquera pas de faire bouger les lignes de tous et de chacun. R\u00e9pertoire issu du patrimoine collectif du rock au classique en passant par le jazz, la pop et les musiques du monde.","performers":"Sarah Kl\u00e9n\u00e8s (danseuse, auteure, compositrice, mezzo-soprano librement \u00e9clectique, arrangeuse); G\u00e9raldine Cozier (auteure, compositrice, soprano coloratur multifacettes, arrangeuse)","boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539033"},"nl":{"name":"Les Superluettes \u2013 Il est temps de rallumer les \u00e9toiles \u2013 BXL sur Sc\u00e8nes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539033"},"en":{"name":"Les Superluettes \u2013 Il est temps de rallumer les \u00e9toiles \u2013 BXL sur Sc\u00e8nes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539033"},"de":{"name":"Les Superluettes \u2013 Il est temps de rallumer les \u00e9toiles \u2013 BXL sur Sc\u00e8nes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539033"},"it":{"name":"Les Superluettes \u2013 Il est temps de rallumer les \u00e9toiles \u2013 BXL sur Sc\u00e8nes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539033"},"sp":{"name":"Les Superluettes \u2013 Il est temps de rallumer les \u00e9toiles \u2013 BXL sur Sc\u00e8nes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539033"},"pt":{"name":"Les Superluettes \u2013 Il est temps de rallumer les \u00e9toiles \u2013 BXL sur Sc\u00e8nes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539033"},"cn":{"name":"Les Superluettes \u2013 Il est temps de rallumer les \u00e9toiles \u2013 BXL sur Sc\u00e8nes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539033"}},"place":{"id":220283,"translations":{"fr":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"Le Jardin de ma S\u0153ur est situ\u00e9 au coin d'une rue du pittoresque March\u00e9 aux poissons, \u00e0 proximit\u00e9 de l\u2019ancien Grand B\u00e9guinage de Bruxelles. On peut difficilement imaginer un nom plus familier. Pourtant, cet endroit n'a pas vol\u00e9 son nom. Vous obtenez exactement ce que vous attendez : une soir\u00e9e sans pr\u00e9tention, pleine de divertissements et de moments partag\u00e9s. Vous vous y sentez comme dans votre salon. Vous oubliez imm\u00e9diatement tous vos soucis et riez, chantez et profitez du spectacle avec les autres participants. Sp\u00e9cialement pour les amateurs de chanson fran\u00e7aise et de th\u00e9\u00e2tre.  \u202f \r\nPensez \u00e0 r\u00e9server votre place !\r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Jardin de ma Soeur","address_street_name":"Op de hoek van de Brandhoutkaai en de Grootgodshuisstraat","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussel","address_line1":"Op de hoek van de Brandhoutkaai en de Grootgodshuisstraat","address_line2":"1000 Brussel","description_web":"Op een straathoek aan de pittoreske Vismarkt ligt Le Jardin de ma Soeur. Een familialere naam kan je haast niet bedenken. Toch heeft deze plek haar naam niet gestolen. Je krijgt exact wat je er zou verwachten: een pretentieloze avond vol vertier en gedeelde momenten. Hier waan je je in een gezellige en veilige woonkamer. Je vergeet er meteen al je zorgen en lacht, zingt en geniet met de andere aanwezigen. Vooral voor liefhebbers van het Franse chanson en verhaaltheater.    \u202f\u202f\u202f ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussels","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Brussels","description_web":"The desire to present theater amongst people; as if a performance is nothing but a conversation, in a place somewhere in between the large halls and the streets, half living room, half pub, in a warm ambiance where one can sip a glass while watching a performance. That's cafe-theater \"Le Jardin de ma Soeur\", at the edge of the ancient \"Grand B\u00e9guinage de Bruxelles\", alongside one of the quays of the old port of Brussels where the spirit of the dock workers lingers and where one can still feel the presence of the beguines with their long black robes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"Dieses malerische Caf\u00e9-Theater, das 1994 in der N\u00e4he des alten \"Grand B\u00e9guinage de Bruxelles\" er\u00f6ffnet wurde, \u00fcberrascht durch seine \u00fcberaus kleinen R\u00e4umlichkeiten. Doch daf\u00fcr ist das Programm ist umso \"gr\u00f6\u00dfer\". Reservierung empfohlen!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"","description_print":"","