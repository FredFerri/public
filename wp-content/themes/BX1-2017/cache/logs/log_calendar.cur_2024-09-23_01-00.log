musical"],"sp":["Teatro musical"],"nl":["Muziektheater"]}}},"translations":{"de":{"name":"Colorature, Mrs. Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ouvrirlesportes.be\/colorature","email":"contact@ouvrirlesportes.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50013227"},"pt":{"name":"Colorature, Mrs. Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ouvrirlesportes.be\/colorature","email":"contact@ouvrirlesportes.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50013227"},"en":{"name":"Colorature, Mrs. Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ouvrirlesportes.be\/colorature","email":"contact@ouvrirlesportes.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50013227"},"it":{"name":"Colorature, Mrs. Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ouvrirlesportes.be\/colorature","email":"contact@ouvrirlesportes.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50013227"},"cn":{"name":"Colorature, Mrs. Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ouvrirlesportes.be\/colorature","email":"contact@ouvrirlesportes.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50013227"},"fr":{"name":"Colorature, Mrs. Jenkins et son pianiste","shortdescr":"Une pi\u00e8ce, sous forme de com\u00e9die, conte la folle obstination de celle qui aurait pu inspirer la Castafiore d\u2019Herg\u00e9. Et rien ne sera chang\u00e9 \u00e0 son destin : de nouveaux et nombreux rires salueront sa m\u00e9moire, car cette pi\u00e8ce de Stephen Temperley, Colorature, Mrs. Jenkins et son pianiste est un grand \u00e9clat de rire. \nLE POINT","longdescr":"New York, 1964. Au piano d\u2019un club de jazz en vogue, Cosme McMoon, pris de nostalgie, \u00e9voque les douze ann\u00e9es de sa singuli\u00e8re collaboration avec la cantatrice Florence Foster Jenkins. Riche h\u00e9riti\u00e8re am\u00e9ricaine dans les ann\u00e9es 30, Florence Foster Jenkins se pique d\u2019art lyrique, s\u2019improvise soprano colorature et inflige aux plus fameux airs un traitement redoutable par sa fausset\u00e9 et ses fantaisies rythmiques. Elle devient pourtant incroyablement populaire au fil de r\u00e9citals et d\u2019enregistrements improbables, sans se douter que son succ\u00e8s n\u2019est pas d\u00fb \u00e0 son talent fantasm\u00e9 mais aux rires que sa voix fausse et son exub\u00e9rance provoquent. De leur rencontre au dernier concert \u00e0 Carnegie Hall, Colorature, Mrs Jenkins et son pianiste nous invitent \u00e0 partager le destin \u00e0 la fois hilarant et bouleversant de deux personnages hors du commun.\n\nApr\u00e8s Un violon sur le toit, Hairspray, Fame, et plus r\u00e9cemment Temp\u00eate en juin et My Fair Lady, St\u00e9phane Laporte, couronn\u00e9 du Prix de l\u2019Adaptateur de th\u00e9\u00e2tre, met en sc\u00e8ne l\u2019une des figures les plus attachantes et populaires de l\u2019histoire contemporaine.","performers":"Avec Agn\u00e8s Bove, Cyril Romoli Pi\u00e8ce de Stephen Temperley Mise en sc\u00e8ne Agn\u00e8s Boury\nAdaptation St\u00e9phane Laporte, Costumes Eymeric Fran\u00e7ois, Lumi\u00e8res Laurent B\u00e9al, D\u00e9cor Claude Plet","boxoffice_url":null,"website":"https:\/\/www.ouvrirlesportes.be\/colorature","email":"contact@ouvrirlesportes.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50013227"},"sp":{"name":"Colorature, Mrs. Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ouvrirlesportes.be\/colorature","email":"contact@ouvrirlesportes.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50013227"},"nl":{"name":"Colorature, Mrs. Jenkins et son pianiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ouvrirlesportes.be\/colorature","email":"contact@ouvrirlesportes.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50013227"}},"place":{"id":266765,"translations":{"de":{"name":"Ouvrir les portes ","address_street_name":"Rue de Verrewinkel","address_street_number":"79","address_street_box":null,"email":null,"website":"http:\/\/www.ouvrirlesportes.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Rue de Verrewinkel, 79","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Ouvrir les portes ","address_street_name":"Rue de Verrewinkel","address_street_number":"79","address_street_box":null,"email":null,"website":"http:\/\/www.ouvrirlesportes.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Rue de Verrewinkel, 79","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Ouvrir les portes ","address_street_name":"Rue de Verrewin