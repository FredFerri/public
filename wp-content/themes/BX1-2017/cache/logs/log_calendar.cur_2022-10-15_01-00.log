-06","date_end":"2022-10-30","date_next":"2022-10-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Exposition \/\/\/ Retrospective \/\/\/ Thierry Dussac","shortdescr":null,"longdescr":"RETROSPECTIVE - THIERRY DUSSAC SOLO EXHIBITION et MONOGRAPHIE\r\n\r\nVous aurez le privil\u00e8ge de d\u00e9couvrir et d'acqu\u00e9rir en exclusivit\u00e9 sa nouvelle monographie qui retrace plus de 30 ans de cr\u00e9ation.\r\n\r\nL\u2019\u0153uvre de Dussac est intimement li\u00e9e \u00e0 sa vie. Le peintre, dans sa recherche picturale et l\u2019homme dans son parcours de vie sont indissociables. L\u2019un n\u2019existerait pas sans l\u2019autre et inversement. Cette qu\u00eate de libert\u00e9, d\u2019absolu, d\u2019absolution avant le n\u00e9ant, appartientautant au cr\u00e9ateur qu\u2019\u00e0 l\u2019homme.\r\n\r\n___ Exposition ___\r\n\r\n06.10.2022 au 30.10.2022\r\nDe 11h \u00e0 18h\r\n\r\nInstitut Fran\u00e7ais des Arts\r\nRue Haute 195\r\n1000 Bruxelles","performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/institutfrancaisdesarts","email":"institutfrancaisdesarts@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542829"},"nl":{"name":"Exposition \/\/\/ Retrospective \/\/\/ Thierry Dussac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"webs