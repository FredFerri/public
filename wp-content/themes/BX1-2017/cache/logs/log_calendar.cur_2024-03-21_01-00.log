e,"is_soldout":false,"last_updated_at":"2024-02-23T16:15:05+01:00","published_at":"2024-02-23T11:25:45+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":295315,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[104],"translations":{"de":["Jugendstil, Art d\u00e9co"],"pt":[null],"en":["Art Nouveau, Art D\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"cn":[null],"fr":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Winnens house","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007659"},"pt":{"name":"BANAD Festival - Guided tour of the Winnens house","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007659"},"en":{"name":"BANAD Festival - Guided tour of the Winnens house","shortdescr":"As part of the BANAD Festival, come and discover the Winnens house. A bourgeois house with modernist facades and a characteristic Art Deco interior. ","longdescr":"\nAt the end of the 1920s, the architect Alfred Nyst built this bourgeois house with an austere, yet elegant, Modernist fa\u00e7ade on the corner of the Vergote Square. From the outside, and in addition to being round, the terrace with its star shape is particularly remarkable. Inside, we find ourselves in a very characteristic Art Deco interior, perfectly balancing functionality and sophistication. Both by its clear formal language and the fact that it features various architectural trends, the Winnens House is most representative of a fascinating period in the history of Brussels architecture. This is the oldest Modernist building one can visit during the BANAD Festival.","performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007659"},"it":{"name":"BANAD Festival - Guided tour of the Winnens house","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007659"},"cn":{"name":"BANAD Festival - Guided tour of the Winnens house","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007659"},"fr":{"name":"BANAD Festival - Visite guid\u00e9e de la maison Winnens","shortdescr":"Dans le cadre du BANAD Festival, venez d\u00e9couvrir la maison Winnens. Une maison bourgeoise au fa\u00e7ades modernistes et \u00e0 l'int\u00e9rieur Art D\u00e9co caract\u00e9ristique. ","longdescr":"\u00c0 la fin des ann\u00e9es 1920, l'architecte Alfred Nyst a construit cette maison bourgeoise au fa\u00e7ades modernistes aust\u00e8res mais \u00e9l\u00e9gantes \u00e0 l'angle de la Square Vergote. \u00c0 l'ext\u00e9rieur, outre sa forme ronde prononc\u00e9e, la terrasse \u00e0 motif \u00e9toil\u00e9 est particuli\u00e8rement remarquable. \u00c0 l'int\u00e9rieur, nous trouvons un int\u00e9rieur Art D\u00e9co tr\u00e8s caract\u00e9ristique, \u00e9quilibrant parfaitement la fonctionnalit\u00e9 et la sophistication. De par son langage formel clair et le fait qu'elle r\u00e9v\u00e8le diverses tendances architecturales, la maison Winnens est tr\u00e8s repr\u00e9sentative d'une p\u00e9riode fascinante de l'histoire de l'architecture bruxelloise ; il s'agit du plus ancien b\u00e2timent moderniste que l'on puisse visiter durant le BANAD Festival.","performers":"Explore.Brussels asbl-vzw","boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007659"},"sp":{"name":"BANAD Festival - Guided tour of the Winnens house","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007659"},"nl":{"name":"BANAD Festival - Rondleiding in de woning Winnens","shortdescr":"Kom in het kader van het BANAD Festival het Winnenshuis ontdekken. Een burgerlijk huis met modernistische gevels en een karakteristiek Art Deco interieur. ","longdescr":"Eind jaren 1920 al bouwde architect Alfred Nyst dit sobere maar elegante burgerhuis op de hoek van het Vergotesquare. De woning is daarmee het oudste modernistische gebouw dat tijdens het BANAD Festival te bezoeken valt. Aan de buitenkant valt naast de uitgesproken ronde vorm vooral het mooie terras met stermotief op; binnenin treffen we een zeer karakteristieke art-deco-inrichting aan, die perfect de balans vindt tussen functionaliteit en verfijning. Door haar heldere vormentaal en het feit dat ze verschillende architecturale tendensen zichtbaar maakt, is Woning Winnens zeer representatief voor een ongemeen boeiende periode uit de Brusselse architectuurgeschiedenis.","performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007659"}},"place":{"id":50001230,"translations":{"de":{"name":"Maison Winnens","address_street_name":"Square Vergote","address_street_number":"16","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Square Vergote, 16","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Winnens","address_street_name":"Square Vergote","address_street_number":"16","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Square Vergote, 16","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Winnens house","address_street_name":"Vergotesquare","address_street_number":"16","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Vergotesquare, 16","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Winnens","address_street_name":"Square Vergote","address_street_number":"16","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":