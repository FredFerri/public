hone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003331"},"en":{"name":"Les contes de la chariotte, un conte d'objets par H\u00e9l\u00e8ne D\u00e9sirant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/les-contes-de-la-chariotte\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003331"},"it":{"name":"Les contes de la chariotte, un conte d'objets par H\u00e9l\u00e8ne D\u00e9sirant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/les-contes-de-la-chariotte\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003331"},"cn":{"name":"Les contes de la chariotte, un conte d'objets par H\u00e9l\u00e8ne D\u00e9sirant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/les-contes-de-la-chariotte\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003331"},"fr":{"name":"Les contes de la chariotte, un conte d'objets par H\u00e9l\u00e8ne D\u00e9sirant","shortdescr":"Des jouets oubli\u00e9s se d\u00e9posent sur le bois de la sc\u00e8ne et livrent leurs mots. Comme les images d\u2019un livre, \u00e0 travers la voix de la conteuse, ils disent les contes. Partant de contes traditionnels, H\u00e9l\u00e8ne D\u00e9sirant anime un spectacle de contes d\u2019objets pour faire r\u00eaver les petits comme les grands.","longdescr":"Il y avait une vache. Sur la vache, il y avait une chaise. Sur la chaise, une maison. Il y avait un gar\u00e7on qui tirait une chariotte remplie de bo\u00eetes. \n\n\u00ab Les contes de la chariotte, les contes de la chariotte, qui veut une histoire, qui veut une histoire? \u00bb \n\nPartant de contes traditionnels, H\u00e9l\u00e8ne D\u00e9sirant anime un spectacle de contes d\u2019objets pour faire r\u00eaver les petits comme les grands.\n\nDimanche 24 novembre \u00e0 14h\nDur\u00e9e : 40 minutes \nPour toute la famille, \u00e0 partir de 5 ans \nInfo + r\u00e9servations : https:\/\/ccbruegel.be\/programme\/les-contes-de-la-chariotte\/ \n\n","performers":"H\u00e9l\u00e8ne D\u00e9sirant (conteuse d'objets)","boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/les-contes-de-la-chariotte\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003331"},"sp":{"name":"Les contes de la chariotte, un conte d'objets par H\u00e9l\u00e8ne D\u00e9sirant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/les-contes-de-la-chariotte\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003331"},"nl":{"name":"Les contes de la chariotte, un conte d'objets par H\u00e9l\u00e8ne D\u00e9sirant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/les-contes-de-la-chariotte\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003331"}},"place":{"id":249303,"translations":{"de":{"name":"Les Dimanches du conte","address_street_name":"Rue des Renards","address_street_number":"1F","address_street_box":null,"email":"info@dimanchesduconte.be","website":"http:\/\/www.dimanchesduconte.be","phone_contact":"+32 485 67 10 89","phone_booking":null,"address_zip":"1000","address_city":"Bru