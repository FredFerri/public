posant une narration neuve.\r\nEn Partenariat avec l\u2019ARC \u2013 Action et Recherche Culturelles, l'Habitat Riga et le Festival S.A.M.E.\r\n\r\nINFOS PRATIQUES\r\nD\u00e9but : 19h15 - dur\u00e9e 50min + temps d'\u00e9change\r\nR\u00e9servations indispensables\r\nAccessible PMR\r\nTraduction en langue des signes\r\nPrix libre\r\nA partir de 10 ans","performers":"Evelyne Devuyst et Christine Horman","boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":"+32 497 78 20 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550653"},"nl":{"name":"Histoires de bossu\u00b7es et autres corps tordus \/ spectacle cont\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":"+32 497 78 20 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550653"},"en":{"name":"Histoires de bossu\u00b7es et autres corps tordus \/ spectacle cont\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":"+32 497 78 20 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550653"},"de":{"name":"Histoires de bossu\u00b7es et autres corps tordus \/ spectacle cont\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":"+32 497 78 20 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550653"},"it":{"name":"Histoires de bossu\u00b7es et autres corps tordus \/ spectacle cont\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"