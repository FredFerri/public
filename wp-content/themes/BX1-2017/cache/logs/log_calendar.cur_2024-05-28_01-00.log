origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.28543716208189446,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"SansMOTdire. Binding & joke. Alain Briand's Book-Objects","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010764"},"pt":{"name":"SansMOTdire. Binding & joke. Alain Briand's Book-Objects","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010764"},"en":{"name":"SansMOTdire. Binding & joke. Alain Briand's Book-Objects","shortdescr":"We invite you to discover the poetic universe of Alain Briand, a French bookbinder fond of Moli\u00e8re's language through a collection of approximately thirty whimsical and unconventional books as objects.","longdescr":"We invite you to discover the poetic universe of a French bookbinder fond of Moli\u00e8re's language through a collection of approximately thirty whimsical and unconventional books as objects.\n\nAlain Briand embraces the Surrealistic art of incongruity by adopting the interplay between words and images, through unexpected shifts, wittiness, playfulness, and poetry. Imbued with this ethos, his creations follow in the wake of the grand avant-garde movements of the 20th century.\nSometimes conceived as reading supports, sometimes as \u201cobjects\u201d in their own right, they can embody an artistic concept, materialise a personal view or become a whole original artwork. By introducing the practice of binding into artistic creation in a subtle and unexpected way, Alain Briand offers us the opportunity to discover, through his technical mastery, a neglected know-how.\nHis books as objects, atypical and rare in the contemporary artistic scene, are presented for the first time in Brussels, to mark the year of Surrealism in Brussels.\n\nAn \u201cantidote\u201d to gloominess and boredom, this exhibition is both a celebration of the spirit, and a tribute to craftsmanship.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010764"},"it":{"name":"SansMOTdire. Binding & joke. Alain Briand's Book-Objects","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010764"},"cn":{"name":"SansMOTdire. Binding & joke. Alain Briand's Book-Objects","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010764"},"fr":{"name":"SansMOTdire. Reliure & fac\u00e9tie. Les livres-objets d'Alain Briand","shortdescr":"\u00c0 travers une trentaine de livres-objets, insolites et ludiques, se d\u00e9voile l\u2019univers po\u00e9tique de l'artiste-relieur amoureux de la langue fran\u00e7aise, Alain Briand.","longdescr":"\u00c0 travers une trentaine de livres-objets, insolites et ludiques, se d\u00e9voile l\u2019univers po\u00e9tique d\u2019un artiste-relieur amoureux de la langue fran\u00e7aise.\nAlain Briand cultive l\u2019art du d\u00e9calage, propre au Surr\u00e9alisme: le d\u00e9tournement, l\u2019humour, le jeu, la po\u00e9sie, la tension et l\u2019interaction entre les mots et les images. Impr\u00e9gn\u00e9es de cet esprit, ses r\u00e9alisations s\u2019inscrivent dans le sillage des grands mouvements avant-gardistes du XXe si\u00e8cle. Tant\u00f4t con\u00e7ues comme objets de lecture, tant\u00f4t comme \u00abobjets\u00bb proprement dits, elles peuvent illustrer un concept artistique, mat\u00e9rialiser une vision personnelle ou devenir un \u0153uvre totale originale. En introduisant de fa\u00e7on subtile et inattendue la pratique de la reliure dans la cr\u00e9ation artistique, Alain Briand nous offre l\u2019opportunit\u00e9 de d\u00e9couvrir par sa ma\u00eetrise technique un savoir-faire m\u00e9connu. \nAtypiques dans le paysage artistique d\u2019aujourd\u2019hui, ses livres-objets sont pr\u00e9sent\u00e9s pour la premi\u00e8re fois \u00e0 Bruxelles, \u00e0 l\u2019occasion de l\u2019ann\u00e9e du Surr\u00e9alisme \u00e0 Bruxelles. \n\nUne exposition \u00abantidote\u00bb \u00e0 la morosit\u00e9 et \u00e0 l\u2019ennui, une f\u00eate de l\u2019esprit, un \u00e9loge au savoir-faire. \n","performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010764"},"sp":{"name":"SansMOTdire. Binding & joke. Alain Briand's Book-Objects","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010764"},"nl":{"name":"SansMOTdire. Binding & Grapje: De Boekobjecten van Alain Briand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010764"}},"place":{"last_updated_at":"2024-05-16T14:58:22+02:00","published_at":"2024-05-16T14:58:22+02:00","id":50001742,"translations":{"de":{"name":"Association du Patrimoine artistique","address_street_name":"Rue Charles Hanssens","address_street_number":"7","address_street_box":null,"email":"as.part.art@gmail.com","website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Charles Hanssens, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Association du Patrimoine artistique","address_street_name":"Rue Charles Hanssens","address_street_number":"7","address_street_box":null,"email":"as.part.art@gmail.com","website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Charles Hanssens, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,