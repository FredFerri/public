l,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"Un Vieux Conte \u00e0 R\u00e9gler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/un-vieux-conte-a-regler\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004973"},"pt":{"name":"Un Vieux Conte \u00e0 R\u00e9gler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/un-vieux-conte-a-regler\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004973"},"en":{"name":"Un Vieux Conte \u00e0 R\u00e9gler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/un-vieux-conte-a-regler\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004973"},"it":{"name":"Un Vieux Conte \u00e0 R\u00e9gler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/un-vieux-conte-a-regler\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004973"},"cn":{"name":"Un Vieux Conte \u00e0 R\u00e9gler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/un-vieux-conte-a-regler\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004973"},"fr":{"name":"Un Vieux Conte \u00e0 R\u00e9gler","shortdescr":"Un jour, une temp\u00eate a surgi. Impr\u00e9visible, comme la vie peut l\u2019\u00eatre.\nLa nuit devint trop noire, le jour trop clair, le sol sembla avoir disparu...\n","longdescr":"Un jour, une temp\u00eate a surgi. Impr\u00e9visible, comme la vie peut l\u2019\u00eatre.\nLa nuit devint trop noire, le jour trop clair, le sol sembla avoir disparu.\nQue reste-t-il alors, quand il ne reste rien ?\nIl m\u2019est rest\u00e9 ma voix, il m\u2019est rest\u00e9 mes mains,\net ces mots et m\u00e9lodies qui jaillissent pour traduire le vertige, l\u2019errance, l\u2019espoir, le deuil, l\u2019amour, et l\u2019\u00e9merveillement de la vie qui revient l\u00e0 o\u00f9 l\u2019on s\u2019y attend le moins.\n\nLe nouveau projet musical de Julie Chemin est compos\u00e9 d\u2019une quinzaine de chansons \u00e9crites tout le long de la travers\u00e9e de sa temp\u00eate.\nLa langue  \u2013 le fran\u00e7ais \u2013  y est organique, cr\u00fbe et douce, lumineuse, limpide.\nLes mots font plonger chacun.e au plus profond, jusqu\u2019\u00e0 cet endroit o\u00f9 tous les \u00eatres se ressemblent.\nRice Trio \/ Un Vieux conte \u00e0 r\u00e9gler\nJulie Chemin : voix, clavier, texte, musique & arrangements\nMartin Chemin : percussions & arrangements\nS\u00e9bastien Willemyns : violon alto & arrangements\n\nNous sommes trois musiciens r\u00e9unis autour de cette mati\u00e8re : Martin Chemin aux percussions, S\u00e9bastien Willemyns \u00e0 l\u2019alto et Julie Chemin au clavier et au chant.\nDe r\u00e9p\u00e9titions en concerts, que nous abordons comme des laboratoires, le r\u00e9pertoire prend forme, les chansons prennent le large gr\u00e2ce \u00e0 l\u2019\u00e9coute du public, l\u2019humour vient se glisser dans la gravit\u00e9.\nEt des parties instrumentales, \u00e0 danser ou \u00e9couter, s\u2019ajoutent et font appara\u00eetre les paysages d\u2019envergure de cette nouvelle aventure.","performers":"Julie Chemin : voix, clavier, texte, musique & arrangements; Martin Chemin : percussions & arrangements; S\u00e9bastien Willemyns : violon alto & arrangements","boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/un-vieux-conte-a-regler\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004973"},"sp":{"name":"Un Vieux Conte \u00e0 R\u00e9gler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/un-vieux-conte-a-regler\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004973"},"nl":{"name":"Un Vieux Conte \u00e0 R\u00e9gler","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/un-vieux-conte-a-regler\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004973"}},"place":{"id":390,"translations":{"de":{"name":"L'Entrela' - Centre Culturel d'Evere","address_street_name":"Rue de Paris","address_street_number":"43","address_street_box":null,"email":"info@lentrela.be","website":"http:\/\/www.lentrela.be\/","phone_contact":"+32 2 241 15 83","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue de Paris, 43","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"L'Entrela' - Centre Culturel d'Evere","address_street_name":"Rue de Paris","address_street_number":"43","address_street_box":null,"email":"info@lentrela.be","website":"http:\/\/www.lentrela.be\/","phone_contact":"+32 2 241 15 83","phone_booking":null