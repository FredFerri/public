Lorent"}}}],"dates":[{"day":"2022-11-19","doors":"19:30:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":12},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":10},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":8},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"}},"value":8},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T22:05:33+02:00","published_at":"2022-08-31T12:01:31+02:00","backoffice_id":260721,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":541721,"date_start":"2022-11-19","date_end":"2022-11-19","date_next":"2022-11-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"MARA DOBRESCO - Piano & Musique de Chambre \/\/ \"Schubertiade\" des temps moderne)","shortdescr":"Lou\u00e9e pour son temp\u00e9rament et l\u2019\u00e9l\u00e9gance de son phras\u00e9, la pianiste Mara Dobresco joue \u00e0 travers le monde entier. Elle fait escale dans notre salon le temps d'une soir\u00e9e plac\u00e9e sous le signe du partage. Quoi de mieux alors que les mots de l'artiste pour \u00e9voquer ce concert ?","longdescr":"Apr\u00e8s deux saisons tonitruantes avec pr\u00e8s d'une dizaine d'\u00e9v\u00e8nements sold-out dans son salon, le Jardin Musical est heureux de vous annoncer le d\u00e9marrage de sa nouvelle s\u00e9rie de concerts Automne 2022.\r\n\r\nLou\u00e9e pour son temp\u00e9rament et l\u2019\u00e9l\u00e9gance de son phras\u00e9, la pianiste Mara Dobresco joue \u00e0 travers le monde entier. Elle fait escale dans notre salon le temps d'une soir\u00e9e plac\u00e9e sous le signe du partage. Quoi de mieux alors que les mots de l'artiste pour \u00e9voquer ce concert ?\r\n\r\n\"Nous allons ouvrir ensemble quelques fen\u00eatres vers le monde de la nuit, qui m\u2019est si cher, celui du silence, de la lumi\u00e8re et de l\u2019espoir, dans un programme qui vous sera d\u00e9voil\u00e9 le soir m\u00eame\u2026comme dans les Schubertiades d\u2019antan.\" MARA DOBRESCO\r\n\r\nLe Jardin Musical:\r\nQuai aux briques 62, 1000 Bruxelles\r\ninfo@jardinmusical.org\r\n+32 456 04 35 05","performers":"MARA DOBRESCO Piano et Musique de Chambre","boxoffice_url":null,"website":"https:\/\/www.jardinmusical.org\/","email":"press@sophiecarree.be","phone_contact":"+32 456 04 35 05","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541721"},"nl":{"name":"MARA DOBRESCO (Piano en Kamermuziek \/ \"Schubertiade\" van de moderne tijd)","shortdescr":"Geprezen voor haar temperament en voor de elegantie van haar musikaal oeuvre, reist pianiste Mara Dobresco over de hele wereld. Ze doet ons het genoegen om een avond halt te houden in ons salon om haar talent met ons te delen. Wie zou dan beter de artiste zelf haar concert kunnen verwoorden?","longdescr":"Na twee daverende seizoenen met een tiental uitverkochte muzikale evenementen, verheugt de \u201cJardin Musical\u201d zich de start aan te kondigen van haar programmatie voor het herfstseizoen 2022.\r\n\r\nGeprezen voor haar temperament en voor de elegantie van haar musikaal oeuvre, reist pianiste Mara Dobresco over de hele wereld. Ze doet ons het genoegen om een avond halt te houden in ons salon om haar talent met ons te delen. Wie zou dan beter de artiste zelf haar concert kunnen verwoorden?\r\n\r\n\"Laten we samen een paar vensters openen naar de wereld van de nacht, die me zo dierbaar is, de nacht van de stilte, van licht en hoop, in een programma dat diezelfde avond zal worden onthuld ... net zoals in de Schubertiades van weleer.\" MARA DOBRESCO\r\n\r\nLe Jardin Musical:\r\nQuai aux briques 62, 1000 Brussels\r\ninfo@jardinmusical.org\r\n+32 456 04 35 05","performers":"MARA DOBRESCO Piano en Kamermuziek","boxoffice_url":null,"website":null,"email":"info@jardinmusical.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541721"},"en":{"name":"MARA DOBRESCO (Piano & Chamber Music \/ \"Schubertiade\" of modern times)","shortdescr":"Praised for her temperament and elegant phrasing, pianist Mara Dobresco plays all over the world. She will stop by our \"salon\" for an evening of sharing. What could be better than the words of the artist to evoke this concert?","longdescr":"After two thunderous seasons with nearly a dozen sold-out events in its salon, Jardin\r\nMusical is pleased to announce the launch of its new Fall 2022 concert series.\r\n\r\nPraised for her temperament and elegant phrasing, pianist Mara Dobresco plays all over the world. She will stop by our \"salon\" for an evening of sharing. What could be better than the words of the artist to evoke this concert?\r\n\r\n\"We are going to open together some windows towards the world of the night, which is so dear to me, that of the silence, the light and the hope, in a program which will be revealed to you on the same evening... as in the Schubertiades of former days.\" MARA DOBRESCO\r\n\r\nLe Jardin Musical:\r\nQuai aux briques 62, 1000 Brussels\r\ninfo@jardinmusical.org\r\n+32 456 04 35 05","performers":"MARA DOBRESCO Piano & Chamber Music","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541721"},"de":{"name":"MARA DOBRESCO - Piano & Musique de Chambre \/\/ \"Schubertiade\" des temps moderne)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541721"},"it":{"name":"MARA DOBRESCO - Piano & Musique de Chambre \/\/ \"Schubertiade\" des temps moderne)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541721"},"sp":{"name":"MARA DOBRESCO - Piano & Musique de Chambre \/\/ \"Schubertiade\" des temps moderne)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541721"},"pt":{"name":"MARA DOBRESCO - Piano & Musique de Chambre \/\/ \"Schubertiade\" des temps moderne)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541721"},"cn":{"name":"MARA DOBRESCO - Piano & Musique de Chambre \/\/ \"Schubertiade\" des temps moderne)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.bru