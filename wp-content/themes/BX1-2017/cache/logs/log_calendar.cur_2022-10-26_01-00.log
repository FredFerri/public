ild_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[321],"translations":{"fr":["Bande Dessin\u00e9e"],"nl":["Stripverhaal"],"en":["Comic strip"],"de":["Comic"]}},"tags":[],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-24T01:08:39+02:00","published_at":"2022-07-01T13:35:24+02:00","backoffice_id":257542,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.39480460674971},{"id":542597,"date_start":"2022-10-25","date_end":"2022-11-10","date_next":"2022-10-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"],"de":["Museen & Kunstzentren","Fotografie"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"\u00ab Que portais-tu ce jour-l\u00e0 ? \u00bb NON, l\u2019habit ne fait pas le viol","shortdescr":"En Belgique, 16% des personnes interrog\u00e9es, dans un sondage publi\u00e9 par Amnesty International Belgique francophone et SOS Viol, estiment que la responsabilit\u00e9 de la victime peut \u00eatre engag\u00e9e car la fa\u00e7on dont elle est habill\u00e9\u00b7e peut \u00ab inviter \u00bb au viol.","longdescr":"C\u2019est une id\u00e9e d\u00e9vastatrice, aussi bien pour les personnes ayant subi un viol que pour notre soci\u00e9t\u00e9. Ce chiffre alarmant d\u00e9montre que ce mythe a la peau dure.\r\nAvec cette question fr\u00e9quente sur les v\u00eatements port\u00e9s, finalement, on renvoie la responsabilit\u00e9 sur la personne qui est victime.\r\nD\u00e9construire un mythe r\u00e9pandu de la culture du viol\r\nL\u2019exposition \u00ab Que portais-tu ce jour-l\u00e0 ? \u00bb a \u00e9t\u00e9 montr\u00e9e pour la premi\u00e8re fois en 2013 \u00e0 l\u2019Universit\u00e9 de l\u2019Arkansas aux \u00c9tats-Unis. Des \u00e9tudiant\u00b7e\u00b7s ayant subi un viol ont volontairement particip\u00e9 \u00e0 la r\u00e9daction de br\u00e8ves descriptions des habits qu\u2019ils\u00b7elles portaient au moment de leur agression sexuelle. Ces t\u00e9moignages ont \u00e9t\u00e9 utilis\u00e9s pour reproduire leurs tenues. A c\u00f4t\u00e9 de chaque pi\u00e8ce, une l\u00e9gende explique son origine, avec quelques phrases de la victime.\r\nA travers cette exposition, l\u2019\u00e9vidence saute aux yeux ; NON, l\u2019habit ne fait pas le viol \u2026 !\r\nLa commune d\u2019Evere vous invite \u00e0 visiter cette exposition install\u00e9e \u00e0 l\u2019espace Delahaut de la Maison communale d\u2019Evere.","performers":null,"boxoffice_url":null,"website":null,"email":"ddo@evere.brussels","phone_contact":"+32 2 563 60 65","phone_booking":"+32 2 563 60 65","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542597"},"nl":{"name":"\u2018Wat had je die avond aan?\u2019 NEE, kleding is geen uitnodiging tot verkrachting!","shortdescr":"Volgens een peiling die Amnesty International Belgique francophone en SOS Viol publiceerden, is in Belgi\u00eb 16 % van de ondervraagden van mening dat het slachtoffer verantwoordelijk kan worden gesteld omdat de manier waarop ze gekleed is, kan \u2018uitnodigen\u2019 tot verkrachting.","longdescr":"Dit is een vernietigende gedachte, zowel voor de slachtoffers van een verkrachting als voor onze samenleving. Dit verontrustende cijfer toont aan hoe hardnekkig deze mythe is.\r\nMet deze vaak gestelde vraag naar de kleding die men aanhad, wordt de verantwoordelijkheid uiteindelijk gelegd bij degene die het slachtoffer is.\r\nDe wijdverbreide mythe van de verkrachtingscultuur ontkrachten\r\nDe tentoonstelling \u2018Wat had je die dag aan?\u2019 werd voor de eerste keer gehouden in 2013 in de universiteit van Arkansas in de Verenigde Staten. Studentes die het slachtoffer waren van een verkrachting werkten vrijwillig mee aan het opstellen van korte beschrijvingen van de kleding die ze droegen op het ogenblik van het seksueel geweld. Deze getuigenissen werden gebruikt om hun outfit na te bootsen. Naast elk stuk staat een legende met uitleg over de oorsprong, met enkele zinnen van het slachtoffer.\r\nDeze tentoonstelling maakt het overduidelijk: NEE, kleding is geen uitnodiging tot verkrachting!\r\nDe gemeente Evere nodigt u uit om deze tentoonstelling te bezoeken in de aula Delahaut van het gemeentehuis van Evere.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542597"},"en":{"name":"\u00ab Que portais-tu ce soir-l\u00e0 \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542597"},"de":{"name":"Exposition \u00ab Que portais-tu ce soir-l\u00e0 \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542597"},"it":{"name":"Exposition \u00ab Que portais-tu ce soir-l\u00e0 \u00bb","sho