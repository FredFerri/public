ht":852,"oEmbed_width":1200,"translations":{"de":{"title":"La jonction Nord-Midi","copyright":null},"pt":{"title":"La jonction Nord-Midi","copyright":null},"en":{"title":"La jonction Nord-Midi","copyright":null},"it":{"title":"La jonction Nord-Midi","copyright":null},"cn":{"title":"La jonction Nord-Midi","copyright":null},"fr":{"title":"La jonction Nord-Midi","copyright":null},"sp":{"title":"La jonction Nord-Midi","copyright":null},"nl":{"title":"La jonction Nord-Midi","copyright":null}}}],"dates":[{"day":"2024-08-31","doors":null,"start":"14:00:00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50012953,"date_start":"2024-08-31","date_end":"2024-08-31","date_next":"2024-08-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-08-24T03:22:02+02:00","published_at":"2024-07-29T09:22:25+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":304703,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":1.2599210498948732,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[122],"translations":{"de":["Dance"],"pt":[null],"en":["Dance"],"it":["Dance"],"cn":[null],"fr":["Dance"],"sp":["Dance"],"nl":["Dance"]}}},"translations":{"de":{"name":"Color Bang - Festival of Colors","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@colorbang.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012953"},"pt":{"name":"Color Bang - Festival of Colors","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@colorbang.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012953"},"en":{"name":"Color Bang - Festival of Colors","shortdescr":"Get ready to celebrate joy at Color Bang - Festival of Colors in Brussels! \n\nJoin us at Parc du Cinquantenaire on Saturday, August 31, 2024, from 11:00 AM to 7:00 PM for a day of organic color play, DJ music, and pure delight. Enjoy colorful festivities, delicious food stalls, and a sense of unity as you paint each other. Entry is FREE for everyone!","longdescr":"Join us for an unforgettable experience at Color Bang, where joy, color, and music come together in a vibrant celebration. Held in the heart of Brussels at Parc du Cinquantenaire, this year's festival promises to be a day full of fun and unforgettable memories.\n\nHere\u2019s what you can look forward to:\n\n- Color Play: Have fun with organic colors, throw them in the air, and paint each other to create a sense of unity and pure joy.\n\n\n- DJ Music: Dance to fantastic DJ music all day long.\n\n- Food Stalls: After the colorful festivities, explore a variety of delicious food available at the stalls.\n\n- Family Fun: People of all ages, including kids, are welcome to join in the fun and excitement.\n\nColor Bang is about letting go of your worries, embracing life, and connecting with others in a joyful and colorful atmosphere. Entry is FREE and open to everyone, making it a perfect outing for friends and family.\n\n- Date: Saturday, August 31, 2024  \n- Time: 11:00 AM - 07:00 PM  \n- Location: Parc du Cinquantenaire, Brussels  \n\nThis event is proudly supported by our partners Atcon Global, Indian Foodism Lounge, Coca-Cola and Juplier.\n\nBring your friends and family for a day of joy, fun, and unforgettable memories. We can\u2019t wait to see you there! For any questions, feel free to contact us at info@colorbang.be. Don\u2019t miss one of Brussels\u2019 most exciting and colorful festivals!\n\nStay up to date with the latest info by following our Facebook event page\nhttps:\/\/www.facebook.com\/share\/kGTVKwTndcy2yRW7\/","performers":null,"boxoffice_url":null,"website":null,"email":"info@colorbang.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012953"},"it":{"name":"Color Bang - Festival of Colors","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@colorbang.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012953"},"cn":{"name":"Color Bang - Festival of Colors","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@colorbang.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012953"},"fr":{"name":"Color Bang - Festival of Colors","shortdescr":"Pr\u00e9parez-vous \u00e0 c\u00e9l\u00e9brer la joie au Color Bang - Festival des Couleurs \u00e0 Bruxelles ! \n\nRejoignez-nous au Parc du Cinquantenaire le samedi 31 ao\u00fbt 2024, pour une journ\u00e9e de jeux de couleurs organiques, de musique DJ et de pur bonheur. Profitez des festivit\u00e9s color\u00e9es, des stands de nourriture d\u00e9licieux et d'un sentiment d'unit\u00e9 en vous peignant les uns les autres. Entr\u00e9e GRATUITE pour tous !","longdescr":"Rejoignez-nous pour une exp\u00e9rience inoubliable au Color Bang, o\u00f9 la joie, la couleur et la musique se r\u00e9unissent dans une c\u00e9l\u00e9bration vibrante. Organis\u00e9 en plein c\u0153ur de Bruxelles au Parc du Cinquantenaire, le festival de cette ann\u00e9e promet d'\u00eatre une journ\u00e9e pleine de plaisir et de souvenirs inoubliables.\n\nVoici ce qui vous attend :\n\n- Jeux de Couleurs : Amusez-vous avec des couleurs organiques, jetez-les en l'air et peignez-vous les uns les autres pour cr\u00e9er un sentiment d'unit\u00e9 et de pur bonheur.\n\n- Musique DJ : Dansez au rythme de la musique fantastique des DJ toute la journ\u00e9e.\n\n- Stands de Nourriture : Apr\u00e8s les festivit\u00e9s color\u00e9es, explorez une vari\u00e9t\u00e9 de d\u00e9licieuses nourritures disponibles aux stands.\n- Plaisir pour Toute la Famille : Les personnes de tous \u00e2ges, y compris les enfants, sont les bienvenues pour participer au plaisir et \u00e0 l'excitation.\nColor Bang consiste \u00e0 oublier vos soucis, \u00e0 embrasser la vie et \u00e0 vous connecter avec les autres dans une atmosph\u00e8re joyeuse et color\u00e9e. L'entr\u00e9e est GRATUITE et ouverte \u00e0 tous, ce qui en fait une sortie parfaite pour les amis et la famille.\n\n- Date : Samedi 31 ao\u00fbt 2024\n- Heure : 11h00 - 19h00\n- Lieu : Parc du Cinquantenaire, Bruxelles\n\nCet \u00e9v\u00e9nement est fi\u00e8rement soutenu par nos partenaires Atcon Global, Indian Foodism Lounge, Coca-Cola et Juplier.\n\nAmenez vos amis et votre famille pour une journ\u00e9e de joie, de plaisir et de souvenirs inoubliables. Nous avons h\u00e2te de vous voir l\u00e0-bas ! Pour toute question, n'h\u00e9sitez pas \u00e0 nous contacter \u00e0 info@colorbang.be. Ne manquez pas l'un des festivals les plus excitants et color\u00e9s de Bruxelles !\n\nRestez \u00e0 jour avec les derni\u00e8res infos en suivant notre page \u00e9v\u00e9nement Facebook\nhttps:\/\/www.facebook.com\/share\/kGTVKwTndcy2yRW7\/","performers":null,"boxoffice_url":null,"website":null,"email":"info@colorbang.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012953"},"sp":{"name":"Color Bang - Festival of Colors","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@colorbang.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012953"},"nl":{"name":"Color Bang - Festival of Colors","shortdescr":"Maak je klaar om vreugde te vieren bij Color Bang - Festival van Kleuren in Brussel! \n\nSluit je aan bij ons in het Parc du Cinquantenaire op zaterdag 31 augustus 2024, voor een dag vol organische kleuren, DJ-muziek en puur plezier. Geniet van de kleurrijke festiviteiten, heerlijke eetkraampjes en een gevoel van saamhorigheid terwijl je elkaar beschildert. Toegang is GRATIS voor iedereen!","longdescr":"Sluit je bij ons aan voor een onvergetelijke ervaring bij Color Bang, waar vreugde, kleur en muziek samenkomen in een bruisende viering. Het festival vindt plaats in het hart van Brussel, in het Parc du Cinquantenaire, en belooft een dag vol plezier en onvergetelijke herinneringen.\n\nDit is wat je kunt verwachten:\n\n- Kleuren Spel: Geniet van organische kleuren, gooi ze in de lucht en beschilder elkaar om een gevoel van eenheid en puur geluk te cre\u00ebren.\n\n- DJ Muziek: Dans de hele dag op fantastische DJ-muziek.\n\n- Eetkraampjes: Ontdek een verscheidenheid aan heerlijke voedingsmiddelen bij de kraampjes na de kleurrijke festiviteiten.\n\n- Gezinsplezier: Mensen van alle leeftijden, inclusief kinderen, zijn welkom om deel te nemen aan het plezier en de opwinding.\n\nColor Bang draait om het loslaten van je zorgen, het omarmen van het leven en het verbinden met anderen in een vrolijke en kleurrijke sfeer. De toegang is GRATIS en open voor iedereen, waardoor het een perfecte uitje is voor vrienden en familie.\n\n- Datum: Zaterdag 31 augustus 2024\n- Tijd: 11:00 - 19:00\n- Locatie: Parc du Cinquantenaire, Brussel\n\nDit evenement wordt trots ondersteund door onze partners Atcon Global, Indian Foodism Lounge, Coca-Cola en Juplier.\n\nBreng je vrienden en familie mee voor een dag vol vreugde, plezier en onvergetelijke herinneringen. We kunnen niet wachten om je daar te zien! Voor vragen kun je ons bereiken op info@colorbang.be. Mis dit opwindende en kleurrijke festival in Brussel niet!\n\nBlijf op de hoogte van het laatste nieuws door onze Facebook-evenementpagina te volgen\nhttps:\/\/www.facebook.com\/share\/kGTVKwTndcy2yRW7\/","performers":null,"boxoffice_url":null,"website":null,"email":"info@colorbang.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012953"}},"place":{"id":235980,"translations":{"de":{"name":"Parc du Cinquentenaire in Br\u00fcssel","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"Der 1880 anl\u00e4sslich des 50. Jahrestags der Unabh\u00e4ngigkeit Belgiens angelegte Parc du Cinquantenaire ist eine Gartenanlage im \u201efranz\u00f6sischen Stil\u201c mit historischer Bedeutung. Hier kann man neben Gartenkunst auch Denkm\u00e4ler, Skulpturen und Museen bewundern. \u00dcberragt wird der Park von einem Triumphbogen mit drei Arkaden, auf denen eine bronzene Quadriga prangt. Von hier aus k\u00f6nnen Besucher einen atemberaubenden Blick auf die belgische Hauptstadt genie\u00dfen. Die breiten Alleen f\u00fchren unter anderem zum Pavillon der menschlichen Leidenschaften aus der Feder des ber\u00fchmten Jugendstilarchitekten Victor Horta, zum K\u00f6niglichen Armee- und Milit\u00e4rmuseum, zum Museum f\u00fcr Kunst & Geschichte und zum Automuseum Autoworld.\r\n\r\nGanzj\u00e4hrig finden hier zudem Veranstaltungen aller Art statt: Sportveranstaltungen, Feste, Konzerte, Feuerwerk... Im Sommer l\u00e4dt Sie das Park-Caf\u00e9 \u201eGuinguette Maurice\u201c zu einer sonnigen Pause ein.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Parque do Cinquenten\u00e1rio","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"O local \u00e9 um vasto conjunto de jardins, pontuado por monumentos e museus. \u00c9 dominado por um arco do triunfo de tr\u00eas arcadas: o Cinquenten\u00e1rio. O parque acolhe numerosas atividades ao longo de todo o ano: manifesta\u00e7\u00f5es, festas, fogos de artif\u00edcio, eventos desportivos, concertos\u2026 O local foi constru\u00eddo em 1880 para o 50.\u00ba anivers\u00e1rio da independ\u00eancia da B\u00e9lgica. As grandes vias levam ao Pavilh\u00e3o das Paix\u00f5es Humanas, desenhado por Victor Horta, ao Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar, aos Museus Reais de Arte e Hist\u00f3ria e \u00e0 Autoworld. No \u00e1pice dos tr\u00eas arcos triunfais, uma quadriga de bronze e um panorama com vista deslumbrante de Bruxelas inteira. Equipamentos: -Bancos -Mesas de piquenique -Chafarizes -Parque infantil 3-7 anos -Parque infantil 7-12 anos -Campo polidesportivo -Espregui\u00e7adeiras (no ver\u00e3o) Acessibilidade: a entrada do lado Schuman foi toda especialmente adaptada neste sentido. O revestimento das vias \u00e9 conveniente para os carrinhos. Aqui e ali, s\u00e3o atravessadas por canais pouco profundos. Ladrilhado redondo na esplanada.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Cinquantenaire Park","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Brussels","description_web":"Built in 1880 to mark the 50th anniversary of Belgium's independence, Cinquantenaire Park is both a collection of French-style gardens and a historical site that's home to monuments, sculptures and museums. It's dominated by a triumphal arch with three arches and a bronze quadriga at its summit, which offers a stunning panoramic view of the capital. The wide paths lead to the Pavilion of Human Passions designed by Victor Horta, the Royal Museum of the Armed Forces and Military History, the Art & History Museum and Autoworld, the car museum.\r\n\r\nTake part in events here throughout the year: sporting events, festivals, concerts, fireworks... In the summer, you can enjoy a short break at the Guinguette Maurice pop-up bar.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Parco del Cinquantenario, natura e cultura nel centro di Bruxelles","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"Il Parc du Cinquantenaire, polmone verde di Bruxelles, \u00e8 un'oasi di pace nel mezzo del Quartiere Europeo.\u00a0\r\n\r\nRifugio tranquillo in mezzo alla tempesta delle automobili, il parco cela dei veri e propri tesori : la Grande Moschea, la statua del cane verde o il Pavillon des passions humaines di Victor Horta.\u00a0\r\nUbicato tra la rotonda Schuman, le avenues des Nerviens, de la Renaissance e de Tervueren, il Parco del Cinquantenario copre una trentina di ettari di giardino classico, con vialetti tracciati da funi, siepi di allori potati e un tracciato simmetrico. Il Museo del Cinquantenario, i Musei d'Arte e di Storia Militare e Autoworld sono ospitati all'interno della grande costruzione del Cinquantenario.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Parc du Cinquantenaire","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Parc du Cinquantenaire","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"Construit en 1880 pour le 50e anniversaire de l\u2019ind\u00e9pendance de la Belgique, le parc du Cinquantenaire est \u00e0 la fois un ensemble de jardins \u00ab\u00a0\u00e0 la fran\u00e7aise\u00a0\u00bb et un site historique o\u00f9 d\u00e9couvrir monuments, sculptures et mus\u00e9es. Il est domin\u00e9 par un arc de triomphe \u00e0 trois arcades avec, au sommet, un quadrige de bronze et un panorama avec une vue imprenable sur la capitale. Les grandes all\u00e9es vous conduisent au Pavillon des Passions humaines dessin\u00e9 par Victor Horta, au Mus\u00e9e Royal de l'Arm\u00e9e et d'Histoire Militaire, au Mus\u00e9e Art & Histoire et \u00e0 Autoworld, le mus\u00e9e de l\u2019automobile.\r\n\r\nParticipez \u00e0 des manifestations tout au long de l\u2019ann\u00e9e\u00a0: \u00e9v\u00e8nements sportifs, f\u00eates, concerts, feux d\u2019artifice\u2026 En \u00e9t\u00e9, la guinguette Maurice vous accueille pour une petite pause.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Parque del Cincuentenario","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"El Cincuentenario est\u00e1 compuesto por un amplio conjunto de jardines llenos de monumentos y museos. Destaca por su por su arco de triunfo compuesto por tres arcos. El parque acoge numerosas actividades a lo largo del a\u00f1o: eventos, celebraciones, espect\u00e1culos de fuegos artificiales, eventos deportivos, conciertos, etc.. \r\nEste lugar de inter\u00e9s fue construido en 1880 por el 50\u00ba aniversario de la independencia de B\u00e9lgica. Sus amplios caminos llevan hacia el Templo de las pasiones humanas, dise\u00f1ado por Victor Horta, el Real Museo de las Fuerzas armadas y de Historia Militar, el Museo Real de Arte e Historia y el Autoworld. En la parte superior de los tres arcos de triunfo hay una cuadriga y una vista impresionante de Bruselas.\r\n\r\nInstalaciones: \r\n- Bancos\r\n- Mesas de p\u00edcnic\r\n- Fuentes \r\n- Parques para ni\u00f1os de 3 a 7 a\u00f1os\r\n- Parques para ni\u00f1os de 7 a 12 a\u00f1os\r\n- Una pista deportiva polivalente\r\n- Tumbonas (en verano)\r\n\r\nAccesibilidad: \r\nLa entrada por Schuman ha sido especialmente dise\u00f1ada teniendo esto en mente. El camino est\u00e1 adecuado para sillas de ruedas. Aqu\u00ed y all\u00e1 encontrar\u00e1s peque\u00f1os caminos rodeando la explanada.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Jubelpark","address_street_name":"Jubelpark","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark","address_line2":"1000 Brussel","description_web":"Het Jubelpark werd in 1880 aangelegd ter gelegenheid van de 50e verjaardag van de Belgische onafhankelijkheid. Het park bestaat uit een aantal tuinen in Franse stijl. Maar het is vooral een historische site met veel monumenten, beeldhouwwerken en musea. Centraal staat de gigantische triomfboog. Die telt drie bogen, een bronzen vierspan helemaal bovenaan en een panoramisch uitzicht over de hoofdstad. In het park leiden de brede lanen je naar het Paviljoen der Menselijke Driften (ontworpen door Victor Horta), het Koninklijk Museum van het Leger en de Krijgsgeschiedenis, de Koninklijke Musea voor Kunst en Geschiedenis en Autoworld, het automuseum.\r\n\r\nJe kan er het hele jaar door naar sportevenementen, feesten, concerten, vuurwerk... In de zomer vind je er ook de Guinguette Maurice.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":"138560756189921","backoffice_id":1468,"location":{"lat":50.84192984,"lon":4.38610375},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:14:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto