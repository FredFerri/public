:null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005989"},"nl":{"name":"\"Armon\u00edas sure\u00f1as\" Constanza Guzm\u00e1n","shortdescr":"Constanza Guzm\u00e1n herneemt de liederen van haar geboorteland Latijns-Amerika, met Jeanfran\u00e7ois Prins op gitaar, Annemie Osborne op cello en Am\u00e8le Metlini op viool. Van Silvio Rodriguez tot Atahualpa Yupanqui, en niet te vergeten Violeta Parra en Chico Buarque, deze muzikanten zullen je in vervoering brengen met woorden en harmonie\u00ebn uit landen als Chili, Argentini\u00eb, Brazili\u00eb en Cuba. ","longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005989"}},"place":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en"