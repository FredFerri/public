ible parking"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T06:35:39+02:00","published_at":"2022-10-10T09:01:25+02:00","backoffice_id":263739,"import_origin":null,"sub_type":"party","show_in_agenda":true,"ranking":1},{"id":530988,"date_start":"2022-10-15","date_end":"2022-10-15","date_next":"2022-10-15","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Logement ouvrier et cit\u00e9s-jardins aux confins de Molenbeek","shortdescr":"D\u00e8s le d\u00e9but du 19esi\u00e8cle, la chauss\u00e9e de Gand, \u00e0 Molenbeek-Saint-Jean, voit s\u2019\u00e9tablir sur ses abords une foule d\u2019usines, manufactures, petites fabriques et ateliers. Pas \u00e9tonnant que s\u2019y d\u00e9veloppent, peu de temps apr\u00e8s, plusieurs ensembles de logements destin\u00e9s aux ouvriers, qui vivent alors dans des conditions mis\u00e9rables.","longdescr":"D\u00e8s le d\u00e9but du 19esi\u00e8cle, la chauss\u00e9e de Gand, \u00e0 Molenbeek-Saint-Jean, voit s\u2019\u00e9tablir sur ses abords une foule d\u2019usines, manufactures, petites fabriques et ateliers. Pas \u00e9tonnant que s\u2019y d\u00e9veloppent, peu de temps apr\u00e8s, plusieurs ensembles de logements destin\u00e9s aux ouvriers, qui vivent alors dans des conditions mis\u00e9rables. En 1899, dans un contexte de fortes revendications de la classe laborieuse, Molenbeek est d\u2019ailleurs la seconde commune bruxelloise \u00e0 mettre en place une soci\u00e9t\u00e9 de logement public, juste apr\u00e8s Schaerbeek. Nomm\u00e9e aujourd\u2019hui \u00abLogement Molenbeekois\u00bb, elle est \u00e0 l\u2019origine, dans l\u2019entre-deux-guerres, de plusieurs cit\u00e9s-jardins aux noms \u00e9vocateurs: cit\u00e9 du Lierre, Gulden-Bodem, Accord-M\u00e9lodie, Nogent, Diongre ou encore de Saulnier\u2026\nEn passant en revue l\u2019\u00e9volution des typologies et des styles de logement social \u00e0 Bruxelles, des premi\u00e8res cit\u00e9s ouvri\u00e8res aux ensembles modernistes, en passant \u00e9videmment par les cit\u00e9s-jardins, cette visite sera aussi l\u2019occasion de se plonger dans l\u2019histoire des revendications sociales en mati\u00e8re de logement d\u00e9cent \u00e0 Bruxelles, depuis le 19esi\u00e8cle.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.530988"},"nl":{"name":"Logement ouvrier et cit\u00e9s-jardins aux confins de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.530988"},"en":{"name":"Logement ouvrier et cit\u00e9s-jardins aux confins de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.530988"},"de":{"name":"Logement ouvrier et cit\u00e9s-jardins aux confins de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.530988"},"it":{"name":"Logement ouvrier et cit\u00e9s-jardins aux confins de Molenbeek","shortdescr":null,"longdescr":nu