h_capacity":false,"is_not_major_event":false,"backoffice_id":283622,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"Ik en den Theo + Bel Moderne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/?","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001111"},"pt":{"name":"Ik en den Theo + Bel Moderne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/?","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001111"},"en":{"name":"Ik en den Theo + Bel Moderne","shortdescr":null,"longdescr":"After she created a Bal Moderne choreography on Jaune Toujours' Ici Bruxelles, Ik en den Theo asked Maria-Clara Villa-Lobos to create Bal Moderne choreographies for songs by Ik en den Theo. She did so for Indiaan, Superheld, Dans, Dance, Danse and Kikkertjes. The choreographies can be taught and practised in Bal Moderne workshops and\/or during Ik en den Theo concerts, with the help of the Bal Moderne dancers, which brings the Ik en den Theo concert experience to an even higher level. Shake a leg!","performers":"Ik en den Theo + Bal Moderne","boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/?","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001111"},"it":{"name":"Ik en den Theo + Bel Moderne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/?","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001111"},"cn":{"name":"Ik en den Theo + Bel Moderne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/?","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001111"},"fr":{"name":"Ik en den Theo + Bel Moderne","shortdescr":null,"longdescr":"Apr\u00e8s avoir cr\u00e9\u00e9 une chor\u00e9graphie de Bal Moderne sur 'Ici Bruxelles' de Jaune Toujours, Moi et le Th\u00e9o ont demand\u00e9 \u00e0 Maria-Clara Villa-Lobos de cr\u00e9er des chor\u00e9graphies de Bal Moderne pour des chansons de Moi et le Th\u00e9o. Elle l'a fait pour Indien, Super h\u00e9ro, Danse, Dance, Dans et Grenouilles. Les chor\u00e9graphies peuvent \u00eatre enseign\u00e9es et pratiqu\u00e9es dans les ateliers de Bal Moderne et\/ou pendant les concerts de Moi et le Th\u00e9o, avec l'aide des danseurs de Bal Moderne, ce qui porte l'exp\u00e9rience des concerts Ik en den Theo \u00e0 un niveau encore plus \u00e9lev\u00e9. Bougez-vous !","performers":"Ik en den Theo + Bal Moderne","boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/?","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001111"},"sp":{"name":"Ik en den Theo + Bel Moderne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/?","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001111"},"nl":{"name":"Ik en den Theo + Bel Moderne","shortdescr":null,"longdescr":"Nadat ze een Bal Moderne choreografie maakte op het Jaune Toujours nummer 'Ici Bruxelles', vroegen Ik en 