article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-29T03:01:41+02:00","published_at":"2024-04-03T10:25:42+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":297703,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.34123856033855543,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Abstract Writings. Abstract Thoughts.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/abstract-writings-abstract-thoughts\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009156"},"pt":{"name":"Abstract Writings. Abstract Thoughts.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/abstract-writings-abstract-thoughts\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009156"},"en":{"name":"Abstract Writings. Abstract Thoughts.","shortdescr":"\"Abstract Writings, Abstract Thoughts\" reveals a hitherto unpublished aspect of Jean Boghossian's work: his writings on art, a constant feature of his practice for many years. The artist's thoughts, in dialogue with his pictorial creations dealing with questions of support and texture, give an insight into the intensity of his work.","longdescr":"Jean Boghossian (Aleppo, 1949), a Belgian artist of Armenian origin, creates a non-conformist body of work exploring a wide range of media, including paper, canvas, wood and the artist's book. His work is included in the collection of the Wittockiana, where he has already exhibited a selection of Livres sauv\u00e9s (Ph\u00e9nix). This new exhibition, \"Abstract Writings. Abstract Thoughts\", reveals a hitherto unseen aspect of his work: his writings on art, a constant feature of his practice for many years. A commentary on life, but perhaps even more an accomplice to the artist's artistic journey, these \"notes\" give an account of the artist's creative experience. This collection of writings, at the crossroads of inner reflection and representation of the world, reveals Boghossian as an artist-thinker. His thoughts, in dialogue with his pictorial creations addressing questions of medium and texture, provide a telling insight into the intensity of his work.","performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/abstract-writings-abstract-thoughts\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009156"},"it":{"name":"Abstract Writings. Abstract Thoughts.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/abstract-writings-abstract-thoughts\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009156"},"cn":{"name":"Abstract Writings. Abstract Thoughts.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/abstract-writings-abstract-thoughts\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009156"},"fr":{"name":"Abstract Writings. Abstract Thoughts.","shortdescr":"\"Abstract Writings, Abstract Thoughts\" r\u00e9v\u00e8le un aspect jusqu\u2019alors in\u00e9dit de l'\u0153uvre de Jean Boghossian : ses \u00e9crits sur l\u2019art, \u00e9l\u00e9ment constant de sa pratique depuis de nombreuses ann\u00e9es. Les pens\u00e9es de l'artiste, en dialogue avec ses cr\u00e9ations picturales abordant les questions de support et de texture, donnent un aper\u00e7u parlant d\u2019intensit\u00e9 de son travail.","longdescr":"Jean Boghossian (Alep, 1949), artiste belge d\u2019origine arm\u00e9nienne, cr\u00e9e une \u0153uvre non conformiste explorant une large gamme de m\u00e9dias, tels que le papier, la toile, le bois et le livre d\u2019artiste. Son travail figure dans la collection de la Wittockiana, o\u00f9 il a d\u00e9j\u00e0 expos\u00e9 une s\u00e9lection de Livres sauv\u00e9s (Ph\u00e9nix). Cette nouvelle exposition, \"Abstract Writings, Abstract Thoughts\", r\u00e9v\u00e8le un aspect jusqu\u2019alors in\u00e9dit de son \u0153uvre : ses \u00e9crits sur l\u2019art, \u00e9l\u00e9ment constant de sa pratique depuis de nombreuses ann\u00e9es. Commentaires sur la vie, mais peut-\u00eatre plus encore complices du parcours artistique, ces \u00ab notes \u00bb  rendent comptent de l\u2019exp\u00e9rience cr\u00e9ative de l\u2019artiste. Cette collection d\u2019\u00e9crits, \u00e0 la crois\u00e9e de la r\u00e9flexion int\u00e9rieure et de la repr\u00e9sentation du monde, d\u00e9voile Boghossian en tant qu\u2019artiste-penseur. Ses pens\u00e9es, en dialogue avec ses cr\u00e9ations picturales abordant les questions de support et de texture, donnent un aper\u00e7u parlant d\u2019intensit\u00e9 de son travail.","performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/abstract-writings-abstract-thoughts\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009156"},"sp":{"name":"Abstract Writings. Abstract Thoughts.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/abstract-writings-abstract-thoughts\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009156"},"nl":{"name":"Abstract Writings. Abstract Thoughts.","shortdescr":"\"Abstract Writings, Abstract Thoughts\" onthult een tot nu toe ongepubliceerd aspect van het werk van Jean Boghossian: zijn geschriften over kunst, al vele jaren een vast onderdeel van zijn praktijk. De gedachten van de kunstenaar, in dialoog met zijn picturale creaties die te maken hebben met kwesties van ondersteuning en textuur, geven inzicht in de intensiteit van zijn werk.","longdescr":"Jean Boghossian (Aleppo, 1949), een Belgische kunstenaar van Armeense afkomst, cre\u00ebert een non-conformistisch oeuvre waarin hij een breed scala aan media gebruikt, waaronder papier, doek, hout en het kunstenaarsboek. Zijn werk is opgenomen in de collectie van de Wittockiana, waar hij al een selectie van Livres sauv\u00e9s (Ph\u00e9nix) tentoonstelde. Deze nieuwe tentoonstelling, \"Abstract Writings, Abstract Thoughts\", onthult een tot nu toe ongezien aspect van zijn werk: zijn geschriften over kunst, al vele jaren een vast onderdeel van zijn praktijk. Deze \"notities\" zijn een commentaar op het leven, maar misschien nog meer een medeplichtige aan de artistieke reis van de kunstenaar en geven een verslag van zijn creatieve ervaring. Deze verzameling geschriften, op het kruispunt van innerlijke reflectie en representatie van de wereld, onthult Boghossian als een kunstenaar-denker. Zijn gedachten, in dialoog met zijn picturale creaties die vragen van medium en textuur behandelen, geven een veelzeggend inzicht in de intensiteit van zijn werk.","performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/abstract-writings-abstract-thoughts\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009156"}},"place":{"last_updated_at":"2023-02-09T09:15:26+01:00","published_at":"2013-10-19T01:13:14+02:00","id":142,"translations":{"de":{"name":"Wittockiana: Msueum f\u00fcr Buch- und Buchbindekunst","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":"Die Wittockiana wurde 1983 von dem renommierten Buchkenners Michel Wittock gegr\u00fcndet und ist sowohl Buchmuseum als auch Bibliothek und Archiv f\u00fcr kostbare historische, moderne und zeitgen\u00f6ssische B\u00fccher.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Wittockiana : Mus\u00e9e des Arts du livre et de la Reliure ","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":