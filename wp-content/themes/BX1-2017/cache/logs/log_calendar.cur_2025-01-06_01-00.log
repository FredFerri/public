:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004567"},"it":{"name":"D\u00e9couverte de la Brasserie de la Senne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/onceinbrussels.be\/brasserie-de-la-senne-in\/","email":"melanie@onceinbrussels.be","phone_contact":"+32 496 77 86 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004567"},"cn":{"name":"D\u00e9couverte de la Brasserie de la Senne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/onceinbrussels.be\/brasserie-de-la-senne-in\/","email":"melanie@onceinbrussels.be","phone_contact":"+32 496 77 86 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004567"},"fr":{"name":"D\u00e9couverte de la Brasserie de la Senne","shortdescr":"L\u2019occasion de d\u00e9couvrir la fa\u00e7on dont on fabrique de la bi\u00e8re artisanale dans de si impressionnantes installations. Enfin nous terminerons la visite par une d\u00e9gustation comment\u00e9e de quatre bi\u00e8res phares de la brasserie.","longdescr":"Au d\u00e9but du 20\u00e8me si\u00e8cle \u00e0 Bruxelles, on d\u00e9nombrait encore une centaine de brasseries. Suite aux guerres mondiales, \u00e0 l\u2019industrialisation et \u00e0 la formalisation des go\u00fbts, il n\u2019en restera plus qu\u2019une jusqu\u2019\u00e0 ce que Bernard rencontre Yvan en 2002. Ensemble ils cr\u00e9ent la Brasserie de La Senne. Les bi\u00e8res format\u00e9es et sucr\u00e9es c\u00e8dent la place \u00e0 l\u2019amertume. Aujourd\u2019hui install\u00e9s dans 4500 m\u00b2 sur le site de Tour & Taxis, ils ont mis la technologie au service de leurs bi\u00e8res. Lors de cette visite, vous acc\u00e9dez \u00e0 l\u2019espace de production. L\u2019occasion de d\u00e9couvrir la fa\u00e7on dont on fabrique de la bi\u00e8re artisanale dans de si impressionnantes installations. Enfin nous terminerons la visite par une d\u00e9gustation comment\u00e9e de quatre bi\u00e8res phares de la brasserie.","performers":null,"boxoffice_url":null,"website":"https:\/\/onceinbrussels.be\/brasserie-de-la-senne-in\/","email":"melanie@onceinbrussels.be","phone_contact":"+32 496 77 86 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004567"},"sp":{"name":"D\u00e9couverte de la Brasserie de la Senne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/onceinbrussels.be\/brasserie-de-la-senne-in\/","email":"melanie@onceinbrussels.be","phone_contact":"+32 496 77 86 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004567"},"nl":{"name":"D\u00e9couverte de la Brasserie de la Senne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/onceinbrussels.be\/brasserie-de-la-senne-in\/","email":"melanie@onceinbrussels.be","phone_contact":"+32 496 77 86 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004567"}},"place":{"id":50001281,"translations":{"de":{"name":"Brasserie de la Senne","address_street_name":"Dr\u00e8ve Anna Boch","address_street_number":"19","address_street_box":null,"email":"melanie@onceinbrussels.be","website":null,"phone_contact":"+32 496 77 86 01","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Dr\u00e8ve Anna Boch, 19","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Brasserie de la Senne","address_street_name":"Dr\u00e8ve Anna Boch","address_street_number":"19","address_street_box":null,"email":"melanie@onceinbrussels.be","website":null,"phone_contact":"+32 496 77 86 01","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Dr\u00e8ve A