":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & durable"],"nl":["Groen & duurzaam"],"en":["Green & sustainable"],"de":["Gr\u00fcn & nachhaltig"],"it":["Green e sostenibile"],"sp":["Ecol\u00f3gico y sostenible"],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-19T02:37:09+02:00","published_at":"2023-05-30T16:25:33+02:00","backoffice_id":277943,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.27235264688108},{"id":551525,"date_start":"2023-03-19","date_end":"2099-02-11","date_next":"2023-07-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"],"de":["Stadtteile"],"it":["Quartieri"],"sp":["Barrios"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":"Qui aurait pu deviner qu\u2019Etterbeek, un petit village situ\u00e9 \u00e0 l\u2019ext\u00e9rieur de la deuxi\u00e8me enceinte de Bruxelles, deviendrait un jour le centre du pouvoir europ\u00e9en ?","longdescr":"Pourquoi Bruxelles a-t-elle endoss\u00e9 le r\u00f4le de capitale europ\u00e9enne ? \r\n\r\nNous vous emmenons dans un voyage \u00e0 travers le temps. De l\u2019Etterbeek bucolique d\u2019avant le 19e si\u00e8cle, o\u00f9 l\u2019\u00e9lite bruxelloise habitait de luxueuses et vastes demeures, au 19e si\u00e8cle, et jusqu\u2019aux ann\u00e9es 50, lorsque l\u2019Union europ\u00e9enne a d\u00e9cid\u00e9 de s\u2019y installer, on vous emm\u00e8ne dans l\u2019Histoire et la g\u00e9ographie d\u2019un quartier unique !\r\n\r\nAu cours de cette promenade, vous d\u00e9couvrirez :\r\n\u2013 Les vestiges du Domaine d\u2019Eggevoorde des 16\u00e8me et 17\u00e8me si\u00e8cles ;\r\n\u2013 Le Zoo de Bruxelles ;\r\n\u2013 La \u00ab Cit\u00e9 des Sciences \u00bb fond\u00e9e par Ernest Solvay (o\u00f9 se sont d\u00e9roul\u00e9es les c\u00e9l\u00e8bres conf\u00e9rences Solvay) ;\r\n\u2013 L\u2019ancien atelier et la maison du peintre Paul Parmentier, un exemple incroyable de construction n\u00e9ogothique ;\r\n\u2013 Les plus importantes institutions europ\u00e9ennes ;\r\n\u2013 \u2026et bien d\u2019autres choses encore","performers":"Une visite guid\u00e9e originale de Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551525"},"nl":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551525"},"en":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.bru