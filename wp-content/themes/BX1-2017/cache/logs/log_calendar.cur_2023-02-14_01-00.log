_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Flybox, d\u00e9couvrez la Belgique gr\u00e2ce \u00e0 la r\u00e9alit\u00e9 virtuelle","shortdescr":"Gr\u00e2ce \u00e0 une sensation de vol ultra-r\u00e9aliste et des images immersives \u00e0 360\u00b0, \u00ab d\u00e9collez \u00bb depuis la Grand-Place pour un vol autour de la Belgique.","longdescr":"D\u00e9collage imminent ! Survoler l'enti\u00e8ret\u00e9 de la Belgique en tyrolienne ? C'est d\u00e9sormais possible gr\u00e2ce \u00e0 l'exp\u00e9rience de r\u00e9alit\u00e9 virtuelle Flybox ! \u00c0 l'aide d\u2019un casque VR, survolez la Belgique et d\u00e9couvrez la diversit\u00e9 de l'offre touristique que le pays a \u00e0 offrir en partant de la Grand-Place de Bruxelles. Voguez sur les canaux de Bruges, volez au-dessus de l\u2019atomium, Rejoignez une \u00e9quipe de parkour sur les marches de la montagne de Bueren ou balladez-vous en cuistax le long de la mer ... Gr\u00e2ce \u00e0 la r\u00e9alit\u00e9 virtuelle, visiter la Belgique n'a jamais \u00e9t\u00e9 aussi simple !","performers":null,"boxoffice_url":null,"website":"https:\/\/imaginebelgium.be\/","email":"booking@imaginebelgium.be","phone_contact":"+32 2 681 15 80","phone_booking":"+32 2 681 15 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.502693"},"nl":{"name":"Flybox, ontdek Belgi\u00eb dankzij virtual reality","shortdescr":"Een ultrarealistisch vlieggevoel en meeslepende 360\u00b0-beelden om het land te verkennen, comfortabel en uitgerust met een VR-headset. Flybox wil een culturele en leuke activiteit zijn, toegankelijk voor het grootste aantal en vooral voor gezinnen, om kinderen tijdens de zomer (en heel het jaar door) te vermaken.","longdescr":"Kom Belgi\u00eb ontdekken zoals nooit tevoren met je hele familie ! Stel je voor dat je heel Belgi\u00eb kan bezoeken in het hartje van Brussel dankzij een virtual reality ervaring. Zet uw VR-bril op, stijg op vanaf de Grote Markt in Brussel en vlieg over de drukke stad Antwerpen, klim over de Buerense trap in Luik, vaar over de Brugse grachten of neem deel aan een fietswedstrijd in Vlaanderen.","performers":null,"boxoffice_url":null,"website":"https:\/\/imaginebelgium.be\/","email":"booking@imaginebelgium.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.502693"},"en":{"name":"Flybox, discover Belgium with virtual reality","shortdescr":"Flybox offers you an original way to explore the capital of Europe and the whole country as you've never experienced it before! Get excited, the future of tourism is now !","longdescr":"Come and explore Belgium like never before with your whole family ! Imagine Belgium is opening a brand new virtual reality experience in the heart of Brussels. Put on your VR goggles, take off from the Grand Place in Brussels and fly over the busy city of Antwerp, discover the Bueren stairs in Liege, sail on the canals of Bruges or take part in a bike race in Flanders.","performers":null,"boxoffice_url":null,"website":"https:\/\/imaginebelgium.be\/","email":"booking@imaginebelgium.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.502693"},"de":{"name":"Flybox, d\u00e9couvrez la Belgique gr\u00e2ce \u00e0 la r\u00e9alit\u00e9 virtuelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/imaginebelgium.be\/","email":"booking@imaginebelgium.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.502693"},"it":{"name":"Flybox, d\u00e9couvrez la Belgique gr\u00e2ce \u00e0 la r\u00e9alit\u00e9 virtuelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/imaginebelgium.be\/","email":"booking@imaginebelgium.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.502693"},"sp":{"name":"Flybox, d\u00e9couvrez la Belgique gr\u00e2ce \u00e0 la r\u00e9alit\u00e9 virtuelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/imaginebelgium.be\/","email":"booking@imaginebelgium.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.502693"},"pt":{"name":"Flybox, d\u00e9couvrez la Belgique gr\u00e2ce \u00e0 la r\u00e9alit\u00e9 virtuelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/imaginebelgium.be\/","email":"booking@imaginebelgium.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.502693"},"cn":{"name":"Flybox, d\u00e9couvrez la Belgique gr\u00e2ce \u00e0 la r\u00e9alit\u00e9 virtuelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/imaginebelgium.be\/","email":"booking@imaginebelgium.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.502693"}},"place":{"id":276319,"translations":{"fr":{"name":"Imagine Belgium","address_street_name":"Rue de la Colline","address_street_number":"24","address_street_box":null,"email":"booking@imaginebelgium.be","website":"http:\/\/www.imaginebelgium.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Colline, 24","address_line2":"1000 Bruxelles","description_web":"Gra\u0302ce a\u0300 une sensation de vol incroyablement re\u0301aliste et des images immersives a\u0300 360\u00b0,\r\nle visiteur \"de\u0301colle\" de la Grand Place pour un vol de 15 minutes au-dessus de la Belgique. Une fac\u0327on originale d'explorer le pays sous un angle nouveau, e\u0301quipe\u0301 d'un casque de re\u0301alite\u0301 virtuelle. Flybox se veut e\u0302tre une activite\u0301 culturelle, ludique, accessible a\u0300 tous. L\u2019attraction VR Flybox dure 15 minutes. Vous aurez ensuite acce\u0300s a\u0300 notre Photo Booth\r\nou\u0300 vous pourrez repartir avec un cliche\u0301 original marquant votre passage chez Imagine Belgium.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Imagine Belgium","address_street_name":"Heuvelstraat","address_street_number":"24","address_street_box":null,"email":"booking@imaginebelgium.be","website":"http:\/\/www.imaginebelgium.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Heuvelstraat, 24","address_line2":"1000 Brussel","description_web":"Dankzij een ultrarealistisch vlieggevoel en meeslepende 360\u00b0-beelden \"stijgt\" de bezoeker op van de Grote Markt voor een vlucht van 15 minuten rond Belgie\u0308. Een originele manier om het land te verkennen, comfortabel en uitgerust met een VR-headset. Flybox wil een culturele en leuke activiteit zijn, toegankelijk voor iedereen.\r\nDe VR Flybox reis duurt 15 minuten. Daarna krijgt u toegang tot onze fotobooth waar je originele foto's kan nemen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Imagine Belgium","address_street_name":"Rue de la Colline","address_street_number":"24","address_street_box":null,"email":"booking@imaginebelgium.be","website":"http:\/\/www.imaginebelgium.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de la Colli