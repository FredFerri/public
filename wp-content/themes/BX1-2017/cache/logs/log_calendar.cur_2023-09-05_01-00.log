T09:46:42+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":238575,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.10938779812488153,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[105],"translations":{"de":["Gastronomie"],"pt":[null],"en":["Gastronomy"],"it":["Cucina"],"cn":[null],"fr":["Gastronomie"],"sp":["Gastronom\u00eda"],"nl":["Gastronomie"]}}},"translations":{"de":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.518575"},"pt":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.518575"},"en":{"name":"Espresso Lover Coffee Tour","shortdescr":"During this Espresso Lover Coffee Tour, you will learn about the espresso world in all its splendor and diversity. Hosted in EN & FR.","longdescr":"ESPRESSO LOVER COFFEE TOUR\r\n\r\nDuring this Espresso Lover Coffee Tour, you will learn about the espresso world in all its splendor and diversity. \r\n\r\nFrom shot to shot, you will discover espresso and its complex taste palette, but also better understand the baristas and the equipment dedicated to its preparation... Be ready!\r\n\r\n- 6 innovative places (sometimes a little more or a little less depending on the area)\r\n- 4 hours of advice and fun\r\n- 1 unique neighborhood experience around espresso in all its diversity\r\n\r\nAt the end of the Espresso Lover Coffee Tour, you'll know a little more about\r\n- Specialty coffee, its terroirs and its values\r\n- how to taste and appreciate an espresso\r\n- the importance of the baristas\r\n- the machines and grinders that make the difference\r\n- where to drink in your favorite neighborhood\r\n- whether or not to invest in a machine for your home\r\n\r\nWho is it for?\r\nThe Espresso Lover Coffee Tours are aimed at espresso lovers, but also at professionals in the hospitality industry.\r\n\r\nThe Coffee Tours last on average 4 hours, are totally outdoor (dress accordingly!!) and do not end at the starting point. \r\n\r\nMore practical information when you make your reservation.\r\n\r\nDiscover, taste, enjoy... do it again!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.518575"},"it":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.518575"},"cn":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.518575"},"fr":{"name":"Espresso Lover Coffee Tour","shortdescr":"Lors de ce Espresso Lover Coffee Tour, vous appr\u00e9henderez la plan\u00e8te espresso dans toute sa splendeur et sa diversit\u00e9. Donn\u00e9 en FR & EN.","longdescr":"ESPRESSO LOVER COFFEE TOUR\r\n\r\nLors de ce Espresso Lover Coffee Tour, vous appr\u00e9henderez la plan\u00e8te espresso dans toute sa splendeur et sa diversit\u00e9. \r\n\r\nDe shots en shots, vous allez d\u00e9couvrir l\u2019espresso et sa palette gustative complexe, mais aussi mieux comprendre les baristas et le mat\u00e9riel d\u00e9di\u00e9 \u00e0 sa r\u00e9alisation\u2026 soyez pr\u00eat.e !\r\n\r\n- 6 lieux innovants (parfois un peu plus ou un peu moins selon le quartier)\r\n- 4h de conseils et de fun\r\n- 1 exp\u00e9rience de quartier unique autour de l\u2019espresso dans toute sa diversit\u00e9\r\n\r\n\u00c0 la fin du Espresso Lover Coffee Tour, vous en saurez un peu plus sur\r\n- le Caf\u00e9 de Sp\u00e9cialit\u00e9, ses terroirs et ses valeurs\r\n- comment go\u00fbter et appr\u00e9cier un espresso\r\n- l\u2019importance du m\u00e9tier de barista\r\n- les machines et moulins qui font la diff\u00e9rence\r\n- o\u00f9 consommer dans votre quartier pr\u00e9f\u00e9r\u00e9\r\n- investir ou pas dans une machine pour la maison\r\n\r\nPour qui ?\r\nLes Espresso Lover Coffee Tours s\u2019adressent aux amateur.ices d\u2019espresso, mais aussi aux professionnel.les de l\u2019horeca.\r\n\r\nLes Coffee Tours durent en moyenne 4h, se passent totalement en ext\u00e9rieur (bien s\u2019habiller en cons\u00e9quence!!) et ne se terminent pas au point de d\u00e9part. \r\n\r\nPlus d\u2019infos pratiques lors de la r\u00e9servation.\r\n\r\nD\u00e9couvrez, go\u00fbtez, appr\u00e9ciez\u2026 recommencez !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.518575"},"sp":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website"