"tags":["kids"],"accessibilities":{"list":[255,265,266],"translations":{"fr":["Accessible","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Adapted toilet","Brussels Health Safety Label"],"de":["Barrierefrei","Barrierefreies WC","Brussels Health Safety Label"],"it":["Accessibile","WC idoneo","Brussels Health Safety Label"],"sp":["Habilitado","Ba\u00f1os adaptados","Brussels Health Safety Label"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-05T02:38:24+02:00","published_at":"2022-08-10T15:07:37+02:00","backoffice_id":259470,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.19946949352953},{"id":539551,"date_start":"2022-08-11","date_end":"2024-01-06","date_next":"2023-07-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Parcours BD de Bruxelles","shortdescr":"Ce parcours guid\u00e9 de la bande dessin\u00e9e \u00e0 Bruxelles est une activit\u00e9 id\u00e9ale \u00e0 faire en famille, entre amis ou entre coll\u00e8gues. En effet, cette balade d\u2019environ 3 heures nous permettra de d\u00e9couvrir les personnages les plus c\u00e9l\u00e8bres de la bande dessin\u00e9e belge de Tintin \u00e0 Ast\u00e9rix en passant par les Schtroumpfs, tous seront pr\u00e9sent lors de notre balade.","longdescr":"Programme :\r\n\r\nHerg\u00e9 \u2013 Tintin en Am\u00e9rique.\r\nOlivier Rameau.\r\nLe Passage de Fran\u00e7ois Schuiten.\r\nBroussaille de Frank P\u00e9.\r\nVictor Sackeville.\r\nRic Hochet.\r\nN\u00e9ron.\r\nL\u2019Ange.\r\nLucky Luke.\r\nAst\u00e9rix.\r\nLes r\u00eaves de Nic.\r\nCori le Moussaillon.\r\nGaston Lagaffe.\r\nPoje.\r\nSculpture Schtroumpf.\r\n \r\n\r\nInformations pratiques :\r\n\r\nPrix :\r\nAdultes : 35\u20ac\r\nEnfants (de 6 \u00e0 12 ans) : 20\u20ac\r\nEnfants (moins de 6 ans) : Gratuit.\r\n\r\nQuand :\r\nTous les dimanches.\r\n\r\nHeures de d\u00e9part :\r\n10h30\r\n\r\nPoint de rencontre :\r\nLa Grand-Place de Bruxelles, en face de l\u2019H\u00f4tel de ville. Vous reconna\u00eetrez nos guides gr\u00e2ce \u00e0 leur parapluie blanc muni du logo Bravo Discovery.\r\n\r\nDur\u00e9e :\r\nEnviron 3h.\r\n\r\nLangue :\r\nFran\u00e7ais.\r\n\r\nInclus :\r\nGuide francophone passionn\u00e9 et professionnel.\r\n\r\nNon inclus : Entr\u00e9e aux mus\u00e9es\r\nBrussels Comic Book Route","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539551"},"nl":{"name":"Parcours BD de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539551"},"en":{"name":"Brussels Comic Book Route","shortdescr":"Not only is Brussels the capital of Belgium and Europe, it is also the capital of Comic strip. Comic strip images are scattered around the streets telling the adventures of iconic characters such as Tintin, Lucky Luke, the Smurfs or Quick & Flupke.","longdescr":"Program:\r\n\r\nHerg\u00e9 \u2013 Tintin in America.\r\nOlivier Rameau.\r\nLe Passage de Fran\u00e7ois 