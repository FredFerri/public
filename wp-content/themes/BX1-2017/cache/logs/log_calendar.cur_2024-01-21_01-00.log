et"]}},"recurring":[{"day":"saturday","occurences":{"is_last":false,"is_fourth":false,"is_third":false,"is_second":false,"is_first":true},"time_start":"10:00:00","time_end":"20:00:00","translations":{"fr":"Ouvert le premier, samedi du mois de 10:00 \u00e0 20:00","nl":"Open op de eerste, zaterdag van de maand van 10:00 tot 20:00","en":"Open the first, saturday of the month from 10:00 to 20:00"}}],"targets":{"list":[12],"translations":{"de":["LGTBQIA"],"pt":[null],"en":["LGTBQIA"],"it":["LGTBQIA"],"cn":[null],"fr":["LGTBQIA"],"sp":["LGTBQIA"],"nl":["LGTBQIA"]}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50005812,"date_start":"2024-01-04","date_end":"2024-02-04","date_next":"2024-02-04","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-01-06T01:03:10+01:00","published_at":"2024-01-04T18:42:13+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":291922,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3149802624737183,"languages":{"spoken":["en","de","pl","pt","it","es","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Piotr Butkiewicz \/ Halinka Jakubowska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/napiorkowska.pl\/language\/en\/piotr-butkiewicz-and-halinka-jakubowska\/","email":"galeria@napiokowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005812"},"pt":{"name":"Piotr Butkiewicz \/ Halinka Jakubowska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/napiorkowska.pl\/language\/en\/piotr-butkiewicz-and-halinka-jakubowska\/","email":"galeria@napiokowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005812"},"en":{"name":"Piotr Butkiewicz \/ Halinka Jakubowska","shortdescr":"Exhibition of two artists presenting paintings and sculptures by award-winning artists. Piotr Butkiewicz wishes to reach total autonomy in paintings; Halinka Jakubowska seeks to underline the natural features of the materials she uses. ","longdescr":"Participating artists: \nPIOTR BUTKIEWICZ\n\u201cMy painting is an attempt to tame and transform the surrounding reality into my own.\nFor many years I dealt mainly with landscape \u2013 with its mood, light, and variability. For almost ten years, it has been evolving towards less concrete forms, narratives built in the language of free gesture, abstractions and actions freed from the dictates of reason.\nThe subjects that I undertake, as well as the painting process itself, are usually intimate, e.g. relationships of forms, delight, eluding, breathing, and depth. I want painting to be something liberated and separate from the hard reality, it could be a counterweight to it. (...)\nMy painting is a way to discover yourself, it doesn\u2019t have to be smart or have any particular purpose. I am for completely free painting, I am even for liberating painting from art.\u201d\nPiotr Butkiewicz\n\nPiotr Butkiewicz (born in 1966) obtained his diploma at the Academy of Fine Arts in Wroc\u0142aw. He graduated in 1991 in the sculpture studio of Prof. Leon Podsiad\u0142y. He practices painting and sculpture. His artwork was presented in individual exhibitions in Poland and Europe (Gallery Bell\u2019 Arte, Berlin, Gallery OmaHoune, Helsinki, Kreismuseum, Ludwigshafen and many others). Butkiewicz participated also in the movie project of A. \u017bmijewski \u201cA souvenir from Cellulose\u201d.\n\nHALINKA JAKUBOWSKA \n\"My work begins with a walk in the quarries, in the foundry, in the workshop...\nThis is where I find inspiration for my sculptures.\nSuddenly something catches my attention, speaks to me, inspires me: a shape, a crack or a rough structure... And the creative work begins.\"\nHalinka Jakubowska\n\nHalinka Jakubowska studied sculpture at the Acad\u00e9mie Royale des Beaux-Arts in Li\u00e8ge and the Akademie voor Beeldende Kunsten in Brussels. She exhibited her works at individual exhibitions and took part in numerous group exhibitions in Belgium, Poland, France, Switzerland, the Netherlands, Luxembourg, Germany, Italy, Spain and Turkey. Jakubowska\u2019s works can be found in collections throughout Europe and are displayed in public spaces as well (in Li\u00e8ge, the Embassy of the Republic of Poland in Brussels, as well as in Italy and Spain).\nThe artist received the Golden Cross of Merit in 2015, the title of \u201cthe Pole of the Year in Belgium\u201d award in the field of Culture and Science in 2011 and numerous other awards and recognitions in the field of fine arts.","performers":null,"boxoffice_url":null,"website":"https:\/\/napiorkowska.pl\/language\/en\/piotr-butkiewicz-and-halinka-jakubowska\/","email":"galeria@napiokowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005812"},"it":{"name":"Piotr Butkiewicz \/ Halinka Jakubowska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/napiorkowska.pl\/language\/en\/piotr-butkiewicz-and-halinka-jakubowska\/","email":"galeria@napiokowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005812"},"cn":{"name":"Piotr Butkiewicz \/ Halinka Jakubowska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/napiorkowska.pl\/language\/en\/piotr-butkiewicz-and-halinka-jakubowska\/","email":"galeria@napiokowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005812"},"fr":{"name":"Piotr Butkiewicz \/ Halinka Jakubowska","shortdescr":"Exposition de deux artistes pr\u00e9sentant des peintures et sculptures. Piotr Butkiewicz souhaite atteindre une autonomie totale dans la peinture ; Halinka Jakubowska cherche \u00e0 souligner les caract\u00e9ristiques naturelles des mat\u00e9riaux qu'elle utilise.","longdescr":"ARTISTES: \nPIOTR BUTKIEWICZ \t\n\"Ma peinture est une tentative d'apprivoiser et de transformer la r\u00e9alit\u00e9 environnante en la mienne.\nDepuis de nombreuses ann\u00e9es, je me pr\u00e9occupe principalement du paysage - avec son ambiance, sa lumi\u00e8re, sa variabilit\u00e9. Depuis pr\u00e8s de dix ans, il \u00e9volue vers des formes moins sp\u00e9cifiques, un r\u00e9cit construit dans le langage du geste libre, de l'abstraction et de l'action. libre des diktats de la raison.\nLes th\u00e8mes que j'aborde, tout comme le processus de peinture lui-m\u00eame, sont le plus souvent intimes et intimistes. (...)\nJe veux que la peinture soit quelque chose de libre et s\u00e9par\u00e9 de la dure r\u00e9alit\u00e9, capable de lui faire contrepoids. (...)\nMa peinture est une fa\u00e7on de me d\u00e9couvrir, elle n'a pas besoin d'\u00eatre intelligente ou d'avoir un but. Je suis pour une peinture totalement libre, je suis m\u00eame pour une lib\u00e9ration de la peinture de l\u2019art.\nPiotr Butkiewicz\n\nPiotr Butkiewicz (n\u00e9 en 1966) a \u00e9tudi\u00e9 \u00e0 l'Acad\u00e9mie des Beaux-Arts de Wroc\u0142aw, o\u00f9 en 1991 dans l'atelier de sculpture du prof. L\u00e9on Podsiad\u0142y a d\u00e9fendu son dipl\u00f4me. Il s'occupe de sculpture et de peinture. Il a pr\u00e9sent\u00e9 ses \u0153uvres lors de nombreuses expositions individuelles et collectives nationales et \u00e9trang\u00e8res. Il a expos\u00e9 ses \u0153uvres dans le cadre de la pr\u00e9sentation de la Basse-Sil\u00e9sie \u00e0 l'EXPO 2000 de Hanovre. Il a expos\u00e9, entre autres, \u00e0 Berlin, La Haye, Wroc\u0142aw, Bruxelles, Helsinki, Kleinniedesheim et \u0141\u00f3d\u017a. Il a particip\u00e9 \u00e0 l'exposition \u00ab Places not Places \u00bb au Centre de sculpture d'Oro\u0144sko. Il a \u00e9galement particip\u00e9 au projet et au film d'Artur \u017bmijewski intitul\u00e9 \"Souvenir from Cellulose\".\n\nHALINKA JAKUBOWSKA \n\"Mon travail commence par une promenade dans les carri\u00e8res, \u00e0 la fonderie, \u00e0 l'atelier...\nC'est l\u00e0 que je trouve l'inspiration pour mes sculptures.\nSoudain, quelque chose attire mon attention, me parle, m'inspire: une forme, une fissure ou une structure brute...\nEt ainsi le travail cr\u00e9atif commence.\"\nHalinka Jakubowska \n\nHALINKA JAKUBOWSKA est dipl\u00f4m\u00e9e en sculpture de l'Acad\u00e9mie Royale des Beaux-Arts de Li\u00e8ge et de l'Akademie voor Beeldende Kunsten de Bruxelles. La sculpteure utilise dans ses \u0153uvres ses mat\u00e9riaux de pr\u00e9dilection : le bronze, l'acier, les scories et la pierre.\nElle affectionne particuli\u00e8rement la pierre bleue belge \u2013 aussi appel\u00e9e \u00ab petit granite-pierre bleue \u00bb et obtenue en Belgique, dans la r\u00e9gion de Soignies.\nL'artiste exp\u00e9rimente avec la texture, la couleur et la forme, en mettant en avant  les caract\u00e9ristiques naturelles du mat\u00e9riau. L'artiste a expos\u00e9 ses \u0153uvres lors d'expositions individuelles et a particip\u00e9 \u00e0 de nombreuses expositions collectives en Belgique, Pologne, France, Suisse, Pays-Bas, Luxembourg, Allemagne, Italie, Espagne et Turquie. Les \u0153uvres de Jakubowska font partie de collections dans toute l'Europe et sont \u00e9galement expos\u00e9es dans l'espace public (notamment \u00e0 Li\u00e8ge, \u00e0 l'Ambassade de la R\u00e9publique de Pologne \u00e0 Bruxelles, ainsi qu'en Italie et en Espagne).","performers":null,"boxoffice_url":null,"website":"https:\/\/napiorkowska.pl\/language\/en\/piotr-butkiewicz-and-halinka-jakubowska\/","email":"galeria@napiokowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005812"},"sp":{"name":"Piotr Butkiewicz \/ Halinka Jakubowska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/napiorkowska.pl\/language\/en\/piotr-butkiewicz-and-halinka-jakubowska\/","email":"galeria@napiokowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005812"},"nl":{"name":"Piotr Butkiewicz \/ Halinka Jakubowska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/napiorkowska.pl\/language\/en\/piotr-butkiewicz-and-halinka-jakubowska\/","email":"galeria@napiokowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005812"}},"place":{"id":251322,"translations":{"de":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"website":"http:\/\/www.napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Mont des Arts, 8","address_line2":"1000 Bruxelles","description_web":null,"desc