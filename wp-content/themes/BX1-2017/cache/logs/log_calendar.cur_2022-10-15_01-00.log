n":{"lat":50.84321233,"lon":4.35747449},"region":"brussels","last_updated_at":"2022-10-13T13:35:11+02:00","published_at":"2013-10-19T01:13:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/b19373b6cb802471083441f126724e25573de266.jpg","width":6000,"height":4000,"ratio":1.5,"translations":{"fr":{"title":"Concert de midi : Georgia Koumentakou","copyright":null},"nl":{"title":"Concert de midi : Georgia Koumentakou","copyright":null},"en":{"title":"Concert de midi : Georgia Koumentakou","copyright":null}}}],"dates":[{"day":"2022-10-24","doors":null,"start":"12:30:00","end":"13:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,261,263,265],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-13T13:35:11+02:00","published_at":"2022-10-06T11:13:00+02:00","backoffice_id":263590,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":538291,"date_start":"2022-10-25","date_end":"2022-10-25","date_next":"2022-10-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes"}},"others":{"list":[89],"translations":{"fr":["Litt\u00e9rature"],"nl":["Literatuur"],"en":["Litterature "],"de":["Literatur"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Rencontre avec Zainab Fasiki","shortdescr":"La b\u00e9d\u00e9iste marocaine Zainab Fasiki pr\u00e9sente son ouvrage Hshouma, qui vise \u00e0 briser les tabous autour de la sexualit\u00e9 au Maroc et surtout \u00e0 changer la fa\u00e7on de voir la nudit\u00e9 et les femmes.","longdescr":"Zainab Fasiki est n\u00e9e le 21 juillet 1994 \u00e0 F\u00e8s, au Maroc. Int\u00e9ress\u00e9e par le dessin et la robotique d\u00e8s l\u2019\u00e2ge de 5 ans, elle d\u00e9croche le dipl\u00f4me de technicienne sup\u00e9rieure en m\u00e9canique en 2014, class\u00e9e premi\u00e8re dans cette fili\u00e8re dans son pays. Elle poursuit \u00e0 l'\u00c9cole nationale sup\u00e9rieure d\u2019\u00e9lectricit\u00e9 et de m\u00e9canique de Casablanca, dont elle sort dipl\u00f4m\u00e9e ing\u00e9nieure d\u2019\u00e9tat en m\u00e9canique en 2017. \r\n\r\nElle commence \u00e0 dessiner des bandes dessin\u00e9es \u00e0 16 ans gr\u00e2ce \u00e0 sa tablette graphique et \u00e0 son ordinateur dans sa chambre. \u00c0 cause des discriminations sexistes qui r\u00e8gnent dans le domaine de la m\u00e9canique, mais aussi du harc\u00e8lement dans la rue et du contr\u00f4le de sa famille, Zainab trouve dans le dessin sa fa\u00e7on de s\u2019en sortir : elle se dessine nue et le partage avec les internautes pour prouver \u00e0 tout le monde qu\u2019elle vivra comme elle le souhaite. \r\n\r\nApr\u00e8s avoir collabor\u00e9 \u00e0 plusieurs projets artistiques, elle d\u00e9cide de se consacrer \u00e0 sa carri\u00e8re d\u2019artiste. Elle cr\u00e9e le collectif Women Power qui encourage les femmes artistes marocaines via des ateliers et r\u00e9alise son projet Hshouma qui vise \u00e0 briser les tabous au Maroc et surtout \u00e0 changer la fa\u00e7on de voir la nudit\u00e9 et les femmes. \r\n\r\nPour tous ses efforts, Zainab a \u00e9t\u00e9 honor\u00e9e par l\u2019organisation Amnesty International, lors de la Journ\u00e9e internationale des femmes d\u00e9fenseures des droits humains, le 29 novembre 2018, \u00e0 Rabat, au Maroc. En octobre 2019, au cours de sa formation sur les caricatures politiques aux \u00c9tats-Unis, elle a \u00e9t\u00e9 nomm\u00e9e par TIME Magazine une Next Generation Leader pour son guide dessin\u00e9 Hshouma.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538291"},"nl":{"name":"Rencontre avec Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538291"},"en":{"name":"Rencontre avec Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538291"},"de":{"name":"Rencontre avec Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538291"},"it":{"name":"Rencontre avec Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538291"},"sp":{"name":"Rencontre avec Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,