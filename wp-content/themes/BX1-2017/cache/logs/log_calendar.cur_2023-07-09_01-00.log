3-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes","it":"Varie","sp":"Varios","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Appel au don d'Archives LGBTQIA+ sur le mariage homosexuel","shortdescr":"Les Archives de la Ville de Bruxelles lanceront un appel au don d\u2019archives LGBTQIA+ sur le th\u00e8me du mariage.","longdescr":"En 2023, nous c\u00e9l\u00e9brons avec fiert\u00e9 les 20 ans de la promulgation de la loi autorisant le mariage des personnes de m\u00eame sexe. La Ville de Bruxelles, au travers de l\u2019initiative de ses Mus\u00e9es et ses Archives souhaite que cet anniversaire soit marqu\u00e9 dans le temps. Les Archives de la Ville de Bruxelles lanceront un appel au don d\u2019archives LGBTQIA+ sur le th\u00e8me du mariage via une distribution de flyers chez les partenaires de la Pride Week et par une campagne d\u2019affichage dans les lieux de la communaut\u00e9 \u00e0 Bruxelles et chez les commer\u00e7ant\u00b7e\u00b7s du centre-ville. Les donateur\u00b7ice\u00b7s sont invit\u00e9\u00b7e\u00b7s \u00e0 prendre rendez-vous aux Archives, rue des Tanneurs pour faire leurs dons.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.archives.bruxelles.be","email":"archives@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.556978"},"nl":{"name":"Oproep voor schenkingen van  LGBTQIA+- Archieven over het homohuwelijk","shortdescr":"Het Archief van de Stad Brussel zal een oproep lanceren voor schenkingen \r\nvan LGBTQIA+-archieven over het thema van het \r\nhuwelijk.","longdescr":"In 2023 vieren we met trots 20 jaar sinds de uitvaardiging van de wet die het homohuwelijk toelaat. De Stad Brussel wil, via het initiatief van haar Musea en Archief, dat deze verjaardag door herinneringen uit de tijd wordt ge\u00efllustreerd. Het Archief van de Stad Brussel zal een oproep lanceren voor schenkingen van LGBTQIA+-archieven over het thema van het huwelijk via de verspreiding van flyers bij partners van de Pride Week en via een postercampagne op locaties van de gemeenschap in Brussel en bij \r\nhandelaars in het stadscentrum. Schenkers worden uitgenodigd een afspraak te maken met het Archief, Huidevettersstraat om hun schenkingen te doen.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussel.be","email":"archives@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.556978"},"en":{"name":"Call for donations  of LGBTQIA+  archives on same-sex marriage","shortdescr":"The Archives of the City of Brussels will launch a call for donations of LGBTQIA+ archives \r\non the theme of marriage.","longdescr":"In 2023, we proudly celebrate 20 years since the enactment of the law allowing same-sex marriage. The City of Brussels, through the initiative of its Museums and Archives, would like this anniversary to be marked in time. The Archives of the City of Brussels will launch a call for donations of LGBTQIA+ archives on the theme of marriage. Flyers will be distributed by Pride Week partners and there will be a poster \r\ncampaign in community venues in Brussels and in city centre shops. Donors are invited to make an appointment at the Archives, rue des Tanneurs to make their donations.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.archives.bruxelles.be","email":"archives@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.556978"},"de":{"name":"Appel au don d'Archives LGBTQIA+ sur le mriage homosexuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archives.bruxelles.be","email":"archives@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.556978"},"it":{"name":"Appel au don d'Archives LGBTQIA+ sur le mriage homosexuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archives.bruxelles.be","email":"archives@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.556978"},"sp":{"name":"Appel au don d'Archives LGBTQIA+ sur le mriage homosexuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archives.bruxelles.be","email":"archives@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.556978"},"pt":{"name":"Appel au don d'Archives LGBTQIA+ sur le mriage homosexuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archives.bruxelles.be","email":"archives@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.556978"},"cn":{"name":"Appel au don d'Archives LGBTQIA+ sur le mriage homosexuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archives.bruxelles.be","email":"archives@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.556978"}},"place":{"id":210334,"translations":{"fr":{"name":"Archives de la Ville de Bruxelles","address_street_name":"Rue des Tanneurs","address_street_number":"65","address_street_box":null,"email":"archives@brucity.be","website":"http:\/\/archives.bruxelles.be","phone_contact":"+32 2 279 5