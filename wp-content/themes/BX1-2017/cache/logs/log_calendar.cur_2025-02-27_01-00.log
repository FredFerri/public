establishment?","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brussels By Foot","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@brusselsbyfoot.com","website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","phone_contact":"+32 472 39 82 17","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Brussels By Foot","address_line2":"1000 Brussel","description_web":"Brussels By Foot is een klein bedrijf dat ongewone rondleidingen door Brussel aanbiedt. Ze cre\u00ebren thematische rondleidingen om u Brussel te laten ontdekken vanuit heel bijzondere en soms verrassende invalshoeken... Als gepassioneerde Brusselaars nemen ze je mee door de straten en steegjes van Brussel en tonen ze je de stad zoals zij die kennen, zoals zij ervan houden.\n\nStadslegendes, sociale strubbelingen, misdaadsc\u00e8nes, Art Nouveau of andere thema's, ga met ze mee en ontdek Brussel zoals je het nog nooit hebt gezien!\n\nDe rondleidingen zijn beschikbaar op inschrijving via de website, maar op verzoek kunnen er ook priv\u00e9rondleidingen voor groepen worden geregeld. Als onderdeel van deze priv\u00e9-ervaringen kunt u de rondleiding combineren met een chocoladeproeverij, een goed gebrouwen aperitief of een maaltijd in een authentiek Brussels etablissement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":41819,"location":{"lat":50.8446735,"lon":4.3500613},"last_updated_at":"2025-01-27T10:36:39+01:00","published_at":"2024-01-20T21:02:59+01:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/a4173a2071c84f79971f63e2b9979c108850bc49.jpg","width":960,"height":710,"ratio":1.35,"oEmbed_height":710,