ons":{}},"tags":["major_event"],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-04T16:05:11+02:00","published_at":"2022-04-20T16:04:10+02:00","backoffice_id":252273,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":1},{"id":538087,"date_start":"2022-09-23","date_end":"2022-09-24","date_next":"2022-09-23","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Zohra's Feestje","shortdescr":"Le fiasco de la f\u00eate d\u2019anniversaire de Yamina devient un pr\u00e9texte pour traverser la m\u00e9moire de sa grand-m\u00e8re Zohra. N\u00e9e en Alg\u00e9rie, elle nous expose \u00e0 l\u2019odeur des oliviers et de ses grands voyages.","longdescr":"Yamina a huit ans et n'aime pas les f\u00eates d'anniversaire. Lorsque sa grand-m\u00e8re Zohra a 70 ans, sa m\u00e8re Fadila lui organise un anniversaire surprise. Mais grand-m\u00e8re Zohra n'est pas du tout f\u00eatarde et la f\u00eate tourne au fiasco. Yamina se demande pourquoi sa grand-m\u00e8re n'aime pas les f\u00eates, elle aussi. Ensemble, elles partent en voyage dans les souvenirs de Zohra, \u00e0 la recherche d\u2019une r\u00e9ponse. Souvenirs de l'Alg\u00e9rie, son pays de naissance, des arbres pleins d'olives, de l'\u00e2ne Bakri et de son voyage de grand-m\u00e8re Zohra vers la Belgique.\r\n\r\nVendredi 23 septembre : 11h (NL) - 13h30 (FR)\r\nSamedi 24 septembre : 16h (FR)\r\n\r\nTh\u00e9matique : Patrimoine - Syst\u00e8me d'exploitation\r\nParcours : R\u00eaver - Apprendre - Contester \r\n\r\n\r\nDistribution et cr\u00e9dits : \r\nDE ET AVEC Yamina Takkatz \u00b7 MISE EN SC\u00c8NE Michai Geyzen \u00b7 TEXTE Yamina Takkatz, Michai Geyzen. JEU Yamina Takkatz et Anna Saveniers (NL), Sanae Saidi-Leclere (FR) \u00b7 COMPOSITION Han Stubbe \u00b7 ANIMATION Yamina Takkatz \u00b7 DRAMATURGIE Ans Vroom \u00b7 PAROLES Gunter Nagels \u00b7 LUMI\u00c8RES Jeroen Wutz \u00b7 SC\u00c9NOGRAPHIE Ruby Renteurs \u00b7 REMERCIEMENTS \u00e0 Khalid Koujili El Yakoubi, C\u00e9line Felga et Sarah Vermeyen \u00b7 AVEC LE SOUTIEN DE Stad Antwerpen & De Studio","performers":"ZEBARBAR & De Studio","boxoffice_url":null,"website":"https:\/\/www.famefestival.be","email":"ticket@famefestival.be","phone_contact":null,"phone_booking":"+32 474 30 96 81","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538087"},"nl":{"name":"Zohra's Feestje","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538087"},"en":{"name":"Zohra's Feestje","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538087"},"de":{"name":"Zohra's Feestje","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538087"},"it":{"name":"Zohra's Feestje","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/eve