,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-20T02:02:46+01:00","published_at":"2025-01-30T08:28:47+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317145,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":0.2068428527328215,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[10,4],"translations":{"de":["Jazz & Blues","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Jazz & Blues","Pop, rock, jazz\u2026"],"it":["Jazz e Blues","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Jazz & Blues","Pop, rock, jazz\u2026"],"sp":["Jazz y blues","Pop, rock, jazz\u2026"],"nl":["Jazz & Blues","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"The Jazz Wednesdays: Stories & Music","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment\/1551335","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005983"},"pt":{"name":"The Jazz Wednesdays: Stories & Music","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment\/1551335","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005983"},"en":{"name":"House Concerts: The Jazz Wednesdays - Stories & Music","shortdescr":"\u201cThe Jazz Wednesdays: Stories & Music\u201d, a series of evenings dedicated to discovering the great figures in jazz history. These events will take place one Wednesday per month, from February to June 2025, at the Jazz House. More info at the link below! NO BAR SERVICE!\n\nEach evening will start at 7:00 PM with a presentation and guided listening session, followed by a live concert at 7:30 PM.","longdescr":null,"performers":"More info at the event link!","boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment\/1551335","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005983"},"it":{"name":"The Jazz Wednesdays: Stories & Music","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment\/1551335","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005983"},"cn":{"name":"The Jazz Wednesdays: Stories & Music","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment\/1551335","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005983"},"fr":{"name":"House Concerts: Les mercredis jazz \u2013 Histoires et musique","shortdescr":"\u201cHouse concerts: Les Mercredis du Jazz - Histoires et Musique\u201d, s\u00e9rie de soir\u00e9es d\u00e9di\u00e9es \u00e0 la d\u00e9couverte des grandes figures de l\u2019histoire du jazz. Un mercredi par mois, de f\u00e9vrier \u00e0 juin 2025, dans une maison priv\u00e9. Plus d\u2019infos dans le lien ci-dessous ! Chaque soir\u00e9e d\u00e9butera \u00e0 19h00 par une pr\u00e9sentation et une s\u00e9ance d\u2019\u00e9coute comment\u00e9e, suivies d\u2019un concert live \u00e0 19h30. PAS DE BAR!\n","longdescr":"19 f\u00e9vrier 2025 - Angelo Gregorio & Paolo Loveri | L\u2019histoire des duos jazz\n\nMusicien \u00e0 d\u00e9couvrir : Duke Ellington - Biographie : Duke Ellington (1899-1974) est l\u2019un des plus grands compositeurs et chefs d\u2019orchestre de l\u2019histoire du jazz. Cr\u00e9ateur de morceaux immortels tels que Take the \u201cA\u201d Train et Mood Indigo, il a transform\u00e9 le big band jazz en une forme d\u2019art sophistiqu\u00e9e.\n\nFormation : Duo \u2013 Saxophone (Angelo Gregorio) et Guitare (Paolo Loveri).\n\n\n\n26 mars 2025 - Ceci n\u2019est pas un Trio | L\u2019histoire des Hammond Trio\n\nMusicien \u00e0 d\u00e9couvrir : Jimmy Smith - Biographie : Jimmy Smith (1925-2005) a r\u00e9volutionn\u00e9 l\u2019utilisation de l\u2019orgue Hammond dans le jazz. Avec son style innovant et son groove captivant, il a d\u00e9fini le soul jazz et influenc\u00e9 des g\u00e9n\u00e9rations de musiciens.\n\nFormation : Trio \u2013 Saxophone (Angelo Gregorio), Hammond (Julien Gillain) et Batterie (Lucas Vanderputten).\n\n\n\n16 avril 2025 - The Hipster Project | Le hard bop des ann\u00e9es 70\n\nLa conf\u00e9rence sera tenue en compagnie de Michel Mainil.\n\nMusicien \u00e0 d\u00e9couvrir : Art Blakey - Biographie : Art Blakey (1919-1990), batteur et leader des Jazz Messengers, est une figure embl\u00e9matique du hard bop. Avec ses rythmes puissants et dynamiques, il a marqu\u00e9 l\u2019histoire du jazz et r\u00e9v\u00e9l\u00e9 des talents tels que Wayne Shorter et Freddie Hubbard.\n\nFormation : Quintette \u2013 Trompette, Saxophone, Contrebasse, Piano et Batterie.\n\n\n\n28 mai 2025 - The Jazz Sailor | Concert immersif sur le th\u00e8me de l'eau\n\nUne exp\u00e9rience unique alliant musique, narration et projections d\u2019images, explorant le th\u00e8me de l\u2019eau. Inspir\u00e9 par la recherche cr\u00e9ative d\u2019Angelo Gregorio, ce projet c\u00e9l\u00e8bre la beaut\u00e9 de la nature \u00e0 travers le jazz.\n\nFormation : Quintette \u2013 Saxophone, Guitare, Piano, Batterie et Contrebasse, avec narration et projections.\n\n\n\n11 juin 2025 - Carla Piombino 4tet | La voix f\u00e9minine dans le jazz\n\nLa conf\u00e9rence sera tenue en compagnie de Flavio Spampinato.\n\nMusicienne \u00e0 d\u00e9couvrir : Nina Simone - Biographie : Nina Simone (1933-2003), surnomm\u00e9e la \u201cGrande Pr\u00eatresse de la Soul\u201d, \u00e9tait une chanteuse, pianiste et militante des droits civiques. Avec des morceaux comme Feeling Good et Mississippi Goddam, elle a m\u00eal\u00e9 jazz, blues et soul avec un engagement social puissant.\n\nFormation : Quartet \u2013 Voix (Carla Piombino), Contrebasse, Piano et Batterie.","performers":"Plus d'info sur le lien de l'evenement!","boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment\/1551335","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005983"},"sp":{"name":"The Jazz Wednesdays: Stories & Music","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment\/1551335","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005983"},"nl":{"name":"Huiskamerconcerten: De jazzwoensdagen \u2013 Verhalen & muziek","shortdescr":"\u201cDe Jazz Woensdagen: Verhalen & Muziek\u201d, een reeks avonden gewijd aan het ontdekken van de grote figuren uit de jazzgeschiedenis. Deze evenementen vinden \u00e9\u00e9n woensdag per maand plaats, van februari tot juni 2025. Meer info via de link hieronder! Elke avond begint om 19:00 uur met een presentatie en een begeleide luistersessie, gevolgd door een liveconcert om 19:30 uur. Er is geen bar voorzien.","longdescr":null,"performers":"Meer info via de link van het evenement!","boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment\/1551335","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brusse