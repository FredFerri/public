is_soldout":false,"last_updated_at":"2024-02-08T01:05:16+01:00","published_at":"2024-01-19T08:50:10+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292729,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.22191822427467614,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[251],"translations":{"de":["Zeitgen\u00f6ssische Kunst "],"pt":[null],"en":["Contemporary Art"],"it":["Arte contemporanea "],"cn":[null],"fr":["Art Contemporain "],"sp":["Arte contempor\u00e1neo "],"nl":["Hedendaagse Kunst"]}}},"translations":{"de":{"name":"Nocturnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006253"},"pt":{"name":"Nocturnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006253"},"en":{"name":"Nocturnes","shortdescr":"Every first Wednesday of the month, WIELS opens its doors until 21:00! This is your chance to visit our exhibitions in the evening and to enjoy relaxed guided tours.\n\n\n","longdescr":"18:00-19:00 I APERO TOURS (FR\/NL\/EN)\n\nEach Nocturne, join our Ap\u00e9ro Tour, a guided tour during which one of the WIELS guides takes you through the current exhibitions and enjoy a drink of your choice at the WIELS\u2019 Caf\u00e9 before or after the visit. Join our guides and discover the exhibitions differently!\n\nEntrance ticket + \u20ac 7\n\n18:00-19:00 I KETS TOUR (FR\/NL)\n\nFor kids, WIELS offers the Kets Tour - an evening-time guided tour specially conceived for the little ones. At the end of the tour, everyone can get together to share their experience at the WIELS CAFE.\n\nFor children from 3 years old","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006253"},"it":{"name":"Nocturnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006253"},"cn":{"name":"Nocturnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006253"},"fr":{"name":"Nocturnes","shortdescr":"Chaque premier mercredi du mois, le WIELS ouvre ses portes jusqu'\u00e0 21:00! Une belle occasion de visiter nos expositions en soir\u00e9e et de profiter de visites guid\u00e9es d\u00e9contract\u00e9es.","longdescr":"18:00-19:00 I AP\u00c9RO TOURS (FR\/NL\/EN)\n\nParticipez lors de chaque Nocturne \u00e0 l'un de nos Ap\u00e9ro Tours, une visite guid\u00e9e au cours de laquelle l'un ou l'une des guides du WIELS vous emm\u00e8ne \u00e0 travers les expositions en cours et profitez d'une boisson au WIELS' Caf\u00e9 avant ou apr\u00e8s votre visite. Rejoignez nos guides et d\u00e9couvrez les expositions autrement !\n\nTicket d'entr\u00e9e + \u20ac 7\n\n18:00-19:00 I KETS TOUR (FR\/NL)\n\nPour les enfants, WIELS propose le Kets Tour - une visite guid\u00e9e sp\u00e9cialement con\u00e7ue pour les plus petits. En fin de visite, petits et grands se rejoignent au WIELS' Caf\u00e9 pour partager leur exp\u00e9rience.\n\nPour les enfants \u00e0 partir de 3 ans","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006253"},"sp":{"name":"Nocturnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006253"},"nl":{"name":"Nocturnes","shortdescr":"Elke eerste woensdag van de maand opent WIELS haar deuren tot 21:00! Dit is je kans om onze tentoonstellingen 's avonds te bezoeken en te genieten van een programma van ontspannen rondleidingen.","longdescr":"18:00-19:00 I APERO RONDLEIDINGEN (FR\/NL\/EN)\n\nNeem elke nocturne deel aan onze 'Ap\u00e9ro Tour', een rondleiding waarbij \u00e9\u00e9n van de WIELS-gidsen je meeneemt doorheen de lopende tentoonstellingen en geniet voor of na het bezoek van een drankje in het WIELS' Caf\u00e9. Schrijf je in en ontdek de tentoonstellingen op een andere manier!\n\nToegangsticket + \u20ac 7\n\n18:00-19:00 I KETS RONDLEIDINGEN (FR\/NL)\n\nVoor kinderen biedt WIELS de Kets Tour - een rondleiding op maat van kinderen. Aan het einde van de rondleiding kunnen jong en oud hun ervaringen delen in het WIELS' Caf\u00e9.\n\nVoor kinderen vanaf 3 jaar","performers":"Jef Geys, Oscar Murillo","boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006253"}},"place":{"id":1490,"translations":{"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"It was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world. The Art centre has a shop, a caf\u00e9 and offer an impressive panorama on the city. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Le WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art. Le centre d'art dispose d'un magasin, d'un caf\u00e9 et d'un toit terrasse offrant une impressionnante vue sur la ville. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Forest","description_web":"Wiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd. Het kunstcentrum heeft een shop, een caf\u00e9 en een dakterras met een indrukwekkend uitzicht over de stad. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[n