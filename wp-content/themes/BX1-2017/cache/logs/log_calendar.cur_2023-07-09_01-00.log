":[null],"cn":[null]}},"tags":["exterior","force_publication","annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":{"list":[258,259,263],"translations":{"fr":["Appareils d'amplification du son","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Geluidsversterkende apparatuur","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Sound-amplifying equipment","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["H\u00f6rverst\u00e4rker","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Apparecchi acustici","Cane guida","Accessibile ai pedoni con supporti"],"sp":["Aparatos de amplificaci\u00f3n del sonido","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-11T03:05:32+02:00","published_at":"2022-11-17T10:50:52+01:00","backoffice_id":265790,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.2547308482414},{"id":555713,"date_start":"2023-04-30","date_end":"2023-10-22","date_next":"2023-08-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e du Logis Flor\u00e9al : les compagnons vous accueillent","shortdescr":"Parcourir le Logis Flor\u00e9al , le plus grand ensemble de cit\u00e9s-jardins en Belgique c\u2019est se retrouver plong\u00e9 dans l\u2019atmosph\u00e8re d\u2019un village anglais \u00e0 quelques kilom\u00e8tres \u00e0 peine du centre de Bruxelles.","longdescr":"Des ruelles qui serpentent, des maisons style cottage entour\u00e9es d\u2019une v\u00e9g\u00e9tation abondante, un labyrinthe de sentiers qui passent entre les jardins, un site class\u00e9 au patrimoine\u2026 Le Logis et Flor\u00e9al, c\u2019est tout \u00e7a mais c\u2019est bien plus encore. \r\nCette visite, r\u00e9alis\u00e9e par une guide-conf\u00e9renci\u00e8re qui y habite depuis plus de 25 ans, sera l\u2019occasion d\u2019\u00e9voquer tout un pan de l\u2019histoire architecturale et sociale de la Belgique du 20\u00e8 si\u00e8cle mais aussi la vie d\u2019aujourd\u2019hui dans les cit\u00e9s-jardins. \r\nFaites une promenade et imaginez-vous en vacances ! \r\nUne initiative des Compagnons du Quartier Flor\u00e9al en partenariat avec la Soci\u00e9t\u00e9 Coop\u00e9rative Le Logis-Flor\u00e9al.\r\n\r\nPas de r\u00e9servation n\u00e9cessaire","performers":"Les compagnons du quartier Flor\u00e9al.\r\nNathalie de Wergifosse ( guide conf\u00e9renci\u00e8re)","boxoffice_url":null,"website":"https:\/\/www.lelogisfloreal.be\/","email":"lescompagnonsdefloreal@hotmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555713"},"nl":{"name":"Visite guid\u00e9e du Logis Flor\u00e9al : les compagnons vous accueillent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lelogisfloreal.be\/","email":"lescompagnonsdefloreal@hotmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555713"},"en":{"name":"Visite guid\u00e9e du Logis Flor\u00e9al : les compagnons vous accueillent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lelogisfloreal.be\/","email":"lescompagnonsdefloreal@hotmail.com","phone_contact":null,"phone_booking"