s gepassioneerde Brusselaars nemen ze je mee door de straten en steegjes van Brussel en tonen ze je de stad zoals zij die kennen, zoals zij ervan houden.\n\nStadslegendes, sociale strubbelingen, misdaadsc\u00e8nes, Art Nouveau of andere thema's, ga met ze mee en ontdek Brussel zoals je het nog nooit hebt gezien!\n\nDe rondleidingen zijn beschikbaar op inschrijving via de website, maar op verzoek kunnen er ook priv\u00e9rondleidingen voor groepen worden geregeld. Als onderdeel van deze priv\u00e9-ervaringen kunt u de rondleiding combineren met een chocoladeproeverij, een goed gebrouwen aperitief of een maaltijd in een authentiek Brussels etablissement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":41819,"location":{"lat":50.8446735,"lon":4.3500613},"last_updated_at":"2025-01-27T10:36:39+01:00","published_at":"2024-01-20T21:02:59+01:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/cf4937b87c7da4f43622c3df5473bc89fa7fc398.jpg","width":2048,"height":1536,"ratio":1.33,"oEmbed_height":1536,"oEmbed_width":2048,"translations":{"de":{"title":"Bruxelles : Belle \u00c9poque et Art Nouveau","copyright":null},"pt":{"title":"Bruxelles : Belle \u00c9poque et Art Nouveau","copyright":null},"en":{"title":"Bruxelles : Belle \u00c9poque et Art Nouveau","copyright":null},"it":{"title":"Bruxelles : Belle \u00c9poque et Art Nouveau","copyright":null},"cn":{"title":"Bruxelles : Belle \u00c9poque et Art Nouveau","copyright":null},"fr":{"title":"Bruxelles : Belle \u00c9poque et Art Nouveau","copyright":null},"sp":{"title":"Bruxelles : Belle \u00c9poque et Art Nouveau","copyright":null},"nl":{"title":"Bruxelles : Belle \u00c9poque et Art Nouveau","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/2b5518e773cf