lse,"is_canceled":false},{"day":"2025-05-18","doors":null,"start":"14:00:00","end":"15:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-06-15","doors":null,"start":"14:00:00","end":"15:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":5}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[263,265,255],"translations":{"de":["Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC","Barrierefrei"],"pt":[null,null,null],"en":["Accessible to pedestrians with mobility aids","Adapted toilet","Accessible"],"it":["Accessibile ai pedoni con supporti","WC idoneo","Accessibile"],"cn":[null,null,null],"fr":["Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Accessible"],"sp":["Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados","Habilitado"],"nl":["Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Toegankelijk"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700004746,"date_start":"2025-01-19","date_end":"2025-06-15","date_next":"2025-03-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-17T01:01:43+01:00","published_at":"2024-12-18T19:18:14+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":314692,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.23818958080238592,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[255],"translations":{"de":["Besuche von Ausstellungen"],"pt":[null],"en":["Exhibition guided tours"],"it":["Visite a esposizioni"],"cn":[null],"fr":["Visites d'expositions"],"sp":["Visitas a las exposiciones"],"nl":["Tentoonstelling"]}}},"translations":{"de":{"name":"Family Sundays","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sundays\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004746"},"pt":{"name":"Family Sundays","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sundays\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004746"},"en":{"name":"Family Sundays","shortdescr":"D\u00e9couvrez la fascinante th\u00e9matique de la pluie lors de nos Family Sundays. Chaque troisi\u00e8me dimanche du mois, le Mus\u00e9e des \u00c9gouts propose aux familles des activit\u00e9s passionnantes pour explorer, de mani\u00e8re originale, l\u2019exposition \u00ab Apr\u00e8s la pluie \u00bb.","longdescr":"En famille, observez de mani\u00e8re ludique un ph\u00e9nom\u00e8ne naturel tr\u00e8s connu des Belges : la pluie! R\u00e9pondez aux questions que se posent vos petits curieux et vous aussi ! Quelles quantit\u00e9s d\u2019eau les nuages d\u00e9versent-ils lorsqu\u2019il pleut ? D\u2019o\u00f9 viennent ces gouttes qui tombent du ciel ? O\u00f9 vont-elles quand elles touchent le sol ? Des r\u00e9ponses pas si \u00e9videntes. Nos dispositifs tactiles et interactifs vous aident \u00e0 solutionner les questions. Plongez ensemble au c\u0153ur d\u2019un sujet passionnant.\n\nAu programme :\n\n** De 10h30 \u00e0 12h30 et de 13h30 \u00e0 16h30: Sauve qui pleut !\nAutour du bac \u00e0 sable \u00e0 r\u00e9alit\u00e9 augment\u00e9e, modelez le paysage bruxellois et faites tomber la pluie ou revenir le soleil. D\u00e9couvrez concr\u00e8tement comment l\u2019eau ruiss\u00e8le dans le paysage et son impact sur les quartiers et les habitants.\n\n** \u00c0 14h00 : visite guid\u00e9e th\u00e9matique\nEn compagnie de nos guides, suivez le voyage d\u2019une goutte de pluie en ville. Suivez notre visite th\u00e9matique pour mieux comprendre la gestion des eaux de pluie \u00e0 Bruxelles.\n\n** De 14h \u00e0 16h (en continu) : Eau contes goutte ; atelier de lectures cont\u00e9es\n\u00ab Il pleut, il mouille, c\u2019est la f\u00eate \u00e0 la grenouille ! \u00bb Pour terminer votre visite, laissez-vous conter quelques histoires c\u00e9l\u00e9brant la pluie. Embarquez pour un voyage vers des contr\u00e9es o\u00f9 la pluie est un bienfait.\n\nInfos pratiques :\n\n** Dates: 15.12.24, 19.01.25, 16.02, 16.03, 20.04, 18.05, 15.06.25\n** L\u2019entr\u00e9e est payante pour les adultes. Pour les enfants, l\u2019entr\u00e9e est gratuite jusqu\u2019\u00e0 18 ans. \n** Les activit\u00e9s sont gratuites sous r\u00e9serve de l\u2019achat du ticket d\u2019entr\u00e9e.\n\n** Les places pour la visite guid\u00e9e sont limit\u00e9es, la r\u00e9servation est obligatoire via notre plateforme de r\u00e9servation.\n** Dur\u00e9e : 1h\n** \u00c0 partir de 9 ans\n\n** Animation bac \u00e0 sable : \u00e0 partir de 9 ans\n** Atelier de lectures cont\u00e9es : tous les \u00e2ges","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sundays\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004746"},"it":{"name":"Family Sundays","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sundays\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004746"},"cn":{"name":"Family Sundays","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sundays\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004746"},"fr":{"name":"Family Sundays : \u00ab Apr\u00e8s la pluie \u00bb","shortdescr":"D\u00e9couvrez la fascinante th\u00e9matique de la pluie lors de nos Family Sundays. Chaque troisi\u00e8me dimanche du mois, le Mus\u00e9e des \u00c9gouts propose aux familles des activit\u00e9s passionnantes pour explorer, de mani\u00e8re originale, l\u2019exposition \u00ab Apr\u00e8s la pluie \u00bb.","longdescr":"En famille, observez de mani\u00e8re ludique un ph\u00e9nom\u00e8ne naturel tr\u00e8s connu des Belges : la pluie! R\u00e9pondez aux questions que se posent vos petits curieux et vous aussi ! Quelles quantit\u00e9s d\u2019eau les nuages d\u00e9versent-ils lorsqu\u2019il pleut ? D\u2019o\u00f9 viennent ces gouttes qui tombent du ciel ? O\u00f9 vont-elles quand elles touchent le sol ? Des r\u00e9ponses pas si \u00e9videntes. Nos dispositifs tactiles et interactifs vous aident \u00e0 solutionner les questions. Plongez ensemble au c\u0153ur d\u2019un sujet passionnant.\n\nAu programme :\n\n** De 10h30 \u00e0 12h30 et de 13h30 \u00e0 16h30: Sauve qui pleut !\nAutour du bac \u00e0 sable \u00e0 r\u00e9alit\u00e9 augment\u00e9e, modelez le paysage bruxellois et faites tomber la pluie ou revenir le soleil. D\u00e9couvrez concr\u00e8tement comment l\u2019eau ruiss\u00e8le dans le paysage et son impact sur les quartiers et les habitants.\n\n** \u00c0 14h00 : visite guid\u00e9e th\u00e9matique\nEn compagnie de nos guides, suivez le voyage d\u2019une goutte de pluie en ville. Suivez notre visite th\u00e9matique pour mieux comprendre la gestion des eaux de pluie \u00e0 Bruxelles.\n\n** De 14h \u00e0 16h (en continu) : Eau contes goutte ; atelier de lectures cont\u00e9es\n\u00ab Il pleut, il mouille, c\u2019est la f\u00eate \u00e0 la grenouille ! \u00bb Pour terminer votre visite, laissez-vous conter quelques histoires c\u00e9l\u00e9brant la pluie. Embarquez pour un voyage vers des contr\u00e9es o\u00f9 la pluie est un bienfait.\n\nInfos pratiques :\n\n** Dates: 15.12.24, 19.01.25, 16.02, 16.03, 20.04, 18.05, 15.06.25\n** L\u2019entr\u00e9e est payante pour les adultes. Pour les enfants, l\u2019entr\u00e9e est gratuite jusqu\u2019\u00e0 18 ans. \n** Les activit\u00e9s sont gratuites sous r\u00e9serve de l\u2019achat du ticket d\u2019entr\u00e9e.\n\n** Les places pour la visite guid\u00e9e sont limit\u00e9es, la r\u00e9servation est obligatoire via notre plateforme de r\u00e9servation.\n** Dur\u00e9e : 1h\n** \u00c0 partir de 9 ans\n\n** Animation bac \u00e0 sable : \u00e0 partir de 9 ans\n** Atelier de lectures cont\u00e9es : tous les \u00e2ges","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sundays\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004746"},"sp":{"name":"Family Sundays","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sundays\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004746"},"nl":{"name":"Family Sundays : \u2018Na regen komt\u2026\u2019","shortdescr":"Ontdek alles over het boeiende thema regen op onze Family Sundays. Elke derde zondag van de maand organiseert het Riolenmuseum een aantal boeiende activiteiten op maat van gezinnen met kinderen om de tentoonstelling \u2018Na regen komt\u2026\u2019 op een originele manier te verkennen.","longdescr":"Kom met het hele gezin naar het Riolenmuseum en ontdek een natuurfenomeen waar de Belgen heel vertrouwd mee zijn: regen! Samen beantwoorden we vragen die nieuwsgierige kindjes zich stellen: Hoeveel water gieten de wolken naar beneden als het regent? Waar komen de druppels die uit de lucht vallen vandaan en waar gaan ze naartoe als ze de grond raken? De antwoorden liggen misschien niet helemaal voor de hand!  Speelse en interactieve tools helpen je om ze te beantwoorden. In Brussel belandt regenwater vaak in de riolen, terwijl het zo\u2019n kostbare bron is. Duik samen in het hart van dit fascinerende onderwerp.\n\n Op het programma:\n\n** Van 10u30 tot 12u30u en van 13u30 tot 16u30 (doorlopend): Red de regen!\nIn een augmented reality-zandbak modelleer je het Brusselse landschap en laat je het zelf regenen of mooi weer worden. Ontdek hoe de regen door het landschap stroomt en welke wijken beschermd moeten worden tegen overstromingen. Onze animator helpt je op weg.\n\n** Van 14u tot 16u (doorlopend) : Als de kikkers kwaken gaan de wolken regen maken.\nNestel je in een gezellig hoekje en luister naar een aantal verhalen waarin de regen wordt gevierd. Onze verhalenvertelster neemt je mee op reis in de magische wereld van de regendruppels en naar landen waar regen als een zege wordt beschouwd.\n\n** Om 15u30: Rondleiding met een gids doorheen de nieuwe tentoonstelling.\nVolg de reis van een regendruppel doorheen de stad en ontdek onze fascinerende tentoonstelling .\n\n Praktische info:\n\n** Data: 15.12.24, 19.01.25, 16.02, 16.03, 20.04, 18.05, 15.06.25\n** De toegang voor volwassenen is betalend. Voor kinderen onder de 18 is de toegang gratis. Koop hier je tickets.\n** Deelname aan de activiteiten is gratis, mits aankoop van een toegangsticket.\n\nRondleiding:\n** De plaatsen voor de rondleiding zijn beperkt, reserveren is verplicht via ons online reservatieplatform\n** Vanaf 9 jaar\n** Duur: 1 uur\n\n** Animatie zandbak : vanaf 9 jaar\n** Verhalen vertellen : alle leeftijden","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/nl\/news\/family-sundays-2\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004746"}},"place":{"id":231869,"translations":{"de":{"name":"Kanalisationsmuseum (Mus\u00e9e des \u00c9gouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Das Kanalisationsmuseum f\u00fchrt Sie hinab in die Unterwelten der Br\u00fcsseler Kanalisation. Entdecken Sie die Geheimnisse des faszinierenden, 400 Kilometer langen Labyrinths, das sich unter dem Br\u00fcsseler Stadtgebiet auftut. Tausende Kubikmeter Wasser flie\u00dfen t\u00e4glich durch die Br\u00fcsseler Abwasserkanalisation. Was mit ihnen geschieht, welche Wege sie nehmen, erfahren Sie im Kanalisationsmuseum - ein Museum mit vielen interessanten Details f\u00fcr Gro\u00df und Klein: Geschichtliches, Technisches und Am\u00fcsantes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Sewer Museum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.sewermuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Brussels","description_web":"Why not visit the Brussels sewers and the Sewers museum during your next excursion in Brussels. A visit of Brussels' sewerage network - led by experienced guides or ex-workers - is extraordinary, full of surprises, but above all fascinating. The sewers have become vital to our way of life, so much so that it's hard to imagine what it was like before they existed. A visit of the Sewers Museum (and a real sewer!) is therefore an amazing, unusual and thrilling experience.\r\nBrussels' first sewerage network came into use in the 17th century, but they were very limited and a large part of the city's waste still found its way into the river Senne. The river carried waste and carrion and regularly overflowed, or dried out in the summer, leaving behind less-than-pleasant smells.\r\nIt was partially due to this, that the government in the second half of the 19th century decided to completely transform the Senne and its neighbouring streets by building great boulevards to cover the insalubrious area. Between the two world wars a second transformation: a portion of the Senne was diverted and then covered over. The sewerage network improved and grew over the years, going from 45 km in 1847 to the 350 km that we have today.\r\n The entrance to the museum is housed in one of the toll pavilions that used to collect taxes on goods that entered the city.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e des \u00c9gouts","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Au premier abord, on n\u2019y aurait pas pens\u00e9\u2026 Aller visiter les \u00e9gouts d\u2019une grande ville ? Mais en y r\u00e9fl\u00e9chissant un court instant, on per\u00e7oit vite l\u2019int\u00e9r\u00eat et les apprentissages potentiels ! Cet endroit qu\u2019aujourd\u2019hui on n\u2019imagine pas autrement qu\u2019enfoui\u2026 n\u2019a pas toujours exist\u00e9 sous cette forme, loin s\u2019en faut !\r\nC\u2019est au 17e si\u00e8cle que se met en place \u00e0 Bruxelles le premier r\u00e9seau d\u2019\u00e9gouts ; toutefois celui-ci reste \u00e9l\u00e9mentaire et bon nombre de d\u00e9chets terminent encore leur itin\u00e9raire dans le cours d\u2019eau bruxellois, la Senne. Celle-ci charrie d\u00e9tritus et charognes, et d\u00e9borde r\u00e9guli\u00e8rement en temps de pluie, ou s\u2019ass\u00e8che en \u00e9t\u00e9, laissant s\u2019\u00e9chapper des odeurs peu subtiles\u2026\r\nUn grand plan d\u2019assainissement est ex\u00e9cut\u00e9 dans la seconde moiti\u00e9 du 19e si\u00e8cle. On d\u00e9cide de vo\u00fbter la Senne et d\u2019\u00e9tablir de larges boulevards \u00e0 la place des ruelles insalubres. Durant l\u2019entre-deux-guerres, une deuxi\u00e8me entreprise de d\u00e9tournement et de vo\u00fbtement du cours d\u2019eau viendra renforcer l\u2019efficacit\u00e9 des premiers travaux.\r\nProgressivement, le r\u00e9seau des \u00e9gouts va se perfectionner et s\u2019agrandir : comptant 45 km en 1847, on d\u00e9nombre actuellement 350 km de d\u00e9dales souterrains, qui recueillent conjointement les eaux pluviales et les eaux us\u00e9es provenant de l\u2019activit\u00e9 humaine. \r\n\r\nAper\u00e7u de ce r\u00e9seau, explications sur son histoire et le travail des hommes qui l\u2019entretiennent, cycle de l\u2019eau, etc. : ce sont l\u00e0 quelques-unes des th\u00e9matiques qui vous y attendent ! Notez que l\u2019entr\u00e9e du mus\u00e9e si\u00e8ge dans un des deux \u00ab pavillons d\u2019octroi \u00bb, b\u00e2timents qui mat\u00e9rialisent la perception de la taxe sur tous les biens entrant dans la Ville au 19e si\u00e8cle.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo del Alcantarillado (Mus\u00e9e des Egouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"En un primer momento, a uno no se le pasar\u00eda por la cabeza... \u00bfIr a visitar las alcantarillas de una gran ciudad? Pero si te paras a pensarlo, \u00a1ver\u00e1s r\u00e1pidamente el potencial de aprendizaje y el inter\u00e9s! Este lugar que, actualmente, solo nos imaginamos bajo tierra no siempre lo ha estado, ni mucho menos. En el siglo XVII se cre\u00f3 el primer sistema de alcantarillado en Bruselas; sin embargo, segu\u00eda siendo b\u00e1sico y muchos residuos terminaban su recorrido en el r\u00edo de la ciudad, el Senne. Este r\u00edo, que llevaba basura y carro\u00f1a, se sol\u00eda desbordar normalmente en \u00e9poca de lluvias, o se secaba en verano, lo que hac\u00eda que desprendiera olores desagradables...\r\nEn la segunda mitad del siglo XIX se puso en marcha un importante plan de saneamiento.\r\nSe decidi\u00f3 recubrir el Senne y crear amplios bulevares en lugar de callejones insalubres. Durante el per\u00edodo de entreguerras, unas segundas obras de recubrimiento y desv\u00edo del agua reforzaron las primeras. Gradualmente, el sistema de alcantarillado se mejor\u00f3 y ampli\u00f3: de 45 km en 1847, actualmente hay 350 km de laberintos subterr\u00e1neos, que recogen conjuntamente el agua de lluvia y las aguas residuales de la ciudad. El museo se inaugur\u00f3 en 1988 como respuesta a una demanda creciente y ofrece visitas realizadas por el propio personal del Servicio de Alcantarillado. Gracias a este museo podr\u00e1s disfrutar de una perspectiva general de esta red, explicaciones sobre su historia y sobre la labor que desempe\u00f1an sus trabajadores, informaci\u00f3n sobre el ciclo hidrol\u00f3gico, etc. Cabe destacar que la entrada al museo se encuentra en uno de los dos Pavillons d\u2019octroi, los edificios donde se recaudaban los impuestos de todas las mercanc\u00edas que entraban en la ciudad en el siglo XIX.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Riolenmuseum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.riolenmuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Brussel","description_web":"Zet eens een bezoek aan de Brusselse riolen en het Riolenmuseum op het programma van een uitstap in Brussel! Apart, ongewoon en onverwacht, maar vooral interessant en allesbehalve saai is zo\u2019n afdaling in ondergronds Brussel, begeleid door ervaren stadsgidsen of (voormalige) rioolwerkers.\r\nRiolen zijn levensnoodzakelijk geworden voor onze manier van leven, vandaar dat we ons maar moeilijk kunnen voorstellen hoe het eraan toeging toen ze nog niet bestonden. Een bezoek aan het Riolenmuseum (en een echte riool!) is dan ook verrassend, ongewoon en ongemeen boeiend.\r\nIn de 17de eeuw werd in Brussel een eerste riolennet in gebruik genomen. Dat bleef nog erg beperkt en het overgrote deel van het afvalwater vond nog altijd zijn weg naar die ene Brusselse rivier, de Zenne. Die voerde dan ook een smurrie van afval, viezigheid en zelfs dierenkadavers de hele stad door. Als de Zenne bij overvloedige regen overstroomde of in volle zomer opdroogde in de zomer, zorgde dat natuurlijk voor weinig aangename geurtjes...\r\nGedeeltelijk omwille van die overlast besloot de overheid in de tweede helft van de 19de eeuw om een overwelving aan te brengen boven de Zenne en grote boulevards aan te leggen in plaats van de vieze en slordige steegjes. Later werd tussen de twee Wereldoorlogen nog een tweede keer ingegrepen: een deel van de Zenne werd verlegd en er werden nog meer overwelvingen aangebracht. \r\nLangzamerhand verbeterde en vergrootte het riolennet, van 45 km in 1847 naar de huidige 350 km riool, die zowel afval- als regenwater afvoert. \r\nNaast een bezoek aan de riolen zelf levert dit museum een schat aan boeiende en interessante informatie op over alle aspecten van riolen, rioolwater en de mensen die ze \u2013 vaak in gevaarlijke en altijd in onaangename omstandigheden - onderhouden. Leuk: de ingang van het museum is gehuisvest in een van de twee octrooipaviljoenen aan de Anderlechtse Poort, waar vroeger tol werd geheven op goederen die in de stad werden binnengebracht.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":989,"location":{"lat":50.8450404,"lon":4.3386943},"region":"brussels","last_updated_at":"2025-01-27T16:55:54+01:00","published_at":"2013-10-19T01:13:58+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231869,"translations":{"de":{"name":"Kanalisationsmuseum (Mus\u00e9e des \u00c9gouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Das Kanalisationsmuseum f\u00fchrt Sie hinab in die Unterwelten der Br\u00fcsseler Kanalisation. Entdecken Sie die Geheimnisse des faszinierenden, 400 Kilometer langen Labyrinths, das sich unter dem Br\u00fcsseler Stadtgebiet auftut. Tausende Kubikmeter Wasser flie\u00dfen t\u00e4glich durch die Br\u00fcsseler Abwasserkanalisation. Was mit ihnen geschieht, welche Wege sie nehmen, erfahren Sie im Kanalisationsmuseum - ein Museum mit vielen interessanten Details f\u00fcr Gro\u00df und Klein: Geschichtliches, Technisches und Am\u00fcsantes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Sewer Museum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.sewermuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Brussels","description_web":"Why not visit the Brussels sewers and the Sewers museum during your next excursion in Brussels. A visit of Brussels' sewerage network - led by experienced guides or ex-workers - is extraordinary, full of surprises, but above all fascinating. The sewers have become vital to our way of life, so much so that it's hard to imagine what it was like before they existed. A visit of the Sewers Museum (and a real sewer!) is therefore an amazing, unusual and thrilling experience.\r\nBrussels' first sewerage network came into use in the 17th century, but they were very limited and a large part of the city's waste still found its way into the river Senne. The river carried waste and carrion and regularly overflowed, or dried out in the summer, leaving behind less-than-pleasant smells.\r\nIt was partially due to this, that the government in the second half of the 19th century decided to completely transform the Senne and its neighbouring streets by building great boulevards to cover the insalubrious area. Between the two world wars a second transformation: a portion of the Senne was diverted and then covered over. The sewerage network improved and grew over the years, going from 45 km in 1847 to the 350 km that we have today.\r\n The entrance to the museum is housed in one of the toll pavilions that used to collect taxes on goods that entered the city.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e des \u00c9gouts","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Au premier abord, on n\u2019y aurait pas pens\u00e9\u2026 Aller visiter les \u00e9gouts d\u2019une grande ville ? Mais en y r\u00e9fl\u00e9chissant un court instant, on per\u00e7oit vite l\u2019int\u00e9r\u00eat et les apprentissages potentiels ! Cet endroit qu\u2019aujourd\u2019hui on n\u2019imagine pas autrement qu\u2019enfoui\u2026 n\u2019a pas toujours exist\u00e9 sous cette forme, loin s\u2019en faut !\r\nC\u2019est au 17e si\u00e8cle que se met en place \u00e0 Bruxelles le premier r\u00e9seau d\u2019\u00e9gouts ; toutefois celui-ci reste \u00e9l\u00e9mentaire et bon nombre de d\u00e9chets terminent encore leur itin\u00e9raire dans le cours d\u2019eau bruxellois, la Senne. Celle-ci charrie d\u00e9tritus et charognes, et d\u00e9borde r\u00e9guli\u00e8rement en temps de pluie, ou s\u2019ass\u00e8che en \u00e9t\u00e9, laissant s\u2019\u00e9chapper des odeurs peu subtiles\u2026\r\nUn grand plan d\u2019assainissement est ex\u00e9cut\u00e9 dans la seconde moiti\u00e9 du 19e si\u00e8cle. On d\u00e9cide de vo\u00fbter la Senne et d\u2019\u00e9tablir de larges boulevards \u00e0 la place des ruelles insalubres. Durant l\u2019entre-deux-guerres, une deuxi\u00e8me entreprise de d\u00e9tournement et de vo\u00fbtement du cours d\u2019eau viendra renforcer l\u2019efficacit\u00e9 des premiers travaux.\r\nProgressivement, le r\u00e9seau des \u00e9gouts va se perfectionner et s\u2019agrandir : comptant 45 km en 1847, on d\u00e9nombre actuellement 350 km de d\u00e9dales souterrains, qui recueillent conjointement les eaux pluviales et les eaux us\u00e9es provenant de l\u2019activit\u00e9 humaine. \r\n\r\nAper\u00e7u de ce r\u00e9seau, explications sur son histoire et le travail des hommes qui l\u2019entretiennent, cycle de l\u2019eau, etc. : ce sont l\u00e0 quelques-unes des th\u00e9matiques qui vous y attendent ! Notez que l\u2019entr\u00e9e du mus\u00e9e si\u00e8ge dans un des deux \u00ab pavillons d\u2019octroi \u00bb, b\u00e2timents qui mat\u00e9rialisent la perception de la taxe sur tous les biens entrant dans la Ville au 19e si\u00e8cle.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo del Alcantarillado (Mus\u00e9e des Egouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"En un primer momento, a uno no se le pasar\u00eda por la cabeza... \u00bfIr a visitar las alcantarillas de una gran ciudad? Pero si te paras a pensarlo, \u00a1ver\u00e1s r\u00e1pidamente el potencial de aprendizaje y el inter\u00e9s! Este lugar que, actualmente, solo nos imaginamos bajo tierra no siempre lo ha estado, ni mucho menos. En el siglo XVII se cre\u00f3 el primer sistema de alcantarillado en Bruselas; sin embargo, segu\u00eda siendo b\u00e1sico y muchos residuos terminaban su recorrido en el r\u00edo de la ciudad, el Senne. Este r\u00edo, que llevaba basura y carro\u00f1a, se sol\u00eda desbordar normalmente en \u00e9poca de lluvias, o se secaba en verano, lo que hac\u00eda que desprendiera olores desagradables...\r\nEn la segunda mitad del siglo XIX se puso en marcha un importante plan de saneamiento.\r\nSe decidi\u00f3 recubrir el Senne y crear amplios bulevares en lugar de callejones insalubres. Durante el per\u00edodo de entreguerras, unas segundas obras de recubrimiento y desv\u00edo del agua reforzaron las primeras. Gradualmente, el sistema de alcantarillado se mejor\u00f3 y ampli\u00f3: de 45 km en 1847, actualmente hay 350 km de laberintos subterr\u00e1neos, que recogen conjuntamente el agua de lluvia y las aguas residuales de la ciudad. El museo se inaugur\u00f3 en 1988 como respuesta a una demanda creciente y ofrece visitas realizadas por el propio personal del Servicio de Alcantarillado. Gracias a este museo podr\u00e1s disfrutar de una perspectiva general de esta red, explicaciones sobre su historia y sobre la labor que desempe\u00f1an sus trabajadores, informaci\u00f3n sobre el ciclo hidrol\u00f3gico, etc. Cabe destacar que la entrada al museo se encuentra en uno de los dos Pavillons d\u2019octroi, los edificios donde se recaudaban los impuestos de todas las mercanc\u00edas que entraban en la ciudad en el siglo XIX.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Riolenmuseum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.riolenmuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Brussel","description_web":"Zet eens een bezoek aan de Brusselse riolen en het Riolenmuseum op het programma van een uitstap in Brussel! Apart, ongewoon en onverwacht, maar vooral interessant en allesbehalve saai is zo\u2019n afdaling in ondergronds Brussel, begeleid door ervaren stadsgidsen of (voormalige) rioolwerkers.\r\nRiolen zijn levensnoodzakelijk geworden voor onze manier van leven, vandaar dat we ons maar moeilijk kunnen voorstellen hoe het eraan toeging toen ze nog niet bestonden. Een bezoek aan het Riolenmuseum (en een echte riool!) is dan ook verrassend, ongewoon en ongemeen boeiend.\r\nIn de 17de eeuw werd in Brussel een eerste riolennet in gebruik genomen. Dat bleef nog erg beperkt en het overgrote deel van het afvalwater vond nog altijd zijn weg naar die ene Brusselse rivier, de Zenne. Die voerde dan ook een smurrie van afval, viezigheid en zelfs dierenkadavers de hele stad door. Als de Zenne bij overvloedige regen overstroomde of in volle zomer opdroogde in de zomer, zorgde dat natuurlijk voor weinig aangename geurtjes...\r\nGedeeltelijk omwille van die overlast besloot de overheid in de tweede helft van de 19de eeuw om een overwelving aan te brengen boven de Zenne en grote boulevards aan te leggen in plaats van de vieze en slordige steegjes. Later werd tussen de twee Wereldoorlogen nog een tweede keer ingegrepen: een deel van de Zenne werd verlegd en er werden nog meer overwelvingen aangebracht. \r\nLangzamerhand verbeterde en vergrootte het riolennet, van 45 km in 1847 naar de huidige 350 km riool, die zowel afval- als regenwater afvoert. \r\nNaast een bezoek aan de riolen zelf levert dit museum een schat aan boeiende en interessante informatie op over alle aspecten van riolen, rioolwater en de mensen die ze \u2013 vaak in gevaarlijke en altijd in onaangename omstandigheden - onderhouden. Leuk: de ingang van het museum is gehuisvest in een van de twee octrooipaviljoenen aan de Anderlechtse Poort, waar vroeger tol werd geheven op goederen die in de stad werden binnengebracht.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":989,"location":{"lat":50.8450404,"lon":4.3386943},"last_updated_at":"2025-01-27T16:55:54+01:00","publi