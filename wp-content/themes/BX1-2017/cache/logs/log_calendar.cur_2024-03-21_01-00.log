 exudes a captivating energy that is conducive to artistic expression and fosters a deep appreciation for music.","performers":"Victor Julien-Laferri\u00e8re (Queen Elisabeth Winner) -Cello\nNad\u00e8ge Rochat-Cello\nMathis Rochat-Viola\nLars Anders Tomter-Viola\nAbigel Kralik-Violin\nMiclen Laipang-Violin\nTrio Baul meets Saz:\n\nEmre G\u00fcltekin\nMalabika Brahma\nSangay Kyapah \n","boxoffice_url":null,"website":"http:\/\/www.taraconcerts.com","email":"info@taraconcerts.com","phone_contact":"+32 470 25 79 02","phone_booking":"+32 470 25 79 02","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008475"},"it":{"name":"Tara Concerts La Nuit Transfigur\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.taraconcerts.com","email":"info@taraconcerts.com","phone_contact":"+32 470 25 79 02","phone_booking":"+32 470 25 79 02","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008475"},"cn":{"name":"Tara Concerts La Nuit Transfigur\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.taraconcerts.com","email":"info@taraconcerts.com","phone_contact":"+32 470 25 79 02","phone_booking":"+32 470 25 79 02","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008475"},"fr":{"name":"Tara Concerts La Nuit Transfigur\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.taraconcerts.com","email":"info@taraconcerts.com","phone_contact":"+32 470 25 79 02","phone_booking":"+32 470 25 79 02","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008475"},"sp":{"name":"Tara Concerts La Nuit Transfigur\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.taraconcerts.com","email":"info@taraconcerts.com","phone_contact":"+32 470 25 79 02","phone_booking":"+32 470 25 79 02","agenda_url