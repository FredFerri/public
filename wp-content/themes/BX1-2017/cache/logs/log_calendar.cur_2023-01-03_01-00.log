_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[326],"translations":{"fr":["Jazz"],"nl":["Jazz"],"en":["Jazz"],"de":["Jazz"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:55:01+01:00","published_at":"2022-11-21T11:09:07+01:00","backoffice_id":265964,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":546406,"date_start":"2023-01-14","date_end":"2023-01-14","date_next":"2023-01-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[101],"translations":{"fr":["Folklore"],"nl":["Folklore"],"en":["Folklore"],"de":["Folklore"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Championnat de Belgique de lancer de sapin","shortdescr":"Ev\u00e8nement sportif gratuit \u00e0 caract\u00e8re ludique \u00e0 Auderghem! Dans une ambiance familiale et festive, chacun (homme, femme, enfant et groupes) peut essayer de lancer un sapin pour remporter un troph\u00e9e!","longdescr":"Cet \u00e9v\u00e8nement sportif \u00e0 caract\u00e8re ludique est organis\u00e9 chaque ann\u00e9e en janvier sur la place Pinoy \u00e0 Auderghem. Dans une ambiance familiale et festive, l\u2019\u00e9dition de 2020 a accueilli pr\u00e8s de 1000 personnes, dont 650 participants au lancer de sapin. Sur place, un groupe de musique assure l\u2019animation pendant toute la soir\u00e9e. Un bar et des stands de petite restauration sont \u00e9galement disponibles. La soir\u00e9e se cl\u00f4ture par la remise des troph\u00e9es aux gagnants en pr\u00e9sence de divers ministres Bruxellois, bourgmestre et \u00e9chevins d\u2019Auderghem. Les prix r\u00e9compensent les 3 meilleurs lancers par cat\u00e9gorie (homme, femme, enfant et groupe), mais \u00e9galement des performances originales (prix de la meilleure technique de lancer, prix du groupe sympathique, etc).\r\n\r\nFait important \u00e0 signaler: les sapins sont fournis par l\u2019organisation \u2013 il ne faut pas apporter son propre sapin !\r\nInscriptions individuelles sur place, inscription pour les groupes (max 10 personnes) en ligne obligatoire sur www.motum.brussels","performers":null,"boxoffice_url":null,"website":"http:\/\/www.motum.brussels","email":"motumvzw@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546406"},"nl":{"name":"Belgisch kampioenschap kerstboomwerpen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546406"},"en":{"name":"Championnat de Belgique de lancer de sapin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546406"},"de":{"name":"Championnat de Belgique de lancer de sapin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546406"},"it":{"name":"Championnat de Belgique de lancer de sapin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.