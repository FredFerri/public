la m\u00e9moire collective.\r\n\r\nLes artistes vont \u00e0 la rencontre des jeunes g\u00e9n\u00e9rations et des adultes autour des questions li\u00e9es \u00e0 la m\u00e9moire, aux savoirs et aux savoir-faire, \u00e0 la parole du quotidien.\r\n\r\nElles prennent la forme d\u2019outils p\u00e9dagogiques en \u00e9ducation permanente, de collectages, d\u2019ateliers et d\u2019animations, de prestations et de rencontres.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Th\u00e9\u00e2tre de la Parole","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"7","address_street_box":"D","email":"info@theatredelaparole.be","website":"http:\/\/www.theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 7 \/ D","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Th\u00e9\u00e2tre de la Parole","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"7","address_street_box":"D","email":"info@theatredelaparole.be","website":"http:\/\/www.theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":null,"address_zip":"1160","address_city":"Oudergem","address_line1":"Rue du Rouge-Clo\u00eetre, 7 \/ D","address_line2":"1160 Oudergem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":32222,"location":{"lat":50.81434148,"lon":4.44283848},"region":"brussels","last_updated_at":"2022-04-07T15:39:02+02:00","published_at":"2018-10-04T11:28