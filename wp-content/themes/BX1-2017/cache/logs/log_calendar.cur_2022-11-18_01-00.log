 Centre Culturel.\r\nDu dessin au conte, c\u2019est l\u2019occasion de d\u00e9couvrir les multiples \u00e9tapes de cr\u00e9ation d\u2019un livre.\r\nVenez voir cette exposition tout en histoire, en dessin et en couleur\u00a0!","performers":"No\u00e9lia Diaz Iglesias, No\u00e9mie Favart, Marie Mahler, \u00c9milie Seron et Mathilde Vandenbussche","boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539831"},"nl":{"name":"\u00ab Petits mondes illustr\u00e9s \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539831"},"en":{"name":"\u00ab Petits mondes illustr\u00e9s \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539831"},"de":{"name":"Exposition : \u00ab Petits mondes illustr\u00e9s \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539831"},"it":{"name":"Exposition : \u00ab Petits mondes illustr\u00e9s \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539831"},"sp":{"name":"Exposition : \u00ab Petits mondes illustr\u00e9s \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\