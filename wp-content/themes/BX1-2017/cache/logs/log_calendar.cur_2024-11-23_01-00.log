null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/je-taime\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001477"},"en":{"name":"Je t'aime","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/je-taime\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001477"},"it":{"name":"Je t'aime","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/je-taime\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001477"},"cn":{"name":"Je t'aime","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/je-taime\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001477"},"fr":{"name":"Je t'aime","shortdescr":"Je t\u2019aime Elle n\u2019a pas de pr\u00e9nom, elle, l\u2019h\u00e9ro\u00efne de Je t\u2019aime. Elle va nous plonger dans son livre, donner vie \u00e0 ses histoires. Elle les joue, les chante. Son salon devient rivi\u00e8re, elle y invite un oiseau et m\u00eame Catherine Deneuve ! Elle n\u2019a pas gagn\u00e9 le prix litt\u00e9raire qu\u2019elle convoitait, tant pis, elle a gagn\u00e9 ce en quoi elle croit et qui la fait vibrer : l\u2019amour.","longdescr":"\"C\u2019est parce que je croyais \u00eatre immortelle, n\u2019aimer que toi, t\u2019aimer toujours.\" Veronique Castanyer nous invite dans son salon. Elle raconte, se raconte, un peu. S\u2019amuse, beaucoup. Joue, passionn\u00e9ment. \"Histoires d\u2019humains qui tentent d\u2019\u00eatre heureux et se blessent aux \u00e9pines des jours, qui se quittent et se reprennent. Parce qu\u2019aimer est bien plus compliqu\u00e9 que de faire du v\u00e9lo.\" Je t\u2019aime est un spectacle tout en douceur et en force, en rires, en chants et en temps.","performers":"De et avec Veronique Castanyer | Cr\u00e9ation des \u00e9clairages et r\u00e9gie Philippe Demeestere | Photos Yves Gervais \/ Vincent Loutrie \/ Veronique Castanyer","boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/je-taime\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001477"},"sp":{"name":"Je t'aime","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/je-taime\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001477"},"nl":{"name":"Je t'aime","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/je-taime\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001477"}},"place":{"id":1085,"translations":{"de":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Bruxelles","address_line1