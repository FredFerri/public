_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000165"},"en":{"name":"Quelque chose a chang\u00e9 dans l'air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelque-chose-a-change-dans-l-air","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000165"},"it":{"name":"Quelque chose a chang\u00e9 dans l'air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelque-chose-a-change-dans-l-air","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000165"},"cn":{"name":"Quelque chose a chang\u00e9 dans l'air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelque-chose-a-change-dans-l-air","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000165"},"fr":{"name":"Quelque chose a chang\u00e9 dans l'air","shortdescr":"Quelles traces vont vous marquer ?","longdescr":"\"Quelque chose a chang\u00e9 dans l\u2019air\" est un spectacle unique qui fusionne l\u2019improvisation th\u00e9\u00e2trale et la danse contemporaine pour cr\u00e9er une exp\u00e9rience visuelle et \u00e9motionnelle captivante. Le spectacle met en avant l\u2019utilisation de la peinture color\u00e9e, qui est utilis\u00e9e comme un moyen de communication non verbal entre les acteur.rices-danseur.euses et le public. Le spectacle se d\u00e9roule dans un espace sc\u00e9nique minimaliste, o\u00f9 les acteur.rices-danseur.euses \u00e9voluent avec spontan\u00e9it\u00e9. Iels utilisent la peinture color\u00e9e pour cr\u00e9er des motifs, des formes et des tra\u00een\u00e9es dans l\u2019air, laissant ainsi des traces symboliques de leurs \u00e9motions, de leurs pens\u00e9es et de leurs relations. Les com\u00e9dien.nes et le.la danseur.euse explorent diff\u00e9rents th\u00e8mes et histoires en utilisant la peinture comme un langage visuel. Les couleurs deviennent des m\u00e9taphores, exprimant \u00e9motions, souvenirs et transformations. Le public est invit\u00e9 \u00e0 \u00eatre pleinement immerg\u00e9 dans l\u2019exp\u00e9rience, la peinture color\u00e9e cr\u00e9ant un paysage visuel sur les corps et le plateau changeant et porteur de sens. \"Quelque chose a chang\u00e9 dans l\u2019air\" est une exploration artistique sur l\u2019inexprim\u00e9, l\u2019impact de nos mots et de nos corps sur nous et sur les autres. C\u2019est un moment spontan\u00e9 et \u00e9ph\u00e9m\u00e8re qui laisse une empreinte subtile sur les personnages comme sur le public.","performers":"Compagnie Les Ecorc\u00e9s","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelque-chose-a-change-dans-l-air","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000165"},"sp":{"name":"Quelque chose a chang\u00e9 dans l'air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelque-chose-a-change-dans-l-air","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000165"},"nl":{"name":"Quelque chose a chang\u00e9 dans l'air","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelque-chose-a-change-dans-l-air","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000165"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_st