els.imgix.net\/b7c973dc1c6aa3d38fbda255ce56a524a52ef651.jpg","width":720,"height":548,"ratio":1.31,"translations":{"fr":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"nl":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"en":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/61fd8f7144d0197fc8119cb426b2924d9a02a151.jpg","width":720,"height":856,"ratio":0.84,"translations":{"fr":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"nl":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"en":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/aade301350dfdf366b60de27a8e9ec5517cd9d6c.jpg","width":720,"height":960,"ratio":0.75,"translations":{"fr":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"nl":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"en":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/6f8232f1fdb9da3ebee4e2b1eb097ac0c3dbf2fe.jpg","width":720,"height":861,"ratio":0.84,"translations":{"fr":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"nl":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"en":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/a4c1c166e7afa3ead3057118d427013c99296285.jpg","width":720,"height":960,"ratio":0.75,"translations":{"fr":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"nl":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null},"en":{"title":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","copyright":null}}}],"dates":[{"day":"2021-11-20","doors":"10:30:00","start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-01-15","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":true,"is_canceled":false},{"day":"2022-03-12","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-05-21","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":true,"is_canceled":false},{"day":"2022-07-09","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":true,"is_canceled":false},{"day":"2022-11-12","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":65}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[323],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-08T18:05:07+02:00","published_at":"2021-09-07T17:12:00+02:00","backoffice_id":238574,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.14083339793634},{"id":532815,"date_start":"2022-06-18","date_end":"2022-07-10","date_next":"2022-07-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":null,"longdescr":"Quand notre cher Guidon a foul\u00e9 du pied les berges du Broeck, caracolant le long du Rinck de la future Vaillance, pouvait-il s'imaginer que son culte donnerait naissance \u00e0 une coll\u00e9giale superbe ? Que d'aucun se pencherait sur cette s\u00e9pulture trap\u00e9zo\u00efdale ? Que l'on referait son histoire \u00e0 coup de suppositions, intrigu\u00e9s que nous sommes tous par ces pierres aux origines incertaines? Imaginait-il aussi que de gentes b\u00e9guines participeraient \u00e0 cette vie rurale aux portes de la ville ou qu'un Humaniste des plus r\u00e9put\u00e9s se ressourcerait \u00e0 l'ombre de la coll\u00e9giale qui porte encore et toujours son nom? Ah ! Ce petit sacristain de Laeken a vraiment plus d'un tour dans son sac ! Au point de concourir aux b\u00e9n\u00e9dictions d'animaux\u2026 quitte \u00e0 rendre jaloux Hubert. Seul Pierre aura la clef du myst\u00e8re.\r\n\r\nR\u00e9servation obligatoire et mise \u00e0 disposition d\u2019un guide pendant 2h. Possibilit\u00e9 d\u2019inclure la visite de la Maison d\u2019Erasme et du B\u00e9guinage en suppl\u00e9ment (selon les conditions tarifaires des partenaires).","performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532815.html"},"nl":{"name":"Anderlecht: Herinnering aan de begijnen, Sint-Guido en Erasmus","shortdescr":null,"longdescr":"Toen die goede Guido langs de beemden van het Broeck dartelde en langs de Rinck zwierf, waar later het Dapperheidsplein zou worden aangelegd, kon hij zich vast niet voorstellen dat zijn verering aanleiding zou geven tot de bouw van een prachtige collegiale kerk. Daarbovenop zou hij verbaasd zijn dat zijn trapeziumvormig graf zo druk wordt bezocht of dat zijn legende bol zou staan van de hypotheses, omdat de onzekere oorsprong van die stenen ons nu eenmaal intrigeert. Had hij ooit durven dromen dat liefelijke begijnen zouden deel uitmaken van het landelijke leven aan de poorten van de stad en dat een van de beroemdste humanisten zou herbronnen in de schaduw van de collegiale kerk die tot op vandaag zijn naam draagt? Die kleine koster van Laken heeft in ieder geval heel wat teweeggebracht. Zo zegende hij zelfs dieren! Sint-Hubertus werd er zowaar jaloers van. Alleen Sint-Pieter zal later een eindoordeel kunnen vellen. \r\n\r\nVergoeding voor een gids van twee uur. Mogelijkheid om het bezoek aan het Erasmushuis en het Begijnhof als extra te boeken, volgens de prijsvoorwaarden van onze partners.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532815.html"},"en":{"name":"Anderlecht: Memories of the Beguines, Saint Guidon and Erasme","shortdescr":null,"longdescr":"When dear old Guy first set foot in Broeck, sauntering around the Rinck, which would later become known as place de la Vaillance, little could he have imagined that his devotees would end up building him a magnificent collegiate church. Or that crowds would crane over this trapezoidal tomb. That his life story would be re-enacted based on suppositions and guesswork, intrigued as we all are by tombstones of uncertain origin. How could he have envisaged that the Beguines would pay homage to his humble lifestyle by the city gates, or that one of the world\u2019s most renowned Humanists would come to re-emerge from the shadows of the collegiate church that still bears his name today? There can be no doubt, this little sacristan from Laeken was full of surprises! He even made it his business to bless animals\u2026 enough to make Saint Hubert, the patron saint of hunters, green with envy. Only Peter has the key to the mystery.  \r\n\r\n\u20ac160 for a guide for 2 hours. Possibility of including a visit of Erasmus House and the Beguinage as an extra. Depending on the price conditions of our partners","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532815.html"},"de":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532815.html"},"it":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532815.html"},"sp":{"name":"Anderlecht: Informaci\u00f3n sobre las beguinas, san Guido y Erasmo","shortdescr":null,"longdescr":"Cuando nuestro querido Guido puso un pie en las orillas del Broeck, caminando a lo largo del Rinck de la futura Vaillance, \u00bfpodr\u00eda haber imaginado que su culto dar\u00eda a luz a una magn\u00edfica colegiata? \u00bfQue algunos mirar\u00edan esta sepultura trapezoidal? \u00bfQue, intrigados por estas piedras de origen incierto, reconstruir\u00edamos su historia a base de suposiciones? \u00bfSe imaginar\u00eda tambi\u00e9n que los pueblos beguinos participar\u00edan de esta vida rural en las afueras de la ciudad o que uno de los humanistas m\u00e1s famosos recuperar\u00eda fuerzas a la sombra de la colegiata que a\u00fan lleva su nombre? \u00a1Ah! Este peque\u00f1o sacrist\u00e1n de Laeken guarda m\u00e1s de un truco bajo la manga. Hasta el punto de contribuir con las bendiciones de los animales\u2026 incluso si eso significa poner celoso a Hubert. Solo Pierre tendr\u00e1 la clave del misterio. \r\n\r\nPrestaci\u00f3n de los servicios de un gu\u00eda durante 2 horas. Posibilidad de incluir una visita a la Casa de Erasmo y al B\u00e9guinage con un coste adicional (seg\u00fan las condiciones tarifarias de los socios).","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532815.html"},"pt":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532815.html"},"cn":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532815.html"}},"place":{"id":8600,"translations":{"fr":{"name":"Maison d'Erasme","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"\u00c9rasme a s\u00e9journ\u00e9 en 1521 dans cette maison gothique (1450-1515) qui rassemble \u00e0\r\nla fois une collection de peintures, gravures et scuptures (Albrecht Du\u0308rer, Joos Van\r\nCleve, Pieter Huys, Cornelis Metsys, Frans Francken le Jeune \u2026), une biblioth\u00e8que\r\nsp\u00e9cialis\u00e9e dans les \u00e9ditions princeps, c\u2019est-\u00e0-dire les premi\u00e8res \u00e9ditions d\u2019une \u0153uvre\r\nchez diff\u00e9rents imprimeurs, un Jardin philosophique et un Jardin de plantes\r\nm\u00e9dicinales. Le mus\u00e9e publie des livres et organise des conf\u00e9rences, des concerts,\r\ndes expositions d\u2019art contemporain et historiques, des activit\u00e9s p\u00e9dagogiques, des\r\nvisites guid\u00e9es pour groupes.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Erasmushuis","address_street_name":"Formanoirstraat","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Formanoirstraat, 31","address_line2":"1070 Anderlecht","description_web":"In 1521 verbleef Erasmus in dit gotische huis (1450-1515) waar zich niet alleen een collectie bevindt van schilderijen, prenten en beeldhouwwerken (Albrecht Du\u0308rer, Joos\r\nVan Cleve, Pieter Huys, Cornelis Metsys, Frans Francken de Jongere\u2026), maar ook een\r\nbibliotheek gespecialiseerd in \u2018editiones principes\u2019, dat wil zeggen de eerste uitgaven\r\nvan een werk bij verschillende drukkers. Verder bevindt zich buiten nog een Filosofische\r\ntuin en een tuin met Geneeskrachtige planten.\r\nDaarnaast publiceert het museum boeken en organiseert voordrachten, concerten,\r\ntentoonstellingen met een historisch thema en tentoonstellingen Hedendaagse kunst,\r\npedagogische activiteiten en rondleidingen voor groepen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Erasmus House","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"For several years, this house, which looks like a cloister, was home to the brilliant 16th-century humanist. Works of art, engravings, books, and archives bear witness to life in that era. End your visit in the philosophical and medicinal garden.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Museum des Maison d'Erasme","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"Das \u201eMaison d\u2019Erasme\u201c in der Br\u00fcsseler Gemeinde Anderlecht wurde Ende des 15. Jahrhunderts im Auftrag eines Stiftsherrn der nahegelegenen Stiftskirche St. Peter und St. Guido  im sp\u00e4tgotischen Stil errichtet.\r\n\r\nDas Haus beherbergte im Jahr 1521 den bedeutenden niederl\u00e4ndischen Gelehrten des Renaissance-Humanismus Erasmus von Rotterdam, der hier, fernab von den gro\u00dfen Machtzentren und den dort herrschenden Religionskriegen, die Ruhe und Abgeschiedenheit der Natur suchte.\r\n\r\nDas im Maison d\u2019Erasme untergebrachte Museum zeigt sowohl eine Gem\u00e4ldesammlung mit Werken von Holbein, Bosch und Metsys als auch eine reich mit alten B\u00fccherausgaben best\u00fcckte Bibliothek. Der umliegende Garten besteht aus einem \u201eJardin des Maladies\u201c \u2013 dem \u201eGarten der Krankheiten\u201c mit zahlreichen Heilpflanzen \u2013 und einem \u201eJardin philosophique\u201c \u2013 dem \u201ePhilosophischen Garten\u201c.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Casa di Erasmo","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Casa di Erasmo deve il suo nome e la sua fama ad Erasmo da Rotterdam, che vi soggiorn\u00f2 nel 1521. Divenuta un museo dedicato al grande umanista rinascimentale, \u00e8 luogo di esposizione di una collezione unica composta da opere d'arte - sculture e dipinti di maestri fiamminghi -, mobili e libri antichi, molti dei quali scritti dallo stesso Erasmo. Se la Casa di Erasmo \u00e8 una delle pi\u00f9 antiche di Bruxelles - costruita in tre fasi nel corso dei secoli XV e XVI -, nel 1932 \u00e8 stata oggetto di un restauro completo voluto, nello spirito del pi\u00f9 puro storicismo, da Daniel Van Damme, fondatore del museo, con l'aiuto dell'architetto Charles Van Elst, che costru\u00ec anche la casa di Maurice Car\u00eame.  Gli spazi interni sono stati poi riconvertiti in sale del museo. Queste sono state decorate (una stanza con le pareti completamente rivestite di sontuose pelli di Cordoba) ed arredate con mobili provenienti dall'antica collezione del Ministro Vandenpeereboom. Gli interni sono quindi ricostruzioni con lo scopo di dare ai visitatori un'idea di quello che poteva essere una residenza rinascimentale. Le ricostruzioni sono in parte basate su documenti storici (lo studio di Erasmo che d\u00e0 sul giardino) ed in parte su ritrovamenti archeologici quali lo splendido fregio affrescato del primo piano. Nella parte posteriore della casa, un ampio giardino ombreggiato da grandi alberi conserva alcuni resti archeologici dell'antico castello di Anderlecht, poeticamente abbinati a diverse installazioni di artisti contemporanei. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa de Erasmo","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Casa de Erasmo debe su nombre y prestigio a la temporada que pas\u00f3 en ella Erasmo de R\u00f3terdam en 1521. Convertida en un museo dedicado a este gran humanista del Renacimiento, es el envoltorio de una colecci\u00f3n \u00fanica compuesta por obras de arte (esculturas y pinturas de maestros flamencos), muebles y libros antiguos, entre ellos numerosas ediciones erasmianas. Si la Casa de Erasmo es una de las m\u00e1s antiguas de Bruselas (construida en tres fases a lo largo de los siglos XV y XVI), a partir de 1932 fue objeto de una restauraci\u00f3n completa llevada a cabo, en el m\u00e1s puro historicismo, por Daniel Van Damme, fundador del museo, con la ayuda del arquitecto Charles Van Elst, que tambi\u00e9n construy\u00f3 la casa de Maurice Car\u00eame. Los espacios interiores se reorganizaron entonces en salas de museo que fueron decoradas (entre ellas, una sala con las paredes totalmente cubiertas por suntuosas pieles de C\u00f3rdoba) y amuebladas con mobiliario procedente de la antigua colecci\u00f3n del ministro Vandenpeereboom. El interior es, por tanto, una reproducci\u00f3n cuyo fin es dar a los visitantes la idea de lo que podr\u00eda haber sido una residencia en el Renacimiento, basada en parte en documentos hist\u00f3ricos (despacho de Erasmo frente al jard\u00edn) y en hallazgos arqueol\u00f3gicos como el maravilloso friso pintado al fresco del primer piso. Detr\u00e1s de la casa, un vasto jard\u00edn con grandes \u00e1rboles que le dan sombra conserva algunos restos arqueol\u00f3gicos del antiguo castillo de Anderlecht, los cuales se encuentran, po\u00e9ticamente, cerca de varias instalaciones de artistas contempor\u00e1neos. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la Maison d'Erasme","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la Maison d'Erasme","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":327,"location":{"lat":50.83592263,"lon":4.3077579},"region":"brussels","last_updated_at":"2022-05-12T10:35:10+02:00","published_at":"2013-10-19T01:13:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":230072,"translations":{"fr":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":"Professionnels dans l'organisation d\u2019\u00e9v\u00e9nements culturels depuis 1986.\r\nVous \u00eates \u00e0 la recherche d'un team-building cr\u00e9atif et culturel pour vos collaborateurs? Ou d'un programme social pour vos clients? Contactez-nous et d\u00e9couvrez nos propositions:\r\n- Rallyes inoubliables: New: \"Enigme sanglant, mais qui a tu\u00e9 monsieur le Comte?\" devenez un detective et trouvez la solution: \u00e0 pied, en tuk tuk, dans une old timer...\r\n- Dine Around (Entr\u00e9e, plat et dessert en trois restaurant) et sa version Best Of: avec un workshop chocolat chez Laurent Gerbaud comme dessert!\r\n- Chateaux et lieux exclusifs pour vos \u00e9v\u00e9nements d\u2019atmosph\u00e8re et tour VIP\r\n- Diner Thematique: Ex: Art Nouveau, possibilit\u00e9 de l'agr\u00e9menter avec: guides costum\u00e9s, musique live, interpr\u00e8te de Jacques Brel, magiciens, danseurs, acteurs,...\r\n- Itin\u00e9raires sur mesure: Art Nouveau, Anvers \u00e0 la mode, hommage \u00e0 Brel, Brussels by night, Bi\u00e8re et Chocolat, Bruxelles insolite, Simenon et Maigret, Atelier mode, design, Le Gay Bruxelles, \"Qui a tu\u00e9...\", Bruxelles durable.\r\n\r\nSur Bruxelles et toute la Belgique. Nous r\u00e9pondons sur mesure et \u00e0 la demande.\r\nNotre Equipe:\r\n- 4 professionnels pour s'assurer que votre programme atteigne vos objectifs et d\u00e9passe les attentes de vos clients.\r\n- 200 guides multilingues, acteurs, coordinateurs, hotesses,... sp\u00e9cialis\u00e9s dans la mise \u00e0 l'honneur de la Belgique et ses tr\u00e9sors cach\u00e9s.\r\n- 7 jours sur 7\r\n- Notre objectif: vivre l'Art comme un Art de Vivre.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Itin\u00e9raires","address_street_name":"Waterleidingsstraat","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Waterleidingsstraat, 171","address_line2":"1050 Elsene","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":"CULTURAL EVENTS SINCE 1986 \r\nAre you looking for fresh and creative incentive, team-building, or social programs for your clients? Contact us and fi nd out what\u2019s on the \u201cmenu\u201d: \r\n\u2022  Unforgettable rallies: NEW! \u201cBloody inquiry, become one of our most famous detective\u201d -> On foot, tuk tuk, old street car,... \r\n\u2022  Dine Around (3 courses in 3 differents venues). Best of version: with a chocolat workshop at Laurent Gerbaud \u2022 Private Castles for exclusive events & atmosphere and exclusive tours \r\n\u2022  Thematic Diner: Ex: Art Nouveau, possibilities of : costumed guides, live band, a Jacques Brel singer,... \r\n\u2022  Custom-tailored itineraires: Art Nouveau, Trendy Antwerp, Brel and Brussels by night, Beer and chocolate, another Bruges, Simenon and Maigret, Fashion workshops, design, Brussels is there for you, the Gay Brussels, \u201cWho killed Sir the Count?\u201d, Sustainable Brussels.\r\n\r\nIn Brussels and all Belgium. Our programs are exclusive and interactive.\r\nOur team: \r\n\u2022  4 specialists who ensure that your program meets your objectives and exceeds your clients expectations. \r\n\u2022  200 multilingual guides, entertainers, coordinators, hotesses, ... specialists in Belgium\u2019s off  the beaten path treasures. \r\n\u2022  We answer 7 days a week \r\n\u2022 Our aim: to live art as an \u201cArt de Vivre\u201d ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virt