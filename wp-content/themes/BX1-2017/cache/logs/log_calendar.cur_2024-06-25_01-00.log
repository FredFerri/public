:{"name":"Ancienne manufacture Demeuldre-Coch\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/ancienne-manufacture-demeuldre-coche","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008715"},"cn":{"name":"Ancienne manufacture Demeuldre-Coch\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/ancienne-manufacture-demeuldre-coche","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008715"},"fr":{"name":"Ancienne manufacture Demeuldre-Coch\u00e9","shortdescr":null,"longdescr":"Cette ancienne manufacture de porcelaine fond\u00e9e en 1830, a produit nombre de porcelaines et fa\u00efences d\u00e9coratives destin\u00e9es aux b\u00e2timents bruxellois d'architectes de renom comme Victor Horta et Paul Saintenoy. Les carreaux qui ornent la fa\u00e7ade des anciens magasins Old England (actuel Mus\u00e9e des Instruments de Musique) en sont un bel exemple. De style \u00e9clectique, l'imposante fa\u00e7ade tr\u00e8s ouvrag\u00e9e est d\u00e9cor\u00e9e de c\u00e9ramiques polychromes. Les larges vitrines du rez-de-chauss\u00e9e laissent voir l'int\u00e9rieur du magasin et son d\u00e9cor de boiseries. D'anciens panneaux en c\u00e9ramique verniss\u00e9e dont trois remarquables all\u00e9gories sign\u00e9es Isidore De Rudder (1897) - l'Harmonie, la Couleur et la Mesure - t\u00e9moignent encore du savoir-faire de l'ancien \u00e9tablissement qui s'assurait la collaboration d'artistes renomm\u00e9s. L'ancienne manufacture abrite aujourd'hui la galerie d'art TALK C.E.C, un lieu novateur multidisciplinaire qui r\u00e9partit ses activit\u00e9s en alliant culture et d\u00e9couverte.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/ancienne-manufacture-demeuldre-coche","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008715"},"sp":{"name":"Ancienne manufacture Demeuldre-Coch\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/ancienne-manufacture-demeuldre-coche","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008715"},"nl":{"name":"Ancienne manufacture Demeuldre-Coch\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/ancienne-manufacture-demeuldre-coche","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008715"}},"place":{"id":50001369,"translations":{"de":{"name":"Ancienne manufacture Demeuldre-Coch\u00e9","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"141-143","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre, 141-143","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Ancienne manufacture Demeuldre-Coch\u00e9","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"141-143","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre, 141-143","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"n