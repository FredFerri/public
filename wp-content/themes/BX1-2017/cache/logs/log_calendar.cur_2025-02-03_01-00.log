e,"is_first":true},"time_start":"09:30:00","time_end":"17:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier lundis du mois de 09:30 \u00e0 17:00","nl":"Open op de eerste, tweede, derde, vierde en laatste maandags van de maand van 09:30 tot 17:00","en":"Open the first, second, third, fourth and last mondays of the month from 09:30 to 17:00"}},{"day":"tuesday","occurences":{"is_last":true,"is_fourth":true,"is_third":true,"is_second":true,"is_first":true},"time_start":"09:30:00","time_end":"17:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier mardis du mois de 09:30 \u00e0 17:00","nl":"Open op de eerste, tweede, derde, vierde en laatste dinsdags van de maand van 09:30 tot 17:00","en":"Open the first, second, third, fourth and last tuesdays of the month from 09:30 to 17:00"}},{"day":"sunday","occurences":{"is_last":true,"is_fourth":true,"is_third":true,"is_second":true,"is_first":true},"time_start":"10:00:00","time_end":"18:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier dimanches du mois de 10:00 \u00e0 18:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zondags van de maand van 10:00 tot 18:00","en":"Open the first, second, third, fourth and last sundays of the month from 10:00 to 18:00"}}],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":530835,"date_start":"2022-01-03","date_end":"2026-12-31","date_next":"2025-02-02","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":true,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-02T01:03:10+01:00","published_at":"2022-04-04T12:13:23+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":250835,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.10311813598464194,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Belgi\u00eb kennen als z'n broekzak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.530835"},"pt":{"name":"Belgi\u00eb kennen als z'n broekzak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.530835"},"en":{"name":"Belgi\u00eb kennen als z'n broekzak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.530835"},"it":{"name":"Belgi\u00eb kennen als z'n broekzak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.530835"},"cn":{"name":"Belgi\u00eb kennen als z'n broekzak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.530835"},"fr":{"name":"La Belgique dans la poche","shortdescr":"La Belgique dans la poche!","longdescr":"Avec un guide, les enfants se lancent dans une exp\u00e9dition ludique et interactive \u00e0 travers l\u2019histoire de la Belgique.\r\n\r\nJeux de r\u00f4le, dessins, missions \u00e0 accomplir, les enfants sont les acteurs de la visite.\r\n\r\nLa visite est adapt\u00e9e suivant les comp\u00e9tences terminales des diff\u00e9rentes ann\u00e9es.\r\n\r\n4\u00e8me primaire : voter et fuir !\r\nDans une d\u00e9mocratie, les habitants d\u2019un pays d\u00e9terminent ce qui se passe dans leur pays. Ensemble, nous cherchons la signification du mot d\u00e9mocratie. Qui peut dire les points communs et les diff\u00e9rences entre : \u00ab je pars \u00bb et \u00ab ils sont partis \u00bb? Sous la forme de jeux, nous d\u00e9couvrons la d\u00e9mocratie, la migration et l\u2019immigration.\r\n\r\n5\u00e8me primaire : est-on heureux quand on est riche ?\r\nLa prosp\u00e9rit\u00e9 correspond \u00e0 ce que nous pouvons acheter avec notre argent. Qui a d\u00e9j\u00e0 entendu dire que la Belgique est un \u00c9tat-providence ? Dans ce jeu, nous examinons de plus pr\u00e8s la signification de la prosp\u00e9rit\u00e9 et la solidarit\u00e9.\r\n\r\n6\u00e8me primaire : devenir grand\r\n\r\nQu\u2019en pensez-vous : est-ce important d\u2019avoir diff\u00e9rentes opinions ? Que feriez-vous si vous ne pouviez pas r\u00e9soudre certaines choses seuls en Belgique ? Ce jeu interactif s\u2019int\u00e9resse \u00e0 l\u2019importance du pluralisme et de l\u2019Europe\r\n\r\nR\u00e9servation\r\nContacter directement Arkadia: T: +32 (0)2 319 45 60 - info@arkadia.be","performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.530835"},"sp":{"name":"Belgi\u00eb kennen als z'n broekzak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.530835"},"nl":{"name":"Belgi\u00eb kennen als z'n broekzak","shortdescr":"Belgi\u00eb kennen als z'n broekzak!","longdescr":"De kinderen storten zich samen met een gids in een zoektocht door Belgi\u00eb en zijn geschiedenis. Rollenspellen, tekeningen, uit te voeren missies, kortom de kinderen zijn de acteurs van het bezoek.\r\n\r\nHet bezoek is aangepast volgens de doelen en eindtermen van elk leerjaar.\r\n\r\n4de leerjaar: Stemmen en vluchten!\r\nIn een democratie bepalen de inwoners van een land zelf wat er in hun land gebeurt. Samen gaan we op zoek naar de betekenis van het woordje democratie. En wie van jullie ontdekt de overeenkomsten en de verschillen tussen: \u2018Ik vertrek\u2019 en \u2018Zij vertrokken\u2019? Spelenderwijs maken we kennis met democratie, migratie en immigratie.\r\n\r\n5de leerjaar: Ben je wel als je wel vaart?\r\nWelvaart is wat kunnen we kopen van ons geld. Wie heeft ooit al gehoord over moedertje Belgi\u00eb is een verzorgingsstaat? In deze ontdekkingstocht gaan we dieper in op de betekenis van welvaart en solidariteit.\r\n\r\n6de leerjaar: Groot worden\r\nWat denk jij: zijn verschillende meningen belangrijk? En wat zou je doen je als je sommige dingen niet alleen kunt oplossen in Belgi\u00eb? Een interactieve zoektocht naar de waarde van het pluralisme en van Europa.\r\n\r\nReservatie\r\nContacteer Korei: T: + 32 2 380 22 09 - info@korei.be","performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.530835"}},"place":{"id":233379,"translations":{"de":{"name":"Museum BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Belgische Fritten, Bier, Schokolade...Belgien ist mehr als nur das, oder? Demokratie, Wohlstand, Solidarit\u00e4t, Vielfalt, Migration, Sprachen, Europa: Dies sind die Themen, die das BELvue Museum Ihnen auf Ihrem Rundgang durch die Ausstellungsr\u00e4ume n\u00e4herbringt! Jedes Thema wird anhand von aktuellen Kommentaren und Berichten geschildert und dann in seinen geschichtlichen Kontext gebracht. Eine moderne und originelle Herangehensweise, die den Besuchern einen faszinierenden Einblick in das Belgien der Gegenwart gew\u00e4hrt.\r\n\r\nAbsolut sehenswert ist auch die Galerie: Mehr als 200 Ausstellungsst\u00fccke verk\u00f6rpern gewisserma\u00dfen das materielle Ged\u00e4chtnis Belgiens. Zu bewundern gibt es unter anderem eine Lithographie von Magritte, Kristallvasen aus der Kristallmanufaktur Val Saint-Lambert und sogar einen von den Roten Teufeln signierten Fu\u00dfball. Eine geballte Ladung belgischer Lebensart!\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Apresentando-se como o museu da B\u00e9lgica e da sua hist\u00f3ria, mas igualmente como \u00abcentro para a democracia\u00bb, o estabelecimento beneficia de uma museografia recentemente completamente remodelada. Democracia, prosperidade, solidariedade, pluralismo, migra\u00e7\u00f5es, l\u00ednguas, Europa: o museu BELvue prop\u00f5e-lhe descobrir o pa\u00eds atrav\u00e9s desses temas. A abordagem quer-se original, pelo que cada tema \u00e9, em primeiro lugar, explicitado com a ajuda de testemunhas reais e, de seguida, contextualizado atrav\u00e9s da hist\u00f3ria. Mais de 200 objetos comp\u00f5em uma galeria e permitem incarnar a mem\u00f3ria material do pa\u00eds. Poder\u00e1 a\u00ed encontrar, por exemplo, uma litografia de Magritte, vasos em cristal produzidos por Val Saint-Lambert, m\u00e1scaras de carnaval da regi\u00e3o de Binche, ou ainda um bal\u00e3o assinado pela Sele\u00e7\u00e3o Belga de Futebol! Este edif\u00edcio, inicialmente usado como hotel, foi constru\u00eddo em 1776 \u2014 e aberto durante o ano seguinte \u2014 num tur\u00edstico, comercial (dif\u00edcil imagin\u00e1-lo hoje em dia!) e muito cosmopolita (o hotel Astoria, na rua Royale, \u00e9 a \u00fanica testemunha atual). O estabelecimento recebia essencialmente turistas, a maioria dos quais ingleses, mas n\u00e3o qualquer turista: tratava-se de um hotel de luxo, com clientes prestigiosos. De estilo neocl\u00e1ssico, como toda a Pra\u00e7a Real, o edif\u00edcio privilegia a sobriedade e as propor\u00e7\u00f5es harmoniosas. A visita interior oferecer-lhe-\u00e1 ainda mais detalhes de decora\u00e7\u00e3o. O Parque de Bruxelas consiste num polo de atra\u00e7\u00e3o para os turistas: o passeio mundano \u00e9, na realidade, um trabalho de escolha. \u00abDo meio-dia \u00e0 uma, este passeio torna-se, simplesmente, o local de encontro de estranhos e ricos. Esta salada de frutas de pa\u00edses que se encontram alegra este local durante algumas horas por dia\u00bb. Se, em geral, as rela\u00e7\u00f5es de Bellevue com o seu ilustre vizinho \u2014 o Pal\u00e1cio Real \u2014 permanecem boas, com o hotel a alojar frequentemente convidados de honra pass\u00edveis de uma visita real, poderiam ter ocorrido algumas fric\u00e7\u00f5es, nomeadamente devido \u00e0 constru\u00e7\u00e3o dos terra\u00e7os adjacentes ao estabelecimento, que oferecem uma vista magn\u00edfica para os jardins do rei, o que n\u00e3o \u00e9 muito do agrado de L\u00e9opold II\u2026 Ver o panfleto sobre a hist\u00f3ria do edif\u00edcio, dispon\u00edvel no local A entrada para o museu BELvue \u00e9 gratuita todas as ter\u00e7as-feiras a partir das 14h.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussels","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussels","description_web":"Chips, beer and chocolates... surely there is more to Belgium than that? Democracy, prosperity, solidarity, pluralism, migration, languages and Europe: these are the themes used by the BELvue Museum to help you to discover Belgium. Each one is developed through present-day testimonials and then traced right through history. This is a modern, original way of gaining a fuller understanding of modern-day Belgium.\r\nHave a look at the gallery too: there are more than 200 objects to view, each one forming a tangible memory of Belgium. Here are just a few examples: a lithograph by Magritte, a motorcycle, crystal vases by Val Saint-Lambert, and a football signed by the Red Devils. The very essence of Belgian-ness!\r\n\r\nSpeciale openingstijden op schoolvakanties en feestdagen 9.30 tot 17.00 uur\r\n24\/12 en 31\/12 9u30 tot 16u00\r\nHet BELvue Museum is elke woensdag vanaf 14u en de eerste zondag van de maand gratis toegankelijk.\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.BELvue-Museum.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Nel Museo BELvue, grazie a numerosi documenti, i visitatori potranno scoprire i grandi periodi della storia del Belgio.\u00a0...\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Se pr\u00e9sentant comme le mus\u00e9e de la Belgique et de son histoire, mais \u00e9galement comme \u00ab centre pour la d\u00e9mocratie \u00bb, l\u2019\u00e9tablissement b\u00e9n\u00e9ficie d\u2019une mus\u00e9ographie compl\u00e8tement remani\u00e9e depuis peu. D\u00e9mocratie, prosp\u00e9rit\u00e9, solidarit\u00e9, pluralisme, migrations, langues, Europe : le mus\u00e9e BELvue vous propose de d\u00e9couvrir le pays \u00e0 travers ces quelques th\u00e9matiques. L\u2019approche se veut originale, puisque chaque th\u00e9matique est d\u2019abord explicit\u00e9e \u00e0 l\u2019aide de t\u00e9moignages actuels, et ensuite contextualis\u00e9e \u00e0 travers l\u2019histoire. Plus de 200 objets composent une galerie et permettent d\u2019incarner la m\u00e9moire mat\u00e9rielle du pays. Vous y croiserez par exemple une lithographie de Magritte, des vases en cristal du Val Saint-Lambert, un costume du carnaval de Binche, ou encore un ballon sign\u00e9 par les Diables Rouges !\r\n\r\nCe b\u00e2timent, affect\u00e9 initialement \u00e0 l\u2019usage d\u2019un h\u00f4tel, est b\u00e2ti en 1776 \u2014 et ouvert dans le courant de l\u2019ann\u00e9e suivante \u2014 dans un p\u00f4le \u00e0 vocation touristique, commercial (difficile \u00e0 s\u2019imaginer aujourd\u2019hui !), et tr\u00e8s cosmopolite (l\u2019h\u00f4tel Astoria, rue Royale, en demeure le seul t\u00e9moin actuel). L\u2019\u00e9tablissement recevait essentiellement des touristes, en majorit\u00e9 anglais, mais pas n\u2019importe quels touristes : il s\u2019agit d\u2019une h\u00f4tellerie de luxe, avec des clients prestigieux.\r\n\r\nDe style n\u00e9oclassique, comme l\u2019ensemble de la place Royale, le b\u00e2timent privil\u00e9gie la sobri\u00e9t\u00e9 et les proportions harmonieuses. La visite int\u00e9rieure vous offrira davantage de d\u00e9tails sur le d\u00e9cor.\r\n\r\nLe Parc de Bruxelles constituait un p\u00f4le d\u2019attraction pour les touristes : la promenade mondaine est en effet une occupation de choix. \u00ab De midi \u00e0 une heure, cette promenade devient ordinairement le rendez-vous des \u00e9trangers et des gens riches. Cette mac\u00e9doine de nations qu\u2019on y rencontre \u00e9gaie quelques heures par jour cet endroit. \u00bb\r\nSi globalement, les relations du Bellevue avec son illustre voisin \u2014 le palais royal \u2014 restent bonnes, l\u2019h\u00f4tel h\u00e9bergeant m\u00eame souvent des invit\u00e9s de marque susceptibles d\u2019une entrevue royale, quelques frictions ont pu appara\u00eetre, notamment \u00e0 cause de la construction de terrasses adjacentes \u00e0 l\u2019\u00e9tablissement, et donnant une vue magnifique sur les jardins du roi, ce qui n\u2019\u00e9tait pas tr\u00e8s au go\u00fbt de L\u00e9opold II\u2026\r\n\r\nHoraire exceptionnel les jours de vacances scolaires et le jours f\u00e9ri\u00e9s 9h30 \u00e0 17h\r\nLe 24\/12 et le 31\/12 9h30 \u00e0 16:00\r\nL'entr\u00e9e au mus\u00e9e BELvue est gratuite tous les mercredis \u00e0 partir de 14 heures et le 1er dimanche du mois","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Musee-BELvue.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Conocido como el museo de B\u00e9lgica y su historia, pero tambi\u00e9n como \"centro para la democracia\", el establecimiento posee una museograf\u00eda completamente redise\u00f1ada desde hace poco. Democracia, prosperidad, solidaridad, pluralismo, migraciones, idiomas, Europa: El museo BELvue te propone descubrir el pa\u00eds a trav\u00e9s de diferentes tem\u00e1ticas. El enfoque es original, ya que cada tem\u00e1tica se explica en primer lugar con la ayuda de testimonios actuales y a continuaci\u00f3n es contextualizada a trav\u00e9s de la historia. M\u00e1s de 200 objetos componen una galer\u00eda para encarnar la memoria material del pa\u00eds. Encontrar\u00e1s, por ejemplo, una litograf\u00eda de Magritte, los vasos de cristal de Val Saint-Lambert, un disfraz del carnaval de Binche, \u00a1Y un bal\u00f3n firmado por los Diablos Rojos!\r\nEste edificio, originalmente utilizado como hotel, se construy\u00f3 en 1776 \u2014 y fue abierto durante el transcurso del a\u00f1o siguiente \u2014 como un centro de car\u00e1cter tur\u00edstico, comercial y muy cosmopolita. El establecimiento recibe esencialmente turistas, en su mayor\u00eda ingleses, pero no cualquier turista: se trata de un hospedaje de lujo, con clientes prestigiosos. De estilo neocl\u00e1sico, como el conjunto de la Place Royale, el edificio favorece la sobriedad y las proporciones armoniosas. La vista interior te ofrecer\u00e1 m\u00e1s detalles del decorado.\r\nEl Parque de Bruselas constituye un centro de atracci\u00f3n para los turistas: esta visita al parque es en efecto una excelente actividad a elegir. \"Entre media hora y una hora, este paseo se convierte generalmente en un punto de reuni\u00f3n para la diversidad, desde extranjeros hasta gente rica. Esta macedonia de nacionalidades que encontramos enriquece el ambiente del lugar\".\r\nSi las relaciones entre Bellevue y su ilustre vecino - el Palacio Real - siguen siendo buenas, el hotel hospeda a menudo a distinguidos invitados de entrevista real. Pueden haber surgido ciertos roces especialmente a causa de la contrucci\u00f3n de terrazas adyacentes al establecimiento, proporcionando una magn\u00edfica vista al Real Jard\u00edn de las Plantas Medicinales, el cual no era del agrado de Leopoldo ll.\r\nV\u00e9ase el folleto sobre la historia del edificio disponible en el lugar.\r\n\r\nLa entrada al museo BELvue es gratuita todos los mi\u00e9rcoles a partir de las 14:00.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Frieten, bier, chocolade\u2026 maar Belgi\u00eb is toch wel meer dan dat, nietwaar? Democratie, welvaart, solidariteit, pluralisme, migratie, taal, Europa: dat zijn de thema\u2019s die het BELvue museum jullie voorstelt om kennis te maken met het land! Elk thema wordt uitgewerkt aan de hand van hedendaagse getuigenissen en vervolgens toegelicht doorheen de geschiedenis. Een eigentijdse en originele manier om een beter inzicht te verwerven in het Belgi\u00eb van vandaag.\r\nNeem zeker ook een kijkje in de galerij: daar staan meer dan 200 voorwerpen opgesteld die het materi\u00eble geheugen van Belgi\u00eb vormen. Je kunt er onder andere de volgende zaken bewonderen: een lithografie van Magritte, een motorfiets, kristallen vazen van Val Saint-Lambert, en een bal met de handtekeningen van de Rode Duivels erop. Een verzameling met een hoog Belgi\u00ebgehalte!\r\n\r\nElke woensdag vanaf 14.00 uur is het BELvue museum gratis toegankelijk.\r\nMaandag open voor groepen en scholen op reservering van 09:30 tot 17:00\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.BELvue-museum.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":1250,"location":{"lat":50.8426107,"lon":4.3606882},"region":"brussels","last_updated_at":"2024-09-02T10:57:51+02:00","published_at":"2013-10-19T01:14:10+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":233379,"translations":{"de":{"name":"Museum BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Belgische Fritten, Bier, Schokolade...Belgien ist mehr als nur das, oder? Demokratie, Wohlstand, Solidarit\u00e4t, Vielfalt, Migration, Sprachen, Europa: Dies sind die Themen, die das BELvue Museum Ihnen auf Ihrem Rundgang durch die Ausstellungsr\u00e4ume n\u00e4herbringt! Jedes Thema wird anhand von aktuellen Kommentaren und Berichten geschildert und dann in seinen geschichtlichen Kontext gebracht. Eine moderne und originelle Herangehensweise, die den Besuchern einen faszinierenden Einblick in das Belgien der Gegenwart gew\u00e4hrt.\r\n\r\nAbsolut sehenswert ist auch die Galerie: Mehr als 200 Ausstellungsst\u00fccke verk\u00f6rpern gewisserma\u00dfen das materielle Ged\u00e4chtnis Belgiens. Zu bewundern gibt es unter anderem eine Lithographie von Magritte, Kristallvasen aus der Kristallmanufaktur Val Saint-Lambert und sogar einen von den Roten Teufeln signierten Fu\u00dfball. Eine geballte Ladung belgischer Lebensart!\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Apresentando-se como o museu da B\u00e9lgica e da sua hist\u00f3ria, mas igualmente como \u00abcentro para a democracia\u00bb, o estabelecimento beneficia de uma museografia recentemente completamente remodelada. Democracia, prosperidade, solidariedade, pluralismo, migra\u00e7\u00f5es, l\u00ednguas, Europa: o museu BELvue prop\u00f5e-lhe descobrir o pa\u00eds atrav\u00e9s desses temas. A abordagem quer-se original, pelo que cada tema \u00e9, em primeiro lugar, explicitado com a ajuda de testemunhas reais e, de seguida, contextualizado atrav\u00e9s da hist\u00f3ria. Mais de 200 objetos comp\u00f5em uma galeria e permitem incarnar a mem\u00f3ria material do pa\u00eds. Poder\u00e1 a\u00ed encontrar, por exemplo, uma litografia de Magritte, vasos em cristal produzidos por Val Saint-Lambert, m\u00e1scaras de carnaval da regi\u00e3o de Binche, ou ainda um bal\u00e3o assinado pela Sele\u00e7\u00e3o Belga de Futebol! Este edif\u00edcio, inicialmente usado como hotel, foi constru\u00eddo em 1776 \u2014 e aberto durante o ano seguinte \u2014 num tur\u00edstico, comercial (dif\u00edcil imagin\u00e1-lo hoje em dia!) e muito cosmopolita (o hotel Astoria, na rua Royale, \u00e9 a \u00fanica testemunha atual). O estabelecimento recebia essencialmente turistas, a maioria dos quais ingleses, mas n\u00e3o qualquer turista: tratava-se de um hotel de luxo, com clientes prestigiosos. De estilo neocl\u00e1ssico, como toda a Pra\u00e7a Real, o edif\u00edcio privilegia a sobriedade e as propor\u00e7\u00f5es harmoniosas. A visita interior oferecer-lhe-\u00e1 ainda mais detalhes de decora\u00e7\u00e3o. O Parque de Bruxelas consiste num polo de atra\u00e7\u00e3o para os turistas: o passeio mundano \u00e9, na realidade, um trabalho de escolha. \u00abDo meio-dia \u00e0 uma, este passeio torna-se, simplesmente, o local de encontro de estranhos e ricos. Esta salada de frutas de pa\u00edses que se encontram alegra este local durante algumas horas por dia\u00bb. Se, em geral, as rela\u00e7\u00f5es de Bellevue com o seu ilustre vizinho \u2014 o Pal\u00e1cio Real \u2014 permanecem boas, com o hotel a alojar frequentemente convidados de honra pass\u00edveis de uma visita real, poderiam ter ocorrido algumas fric\u00e7\u00f5es, nomeadamente devido \u00e0 constru\u00e7\u00e3o dos terra\u00e7os adjacentes ao estabelecimento, que oferecem uma vista magn\u00edfica para os jardins do rei, o que n\u00e3o \u00e9 muito do agrado de L\u00e9opold II\u2026 Ver o panfleto sobre a hist\u00f3ria do edif\u00edcio, dispon\u00edvel no local A entrada para o museu BELvue \u00e9 gratuita todas as ter\u00e7as-feiras a partir das 14h.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussels","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussels","description_web":"Chips, beer and chocolates... surely there is more to Belgium than that? Democracy, prosperity, solidarity, pluralism, migration, languages and Europe: these are the themes used by the BELvue Museum to help you to discover Belgium. Each one is developed through present-day testimonials and then traced right through history. This is a modern, original way of gaining a fuller understanding of modern-day Belgium.\r\nHave a look at the gallery too: there are more than 200 objects to view, each one forming a tangible memory of Belgium. Here are just a few examples: a lithograph by Magritte, a motorcycle, crystal vases by Val Saint-Lambert, and a football signed by the Red Devils. The very essence of Belgian-ness!\r\n\r\nSpeciale openingstijden op schoolvakanties en feestdagen 9.30 tot 17.00 uur\r\n24\/12 en 31\/12 9u30 tot 16u00\r\nHet BELvue Museum is elke woensdag vanaf 14u en de eerste zondag van de maand gratis toegankelijk.\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.BELvue-Museum.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Nel Museo BELvue, grazie a numerosi documenti, i visitatori potranno scoprire i grandi periodi della storia del Belgio.\u00a0...\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Se pr\u00e9sentant comme le mus\u00e9e de la Belgique et de son histoire, mais \u00e9galement comme \u00ab centre pour la d\u00e9mocratie \u00bb, l\u2019\u00e9tablissement b\u00e9n\u00e9ficie d\u2019une mus\u00e9ographie compl\u00e8tement remani\u00e9e depuis peu. D\u00e9mocratie, prosp\u00e9rit\u00e9, solidarit\u00e9, pluralisme, migrations, langues, Europe : le mus\u00e9e BELvue vous propose de d\u00e9couvrir le pays \u00e0 travers ces quelques th\u00e9matiques. L\u2019approche se veut originale, puisque chaque th\u00e9matique est d\u2019abord explicit\u00e9e \u00e0 l\u2019aide de t\u00e9moignages actuels, et ensuite contextualis\u00e9e \u00e0 travers l\u2019histoire. Plus de 200 objets composent une galerie et permettent d\u2019incarner la m\u00e9moire mat\u00e9rielle du pays. Vous y croiserez par exemple une lithographie de Magritte, des vases en cristal du Val Saint-Lambert, un costume du carnaval de Binche, ou encore un ballon sign\u00e9 par les Diables Rouges !\r\n\r\nCe b\u00e2timent, affect\u00e9 initialement \u00e0 l\u2019usage d\u2019un h\u00f4tel, est b\u00e2ti en 1776 \u2014 et ouvert dans le courant de l\u2019ann\u00e9e suivante \u2014 dans un p\u00f4le \u00e0 vocation touristique, commercial (difficile \u00e0 s\u2019imaginer aujourd\u2019hui !), et tr\u00e8s cosmopolite (l\u2019h\u00f4tel Astoria, rue Royale, en demeure le seul t\u00e9moin actuel). L\u2019\u00e9tablissement recevait essentiellement des touristes, en majorit\u00e9 anglais, mais pas n\u2019importe quels touristes : il s\u2019agit d\u2019une h\u00f4tellerie de luxe, avec des clients prestigieux.\r\n\r\nDe style n\u00e9oclassique, comme l\u2019ensemble de la place Royale, le b\u00e2timent privil\u00e9gie la sobri\u00e9t\u00e9 et les proportions harmonieuses. La visite int\u00e9rieure vous offrira davantage de d\u00e9tails sur le d\u00e9cor.\r\n\r\nLe Parc de Bruxelles constituait un p\u00f4le d\u2019attraction pour les touristes : la promenade mondaine est en effet une occupation de choix. \u00ab De midi \u00e0 une heure, cette promenade devient ordinairement le rendez-vous des \u00e9trangers et des gens riches. Cette mac\u00e9doine de nations qu\u2019on y rencontre \u00e9gaie quelques heures par jour cet endroit. \u00bb\r\nSi globalement, les relations du Bellevue avec son illustre voisin \u2014 le palais royal \u2014 restent bonnes, l\u2019h\u00f4tel h\u00e9bergeant m\u00eame souvent des invit\u00e9s de marque susceptibles d\u2019une entrevue royale, quelques frictions ont pu appara\u00eetre, notamment \u00e0 cause de la construction de terrasses adjacentes \u00e0 l\u2019\u00e9tablissement, et donnant une vue magnifique sur les jardins du roi, ce qui n\u2019\u00e9tait pas tr\u00e8s au go\u00fbt de L\u00e9opold II\u2026\r\n\r\nHoraire exceptionnel les jours de vacances scolaires et le jours f\u00e9ri\u00e9s 9h30 \u00e0 17h\r\nLe 24\/12 et le 31\/12 9h30 \u00e0 16:00\r\nL'entr\u00e9e au mus\u00e9e BELvue est gratuite tous les mercredis \u00e0 partir de 14 heures et le 1er dimanche du mois","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Musee-BELvue.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Conocido como el museo de B\u00e9lgica y su historia, pero tambi\u00e9n como \"centro para la democracia\", el establecimiento posee una museograf\u00eda completamente redise\u00f1ada desde hace poco. Democracia, prosperidad, solidaridad, pluralismo, migraciones, idiomas, Europa: El museo BELvue te propone descubrir el pa\u00eds a trav\u00e9s de diferentes tem\u00e1ticas. El enfoque es original, ya que cada tem\u00e1tica se explica en primer lugar con la ayuda de testimonios actuales y a continuaci\u00f3n es contextualizada a trav\u00e9s de la historia. M\u00e1s de 200 objetos componen una galer\u00eda para encarnar la memoria material del pa\u00eds. Encontrar\u00e1s, por ejemplo, una litograf\u00eda de Magritte, los vasos de cristal de Val Saint-Lambert, un disfraz del carnaval de Binche, \u00a1Y un bal\u00f3n firmado por los Diablos Rojos!\r\nEste edificio, originalmente utilizado como hotel, se construy\u00f3 en 1776 \u2014 y fue abierto durante el transcurso del a\u00f1o siguiente \u2014 como un centro de car\u00e1cter tur\u00edstico, comercial y muy cosmopolita. El establecimiento recibe esencialmente turistas, en su mayor\u00eda ingleses, pero no cualquier turista: se trata de un hospedaje de lujo, con clientes prestigiosos. De estilo neocl\u00e1sico, como el conjunto de la Place Royale, el edificio favorece la sobriedad y las proporciones armoniosas. La vista interior te ofrecer\u00e1 m\u00e1s detalles del decorado.\r\nEl Parque de Bruselas constituye un centro de atracci\u00f3n para los turistas: esta visita al parque es en efecto una excelente actividad a elegir. \"Entre media hora y una hora, este paseo se convierte generalmente en un punto de reuni\u00f3n para la diversidad, desde extranjeros hasta gente rica. Esta macedonia de nacionalidades que encontramos enriquece el ambiente del lugar\".\r\nSi las relaciones entre Bellevue y su ilustre vecino - el Palacio Real - siguen siendo buenas, el hotel hospeda a menudo a distinguidos invitados de entrevista real. Pueden haber surgido ciertos roces especialmente a causa de la contrucci\u00f3n de terrazas adyacentes al establecimiento, proporcionando una magn\u00edfica vista al Real Jard\u00edn de las Plantas Medicinales, el cual no era del agrado de Leopoldo ll.\r\nV\u00e9ase el folleto sobre la historia del edificio disponible en el lugar.\r\n\r\nLa entrada al museo BELvue es gratuita todos los mi\u00e9rcoles a partir de las 14:00.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Frieten, bier, chocolade\u2026 maar Belgi\u00eb is toch wel meer dan dat, nietwaar? Democratie, welvaart, solidariteit, pluralisme, migratie, taal, Europa: dat zijn de thema\u2019s die het BELvue museum jullie voorstelt om kennis te maken met het land! Elk thema wordt uitgewerkt aan de hand van hedendaagse getuigenissen en vervolgens toegelicht doorheen de geschiedenis. Een eigentijdse en originele manier om een beter inzicht te verwerven in het Belgi\u00eb van vandaag.\r\nNeem zeker ook een kijkje in de galerij: daar staan meer dan 200 voorwerpen opgesteld die het materi\u00eble geheugen van Belgi\u00eb vormen. Je kunt er onder andere de volgende zaken bewonderen: een lithografie van Magritte, een motorfiets, kristallen vazen van Val Saint-Lambert, en een bal met de handtekeningen van de Rode Duivels erop. Een verzameling met een hoog Belgi\u00ebgehalte!\r\n\r\nElke woensdag vanaf 14.00 uur is het BELvue museum gratis toegankelijk.\r\nMaandag open voor groepen en scholen op reservering van 09:30 tot 17:00\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.BELvue-museum.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":1250,"location":{"lat":50.8426107,"lon":4.3606882},"last_updated_at":"2024-09-02T10:57:51+02:00","published_at":"2013-10-19T01:14:10+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/fcbe6a01cbc32bb7bc6270bf985420978692fdc2.png","width":960,"height":960,"ratio":1,"oEmbed_height":960,"oEmbed_width":960,"translations":{"de":{"title":"La Belgique dans la poche","copyright":"BELvue"},"pt":{"title":"La Belgique dans la poche","copyright":"BELvue"},"en":{"title":"La Belgique dans la poche","copyright":"BELvue"},"it":{"title":"La Belgique dans la poche","copyright":"BELvue"},"cn":{"title":"La Belgique dans la poche","copyright":"BELvue"},"fr":{"title":"La Belgique dans la poche","copyright":"BELvue"},"sp":{"title":"La Belgique dans la poche","copyright":"BELvue"},"nl":{"title":"La Belgique dans la poche","copyright":"BELvue"}}}],"dates":[],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":75},{"translations":{"de":{"name":"Gruppe"},"en":{"name":"Group"},"it":{"name":"Gruppi"},"fr":{"name":"Groupe"},"sp":{"name":"Grupos"},"nl":{"name":"Groep"}},"value":85}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":false},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: gesloten"]},"date_start":null,"date_end":null,"is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[5],"translations":{"de":["Kinder 9-12 Jahre"],"pt":[null],"en":["Children 9-12 yr."],"it":["Bambini 9-12 anni"],"cn":[null],"fr":["Enfants 9-12 ans"],"sp":["Ni\u00f1os de 9 a 12 a\u00f1os"],"nl":["Kinderen 9-12 j."]}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":456203,"date_start":"2023-03-16","date_end":"2030-12-31","date_next":"2025-02-02","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-02T01:03:13+01:00","published_at":"2018-09-21T10:42:11+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":176203,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.08888531248615283,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[37,36],"translations":{"de":["Audiovisuelle K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Audiovisual art","Museums and art centers"],"it":["Arti audiovisive","Musei e centri artistici"],"cn":[null,null],"fr":["Arts audiovisuels","Mus\u00e9es et art centers"],"sp":["Artes audiovisuales","Museos y centros de arte"],"nl":["Audiovisuele kunst","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.456203"},"pt":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.456203"},"en":{"name":"With Brel in Brussels - Walking Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FONDATIONBREL&module=ACTIVITYSERIEDETAILS&s=7DAAF48D-4C28-ACFE-8E1E-42E33A52D157&lg=EN","website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.456203"},"it":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.456203"},"cn":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.456203"},"fr":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":"Marchez avec Jacques Brel dans les rues de Bruxelles. A chacun de vos pas, la voix de l'artiste, ses chansons, ses commentaires et les anecdotes d'une quinzaine de t\u00e9moins vous accompagnent dans sa ville natale. \r\n","longdescr":"Des interviews, des t\u00e9moignages et des chansons de Jacques Brel pour cadencer vos pas sur les pav\u00e9s bruxellois et d\u00e9couvrir sa ville natale. Une promenade pour \u00e9couter un r\u00e9cit qui danse entre souvenirs et \u00e9motions au rythme des chansons dans les rues du Bruxelles de Brel. \r\n\r\nCette promenade, con\u00e7ue et comment\u00e9e par Miche et France propose une succession de moments de complicit\u00e9 avec Jacques, avec ceux qui l\u2019ont bien connu et qui l\u2019\u00e9voquent avec le coeur. Plus de 16 voix vous parlent, plus de 22 chansons vous transportent, plus de  37 lieux sont \u00e9voqu\u00e9s. \r\n\r\nAu d\u00e9part de la Fondation Brel, vos pas vous m\u00e8neront de la Grand Place \u00e0 la Monnaie, de la Place Sainte Catherine \u00e0 l\u2019Ancienne Belgique, de tavernes en restaurants, de confidences en r\u00eaves partag\u00e9s.\r\n\r\n\r\n- TRAJET COMPLET - Temps pr\u00e9vu : 2h40\r\n- TRAJET COURT - Temps pr\u00e9vu : 2h\r\n- TRAJET EXPRESS - Temps pr\u00e9vu : 1h\r\n","performers":"Jacques Brel","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FONDATIONBREL&module=ACTIVITYSERIEDETAILS&s=7DAAF48D-4C28-ACFE-8E1E-42E33A52D157&lg=FR","website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.456203"},"sp":{"name":"Avec Brel dans Bruxelles - Promenade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.456203"},"nl":{"name":"Met Brel in Brussel - Wandeling","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FONDATIONBREL&module=ACTIVITYSERIEDETAILS&s=7DAAF48D-4C28-ACFE-8E1E-42E33A52D157&lg=NL","website":"http:\/\/www.fondationbrel.be","email":"info@fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":"+32 2 511 10 20","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.456203"}},"place":{"id":271719,"translations":{"de":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"M\u00f6chten Sie Br\u00fcssel mit den Augen des belgischen Nationalbarden Jacques Brel entdecken?\r\n\r\nDie Jacques Brel gewidmete Stiftung Fondation Brel m\u00f6chte das musikalische, kulturelle und geistige Erbe dieses belgischen Ausnahmek\u00fcnstlers lebendig halten und katalogisiert, digitalisiert und archiviert das Werk und das Leben von Jacques Brel. Nur einen Steinwurf vom Grand-Place entfernt, empf\u00e4ngt die Stiftung interessierte Besucher nun auch mit einer digitalen Dauerausstellung, wo die Besucher in den Abteilungen \u201eBrel Chanteur\u201c (der S\u00e4nger Brel) und \u201eBrel Auteur\u201c (der Autor Brel) die vielf\u00e4ltigen Facetten des Menschen und des K\u00fcnstlers entdecken k\u00f6nnen. \r\n\r\nIn dem eigens eingerichteten Kino \u201eCin\u00e9\u0301 Brel\u201c k\u00f6nnen die Besucher den S\u00e4nger und Schauspieler Jacques Brel in verschiedenen Filmen in Aktion bewundern. 5 Vorf\u00fchrungen pro Tag, darunter der 1966 gedrehte mythische Film \u201eLes Adieux \u00e0 l'Olympia\u201c. \r\nProgramm auf: http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nWeiteres Angebot ist ein Spaziergang auf eigene Faust durch die Heimatstadt des S\u00e4ngers. Ein Audioguide dient als Wegweiser durch das Br\u00fcssel von Jacques Brel. \r\n\r\nKleines Extra: Die Stiftung organisiert regelm\u00e4\u00dfig Treffen mit France Brel, einer der T\u00f6chter des ber\u00fchmten S\u00e4ngers.\r\n\r\nTouristen und treue Fans kommen hier gleicherma\u00dfen auf ihre Kosten. \r\n\r\n* Die Brussels Card umfasst nur die Dauerausstellung des Museums, nicht aber das Kino und den Spaziergang, hierbei handelt es sich um Zusatzangebote. \r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Funda\u00e7\u00e3o Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"\u00c9 f\u00e3 de Jacques Brel e sempre sonhou observar Bruxelas do seu ponto de vista?\r\n\r\nAnimada por um esp\u00edrito de transmiss\u00e3o para as novas gera\u00e7\u00f5es, a Funda\u00e7\u00e3o Brel encarrega-se da recolha, listagem e digitaliza\u00e7\u00e3o dos arquivos relacionados com a obra e a vida de Jacques Brel. Situada a dois passos da Grand Place, ela prop\u00f5e atualmente ao p\u00fablico uma exposi\u00e7\u00e3o digital permanente em que o visitante descobre as m\u00faltiplas facetas do homem e do talento do artista atrav\u00e9s dos espa\u00e7os Brel Cantor e Brel Autor.\r\n\r\nOs visitantes tamb\u00e9m podem ficar a conhecer o cantor e ator Jacques Brel atrav\u00e9s de filmes na sala de cinema, Cin\u00e9 Brel. 5 proje\u00e7\u00f5es por dia, entre os quais os m\u00edticos \"Adieux \u00e0 L'Olympia\" (adeus no Ol\u00edmpia) filmados em 1966.\r\nPrograma\u00e7\u00e3o em: http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nUm passeio individual na cidade natal do cantor tamb\u00e9m ser\u00e1 organizada, com guia \u00e1udio, para os caminhantes ansiosos por se impregnar da cidade de Bruxelas de Jacques Brel.\r\n\r\nUm pequeno extra: a Funda\u00e7\u00e3o organiza regularmente reuni\u00f5es com France Brel, uma das filhas do c\u00e9lebre cantor.\r\n\r\nTurista de passagem ou grande conhecedor, esperamos que todos e todas se sintam bem-vindos\/as na Funda\u00e7\u00e3o Brel.\r\n\r\n* A Brussels Card inclui apenas a exposi\u00e7\u00e3o permanente do museu, mas n\u00e3o inclui o cinema e o passeio, que constituem atividades suplementares.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Brel Foundation","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Brussels","description_web":"Are you a fan of Jacques Brel who has always wanted to see Brussels from his point of view?\r\n\r\nDriven by a spirit of transmission to the new generations, the Brel Foundation gathers, indexes and digitizes archives related to the work and life of Belgian artist Jacques Brel. Located a stone\u2019s throw from the Grand Place, it offers a permanent digital exhibition where visitors can discover the multiple facets of the man\u2019s talent in the Brel Chanteur and Brel Auteur spaces.  \r\n\r\nVisitors can also discover his career of singer and actor in our movie theater Cin\u00e9 Brel. 5 screenings a day, Including the mythical concert \"Les Adieux \u00e0 l'Olympia\" from 1966. \r\nMovie programmation : http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nAlso, a walking tour with audio guide in the native city of the singer is available for anyone who wants to discover Brussels through one of his most iconic figures. \r\n\r\nA little extra bonus: the Brel Foundation regularly organises film clubs in the presence of France Brel, one of the famous singer's daughters (only in French).\r\n\r\nTourist or great connoisseur, everyone Is welcome! \r\n\r\n* The Brussels Card only gives access to the permanent exhibition of the Museum. The movie theater and the audio guided walking tour are additional activities. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondazione Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"Siete fan di Jacques Brel e avete sempre voluto osservare Bruxelles dal suo punto di vista?\r\n\r\nAnimata da uno spirito di tramandamento alle nuove generazioni, la Fondazione Brel raccoglie, cataloga e digitalizza gli archivi relativi all'opera e alla vita di Jacques Brel. Situata a due passi dalla Grand Place, la Fondazione propone oggi al pubblico una mostra digitale permanente che permette ai visitatori di scoprire le molteplici sfaccettature dell'uomo e del talento dell'artista attraverso gli spazi Brel Cantante e Brel Autore.\r\n\r\nI visitatori possono inoltre fare la conoscenza del cantante e attore Jacques Brel attraverso i film del cinema della Fondazione: il Cin\u00e9\u0301 Brel. Cinque proiezioni al giorno tra cui i mitici Addii all'Olympia girati nel 1966.\r\nProgrammazione su: http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nSi organizza anche una passeggiata individuale nella citt\u00e0 natale del cantautore, con un'audioguida, per i visitatori curiosi di immergersi nella Bruxelles di Brel.\r\n\r\nUn piccolo extra: la Fondazione organizza regolarmente incontri con France Brel, una delle figlie del celebre cantante.\r\n\r\nChe siate turisti di passaggio o grandi intenditori poco importa: tutti sono i benvenuti alla Fondazione Brel.\r\n\r\n*La Brussels Card include solo la mostra permanente del museo, ma non il cinema e la passeggiata, che sono attivit\u00e0 supplementari.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"Vous \u00eates fan de Jacques Brel et vous avez toujours souhait\u00e9 observer Bruxelles de son point de vue ?\r\n\r\nAnim\u00e9e par un esprit de transmission vers les nouvelles g\u00e9n\u00e9rations, la Fondation Brel rassemble, r\u00e9pertorie et num\u00e9rise les archives en lien avec l\u2019\u0153uvre et la vie de Jacques Brel. Situ\u00e9e \u00e0 deux pas de la Grand Place, elle propose aujourd\u2019hui au public, une exposition permanente digitale o\u00f9 le visiteur d\u00e9couvre les multiples facettes de l\u2019homme et du talent de l\u2019artiste \u00e0 travers les espaces Brel Chanteur et Brel Auteur. \r\n\r\nLes visiteurs peuvent \u00e9galement apprendre a\u0300 conna\u00eetre le chanteur et l\u2019acteur Jacques Brel a\u0300 travers des films dans sa salle de cin\u00e9ma, le Cin\u00e9\u0301 Brel. 5 projections par jour dont les mythiques Adieux \u00e0 L\u2019Olympia film\u00e9s en 1966. \r\nProgrammation sur : http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nUne ballade individuelle dans la ville natale du chanteur est \u00e9galement organis\u00e9e, avec un audioguide, pour les promeneurs curieux de s\u2019impr\u00e9gner du Bruxelles de Brel. \r\n\r\nPetit plus : La Fondation organise r\u00e9guli\u00e8rement des rencontres avec France Brel, une des filles du c\u00e9l\u00e8bre chanteur.\r\n\r\nTouriste de passage ou grand connaisseur, que chacune et chacun se sente le bienvenu \u00e0 la Fondation Brel. \r\n\r\n* La Brussels Card inclut uniquement l\u2019exposition permanente du mus\u00e9e, mas pas le cin\u00e9ma et la promenade qui sont des activit\u00e9s suppl\u00e9mentaires. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Fundaci\u00f3n Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"Usted es fan de Jacques Brel y siempre quiso conocer Bruselas desde su punto de vista?  \r\n\r\nCon el deseo de transmitir hacia las nuevas generaciones, la Fundaci\u00f3n Brel re\u00fane, registra y digitaliza archivos relacionados con el trabajo y la vida del artista belga Jacques Brel. Ubicado muy cerca de la Grand Place, la fundaci\u00f3n ofrece una exposici\u00f3n digital permanente donde los visitantes pueden descubrir las m\u00faltiples facetas del artista en los espacios Brel Chanteur y Brel Auteur. \r\n\r\nLos visitantes tambi\u00e9n pueden descubrir acerca de su carrera de cantante y actor en nuestra sala de cine, el Cin\u00e9 Brel. 5 proyecciones al d\u00eda, incluso el m\u00edtico concierto \"Les Adieux \u00e0 l'Olympia\" qui dio en Paris en 1966. \r\nProgramaci\u00f3n:   http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nTambi\u00e9n est\u00e1 disponible un paseo individual con audiogu\u00eda en la ciudad nativa del cantante, para todos los que quieran descubrir Bruselas con uno de sus figuras m\u00e1s importantes.  \r\n\r\nExtra : La Fundacion organisa de vez en cuando encuentros con Fran Brel, una de les hijas del famoso cantante (solo en Frances). \r\n\r\nTurista o gran conocedor, \u00a1todos son bienvenidos! \r\n\r\n* La Brussels Card incluye solo la exposici\u00f3n permanente del museo. La sala de cine y el paseo con audiogu\u00eda son actividades a parte. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brel Stichting","address_street_name":"Oud Korenhuis","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Oud Korenhuis, 11","address_line2":"1000 Brussel","description_web":"Ben je een fan van Jacques Brel die graag eens Brussel wilt zien vanuit zijn perspectief? \r\n\r\nDe Brel Sichting wil nieuwe generaties kennis laten maken met de nalatenschap van Jacques Brel. Daarvoor verzamelt, registreert en digitaliseert het de archieven die verband houden met het leven en werk van deze grote Belgische artiest. Op een steenworp verwijderd van de Grote Markt bevindt zich een permanente tentoonstelling waar bezoekers de vele facetten van het talent van deze man kunnen ontdekken in de Brel Chanteur en Brel Auteur ruimtes. \r\n\r\nBezoekers kunnen ook zijn carri\u00e8re van zanger en acteur ontdekken in onze bioscoop Cin\u00e9\r\nBrel. 5 vertoningen per dag, waaronder het mythische concert \"Les Adieux \u00e0 l'Olympia\" in 1966.\r\nMeer informatie : http:\/\/fondationbrel.be\/cine-brel-programmation\/\r\n\r\nOok is er een wandeling met audiogids in de geboortestad van de zanger voor iedereen die Brussel wil ontdekken via een van zijn meest iconische figuren.\r\n\r\nEen extraatje: de Jacques Brel Foundation organiseert regelmatig filmclubs waarop France Brel aanwezig is, een van de dochters van de befaamde zanger (in het Frans).\r\n\r\nToerist of echte kenner, iedereen Is welkom ! \r\n\r\n*De Brussels Card omvat enkel de permanente tentoonstelling van het museum. De cinema en de wandeling zijn bijkomende activiteiten.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[17],"translations":{"de":["Saint-Jacques"],"pt":[null],"en":["Saint-Jacques"],"it":["Saint-Jacques"],"cn":[null],"fr":["Saint-Jacques"],"sp":["Saint-Jacques"],"nl":["Sint-Jacob"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":31719,"location":{"lat":50.84424659,"lon":4.35199771},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2018-08-03T13:26:29+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":271719,"translations":{"de":{"name":"Fondation Jacques Brel","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"11","address_street_box":null,"email":"accueil@fondationbrel.be","website":"http:\/\/www.fondationbrel.be","phone_contact":"+32 2 511 10 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 11","address_line2":"1000 Bruxelles","description_web":"M\u00f6chten Sie Br\u00fcssel mit den Augen des belgischen Nationalbarden Jacques Brel entdecken?\r\n\r\nDie Jacques Brel gewidmete Stiftung Fondation Brel m\u00f6chte das musikalische, kulturelle und geistige Erbe dieses belgischen Ausnahmek\u00fcnstlers lebendig halt