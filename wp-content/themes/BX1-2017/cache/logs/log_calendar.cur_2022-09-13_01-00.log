assereaux d\u2019Europe. C\u2019est aussi un podcast cont\u00e9 cr\u00e9\u00e9 pendant le confinement sur le th\u00e8me des oiseaux.\r\n\r\nINFOS PRATIQUES : \r\nD\u00e9but : 15h - dur\u00e9e 1h30\r\nRDV : \u00e0 l'entr\u00e9e de la for\u00eat de Soignes, au bout de la rue du Rouge-Gorge, 1170 Watermael-Boitsfort\r\nR\u00e9servations indispensables : https:\/\/www.conteenbalade.be\/programme\/titriglidi\/\r\nAccessible PMR accompagn\u00e9s\r\nPrix libre (sugg\u00e9r\u00e9 : 7\u20ac)\r\nA partir de 10 ans","performers":"Amandine Orban de Xivry et Julien Staudt","boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":null,"phone_booking":"+32 497 78 20 75","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540743"},"nl":{"name":"Titriglidi \/ balade cont\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540743"},"en":{"name":"Titriglidi \/ balade cont\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540743"},"de":{"name":"Titriglidi \/ balade cont\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540743"},"it":{"name":"Titriglidi \/ balade cont\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540743"},"sp":{"name":"Titriglidi \/ balade cont\u00e9e","shortdescr":null,"longdescr":null,"perform