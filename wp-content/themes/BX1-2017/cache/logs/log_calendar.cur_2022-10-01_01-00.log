link":null,"publication_state":"public","last_updated_at":"2022-09-30T02:05:33+02:00","published_at":"2022-08-30T09:59:44+02:00","backoffice_id":260653,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.38157141418444},{"id":542024,"date_start":"2022-09-17","date_end":"2022-10-08","date_next":"2022-09-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Art Cin\u00e9tique \"Le Langage des Yeux\"","shortdescr":"Les derni\u00e8res \u0153uvres du maitre japonais du Op Art, Yoshiyuki Miura, seront pr\u00e9sentes \u00e0 c\u00f4t\u00e9 de Sascha Nordmeyer, grand artiste franco-allemand, pour un duo show 100% Cyn\u00e9tique.\r\n\u00ab Le langage des yeux \u00bb, vernissage samedi 17 septembre \u00e0 partir de 18h (RSVP hello@streamart.net)","longdescr":"Ce dialogue n\u2019a nulle pr\u00e9tention \u00e0 marquer d\u2019une pierre l\u2019histoire du cin\u00e9tisme\r\nmaintes fois racont\u00e9e. Tout au plus a-t-elle le m\u00e9rite d\u2019une simple initiation \u00e0 un\r\nlangage optique.\r\nNous le savons bien, notre perception des couleurs est tr\u00e8s personnelle. Qu'en est-\r\nil des formes, de la lumi\u00e8re, des ombres ? L\u2019illusion qui peut en ressortir est bien\r\nr\u00e9elle. Un seul mouvement oculaire modifie l\u2019aspect ; un seul pas de c\u00f4t\u00e9 et\r\nl'\u0153uvre devient plurielle. Une dimension ludique - voire magique - s\u2019installe alors\r\net \u00e9branle nos convictions.\r\nSi la grande \u00e9poque des ann\u00e9es 60 - 70 est retenue par les historiens, avec des\r\nGrands Ma\u00eetres tels que Soto, Vasarely, Cruz Diez, qu\u2019en est-il de l\u2019\u00e9quipage\r\nDuchamp et Man Ray et leur disque \u201cAn\u00e9mic\u201d ? Nous sommes alors en 1925...\r\nInteractive et joueuse, chacune de ces \u0153uvres est un d\u00e9dale sans fin, infatigables\r\nvectrices de contre-pieds, de ricochets, d\u2019interrogations. Enjoy!","performers":"Yoshiyuki Miura (jp)\r\nSascha Nordmeyer (fr-de)","boxoffice_url":null,"website":"http:\/\/www.streamart.net","email":"hello@streamart.net","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542024"},"nl":{"name":"Art Cin\u00e9tique \"Le Langage des Yeux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542024"},"en":{"name":"Art Cin\u00e9tique \"Le Langage des Yeux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542024"},"de":{"name":"Exposition : Art Cin\u00e9tique \"Le Language des Yeux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542024"},"it":{"name":"Exposition : Art Cin\u00e9tique \"Le Language des Yeux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542024"},"sp":{"name":"Exposition : Art Cin\u00e9tique \"Le Language des Yeu