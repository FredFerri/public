Seniors","Enseignants"],"nl":["Jongeren 15-18 j.","LGTBQIA","Senioren","Leerkrachten"],"en":["Youth 15-18  yr.","LGTBQIA","Seniors","Teachers"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-01T01:35:26+02:00","published_at":"2022-02-24T09:45:28+01:00","backoffice_id":248307,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.28011059397367},{"id":530582,"date_start":"2022-04-22","date_end":"2022-08-28","date_next":"2022-06-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s","shortdescr":null,"longdescr":"\u00ab Dans l\u2019\u0153il du cyclone \u00bb \/\/ Mais c\u2019est quoi ce concept ?\r\nH\u00e9 bien en fait, c\u2019est tr\u00e8s simple. Vous prenez une \u00e9quipe d\u2019impro. Cinq personnes. Ou six, enfin on verra. Vous en mettez un au milieu, il a peur, il flippe sa m\u00e8re, peut-\u00eatre m\u00eame qu\u2019il commence une crise d\u2019urticaire si c\u2019est un sensible. Les autres sont autour, et paf paf, ils font comme \u00e7a, et apr\u00e8s ils encha\u00eenent avec un tour de passe-passe, ils sautent, il y a une corde qui descend du plafond et des aigles qui arrivent sur la sc\u00e8ne. Et l\u00e0, c\u2019est le moment crucial : on allume la m\u00e8che, et soudain, SCHLAAAH ! Ah ben oui, c\u2019est tout \u00e7a. Ou ce sera peut-\u00eatre tout autre chose, parce que bon, c'est de l'impro.\r\n--------------\r\n\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 20h00!)\r\nR\u00c9SERVATIONS (obligatoires)","performers":"L'\u00e9quipe des 6Cl\u00f4nes","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530582.html"},"nl":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530582.html"},"en":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530582.html"},"de":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530582.html"},"it":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530582.html"},"sp":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/530582.html"},"pt":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s - Spectacle d'improvisation","shortdescr":null,"lo