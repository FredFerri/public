t_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"],"it":["Cabaret"],"sp":["Caf\u00e9 teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"IMPR'OPEN SPACE - Spectacle d'improvisation","shortdescr":null,"longdescr":"* IMPR'OPEN SPACE *\r\n\r\n\r\nBienvenus dans la jungle du secteur tertiaire ! \r\n\r\n\r\nLes cinq com\u00e9diens et com\u00e9diennes que vous avez pu voir dans Imprh\u00f4pital, Impromissariat et Improfs reviennent dans un nouvel univers tout en post-it, slides et photocopieuses. \r\n\r\n\r\nPlongez dans les r\u00e9unions \u00ab produits \u00bb, venez \u00e0 la rencontre de votre N+1, d\u00e9couvrez les terribles secrets du stagiaire ou r\u00e9v\u00e9lez qui se cache derri\u00e8re le sous-traitant charg\u00e9 du nettoyage de nuit. \r\n\r\n\r\nTenue \u00abcasual Friday \u00bb exig\u00e9e pour ces histoires toujours aussi hors cadre et plus savoureuses qu\u2019un buffet de cantine d\u2019entreprise. \r\n\r\n\r\nVenez sans tarder signer votre CDD pour un spectacle \u00ab orient\u00e9 r\u00e9sultat \u00bb, sans pression manag\u00e9riale ni p\u00e9riode d\u2019essai.\r\n\r\n\r\nAvec : \r\nMarc Sautelet.                Am\u00e9lie Verrydt\r\nValentin Dellieu              Marie Vancutsem\r\nThomas Willaime          \r\n\r\n-------\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (Vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\nSur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\nSur place : 15\u20ac\/personne\r\n--> Pensez \u00e0 r\u00e9server","performers":"Marc Sautelet.                Am\u00e9lie Verrydt\r\nValentin Dellieu              Marie Vancutsem\r\nThomas Willaime","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542916"},"nl":{"name":"IMPR'OPEN SPACE - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542916"},"en":{"name":"IMPR'OPEN SPACE - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542916"},"de":{"name":"IMPR'OPEN SPACE - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542916"},"it":{"name":"IMPR'OPEN SPACE - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\