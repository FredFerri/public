it rendue hier ou l'est aujourd'hui ?!? Au nom de Dieu, des Princes, de l\u2019\u00c9tat, des victimes, mettons les bourreaux sur la sellette, appelons avocats et juges \u00e0 la barre, et \u00e9valuons les sentences : du gibet au bannissement, des travaux forc\u00e9s au bracelet \u00e9lectronique. Ces \u00e9volutions refl\u00e8tent l\u2019esprit du temps et la sensibilit\u00e9 de l\u2019opinion relay\u00e9e par les m\u00e9dias, ses complices. Entre frissons et r\u00e9flexion, une affaire \u00e0 suivre en toute innocence ...\n\nEn collaboration avec l'asbl 91e Parall\u00e8le","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010926"},"sp":{"name":"Crimes et ch\u00e2timents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010926"},"nl":{"name":"Crimes et ch\u00e2timents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010926"}},"place":{"last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2013-10-19T01:13:21+02:00","id":1491,"translations":{"de":{"name":"Bruxelles Bavard ","address_street_name":"Rue des Thuyas","address_street_number":"12","address_street_box":null,"email":"info@bruxellesbavard.be","website":"http:\/\/www.bruxellesbavard.be","phone_contact":"+32 2 673 18 35","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boits