-20T13:52:02+01:00","published_at":"2025-02-20T11:54:54+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":318671,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[7,4],"translations":{"de":["Pop, Rock","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Pop, Rock","Pop, rock, jazz\u2026"],"it":["Pop, Rock","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Pop, Rock","Pop, rock, jazz\u2026"],"sp":["Pop, rock","Pop, rock, jazz\u2026"],"nl":["Pop, Rock","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"F.L.O.Y.D  Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/viage.be\/fr","email":"info@viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006908"},"pt":{"name":"F.L.O.Y.D  Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/viage.be\/fr","email":"info@viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006908"},"en":{"name":"F.L.O.Y.D  Experience","shortdescr":"Immerse yourself in the legendary world of Pink Floyd with F.L.O.Y.D! This passionate band brings their greatest classics to life with stunning precision. With outstanding musical performances and immersive projections, experience a unique sensory journey that will transport you to the heart of Pink Floyd\u2019s iconic concerts. An unforgettable show not to be missed!","longdescr":"F.L.O.Y.D, the band created to recreate Pink Floyd's iconic shows, invites you to relive the intensity and magic of their legendary performances. \n\nWith 10 talented musicians on stage, driven by their shared passion for the legendary band, every note is played with absolute precision. Accompanied by immersive projections, this unique visual and audio experience recreates the spellbinding world of Pink Floyd. \n\nClose your eyes and let yourself be transported: you'll feel like you're at a real Pink Floyd concert. The spellbinding atmosphere and the explosive energy will no doubt give you goosebumps. Get ready for an unforgettable audio visual journey. \n\nSee you at The Viage, Brussels, on 28 March 2025, for an exceptional evening! ","performers":null,"boxoffice_url":null,"website":"https:\/\/viage.be\/en","email":"info@viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006908"},"it":{"name":"F.L.O.Y.D  Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/viage.be\/fr","email":"info@viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006908"},"cn":{"name":"F.L.O.Y.D  Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/viage.be\/fr","email":"info@viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006908"},"fr":{"name":"F.L.O.Y.D  Experience","shortdescr":"Plongez dans l\u2019univers l\u00e9gendaire de Pink Floyd avec F.L.O.Y.D experience ! Ce groupe passionn\u00e9 r\u00e9interpr\u00e8te leurs plus grands classiques avec une fid\u00e9lit\u00e9 \u00e9poustouflante. Entre performances musicales d\u2019exception et projections immersives, vivez une exp\u00e9rience sensorielle unique qui vous transportera au c\u0153ur des concerts mythiques de Pink Floyd. Un show inoubliable \u00e0 ne pas manquer !","longdescr":"F.L.O.Y.D, le groupe qui redonne vie aux spectacles embl\u00e9matiques de Pink Floyd, vous fait revivre toute l\u2019intensit\u00e9 et la magie de leurs performances l\u00e9gendaires. \n\nAvec 10 musiciens talentueux sur sc\u00e8ne, habit\u00e9s par leur passion pour ce groupe mythique, chaque note est interpr\u00e9t\u00e9e avec une pr\u00e9cision absolue. Accompagn\u00e9e de projections immersives, cette exp\u00e9rience visuelle et sonore unique recr\u00e9e l'univers envo\u00fbtant de Pink Floyd. \n\nFermez les yeux et laissez-vous transporter : vous aurez l\u2019impression d\u2019assister \u00e0 un v\u00e9ritable concert de Pink Floyd. Ambiance envo\u00fbtante, \u00e9nergie explosive et \u00e9motions garanties, pr\u00e9parez-vous \u00e0 un voyage sonore et visuel inoubliable. \n\nRendez-vous \u00e0 The Viage, Bruxelles, le 28 mars 2025, pour une soir\u00e9e exceptionnelle ! ","performers":null,"boxoffice_url":null,"website":"https:\/\/viage.be\/fr","email":"info@viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006908"},"sp":{"name":"F.L.O.Y.D  Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/viage.be\/fr","email":"info@viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006908"},"nl":{"name":"F.L.O.Y.D  Experience","shortdescr":"Dompel jezelf onder in de legendarische wereld van Pink Floyd met F.L.O.Y.D! Deze gepassioneerde band brengt hun grootste klassiekers tot leven met verbluffende precisie. Met uitzonderlijke muzikale prestaties en meeslepende projecties beleef je een unieke zintuiglijke ervaring die je meeneemt naar de mythische concerten van Pink Floyd. Een onvergetelijke show die je niet mag missen!","longdescr":"F.L.O.Y.D nodigt je uit om de intensiteit en de magie van de legendarische Pink Floyd concerten te herbeleven. \n\nMet 10 getalenteerde muzikanten op het podium, gedreven door een gedeelde passie voor de legendarische band, wordt elke noot met absolute precisie gespeeld. Het concert wordt extra bijzonder door de indrukwekkende \u2018immersieve\u2019 projecties. Het wordt een unieke audiovisuele ervaring in de betoverende wereld van Pink Floyd. \n\nSluit je ogen en laat je meevoeren: je waant je op een echt Pink Floyd concert met een betoverende sfeer, explosieve energie en gegarandeerd kippenvel! Bereid je voor op een onvergetelijke audiovisuele reis. \n\nAfspraak in The Viage, Brussel, op 28 maart 2025, voor een uitzonderlijke avond! ","performers":null,"boxoffice_url":null,"website":"https:\/\/viage.be\/nl","email":"info@viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006908"}},"place":{"id":271605,"translations":{"de":{"name":"Grand Casino Brussels VIAGE","address_street_name":"Boulevard Anspach ","address_street_number":"30","address_street_box":null,"email":"info@viage.be","website":"http:\/\/www.viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Anspach , 30","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Grand Casino Brussels VIAGE","address_street_name":"Boulevard Anspach ","address_street_number":"30","address_street_box":null,"email":"info@viage.be","website":"http:\/\/www.viage.be","phone_contact":"+32 2 300 01 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Anspach , 30","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_u