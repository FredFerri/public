oors":null,"start":"12:00:00","end":"20:00:00"},{"day":"2022-11-17","doors":null,"start":"12:00:00","end":"20:00:00"},{"day":"2022-11-18","doors":null,"start":"12:00:00","end":"20:00:00"},{"day":"2022-11-19","doors":null,"start":"12:00:00","end":"20:00:00"},{"day":"2022-11-20","doors":null,"start":"12:00:00","end":"20:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"12:00:00","end":"20:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"12:00:00","end":"20:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"12:00:00","end":"20:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"12:00:00","end":"20:00:00"}]}},"translations":{"fr":["lundi, mardi et mercredi: ferm\u00e9","jeudi, vendredi, samedi et dimanche: de 12:00 \u00e0 20:00"],"nl":["maandag, dinsdag en woensdag: gesloten","donderdag, vrijdag, zaterdag en zondag: van 12:00 tot 20:00"],"en":["monday, tuesday and wednesday: closed","thursday, friday, saturday and sunday: from 12:00 to 20:00"]},"date_start":"2022-09-23","date_end":"2022-11-20","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-14T01:36:49+01:00","published_at":"2022-08-18T15:47:30+02:00","backoffice_id":259959,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25687154396614},{"id":537125,"date_start":"2022-07-08","date_end":"2023-03-05","date_next":"2022-11-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,45],"translations":{"fr":["Mus\u00e9es et art centers","Mode"],"nl":["Musea en kunstcentra","Mode"],"en":["Museums and art centers","Fashion"],"de":["Museen & Kunstzentren","Mode"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":"La mode pour enfants se porte mieux que jamais. Plus inclusive, plus \u00e9cologique, privil\u00e9giant le fait-main, chaque ann\u00e9e de nouveaux labels voient le jour. Mais habiller un enfant n\u2019est pas toujours facile ! \u00c0 travers un parcours \u00e0 la fois th\u00e9matique et chronologique, cette nouvelle exposition pose un regard sur la mode actuelle \u00e0 la lumi\u00e8re des tenues enfantines port\u00e9es depuis 1820.","longdescr":"La mode pour enfants se porte mieux que jamais. Plus inclusive, plus \u00e9cologique, privil\u00e9giant le fait-main, chaque ann\u00e9e de nouveaux labels voient le jour. Mais habiller un enfant n\u2019est pas toujours facile ! La mode reste avant tout un ph\u00e9nom\u00e8ne social et les enfants aussi attachent de l\u2019importance \u00e0 ce qu\u2019ils portent.\r\n \r\n\u00c0 travers un parcours \u00e0 la fois th\u00e9matique et chronologique, cette nouvelle exposition pose un regard sur la mode actuelle \u00e0 la lumi\u00e8re des tenues enfantines port\u00e9es depuis 1820.\r\n\r\nEn puisant dans ses collections r\u00e9cemment enrichies de pi\u00e8ces belges mais aussi gr\u00e2ce \u00e0 plusieurs pr\u00eats prestigieux, le mus\u00e9e questionne entre autres la construction des genres, le d\u00e9veloppement de la mode mixte ou unisexe, le mim\u00e9tisme avec la mode adulte mais \u00e9galement l\u2019int\u00e9r\u00eat grandissant de l\u2019industrie du luxe pour les kids. Plus qu\u2019une exposition de mode, Kidorama raconte la place de l\u2019enfant et le d\u00e9veloppement de sa personnalit\u00e9 au sein de notre soci\u00e9t\u00e9.\r\n\r\nUne exposition \u00e0 voir avec des yeux d\u2019enfants !\r\n\r\nL\u2019exposition s\u2019adresse bien entendu aux adultes mais \u00e9galement aux enfants, d\u00e9couvrez toutes les activit\u00e9s du mus\u00e9e sur notre site (parcours ludique, carnet de coloriage, atelier paper dolls ...)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 213 44 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537125"},"nl":{"name":"Kidorama, 200 jaar kindermode","shortdescr":"Kindermode doet het beter dan ooit. Meer en meer inclusief, ecologisch, met handgemaakte producten en elk jaar nieuwe merken. Maar kinderen kleden is niet altijd gemakkelijk!  Deze nieuwe tentoonstelling verkent thematisch en chronologisch de invloed van de kinderkleding sinds 1820 op onze hedendaagse kindermode.","longdescr":"Kindermode doet het beter dan ooit. Meer en meer inclusief, ecologisch, met handgemaakte producten en elk jaar nieuwe merken. Maar kinderen kleden is niet altijd gemakkelijk! Mode blijft een sociaal verschijnsel en ook kinderen hechten belang aan wat ze dragen.\r\n\r\nDeze nieuwe tentoonstelling verkent thematisch en chronologisch de invloed van de kinderkleding sinds 1820 op onze hedendaagse kindermode.\r\n\r\nKidoroma toont de evolutie van genderconstructies, de ontwikkeling van genderneutrale mode, de invloed van mode voor volwassenen en de groeiende belangstelling van de luxemerken voor kinderen. Het museum put daarvoor uit zijn rijke collecties, onlangs aangevuld met Belgische stukken, maar ook uit verschillende prestigieuze bruiklenen. Kidorama is meer dan een modetentoonstelling. Ze vertelt het verhaal van de plaats van het kind en de ontwikkeling van zijn persoonlijkheid binnen onze samenleving.\r\n\r\nEen tentoonstelling die het kind in ons weer tot leven brengt!\r\n\r\nDe tentoonstelling richt zich uiteraard zowel tot volwassenen als tot kinderen. Ontdek alle activiteiten van het museum  op onze website (speelse rondleiding, kleurboekje, workshops paper dolls ...)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/nl\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537125"},"en":{"name":"Kidorama, 200 year of children's fashion","shortdescr":"Children\u2019s fashion is healthier than ever. More inclusive, more environmentally friendly, with an emphasis on handmade items: new labels appear each year. But dressing a child is not always easy!  Through a trajectory that is both thematic and chronological, this new exhibition casts its eye on current fashion in the light of children\u2019s wear since 1820.","longdescr":"Children\u2019s fashion is healthier than ever. More inclusive, more environmentally friendly, with an emphasis on handmade items: new labels appear each year. But dressing a child is not always easy! Fashion is first and foremost a social phenomenon and children also care about what they wear.\r\n\r\nThrough a trajectory that is both thematic and chronological, this new exhibition casts its eye on current fashion in the light of children\u2019s wear since 1820.\r\n\r\nBy delving into its collections, recently enriched by Belgian items as well as several prestigious loans, the museum raises questions about issues such as construction of gender, the development of mixed or unisex fashion, imitation of adult fashion as well as the growing interest in the luxury industry for kids. More than just a fashion exhibition, Kidorama tells the story of the place of the child and the development of his\/her personality within our society.\r\n\r\nAn exhibition to enjoy through children\u2019s eyes!\r\n\r\nThe exhibition is of course aimed at adults but also at children, discover all the activities of the museum on our website (interactive modules, coloring book ...)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/en\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537125"},"de":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537125"},"it":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537125"},"sp":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537125"},"pt":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537125"},"cn":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537125"}},"place":{"id":1515,"translations":{"fr":{"name":"Mus\u00e9e Mode & Dentelle","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Le Mus\u00e9e Mode & Dentelle pr\u00e9sente ses collections \u00e0 travers de grandes expositions annuelles. Elles abordent tant la cr\u00e9ation que la production et l\u2019usage social du v\u00eatement.\r\nCes expositions vous transportent dans des univers aussi vari\u00e9s que captivants. De l\u2019in\u00e9dit avec Masculinities ou Back Side, de l\u2019historique avec le glamour des ann\u00e9es 30 ou les audacieuses seventies ou encore des expositions consacr\u00e9es \u00e0 des cr\u00e9ateurs de chez nous comme Carine Gilson ou Jean-Paul Lespagnard.\r\n\r\nEn parall\u00e8le \u00e0 ces grandes expositions, le mus\u00e9e propose \u00e9galement :\r\n\r\n- La Fashion Room, cet espace in\u00e9dit en Belgique vous permet de comprendre comment un mus\u00e9e enrichit ses collections. D\u00e9couvrez y des pi\u00e8ces exceptionnelles, hors vitrine, afin d\u2019\u00eatre au plus proche de celles-ci.\r\n\r\n- La Chambre des Dentelles pr\u00e9sente de remarquables pi\u00e8ces illustrant la finesse, la qualit\u00e9 et la beaut\u00e9 de la dentelle de Bruxelles. Explorez l\u2019histoire de cette \u00e9toffe pris\u00e9e des \u00e9lites d\u00e8s le 17e si\u00e8cle et aujourd\u2019hui disparue.\r\n\r\nAbrit\u00e9 au c\u0153ur de Bruxelles, dans un ensemble de maisons historiques, le Mus\u00e9e Mode & Dentelle conserve quelque 15.000 pi\u00e8ces datant du 16e si\u00e8cle \u00e0 nos jours. Il poss\u00e8de les plus importantes collections au monde en ce qui concerne la cr\u00e9ation et la confection bruxelloises, qu\u2019il vise \u00e0 replacer dans un contexte belge et international.\r\nSes collections sont les t\u00e9moins de l\u2019\u00e9volution de la mode mais aussi d\u2019une \u00e9poque, de notre culture, de notre soci\u00e9t\u00e9.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Mode en Kant Museum","address_street_name":"Violetstraat","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussel","address_line1":"Violetstraat, 12","address_line2":"1000 Brussel","description_web":"Het Mode & Kant Museum presenteert zijn collecties tijdens grote jaarlijkse tentoonstellingen. Daarin komen het ontwerp, de productie en de sociale dimensie van kleding aan bod.\r\nDeze tentoonstellingen nemen je telkens mee naar een wereld die even gevarieerd als boeiend is. Je maakt er kennis met het ongeziene in Masculinities en Back Side, of met de historische glamour uit de jaren dertig. Ook de gedurfde jaren zeventig en tentoonstellingen gewijd aan onze eigen ontwerpers, zoals Carine Gilson of Jean-Paul Lespagnard, stonden ooit op het programma.\r\n\r\nNaast deze grote tentoonstellingen laat het museum je ook graag kennismaken met:\r\n- De Fashion Room, een baanbrekend concept in Belgi\u00eb, dat je toont hoe een museum zijn collecties verrijkt. We hebben enkele uitzonderlijke stukken opgesteld buiten de vitrine, zodat je ze in detail kunt bekijken.\r\n\r\n- De Kantkamer, waar opmerkelijke stukken opgesteld staan die de verfijning, de kwaliteit en de schoonheid van het Brusselse kantwerk illustreren. Kom de geschiedenis van deze stof ontdekken, die vanaf de 17e eeuw erg door de elite werd gewaardeerd, maar die nu verdwenen is.\r\nIn hartje  Brussel, in een groep historische huizen, bewaart het Mode & Kant Museum ongeveer 15.000 voorwerpen die dateren van de 16e eeuw tot vandaag. Het bezit de belangrijkste collecties ter wereld rond de Brusselse ontwerpen en kleding, die het in een Belgische en internationale context wil plaatsen.\r\nDe collecties leggen getuigenis af over de evolutie van de mode, maar ook over een tijdperk, onze cultuur en onze maatschappij.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of Fashion & Lace","address_street_name":"rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussels","address_line1":"rue de la Violette, 12","address_line2":"1000 Brussels","description_web":"The Fashion & Lace Museum displays its collections by means of major annual exhibitions. These address both the design and the production and social use of the garments.\r\nThe exhibitions transport you to diverse and captivating worlds. From items never before exhibited, such as in Masculinities or Back Side, through historical themes, such as the glamour of the 1930s or the bold \u201870s, to exhibitions devoted to Belgian designers such as Carine Gilson and Jean-Paul Lespagnard.\r\n\r\nParallel to these major exhibitions, the museum also offers:\r\n\r\n- The Fashion Room, an unparalleled space in Belgium, provides you with the opportunity to understand how a museum builds its collections. Discover exceptional items, not hidden behind glass, in order to see them up close.\r\n\r\n- The Lace Room displays remarkable pieces that illustrate the finesse, high quality and beauty of Brussels lace. Explore the history of this type of fabric, so valued by the elites in the 17th century yet no longer in vogue today.\r\n\r\nHoused in a series of historic houses at the heart of Brussels, the Fashion & Lace Museum holds some 15,000 pieces from the 16th century to the present. The Museum has the most important collections in the world when it comes to Brussels design and production, which it seeks to position in a Belgian and international context.\r\nIts collections attest to the changes in fashion as well as to a specific era of our culture and our society.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Mode et Dentelle - Mode- und Spitzenmuseum (Museen der Stadt Br\u00fcssel)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Das im Jahr 1977 er\u00f6ffnete Mode- und Spitzenmuseum (Mus\u00e9e Mode et Dentelle) hat in Br\u00fcssel eine echte Daseinsberechtigung, denn die Geschichte der Stadt, ja des Landes ist im wahrsten Sinne des Wortes eng mit der Textilkunst verwoben.\r\n\r\nBr\u00fcssel weist ein reiches Erbe auf, was feine Stoffe und Textilwaren angeht. Die Tradition der Textilindustrie, die bis ins 12. Jahrhundert zur\u00fcckreicht und sich bis heute im Bereich Modedesign und Textilhandel zeigt, ist fest in der Br\u00fcsseler Kultur verankert.\r\n\r\nEinen faszinierenden Einblick in diesen Bereich geben die reichen Sammlungen des Mode- und Spitzenmuseums mit alten, aber auch modernen Spitzengeweben, Stickereien, Kost\u00fcmen und extravaganten Accessoires, die im Rahmen regelm\u00e4\u00dfig wechselnder Ausstellungen gezeigt werden.\r\n\r\nParallel zu den gro\u00dfen thematischen Ausstellungen bietet das Mode- und Spitzenmuseum der zeitgen\u00f6ssischen Textilkreation eine besondere Plattform: Seit 2004 empf\u00e4ngt das Museum wechselnde Ausstellungen, die sowohl die Arbeiten von Studierenden im Bereich Textilkunst als auch die Werke bereits etablierter Textilk\u00fcnstler zeigen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo del Traje y Encaje (Museos de la Ciudad de Bruselas)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"El Museo del Traje y el Encaje destaca por su perspectiva din\u00e1mica e innovadora centrada en la moda contempor\u00e1nea. Ideal para ver prendas excepcionales de moda belga y bruselense en exposiciones temporales, como la de Jean-Paul Lespagnard. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_