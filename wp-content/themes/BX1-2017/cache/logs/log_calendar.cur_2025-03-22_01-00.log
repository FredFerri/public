e est organis\u00e9e dans le cadre du BANAD 2025.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005936"},"sp":{"name":"Le cimeti\u00e8re d'Ixelles, so famous, so Art Deco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005936"},"nl":{"name":"Le cimeti\u00e8re d'Ixelles, so famous, so Art Deco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005936"}},"place":{"id":245890,"translations":{"de":{"name":"Cimeti\u00e8re d'Ixelles","address_street_name":"Square de Boondael","address_street_number":"478","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Square de Boondael, 478","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Cimeti\u00e8re d'Ixelles","address_street_name":"Square de Boondael","address_street_number":"478","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Square de Boondael, 478","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"v