],"it":["monday: closed","tuesday, wednesday, thursday and friday: from 09:30 to 17:00","saturday and sunday: from 10:00 to 17:00"],"sp":["monday: closed","tuesday, wednesday, thursday and friday: from 09:30 to 17:00","saturday and sunday: from 10:00 to 17:00"],"pt":["monday: closed","tuesday, wednesday, thursday and friday: from 09:30 to 17:00","saturday and sunday: from 10:00 to 17:00"],"cn":["monday: closed","tuesday, wednesday, thursday and friday: from 09:30 to 17:00","saturday and sunday: from 10:00 to 17:00"]},"date_start":"2023-02-18","date_end":"2023-03-05","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Bambini"},"sp":{"name":"Ni\u00f1os"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":0},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Anziani"},"sp":{"name":"Mayores"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":8}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"],"de":["Familie"],"it":["Famiglie"],"sp":["Familias"],"pt":[null],"cn":[null]}},"tags":["kids"],"accessibilities":{"list":[255,259,261,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Assistenzhund","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":["Accessibile","Cane guida","Parcheggio accessibile","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado","Perros gu\u00eda","Estacionamiento habilitado","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null,null,null],"cn":[null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-11T06:07:03+01:00","published_at":"2023-02-08T15:57:29+01:00","backoffice_id":271267,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.5},{"id":551440,"date_start":"2023-02-18","date_end":"2023-03-05","date_next":"2023-02-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["nl","fr","en","de"],"subtitles":[]},"translations":{"fr":{"name":"Cong\u00e9s de d\u00e9tente","shortdescr":"Pas encore de projets pour les cong\u00e9s de d\u00e9tente ? Venez alors au mus\u00e9e BELvue o\u00f9 une foule d\u2019activit\u00e9s vous attendent !","longdescr":"Visitez notre exposition permanente avec nos diff\u00e9rents jeux-parcours pour les enfants de 3 \u00e0 12 ans :\r\n\r\n- Mimi & Momo (3 \u00e0 5 ans) \r\n- La\/\u200bLe Ministre, c\u2019est moi ! (6 \u00e0 8 ans)\r\n- Le Sac Ludique Marmaille&Co (pour les familles avec enfants de 6 \u00e0 12 ans)\r\n- En route avec Zeno (9 \u00e0 12 ans) : \u00e9galement disponible en LSFB (langue des signes francophone de Belgique)\r\n\r\nPas encore convaincu\u00b7e ? Venez \u00e0 notre Family Day le dimanche 26\/02 o\u00f9 vos enfants auront la chance de se transformer en v\u00e9ritables super-h\u00e9ros et super-h\u00e9ro\u00efnes ! Ils auront la possibilit\u00e9 de construire une ville, de fabriquer leur propre cape et d\u2019aider les h\u00e9ros et h\u00e9ro\u00efnes belges dans leurs aventures ! Venez passer donc une journ\u00e9e super-tastique avec toute la famille !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551440"},"nl":{"name":"Krokusvakantie","shortdescr":"Nog geen plannen voor de krokusvakantie? Kom dan naar het BELvue museum waar tal van activiteiten op u staan te wachten!","longdescr":"Bezoek onze permanente tentoonstelling met onze verschillende spelparcours voor kinderen van 3 tot 12 jaar:\r\n\r\n- Mimi & Momo (van 3 tot 5 jaar)\r\n- Ik ben de minister! (van 6 tot 8 jaar)\r\n- Speelzak Marmaille&Co (gezinnen met kinderen van 6 tot 12 jaar)\r\n- Op weg met Zeno (van 9 tot 12 jaar)\r\n\r\nTijdens de Krokusvakantie besteden we ook extra aandacht aan families met kinderen die een (fysieke, mentale of sociale) beperking hebben onder het thema Buitengewoon Krokuskriebels. Zo is het spelparcours \u200b\u2018Op weg met Zeno\u2019 ook beschikbaar in VGT (Vlaamse gebarentaal). Leden van de Gezinsbond genieten ook van een mooie korting!\r\n\r\nNog niet overtuigd? Kom naar onze Family Day op zondag 26\/02 waar uw kinderen zullen omgetoverd worden tot echte superhelden en superheldinnen! Ze krijgen de kans om een stad te bouwen, een eigen cape te maken en Belgische helden bij te staan in hun avonturen! Beleef zo een supertastische dag met het hele gezin!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551440"},"en":{"name":"Carnival holidays","shortdescr":"No plans for the carnival holidays? Then come to the BELvue museum where lots of activities are waiting for you!","longdescr":"Visit our permanent exhibition with our various game tours for children aged 3 to 12:\r\n\r\n- Mimi & Momo (3 to 5 years old) \r\n- I\u2019m the minister! (6 to 8 years old)\r\n- Marmaille&Co Fun Bag (for families with children aged 6 to 12)\r\n- On the road with Zeno (9 to 12 years old): also available in LSFB (Belgian-French sign language) and VGT (Flemish sign language)\r\n\r\nNot convinced yet? Come to our Family Day on Sunday 26\/02 where your children will be transformed into real superheroes! They will have the chance to build a city, make their own cape and assist Belgian heroes in their adventures! So have a super-tastic day with the whole family!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551440"},"de":{"name":"Krokusvakantie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551440"},"it":{"name":"Krokusvakantie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551440"},"sp":{"name":"Krokusvakantie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551440"},"pt":{"name":"Krokusvakantie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551440"},"cn":{"name":"Krokusvakantie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551440"}},"place":{"id":233379,"translations":{"fr":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Se pr\u00e9sentant comme le mus\u00e9e de la Belgique et de son histoire, mais \u00e9galement comme \u00ab centre pour la d\u00e9mocratie \u00bb, l\u2019\u00e9tablissement b\u00e9n\u00e9ficie d\u2019une mus\u00e9ographie compl\u00e8tement remani\u00e9e depuis peu. D\u00e9mocratie, prosp\u00e9rit\u00e9, solidarit\u00e9, pluralisme, migrations, langues, Europe : le mus\u00e9e BELvue vous propose de d\u00e9couvrir le pays \u00e0 travers ces quelques th\u00e9matiques. L\u2019approche se veut originale, puisque chaque th\u00e9matique est d\u2019abord explicit\u00e9e \u00e0 l\u2019aide de t\u00e9moignages actuels, et ensuite contextualis\u00e9e \u00e0 travers l\u2019histoire. Plus de 200 objets composent une galerie et permettent d\u2019incarner la m\u00e9moire mat\u00e9rielle du pays. Vous y croiserez par exemple une lithographie de Magritte, des vases en cristal du Val Saint-Lambert, un costume du carnaval de Binche, ou encore un ballon sign\u00e9 par les Diables Rouges !\r\nCe b\u00e2timent, affect\u00e9 initialement \u00e0 l\u2019usage d\u2019un h\u00f4tel, est b\u00e2ti en 1776 \u2014 et ouvert dans le courant de l\u2019ann\u00e9e suivante \u2014 dans un p\u00f4le \u00e0 vocation touristique, commercial (difficile \u00e0 s\u2019imaginer aujourd\u2019hui !), et tr\u00e8s cosmopolite (l\u2019h\u00f4tel Astoria, rue Royale, en demeure le seul t\u00e9moin actuel). L\u2019\u00e9tablissement recevait essentiellement des touristes, en majorit\u00e9 anglais, mais pas n\u2019importe quels touristes : il s\u2019agit d\u2019une h\u00f4tellerie de luxe, avec des clients prestigieux.\r\nDe style n\u00e9oclassique, comme l\u2019ensemble de la place Royale, le b\u00e2timent privil\u00e9gie la sobri\u00e9t\u00e9 et les proportions harmonieuses. La visite int\u00e9rieure vous offrira davantage de d\u00e9tails sur le d\u00e9cor.\r\nLe Parc de Bruxelles constituait un p\u00f4le d\u2019attraction pour les touristes : la promenade mondaine est en effet une occupation de choix. \u00ab De midi \u00e0 une heure, cette promenade devient ordinairement le rendez-vous des \u00e9trangers et des gens riches. Cette mac\u00e9doine de nations qu\u2019on y rencontre \u00e9gaie quelques heures par jour cet endroit. \u00bb\r\nSi globalement, les relations du Bellevue avec son illustre voisin \u2014 le palais royal \u2014 restent bonnes, l\u2019h\u00f4tel h\u00e9bergeant m\u00eame souvent des invit\u00e9s de marque susceptibles d\u2019une entrevue royale, quelques frictions ont pu appara\u00eetre, notamment \u00e0 cause de la construction de terrasses adjacentes \u00e0 l\u2019\u00e9tablissement, et donnant une vue magnifique sur les jardins du roi, ce qui n\u2019\u00e9tait pas tr\u00e8s au go\u00fbt de L\u00e9opold II\u2026\r\nCf. flyer sur l\u2019histoire du b\u00e2timent disponible sur place\r\n\r\nL\u2019entr\u00e9e au mus\u00e9e BELvue est gratuite tous les mercredis \u00e0 partir de 14h.\r\nLe lundi: ouvert pour des groupes et \u00e9coles sur r\u00e9servation de 09 :30 \u00e0 17 :00\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Frieten, bier, chocolade\u2026 maar Belgi\u00eb is toch wel meer dan dat, nietwaar? Democratie, welvaart, solidariteit, pluralisme, migratie, taal, Europa: dat zijn de thema\u2019s die het BELvue museum jullie voorstelt om kennis te maken met het land! Elk thema wordt uitgewerkt aan de hand van hedendaagse getuigenissen en vervolgens toegelicht doorheen de geschiedenis. Een eigentijdse en originele manier om een beter inzicht te verwerven in het Belgi\u00eb van vandaag.\r\nNeem zeker ook een kijkje in de galerij: daar staan meer dan 200 voorwerpen opgesteld die het materi\u00eble geheugen van Belgi\u00eb vormen. Je kunt er onder andere de volgende zaken bewonderen: een lithografie van Magritte, een motorfiets, kristallen vazen van Val Saint-Lambert, en een bal met de handtekeningen van de Rode Duivels erop. Een verzameling met een hoog Belgi\u00ebgehalte!\r\n\r\nElke woensdag vanaf 14.00 uur is het BELvue museum gratis toegankelijk.\r\nMaandag open voor groepen en scholen op reservering van 09:30 tot 17:00\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"BELvue museum","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais, 7","address_line2":"1000 Brussels","description_web":"Chips, beer and chocolates... surely there is more to Belgium than that? Democracy, prosperity, solidarity, pluralism, migration, languages and Europe: these are the themes used by the BELvue Museum to help you to discover Belgium. Each one is developed through present-day testimonials and then traced right through history. This is a modern, original way of gaining a fuller understanding of modern-day Belgium.\r\nHave a look at the gallery too: there are more than 200 objects to view, each one forming a tangible memory of Belgium. Here are just a few examples: a lithograph by Magritte, a motorcycle, crystal vases by Val Saint-Lambert, and a football signed by the Red Devils. The very essence of Belgian-ness!\r\n\r\nEntry to the BELvue Museum is free every Wednesday from 2 p.m.\r\nMonday open for groups and schools on reservation from 09:30 to 17:00\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Museum BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Belgische Fritten, Bier, Schokolade...Belgien ist mehr als nur das, oder? Demokratie, Wohlstand, Solidarit\u00e4t, Vielfalt, Migration, Sprachen, Europa: Dies sind die Themen, die das BELvue Museum Ihnen auf Ihrem Rundgang durch die Ausstellungsr\u00e4ume n\u00e4herbringt! Jedes Thema wird anhand von aktuellen Kommentaren und Berichten geschildert und dann in seinen geschichtlichen Kontext gebracht. Eine moderne und originelle Herangehensweise, die den Besuchern einen faszinierenden Einblick in das Belgien der Gegenwart gew\u00e4hrt.\r\n\r\nAbsolut sehenswert ist auch die Galerie: Mehr als 200 Ausstellungsst\u00fccke verk\u00f6rpern gewisserma\u00dfen das materielle Ged\u00e4chtnis Belgiens. Zu bewundern gibt es unter anderem eine Lithographie von Magritte, Kristallvasen aus der Kristallmanufaktur Val Saint-Lambert und sogar einen von den Roten Teufeln signierten Fu\u00dfball. Eine geballte Ladung belgischer Lebensart!\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Nel Museo BELvue, grazie a numerosi documenti, i visitatori potranno scoprire i grandi periodi della storia del Belgio.\u00a0...\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Conocido como el museo de B\u00e9lgica y su historia, pero tambi\u00e9n como \"centro para la democracia\", el establecimiento posee una museograf\u00eda completamente redise\u00f1ada desde hace poco. Democracia, prosperidad, solidaridad, pluralismo, migraciones, idiomas, Europa: El museo BELvue te propone descubrir el pa\u00eds a trav\u00e9s de diferentes tem\u00e1ticas. El enfoque es original, ya que cada tem\u00e1tica se explica en primer lugar con la ayuda de testimonios actuales y a continuaci\u00f3n es contextualizada a trav\u00e9s de la historia. M\u00e1s de 200 objetos componen una galer\u00eda para encarnar la memoria material del pa\u00eds. Encontrar\u00e1s, por ejemplo, una litograf\u00eda de Magritte, los vasos de cristal de Val Saint-Lambert, un disfraz del carnaval de Binche, \u00a1Y un bal\u00f3n firmado por los Diablos Rojos!\r\nEste edificio, originalmente utilizado como hotel, se construy\u00f3 en 1776 \u2014 y fue abierto durante el transcurso del a\u00f1o siguiente \u2014 como un centro de car\u00e1cter tur\u00edstico, comercial y muy cosmopolita. El establecimiento recibe esencialmente turistas, en su mayor\u00eda ingleses, pero no cualquier turista: se trata de un hospedaje de lujo, con clientes prestigiosos. De estilo neocl\u00e1sico, como el conjunto de la Place Royale, el edificio favorece la sobriedad y las proporciones armoniosas. La vista interior te ofrecer\u00e1 m\u00e1s detalles del decorado.\r\nEl Parque de Bruselas constituye un centro de atracci\u00f3n para los turistas: esta visita al parque es en efecto una excelente actividad a elegir. \"Entre media hora y una hora, este paseo se convierte generalmente en un punto de reuni\u00f3n para la diversidad, desde extranjeros hasta gente rica. Esta macedonia de nacionalidades que encontramos enriquece el ambiente del lugar\".\r\nSi las relaciones entre Bellevue y su ilustre vecino - el Palacio Real - siguen siendo buenas, el hotel hospeda a menudo a distinguidos invitados de entrevista real. Pueden haber surgido ciertos roces especialmente a causa de la contrucci\u00f3n de terrazas adyacentes al establecimiento, proporcionando una magn\u00edfica vista al Real Jard\u00edn de las Plantas Medicinales, el cual no era del agrado de Leopoldo ll.\r\nV\u00e9ase el folleto sobre la historia del edificio disponible en el lugar.\r\n\r\nLa entrada al museo BELvue es gratuita todos los mi\u00e9rcoles a partir de las 14:00.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Apresentando-se como o museu da B\u00e9lgica e da sua hist\u00f3ria, mas igualmente como \u00abcentro para a democracia\u00bb, o estabelecimento beneficia de uma museografia recentemente completamente remodelada. Democracia, prosperidade, solidariedade, pluralismo, migra\u00e7\u00f5es, l\u00ednguas, Europa: o museu BELvue prop\u00f5e-lhe descobrir o pa\u00eds atrav\u00e9s desses temas. A abordagem quer-se original, pelo que cada tema \u00e9, em primeiro lugar, explicitado com a ajuda de testemunhas reais e, de seguida, contextualizado atrav\u00e9s da hist\u00f3ria. Mais de 200 objetos comp\u00f5em uma galeria e permitem incarnar a mem\u00f3ria material do pa\u00eds. Poder\u00e1 a\u00ed encontrar, por exemplo, uma litografia de Magritte, vasos em cristal produzidos por Val Saint-Lambert, m\u00e1scaras de carnaval da regi\u00e3o de Binche, ou ainda um bal\u00e3o assinado pela Sele\u00e7\u00e3o Belga de Futebol! Este edif\u00edcio, inicialmente usado como hotel, foi constru\u00eddo em 1776 \u2014 e aberto durante o ano seguinte \u2014 num tur\u00edstico, comercial (dif\u00edcil imagin\u00e1-lo hoje em dia!) e muito cosmopolita (o hotel Astoria, na rua Royale, \u00e9 a \u00fanica testemunha atual). O estabelecimento recebia essencialmente turistas, a maioria dos quais ingleses, mas n\u00e3o qualquer turista: tratava-se de um hotel de luxo, com clientes prestigiosos. De estilo neocl\u00e1ssico, como toda a Pra\u00e7a Real, o edif\u00edcio privilegia a sobriedade e as propor\u00e7\u00f5es harmoniosas. A visita interior oferecer-lhe-\u00e1 ainda mais detalhes de decora\u00e7\u00e3o. O Parque de Bruxelas consiste num polo de atra\u00e7\u00e3o para os turistas: o passeio mundano \u00e9, na realidade, um trabalho de escolha. \u00abDo meio-dia \u00e0 uma, este passeio torna-se, simplesmente, o local de encontro de estranhos e ricos. Esta salada de frutas de pa\u00edses que se encontram alegra este local durante algumas horas por dia\u00bb. Se, em geral, as rela\u00e7\u00f5es de Bellevue com o seu ilustre vizinho \u2014 o Pal\u00e1cio Real \u2014 permanecem boas, com o hotel a alojar frequentemente convidados de honra pass\u00edveis de uma visita real, poderiam ter ocorrido algumas fric\u00e7\u00f5es, nomeadamente devido \u00e0 constru\u00e7\u00e3o dos terra\u00e7os adjacentes ao estabelecimento, que oferecem uma vista magn\u00edfica para os jardins do rei, o que n\u00e3o \u00e9 muito do agrado de L\u00e9opold II\u2026 Ver o panfleto sobre a hist\u00f3ria do edif\u00edcio, dispon\u00edvel no local A entrada para o museu BELvue \u00e9 gratuita todas as ter\u00e7as-feiras a partir das 14h.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"],"de":["K\u00f6nigliches Viertel"],"it":["Quartiere reale"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":1250,"location":{"lat":50.84261029,"lon":4.36068879},"region":"brussels","last_updated_at":"2023-02-11T06:06:54+01:00","published_at":"2013-10-19T01:14:10+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":233379,"translations":{"fr":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Se pr\u00e9sentant comme le mus\u00e9e de la Belgique et de son histoire, mais \u00e9galement comme \u00ab centre pour la d\u00e9mocratie \u00bb, l\u2019\u00e9tablissement b\u00e9n\u00e9ficie d\u2019une mus\u00e9ographie compl\u00e8tement remani\u00e9e depuis peu. D\u00e9mocratie, prosp\u00e9rit\u00e9, solidarit\u00e9, pluralisme, migrations, langues, Europe : le mus\u00e9e BELvue vous propose de d\u00e9couvrir le pays \u00e0 travers ces quelques th\u00e9matiques. L\u2019approche se veut originale, puisque chaque th\u00e9matique est d\u2019abord explicit\u00e9e \u00e0 l\u2019aide de t\u00e9moignages actuels, et ensuite contextualis\u00e9e \u00e0 travers l\u2019histoire. Plus de 200 objets composent une galerie et permettent d\u2019incarner la m\u00e9moire mat\u00e9rielle du pays. Vous y croiserez par exemple une lithographie de Magritte, des vases en cristal du Val Saint-Lambert, un costume du carnaval de Binche, ou encore un ballon sign\u00e9 par les Diables Rouges !\r\nCe b\u00e2timent, affect\u00e9 initialement \u00e0 l\u2019usage d\u2019un h\u00f4tel, est b\u00e2ti en 1776 \u2014 et ouvert dans le courant de l\u2019ann\u00e9e suivante \u2014 dans un p\u00f4le \u00e0 vocation touristique, commercial (difficile \u00e0 s\u2019imaginer aujourd\u2019hui !), et tr\u00e8s cosmopolite (l\u2019h\u00f4tel Astoria, rue Royale, en demeure le seul t\u00e9moin actuel). L\u2019\u00e9tablissement recevait essentiellement des touristes, en majorit\u00e9 anglais, mais pas n\u2019importe quels touristes : il s\u2019agit d\u2019une h\u00f4tellerie de luxe, avec des clients prestigieux.\r\nDe style n\u00e9oclassique, comme l\u2019ensemble de la place Royale, le b\u00e2timent privil\u00e9gie la sobri\u00e9t\u00e9 et les proportions harmonieuses. La visite int\u00e9rieure vous offrira davantage de d\u00e9tails sur le d\u00e9cor.\r\nLe Parc de Bruxelles constituait un p\u00f4le d\u2019attraction pour les touristes : la promenade mondaine est en effet une occupation de choix. \u00ab De midi \u00e0 une heure, cette promenade devient ordinairement le rendez-vous des \u00e9trangers et des gens riches. Cette mac\u00e9doine de nations qu\u2019on y rencontre \u00e9gaie quelques heures par jour cet endroit. \u00bb\r\nSi globalement, les relations du Bellevue avec son illustre voisin \u2014 le palais royal \u2014 restent bonnes, l\u2019h\u00f4tel h\u00e9bergeant m\u00eame souvent des invit\u00e9s de marque susceptibles d\u2019une entrevue royale, quelques frictions ont pu appara\u00eetre, notamment \u00e0 cause de la construction de terrasses adjacentes \u00e0 l\u2019\u00e9tablissement, et donnant une vue magnifique sur les jardins du roi, ce qui n\u2019\u00e9tait pas tr\u00e8s au go\u00fbt de L\u00e9opold II\u2026\r\nCf. flyer sur l\u2019histoire du b\u00e2timent disponible sur place\r\n\r\nL\u2019entr\u00e9e au mus\u00e9e BELvue est gratuite tous les mercredis \u00e0 partir de 14h.\r\nLe lundi: ouvert pour des groupes et \u00e9coles sur r\u00e9servation de 09 :30 \u00e0 17 :00\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Frieten, bier, chocolade\u2026 maar Belgi\u00eb is toch wel meer dan dat, nietwaar? Democratie, welvaart, solidariteit, pluralisme, migratie, taal, Europa: dat zijn de thema\u2019s die het BELvue museum jullie voorstelt om kennis te maken met het land! Elk thema wordt uitgewerkt aan de hand van hedendaagse getuigenissen en vervolgens toegelicht doorheen de geschiedenis. Een eigentijdse en originele manier om een beter inzicht te verwerven in het Belgi\u00eb van vandaag.\r\nNeem zeker ook een kijkje in de galerij: daar staan meer dan 200 voorwerpen opgesteld die het materi\u00eble geheugen van Belgi\u00eb vormen. Je kunt er onder andere de volgende zaken bewonderen: een lithografie van Magritte, een motorfiets, kristallen vazen van Val Saint-Lambert, en een bal met de handtekeningen van de Rode Duivels erop. Een verzameling met een hoog Belgi\u00ebgehalte!\r\n\r\nElke woensdag vanaf 14.00 uur is het BELvue museum gratis toegankelijk.\r\nMaandag open voor groepen en scholen op reservering van 09:30 tot 17:00\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"BELvue museum","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais, 7","address_line2":"1000 Brussels","description_web":"Chips, beer and chocolates... surely there is more to Belgium than that? Democracy, prosperity, solidarity, pluralism, migration, languages and Europe: these are the themes used by the BELvue Museum to help you to discover Belgium. Each one is developed through present-day testimonials and then traced right through history. This is a modern, original way of gaining a fuller understanding of modern-day Belgium.\r\nHave a look at the gallery too: there are more than 200 objects to view, each one forming a tangible memory of Belgium. Here are just a few examples: a lithograph by Magritte, a motorcycle, crystal vases by Val Saint-Lambert, and a football signed by the Red Devils. The very essence of Belgian-ness!\r\n\r\nEntry to the BELvue Museum is free every Wednesday from 2 p.m.\r\nMonday open for groups and schools on reservation from 09:30 to 17:00\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Museum BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Belgische Fritten, Bier, Schokolade...Belgien ist mehr als nur das, oder? Demokratie, Wohlstand, Solidarit\u00e4t, Vielfalt, Migration, Sprachen, Europa: Dies sind die Themen, die das BELvue Museum Ihnen auf Ihrem Rundgang durch die Ausstellungsr\u00e4ume n\u00e4herbringt! Jedes Thema wird anhand von aktuellen Kommentaren und Berichten geschildert und dann in seinen geschichtlichen Kontext gebracht. Eine moderne und originelle Herangehensweise, die den Besuchern einen faszinierenden Einblick in das Belgien der Gegenwart gew\u00e4hrt.\r\n\r\nAbsolut sehenswert ist auch die Galerie: Mehr als 200 Ausstellungsst\u00fccke verk\u00f6rpern gewisserma\u00dfen das materielle Ged\u00e4chtnis Belgiens. Zu bewundern gibt es unter anderem eine Lithographie von Magritte, Kristallvasen aus der Kristallmanufaktur Val Saint-Lambert und sogar einen von den Roten Teufeln signierten Fu\u00dfball. Eine geballte Ladung belgischer Lebensart!\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Nel Museo BELvue, grazie a numerosi documenti, i visitatori potranno scoprire i grandi periodi della storia del Belgio.\u00a0...\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Conocido como el museo de B\u00e9lgica y su historia, pero tambi\u00e9n como \"centro para la democracia\", el establecimiento posee una museograf\u00eda completamente redise\u00f1ada desde hace poco. Democracia, prosperidad, solidaridad, pluralismo, migraciones, idiomas, Europa: El museo BELvue te propone descubrir el pa\u00eds a trav\u00e9s de diferentes tem\u00e1ticas. El enfoque es original, ya que cada tem\u00e1tica se explica en primer lugar con la ayuda de testimonios actuales y a continuaci\u00f3n es contextualizada a trav\u00e9s de la historia. M\u00e1s de 200 objetos componen una galer\u00eda para encarnar la memoria material del pa\u00eds. Encontrar\u00e1s, por ejemplo, una litograf\u00eda de Magritte, los vasos de cristal de Val Saint-Lambert, un disfraz del carnaval de Binche, \u00a1Y un bal\u00f3n firmado por los Diablos Rojos!\r\nEste edificio, originalmente utilizado como hotel, se construy\u00f3 en 1776 \u2014 y fue abierto durante el transcurso del a\u00f1o siguiente \u2014 como un centro de car\u00e1cter tur\u00edstico, comercial y muy cosmopolita. El establecimiento recibe esencialmente turistas, en su mayor\u00eda ingleses, pero no cualquier turista: se trata de un hospedaje de lujo, con clientes prestigiosos. De estilo neocl\u00e1sico, como el conjunto de la Place Royale, el edificio favorece la sobriedad y las proporciones armoniosas. La vista interior te ofrecer\u00e1 m\u00e1s detalles del decorado.\r\nEl Parque de Bruselas constituye un centro de atracci\u00f3n para los turistas: esta visita al parque es en efecto una excelente actividad a elegir. \"Entre media hora y una hora, este paseo se convierte generalmente en un punto de reuni\u00f3n para la diversidad, desde extranjeros hasta gente rica. Esta macedonia de nacionalidades que encontramos enriquece el ambiente del lugar\".\r\nSi las relaciones entre Bellevue y su ilustre vecino - el Palacio Real - siguen siendo buenas, el hotel hospeda a menudo a distinguidos invitados de entrevista real. Pueden haber surgido ciertos roces especialmente a causa de la contrucci\u00f3n de terrazas adyacentes al establecimiento, proporcionando una magn\u00edfica vista al Real Jard\u00edn de las Plantas Medicinales, el cual no era del agrado de Leopoldo ll.\r\nV\u00e9ase el folleto sobre la historia del edificio disponible en el lugar.\r\n\r\nLa entrada al museo BELvue es gratuita todos los mi\u00e9rcoles a partir de las 14:00.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Apresentando-se como o museu da B\u00e9lgica e da sua hist\u00f3ria, mas igualmente como \u00abcentro para a democracia\u00bb, o estabelecimento beneficia de uma museografia recentemente completamente remodelada. Democracia, prosperidade, solidariedade, pluralismo, migra\u00e7\u00f5es, l\u00ednguas, Europa: o museu BELvue prop\u00f5e-lhe descobrir o pa\u00eds atrav\u00e9s desses temas. A abordagem quer-se original, pelo que cada tema \u00e9, em primeiro lugar, explicitado com a ajuda de testemunhas reais e, de seguida, contextualizado atrav\u00e9s da hist\u00f3ria. Mais de 200 objetos comp\u00f5em uma galeria e permitem incarnar a mem\u00f3ria material do pa\u00eds. Poder\u00e1 a\u00ed encontrar, por exemplo, uma litografia de Magritte, vasos em cristal produzidos por Val Saint-Lambert, m\u00e1scaras de carnaval da regi\u00e3o de Binche, ou ainda um bal\u00e3o assinado pela Sele\u00e7\u00e3o Belga de Futebol! Este edif\u00edcio, inicialmente usado como hotel, foi constru\u00eddo em 1776 \u2014 e aberto durante o ano seguinte \u2014 num tur\u00edstico, comercial (dif\u00edcil imagin\u00e1-lo hoje em dia!) e muito cosmopolita (o hotel Astoria, na rua Royale, \u00e9 a \u00fanica testemunha atual). O estabelecimento recebia essencialmente turistas, a maioria dos quais ingleses, mas n\u00e3o qualquer turista: tratava-se de um hotel de luxo, com clientes prestigiosos. De estilo neocl\u00e1ssico, como toda a Pra\u00e7a Real, o edif\u00edcio privilegia a sobriedade e as propor\u00e7\u00f5es harmoniosas. A visita interior oferecer-lhe-\u00e1 ainda mais detalhes de decora\u00e7\u00e3o. O Parque de Bruxelas consiste num polo de atra\u00e7\u00e3o para os turistas: o passeio mundano \u00e9, na realidade, um trabalho de escolha. \u00abDo meio-dia \u00e0 uma, este passeio torna-se, simplesmente, o local de encontro de estranhos e ricos. Esta salada de frutas de pa\u00edses que se encontram alegra este local durante algumas horas por dia\u00bb. Se, em geral, as rela\u00e7\u00f5es de Bellevue com o seu ilustre vizinho \u2014 o Pal\u00e1cio Real \u2014 permanecem boas, com o hotel a alojar frequentemente convidados de honra pass\u00edveis de uma visita real, poderiam ter ocorrido algumas fric\u00e7\u00f5es, nomeadamente devido \u00e0 constru\u00e7\u00e3o dos terra\u00e7os adjacentes ao estabelecimento, que oferecem uma vista magn\u00edfica para os jardins do rei, o que n\u00e3o \u00e9 muito do agrado de L\u00e9opold II\u2026 Ver o panfleto sobre a hist\u00f3ria do edif\u00edcio, dispon\u00edvel no local A entrada para o museu BELvue \u00e9 gratuita todas as ter\u00e7as-feiras a partir das 14h.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":1250,"location":{"lat":50.84261029,"lon":4.36068879},"region":"brussels","last_updated_at":"2023-02-11T06:06:54+01:00","published_at":"2013-10-19T01:14:10+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/c7e3690321e00efd84939de2b2bd1c064c7325da.jpg","width":2350,"height":2463,"ratio":0.95,"translations":{"fr":{"title":"Cong\u00e9s de d\u00e9tente","copyright":null},"nl":{"title":"Cong\u00e9s de d\u00e9tente","copyright":null},"en":{"title":"Cong\u00e9s de d\u00e9tente","c