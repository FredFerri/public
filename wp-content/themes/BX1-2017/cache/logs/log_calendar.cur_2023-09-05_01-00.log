o.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560015"},"cn":{"name":"Michaela Riener - Bart Jacobs - I QUATTRO TEMPERAMENTI","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560015"},"fr":{"name":"Michaela Riener - Bart Jacobs - I QUATTRO TEMPERAMENTI","shortdescr":"I Quattro Temperamenti Oeuvres de Monteverdi, Buxtehude, Purcell","longdescr":"Au cours de ce concert, l\u2019expression d\u2019\u00e9motions telles que l\u2019amour, la tristesse, la joie et la col\u00e8re est centrale. La pratique musicale baroque consistant \u00e0 relier la musique \u00e0 toutes ces \u00e9motions remonte \u00e0 la Gr\u00e8ce antique et \u00e0 la doctrine des quatre temp\u00e9raments sanguin, col\u00e9rique, m\u00e9lancolique et flegmatique. La musique avait la capacit\u00e9 de provoquer ces r\u00e9actions et est ainsi devenue un sujet pertinent parmi les compositeurs baroques. Quatre temp\u00e9raments \u00e0 travers la musique de Henry Purcell, Claudio Monteverdi et Dieterich Buxtehude, par quatre fougueux musiciens...","performers":"Bart Jacobs orgue, clavecin et direction Michaela Riener soprano Joanna Huszcza violon Ira Givol viole de gambe","boxoffice_url":"http:\/\/ticket.visit.brussels\/fr\/560015\/michaela-riener-bart-jacobs-i-quattro-temperamenti\/shop","website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560015"},"sp":{"name":"Michaela Riener - Bart Jacobs - I QUATTRO TEMPERAMENTI","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560015"},"nl":{"name":"Michaela Riener - Bart Jacobs - I QUATTRO TEMPERAMENTI","shortdescr":"I Quattro Temperamenti Werken van Monteverdi, Buxtehude, Purcell","longdescr":"Tijdens dit concert staat het uiten van emoties zoals liefde, verdriet, vreugde en woede centraal. De barokke muziekpraktijk om muziek te relateren aan al deze emoties gaat terug tot het oude Griekenland en de leer van de vier temperamenten sanguinisch, cholerisch, melancholisch en flegmatisch. Muziek had namelijk het vermogen om deze reacties uit te lokken en werd zo een relevant onderwerp onder barokcomponisten. Laat je meevoeren langs vier temperamenten doorheen de muziek van Henry Purcell, Claudio Monteverdi en Dieterich Buxtehude door vier temperamentvolle musici\u2026","performers":"Bart Jacobs orgel, klavecimbel en directie Michaela Riener sopraan Joanna Huszcza viool Ira Givol gamba","boxoffice_url":"http:\/\/ticket.visit.brussels\/nl\/560015\/michaela-riener-bart-jacobs-i-quattro-temperamenti\/shop","website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560015"}},"place":{"id":479,"translations":{"de":{"name":"Kirche Notre-Dame de la Chapelle","address_street_name":"Place de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Chapelle","address_line2":"1000 Bruxelles","description_web":"Die Br\u00fcsseler Notre Dame de la Chapelle-Kirche ist aufgrund ihrer romanischen Architektur bemerkenswert und gilt als eine der interessantesten Kirchen Belgiens.\r\n\r\nIn einer der Kapellen befindet sich das Grabmal des Malers Pieter Breughel und seiner Gemahlin, Marie Coucke. In der Kapelle des Heiligen Sakraments erinnert eine Gedenktafel daran, dass sich hier auch die letzte Ruhest\u00e4tte des zum Tode verurteilten und hingerichteten K\u00f6rperschafts\u00e4ltesten Fran\u00e7ois Anneessens, der sich f\u00fcr die Gemeindefreiheit der Stadt Br\u00fcssel eingesetzt hat, befindet.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,