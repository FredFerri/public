ic.   \r\n\r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Fou Rire","address_street_name":"Avenue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue des Grenadiers, 48","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Fou Rire","address_street_name":"Grenadierslaan","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Ixelles","address_line1":"Grenadierslaan, 48","address_line2":"1050 Ixelles","description_web":"Op zoek naar een avond vol humor en vermaak? Dan bij je bij Le Fou Rire aan het juiste (sinds 2019 nieuwe!) adres, want dat betekent \u2018slappe lach\u2019 in het Frans. Via ontspanning, wisselwerking en emotie wil dit door en door Brussels theater mensen verbinden en hen met een verzadigd en uitgelaten gevoel weer naar huis sturen. Tekst en emotie krijgen een glansrol in dit buurttheater, want naast stand-upcomedy komen ook po\u00ebzie, filosofie en zelfs sprookjes en jeugdtheater ruimschoots aan bod.   ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":"lefourire","backoffice_id":11226,"location":{"lat":50.8097778,"lon":4.3917894},"region":"brussels","last_updated_at":"2023-11-27T15:16:14+01:00","published_at":"2013-10-19T01:30:00+02:00","import_origin":null,"exter