[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700004645,"date_start":"2025-01-16","date_end":"2025-01-16","date_next":"2025-01-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-16T12:07:08+01:00","published_at":"2024-12-16T12:04:58+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":314430,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Moi l'\u00e9l\u00e9phant d'Afrique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.briandlaurence.com","email":"laubriandgdl@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004645"},"pt":{"name":"Moi l'\u00e9l\u00e9phant d'Afrique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.briandlaurence.com","email":"laubriandgdl@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004645"},"en":{"name":"Moi l'\u00e9l\u00e9phant d'Afrique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.briandlaurence.com","email":"laubriandgdl@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004645"},"it":{"name":"Moi l'\u00e9l\u00e9phant d'Afrique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.briandlaurence.com","email":"laubriandgdl@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004645"},"cn":{"name":"Moi l'\u00e9l\u00e9phant d'Afrique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.briandlaurence.com","email":"laubriandgdl@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004645"},"fr":{"name":"Moi l'\u00e9l\u00e9phant d'Afrique","shortdescr":"L'histoire de Laurence, petite fille m\u00e9tisse dans ann\u00e9es 80, qui grandit en affrontant le racisme. Surnomm\u00e9e \"\u00c9l\u00e9phant d'Afrique\", elle ressent d\u00e8s l'enfance le poids de l'exclusion. L'abandon par son p\u00e8re renforce cela et la pousse \u00e0 grandir trop vite. Le r\u00e9cit explore la transmission g\u00e9n\u00e9rationnelle des traumas, et la volont\u00e9 de rompre les cycles. Un seul en sc\u00e8ne acidul\u00e9, dr\u00f4le et sensible.","longdescr":"\"Moi, L'\u00c9l\u00e9phant d'Afrique\" est bien plus qu'un simple spectacle, c'est un voyage intime dans la vie d\u2019une jeune fille m\u00e9tisse n\u00e9e dans les ann\u00e9es 80, aux prises avec les luttes et les \u00e9motions de grandir dans un monde marqu\u00e9 par le racisme et l'exclusion. \u00ab \u00c9l\u00e9phant d\u2019Afrique \u00bb c\u2019est comme \u00e7a qu\u2019on l\u2019insultait lorsqu\u2019elle \u00e9tait petite. Pourtant c\u2019est beau et c\u2019est fort un \u00e9l\u00e9phant.\n\nD\u00e8s son enfance, elle est confront\u00e9e \u00e0 des regards m\u00e9prisants et \u00e0 des mots blessants qui\nlaissent des cicatrices invisibles sur son \u00e2me. Que ce soit \u00e0 l\u2019\u00e9cole de la part de ses camarades ou de la part de ses professeurs. Elle se demande pourquoi elle est si diff\u00e9rente, pourquoi elle ne peut pas simplement \u00eatre comme tout le monde. \n\nEt lorsque son p\u00e8re quitte la maison, laissant derri\u00e8re lui un vide douloureux, elle se sent abandonn\u00e9e et perdue. Elle se r\u00e9fugie dans la nourriture. Elle grandit trop vite prenant le chemin des adultes bien malgr\u00e9 elle.\n\nPourtant, m\u00eame avec la douleur et le doute, elle trouve en elle une force insoup\u00e7onn\u00e9e. \u00c0 travers ses luttes, elle d\u00e9couvre sa propre voie sa propre identit\u00e9, et apprend \u00e0 se relever apr\u00e8s chaque chute. \nSon histoire est un rappel \u00e0 la r\u00e9silience et au pouvoir de la confiance en soi.\n\n\nMais ce n'est pas seulement l'histoire d'une victoire sur l'adversit\u00e9. En raison de son pass\u00e9 marqu\u00e9 par l'abandon, elle ne ressent pas le d\u00e9sir d'\u00eatre m\u00e8re \u00e0 son tour. Elle d\u00e9fend l'id\u00e9e que notre enfance et nos exp\u00e9riences pass\u00e9es nous conditionnent profond\u00e9ment, influen\u00e7ant nos choix et nos perspectives sur la vie.\n\n\"Moi, l'\u00c9l\u00e9phant d'Afrique\" explore donc \u00e9galement le th\u00e8me complexe de la transmission interg\u00e9n\u00e9rationnelle des blessures et des traumas. \n\nElle se bat contre les d\u00e9mons de son pass\u00e9, non seulement pour elle-m\u00eame, mais aussi pour briser le cycle et emp\u00eacher que les souffrances qu'elle a endur\u00e9es ne se r\u00e9p\u00e8tent dans les g\u00e9n\u00e9rations futures.\n\nAu c\u0153ur de cette histoire se trouve un message puissant sur le pouvoir de l'acceptation de soi, de la gu\u00e9rison et du choix de d\u00e9finir notre propre avenir, ind\u00e9pendamment des blessures du pass\u00e9.\n\nD\u2019une grande authenticit\u00e9, ce seul en sc\u00e8ne nous fait voyager dans diverses \u00e9motions humaines. Passant du rire au larme, de la col\u00e8re \u00e0 l\u2019humour, de la douleur \u00e0 la joie, ce parcours de vie est un v\u00e9ritable shakers d\u2019\u00e9motions fortes qui ne laissera personne indiff\u00e9rent.\n\nUn seul en sc\u00e8ne sur l\u2019espoir et la r\u00e9silience.\n","performers":"Avec Laurence Briand. Mise en sc\u00e8ne Mohamed Ouachen.\n\n","boxoffice_url":null,"website":"https:\/\/www.briandlaurence.com","email":"laubriandgdl@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004645"},"sp":{"name":"Moi l'\u00e9l\u00e9phant d'Afrique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.briandlaurence.com","email":"laubriandgdl@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004645"},"nl":{"name":"Moi l'\u00e9l\u00e9phant d'Afrique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.briandlaurence.com","email":"laubriandgdl@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004645"}},"place":{"id":50000493,"translations":{"de":{"name":"Th\u00e9atre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9atre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null