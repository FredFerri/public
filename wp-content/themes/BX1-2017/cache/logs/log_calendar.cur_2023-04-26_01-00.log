:false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"],"it":["Spazi verdi"],"sp":["Espacios verdes:"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Dimanche \u00e0 v\u00e9lo | Domaine Coloma Sint-Pieters-Leeuw","shortdescr":"Le 30 avril nous nous rendons au chateau et jardin des roses du domaine Coloma \u00e0 Sint-Pieters-Leeuw! D\u00e9part \u00e0 10:00 au Grand Hospice","longdescr":"Les derniers dimanches du mois, vous pouvez explorer Bruxelles et sa p\u00e9riph\u00e9rie \u00e0 v\u00e9lo. Chaque mois, un(e) de nos guides pr\u00e9pare un itin\u00e9raire \u00e0 v\u00e9lo relaxant et l\u00e9g\u00e8rement sportif d'environ 20 \u00e0 25 km vers un endroit vert et surprenant dans la p\u00e9riph\u00e9rie. Id\u00e9al pour les cyclistes d\u00e9butants et pour des conversations et rencontres agr\u00e9ables avec d'autres cyclistes bruxellois. \r\n\r\nLe 30 avril nous nous rendons au chateau et jardin des roses du domaine Coloma \u00e0 Sint-Pieters-Leeuw\r\n\r\n   - d\u00e9part \u00e0 10h00 du Grand Hospice\r\n\r\n   - nous arrivons \u00e0 notre destination vers midi o\u00f9 nous buvons quelque chose ensemble. N\u2019h\u00e9sitez pas \u00e0 emmener un casse-cro\u00fbte\r\n\r\n   - Au plus tard \u00e0 13 heures, vous pouvez regagner le centre ville \u00e0 v\u00e9lo avec l'un de nos guides\r\n\r\n   - participation gratuite\r\n\r\nInscriptions via info@cactus.brussels (obligatoire)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554970"},"nl":{"name":"Dimanche \u00e0 v\u00e9lo | Colomadomein Sint-Pieters-Leeuw","shortdescr":"Op 30 april fietsen we naar het kasteel en de rozentuin van het Colomadomein in Sint-Pieters-Leeuw! Vertrek 10:00 aan de Grand Hospice","longdescr":"De laatste zondag van de maand kan je met Cactus op ontdekking door Brussel en de Brusselse rand. Elke maand bereidt \u00e9\u00e9n van onze gidsen een ontspannende, licht sportieve fietstocht van zo\u2019n 20 \u00e0 25 km voor naar een verrassende groene plek in de rand. Ideaal voor beginnende fietsers, gezellige babbels en ontmoetingen met andere Brusselse fietsers. \r\n\r\nOp 30 april fietsen we naar het kasteel en de rozentuin van het Colomadomein in Sint-Pieters-Leeuw\r\n\r\n    - We starten om 10u00 aan de Grand Hospice\r\n\r\n    - Tegen de middag komen we aan en drinken we samen iets. Aarzel niet een hapje als aperitief mee te nemen\r\n\r\n    - Ten laatste om 13u kan je met \u00e9\u00e9n van onze gidsen terug richting centrum fietsen\r\n\r\n    - Deelname gratis\r\n\r\nInschrijven via info@cactus.brussels (verplicht)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554970"},"en":{"name":"Dimanche \u00e0 v\u00e9lo | Colomadomein Sint-Pieters-Leeuw","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554970"},"de":{"name":"Dimanche \u00e0 v\u00e9lo | Colomadomein Sint-Pieters-Leeuw","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554970"},"it":{"name":"Dimanche \u00e0 v\u00e9lo | Colomadomein Sint-Pieters-Leeuw","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554970"},"sp":{"name":"Dimanche \u00e0 v\u00e9lo | Colomadomein Sint-Pieters-Leeuw","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.554970"},"pt":{"name":"Dimanche \u00e0 v\u00e9lo | Colomadomein Sint-Pieters-Leeuw","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.554970"},"cn":{"name":"Dimanche \u00e0 v\u00e9lo | Colomadomein Sint-Pieters-Leeuw","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.554970"}},"place":{"id":250146,"translations":{"fr":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":"D6","email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7\/D6","address_line2":"1000 Bruxelles","description_web":"Cactus Bruxelles \u00e0 v\u00e9lo est une association bruxelloise de guides b\u00e9n\u00e9voles locaux ayant \u00e0 coeur Bruxelles et le v\u00e9lo.\r\nIls partagent avec enthousiasme leur passion pour la ville et le v\u00e9lo avec les visiteurs de la ville et les autres Bruxellois. Ils offrent une exp\u00e9rience et une introduction authentique \u00e0 Bruxelles. A v\u00e9lo ils trouvent le rythme id\u00e9al pour vous immerger dans la ville et sa diversit\u00e9.\r\nAvant tout, ils pr\u00e9f\u00e8rent vous guider le long des chemins les moins battus de Bruxelles et cela dans une ambiance conviviale. D\u00e9couvrez Bruxelles pleinement et d\u00e9couvrez plus que vous ne le pensez \u00e0 v\u00e9lo !\r\nZaterdagtour","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":"D6","email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7\/D6","address_line2":"1000 Brussel","description_web":"Cactus Brussel \u00e0 v\u00e9lo is een Brusselse vereniging van lokale vrijwilligersgidsen met een hart voor Brussel en de fiets.\r\nHun passie voor de stad en de fiets delen ze met veel enthousiasme met bezoekers van de stad en andere Brusselaars. Ze bieden een authentieke ervaring en kennismaking met Brussel en vinden met de fiets het ideale ritme om je onder te dompelen in het veelzijdige Brussel. Liefst van al gidsen ze je langs de minder begane paden de stad in een gemoedelijke sfeer. Beleef Brussel ten volle met te fiets en ontdek meer dan je verwacht!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":"D6","email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7\/D6","address_line2":"1000 Brussels","description_web":"Cactus Brussels \u00e0 v\u00e9lo is an association of local guides with a heart for Brussels\r\nand the bicycle. During their guided bike tours, the guide-volunteers share their passion\r\nfor Brussels and the bicycle with both locals and visitors to the city. They offer an authentic\r\nexperience of Brussels and, thanks to the bicycle, they find the ideal rhythm to immerse you\r\nin this surprising capital. Their favorite way to surprise you is with an convivial bike tour\r\nalong the city's less beaten tracks. You can also choose from one of the various themed bike\r\ntours on offer or opt for a tour tailored to your group. The bike tours are ideal to integrate\r\ninto a teambuilding with your company or organization, to get inspired by the multifaceted\r\nBrussels or to discover the city with family and friends.\r\nExperience Brussels to the full by bike and discover more than you expect!\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":"D6","email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7\/D6","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Cact