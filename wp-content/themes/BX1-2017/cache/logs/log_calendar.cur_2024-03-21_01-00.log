alse,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-20T01:01:29+01:00","published_at":"2024-02-01T09:01:42+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":291278,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":1.0455159171494204,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Biennale of Women in Art - Edition Zero -  A SHOW OF RESISTANCE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/biennaleofwomeninart.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005563"},"pt":{"name":"Biennale of Women in Art - Edition Zero -  A SHOW OF RESISTANCE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/biennaleofwomeninart.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005563"},"en":{"name":"Biennale of Women in Art - Edition Zero -  A SHOW OF RESISTANCE","shortdescr":"The Biennale of Women in Art takes place from March 18 to 31, 2024. Over 13 days, the Biennial will feature an exhibition of 25 women artists and a series of meetings exploring the place of women in art. Edition zero, entitled A Show of Resistance, by Women in Art aims to be a showcase for contemporary women artists from all horizons, living and working in Belgium.","longdescr":"ONLY THE OPENING AND CLOSING ARE EVENTS PAY AS A DONATION\nTHE REST OF THE TWO WEEKS ARE FREE !\n_________________________________________________________________________________\nThe Biennale of Women In Art is COLLABORATIVE art event that aims to showcase the work of women artists\/, highlight their contributions to the history of art, and provide a space for dialogue and debate in order to demonstrate and gain recognition for their contributions to the art world today. The objective of the Biennale of Women in Art is to continue and amplify the movement, already initiated by various actors around the world, that contribute to establishing greater gender parity in art. The zero edition of the Biennale (prototype edition) will take place in Brussels in the Vanderborght space (50,rue de l'\u00c9cuyer 1000 Bruxelles), from the 18th of March, 2024 to the 31st of March, 2024, and will focus on Belgian artists (or artists living in Belgium). We will showcase 15 contemporary women artists, 10 performing artists.\nThe selection of the artists has been made by a double committee early 2023:\nThe scientific committee and the citizens committee.\nThe Biennale of Women in Art event is co-created with Belgian and international associations to present their work, workshops, conferences and artistic activities. Biennale themes are daily, and there are guided tours\/workshops for children aged 6 to 12.\n","performers":"The Biennale of Women in Art gives a voice to Belgian and international associations working on the theme of women and \"minority\" artists. Prom\u00e9th\u00e9a, XR4 heritage, Acegood, Art & Public, Bids Belgium, Lyse Vancampenhoudt, Jemima Kulumba, Anne Wetsi Mpoma, Els Goss\u00e9, will be among the free conferences\/panels\/workshops to discover!","boxoffice_url":null,"website":"http:\/\/biennaleofwomeninart.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005563"},"it":{"name":"Biennale of Women in Art - Edition Zero -  A SHOW OF RESISTANCE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/biennaleofwomeninart.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005563"},"cn":{"name":"Biennale of Women in Art - Edition Zero -  A SHOW OF RESISTANCE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/biennaleofwomeninart.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005563"},"fr":{"name":"Biennale of Women in Art - Edition Zero -  A SHOW OF RESISTANCE","shortdescr":"La Biennale of Women in Art a lieu du 18 au 31 mars 2024. Durant 13 jours, la Biennale proposera une exposition regroupant 25 artistes femmes ainsi qu\u2019une s\u00e9rie de rencontres explorant la place des femmes dans l\u2019art. L'Edition zero, intitul\u00e9e A Show of Resistance, par Women in Art souhaite \u00eatre une vitrine pour des femmes artistes contemporaines de tout horizon, vivant et travaillant en Belgique.","longdescr":"SEULS L'OUVERTURE ET LA CL\u00d4TURE SONT DES \u00c9V\u00c9NEMENTS PAYANTS\nLE RESTE DES DEUX SEMAINES EST GRATUIT ! \n_________________________________________________________________________________\nLa Biennale of Women In Art Edition Zero est un \u00e9v\u00e9nement artistique COLLABORATIF qui vise \u00e0 pr\u00e9senter le travail des femmes artistes\/artistes sous-repr\u00e9senter et \u00e0 souligner leurs contributions \u00e0 l'histoire de l'art et \u00e0 fournir un espace de dialogue et de d\u00e9bat afin de d\u00e9montrer et de faire reconna\u00eetre leurs contributions au monde de l'art d'aujourd'hui. L'objectif de la Biennale des femmes dans l'art est de poursuivre et d'amplifier le mouvement, d\u00e9j\u00e0 initi\u00e9 par divers acteurs \u00e0 travers le monde, qui contribuent \u00e0 \u00e9tablir une plus grande parit\u00e9 entre les hommes et les femmes dans l'art. L'\u00e9dition z\u00e9ro de la Biennale (\u00e9dition prototype) aura lieu \u00e0 Bruxelles dans l'espace Vanderborght (50,rue de l'\u00c9cuyer 1000 Bruxelles), du 18 mars 2024 au 31 mars 2024.","performers":"La Biennale of Women in Art donne la voix aux associations Belges et internationale travaillant sur la th\u00e9matique des artistes femmes et artistes \"minoritaires\". Prom\u00e9th\u00e9a, XR4 heritage, Acegood, Art & Public, Bids Belgium, Lyse Vancampenhoudt, Jemima Kulumba, Anne Wetsi Mpoma, Els Goss\u00e9, feront partie des conf\u00e9rences\/panels\/workshop gratuit \u00e0 d\u00e9couvrir !","boxoffice_url":null,"website":"http:\/\/biennaleofwomeninart.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005563"},"sp":{"name":"Biennale of Women in Art - Edition Zero -  A SHOW OF RESISTANCE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/biennaleofwomeninart.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005563"},"nl":{"name":"Biennale of Women in Art - Edition Zero -  A SHOW OF RESISTANCE","shortdescr":"De Biennale of women in art vindt plaats van 18 tot en met 31 maart 2024. Gedurende 13 dagen toont de Biennale een tentoonstelling van 25 kunstenaars en een reeks ontmoetingen over de plaats van vrouwen in de kunst. Editie nul, getiteld A Show of Resistance, van Women in Art wil een showcase zijn voor hedendaagse vrouwelijke kunstenaars van alle achtergronden, wonend en werkend in Belgi\u00eb.","longdescr":"ALLEEN VOOR DE OPENINGS- EN SLUITINGSCEREMONIE MOET BETAALD WORDEN\nDE REST VAN DE TWEE WEKEN ZIJN GRATIS! \n_________________________________________________________________________________\nDe Bi\u00ebnnale van Vrouwen in de Kunst Editie Zero is een COLLABORATIEF artistiek evenement dat tot doel heeft het werk van ondervertegenwoordigde vrouwelijke kunstenaars te presenteren en hun bijdragen aan de kunstgeschiedenis te belichten, en een ruimte te bieden voor dialoog en debat om hun bijdragen aan de kunstwereld van vandaag te demonstreren en erkenning te krijgen. Het doel van de Bi\u00ebnnale van de vrouw in de kunst is om de beweging voort te zetten en te versterken die al door verschillende spelers over de hele wereld in gang is gezet en die helpt om meer gelijkheid tussen mannen en vrouwen in de kunst tot stand te brengen. De nuleditie van de Bi\u00ebnnale (prototype-editie) vindt plaats in Brussel in de Espace Vanderborght (50, rue de l'\u00c9cuyer, 1000 Brussel), van 18 maart 2024 tot 31 maart 2024.","performers":"De Biennale van de Vrouw in de Kunst geeft een stem aan Belgische en internationale verenigingen die werken rond het thema van vrouwelijke en \"minderheids\"-kunstenaars. Prom\u00e9th\u00e9a, XR4 heritage, Acegood, Art & Public, Bids Belgium, Lyse Vancampenhoudt, Jemima Kulumba, Anne Wetsi Mpoma, Els Goss\u00e9, zullen deel uitmaken van de gratis te ontdekken conferenties\/panels\/workshops!","boxoffice_url":null,"website":"http:\/\/biennaleofwomeninart.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005563"}},"place":{"id":251380,"translations":{"de":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Brussels","description_web":"Owned by the City of Brussels, this building with a large shop window stands in the centre of Brussels, only a stone\u2019s throw from the Grand Place. It occupies an impressive 6,000 m\u00b2 of space spread over 5 stories.\n\nBuilt for the \u201cNouveaux \u00c9tablissements Vanderborght Fr\u00e8res\u201d, who traded in household products like carpets, knick-knacks, garden furniture, bedding, etc., the building was designed by architects Govaerts and Van Vaerenbergh, who were used to working together, having previously collaborated on the house of Alice and David van Buren, now the van Buren Museum. The building works, which began in 1932, were completed in 1935. Built in a modernist style, the building did away with ornamental elements, favouring function over appearance.\n\nWith remarkable large shop front windows that allow for greater visibility, each story is made up of one large concrete floorplan that can be easily modified thanks to a system of sliding partition walls on tracks. Other stand-out features of this building are its terraces, which served as exhibition spaces for the company\u2019s garden furniture back in the day, but also spots to relax and enjoy a cup of tea. The store went bankrupt in 1980.\n\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"Propri\u00e9t\u00e9 de la Ville de Bruxelles, cet \u00e9difice \u00e0 la large vitrine se dresse en plein centre de Bruxelles, \u00e0 deux pas des c\u00e9l\u00e8bres Galeries royales Saint-Hubert et \u00e0 peine plus loin de la Grand-Place. Il occupe un espace impressionnant de 6 000 m\u00e8tres carr\u00e9s de surface utile, r\u00e9partis sur 5 \u00e9tages.\n\nConstruit au profit des \u00ab Nouveaux \u00c9tablissements Vanderborght Fr\u00e8res \u00bb, n\u00e9goce en mobilier (tapis, bibelots, mobilier de jardin, literie, etc.), l\u2019\u00e9difice est con\u00e7u par un tandem habitu\u00e9 \u00e0 travailler ensemble : les architectes Govaerts et Van Vaerenbergh, auteurs \u00e9galement de la maison d\u2019Alice et David van Buren \u2014 actuel mus\u00e9e van Buuren. Le chantier, entam\u00e9 en 1932, prend fin en 1935. De style moderniste, la conception de l\u2019immeuble est d\u00e9nu\u00e9e de tout ornement et privil\u00e9gie la fonction.\n\nRemarquable par ses larges vitrines permettant une grande visibilit\u00e9, chaque \u00e9tage est constitu\u00e9 d\u2019un grand un plateau de b\u00e9ton modulable, gr\u00e2ce \u00e0 un syst\u00e8me de cloisons coulissantes sur rail. Le b\u00e2timent se distingue encore par ses terrasses, lieu d\u2019exposition des meubles de jardin mais aussi de d\u00e9tente \u2014 on peut y prendre un th\u00e9 \u00e0 l\u2019\u00e9poque ! Le magasin tombe en faillite en 1980.\n\n\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Vanderborghtgebouw","address_street_name":"Schildknaapsstraat","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Schildknaapsstraat, 50","address_line2":"1000 Brussel","description_web":"Dit gebouw, dat eigendom is van de stad Brussel, ligt in het hartje van Brussel, op een steenworp van de beroemde Koninklijke Sint-Hubertusgalerijen en de Grote Markt. Het neemt een indrukwekkende 6.000 vierkante meter vloeroppervlak in beslag, verdeeld over 5 verdiepingen.\n\nIndertijd gebouwd voor een meubelhandelaar (tapijten, snuisterijen, tuinmeubelen, beddengoed, enz.), \"Nouveaux \u00c9tablissements Vanderborght Fr\u00e8res\", werd het gebouw ontworpen door een team dat gewend was om samen te werken: architecten Govaerts en Van Vaerenbergh, de ontwerpers van het huis van Alice en David van Buren - nu het van Buuren Museum. De bouwwerkzaamheden, die in 1932 begonnen, eindigden in 1935. Eigen aan de modernistische stijl is het ontwerp van het gebouw verstoken van ornamenten en benadrukt het de functie.\n\nElke verdieping bestaat uit een groot modulair betonnen plateau, dankzij een systeem van verschuifbare scheidingswanden op rails, met opmerkelijk grote ramen die een hoge zichtbaarheid mogelijk maken. Het gebouw kenmerkt zich ook nog door zijn terrassen, de plek waar het tuinmeubilair werd tentoongesteld en waar men ook kon ontspannen (indertijd kon je daar thee drinken). De winkel ging in 1980 failliet.\n\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":13469,"location":{"lat":50.84878981,"lon":4.35576881},"region":"brussels","last_updated_at":"2024-03-08T12:09:35+01:00","published_at":"2013-10-19T01:37:09+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":277534,"translations":{"de":{"name":"Women In Art","address_street_name":"Rue du Fort","address_street_number":"78","address_street_box":null,"email":"jk@biennaleofwomeninart.com","website":"http:\/\/www.biennaleofwomeninart.com","phone_contact":"+32 476 02 49 70","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 78","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Women In Art