tact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003047"},"cn":{"name":"African Vibes, Benne Bayfall Band","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003047"},"fr":{"name":"African Vibes, Benne Bayfall Band","shortdescr":"\" Envie d'\u00e9t\u00e9 ? De rythmes africains ?\nLe son excitant des djemb\u00e9s,\nles voix graves, les moove africains ? \"","longdescr":"\" Envie d'\u00e9t\u00e9 ? De rythmes africains ?\nLe son excitant des djemb\u00e9s, les guitares,\nles voix sombres convaincantes,\nles moove africains ? \"\n\nLe groupe pr\u00e9sente ' Benne Bayfall ', un LIVE tr\u00e8s fort et authentique de bout en bout !\n\nFond\u00e9 au S\u00e9n\u00e9gal en 2011 et en Belgique apr\u00e8s de nombreuses tourn\u00e9es,\nils vous interpr\u00e9teront Worldfusion (Afro reggae, chanson, salsa, blues, jazz) dans diff\u00e9rentes langues et porteront un message de tol\u00e9rance et de joie de vivre. En phase avec l'actualit\u00e9 par leurs chansons \u00ab The World is on Fire\u00bb,\n\u00ab Smile \u00bb et \u00ab Libert\u00e9 \u00bb, ils combattent de mani\u00e8re solidaire les points chauds de notre monde.\n\n2 CD et plus de 300 repr\u00e9sentations \u00e0 leur actif, ils travaillent actuellement \u00e0 leur nouvel album\navec un line-up de Malines et des environs.\nPassionnant!","performers":"Musiciens : Voix et guitare Ismaila Ndoye,\nSaxo et claviers : Vincent Lichtvelde,\nBasse : Weissh Akabass,\nGuitare \u00e9lectrique : Raffaello Visconti\nDjembe, congas et dums : Max Kallista","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003047"},"sp":{"name":"African Vibes, Benne Bayfall Band","shortdescr":null,"longdescr":nul