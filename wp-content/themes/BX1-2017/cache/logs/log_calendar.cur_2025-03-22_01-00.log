:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005174"},"en":{"name":"L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005174"},"it":{"name":"L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005174"},"cn":{"name":"L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005174"},"fr":{"name":"L'h\u00f4tel Solvay","shortdescr":"De 1894 \u00e0 1898, Victor Horta construisit le plus prestigieux des h\u00f4tels de ma\u00eetre Art nouveau \u00e0 Bruxelles pour Armand Solvay, le fils du c\u00e9l\u00e8bre industriel Ernest Solvay. Construction majeure du ma\u00eetre de l'Art nouveau Victor Horta, il a la chance d'avoir conserv\u00e9 tous ses \u00e9l\u00e9ments d'origine : mobilier, luminaires, tentures et objets d'art de l'\u00e9poque.","longdescr":"\nClass\u00e9 au patrimoine mondial de l'UNESCO, c'est un \u00e9crin unique, o\u00f9 la notion d'art total prend tout son sens.\nCette visite exclusive vous permettra de d\u00e9couvrir l'enti\u00e8ret\u00e9 de l'h\u00f4tel de ma\u00eetre avec nos guides sp\u00e9cialis\u00e9s.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005174"},"sp":{"name":"L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005174"},"nl":{"name":"L'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005174"}},"place":{"id":261979,"translations":{"de":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architekt: Victor Horta - 1895\/1898\r\nDieses luxuri\u00f6se Anwesen wurde 1894 von Victor Horta f\u00fcr den Sohn des Unternehmers Ernest Solvay erbaut. Dem Architekten wurde vollkommen freie Hand gelassen und bei der bis ins kleinste Detail durchdachten Innenausstattung und dem Mobiliar \u00fcberlie\u00df er nichts dem Zufall. Die Fassade wird von zwei symmetrischen Erkern geziert, die sich \u00fcber zwei Etagen erstrecken. Dar\u00fcber befinden sich zwei Balkone. Im Interieur erwartet den Besucher ein optisches Feuerwerk. Die Farbpalette zwischen Rot- und Oranget\u00f6nen verst\u00e4rkt noch den Eindruck von Luxus und Komfort. Ein Besuch lohnt sich! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Solvay House","address_street_name":"Louizalaan","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Louizalaan, 224","address_line2":"1050 Ixelles","description_web":"Architect: Victor Horta - 1895\/1898 \r\nThis luxury townhouse was built by Victor Horta in 1894 for the son of captain of industry Ernest Solvay. The architect was given \u201ccarte blanche\u201d and designed the interior and the furniture down to the smallest detail. On the fa\u00e7ade, two symmetric bow windows surmounted by balconies are seen to protrude across two floors. Indoors it is a visual extravaganza, with the sheer range of red-orange hues on offer only acting to underpin the atmosphere of luxury and comfort. A must-see building. \r\n\r\nPlease note : Children under 12 years of age are not admitted to the guided tours.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architetto Victor Horta \u2013 1895 \/ 1898 \r\nQuesta lussuosa villa \u00e9 stata costruita da Victor Horta nel 1894 per il figlio dell\u2019industriale Ernest Solvay. L\u2019architetto ha ricevuto totale libert\u00e0 e ha concepito l\u2019interno e i mobili nei minimi dettagli. Sulla facciata, due \u201cbow-window\u201d simetriche si elevano su due piani e sono superate da balconi. Al interno, \u00e9 un fuoco d'artificio visivo. La gamma dei toni rossi \u2013 arrancione rinforza l\u2019atmosfera di lusso e di conforto. Da vedere assolutamente. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architecte: Victor Horta - 1895\/1898\nCette demeure luxueuse fut construite par Victor Horta en 1894 pour le fils de l\u2019industriel Ernest Solvay. L\u2019architecte re\u00e7ut \u201ccarte blanche\u201d et con\u00e7ut l\u2019int\u00e9rieur et le mobilier jusque dans les moindres d\u00e9tails. Sur la fa\u00e7ade, deux bow-windows sym\u00e9triques s\u2019\u00e9l\u00e8vent sur deux \u00e9tages et sont surmont\u00e9s de balcons. A l\u2019int\u00e9rieur, c\u2019est un feu d\u2019artifices visuel. La gamme des tons rouge-orange renforce l\u2019atmosph\u00e8re de luxe et de confort. A voir absolument.\n\nAchat des tickets uniquement en ligne.\n\nVisite guid\u00e9e sur demande \u00e0 l'adresse  info@hotelsolvay.be\n\nAttention : Les enfants de moins de 12 ans ne sont pas admis aux visites guid\u00e9es.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Arquitecto: Victor Horta - 1895\/1898\r\nEsta lujosa mansi\u00f3n fue construida por Victor Horta en 1894 para el hijo del empresario Ernest Solvay. El arquitecto recibi\u00f3 carta blanca y concibi\u00f3 el interior y el mobiliario hasta el \u00faltimo detalle. En la fachada, dos miradores sim\u00e9tricos se elevan sobre los dos pisos y los balcones. El interior es una maravilla visual. La gama de los tonos rojo-naranja refuerza la atm\u00f3sfera de lujo y de confort. Una visita imprescindible.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Solvay Herenhuis","address_street_name":"Louizalaan","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Louizalaan, 224","address_line2":"1050 Elsene","description_web":"Architect: Victor Horta - 1895\/1898\r\nVictor Horta bouwde dit luxueuze herenhuis in 1894 voor de zoon van de industrieel Ernest Solvay. De architect kreeg carte blanche voor dit project. Hij ontwierp het interieur en het meubilair tot in de kleinste details. Op de gevel lopen twee symmetrische erkers over twee verdiepingen, met daarboven balkons. Binnen wacht een visueel vuurwerk. Het palet van rood- en oranjetinten zet de sfeer van luxe en comfort nog sterker in de verf. Een bezoek meer dan waard.\r\n\r\nBelangrijke opmerking : Kinderen jonger dan 12 jaar mogen niet deelnemen aan rondleidingen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[6,5],"translations":{"de":["Chatelain\/Bailli","Flagey"],"pt":[null,null],"en":["Chatelain\/Bailli","Flagey"],"it":["Chatelain\/Bailli","Flagey"],"cn":[null,null],"fr":["Chatelain\/Bailli","Flagey"],"sp":["Ch\u00e2telain\/Bailli","Flagey"],"nl":["Kasteleinswijk\/Baljuw","Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":21979,"location":{"lat":50.8263727,"lon":4.3654832},"region":"brussels","last_updated_at":"2025-01-30T15:59:01+01:00","published_at":"2015-06-26T11:03:12+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36946,"location":{"lat":50.84145283,"lon":4.35976257},"last_updated_at":"2023-06-08T12:25:28+02:00","published_at":"2021-07-23T14:48:31+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/e011cfab37b1cb25301209dd4290dd0de972f3e2.jpg","width":4160,"height":3120,"ratio":1.33,"oEmbed_height":3120,"oEmbed_width":4160,"translations":{"de":{"title":"L'h\u00f4tel Solvay","copyright":null},"pt":{"title":"L'h\u00f4tel Solvay","copyright":null},"en":{"title":"L'h\u00f4tel Solvay","copyright":null},"it":{"title":"L'h\u00f4tel Solvay","copyright":null},"cn":{"title":"L'h\u00f4tel Solvay",