p\u00e9rience qu\u2019il a acquise en pr\u00e8s de 10 ann\u00e9es de spectacles de stand up dans les bars, th\u00e9\u00e2tres et caves de Belgique, de France et du Canada.\r\n\r\nAttitude est un spectacle dr\u00f4le et aussi po\u00e9tique, c\u2019est un one man show assist\u00e9 par un \u00e9poustouflant jeu de lumi\u00e8res, de sons et de projections, c\u2019est donc un spectacle unique \u00e0 d\u00e9couvrir au Th\u00e9\u00e2tre de la Fl\u00fbte Enchant\u00e9e.\r\n\r\nPrix: 15\u20ac\r\nInfos et r\u00e9servations: http:\/\/lafluteenchantee.be\/attitude\/","performers":"One man show \u00e9crit, mis en sc\u00e8ne et interpr\u00e9t\u00e9 par Talip Saritas","boxoffice_url":null,"website":"http:\/\/www.lafluteenchantee.be","email":"la.flute.enchantee@skynet.be","phone_contact":null,"phone_booking":"+32 2 660 79 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539540"},"nl":{"name":"Attitude","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539540"},"en":{"name":"Attitude","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539540"},"de":{"name":"Attitude","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539540"},"it":{"name":"Attitude","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539540"},"sp":{"name":"Attitude","shortdescr":null,"longdescr":null,"performers":null,"boxoffic