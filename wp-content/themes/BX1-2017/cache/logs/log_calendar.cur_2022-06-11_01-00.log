bed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/VHGK9fhlJJU\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/VHGK9fhlJJU?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Visite Bruxelles, Grand-Place, maison de l'Etoile ... myst\u00e9rieuse !"},"nl":{"title":"Visite Bruxelles, Grand-Place, maison de l'Etoile ... myst\u00e9rieuse !"},"en":{"title":"Visite Bruxelles, Grand-Place, maison de l'Etoile ... myst\u00e9rieuse !"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/2dd6709ebce4fd489253833edb3fd5bfea127834.jpg","width":1080,"height":1920,"ratio":0.56,"translations":{"fr":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null},"nl":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null},"en":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/42168541d0f3898624bd2d00f8baa1f4563c5c1c.jpg","width":1441,"height":1080,"ratio":1.33,"translations":{"fr":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null},"nl":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null},"en":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null}}}],"dates":[{"day":"2022-05-22","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-07-03","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-08-28","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-23T01:07:19+02:00","published_at":"2022-03-03T11:57:25+01:00","backoffice_id":248907,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":531861,"date_start":"2022-06-05","date_end":"2022-09-04","date_next":"2022-07-03","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"A Table !","shortdescr":"Au d\u00e9but du spectacle, le menu est annonc\u00e9 aux spectateurs et aux com\u00e9diens qui n\u2019en ont pas connaissance. Qui seront les personnages r\u00e9unis autour de la table ? \u00c0 quelle occasion seront-ils r\u00e9unis ? C\u2019est \u00e0 vous de d\u00e9cider !\r\nD\u00e9marrant de cette impulsion du public et sans concertation ni canevas, les com\u00e9diens vont improviser une vraie sc\u00e8ne de repas pendant 1h15.","longdescr":"Les estomacs se remplissent, les langues se d\u00e9lient.\r\n\r\nC\u2019est \u00e0 un repas bien r\u00e9el auquel va assister le public.\r\nAu d\u00e9but du spectacle, le menu est annonc\u00e9 aux spectateurs et aux com\u00e9diens qui n\u2019en ont pas connaissance. Qui seront les personnages r\u00e9unis autour de la table ? \u00c0 quelle occasion seront-ils r\u00e9unis ? Un repas d\u2019affaire, un d\u00eener de Saint Valentin, un festin de retrouvailles d\u2019amis d\u2019enfance, un pique-nique en famille...\r\nC\u2019est aux spectateurs de proposer.\r\nD\u00e9marrant de cette impulsion du public et sans concertation ni canevas, les com\u00e9diens vont improviser une sc\u00e8ne de repas pendant 1h15.\r\n\u00c0 partir d\u2019une situation toute simple que tout le monde a d\u00e9j\u00e0 v\u00e9cu, les com\u00e9diens vont cr\u00e9er une v\u00e9ritable histoire pouvant, selon les soir\u00e9es, aller d\u2019une com\u00e9die haute en couleur, \u00e0 un drame poignant en passant par un thriller haletant.\r\n__________________________________________\r\nChaque saison, gr\u00e2ce \u00e0 la g\u00e9n\u00e9rosit\u00e9 des com\u00e9diens jouant b\u00e9n\u00e9volement ce spectacle, la moiti\u00e9 des recettes de ce spectacle permet de soutenir une association. Cette ann\u00e9e, il s\u2019agit de l\u2019ASBL forestoise \"A.P.R.E.S. ASBL\" qui se consacre \u00e0 la r\u00e9insertion socio-professionnelle des ex-d\u00e9tenu.e.s.\r\nPlus d\u2019infos : www.apresasbl.be\r\nEn venant assister \u00e0 ce spectacle, vous faites donc \u00e9galement une bonne action !","performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/A-Table.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531861.html"},"nl":{"name":"A Table !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531861.html"},"en":{"name":"A Table !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531861.html"},"de":{"name":"A Table !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_conta