e de maximum 10 personnes.\r\n\r\n1\u00e8re S\u00e9ance d\u00e9couverte OFFERTE. Gratuit pour les membres F\u00e9MA.\r\n\r\nToutes les mesures de protection et de s\u00e9curit\u00e9 seront prises, selon les r\u00e8gles en vigueur :\u00a0 le Covid Safe Ticket est obligatoire pour les participants et encadrants.","performers":"Anne Sophie Dubus","boxoffice_url":null,"website":"https:\/\/www.sportadapte.be\/activites\/handidanse-cours2021\/","email":"sensibilisation@sportadapte.be","phone_contact":"+32 81 77 78 16","phone_booking":"+32 81 77 78 16","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/527084.html"},"nl":{"name":"Cours Handidanse pour adultes en situation de d\u00e9ficience intellectuelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/527084.html"},"en":{"name":"Cours Handidanse pour adultes en situation de d\u00e9ficience intellectuelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/527084.html"},"de":{"name":"Cours Handidanse pour adultes en situation de d\u00e9ficience intellectuelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/527084.html"},"it":{"name":"Cours Handidanse pour adultes en situation de d\u00e9ficience intellectuelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/527084.html"},"sp":{"name":"Cours Handidanse pour adultes en situation de d\u00e9ficience intellectuelle","shortdescr":null,"longdescr":null,"performers":null,"box