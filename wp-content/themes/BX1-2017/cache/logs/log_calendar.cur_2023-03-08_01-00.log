":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-10T17:35:09+01:00","published_at":"2022-08-23T14:41:43+02:00","backoffice_id":260179,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.13891966352112},{"id":550854,"date_start":"2023-03-23","date_end":"2023-03-23","date_next":"2023-03-23","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La plus pr\u00e9cieuse des marchandises","shortdescr":"Jeanne Kacenelenbogen s\u2019empare sans fausse na\u00efvet\u00e9 de ce conte pour adultes qui raconte, tout en pointill\u00e9s, l\u2019horreur des camps et de la Shoah. Une forme narrative particuli\u00e8re qui laisse une empreinte d\u2019autant plus forte.","longdescr":"Il \u00e9tait une fois dans un grand bois, un couple de b\u00fbcherons sans enfant. La faim y r\u00e9gnait toute l\u2019ann\u00e9e, et la Seconde Guerre mondiale s\u00e9vissait tout autour. Chaque jour, la b\u00fbcheronne voyait passer un train, ignorant ce qu\u2019il transportait. Elle esp\u00e9rait qu\u2019un jour, quelque chose de merveilleux lui arriverait de ce train. Elle est exauc\u00e9e le jour o\u00f9 elle ramasse un paquet balanc\u00e9 du wagon, une petite fille de la tribu des \u00ab sans-c\u0153ur \u00bb, de ceux qui \u00ab voyagent gratos en trains sp\u00e9ciaux \u00bb. L\u2019enfant deviendra pour le couple, \u00ab la plus pr\u00e9cieuse des marchandises \u00bb.","performers":"De : Jean-Claude Grumberg \r\nAvec : Jeanne Kacenelenbogen \r\nMise en sc\u00e8ne : Janine Godinas","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550854"},"nl":{"name":"La plus pr\u00e9cieuse des marchandises","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550854"},"en":{"name":"La plus pr\u00e9cieuse des marchandises","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550854"},"de":{"name":"La plus pr\u00e9cieuse des marchandises","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550854"},"it":{"name":"La plus pr\u00e9cieuse des marchandises","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":null,"phone_contact":null,"