52:23+01:00","published_at":"2025-02-07T16:35:54+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317856,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"tour","ranking":0.7937005259840998,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Joseph Marien Stadium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006373"},"pt":{"name":"BANAD Festival - Guided tour of the Joseph Marien Stadium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006373"},"en":{"name":"BANAD Festival - Joseph Marien Stadium","shortdescr":null,"longdescr":"From its foundation in 1919, the Royale Union Saint-Gilloise football club played its matches and trained on an open-air pitch in the Duden Park. In 1921, it decided to build an enclosed stadium for its increasing number of spectators. A design by the architect Albert Callewaert for a stadium with a capacity of 35,000 was accepted in 1922. The imposing main fa\u00e7ade, of artificial white stone and red bricks, with white stone decorations, was built in a mere four months. The main stand seats 2,500 spectators and is covered with a rivetted metal roof. Under the stand there are changing rooms and showers and a caf\u00e9 and members' room with its original Art Deco stained-glass window in the club's colours. \n\nArch. Albert CALLEWAERT, 1926","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006373"},"it":{"name":"BANAD Festival - Guided tour of the Joseph Marien Stadium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006373"},"cn":{"name":"BANAD Festival - Guided tour of the Joseph Marien Stadium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006373"},"fr":{"name":"BANAD Festival - Stade Joseph Marien","shortdescr":null,"longdescr":"Si la Royale Union Saint-Gilloise occupe d\u00e9j\u00e0 une partie du Parc Duden pour ses matchs et entrainements depuis 1919, ce n'est qu'en 1921 \u00e9voque un agrandissement du stade. Le Projet de l'architecte Albert Callewaert est adopt\u00e9 en 1922. Il porte la capacit\u00e9 du stade pr\u00e9existant \u00e0 35 000 spectateurs et l'\u00e9dification d'une nouvelle tribune plus vaste. La fa\u00e7ade en simili-pierre blanche et briques rouges rehauss\u00e9es de pierre blanche frappe par sa prestance et sera construite en 4 mois. La tribune principale, comptant environ 2500 places est couverte d'une charpente m\u00e9tallique rivet\u00e9e. Sous la tribune, outre les vestiaires et les douches, on retrouve un caf\u00e9 et une salle des membres qui a conserv\u00e9 un vitrail d\u00e9coratif Art d\u00e9co aux couleurs du club Saint-Gillois.\n\nArch. Albert CALLEWAERT, 1926","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006373"},"sp":{"name":"BANAD Festival - Guided tour of the Joseph Marien Stadium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006373"},"nl":{"name":"BANAD Festival - Joseph Mari\u00ebn Stadion","shortdescr":null,"longdescr":"Hoewel Union Sint-Gillis al sinds 1919 een deel van het Dudenpark gebruikt voor wedstrijden en trainingen, wordt pas in 1921 melding gemaakt van een uitbreiding van het stadion. Het plan van architect Albert Callewaert wordt goedgekeurd in 1922. Het verhoogt de capaciteit van het bestaande stadion tot 35.000 toeschouwers en voorziet een nieuwe, grotere tribune. De gevel in een imitatie van witte steen en rode baksteen met hier en daar witte steen wordt in 4 maanden tijd opgetrokken en maakt grote indruk. De hoofdtribune met ongeveer 2500 zitplaatsen wordt overkapt met een geklonken metalen constructie. Onder de tribune bevindt zich, naast de kleedkamers en douches, een caf\u00e9 en een ledenkamer met een decoratief glas-in-loodraam in art-decostijl en de kleuren van de club.\n\nArch. Albert CALLEWAERT, 1926","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006373"}},"place":{"id":50002895,"translations":{"de":{"name":"Stade Joseph Marien","address_street_name":"Chauss\u00e9e de Bruxelles","address_street_number":"223","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Chauss\u00e9e de Bruxelles, 223","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Stade Joseph Marien","address_street_name":"Chauss\u00e9e de Bruxelles","address_street_number":"223","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Chauss\u00e9e de Bruxelles, 223","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Stade Joseph Marien","address_street_name":"Chauss\u00e9e de Bruxelles","address_street_number":"223","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Chauss\u00e9e de Bruxelles, 223","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Stade Joseph Marien","address_street_name":"Chauss\u00e9e de Bruxelles","address_street_number":"223","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Chauss\u00e9e d