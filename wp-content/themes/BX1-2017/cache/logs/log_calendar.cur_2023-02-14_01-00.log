 Health Safety Label"],"pt":[null,null,null,null,null,null,null,null,null],"cn":[null,null,null,null,null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-10T16:37:10+01:00","published_at":"2023-01-30T17:26:21+01:00","backoffice_id":270581,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.24807684691734},{"id":543832,"date_start":"2022-10-21","date_end":"2023-06-16","date_next":"2023-02-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"],"it":["Cabaret"],"sp":["Caf\u00e9 teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les Zap\u00e9ro-contes","shortdescr":"Une soir\u00e9e pour d\u00e9couvrir que le conte est bien moins destin\u00e9 \u00e0 endormir les enfants qu'\u00e0 r\u00e9veiller les adultes. Neuf conteuses et conteurs se partagent la sc\u00e8ne pour vous raconter des histoires surprenantes, \u00e9mouvantes, passionnantes et souvent pleine d'humour dans un lieu art nouveau totalement hallucinant.","longdescr":"Osez le conte pour adultes ! \r\nChaque troisi\u00e8me vendredi du mois de 20h \u00e0 22h30, on vous raconte des histoires dr\u00f4les, \u00e9tonnantes, d\u00e9lirantes, \u00e9mouvantes, destin\u00e9es \u00e0 un public adulte.  Depuis douze ans, la sc\u00e8ne ouverte \"Les Zap\u00e9ro-contes\" accueille \u00e0 Bruxelles des conteurs de toute la Belgique et parfois aussi de France. Organis\u00e9es par l'Asbl Racontance, ces sc\u00e8nes ouvertes ont pour objectif de vous faire d\u00e9couvrir l'immense richesse de l'univers du conte (traditionnel, philosophique, fantastique, humoristique\u2026et m\u00eame parfois coquin) tout en battant en br\u00e8che le clich\u00e9 r\u00e9ducteur qui veut que celui-ci soit destin\u00e9 aux seuls enfants. La soir\u00e9e est anim\u00e9e par Dominique Brynaert, conteur et ancien journaliste t\u00e9l\u00e9. \r\nCes soir\u00e9es se d\u00e9roulent d\u00e9sormais dans le fantastique d\u00e9cor Art Nouveau d\u2019une maison et brasserie mythique de Bruxelles : De Ultieme Hallucinatie, r\u00e9cemment restaur\u00e9e par une \u00e9quipe passionn\u00e9e de patrimoine et de culture. \r\nL'entr\u00e9e est libre (participation au chapeau en solidarit\u00e9 avec les artistes) afin de vous faire d\u00e9couvrir cette discipline artistique et offrir la culture \u00e0 toutes les bourses.  Vu le succ\u00e8s habituel, les r\u00e9servations sont fortement recommand\u00e9es via le site de Racontance : www.racontance.be ou par mail : racontance@hotmail.com\r\nPossibilit\u00e9s de repas sur place avant spectacle.","performers":"9 conteuses et conteurs en sc\u00e8ne partag\u00e9e","boxoffice_url":null,"website":"http:\/\/www.racontance.be","email":"racontance@hotmail.com","phone_contact":"+32 477 91 04 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543832"},"nl":{"name":"Les Zap\u00e9ro-contes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.racontance.be","email":"racontance@hotmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543832"},"en":{"name":"Les Zap\u00e9ro-contes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.racontance.be","email":"racontance@hotmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.bruss