"child_events":[],"parent_events":[],"accessibilities":{"list":[255],"translations":{"de":["Barrierefrei"],"pt":[null],"en":["Accessible"],"it":["Accessibile"],"cn":[null],"fr":["Accessible"],"sp":["Habilitado"],"nl":["Toegankelijk"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700006453,"date_start":"2025-03-29","date_end":"2025-03-30","date_next":"2025-03-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-10T15:52:17+01:00","published_at":"2025-02-10T14:37:51+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317980,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Autrique House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006453"},"pt":{"name":"BANAD Festival - Guided tour of the Autrique House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006453"},"en":{"name":"BANAD Festival - Autrique House","shortdescr":"Designed and built by Victor Horta in 1893, the Autrique House heralds the arrival of the Art Nouveau style by its structual and decorative innovations. It underwent an exemplary restoration and now houses a scenography designed by Fran\u00e7ois Schuiten and Beno\u00eet Peeters. The house hosts the exhibtion \"Ateliers disparus. En leurs maisons les artisans\".\n\nArch. Victor HORTA, 1993","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006453"},"it":{"name":"BANAD Festival - Guided tour of the Autrique House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006453"},"cn":{"name":"BANAD Festival - Guided tour of the Autrique House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006453"},"fr":{"name":"BANAD Festival - Maison Autrique","shortdescr":"Construite par Victor Horta en 1893, la maison Autrique annonce l'Art nouveau par ses innovations structurelles et d\u00e9coratives. Elle a fait l'objet d'une restauration exemplaire et b\u00e9n\u00e9ficie d'une sc\u00e9nographie de Fran\u00e7ois Schuiten et Beno\u00eet Peeters. La maison accueille l'exposition \" Ateliers disparus. En leurs maisons les artisans \".\n\nArch. Victor HORTA, 1993","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006453"},"sp":{"name":"BANAD Festival - Guided tour of the Autrique House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006453"},"nl":{"name":"BANAD Festival - Autrique Huis","shortdescr":"Victor Horta bouwde het Autriquehuis in 1893. Het kondigde de art nouveau aan met zijn structurele en decoratieve vernieuwingen. Het huis werd prachtig gerestaureerd en verrijkt met een scenografie van Fran\u00e7ois Schuiten en Beno\u00eet Peeters. Op dit moment presenteert het Autriquehuis de tentoonstelling \"Ateliers disparus. En leurs maisons les artisans\".\nArch. Victor HORTA, 1993","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006453"}},"place":{"id":241931,"translations":{"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Autrique House","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaarbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":4383,"location":{"lat":50.8632575,"lon":4.3731694},"region":"brussels","last_updated_at":"2024-09-10T13:09:05+02:00","published_at":"2013-10-19T01:17:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":267246,"translations":{"de":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels ist ein Zusammenschluss von Vereinen, die qualitativ hochwertige Stadtf\u00fchrungen in der Region Br\u00fcssel-Hauptstadt organisieren.\r\nDie Mitgliedsvereine sind ARAU, Pro Velo, Brussels Chatterguides und Arkadia. Im Jahr 2020 hat sich La Fonderie als Partnerverein angeschlossen.\r\nEntdecken Sie das UNESCO-Weltkulturerbe, Jugendstilarchitektur, die Bauwerke von Victoria Horta, Gem\u00e4lde von Magritte, Comic-Kunst von Herg\u00e9, Streetart, Europa, Bier, Schokolade oder besichtigen Sie architektonische Perlen des Jugendstils, des Art-d\u00e9co oder des Neoklassizismus, die normalerweise nicht f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich sind. Die F\u00fchrungen werden sowohl f\u00fcr Einzelbesucher als auch f\u00fcr Gruppen angeboten und reichen von klassischen \u00fcber originelle bis hin zu vollkommen neuen Konzepten und Formaten. Neben Stadtf\u00fchrungen zu Fu\u00df sind auch Besichtigungen per Fahrrad, Bus oder Boot m\u00f6glich.\r\nExplore.Brussels organisiert unter anderem auch das Jugendstil- und Art-d\u00e9co-Festival BANAD, die Brussels Biennale - Neoclassic (BBN) sowie weitere Projekte, darunter die Ausbildung von Stadtf\u00fchrern, der \u201eVerein der Freunde\u201c und der \u201eVerein der Eigent\u00fcmer\u201c. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of guided tour associations in Brussels. This organisation includes ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie and Korei. Events are organised in co-production with these 6 companies. Individual or group tours are available on foot, by bike, by bus and by boat.  Visitors discover UNESCO heritage, Magritte, art deco, chocolate and much more. Explore.Brussels also organises Brussels festivals and other large-scale projects.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels est un r\u00e9seau d'associations de visites guid\u00e9es \u00e0 Bruxelles. Cet organisme regroupe notamment ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie et Korei. les \u00e9v\u00e9nements sont organis\u00e9s en coproduction avec ces 6 entreprises  Les visites individuelles ou en groupe sont disponibles \u00e0 pied, \u00e0 v\u00e9lo, en car et en bateau.  Les visiteurs partent \u00e0 la d\u00e9couverte du patrimoine de l'UNESCO, de Magritte, de l'art d\u00e9co, du chocolat et bien plus encore. Explore.Brussels organise \u00e9galement des festivals bruxellois et d'autres projets de grande envergure.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Explore.brussels ","address_street_name":"Brugmannlaan","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Brugmannlaan, 405","address_line2":"1180 Ukkel","description_web":"Explore.Brussels is een netwerk van verenigingen voor geleide bezoeken in Brussel. Deze organisatie omvat ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie en Korei. De evenementen worden georganiseerd in coproductie met deze 6 bedrijven. Individuele of groepstochten zijn mogelijk te voet, per fiets, per bus en per boot.  Bezoekers ontdekken UNESCO erfgoed, Magritte, art deco, chocolade en nog veel meer. Explore.Brussels organiseert ook Brusselse festivals en andere grootschalige projecten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":27246,"location":{"lat":50.80795462,"lon":4.34397082},"last_updated_at":"2024-05-29T15:24:29+02:00","published_at":"2017-02-27T10:05:49+01:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/5502f0073bec316169f0fb561254f915644b9afc.jpg","width":667,"height":1000,"ratio":0.67,"oEmbed_height":1000,"oEmbed_width":667,"translations":{"de":{"title":"Maison Autrique","copyright":"\u00a9EB- Sophie Voituron"},"pt":{"title":"Maison Autrique","copyright":"\u00a9EB- Sophie Voituron"},"en":{"title":"Maison Autrique","copyright":"\u00a9EB- Sophie Voituron"},"it":{"title":"Maison Autrique","copyright":"\u00a9EB- Sophie Voituron"},"cn":{"title":"Maison Autrique","copyright":"\u00a9EB- Sophie Voituron"},"fr":{"title":"Maison Autrique","copyright":"\u00a9EB- Sophie Voituron"},"sp":{"title":"Maison Autrique","copyright":"\u00a9EB- Sophie Voituron"},"nl":{"title":"Maison Autrique","copyright":"\u00a9EB- Sophie Voituron"}}}],"dates":[{"day":"2025-03-29","doors":"10:00:00","start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-03-30","doors":"10:00:00","start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Kinder"},"en":{"name":"Children"},"it":{"name":"Bambini"},"fr":{"name":"Enfants"},"sp":{"name":"Ni\u00f1os"},"nl":{"name":"Kinderen"}},"value":0},{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":13},{"translations":{"de":{"name":"Studierende"},"en":{"name":"Students"},"it":{"name":"Studenti"},"fr":{"name":"Etudiants"},"sp":{"name":"Estudiantes"},"nl":{"name":"Studenten"}},"value":6.5},{"translations":{"de":{"name":"Article 27"},"pt":{"name":"Article 27"},"en":{"name":"Article 27"},"it":{"name":"Article 27"},"cn":{"name":"Article 27"},"fr":{"name":"Article 27"},"sp":{"name":"Article 27"},"nl":{"name":"Artikel 27"}},"value":1.25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700006433,"date_start":"2025-03-29","date_end":"2025-03-30","date_next":"2025-03-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-10T15:52:17+01:00","published_at":"2025-02-10T12:34:52+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317960,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Van Eetvelde House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006433"},"pt":{"name":"BANAD Festival - Guided tour of the Van Eetvelde House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006433"},"en":{"name":"BANAD Festival - Van Eetvelde House","shortdescr":null,"longdescr":"Built between 1895 and 1897 for Edmond van Eetvelde, advisor to King Leopold II and General Secretary of the Congo Free State, this masterpiece by Victor Horta has at its centre a lightwell with a splendid stained-glass dome with delicate metal supports. Extended more than once, the resulting ensemble reflects the evolution of Victor Horta's style. The precious materials from Congo call to mind the historical ties between colonization and Art Nouveau, at one point referred to with the term \"Congo style\". On the occasion of the year of Art Nouveau in 2023, the Art Nouveau Laboratory acquired accommodation in the van Eetvelde buildings, and the glass canopy was restored. Thus, it is the moment to rediscover this Art Nouveau jewel, a UNESCO World Heritage Site.\n\nArch. Victor HORTA, 1895\/1899\/1901","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006433"},"it":{"name":"BANAD Festival - Guided tour of the Van Eetvelde House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006433"},"cn":{"name":"BANAD Festival - Guided tour of the Van Eetvelde House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006433"},"fr":{"name":"BANAD Festival - H\u00f4tel van Eetvelde","shortdescr":null,"longdescr":"Construit entre 1895 et 1897 pour Edmond van Eetvelde, conseiller de L\u00e9opold II, secr\u00e9taire g\u00e9n\u00e9ral de l'\u00c9tat ind\u00e9pendant du Congo, ce chef-d'\u0153uvre de Victor Horta s'articule autour d'un puits de lumi\u00e8re d\u00e9cor\u00e9 d'une splendide verri\u00e8re \u00e0 la d\u00e9licate structure m\u00e9tallique. Agrandi \u00e0 plusieurs reprises, cet h\u00f4tel de ma\u00eetre et ses extensions, r\u00e9sument l'\u00e9volution du style de Victor Horta.\n\nArch. Victor HORTA, 1895\/1899\/1901","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006433"},"sp":{"name":"BANAD Festival - Guided tour of the Van Eetvelde House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006433"},"nl":{"name":"BANAD Festival - Van Eetvelde Herenhuis","shortdescr":null,"longdescr":"Dit meesterwerk van Victor Horta werd tussen 1895 en 1897 gebouwd voor Edmond van Eetvelde, adviseur van Leopold II, secretaris-generaal van de Onafhankelijke Congostaat. Het ligt rond een lichtschacht getooid met een schitterende glazen overkapping met een delicate metalen structuur. Dit herenhuis en de bijgebouwen vatten de evolutie van Victor Horta's stijl perfect samen. Dit verschillende keren verruimd herenhuis en zijn bijgebouwen vatten de evolutie van Victor Horta's stijl perfect samen.\n\nArch. Victor HORTA, 1895\/1899\/1901","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006433"}},"place":{"id":242040,"translations":{"de":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":"Das Maison van Eetvelde ist ein bemerkenswertes Jugendstilbauwerk aus der Feder von Victor Horta, das 1895-1898 im Auftrag des Diplomaten Edmond Van Eetvelde erbaut wurde. Das Geb\u00e4ude z\u00e4hlt zum UNESCO-Weltkulturerbe.\r\n\r\nDas Geb\u00e4ude wurde 1895 von Edmond Van Eetvelde, seinerzeit Diplomat und Generalsekret\u00e4r im Kongo, in Auftrag gegeben. Sehenswert sind die Eisentr\u00e4ger aus Flacheisen (wie im Industriebereich) statt aus Schmiedeeisen, die Mosaike, der glas\u00fcberdachte Innenhof und die Blumenmotive des Esszimmers.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Palmerstonlaan","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Palmerstonlaan, 2","address_line2":"1000 Brussels","description_web":"Created in 2023 to celebrate the 130th anniversary of the birth of Art Nouveau in Brussels, the LAB\u00b7AN (Laboratory Art Nouveau) aims to enhance and promote this unique style and the general and specific themes associated with it. Through its exhibitions and activities, it takes a contemporary look at this Belgian, Brussels and international cultural heritage.\nLAB\u00b7AN is located in the van Eetvelde building, one of Victor Horta's finest creations and a UNESCO World Heritage Site. The opening of LAB\u00b7AN in this extraordinary building makes the Hotel van Eetvelde, a jewel of Brussels Art Nouveau, accessible to the general public 3 days a week.\nThe LAB\u00b7AN x H\u00f4tel van Eetvelde project is managed by the non-profit organisation Patrimoine & Culture, which is also responsible for managing the Halles Saint-G\u00e9ry.\n","description_print":"According to Horta himself, the plans for this house, conceived in 1895, were the most audacious he ever drew. And he did so for a prominent figure, as the client, Baron Edmond van Eetvelde, was the Secretary General of the Independent State of Congo - in reality the unofficial 'Minister of the Congo' - and, therefore, a very close ally of King Leopold II. \n\nThe future owner asked the architect for a house 'for his family', but with as large a living room and dining room as possible, given his frequent social engagements. \n\nThe house is unusual in that it is flanked by two other buildings: a building to the left of it, which was intended to serve both as an extension to the original house and as a rental house and a building to the right of it, a small annex to the main house. ","booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=EN","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Hotel van Eetvelde & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":"Cr\u00e9\u00e9 en 2023 pour c\u00e9l\u00e9brer le 130e anniversaire de la naissance de l'Art nouveau \u00e0 Bruxelles, le LAB\u00b7AN (Laboratoire Art nouveau) a pour mission de valoriser et de promouvoir ce style unique et les th\u00e8mes g\u00e9n\u00e9raux et sp\u00e9cifiques qui lui sont associ\u00e9s. \u00c0 travers les expositions et activit\u00e9s qu'il propose, il pose un regard contemporain sur cet h\u00e9ritage culturel belge, bruxellois et international. \nLe LAB\u00b7AN est situ\u00e9 au sein du b\u00e2timent van Eetvelde, l\u2019une des plus belles cr\u00e9ations de Victor Horta, class\u00e9e au patrimoine mondial de l\u2019UNESCO. L\u2019ouverture du LAB\u00b7AN dans ce b\u00e2timent extraordinaire rend l\u2019H\u00f4tel van Eetvelde, joyau de l\u2019Art nouveau bruxellois, accessible au grand public 3 jours par semaine.\nLe projet LAB\u00b7AN x H\u00f4tel van Eetvelde est g\u00e9r\u00e9 par l\u2019asbl Patrimoine & Culture, \u00e9galement responsable des Halles Saint-G\u00e9ry.\n","description_print":"28\/10\/24 Selon les dires de Horta lui-m\u00eame, le plan de cette maison, con\u00e7u en 1895, est le plus audacieux qu\u2019il ait dessin\u00e9\u2026 Et c\u2019est encore au profit d\u2019une personnalit\u00e9 qu\u2019il le fait, puisque le commanditaire, le baron Edmond van Eetvelde, est le secr\u00e9taire g\u00e9n\u00e9ral de l\u2019\u00c9tat ind\u00e9pendant du Congo \u2014 dans les faits v\u00e9ritable \u00ab ministre du Congo \u00bb \u2014, et donc un tr\u00e8s proche collaborateur du roi L\u00e9opold II. \n\nLe futur propri\u00e9taire r\u00e9clame \u00e0 l\u2019architecte une maison \u00ab pour sa famille \u00bb, mais comportant, au vu de ses obligations mondaines, un salon et une salle \u00e0 manger aussi grands que possible. \n\nLa maison offre la particularit\u00e9 d\u2019\u00eatre flanqu\u00e9e de deux autres \u00e9difices, de part et d\u2019autre : un immeuble \u00e0 sa gauche, devant \u00e0 la fois servir d\u2019agrandissement \u00e0 la maison initiale et de maison de location ; un b\u00e2timent \u00e0 sa droite, petite annexe \u00e0 l\u2019habitation principale. ","booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=FR","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Van Eetvelde Hotel & LAB\u00b7An","address_street_name":"Avenue Palmerston","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Van Eetveldehotel & LAB\u00b7An","address_street_name":"Palmerstonlaan","address_street_number":"2","address_street_box":null,"email":"team@lab-an.be","website":"https:\/\/www.lab-an.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Palmerstonlaan, 2","address_line2":"1000 Brussel","description_web":"Het LAB\u00b7AN (Laboratorium art nouveau) werd opgericht in 2023 om de 130ste verjaardag van de geboorte van de art nouveau in Brussel te vieren en heeft als doel deze unieke stijl en de algemene en specifieke thema's die ermee verbonden zijn, te valoriseren en te promoten. Door middel van tentoonstellingen en activiteiten biedt het een hedendaagse kijk op dit Belgische, Brusselse en internationale culturele erfgoed.\nLAB\u00b7AN is gevestigd in het van Eetvelde gebouw, een van de mooiste creaties van Victor Horta en UNESCO-werelderfgoed. De opening van LAB\u00b7AN in dit buitengewone gebouw maakt het Hotel van Eetvelde, een juweel van de Brusselse art nouveau, 3 dagen per week toegankelijk voor het grote publiek.\nHet project LAB\u00b7AN x H\u00f4tel van Eetvelde wordt beheerd door de vzw Patrimoine & Culture, die ook verantwoordelijk is voor het beheer van de Halles Saint-G\u00e9ry.\n","description_print":"Volgens Victor Horta zelf was het plan voor dit huis in 1895 het meest gedurfde dat hij ooit had ontworpen. De opdrachtgever was ook niet de eerste de beste: baron Edmond van Eetvelde was de secretaris-generaal van de onafhankelijke staat Congo - de 'minister van Congo', zeg maar - en dus een zeer naaste medewerker van koning Leopold II. \n\nDe toekomstige eigenaar vroeg de architect om een huis \u2018voor zijn gezin,\u2019 maar met een zo groot mogelijke woonkamer en eetkamer met het oog op zijn sociale verplichtingen. \n\nBijzonder is dat het huis in feite een drie-eenheid is. Het wordt geflankeerd door twee andere gebouwen: een gebouw links van het huis, dat zowel als uitbreiding van het oorspronkelijke huis als als huurhuis moest dienen, en een gebouw rechts van het huis, een klein bijgebouw bij het hoofdhuis. ","booking_url":"https:\/\/shop.utick.be\/?pos=LABAN&module=ACTIVITYSERIEDETAILS&s=E4D8C982-7620-86BE-07B4-22D6FF0EFE20&lg=NL","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":4486,"location":{"lat":50.8472189,"lon":4.3803579},"region":"brussels","last_updated_at":"2024-10-28T12:06:41+01:00","published_at":"2013-10-19T01:17:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":267246,"translations":{"de":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels ist ein Zusammenschluss von Vereinen, die qualitativ hochwertige Stadtf\u00fchrungen in der Region Br\u00fcssel-Hauptstadt organisieren.\r\nDie Mitgliedsvereine sind ARAU, Pro Velo, Brussels Chatterguides und Arkadia. Im Jahr 2020 hat sich La Fonderie als Partnerverein angeschlossen.\r\nEntdecken Sie das UNESCO-Weltkulturerbe, Jugendstilarchitektur, die Bauwerke von Victoria Horta, Gem\u00e4lde von Magritte, Comic-Kunst von Herg\u00e9, Streetart, Europa, Bier, Schokolade oder besichtigen Sie architektonische Perlen des Jugendstils, des Art-d\u00e9co oder des Neoklassizismus, die normalerweise nicht f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich sind. Die F\u00fchrungen werden sowohl f\u00fcr Einzelbesucher als auch f\u00fcr Gruppen angeboten und reichen von klassischen \u00fcber originelle bis hin zu vollkommen neuen Konzepten und Formaten. Neben Stadtf\u00fchrungen zu Fu\u00df sind auch Besichtigungen per Fahrrad, Bus oder Boot m\u00f6glich.\r\nExplore.Brussels organisiert unter anderem auch das Jugendstil- und Art-d\u00e9co-Festival BANAD, die Brussels Biennale - Neoclassic (BBN) sowie weitere Projekte, darunter die Ausbildung von Stadtf\u00fchrern, der \u201eVerein der Freunde\u201c und der \u201eVerein der Eigent\u00fcmer\u201c. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","pho