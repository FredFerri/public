bruegel.be\/programme\/creatures\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007512"},"it":{"name":"Cr\u00e9atures, un spectacle musical et post-binaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/creatures\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007512"},"cn":{"name":"Cr\u00e9atures, un spectacle musical et post-binaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/creatures\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007512"},"fr":{"name":"Cr\u00e9atures, un spectacle merveilleux, musical et post-binaire","shortdescr":"Avant que le ciel... ne devienne le repaire d'\u00e9tranges cr\u00e9atures, il y avait un royaume o\u00f9 les monstres ne sont pas celleux que l'on croit et o\u00f9 l'adelphit\u00e9 est reine. 'Cr\u00e9atures' est un conte gestuel et musical, post-binaire et merveilleux o\u00f9 les paroles de la conteuse Julie Boitte s'entrem\u00ealent aux notes du violoncelle de Corentin Dellicour.","longdescr":"Dans ce royaume... il sera question de deux naissances, gr\u00e2ce \u00e0 une cr\u00e9ature marine qui a offert son coeur, de deux vies li\u00e9es par un fil commun et une marque ind\u00e9l\u00e9bile qui changera tout. \n\n'Cr\u00e9atures' est une \u0153uvre collaborative, cr\u00e9\u00e9e avec une attention \u00e0 ne pas reproduire les rapports de domination quels qu'ils soient, tout en gardant une dimension merveilleuse.\n\nVenez le d\u00e9couvrir sur la sc\u00e8ne des Dimanches du conte !\n\nSpectacle tous publics \u00e0 partir de 8 ans \nDur\u00e9e : 60 minutes ","performers":"Julie Boitte (conteuse) ; Corentin Dellicour (violoncelle) ; Camille Pier (aide \u00e0 l'\u00e9criture, fond de sc\u00e8ne et graphisme) ; Caroline Leboutte (mise en sc\u00e8ne) ; Lion Ascendant Connasse (costumes) ; Antoinette Clette (sc\u00e9nographie, lumi\u00e8res) ; Th\u00e9r\u00e8se Coriou (conseil en production et d\u00e9veloppement) ; C\u00e9line Meurice - Nouveau Monde Diffusion (diffusion)","boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/creatures\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007512"},"sp":{"name":"Cr\u00e9atures, un spectacle musical et post-binaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/creatures\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007512"},"nl":{"name":"Cr\u00e9atures, un spectacle merveilleux, musical et post-binaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/creatures\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007512"}},"place":{"id":249303,"translations":{"de":{"name":"Les Dimanches du conte","address_street_name":"Rue des Renards","address_street_number":"1F","address_street_box":null,"email":"info@dimanchesduconte.be","website":"http:\/\/www.dimanchesduconte.be","phone_contact":"+32 485 67 10 89","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Renards, 1F","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}