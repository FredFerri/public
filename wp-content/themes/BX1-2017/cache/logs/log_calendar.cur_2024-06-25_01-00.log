d":"18:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]}},"translations":{"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 18:00"],"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 18:00"]},"date_start":"2024-05-16","date_end":"2024-09-29","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50008766,"date_start":"2024-04-13","date_end":"2024-06-30","date_next":"2024-06-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-24T02:00:30+02:00","published_at":"2024-03-23T19:52:32+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":297069,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.23305457683800562,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[41,36],"translations":{"de":["Installation, Performance","Museen & Kunstzentren"],"pt":[null,null],"en":["Installation, performance","Museums and art centers"],"it":["Installazioni, performance","Musei e centri artistici"],"cn":[null,null],"fr":["Installation, performance","Mus\u00e9es et art centers"],"sp":["Instalaci\u00f3n, performance","Museos y centros de arte"],"nl":["Installatie, performance","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Constant_V: Declarations","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008766"},"pt":{"name":"Constant_V: Declarations","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008766"},"en":{"name":"Constant_V: Declarations","shortdescr":"Declarations is an ongoing artistic research project that looks into the poetic materiality of the CSS web-language. The project is initiated by graphic designer Doriane Timmermans, a member of the collective Open Source Publishing.\nThis installation participates at the open doors weekends of Parcours d\u2019Artistes Saint-Gilles 2024","longdescr":"This installation participates at the open doors weekends of Parcours d\u2019Artistes Saint-Gilles 2024\n\nDeclarations is an ongoing artistic research project that looks into the poetic materiality of the CSS web-language. The project is initiated by graphic designer Doriane Timmermans, a member of the collective Open Source Publishing.\n\nCSS tells a browser, screen, phone, smartwatch - and devices from the past or yet to be imagined - how text flows, spaces are divided, hyperlinks are clicked, menus unfolded, and notification bubbled. It takes care of colors, mouvement, scrolling, animations and responsiveness. Every lines of the CSS language is called a \u2019declaration\u2019.\n\nDoriane invited a group of artists, writers, amateurs, designers and hackers to came together for a week to inspect a shift in design practices emerging from the nature of the web: as it is made of text, designing become writing. Makers of the web are becoming both authors and architects, and websites become a work of articulations. Questions are asked such as who decide of the words we use to shape the web, and what does they induce on our uses of technology, in terms of power and accessibility.\n\nThe group researched how the malleability of language is used to dialogue with a multitude of unknown canvases; how, similarly to the choice of words we decide to use to tell a story, designing with declarations, speak about our intentions, and encodes narrations into the things we make.\n\nThe results of this worksession, the first of this research, are presented as an installation in Constant\u2019s window.","performers":"Doriane Timmermans (artist)","boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008766"},"it":{"name":"Constant_V: Declarations","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008766"},"cn":{"name":"Constant_V: Declarations","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008766"},"fr":{"name":"Constant_V: Declarations","shortdescr":"Declarations est un projet de recherche artistique en cours de d\u00e9veloppement sur la mat\u00e9rialit\u00e9 po\u00e9tique du langage web CSS. Le projet a initi\u00e9 par la graphiste Doriane Timmermans, membre du collectif Open Source Publishing.\nCette installation participe aux week-ends portes ouvertes du Parcours d\u2019Artistes Saint-Gilles 2024","longdescr":"Cette installation participe aux week-ends portes ouvertes du Parcours d\u2019Artistes Saint-Gilles 2024\n\nDeclarations est un projet de recherche artistique en cours de d\u00e9veloppement sur la mat\u00e9rialit\u00e9 po\u00e9tique du langage web CSS. Le projet a initi\u00e9 par la graphiste Doriane Timmermans, membre du collectif Open Source Publishing.\n\nLe langage web indique au navigateur, \u00e0 l\u2019\u00e9cran, au t\u00e9l\u00e9phone, \u00e0 la smartwatch - et aux appareils du pass\u00e9 ou ceux \u00e0 imaginer - comment le texte s\u2019\u00e9coule, comment les espaces sont divis\u00e9s, les liens hypertextes sont cliqu\u00e9s, les menus se d\u00e9plient et les notifications affich\u00e9es dans des bulles. Ce langage s\u2019occupe des couleurs, du mouvement, du d\u00e9filement, des r\u00e9actions, des animations et de la r\u00e9activit\u00e9. Chaque ligne du langage CSS s\u2019appelle une \u2019d\u00e9claration\u2019.\n\nDoriane a invit\u00e9 un groupe un groupe d\u2019artistes, d\u2019\u00e9crivain.e.s, d\u2019amateur.e.s, de designers et de hackers, pour examiner ensemble un changement dans les pratiques de conception \u00e9mergeant de la nature du web : comme il est fait de texte, le design devient \u00e9criture.\nLes cr\u00e9ateur.trice.s du web deviennent \u00e0 la fois des auteur.trice.s et des architectes, et les sites web deviennent des \u0153uvres d\u2019articulation. Cela pose la question de savoir qui d\u00e9cide de ces mots et ce qu\u2019ils induisent sur nos usages de la technologie, cela questionne le pouvoir et l\u2019accessibilit\u00e9.\n\nLe groupe a \u00e9tudi\u00e9 comment la mall\u00e9abilit\u00e9 du langage est utilis\u00e9e pour dialoguer avec une multitude de toiles inconnues ; comment, \u00e0 l\u2019instar du choix des mots que nous d\u00e9cidons d\u2019utiliser pour raconter une histoire, la conception avec des d\u00e9clarations parle de nos intentions et encode des narrations dans les objets que nous fabriquons.\n\nLes premiers r\u00e9sultats de cette recherche sont pr\u00e9sent\u00e9s dans cette installation dans la vitrine de Constant.","performers":"Doriane Timmermans (artiste)","boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008766"},"sp":{"name":"Constant_V: Declarations","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008766"},"nl":{"name":"Constant_V: Declarations","shortdescr":"Declarations is een doorlopend artistiek onderzoeksproject die kijkt naar de po\u00ebtische materialiteit van de CSS webtaal. Het project is ge\u00efnitieerd door grafisch ontwerpster Doriane Timmermans, lid van het collectief Open Source Publishing.\nDeze installatie neemt deel aan de opendeur weekends van Parcours d\u2019Artistes Sint-Gillis 2024","longdescr":"Deze installatie neemt deel aan de opendeur weekends van Parcours d\u2019Artistes Sint-Gillis 2024\n\nDeclarations is een doorlopend artistiek onderzoeksproject die kijkt naar de po\u00ebtische materialiteit van de CSS webtaal. Het project is ge\u00efnitieerd door grafisch ontwerpster Doriane Timmermans, lid van het collectief Open Source Publishing.\n\nCSS vertelt een browser, scherm, telefoon, smartwatch - en apparaten uit het verleden of die nog bedacht moeten worden - hoe tekst stroomt, ruimtes worden verdeeld, hyperlinks worden aangeklikt, menu\u2019s worden uitgevouwen en meldingen opborrelen. Het zorgt voor kleuren, beweging, scrollen, animaties en flexibiliteit. Elke regel in de CSS taal wordt een \u2019declaratie\u2019 genoemd.\n\nDoriane nodigde een groep van kunstenaars en kunstenaressen, schrijvers en schrijfsters, amateurs, ontwerpers en ontwerpsters en hackers om samen te onderzoeken een verschuiving in ontwerppraktijken die voortkomen uit de aard van het web: omdat het uit tekst bestaat, wordt het schrijven ook het vormgeven.\n\nMakers van het web worden zowel auteurs als architecten, en websites worden een werk van articulaties.\nVervolgens worden vragen gesteld zoals wie beslist over de woorden die we gebruiken om het web vorm te geven, en wat doen ze met ons gebruik van technologie?\n\nDe groep onderzocht hoe de kneedbaarheid van taal wordt gebruikt om een dialoog aan te gaan met een veelheid aan onbekende doeken; hoe, vergelijkbaar met de keuze van woorden die we besluiten te gebruiken om een verhaal te vertellen, het ontwerpen met verklaringen iets zegt over onze bedoelingen en verhalen codeert in de dingen die we maken.\n\nDe eerste resultaten van dit onderzoek worden getoond in een installatie in de vitrine van Constant.","performers":"Doriane Timmermans (kunstenares)","boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008766"}},"place":{"id":243917,"translations":{"de":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Constant","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":"Constant est une association sans but lucratif bas\u00e9e \u00e0 Bruxelles, active depuis 1997 dans les domaines de l\u2019art et des m\u00e9dias.\r\nConstant est un atelier interdisciplinaire qui se concentre sur la culture et l\u2019\u00e9thique du web. La pratique artistique de Constant est inspir\u00e9e par la fa\u00e7on avec laquelle les infrastructures technologiques, les \u00e9changes de donn\u00e9es et les logiciels d\u00e9terminent nos vies quotidiennes. Quelques chantiers importants sont le logiciel libre, les alternatives au copyright et le (cyber)f\u00e9minisme.\r\nDe fa\u00e7on r\u00e9guli\u00e8re Constant organise des ateliers, des print-parties, des balades, des performances, des lectures et des rencontres \u2018Verbindingen\/Jonctions\u2019 pour un public qui aime l\u2019exp\u00e9rimentation, la discussion et des \u00e9changes de toutes sortes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Constant vzw","address_street_name":"Fortstraat","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Fortstraat, 5","address_line2":"1060 Sint-Gillis","description_web":"Constant is een vereniging zonder winstoogmerk werkzaam in het gebied tussen kunst en media.\r\nHet is een interdisciplinaire werkplaats die zich bezighoudt met de cultuur en ethiek van het web. De artistieke praktijk van Constant wordt ge\u00efnspireerd door de manier waarop technologische infrastructuren, data-uitwisseling en software ons dagelijkse leven bepalen. Belangrijke werkterreinen zijn vrije software, alternatieven op auteursrecht en (cyber)feminisme.\r\nConstant organiseert regelmatig workshops, print-parties, wandelingen en \u2018Verbindingen\/Jonctions\u2019-bijeenkomsten voor een publiek dat houdt van experimenten, discussies en uitwisselingen allerhande.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl":["Sint-Gillis centrum"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":6251,"location":{"lat":50.829913,"lon":4.34345951},"region":"brussels","last_updated_at":"2022-05-30T12:22:16+02:00","published_at":"2013-10-19T01:19:59+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":243917,"translations":{"de":{"name":"Constant asbl","