":15}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T13:05:33+02:00","published_at":"2022-08-11T12:30:07+02:00","backoffice_id":259540,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.16465843900209},{"id":544728,"date_start":"2022-10-27","date_end":"2023-06-29","date_next":"2022-10-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Concerts de midi Erasmusica","shortdescr":null,"longdescr":"Les \u00e9tudiants de la section HIPP (Historical Performance Practice) du Koninklijk Conservatorium Brussel vous invitent \u00e0 \u00e9couter chaque mois les sonorit\u00e9s subtiles et uniques de la musique ancienne interpr\u00e9t\u00e9e sur des instruments d\u2019\u00e9poque.\r\nLes musiciens vous proposent un voyage \u00e0 travers toute l\u2019Europe. A chaque \u00e9dition, c\u2019est un programme surprise vari\u00e9 qui vous est pr\u00e9sent\u00e9, accompagn\u00e9 d\u2019explications et d\u2019anecdotes tout au long du concert.\r\n\r\nGratuit et sans r\u00e9servation\r\nUne organisation de la Maison d\u2019\u00c9rasme & B\u00e9guinage et du Koninklijk Conservatorium Brussel avec la collaboration de la Muziekacademie Anderlecht.","performers":"Les \u00e9tudiants de la section HIPP (Historical Performance Practice) du Koninklijk Conservatorium Brussel","boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544728"},"nl":{"name":"Middagconcerten Erasmusica","shortdescr":null,"longdescr":"Een keer per maand nodigen de studenten van de afdeling Historical Performance Practice van het Koninklijk Conservatorium Brussel u uit te luisteren naar de subtiele en unieke klanken van de barok- en klassieke muziek, uitgevoerd op historische instrumenten. Tijdens een middagconcert nemen zij u mee op een muzikale reis doorheen Europa. Wij gidsen u telkens door een gevarieerd en verrassend programma aan de hand van uitleg en anekdotes.\r\n\r\nGratis en zonder reservering\r\nEen organisatie van het Erasmushuis & Begijnhof en het Koninklijk Conservatorium Brussel in samenwerking met de Muziekacademie Anderlecht.","performers":"De studenten van de afdeling Historical Performance Practice van het Koninklijk Conservatorium Brussel","boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/nl\/2022\/09\/middagconcerten-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544728"},"en":{"name":"Concerts de midi Erasmusica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544728"},"de":{"name":"Concerts de midi Erasmusica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544728"},"it":{"name":"Concerts de midi Erasmusica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,