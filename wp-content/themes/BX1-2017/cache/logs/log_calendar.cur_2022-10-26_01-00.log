2T02:05:20+02:00","published_at":"2021-06-16T14:42:06+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/bd2cb6002a65cd136c15b1b439bbbeeb355396d3.jpg","width":1241,"height":1749,"ratio":0.71,"translations":{"fr":{"title":"Salsa, Bachata, Ladystyling!","copyright":null},"nl":{"title":"Salsa, Bachata, Ladystyling!","copyright":null},"en":{"title":"Salsa, Bachata, Ladystyling!","copyright":null}}}],"dates":[{"day":"2022-09-13","doors":null,"start":"19:00:00","end":"22:00:00"},{"day":"2022-10-03","doors":null,"start":"19:00:00","end":"22:00:00"},{"day":"2022-10-11","doors":null,"start":"19:00:00","end":"22:00:00"}],"recurring":[{"day":"monday","occurences":{"is_first":true,"is_second":false,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"19:00:00","time_end":"22:00:00","translations":{"fr":"Ouvert le premier lundi du mois de 19:00 \u00e0 22:00","nl":"Open op de eerste maandag van de maand van 19:00 tot 22:00","en":"Open the first monday of the month from 19:00 to 22:00"}},{"day":"tuesday","occurences":{"is_first":false,"is_second":true,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"19:00:00","time_end":"22:00:00","translations":{"fr":"Ouvert le deuxi\u00e8me mardi du mois de 19:00 \u00e0 22:00","nl":"Open op de tweede dinsdag van de maand van 19:00 tot 22:00","en":"Open the second tuesday of the month from 19:00 to 22:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":80}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-12T02:05:21+02:00","published_at":"2022-07-13T09:06:59+02:00","backoffice_id":258312,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.28114422176725},{"id":538206,"date_start":"2022-09-08","date_end":"2022-12-10","date_next":"2022-10-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Warch\u00e9 : Lina Ghotmeh, Emilija \u0160karnulyt\u0117 et Sara Ouhaddou","shortdescr":"L\u2019exposition Warch\u00e9, \u00ab chantier \u00bb en arabe, s\u2019articule autour de l\u2019histoire personnelle de Lina Ghotmeh, architecte originaire de Beyrouth, en dialogue avec les artistes visuelles Emilija \u0160karnulyt\u0117 et Sara Ouhaddou.","longdescr":"L\u2019exposition Warch\u00e9, \u00ab chantier \u00bb en arabe, s\u2019articule autour de l\u2019histoire personnelle de Lina Ghotmeh, architecte originaire de Beyrouth, en dialogue avec les artistes visuelles Emilija \u0160karnulyt\u0117 et Sara Ouhaddou.\r\nL\u2019architecte investit le sol d\u2019un tapis de briques issues de productions locales, une d\u00e9monstration de son engagement pour l\u2019architecture de terre. A ses c\u00f4t\u00e9s, l\u2019installation vid\u00e9o de Emilija \u0160karnulyt\u00eb convoque une vision r\u00e9tro-futuriste de notre plan\u00e8te, elle-m\u00eame confront\u00e9e aux explorations de Sara Ouhaddou qui pr\u00e9sente une nouvelle s\u00e9rie de collages et une installation de sculpture de savon de Marseille, incrust\u00e9e d\u2019ossements de c\u00e9ramique.\r\nCon\u00e7ue comme une agora, l\u2019exposition invite \u00e0 penser notre rapport au temps comme t\u00e9moin de notre passage sur terre et questionne ainsi la responsabilit\u00e9 de nos interpr\u00e9tations de la ville, tant politiques que po\u00e9tiques.\r\nCommissariat : Anissa Touati\r\n\r\nInformations pratiques:\r\nExposition du 8 septembre au 3 d\u00e9cembre 2022\r\nDu mercredi au vendredi de 12h \u00e0 18h, le samedi de 11h \u00e0 18h\r\nEntre\u0301e 5\u20ac \/ Gratuite\u0301* (sur pre\u0301sentation d\u2019un justificatif)\r\n*E\u0301tudiants, enseignants, -26 ans, demandeurs d\u2019emploi et membres SMART            Visite comment\u00e9e chaque mercredi et samedi \u00e0 15h, et gratuit\u00e9 de l'exposition chaque premier samedi du mois\r\n\r\n\r\nEn partenariat avec Brussels Design September","performers":"Lina Ghotmeh, Emilija \u0160karnulyt\u0117 et Sara Ouhaddou artistes plasticiennes, commissariat Anissa Touatti","boxoffice_url":null,"website":"http:\/\/www.fondationthalie.org","email":"discutons@fondationthalie.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538206"},"nl":{"name":"Warch\u00e9 : Lina Ghotmeh, Emilija \u0160karnulyt\u0117 et Sara Ouhaddou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538206"},"en":{"name":"Warch\u00e9 : Lina Ghotmeh, Emilija \u0160karnulyt\u0117 et Sara Ouhaddou","shortdescr":"The exhibition Warch\u00e9 \u2014meaning \u2018worksite\u2019 in Arabic\u2014 is based on the personal story of Lina Ghotmeh, an architect from Beirut, in dialogue with the visual artists Emilija \u0160karnulyt\u0117 and Sara Ouhaddou.","longdescr":"Titled Warch\u00e9, meaning worksite in Arabic, the exhibit is based on the personal history of Lina Ghotmeh, a Beyrouth native architect, in dialogue with the visual artists Emilija \u0160karnulyt\u0117 and Sara Ouhaddou.\r\nLina Ghotmeh (winner of the Schelling Foundation Architecture Prize in 2020) is taking over the floor of the exhibition space with locally sourced bricks, demonstrating her commitment to earthen architecture. Alongside her, Emilija \u0160karnulyt\u0117\u2019s video installation conjures up a retro-futuristic view of our planet, confronted by Sara Ouhaddou\u2019s explorations, who unveils a new series of collages and a sculpture installation of Marseille soap, encrusted with ceramic bones.\r\nConceived as an agora, the exhibit conveys a reflection on our relationship to time as we witness moments on Earth and questions our responsibility of the city, be they political or poetic.\r\nCurator: Anissa Touati\r\n\r\nPractical information:\r\nExhibition from 8 September to 3 December 2022\r\nFrom Wednesday to Friday from 12pm to 6pm, on Saturday from 11am to 6pm\r\nEntrance 5\u20ac \/ Free* (on presentation of suitable evidence)\r\n*Students, teachers, -26, job seekers, SMART members\r\nCommented tour every Wednesday and Saturday at 3 pm. Free entrance every first Saturday of the month\r\n\r\nIn partnership with Brussels Design September","performers":"Lina Ghotmeh, Emilija \u0160karnulyt\u0117 and Sara Ouhaddou contemporary artist, curraation by Anissa Touatti","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538206"},"de":{"name":"Warch\u00e9 : Lina Ghotmeh, Emilija \u0160karnulyt\u0117 et Sara Ouhaddou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538206"},"it":{"name":"Warch\u00e9 : Lina Ghotmeh, Emilija \u0160karnulyt\u0117 et Sara Ouhaddou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email"