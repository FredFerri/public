ss_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/60e07689c292ce34e24578d1f6fe02d2b5184c3e.jpg","width":810,"height":1080,"ratio":0.75,"translations":{"fr":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null},"nl":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null},"en":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/19d5ba73871f65ab1d06aef486338a1382e45e0b.jpg","width":1200,"height":670,"ratio":1.79,"translations":{"fr":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null},"nl":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null},"en":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null}}},{"type":"video","link":"https:\/\/www.youtube.com\/watch?v=xeEnbiMiyeQ","oEmbed_title":"Visite Bruxelles, Grand-Place, hotel de ville : l'aile droite","oEmbed_author_name":"Visite Bruxelles","oEmbed_author_url":"https:\/\/www.youtube.com\/c\/VisiteBruxelles","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/xeEnbiMiyeQ\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/xeEnbiMiyeQ?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : l'aile droite"},"nl":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : l'aile droite"},"en":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : l'aile droite"}}}],"dates":[{"day":"2022-05-01","doors":null,"start":"09:30:00","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-08-21","doors":null,"start":"09:30:00","end":"12:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":32}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-18T17:05:11+02:00","published_at":"2022-03-03T11:52:33+01:00","backoffice_id":248893,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":535908,"date_start":"2022-08-22","date_end":"2022-08-22","date_next":"2022-08-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"The Party is over","shortdescr":"Hommage \u00e0 10 d\u00e9esses de la chanson qui ont pr\u00e9f\u00e9r\u00e9 la flamboyance \u00e0 la ti\u00e8de prudence.\r\n\u00abNon, je ne regrette rien\u00bb, \u00abPour ne pas vivre seul\u00bb, \u00abOver the Rainbow\u00bb, \u2026","longdescr":"Anne Mie Giels - la magnifique Norma de Sunset Boulevard - est assur\u00e9ment une des rencontres majeures des 20 ans du Festival Bruxellons!. Une rencontre artistique rare, mais aussi humaine. Depuis 2002, Anne Mie Gils a jou\u00e9 des dizaines de repr\u00e9sentations de The Party is over, un spectacle qu'elle a cr\u00e9\u00e9 avec Pol Vanfleteren.\r\nElle a voulu rendre hommage \u00e0 10 d\u00e9esses de la chanson qui ont toujours pr\u00e9f\u00e9r\u00e9 la flamboyance \u00e0 la ti\u00e8de prudence. Mais cela dure moins longtemps. The party is over, la f\u00eate est finie\u2026 Nous vous donnons rendez-vous pour un moment de gr\u00e2ce.\r\nVoici enfin la cr\u00e9ation mondiale en Fran\u00e7ais de The Party is over\r\n\r\n10 chanteuses: Edith Piaf, Marilyn Monroe, Judy Garland, Bessie Smith, Patsy Cline, Janis Joplin, Billie Holiday, Dalida, Ann Christy et Dinah Washington.\r\n10 femmes.\r\nElles ont toutes chant\u00e9 magnifiquement \u00abl'Homme\u00bb. L'amour de \u00abl'Homme\u00bb. Et pourtant\u2026\r\nElles avaient toutes pour devise: \u00abIt\u2019s better to burn out than to fade away.\u00bb\r\nAnne Mie Giels nous m\u00e8ne \u00e0 la rencontre de ces dix artistes exceptionnelles, chantant leurs plus belles chansons, mais aussi nous racontant de nombreuses annecdotes qui nous confrontent \u00e0 la r\u00e9alit\u00e9 de leurs vies, de leurs vraies vies. Quand les projecteurs se sont \u00e9teints et que les paillettes ont disparu.\r\nThe party is over, la f\u00eate est finie\u2026\r\n\r\nNon! Rien de rien ...\r\nNon! Je ne regrette rien...\r\nNi le bien qu'on m'a fait\r\nNi le mal tout \u00e7a m'est bien \u00e9gal!\r\n(\u2026)\r\nNon! Rien de rien ...\r\nNon! Je ne regrette rien ...\r\nCar ma vie, car mes joies\r\nAujourd'hui, \u00e7a commence avec toi!\r\n\"Non je ne regrette rien\" par Edith Piaf","performers":"SPECTACLE MUSICAL DE ANNE MIE GILS ET POL VANFLETEREN\r\nMise en sc\u00e8ne: Jan Verbist \u25aa Avec: Anne Mie Gils et Pol Vanfleteren","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=FR","website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":null,"phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535908"},"nl":{"name":"The Party is over","shortdescr":null,"longdes