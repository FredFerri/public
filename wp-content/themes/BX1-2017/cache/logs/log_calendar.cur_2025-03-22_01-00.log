rtdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Courage-s.5700007445","website":"http:\/\/www.laclarenciere.be","email":"Fabienne.govaerts@gmail.com","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007445"},"fr":{"name":"Courage(s)","shortdescr":"THEATRE D'IMPROVISATION\nPendant ce spectacle d'1h15 enti\u00e8rement improvis\u00e9, Alexandre Valancin invite 3 com\u00e9dien\/es \u00e0 s'inspirer\nde VOS courages pour en faire des tranches de vie des personnages.","longdescr":"Pendant ce spectacle d'1h15 enti\u00e8rement improvis\u00e9, Alexandre Valancin invite 3 com\u00e9dien\/es \u00e0 s'inspirer\nde VOS courages pour en faire des tranches de vie des personnages.\n\nAvant le spectacle, il vous sera possible de transmettre (anonymement) deux types de situations qui serviront d'inspiration.\nCelles o\u00f9 vous avez d\u00fb faire preuve de courage,\net celles o\u00f9 vous avez \u00e9t\u00e9 admiratifs du courage d'autres personnes.\nEt ce, que ce soit de petits courages quotidiens, aux plus difficiles que la vie peut r\u00e9server !","performers":"Interpr\u00e9tation : Alexandre Valancin, Catherine Lembr\u00e9e et Marie Pierre Thomas\nProduction : L'Eau est un \u00e9tat Ebullition ASBL","boxoffice_url":"https:\/\/www.visit.brussels\/fr\/visiteurs\/agenda\/event-detail\/book-tickets.Courage-s.5700007445","website":"http:\/\/www.laclarenciere.be","email":"Fabienne.govaerts@gmail.com","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007445"},"sp":{"name":"Courage(s)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agenda\/event-detail\/book-tickets.Courage-s.5700007445","website":"http:\/\/www.laclarenciere.be","ema