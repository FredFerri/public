n \r\n\r\n\"Art is what makes life more interesting than art\", this quote from\r\n\r\nRobert Filliou also illustrates what unites Max Modesti and\r\n\r\nHerv\u00e9 Perdriolle, a pronounced taste for the encounters and adventures that the art world arouses.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Galerie Herv\u00e9 Perdriolle","address_street_name":"Rue Saint-Georges","address_street_number":"27","address_street_box":null,"email":null,"website":"http:\/\/www.modestiperdriolle.com","phone_contact":"+32 492 31 01 19","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Saint-Georges, 27","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Galerie Herv\u00e9 Perdriolle","address_street_name":"Rue Saint-Georges","address_street_number":"27","address_street_box":null,"email":null,"website":"http:\/\/www.modestiperdriolle.com","phone_contact":"+32 492 31 01 19","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Saint-Georges, 27","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Galerie Herv\u00e9 Perdriolle","address_street_name":"Rue Saint-Georges","address_street_number":"27","address_street_box":null,"email":null,"website":"http:\/\/www.modestiperdriolle.com","phone_contact":"+32 492 31 01 19","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Saint-Georges, 27","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Galerie Herv\u00e9 Perdriolle","address_street_name":"Rue Saint-Georges","address_street_number":"27","address_street_box":null,"email":null,"website":"http:\/\/www.modestiperdriolle.com","phone_contact"