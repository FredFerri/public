y":"2025-03-05","doors":"08:00:00","start":"08:00:00","end":"12:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-03-06","doors":"08:00:00","start":"08:00:00","end":"12:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-03-07","doors":"08:00:00","start":"08:00:00","end":"12:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2025-03-04","end":"21:00:00","start":"19:00:00","timestamp":"2025-03-04T19:00:00"}},{"id":5700007870,"date_start":"2025-03-22","date_end":"2025-04-25","date_next":"2025-03-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T12:52:23+01:00","published_at":"2025-03-20T14:00:09+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":320364,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.30571070873287987,"languages":{"spoken":["en","pl","de","it","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"Rafal Strent. Mount Ararat and other works","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":null,"phone_booking":"+32 495 71 89 88","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007870"},"pt":{"name":"Rafal Strent. Mount Ararat and other works","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":null,"phone_booking":"+32 495 71 89 88","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007870"},"en":{"name":"Rafal Strent. Mount Ararat and other works","shortdescr":"This exhibition showcases Rafa\u0142 Strent's unique blend of painting and graphic arts. His art reflects his fascination with the world and personal experiences. \nStrent's vision is influenced by literature and travels, including Mongolia, which inspired exotic landscapes. His fascination with writers like Rafa\u0142 Wojaczek and Bohumil Hrabal shapes his work.","longdescr":"Mount Ararat and Other Works by Rafa\u0142 Strent\n\nRafa\u0142 Strent, born in 1943, is an outstanding Polish artist who has been actively engaged in painting, graphic arts, and drawing since the 1970s. His work, characterized by a unique approach to form and color, has gained recognition both in Poland and abroad.\n\nThe works presented in this exhibition reveal Strent\u2019s fascination with the external world and his personal experiences. The artist draws inspiration from his surroundings, the people he encounters, and his own emotions and memories. His curiosity, openness, sensitivity, and subtlety allow him to explore various artistic fields, which is reflected in the diversity of his works. His fascination with literature also plays a significant role in shaping his artistic vision.\n\nStrent is known for experimenting with graphic techniques such as etching and aquatint, often combining them with painting to create a unique artistic expression. His prints are distinguished by a painterly quality, with variations in color and composition that make each piece distinctive.\n\nFrom Kobzdej\u2019s studio, he developed a sensitivity to color and texture, as well as a deep fascination with literature. Through a series of intriguing coincidences, he had the opportunity to meet notable writers, including the Polish poet Rafa\u0142 Wojaczek and the Czech writer Bohumil Hrabal.\n\nHis artistic journey has also been deeply influenced by his extensive travels, including trips to Mongolia, which resulted in a series of graphics and paintings inspired by exotic landscapes. His works reflect the richness of his experiences and emotions, which he translates into the language of art, creating pieces full of depth and expression.\n\nOne of Strent\u2019s notable works is \u201cArarat\u201d (1996), created using etching and aquatint techniques on paper. The title \u201cArarat\u201d refers to Mount Ararat, a significant cultural and biblical symbol often associated with the resting place of Noah\u2019s Ark. This motif reflects Strent\u2019s interest in exploring themes that connect art with broader cultural narratives, thus evoking powerful imagery through art, blending historical and symbolic elements with contemporary artistic expression.\n\nGallery Katarzyna Napi\u00f3rkowska\nMont des Arts 8\nBrussels\n\nWe cordially invite you to the open days of the new exhibition by Rafa\u0142a Strent\nKatarzyna Napi\u00f3rkowska Art Gallery, Mont des Arts 8, Brussels \n\nOPEN DAYS:\n\n22 of March 2025 Saturday: 12-18.00\n24 of March 2025 Monday: 12-18.00\n25 of March 2025 Tuesday 12-18.00\n\nExhibition: 22 March- 27 April, 2025 (by appointment and 7\/7, 24\/24)\nEmail: galeria@napiorkowska.pl","performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":null,"phone_booking":"+32 495 71 89 88","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007870"},"it":{"name":"Rafal Strent. Mount Ararat and other works","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":null,"phone_booking":"+32 495 71 89 88","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007870"},"cn":{"name":"Rafal Strent. Mount Ararat and other works","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":null,"phone_booking":"+32 495 71 89 88","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007870"},"fr":{"name":"Rafa\u0142 Strent. Le Mont Ararat et autres \u0153uvres","shortdescr":"Cette exposition pr\u00e9sente le m\u00e9lange unique de Rafa\u0142 Strent entre peinture et arts graphiques. Son art refl\u00e8te sa fascination pour le monde et ses exp\u00e9riences personnelles. La vision de Strent est influenc\u00e9e par la litt\u00e9rature et les voyages, notamment en Mongolie, qui ont inspir\u00e9 des paysages exotiques. Sa fascination pour des \u00e9crivains comme Rafa\u0142 Wojaczek et Bohumil Hrabal fa\u00e7onne son travail.","longdescr":"Le Mont Ararat et autres \u0153uvres de Rafa\u0142 Strent\n\nRafa\u0142 Strent, n\u00e9 en 1943, est un artiste polonais \u00e9minent qui s'est engag\u00e9 activement dans la peinture, les arts graphiques et le dessin depuis les ann\u00e9es 1970. Son travail, caract\u00e9ris\u00e9 par une approche unique de la forme et de la couleur, a acquis une reconnaissance \u00e0 la fois en Pologne et \u00e0 l'\u00e9tranger.\n\nLes \u0153uvres pr\u00e9sent\u00e9es dans cette exposition r\u00e9v\u00e8lent la fascination de Strent pour le monde ext\u00e9rieur et ses exp\u00e9riences personnelles. L'artiste tire son inspiration de son environnement, des personnes qu'il rencontre, et de ses propres \u00e9motions et souvenirs. Sa curiosit\u00e9, son ouverture, sa sensibilit\u00e9 et sa subtilit\u00e9 lui permettent d'explorer divers domaines artistiques, ce qui se refl\u00e8te dans la diversit\u00e9 de ses \u0153uvres. Sa fascination pour la litt\u00e9rature joue \u00e9galement un r\u00f4le important dans la formation de sa vision artistique.\n\nStrent est connu pour exp\u00e9rimenter des techniques graphiques telles que la gravure et l'aquatinte, qu'il combine souvent avec la peinture pour cr\u00e9er une expression artistique unique. Ses estampes se distinguent par une qualit\u00e9 picturale, avec des variations de couleur et de composition qui rendent chaque pi\u00e8ce distincte.\n\nDans l'atelier de Kobzdej, il a d\u00e9velopp\u00e9 une sensibilit\u00e9 \u00e0 la couleur et \u00e0 la texture, ainsi qu'une profonde fascination pour la litt\u00e9rature. \u00c0 travers une s\u00e9rie de co\u00efncidences intrigantes, il a eu l'occasion de rencontrer des \u00e9crivains notables, notamment le po\u00e8te polonais Rafa\u0142 Wojaczek et l'\u00e9crivain tch\u00e8que Bohumil Hrabal.\n\nSon parcours artistique a \u00e9galement \u00e9t\u00e9 profond\u00e9ment influenc\u00e9 par ses voyages \u00e9tendus, notamment ses voyages en Mongolie, qui ont abouti \u00e0 une s\u00e9rie de graphiques et de peintures inspir\u00e9s par des paysages exotiques. Ses \u0153uvres refl\u00e8tent la richesse de ses exp\u00e9riences et de ses \u00e9motions, qu'il traduit en langage artistique, cr\u00e9ant des pi\u00e8ces remplies de profondeur et d'expression.\n\nL'une des \u0153uvres notables de Strent est \"Ararat\" (1996), r\u00e9alis\u00e9e \u00e0 l'aide de techniques d'etching et d'aquatinte sur papier. Le titre \"Ararat\" fait r\u00e9f\u00e9rence au mont Ararat, un symbole culturel et biblique important souvent associ\u00e9 au reposoir de l'arche de No\u00e9. Ce motif refl\u00e8te l'int\u00e9r\u00eat de Strent pour l'exploration de th\u00e8mes qui relient l'art \u00e0 des r\u00e9cits culturels plus larges, \u00e9voquant ainsi des images puissantes \u00e0 travers l'art, en m\u00e9langeant des \u00e9l\u00e9ments historiques et symboliques avec une expression artistique contemporaine.\n\nGalerie Katarzyna Napi\u00f3rkowska\nMont des Arts 8\nBruxelles\n\nNous vous invitons cordialement aux jours d'ouverture de la nouvelle exposition de Rafa\u0142 Strent\nGalerie Katarzyna Napi\u00f3rkowska, Mont des Arts 8, Bruxelles\n\nJOURS D'OUVERTURE :\n\n22 mars 2025 samedi : 12-18.00\n24 mars 2025 lundi : 12-18.00\n25 mars 2025 mardi : 12-18.00\n\nExposition : 22 mars - 27 avril 2025 (sur rendez-vous et 7\/7, 24\/24)\nE-mail : galeria@napiorkowska.pl","performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":null,"phone_booking":"+32 495 71 89 88","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007870"},"sp":{"name":"Rafal Strent. Mount Ararat and other works","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":null,"phone_booking":"+32 495 71 89 88","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007870"},"nl":{"name":"Rafal Strent. Mount Ararat and other works","shortdescr":"Deze tentoonstelling toont Rafa\u0142 Strents unieke combinatie van schilderkunst en grafische kunst. Zijn kunst weerspiegelt zijn fascinatie voor de wereld en zijn persoonlijke ervaringen. Strents visie wordt be\u00efnvloed door literatuur en reizen, waaronder naar Mongoli\u00eb, wat exotische landschappen inspireerde. Zijn fascinatie voor schrijvers zoals Rafa\u0142 Wojaczek en Bohumil Hrabal vormt zijn werk.","longdescr":"Mount Ararat en andere werken van Rafa\u0142 Strent\n\nRafa\u0142 Strent, geboren in 1943, is een vooraanstaande Poolse kunstenaar die sinds de jaren zeventig actief is in de schilderkunst, grafische kunst en tekenkunst. Zijn werk, gekenmerkt door een unieke benadering van vorm en kleur, heeft erkenning gekregen zowel in Polen als in het buitenland.\n\nDe werken die in deze tentoonstelling worden gepresenteerd, onthullen Strents fascinatie voor de buitenwereld en zijn persoonlijke ervaringen. De kunstenaar put inspiratie uit zijn omgeving, de mensen die hij ontmoet, en zijn eigen emoties en herinneringen. Zijn nieuwsgierigheid, openheid, gevoeligheid en subtiliteit laten hem toe om verschillende artistieke gebieden te verkennen, wat weerspiegeld wordt in de diversiteit van zijn werken. Zijn fascinatie voor literatuur speelt ook een belangrijke rol bij het vormgeven van zijn artistieke visie.\n\nStrent staat bekend om zijn experimenten met grafische technieken zoals etsen en aquatint, die hij vaak combineert met schilderkunst om een unieke artistieke expressie te cre\u00ebren. Zijn prenten worden gekenmerkt door een schilderachtige kwaliteit, met variaties in kleur en compositie die elk stuk onderscheidend maken.\n\nIn het atelier van Kobzdej ontwikkelde hij een gevoeligheid voor kleur en textuur, evenals een diepe fascinatie voor literatuur. Door een reeks intrigerende toevalligheden had hij de kans om bekende schrijvers te ontmoeten, waaronder de Poolse dichter Rafa\u0142 Wojaczek en de Tsjechische schrijver Bohumil Hrabal.\n\nZijn artistieke reis is ook diepgaand be\u00efnvloed door zijn uitgebreide reizen, waaronder reizen naar Mongoli\u00eb, die resulteerden in een reeks grafische werken en schilderijen ge\u00efnspireerd door exotische landschappen. Zijn werken weerspiegelen de rijkdom van zijn ervaringen en emoties, die hij vertaalt in de taal van de kunst, waardoor hij stukken cre\u00ebert die vol zijn van diepte en expressie.\n\nEen van Strents opvallende werken is \"Ararat\" (1996), gemaakt met ets- en aquatinttechnieken op papier. De titel \"Ararat\" verwijst naar de berg Ararat, een belangrijk cultureel en bijbels symbool dat vaak wordt geassocieerd met de rustplaats van Noachs ark. Dit motief weerspiegelt Strents interesse in het verkennen van thema's die kunst verbinden met bredere culturele verhalen, waardoor krachtige beelden worden opgeroepen door kunst, historische en symbolische elementen vermengend met hedendaagse artistieke expressie.\n\nGalerie Katarzyna Napi\u00f3rkowska\nMont des Arts 8\nBrussel\n\nWij nodigen u hartelijk uit voor de open dagen van de nieuwe tentoonstelling van Rafa\u0142 Strent\nGalerie Katarzyna Napi\u00f3rkowska, Mont des Arts 8, Brussel\n\nOPEN DAGEN:\n\n22 maart 2025 zaterdag: 12-18.00\n24 maart 2025 maandag: 12-18.00\n25 maart 2025 dinsdag: 12-18.00\n\nTentoonstelling: 22 maart - 27 april 2025 (op afspraak en 7\/7, 24\/24)\nE-mail: galeria@napiorkowska.pl","performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":null,"phone_booking":"+32 495 71 89 88","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007870"}},"place":{"id":251322,"translations":{"de":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"website":"http:\/\/www.napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Mont des Arts, 8","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"website":"http:\/\/www.napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"address_zip":"1000","address_city":"Br