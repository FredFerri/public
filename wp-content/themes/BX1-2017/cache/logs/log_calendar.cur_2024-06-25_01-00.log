de nombreux \u00e9difices d\u00e9di\u00e9s aux arts visuels et aux repr\u00e9sentations th\u00e9\u00e2trales. T\u00e9moins d\u2019une \u00e9poque, ils vous raconteront l\u2019histoire de la capitale \u00e0 travers les anecdotes, les \u0153uvres et les grands \u00e9v\u00e9nements qu\u2019ils ont accueillis. Plus une minute \u00e0 perdre, enfourchez votre v\u00e9lo pour une balade des plus divertissantes ","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010791"},"sp":{"name":"Bruxelles s'amuse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010791"},"nl":{"name":"Bruxelles s'amuse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010791"}},"place":{"id":280345,"translations":{"de":{"name":"Rue de Dublin ","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Rue de Dublin ","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_vis