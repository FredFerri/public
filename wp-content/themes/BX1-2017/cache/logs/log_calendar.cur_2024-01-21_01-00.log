one_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.559966"},"en":{"name":"Guten tag, madame Merkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559966"},"it":{"name":"Guten tag, madame Merkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559966"},"cn":{"name":"Guten tag, madame Merkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559966"},"fr":{"name":"Guten tag, madame Merkel","shortdescr":"R\u00eaverie r\u00e9aliste et satirique sur Angela Merkel, politicienne sans charisme devenue la femme la plus puissante du monde.\r\n","longdescr":"Partant du constat qu\u2019on ne r\u00e8gne pas sur un pays comme l\u2019Allemagne en \u00e9tant un enfant de ch\u0153ur, une question passionnante se pose : qui est Angela Merkel ? Qui est-elle pour tenir le pouvoir si fort et si longtemps ? Qui est cette femme \u00e0 l\u2019allure passe-partout qui a gagn\u00e9 le respect des dirigeants europ\u00e9ens et influenc\u00e9 profond\u00e9ment les d\u00e9cisions de son \u00e9poque ? Avec une dizaine de personnages \u00e0 ses c\u00f4t\u00e9s, de Bismarck \u00e0 Vladimir Poutine en passant par Nicolas Sarkozy, on suit sa vie de la chute du mur du Berlin jusqu\u2019\u00e0 la fin de sa carri\u00e8re de chanceli\u00e8re, d\u00e9couvrant sous l\u2019angle intime cette femme de pouvoir secr\u00e8te \u00e0 l\u2019intelligence politique. Ce seule en sc\u00e8ne impeccablement cisel\u00e9, subtil, cultiv\u00e9, dr\u00f4le et assassin, \u00e9mouvant aussi, parvient \u00e0 int\u00e9resser (et faire rire !) en parlant de, et seulement de, la dr\u00f4le Angela Merkel. ","performers":"Ecriture, mise en sc\u00e8ne et interpr\u00e9tation Anna Fournier \r\nAssistante \u00e0 la mise en sc\u00e8ne Marie Sambourg","boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559966"},"sp":{"name":"Guten tag, madame Merkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559966"},"nl":{"name":"Guten tag, madame Merkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559966"}},"place":{"id":7929,"translations":{"de":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_