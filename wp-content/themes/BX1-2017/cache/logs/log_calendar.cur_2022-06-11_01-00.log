:null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10308047413469},{"id":528863,"date_start":"2022-06-12","date_end":"2022-06-12","date_next":"2022-06-12","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les places bruxelloises : Le Bld Simon Bolivar et l'Esprit ouvert de Tapta","shortdescr":"Chaque place bruxelloise a son histoire faite de diff\u00e9rentes strates qui se succ\u00e8dent pour cr\u00e9er ce qui fait Bruxelles aujourd'hui.","longdescr":"Chaque place bruxelloise a son histoire faite de diff\u00e9rentes strates qui se succ\u00e8dent pour cr\u00e9er ce qui fait Bruxelles aujourd'hui. Une place est un lieu de rencontre o\u00f9 des architectures, des \u0153uvres d'art et du mobilier sont cr\u00e9\u00e9s pour faciliter l\u2019espace d\u2019\u00e9change, de circulation et de vie.\nNous vous invitons \u00e0 d\u00e9couvrir la sculpture con\u00e7ue par Tapta en1997, baptis\u00e9eEsprit ouvert \u2013 Perspectives et R\u00e9flexions. C'est le point de rencontre de diff\u00e9rentes avenues. Le trac\u00e9 de l'Avenue Simon Bolivar a \u00e9t\u00e9 envisag\u00e9 d\u00e8s la fin des ann\u00e9es 1950, dans le cadre du plan Manhattan. Ce plan pr\u00e9voyait une refonte compl\u00e8te du quartier Nord, qui devait \u00eatre un grand centre d'affaires \u00e0 l'am\u00e9ricaine. C'est entre 1970 et 1990 que les diff\u00e9rentes tours du World Trade Center ont \u00e9t\u00e9 \u00e9rig\u00e9es, dont une vient d'\u00eatre d\u00e9molie! Ces quartiers en constante \u00e9volution s'adapte \u00e0 la situation actuelle o\u00f9 de nombreux bureaux seront transform\u00e9s en espaces multifonctionnels,parmi lesquels logements, bureaux et autres affectations.\nPour respecter les pr\u00e9cautions sanitaires li\u00e9es au Covid-19, chaque visiteur devra se munir de son masque.\nCette visite est soutenue par l\u2019\u00e9chevine de l\u2019Urbanisme, des Espaces public et du Patrimoine de la ville de Bruxelles.\n4 places seront offertes pour les habitants de la ville de Bruxelles dans le Brusseleir de novembre.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528863.html"},"nl":{"name":"Les places bruxelloises : Le Bld Simon Bolivar et l'Esprit ouvert de Tapta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528863.html"},"en":{"name":"Les places bruxelloises : Le Bld Simon Bolivar et l'Esprit ouvert de Tapta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528863.html"},"de":{"name":"Les places bruxelloises : Le Bld Simon Bolivar et l'Esprit ouvert de Tapta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528863.html"},"it":{"name":"Les places bruxelloises : Le Bld Simon Bolivar et l'Esprit ouvert de Tapta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528863.html"},"sp":{"name":"Les places bruxelloises : Le Bld Simon Bolivar et l'Esprit ouvert de Tapta","shortd