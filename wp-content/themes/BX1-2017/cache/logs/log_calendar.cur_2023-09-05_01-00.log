d_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50001729,"date_start":"2023-09-23","date_end":"2023-09-24","date_next":"2023-09-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T08:45:05+02:00","published_at":"2023-09-04T08:39:23+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284501,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":1,"languages":{"spoken":["fr","en","es"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{}},"translations":{"de":{"name":"Festival Estell\u00e9s 2023 !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.billetweb.fr\/festival-estelles","email":"espaivalenciabelgica@gmail.com","phone_contact":"+32 473 86 07 02","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001729"},"pt":{"name":"Festival Estell\u00e9s 2023 !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.billetweb.fr\/festival-estelles","email":"espaivalenciabelgica@gmail.com","phone_contact":"+32 473 86 07 02","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001729"},"en":{"name":"Festival Estell\u00e9s 2023 !","shortdescr":"Come and celebrate Valencian and Belgian music at the 2nd Festival Estell\u00e9s in Brussels!\n\nFellow music lovers and party-goers, we invite you to join us for an evening of musical ecstasy and plenty of surprises! 8 hours full of music with groups from Valencia and Belgium, enchanting you with their unique sounds.\n","longdescr":"Come and celebrate Valencian and Belgian music at the Festival Estell\u00e9s in Brussels!\n\nMusic lovers and party-goers alike, we invite you to join us for the Festival Estell\u00e9s, an evening of musical ecstasy and plenty of surprises!\n\nOn the program:\n\n* 8 hours full of music: Groups from Valencia and Belgium will enchant you with their unique sounds. Among the bands on the line-up, you'll discover the lively rhythms of AUXILI and HYPERCONTENT.\n\n* Reggae, ska, techno, jazz fusion, electrocumbia and more! Our talented Belgian and Valencian DJs will have you dancing the night away. Get ready to vibrate in an unforgettable atmosphere.\n\n* Small food and beverage area to enjoy all night long.\n\nDon't miss this exceptional opportunity to celebrate Valencian and Belgian musical diversity and share memorable moments with friends. \n\nBook your tickets now and get ready for an unforgettable evening at the Festival Estell\u00e9s in Brussels! \n","performers":"Auxili (ska, reggae)\nHypercontent! (electro-jazz)\nOrop\u00e9ndola (electro-house)\nIman\u00e1 (indie-pop electro)\nJugo de Lulo (electro-cumbia)\nDr Wey (electro-house latino)\nAir Pau (techno)","boxoffice_url":null,"website":"https:\/\/www.billetweb.fr\/festival-estelles","email":"espaivalenciabelgica@gmail.com","phone_contact":"+32 473 86 07 02","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001729"},"it":{"name":"Festival Estell\u00e9s 2023 !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.billetweb.fr\/festival-estelles","email":"espaivalenciabelgica@gmail.com","phone_contact":"+32 473 86 07 02","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001729"},"cn":{"name":"Festival Estell\u00e9s 2023 !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.billetweb.fr\/festival-estelles","email":"espaivalenciabelgica@gmail.com","phone_contact":"+32 473 86 07 02","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001729"},"fr":{"name":"Festival Estell\u00e9s 2023 !","shortdescr":"Venez c\u00e9l\u00e9brer la musique valencienne et belge au 2\u00e8me Festival Estell\u00e9s de Bruxelles !\n\nAmis m\u00e9lomanes et amateurs de la f\u00eate, nous vous invitons \u00e0 nous rejoindre pour une soir\u00e9e de pure extase musicale et plein de surprises ! 8h de musique envo\u00fbtante avec des groupes valenciens et belges qui vous enchanteront avec leurs sons uniques.\n","longdescr":"Venez c\u00e9l\u00e9brer la musique valencienne et belge au Festival Estell\u00e9s de Bruxelles !\n\nAmis m\u00e9lomanes et amateurs de la f\u00eate, nous vous invitons \u00e0 rejoindre le Festival Estell\u00e9s, une soir\u00e9e de pure extase musicale et plein de surprises !\n\nAu programme :\n\n* 8h de musique envo\u00fbtante : Des groupes valenciens et belges vous enchanteront avec leurs sons uniques. Parmi les groupes \u00e0 l'affiche, vous pourrez d\u00e9couvrir les rythmes entra\u00eenants de AUXILI et HYPERCONTENT.\n\n* Reggae, ska, techno, fusion jazz, electrocumbia et bien plus ! Nos talentueux DJ belges et valenciens vous feront danser jusqu'au bout de la nuit. Pr\u00e9parez-vous \u00e0 vibrer dans une ambiance inoubliable.\n\n* Petit espace de restauration et boissons pour profiter all night long.\n\nNe manquez pas cette occasion exceptionnelle de c\u00e9l\u00e9brer la diversit\u00e9 musicale valencienne et belge et de partager des moments m\u00e9morables entre amis. \n\nR\u00e9servez votre ticket d\u00e8s maintenant et pr\u00e9parez-vous pour une soir\u00e9e inoubliable au Festival Estell\u00e9s de Bruxelles ! \n","performers":"Auxili (ska, reggae)\nHypercontent! (electro-jazz)\nOrop\u00e9ndola (electro-house)\nIman\u00e1 (indie-pop electro)\nJugo de Lulo (electro-cumbia)\nDr Wey (electro-house latino)\nAir Pau (techno)","boxoffice_url":null,"website":"https:\/\/www.billetweb.fr\/festival-estelles","email":"espaivalenciabelgica@gmail.com","phone_contact":"+32 473 86 07 02","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001729"},"sp":{"name":"Festival Estell\u00e9s 2023 !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.billetweb.fr\/festival-estelles","email":"espaivalenciabelgica@gmail.com","phone_contact":"+32 473 86 07 02","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001729"},"nl":{"name":"Festival Estell\u00e9s 2023 !","shortdescr":"Kom Valenciaanse en Belgische muziek vieren op het 2e Festival Estell\u00e9s in Brussel!\n\nMedemuziekliefhebbers en feestvierders, we nodigen jullie uit voor een avond pure muzikale extase en veel verrassingen! 8 uur lang muziek met groepen uit Valencia en Belgi\u00eb, die je betoveren met hun unieke klanken.","longdescr":"Kom Valenciaanse en Belgische muziek vieren op het Festival Estell\u00e9s in Brussel!\n\nMedemuziekliefhebbers en feestvierders, wij nodigen jullie uit voor het Festival Estell\u00e9s, een avond van pure muzikale extase en vele verrassingen!\n\nOp het programma:\n\n* 8 uur muziek: groepen uit Valencia en Belgi\u00eb zullen je betoveren met hun unieke klanken. Op het programma staan onder andere AUXILI en HYPERCONTENT.\n\n* Reggae, ska, techno, jazzfusion, electrocumbia en meer! Onze getalenteerde Belgische en Valenciaanse DJ's zullen je de hele nacht laten dansen. Maak je klaar om te vibreren in een onvergetelijke sfeer.\n\n* Kleine eet- en drinkgelegenheid om de hele nacht van te genieten.\n\nMis deze uitzonderlijke kans niet om de Valenciaanse en Belgische muzikale diversiteit te vieren en onvergetelijke momenten te delen met vrienden. \n\nReserveer nu je tickets en maak je klaar voor een onvergetelijke avond op het Festival Estell\u00e9s in Brussel! \n","performers":"Auxili (ska, reggae)\nHypercontent! (electro-jazz)\nOrop\u00e9ndola (electro-house)\nIman\u00e1 (indie-pop electro)\nJugo de Lulo (electro-cumbia)\nDr Wey (electro-house latino)\nAir Pau (techno)","boxoffice_url":null,"website":"https:\/\/www.billetweb.fr\/festival-estelles","email":"espaivalenciabelgica@gmail.com","phone_contact":"+32 473 86 07 02","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001729"}},"place":{"id":273242,"translations":{"de":{"name":"LaVall\u00e9e","address_street_name":"Rue Adolphe Lavall\u00e9e","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Adolphe Lavall\u00e9e, 39","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"LaVall\u00e9e","address_street_name":"Rue Adolphe Lavall\u00e9e","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Adolphe Lavall\u00e9e, 39","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"LaVall\u00e9e","address_street_name":"Adolphe Lavall\u00e9e Street","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_booking":null,"address_zip":"1080","address_cit