0:00:00","end":"17:00:00"}]}},"translations":{"fr":["lundi, mardi, jeudi, vendredi et samedi: ferm\u00e9","mercredi: de 13:00 \u00e0 16:00","dimanche: de 10:00 \u00e0 17:00"],"nl":["maandag, dinsdag, donderdag, vrijdag en zaterdag: gesloten","woensdag: van 13:00 tot 16:00","zondag: van 10:00 tot 17:00"],"en":["monday, tuesday, thursday, friday and saturday: closed","wednesday: from 13:00 to 16:00","sunday: from 10:00 to 17:00"]},"date_start":"2018-01-01","date_end":"2022-12-31","is_also_by_appointment":false}],"date_exceptions":[{"day":"2020-05-01","start":"10:00:00","end":"17:00:00"},{"day":"2021-11-01","start":"10:00:00","end":"17:00:00"}],"prices":[{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":8}],"child_events":[],"parent_events":[513352],"targets":{"list":[11,10],"translations":{"fr":["Famille","Seniors"],"nl":["Familie","Senioren"],"en":["Family","Seniors"]}},"visit_profile":{"list":[320],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:06:56+02:00","published_at":"2016-03-17T15:49:56+01:00","backoffice_id":103411,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10308047413469},{"id":537685,"date_start":"2022-07-25","date_end":"2022-07-29","date_next":"2022-07-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Journ\u00e9es des Cara\u00efbes","shortdescr":"La Chambre de commerce des Cara\u00efbes en Europe (CCCE) est fi\u00e8re de lancer la premi\u00e8re promotion annuelle des \u00ab Journ\u00e9es des Cara\u00efbes \u00bb, qui se tiendra au Sofitel Brussels Europe du 25 au 31 juillet 2022, avec en vedette une Semaine culinaire carib\u00e9enne au \u2018Restaurant 1040\u2019 du Sofitel Brussels Europe.","longdescr":"Pendant la Semaine culinaire des Cara\u00efbes, le c\u00e9l\u00e8bre chef carib\u00e9en Orlando \u2013venant de Sainte-Lucie- pr\u00e9parera un menu gastronomique des Cara\u00efbes de 4 plats, une occasion unique de d\u00e9couvrir la meilleure cuisine des Cara\u00efbes \u00e0 un tarif sp\u00e9cial de 49 euros, y compris un plat bonus et une boisson digestive gratuite.\r\nDerrick Orlando Satchell, mieux connu sous le nom de Chef Orlando, est un chef de cuisine britannique (d\u2019origine jama\u00efcaine-barbadienne), internationalement accr\u00e9dit\u00e9 et prim\u00e9, qui a fait de Sainte-Lucie sa maison, o\u00f9 il poss\u00e8de et exploite Orlando\u2019s Restaurant & Bar, situ\u00e9 au Fond Bernier \u00e0 Soufri\u00e8re au sud de l\u2019\u00eele.\r\nL\u2019\u00e9tablissement culinaire du Chef Orlando a \u00e9t\u00e9 accr\u00e9dit\u00e9 comme l\u2019un des trois meilleurs dans la Cara\u00efbe et il a remport\u00e9 le prestigieux titre de \u00ab Chef de l\u2019ann\u00e9e carib\u00e9enne \u00bb aux Caribbean Travel Awards 2020. Le v\u00e9t\u00e9ran de la gastronomie a \u00e9t\u00e9 \u00e9lu l\u2019un des meilleurs chefs de la r\u00e9gion en 2018 et 2019 par le Caribbean Journal, et a \u00e9t\u00e9 reconnu comme le seul restaurant des Cara\u00efbes \u00e0 \u00eatre consid\u00e9r\u00e9 comme l\u2019un des meilleurs au monde par les lecteurs des Travel & Leisure et Food & Wine en 2020. Orlando\u2019s Restaurant & Bar est en effet le seul restaurant carib\u00e9en \u00e0 avoir obtenu cette distinction par ces publications class\u00e9es ; la liste annuelle du Meilleur Restaurant du Monde, une collaboration entre Travel + Leisure et Food & Wine, est une c\u00e9l\u00e9bration des restaurants du monde entier qui capturent le mieux l\u2019esprit, la culture et la cuisine de leurs communaut\u00e9s.\r\nEn 2019, le chef Orlando a \u00e9galement \u00e9t\u00e9 r\u00e9compens\u00e9 par un prix de Gault Millau France, et l\u2019un des meilleurs restaurants \u00e0 d\u00eener dans la Cara\u00efbe \u00e0 de nombreuses reprises par by Trip Advisor.","performers":"Le c\u00e9l\u00e8bre chef carib\u00e9en Orlando \u2013venant de Sainte-Lucie- pr\u00e9parera un menu gastronomique des Cara\u00efbes de 4 plats, une occasion unique de d\u00e9couvrir la meilleure cuisine des Cara\u00efbes \u00e0 un tarif sp\u00e9cial de 49 euros, y compris un plat bonus et une boisson digestive gratuite.","boxoffice_url":null,"website":null,"email":"h5282-fb@sofitel.com","phone_contact":"+32 2 681 03 93","phone_booking":"+32 2 235 51 35","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537685.html"},"nl":{"name":"Cara\u00efbische Dagen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537685.html"},"en":{"name":"Caribbean Days","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537685.html"},"de":{"name":"Journ\u00e9es des Cara\u00efbes - Caribbean Days - Cara\u00efbische Dagen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/537685.html"},"it":{"name":"Journ\u00e9es des Cara\u00efbes - Caribbean Days - Cara\u00efbische Dagen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contac