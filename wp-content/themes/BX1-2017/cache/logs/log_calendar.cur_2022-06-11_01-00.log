ns":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":13.9},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Jobseekers"}},"value":10.8},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":10.8},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,265,266],"translations":{"fr":["Accessible","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-06T01:07:31+02:00","published_at":"2022-05-06T13:47:06+02:00","backoffice_id":253274,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.27909200099982},{"id":528355,"date_start":"2022-03-06","date_end":"2022-07-03","date_next":"2022-07-03","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"family day @ argos","shortdescr":"embrace your inner child","longdescr":"Tous les premiers dimanche du mois, c'est Family Day! Ce jour-l\u00e0, argos vous encourage \u00e0 venir visiter nos expos en famille. Invitez donc les cousins, la grand-m\u00e8re et tous les membres de votre famille choisie. On accueille les plus petits avec des ateliers et des visites guid\u00e9es adapt\u00e9es et en trois langues, et le bar s'adapte \u00e9galement: chacun et chacune y trouvera son compte! \r\n\r\nNotez d\u00e9j\u00e0 les prochaines dates dans vos agendas: le 5 juin, on transforme nos bo\u00eetes \u00e0 chaussures en diorama et le 3 juillet, on pr\u00e9voit un atelier podcast! \r\n\r\nPlus d'informations sur notre site!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.argosarts.org","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528355.html"},"nl":{"name":"family day @ argos","shortdescr":"embrace your inner child","longdescr":"Elke eerste zondag van de maand is het Family Day. Dan moedigt argos je aan om met het hele gezin op bezoek te komen. Nodig dus gerust al je neefjes en je oma uit, en vergeet de leden van je 'gekozen familie' niet! Voor de kleinsten zijn er workshops en rondleidingen op kindermaat. Aan de bar is er voor ieder wat wils! \r\n\r\nNoteer alvast volgende data in je agenda: op 5 juni maken we kijkdozen en op 3 juli plannen we een heuse podcast workshop! \r\n\r\nMeer info op onze website","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528355.html"},"en":{"name":"family day @ argos","shortdescr":"embrace your inner child","longdescr":"As of 2022, argos hosts family days every first Sunday of each month. Children, young people, parents, adults and non-parents are all welcome to visit our exhibition together.\r\n\r\nOn these occasions, our bar provides special treats that cater to all. Guides adapt their tours to kids and their families. Two playful, participatory workshops are programmed throughout the afternoon in English, French, and Dutch. Always linked to the current exhibitions, the activities are renewed each time, highlighting an artistic technique or an aspect of the exhibition.\r\n\r\nKeep an eye on our website for updates!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528355.html"},"de":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528355.html"},"it":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528355.html"},"sp":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528355.html"},"pt":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528355.html"},"cn":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528355.html"}},"place":{"id":228372,"translations":{"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9 en 1989 \u00e0 Bruxelles, argos est un lieu ressource pour la pr\u00e9sentation, la production et le d\u00e9veloppement des arts audiovisuels critiques, ainsi que pour leur distribution, conservation et restauration.\r\n\r\nargos consid\u00e8re l\u2019audiovisuel comme un moyen des plus pertinents pour regarder et comprendre le monde de mani\u00e8re ouverte et int\u00e9gr\u00e9e. Soutenant les voix alternatives dans la soci\u00e9t\u00e9, il favorise le dialogue avec un large \u00e9ventail de partenaires institutionnels ou non, tant \u00e0 Bruxelles qu\u2019ailleurs. argis recherche sans cesse de nouvelles fa\u00e7ons d'impliquer et d\u2019associer les publics les plus larges.\r\n\r\nargos  con\u00e7oit des expositions et programmations, distribue les \u0153uvres audiovisuelles les plus contemporaines et critiques; sa mission par ailleurs constitue, conserve et fait conna\u00eetre un tr\u00e8s important fonds de films et de vid\u00e9os d\u2019artistes. Il comporte \u00e9galement une m\u00e9diath\u00e8que unique en son genre, ouverte aux professionnels et au grand public. Celle-ci inclut une tr\u00e8s large s\u00e9lection de publications et les \u0153uvres audiovisuelles de la collection. De plus, ARGOS d\u00e9veloppe des projets de recherche in\u00e9dits pour pallier les lacunes importantes dans l'histoire de l'art, questionnant les relations entre culture et soci\u00e9t\u00e9.\r\n\r\n\u00c0 travers ces multiples activit\u00e9s, argis a pour objectif de permettre une meilleure compr\u00e9hension du pass\u00e9 et du pr\u00e9sent des arts audiovisuels tout en fournissant les outils pour imaginer et fa\u00e7onner collectivement leur avenir.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"nl":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussel","address_line1":"Werfstraat, 13","address_line2":"1000 Brussel","description_web":"argos werd opgericht in 1989 in Brussel en is een instituut, en bron, voor de studie, productie en vooruitgang van kritische audiovisuele kunsten, evenals de distributie, het behoud en de restauratie ervan.\r\n\r\nargos beschouwt het audiovisuele als een belangrijk middel om op meer open en ge\u00efntegreerde manieren de wereld te bekijken en te begrijpen. We ondersteunen een veelheid aan stemmen in de samenleving en gaan in dialoog met een breed scala aan institutionele en niet-institutionele partners, zowel in Brussel als daarbuiten. Zo willen we een steeds ruimer en \u200b\u200bmeer divers publiek bij onze activiteiten betrekken.\r\n\r\n\u249c\u24ad\u24a2\u24aa\u24ae maakt tentoonstellingen en programma's, distribueert audiovisuele werken en bouwt, beheert en ontsluit een prominente collectie van kunstenaarfilms en -video's. We hebben ook een unieke mediatheek met een ruime selectie van publicaties en de audiovisuele werken van de collectie, die zowel voor professionals als het algemene publiek toegankelijk is. Daarnaast ontwikkelen we originele onderzoeksprojecten met betrekking tot vooraanstaande hiaten in de kunstgeschiedenis en de relatie ervan tot cultuur en maatschappij.\r\n\r\nVia deze verschillende activiteiten wil argos het verleden en het heden van de audiovisuele kunsten beter doorgronden, en ook instrumenten bieden om collectief hun toekomst in te beelden en opnieuw vorm te geven.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"en":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat\/ Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussels","address_line1":"Werfstraat\/ Rue du Chantier, 13","address_line2":"1000 Brussels","description_web":"Founded in 1989 in Brussels, argos is an institution and resource for the presentation, production, and study of critical audiovisual arts, as well as for its distribution, conservation and restoration. argos considers the audiovisual as a primary means of looking at and understanding the world in more open and integrated ways. Supporting a multiplicity of voices in society, it fosters dialogue with a broad range of institutional and non-institutional partners, both in Brussels and beyond, and seeks new ways to engage diverse audiences. \r\n\r\nargos makes exhibitions and programmes, distributes moving image works, and builds, preserves, and discloses a prominent collection of artist films and videos. It also houses a unique media library containing a broad selection of publications, as well as the audiovisual works of the collection, which is open to both professionals and the general public. Additionally, it develops original research projects relating to significant gaps in art history and its relationship to culture and society. Through these various activities, argos aims to more fully understand the past and present of audiovisual arts, as well as provide tools to collectively imagine and shape its futures.\r\n","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":"art_center","facebook_id":null,"backoffice_id":769,"location":{"lat":50.85663153,"lon":4.34963277},"region":"brussels","last_updated_at":"2022-06-06T01:08:36+02:00","published_at":"2013-10-19T01:13:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":228372,"translations":{"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9 en 1989 \u00e0 Bruxelles, argos est un lieu ressource pour la pr\u00e9sentation, la production et le d\u00e9veloppement des arts audiovisuels critiques, ainsi que pour leur distribution, conservation et restauration.\r\n\r\nargos consid\u00e8re l\u2019audiovisuel comme un moyen des plus pertinents pour regarder et comprendre le monde de mani\u00e8re ouverte et int\u00e9gr\u00e9e. Soutenant les voix alternatives dans la soci\u00e9t\u00e9, il favorise le dialogue avec un large \u00e9ventail de partenaires institutionnels ou non, tant \u00e0 Bruxelles qu\u2019ailleurs. argis recherche sans cesse de nouvelles fa\u00e7ons d'impliquer et d\u2019associer les publics les plus larges.\r\n\r\nargos  con\u00e7oit des expositions et programmations, distribue les \u0153uvres audiovisuelles les plus contemporaines et critiques; sa mission par ailleurs constitue, conserve et fait conna\u00eetre un tr\u00e8s important fonds de films et de vid\u00e9os d\u2019artistes. Il comporte \u00e9galement une m\u00e9diath\u00e8que unique en son genre, ouverte aux professionnels et au grand public. Celle-ci inclut une tr\u00e8s large s\u00e9lection de publications et les \u0153uvres audiovisuelles de la collection. De plus, ARGOS d\u00e9veloppe des projets de recherche in\u00e9dits pour pallier les lacunes importantes dans l'histoire de l'art, questionnant les relations entre culture et soci\u00e9t\u00e9.\r\n\r\n\u00c0 travers ces multiples activit\u00e9s, argis a pour objectif de permettre une meilleure compr\u00e9hension du pass\u00e9 et du pr\u00e9sent des arts audiovisuels tout en fournissant les outils pour imaginer et fa\u00e7onner collectivement leur avenir.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"nl":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussel","address_line1":"Werfstraat, 13","address_line2":"1000 Brussel","description_web":"argos werd opgericht in 1989 in Brussel en is een instituut, en bron, voor de studie, productie en vooruitgang van kritische audiovisuele kunsten, evenals de distributie, het behoud en de restauratie ervan.\r\n\r\nargos beschouwt het audiovisuele als een belangrijk middel om op meer open en ge\u00efntegreerde manieren de wereld te bekijken en te begrijpen. We ondersteunen een veelheid aan stemmen in de samenleving en gaan in dialoog met een breed scala aan institutionele en niet-institutionele partners, zowel in Brussel als daarbuiten. Zo willen we een steeds ruimer en \u200b\u200bmeer divers publiek bij onze activiteiten betrekken.\r\n\r\n\u249c\u24ad\u24a2\u24aa\u24ae maakt tentoonstellingen en programma's, distribueert audiovisuele werken en bouwt, beheert en ontsluit een prominente collectie van kunstenaarfilms en -video's. We hebben ook een unieke mediatheek met een ruime selectie van publicaties en de audiovisuele werken van de collectie, die zowel voor professionals als het algemene publiek toegankelijk is. Daarnaast ontwikkelen we originele onderzoeksprojecten met betrekking tot vooraanstaande hiaten in de kunstgeschiedenis en de relatie ervan tot cultuur en maatschappij.\r\n\r\nVia deze verschillende activiteiten wil argos het verleden en het heden van de audiovisuele kunsten beter doorgronden, en ook instrumenten bieden om collectief hun toekomst in te beelden en opnieuw vorm te geven.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"en":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat\/ Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussels","address_line1":"Werfstraat\/ Rue du Chantier, 13","address_line2":"1000 Brussels","description_web":"Founded in 1989 in Brussels, argos is an institution and resource for the presentation, production, and study of critical audiovisual arts, as well as for its distribution, conservation and restoration. argos considers the audiovisual as a primary means of looking at and understanding the world in more open and integrated ways. Supporting a multiplicity of voices in society, it fosters dialogue with a broad range of institutional and non-institutional partners, both in Brussels and beyond, and seeks new ways to engage diverse audiences. \r\n\r\nargos makes exhibitions and programmes, distributes moving image works, and builds, preserves, and discloses a prominent collection of artist films and videos. It also houses a unique media library containing a broad selection of publications, as well as the audiovisual works of the collection, which is open to both professionals and the general public. Additionally, it develops original research projects relating to significant gaps in art history and its relationship to culture and society. Through these various activities, argos aims to more fully understand the past and present of audiovisual arts, as well as provide tools to collectively imagine and shape its futures.\r\n","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":"art_center","facebook_id":null,"backoffice_id":769,"location":{"lat":50.85663153,"lon":4.34963277},"region":"brussels","last_updated_at":"2022-06-06T01:08:36+02:00","published_at":"2013-10-19T01:13:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/5476cbd9a827f0debd641efdf848e651f76e395c.png","width":1056,"height":570,"ratio":1.85,"translations":{"fr":{"title":"family day @ argos","copyright":"Celestrana (1986) \u00a9 Laraaji"},"nl":{"title":"family day @ argos","copyright":"Celestrana (1986) \u00a9 Laraaji"},"en":{"title":"family day @ argos","copyright":"Celestrana (1986) \u00a9 Laraaji"}}}],"dates":[{"day":"2022-03-06","doors":null,"start":"12:00:00","end":"19:00:00"},{"day":"2022-04-03","doors":null,"start":"12:00:00","end":"19:00:00"},{"day":"2022-05-01","doors":null,"start":"12:00:00","end":"19:00:00"},{"day":"2022-06-05","doors":null,"start":"12:00:00","end":"19:00:00"},{"day":"2022-07-03","doors":null,"start":"12:00:00","end":"19:00:00"}],"recurring":[{"day":"sunday","occurences":{"is_first":true,"is_second":false,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"12:00:00","time_end":"19:00:00","translations":{"fr":"Ouvert le premier dimanche du mois de 12:00 \u00e0 19:00","nl":"Open op de eerste zondag van de maand van 12:00 tot 19:00","en":"Open the first sunday of the month from 12:00 to 19:00"}}],"prices":[{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[2,3,4,5,7,8],"translations":{"fr":["Enfants 0-3 ans","Enfants 3-6 ans","Enfants 6-9 ans","Enfants 9-12 ans","Jeunes 12-15 ans","Jeunes 15-18 ans"],"nl":["Kinderen 0-3 j.","Kinderen 3-6 j.","Kinderen 6-9 j.","Kinderen 9-12 j.","Jongeren 12-15 j.","Jongeren 15-18 j."],"en":["Children 0-3 yr.","Children 3-6 yr.","Children 6-9 yr.","Children 9-12 yr.","Youth 12-15  yr.","Youth 15-18  yr."]}},"tags":["kids"],"accessibilities":{"list":[255,257,259,263],"translations":{"fr":["Accessible","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-06T01:08:37+02:00","published_at":"2022-02-25T09:09:13+01:00","backoffice_id":248355,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.25614999088441},{"id":528907,"date_start":"2022-04-10","date_end":"2022-09-18","date_next":"2022-07-03","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La Grand-Place de Bruxelles pour tout public","shortdescr":"Visite guid\u00e9e de la Grand-Place de Bruxelles, \u00e0 destination du grand public : la Grand-Place \"tout-en-un\", pour les touristes de passage. Pour mes compatriotes qui n'ont pas encore pris le temps de vraiment s'arr\u00eater pour la contempler et la comprendre.","longdescr":"Amis touristes de passage, chers compatriotes en vacances, vous souhaitez une visite guid\u00e9e de qualit\u00e9 de la Grand-Place ? Sans le s\u00e9rieux pompeux des guides des monuments officiels, mais avec la garantie qualitative offerte par un guide professionnel patent\u00e9 ?\r\nLe tout, par un bruxellois de souche ? Vous \u00eates au bon endroit !\r\nVenez d\u00e9couvrir tous les aspects de \"la plus belle place du monde\", afin de savoir de quoi vous parlerez, lorsque vous partagerez votre album photos.\r\nUne visite s\u00e9rieuse ... sans se prendre au s\u00e9rieux. Bruxelloise, quoi, un fois !\r\nProgramme de la visite : \r\n*pourquoi la Grand-Place ? que signifie-t-elle dans l'Histoire de la ville ? \r\n*en quoi est-elle bien repr\u00e9sentative du c\u00f4t\u00e9 frondeur et provocateur des bruxellois (\u00e0 l'image du paragraphe ci-dessus; clin d'oeil entendu) ?\r\n*patrimoine de l'Unesco ?, \"la plus belle place du monde\" : vraiment ? En quoi m\u00e9rite-t-elle ces titre et distinction ?\r\n*pr\u00e9sentation des b\u00e2timents principaux, description de leur r\u00f4le dans l'Histoire, * *observation des principales caract\u00e9ristiques architecturales et interpr\u00e9tation des fa\u00e7ades les plus spectaculaires\r\n* d\u00e9couverte de quelques d\u00e9tails qui font tout le charme et donnent un c\u00f4t\u00e9 croustillant, voire \u00e9nigmatique \u00e0 cette Grand-Place de Bruxelles : mythologie, alchimie, franc-ma\u00e7onnerie, provocations politiques, ... mais que voil\u00e0 une belle brochette, mise en app\u00e9tit, avant d'aller d\u00e9guster une bonne bi\u00e8re locale !","performers":"Vincent Beckers, guide touristique et r\u00e9gional","boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528907.html"},"nl":{"name":"La Grand-Place de Bruxelles pour tout public","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528907.html"},"en":{"name":"La Grand-Place de Bruxelles pour tout public","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528907.html"},"de":{"name":"La Grand-Place de Bruxelles pour tout public","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528907.html"},"it":{"name":"La Grand-Place de Bruxelles pour tout public","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528907.html"},"sp":{"name":"La Grand-Place de Bruxelles pour tout public","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528907.html"},"pt":{"name":"La Grand-Place de Bruxelles pour tout public","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528907.html"},"cn":{"name":"La Grand-Place de Bruxelles pour tout public","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528907.html"}},"place":{"id":475,"translations":{"fr":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"\u00c9l\u00e9gant b\u00e2timent datant du 15\u00e8me si\u00e8cle, l\u2019H\u00f4tel de Ville de Bruxelles se situe au c\u0153ur du centre historique, sur la somptueuse Grand-Place.\r\nSouvent consid\u00e9r\u00e9 comme la pi\u00e8ce ma\u00eetresse de la plus belle place du monde, il est probablement l\u2019un des plus beaux \u00e9difices du pays et \u00e9videmment l\u2019un des monuments \u00e0 ne pas manquer lors de votre s\u00e9jour \u00e0 Bruxelles. Sa splendide tour se dresse tel un rep\u00e8re aussi bien pour les curieux d\u2019un jour que les belges de passage dans le centre de la capitale.\r\nUn r\u00e9gal pour les yeux\r\nParticuli\u00e8rement imposant par ses dimensions, ses remarquables d\u00e9cors sculpt\u00e9s et sa fa\u00e7ade asym\u00e9trique, il attire rapidement les regards. En vous promenant devant ce prestigieux b\u00e2timent, peut-\u00eatre que vous apercevrez aux balcons de jeunes mari\u00e9s c\u00e9l\u00e9brer leur union.\r\nL\u2019int\u00e9rieur de l\u2019H\u00f4tel de Ville vaut \u00e9galement le d\u00e9tour. Il attise la curiosit\u00e9 de ceux qui souhaitent d\u00e9couvrir la disposition et l\u2019am\u00e9nagement des diff\u00e9rentes salles de ce chef-d\u2019\u0153uvre architectural. Des visites guid\u00e9es de l\u2019H\u00f4tel de Ville de Bruxelles sont r\u00e9guli\u00e8rement organis\u00e9es afin de d\u00e9couvrir la richesse de cet int\u00e9rieur qui ne cesse d\u2019\u00e9blouir les visiteurs.\r\nL\u2019\u00e9volution d\u2019un b\u00e2timent singulier\r\nSa construction s'\u00e9tale sur une longue p\u00e9riode et voit d\u00e9filer plusieurs architectes. \u00c0 l\u2019origine, l\u2019\u00e9difice ne comptait qu\u2019un beffroi et la partie gauche qui elle est rest\u00e9e identique jusqu\u2019\u00e0 aujourd\u2019hui. Le beffroi, quant \u00e0 lui, est par contre rapidement remplac\u00e9 par la tour actuelle lorsque les maisons des diff\u00e9rentes corporations de m\u00e9tiers s\u2019installent sur la place. Une aile suppl\u00e9mentaire est \u00e9galement ajout\u00e9e sur la droite pour inclure au mieux ces immeubles dans cet incomparable d\u00e9cor.\r\nAu sommet de la nouvelle tour, haute de plus de 90m, la fl\u00e8che est couronn\u00e9e de l\u2019archange Saint-Michel, grand Patron de la ville de Bruxelles. Cette statue en cuivre dor\u00e9 sert en r\u00e9alit\u00e9 de girouette. Si les vents vous sont favorables, vous aurez l\u2019occasion de pouvoir admirer convenablement la mani\u00e8re dont cet embl\u00e8me vient \u00e0 bout du dragon !\r\nActuellement, ce joyau du patrimoine bruxellois abrite l\u2019office du Tourisme.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stadhuis Brussel","address_street_name":"Grote Markt","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"Het elegante stadhuis van Brussel dateert uit de 15de eeuw en ligt in het historische hart van de stad, op de prachtige Grote Markt. \r\n\r\nHet wordt vaak beschouwd als het absolute pronkstuk van het mooiste plein ter wereld en is wellicht een van de mooiste gebouwen van het land. Het is dan ook een niet te missen monument tijdens je bezoek aan Brussel. Zijn prachtige toren is een herkenningspunt voor zowel de dagjestoeristen als de Belgen die door het stadscentrum kuieren. \r\nEen lust voor het oog \r\nNiet alleen de indrukwekkende afmetingen van het gebouw, maar ook de opmerkelijke gebeeldhouwde ornamenten en de asymmetrische gevel trekken meteen de aandacht. En terwijl je dit prestigieuze gebouw voorbij wandelt, word je misschien toegewuifd door een pasgetrouwd stel op het balkon ... \r\nHet interieur van het stadhuis is eveneens een omweg waard. Wie wil, kan een blik werpen op de indeling en de inrichting van de verschillende zalen van dit architecturale meesterwerk. Er worden regelmatig rondleidingen in het Brussels stadhuis georganiseerd om de rijkdom van het interieur aan de bezoekers te tonen. \r\nEvolutie van een uniek gebouw \r\nHet gebouw werd over een lange periode ontworpen door verschillende architecten. Oorspronkelijk bestond het enkel uit een belfort en het linkerdeel, dat ongewijzigd is gebleven. Het belfort daarentegen werd al snel vervangen door de huidige toren, toen de huizen van de verschillende gilden zich op de grote markt begonnen te vestigen. Aan de rechterkant werd een extra vleugel bijgebouwd, om deze gebouwen beter in dit unieke decor op te nemen. \r\nBovenaan de meer dan 90 meter hoge, nieuwe toren, werd de torenspits bekroond met aartsengel Micha\u00ebl, de beschermheilige van de stad Brussel. Het standbeeld in verguld koper doet in werkelijkheid dienst als windwijzer. Bij gunstige wind kan je zelfs zien hoe dit embleem de draak velt! \r\nMomenteel is de toeristische dienst ondergebracht in dit pronkstuk van het Brusselse erfgoed. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Brussels Town Hall","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"An elegant building dating back to the 15th century, the City of Brussels Town Hall is located in the heart of the historical centre, on the sumptuous Grand-Place.\r\nOften considered to be the centrepiece of the most beautiful square in the world, it is undoubtedly one of the most stunning buildings in Belgium and definitely one of the unmissable highlights of your stay in Brussels. Its splendid tower stands as a landmark both for day-trippers and Belgians passing through the centre of the capital.\r\n\r\nA feast for the eyes\r\nParticularly imposing due to its size, its remarkable sculpted decorations and its asymmetrical facade, it quickly catches the eye. Walking in front of this prestigious building, you might spot newlyweds celebrating their union on the balconies.\r\nThe Town Hall's interior is also well worth a visit. It attracts the curiosity of those who want to know more about the layout and arrangement of the different rooms of this architectural masterpiece. Guided tours of the City of Brussels Town Hall are regularly organised and let you discover the richness of this interior which never fails to dazzle its visitors.\r\n\r\nThe evolution of a unique building\r\nIts construction was spread out over a long period of time and is the work of several architects. Originally, the building had only a belfry and the left part of the building has remained the same until today. The belfry, on the other hand, was quickly replaced by the current tower when the houses of the various trade guilds moved into the square. An additional wing was also added on the right to better incorporate these buildings into this exceptional setting.\r\nAt the top of the new tower, more than 90m high, the spire is crowned with the Archangel Saint-Michel, the patron saint of the City of Brussels. This gilded copper statue is actually used as a weather vane. If the winds blow the right way, you can admire the city's hero as he defeats the dragon!\r\nThis jewel of Brussels' architectural heritage currently houses the Tourist Office.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Rathaus Br\u00fcssel","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Rathaus ist ein elegantes Bauwerk aus dem 15. Jahrhundert, gelegen auf dem pr\u00e4chtigen Grand-Place im Herzen des historischen Stadtzentrums. \r\n\r\nEs gilt als das architektonische Meisterwerk eines der sch\u00f6nsten Pl\u00e4tze der Welt und z\u00e4hlt dar\u00fcber hinaus zu den wahrscheinlich eindrucksvollsten Bauwerken Belgiens, das Sie bei Ihrem Besuch in Br\u00fcssel unbedingt besichtigen sollten. Zu verfehlen ist es kaum, denn sein majest\u00e4tischer Turm ragt hoch in den Br\u00fcsseler Himmel hinein.  \r\n\r\nEin Augenschmaus \r\n\r\nInsbesondere seine imposanten Dimensionen, seine bemerkenswerten skulpturalen Verzierungen und seine asymmetrische Fassade fallen sofort ins Auge. Und wenn man Gl\u00fcck hat, kann man auf dem majest\u00e4tischen Balkon einen Blick auf ein frischgebackenes Brautpaar erhaschen. \r\n\r\nAuch das Innere des Rathauses ist einen Besuch wert, denn die Aufteilung und die Anordnung der verschiedenen S\u00e4le dieses architektonischen Meisterwerks sind absolut sehenswert. Es finden regelm\u00e4\u00dfig F\u00fchrungen durch das Br\u00fcsseler Rathaus statt, die spannende Einblicke in die Reicht\u00fcmer des Interieurs gew\u00e4hren, das die Besucher immer wieder aufs Neue begeistert. \r\n\r\nDie Entstehung eines einzigartigen Geb\u00e4udes \r\n\r\nDer Bau des Rathauses erstreckte sich \u00fcber einen relativ langen Zeitraum und war das Werk mehrerer Architekten. Urspr\u00fcnglich bestand das Geb\u00e4ude nur aus einem Glockenturm und dem bis heute unver\u00e4nderten linken Geb\u00e4udefl\u00fcgel. Der Glockenturm hingegen wurde schon bald durch den heutigen Turm ersetzt, als sich die H\u00e4user der verschiedenen Handwerksz\u00fcnfte am Grand-Place niederlie\u00dfen. Um das Geb\u00e4ude noch harmonischer in das Stadtbild einzuf\u00fcgen, wurde ein zus\u00e4tzlicher Fl\u00fcgel auf der rechten Seite hinzugef\u00fcgt. \r\n\r\nAn der Spitze des neuen, mehr als 90 m hohen Turms  thront der Erzengel Michael, der Schutzpatron der Stadt Br\u00fcssel. Die vergoldete Kupferstatue dient eigentlich als Wetterfigur \u2013 und wenn der Wind g\u00fcnstig steht, k\u00f6nnen Sie beobachten, wie die die Engelsfigur den Drachen besiegt! \r\n\r\nDerzeit beherbergt dieses Kleinod des Br\u00fcsseler Architekturerbes das Tourismusb\u00fcro.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Municipio di Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Elegante edificio risalente al 15\u00b0 secolo, il municipio di Bruxelles si trova nel cuore del centro storico, nella sontuosa Grand-Place. \r\n\r\nSpesso considerato come l\u2019elemento centrale della piazza pi\u00f9 bella del mondo, \u00e8 probabilmente uno degli edifici pi\u00f9 belli del paese e sicuramente uno dei monumenti da non perdere quando si visita Bruxelles. La sua splendida torre funge da punto di riferimento sia per i turisti che per i belgi di passaggio nel centro della capitale. \r\n\r\nUna festa per gli occhi \r\n\r\nParticolarmente imponente per le sue dimensioni, le sue stupende decorazioni scolpite e la sua facciata asimmetrica, cattura rapidamente l\u2019attenzione. Passeggiando davanti a tale edificio prestigioso, \u00e8 possibile scorgere sui balconi gli sposi novelli intenti a festeggiare il loro matrimonio. \r\n\r\nVale la pena visitare anche gli interni del municipio. Suscitano la curiosit\u00e0 di chi desidera scoprire la disposizione e l\u2019arredamento delle varie sale di questo capolavoro architettonico. Vengono periodicamente organizzate visite guidate al municipio di Bruxelles durante le quali \u00e8 possibile ammirare la ricchezza degli interni che non smettono mai di affascinare i visitatori. \r\n\r\nL\u2019evoluzione di un edificio eccezionale \r\n\r\nLa sua costruzione avviene nel corso di un lungo periodo di tempo e vede l\u2019avvicendarsi di vari architetti. In origine, l\u2019edificio comprendeva solo una torre campanaria e la parte sinistra, rimasta identica fino ai nostri giorni. La torre campanaria \u00e8 stata invece sostituita rapidamente dalla torre attuale quando le case delle varie corporazioni sono state trasferite nella piazza. \u00c8 stata peraltro aggiunta un\u2019altra ala sulla destra per accogliere al meglio tali edifici in questa cornice dalla bellezza incomparabile. \r\n\r\nIn cima alla nuova torre, alta pi\u00f9 di 90 m, la guglia \u00e8 coronata da San Michele arcangelo, santo patrono della citt\u00e0 di Bruxelles. Tale raffigurazione in rame dorato funge in realt\u00e0 da segnavento. Se il vento soffia nella direzione giusta, avrete modo di ammirare per bene l\u2019eroe della citt\u00e0 che sconfigge il drago! \r\n\r\nQuesto gioiello del patrimonio di Bruxelles ospita attualmente l\u2019ufficio del Turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Ayuntamiento de Bruselas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"El elegante edificio del siglo XV del ayuntamiento de Bruselas se encuentra en el coraz\u00f3n del centro hist\u00f3rico de la ciudad, en la suntuosa Grand-Place. \r\n\r\nConsiderado a menudo como la pieza clave de la plaza m\u00e1s bella del mundo es probablemente uno de los edificios m\u00e1s hermosos del pa\u00eds y evidentemente uno de los monumentos que no debes perderte en tu visita a Bruselas. Su espl\u00e9ndida torre se alza como punto de referencia, tanto para los visitantes del d\u00eda como para los belgas que pasan por el centro de la capital. \r\n\r\nUn regalo para la vista \r\n\r\nEste monumento, imponente por sus dimensiones, sus adornos esculpidos y su fachada asim\u00e9trica, llama r\u00e1pidamente la atenci\u00f3n de los transe\u00fantes. No es extra\u00f1o que al pasear delante de este prestigioso edificio veas en los balcones a alguna pareja de reci\u00e9n casados celebrando su enlace en los balcones. \r\n\r\nEl interior del ayuntamiento tambi\u00e9n merece una visita. Despierta la curiosidad de quienes desean descubrir la disposici\u00f3n y dise\u00f1o de las salas de esta obra maestra arquitect\u00f3nica. Se organizan con regularidad visitas guiadas al ayuntamiento para descubrir la riqueza de su interior que fascina a los visitantes. \r\n\r\nLa evoluci\u00f3n de un edificio singular \r\n\r\nSu construcci\u00f3n abarc\u00f3 un largo periodo y cont\u00f3 con la direcci\u00f3n de varios arquitectos. En un principio, el edificio \u00fanicamente contaba con un campanario y la parte izquierda que se ha conservado intacta hasta el d\u00eda de hoy. El campanario fue r\u00e1pidamente sustituido por la torre actual, cuando las casas de los diferentes gremios se instalaron en la plaza. Asimismo, se a\u00f1adi\u00f3 un ala adicional en la parte derecha para integrar mejor los nuevos edificios en este incomparable decorado. \r\n\r\nEn la cima de la nueva torre, de m\u00e1s de 90 m de altura, el arc\u00e1ngel San Miguel, patr\u00f3n de la ciudad de Bruselas, corona la aguja. Esta estatua de cobre dorado sirve de veleta. Si el viento sopla a su favor, tendr\u00e1s la ocasi\u00f3n de admirar de la mejor forma \u00a1c\u00f3mo San Miguel vence al drag\u00f3n! \r\n\r\nActualmente, esta joya del patrimonio bruselense alberga la oficina de turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"C\u00e2mara Municipal de Bruxelas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"O edif\u00edcio da C\u00e2mara Municipal de Bruxelas \u00e9 uma obra de arte da arquitetura civil g\u00f3tica do s\u00e9culo XV. No s\u00e9culo XVIII, foi-lhe adicionada uma ala de estilo cl\u00e1ssico. As in\u00fameras salas competem entre si em aparato. S\u00e3o notavelmente ornamentadas por tape\u00e7arias excecionais que evocam epis\u00f3dios locais e nacionais da hist\u00f3ria belga. Exposi\u00e7\u00f5es ocupam pontualmente os espa\u00e7os.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":112,"location":{"lat":50.8466937,"lon":4.35252339},"region":"brussels","last_updated_at":"2022-05-23T01:07:19+02:00","published_at":"2013-10-19T01:13:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":277830,"translations":{"fr":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number