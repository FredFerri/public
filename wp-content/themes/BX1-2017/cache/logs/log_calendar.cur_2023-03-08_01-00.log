aert en el s. XIX no han acabado con el esplendor de las salas medievales en el interior del edificio.\r\n\r\nEn lo alto de la torre, desde el camino de ronda almenado, podr\u00e1s disfrutar de unas vistas espectaculares de Bruselas y de su regi\u00f3n.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Porte de Hal - MRAH","address_street_name":"Boulevard du Midi","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"http:\/\/www.portedehal.be","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard du Midi, 150","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Porte de Hal - MRAH","address_street_name":"Boulevard du Midi","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"http:\/\/www.portedehal.be","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard du Midi, 150","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":414,"location":{"lat":50.83309758,"lon":4.34491654},"region":"brussels","last_updated_at":"2023-03-07T02:36:37+01:00","published_at":"2013-10-19T01:13:30+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/6b8c146cf9a1ec51942e4a5de07039a70bcc3a89.jpg","width":956,"height":1351,"ratio":0.71,"translations":{"fr":{"title":"Magical Theatres","copyright":"(c)kmkg-mrah"},"nl":{"title":"Magical Theatres","copyright":"(c)kmkg-mrah"},"en":{"title":"Magical Theatres","copyright":"(c)kmkg-mrah"},"de":