nd":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]}},"translations":{"en":["monday, tuesday, wednesday, thursday and friday: from 10:00 to 17:00","saturday and sunday: from 10:00 to 18:00"],"fr":["lundi, mardi, mercredi, jeudi et vendredi: de 10:00 \u00e0 17:00","samedi et dimanche: de 10:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag, donderdag en vrijdag: van 10:00 tot 17:00","zaterdag en zondag: van 10:00 tot 18:00"]},"date_start":"2023-09-08","date_end":"2023-11-05","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50001701,"date_start":"2023-09-26","date_end":"2023-11-26","date_next":"2023-10-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-23T02:03:13+02:00","published_at":"2023-09-01T16:31:54+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284473,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"expo","ranking":0.31833136784577337,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Voyage au c\u0153ur du Style Sapin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001701"},"pt":{"name":"Voyage au c\u0153ur du Style Sapin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001701"},"en":{"name":"Art nouveau in La Chaux-de-Fonds","shortdescr":"In the effervescence of the late 19th century, Art Nouveau also flourished in La Chaux-de-Fonds (Switzerland). Many buildings constructed in the early 20th century incorporated Art Nouveau elements. Curved forms of French or Belgian Art Nouveau meet the more geometric shapes inspired by German or Viennese Jugendstil: this is the Sapin or fir tree style.","longdescr":"Destroyed by fire in 1794, La Chaux-de-Fonds is a town that turned to the watchmaking industry in the 19th century and developed strongly along a checkerboard urban plan. This specificity of its urban ensemble, built by and for the watchmaking industry, has been inscribed on UNESCO's World Heritage List since 2009.\nThe production period for the Style Sapin objects and works of art is short. Less than ten years separate the beginnings of the Cours Sup\u00e9rieur d'Art et de D\u00e9coration from the outbreak of the First World War. While it's impossible to know precisely the entire artistic output of the period, some objects have been rediscovered. Such is the case of five monumental stained-glass windows created by Jules Courvoisier for the Cernier-Fontainemelon chapel in 1907. Missing when the chapel was remodeled in the 1970s, they were rediscovered in early 2022 and joined the collections of the Mus\u00e9e des beaux-arts. This collection will soon be displayed and installed in a chapel open to the public near the Crematorium.\nThe Villa Fallet is a manifesto of the Style Sapin, a practical implementation of Charles L'Eplattenier's courses, who wished to integrate this new ornamental vocabulary into domestic architecture, and not just into the decoration of watch cases. The house was designed by a group of students from the Cours sup\u00e9rieur d'art et de d\u00e9coration. The plans were drawn up by Charles-\u00c9douard Jeanneret, the future Le Corbusier, under the direction of architect Ren\u00e9 Chapallaz. All the ornamentation is based on the fir tree motif, allowing for a wide range of decorative interventions and experiments. Wrought ironwork, woodwork, stonework and sgraffito make the Villa Fallet a total work of art, testifying to the encounter between the Heimatstil and the fir style. \n","performers":"Sylvie Pipoz, ambtenaar erfgoedontwikkeling van de stad La-Chaux-de-Fonds","boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001701"},"it":{"name":"Voyage au c\u0153ur du Style Sapin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001701"},"cn":{"name":"Voyage au c\u0153ur du Style Sapin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001701"},"fr":{"name":"L'Art nouveau \u00e0 La Chaux-de-Fonds","shortdescr":"Dans l\u2019effervescence de la fin du 19e, l\u2019Art nouveau se d\u00e9ploie \u00e0 La Chaux-de-Fonds (Suisse). De nombreux immeubles construits au d\u00e9but du 20e si\u00e8cle int\u00e8grent des \u00e9l\u00e9ments Art nouveau. Les formes courbes de l\u2019Art nouveau fran\u00e7ais ou belge rencontrent les formes plus g\u00e9om\u00e9triques inspir\u00e9es du Jugendstil allemand ou viennois : c\u2019est le Style sapin.","longdescr":"D\u00e9truite par un incendie en 1794, La Chaux-de-Fonds est une ville qui s\u2019est tourn\u00e9e au 19e si\u00e8cle vers l\u2019industrie horlog\u00e8re et s\u2019est fortement d\u00e9velopp\u00e9e selon un plan urbanistique en damier. Cette sp\u00e9cificit\u00e9 de son ensemble urbain construit par et pour l\u2019horlogerie est inscrite depuis 2009 sur la Liste du patrimoine mondial de l\u2019UNESCO.\n\nLa p\u00e9riode de production d\u2019objets et d\u2019\u0153uvres d\u2019art du Style sapin est courte. Moins de dix ans s\u00e9parent les d\u00e9buts du Cours sup\u00e9rieur d\u2019art et de d\u00e9coration du d\u00e9but de la Premi\u00e8re Guerre mondiale. S\u2019il est impossible de conna\u00eetre pr\u00e9cis\u00e9ment l\u2019entier de la production artistique d\u2019alors, il arrive toutefois que certains objets soient red\u00e9couverts. C\u2019est le cas de cinq vitraux monumentaux r\u00e9alis\u00e9s par Jules Courvoisier pour la chapelle de Cernier-Fontainemelon en 1907. Disparus lors de la transformation du lieu dans les ann\u00e9es 1970, ils sont retrouv\u00e9s d\u00e9but 2022 et rejoignent les collections du Mus\u00e9e des beaux-arts. Cet ensemble sera prochainement mis en valeur et install\u00e9 dans une chapelle ouverte au public \u00e0 proximit\u00e9 du Cr\u00e9matoire. \n\n La Villa Fallet est un manifeste du Style sapin, une mise en pratique des cours de Charles L\u2019Eplattenier qui souhaite int\u00e9grer ce vocabulaire ornemental nouveau \u00e0 l\u2019architecture domestique et non plus uniquement \u00e0 la d\u00e9coration de bo\u00eetes de montres. La r\u00e9alisation de la maison est un travail collectif des \u00e9l\u00e8ves du Cours sup\u00e9rieur d\u2019art et de d\u00e9coration. Les plans sont r\u00e9alis\u00e9s par Charles-\u00c9douard Jeanneret, futur Le Corbusier, sous la direction de l\u2019architecte Ren\u00e9 Chapallaz. L\u2019ensemble de l\u2019ornementation reprend et d\u00e9cline le motif du sapin, permettant une vaste palette d\u2019interventions et d\u2019exp\u00e9rimentations d\u00e9coratives. Ferronneries, travail du bois, de la pierre ou sgraffites font de la Villa Fallet une \u0153uvre d\u2019art totale qui t\u00e9moigne de la rencontre entre le Heimatstil et le Style sapin.","performers":"Sylvie Pipoz, d\u00e9l\u00e9gu\u00e9e \u00e0 la valorisation du patrimoine de la Ville de La-Chaux-de-Fonds","boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001701"},"sp":{"name":"Voyage au c\u0153ur du Style Sapin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001701"},"nl":{"name":"Art nouveau en La Chaux-de-Fonds","shortdescr":"De art nouveau begon ook in La Chaux-de-Fonds (Zwitserland) te bloeien. Veel gebouwen uit het begin van de 20ste eeuw bevatten art-nouveau-elementen. De gebogen vormen van de Franse of Belgische art nouveau ontmoetten de meer geometrische vormen ge\u00efnspireerd door de Duitse of Weense Jugendstil: het resultaat werd de sapin- of dennenboomstijl.","longdescr":"La Chaux-de-Fonds, verwoest door een brand in 1794, is een stad die zich in de 19de eeuw richtte op de horloge-industrie en zich sterk ontwikkelde volgens een stedenbouwkundig dambordplan. Dit specifieke kenmerk van het stedelijk ensemble, gebouwd door en voor de horloge-industrie, staat sinds 2009 op de Werelderfgoedlijst van UNESCO.\nDe productieperiode van objecten en kunstwerken in de dennenboomstijl was kort. Minder dan tien jaar scheiden het begin van de Cours Sup\u00e9rieur d'Art et de D\u00e9coration van het uitbreken van de Eerste Wereldoorlog. Hoewel het onmogelijk is om precies te weten wat de volledige artistieke output van die periode was, zijn sommige objecten herontdekt. Dit is het geval met vijf monumentale glas-in-loodramen die Jules Courvoisier maakte voor de kapel in Cernier-Fontainemelon in 1907. Ze ontbraken toen de kapel in de jaren 1970 werd verbouwd, maar werden begin 2022 herontdekt en toegevoegd aan de collecties van het Mus\u00e9e des beaux-arts. Deze collectie wordt binnenkort tentoongesteld en ge\u00efnstalleerd in een kapel die toegankelijk is voor het publiek in de buurt van het crematorium.\nDe Villa Fallet is een manifest van de sapinstijl, een praktische toepassing van de lezingen van Charles L'Eplattenier, die dit nieuwe ornamentele vocabulaire wilde integreren in de huiselijke architectuur en niet alleen in de decoratie van horlogekasten. De bouw van het huis was een collectieve inspanning van studenten aan de Cours Sup\u00e9rieur d'Art et de D\u00e9coration. De plannen werden opgesteld door Charles-\u00c9douard Jeanneret, de toekomstige Le Corbusier, onder leiding van architect Ren\u00e9 Chapallaz. Alle versieringen waren gebaseerd op het motief van de dennenboom, waardoor een breed scala aan decoratieve ingrepen en experimenten mogelijk was. Smeedijzerwerk, houtwerk, steenwerk en sgraffito maken van de Villa Fallet een totaalkunstwerk, een bewijs van de ontmoeting tussen de Heimatstil en de sparrenstijl. ","performers":"Sylvie Pipoz, ambtenaar erfgoedontwikkeling van de stad La-Chaux-de-Fonds","boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001701"}},"place":{"id":247371,"translations":{"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi...\r\nLe Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi. Sotto il patrocinio della regione di Bruxelles Capitale.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Remarquable t\u00e9moin de l\u2019architecture des march\u00e9s couverts, les Halles Saint-G\u00e9ry  contribuent \u00e0 valoriser le patrimoine de la R\u00e9gion de Bruxelles-Capitale. Centre d\u2019exposition et de manifestation bas\u00e9 en plein coeur du pentagone, elles ont pour vocation de mettre en valeur les traits de d\u00e9marcation du cadre de vie bruxellois et de son identit\u00e9 urbaine par le biais d'une programmation hybride, allant des expositions, aux conf\u00e9rences, concerts, rencontres et performances \u2026\r\nLe Centre Urbain (guichet d\u2019information r\u00e9gional, pour mieux vous conseiller sur l\u2019habitat durable en R\u00e9gion de Bruxelles-Capitale) est \u00e9galement situ\u00e9 au sein des Halles.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Verdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio...\r\nVerdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio y al marco de vida de los bruselenses.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Sint-Gorikshallen","address_street_name":"Sint-Goriksplein","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Sint-Goriksplein","address_line2":"1000 Bruxelles","description_web":"De Sint-Gorikshallen zijn een prachtig architecturaal staaltje van openbare markthallen in het 19de-eeuwse Brussel. Het gebouw werd een aantal jaren geleden volledig gerestaureerd en doet tegenwoordig dienst als permanente informatie-, tentoonstellings- en evenementenruimte gewijd aan het erfgoed en de levenswijzen in de hoofdstad. Op amper twee minuten stappen van de Beurs vormen de Sint-Gorikshallen een gezellige plek om te ontspannen en nieuwe dingen te ontdekken, zowel overdag als bij het vallen van de nacht.\r\nDe hallen herbergen ook de Stadswinkel, een vereniging die de inwoners van het Brussels Hoofdstedelijk Gewest  wil informeren over het leefmilieu en een kwaliteitsvolle leefomgeving, huisvesting, stadsrenovatie, stedenbouw en ruimtelijke ordening, en rationeel energiegebruik. ","descri