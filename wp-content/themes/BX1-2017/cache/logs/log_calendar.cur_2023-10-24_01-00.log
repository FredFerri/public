https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003167"},"en":{"name":"Visite guid\u00e9e en langue des signes de Belgique francophone (LSFB)","shortdescr":"Technology is omnipresent in our daily lives, but what do our online relationships actually represent? How do we inhabit a community through an app? What does it mean to be friends through platforms and avatars? And is there room for love in the metaverse? Connecting traces the links between physical reality and the digital world.\n\n \n\n1 Avenue du port, 1000 Brussels. \n\n","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kanal.brussels\/fr\/evenements\/visite-guidee\/visite-guidee-en-langue-des-signes-de-belgique-francophone-lsfb","email":"info@kanal.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003167"},"it":{"name":"Visite guid\u00e9e en langue des signes de Belgique francophone (LSFB)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kanal.brussels\/fr\/evenements\/visite-guidee\/visite-guidee-en-langue-des-signes-de-belgique-francophone-lsfb","email":"info@kanal.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003167"},"cn":{"name":"Visite guid\u00e9e en langue des signes de Belgique francophone (LSFB)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kanal.brussels\/fr\/evenements\/visite-guidee\/visite-guidee-en-langue-des-signes-de-belgique-francophone-lsfb","email":"info@kanal.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003167"},"fr":{"name":"Visite guid\u00e9e en langue des signes de Belgique francophone (LSFB)","shortdescr":"La technologie est partout dans notre quotidien. Mais que repr\u00e9sentent nos relations en ligne? Peut-on faire communaut\u00e9 par le biais d\u2019une application? Quel sens donner \u00e0 l\u2019amiti\u00e9 qui se forme \u00e0 travers les plateformes et les avatars? Trouve-t-on l\u2019amour dans le m\u00e9tavers? Connecting trace les liens entre la r\u00e9alit\u00e9 physique et le monde num\u00e9rique.\n\n \n\n1 Avenue du port, 1000 Bruxelles. ","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kanal.brussels\/fr\/evenements\/visite-guidee\/visite-guidee-en-langue-des-signes-de-belgique-francophone-lsfb","email":"info@kanal.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003167"},"sp":{"name":"Visite guid\u00e9e en langue des signes de Belgique francophone (LSFB)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kanal.brussels\/fr\/evenements\/visite-guidee\/visite-guidee-en-langue-des-signes-de-belgique-francophone-lsfb","email":"info@kanal.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003167"},"nl":{"name":"Visite guid\u00e9e en langue des signes de Belgique francophone (LSFB)","shortdescr":"Technologie is omnipresent in ons dagelijks leven. Maar wat betekenen onze online relaties? Hoe leven we in gemeenschap via de app? Wat betekent vriendschap via platformen en avatars? En is er plaats voor liefde in de metaverse? Connecting linkt de fysieke realiteit aan de digitale wereld.\n\n \n\n1 Havenlaan, 1000 Brussel. ","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kanal.brussels\/fr\/evenements\/visite-guidee\/visite-guidee-en-langue-des-signes-de-belgique-francophone-lsfb","email":"info@kanal.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003167"}},"place":{"id":271094,"translations":{"de":{"name":"Kanal - Centre Pompidou       ","address_street_name":"Square Sainctelette ","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette ","address_line2":"1000 Bruxelles","description_web":"Weder auf dem Gebiet der modernen und zeitgen\u00f6ssischen Kunst noch im Bereich der Architektur ist Br\u00fcssel ein unbeschriebenes Blatt. Im Gegenteil, es gibt bereits eine ganze Reihe von Museen und Einrichtungen, die sich mit den verschiedenen k\u00fcnstlerischen Disziplinen besch\u00e4ftigen. \r\nWas jedoch bislang noch fehlte, war ein Museum f\u00fcr moderne und zeitgen\u00f6ssische Kunst und ein Architekturmuseum unter einem Dach (und was f\u00fcr einem Dach!). Und so hat das ambitionierte Projekt KANAL Centre Pompidou seine absolute Daseinsberechtigung am Br\u00fcsseler Kanal, wo es die 35 000 m\u00b2 der ehemaligen Citro\u00ebn-Werkstatt in Beschlag nehmen wird. In der Zeit bis zum Beginn der Umbauarbeiten, deren Ende f\u00fcr 2022\/2023 geplant sind, hat die Fondation Kanal beschlossen, ab dem 5. Mai 2018 eine Art \"Vorlaufjahr\" zu starten. 13 Monate lang kann das Publikum in Zusammenarbeit mit dem Centre Pompidou dieses mythische Geb\u00e4ude entdecken - Ausstellungen, Gro\u00dfinstallationen, zehn Auftragsarbeiten von Br\u00fcsseler K\u00fcnstlern sowie ein Programm mit Live-Darbietungen. ","description_print":null,"booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"pt":{"name":"Kanal - Centre Pompidou      ","address_street_name":"Square Sainctelette ","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette ","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"en":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette ","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette ","address_line2":"1000 Bruxelles","description_web":"When it reopens in 2024, Kanal-Centre Pompidou will become the largest cultural institution in Brussels, with more than 35,000m\u00b2 dedicated to current artistic creation in all its forms. After presenting KANAL BRUT - an exhibition in its own, raw space - and then a major two-part exhibition by Swiss artist John M Armleder, the huge garage closed its doors for renovation. However, Kanal remains active in the Brussels cultural sector and is multiplying its collaborations with local actors. Exhibitions and events are planned at K1, a space opposite the building site. ","description_print":null,"booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"it":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette ","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette ","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"cn":{"name":"Kanal - Centre Pompidou      ","address_street_name":"Square Sainctelette ","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette ","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Kanal - Centre Pompidou      ","address_street_name":"Square Sainctelette ","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette ","address_line2":"1000 Bruxelles","description_web":"Lors de sa re\u0301ouverture pre\u0301vue en 2024, Kanal-Centre Pompidou deviendra la plus vaste institution culturelle bruxelloise, avec plus de 35.000 m\u00b2 de\u0301die\u0301s a\u0300 la cre\u0301ation artistique actuelle sous toutes ses formes. Apr\u00e8s avoir pr\u00e9sent\u00e9 \u00ab\u202fKANAL BRUT\u202f\u00bb, une exposition dans son espace encore dans son jus, puis une grande exposition en deux volets de l\u2019artiste suisse John M Armleder, l\u2019immense garage a ferm\u00e9 ses portes pour cause de travaux. Kanal reste cependant actif dans le secteur culturel \u00e0 Bruxelles et multiplie ses collaborations avec les acteurs locaux. Des expositions et des \u00e9v\u00e8nements sont notamment pr\u00e9vus au K1, un local faisant face au chantier. ","description_print":null,"booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"sp":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette ","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette ","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"nl":{"name":"Kanal - Centre Pompidou","address_street_name":"Sainctelettesquare","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Sainctelettesquare","address_line2":"1000 Bruxelles","description_web":"Wanneer Kanal-Centre Pompidou in 2024 heropent, zal het de grootste culturele instelling in Brussel zijn, met meer dan 35.000 vierkante meter gewijd aan hedendaagse artistieke creatie in al haar vormen. Na de presentatie van \u2018KANAL BRUT,\u2019 een tentoonstelling in de oorspronkelijke ruimte, gevolgd door een grote tweedelige tentoonstelling van de Zwitserse kunstenaar John M. Armleder, sloot de enorme garage haar deuren voor renovatie. Kanal blijft echter actief in de culturele sector in Brussel en intensiveert zijn samenwerking met lokale spelers. Zo zijn er tentoonstellingen en evenementen gepland in K1, een ruimte net tegenover de bouwwerf.  ","description_print":null,"booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":"art_center","facebook_id":null,"backoffice_id":31094,"location":{"lat":50.85867303,"lon":4.3479144},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2018-03-21T14:36:53+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":271094,"translations":{"de":{"name":"Kanal - Centre Pompidou       ","address_street_name":"Square Sainctelette ","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"pho