ren 9-12 j."],"en":["Family","Children 6-9 yr.","Children 9-12 yr."]}},"tags":["exterior","kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-13T13:35:04+02:00","published_at":"2022-06-13T13:32:13+02:00","backoffice_id":255837,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":538600,"date_start":"2022-08-21","date_end":"2022-08-21","date_next":"2022-08-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Promenade et d\u00e9couverte : \u201cEn \u00e9t\u00e9, \u00e0 Tour & Taxis\u2026\u201d","shortdescr":"Nous vous emmenons dans les coulisses du site en constante \u00e9volution de Tour &amp; Taxis\u2026","longdescr":"Nous vous emmenons dans les coulisses du site en constante \u00e9volution de Tour &amp; Taxis\u2026\nNous partons de l\u2019Entrep\u00f4t Royalo\u00f9 nous d\u00e9couvrons l\u2019\u00e9norme site, son histoire et ses fonctions au fil du temps \u00e0 l\u2019aide d\u2019une maquette. Le guide nous donnera \u00e9galement un aper\u00e7u des nouvelles \u00e9volutions : quels projets ont d\u00e9j\u00e0 \u00e9t\u00e9 r\u00e9alis\u00e9s et quels sont ceux qui sont encore en cours ?\nNous visitonsle toit-terrasse de l\u2019Entrep\u00f4t Royalet d\u00e9couvrons les caves vo\u00fbt\u00e9es des Sheds, qui abritent m\u00eame un producteur de pleurotes.\nEt nous d\u00e9couvrons laGare Maritime,b\u00e2timent monumental et \u00e9poustouflant, r\u00e9cemment restaur\u00e9e : une ville dans la ville o\u00f9 il ne pleut jamais. Les gigantesques salles, d\u2019une profondeur de 175 m\u00e8tres, reposent sur de minces piliers en fonte avec des \u00e9l\u00e9ments Art Nouveau. La gare, construite entre 1902 et 1908, \u00e9tait \u00e0 l\u2019\u00e9poque la plus grande gare de fret d\u2019Europe. L\u2019architecteJan De Moffarts(Altstadt) a r\u00e9alis\u00e9 la restauration en collaboration avec leBureau Bouwtechniek. Neutelings Riedijk Architects, connu du MAS d\u2019Anvers, y a ajout\u00e9 de nouveaux \u00e9l\u00e9ments qui s\u2019int\u00e8gre merveilleusement bien. Pour conclure le tour, nous visiterons l\u2019un de ces modules qui sert de bureau.\nApr\u00e8s votre promenade, profitez de la terrasse d\u2019\u00e9t\u00e9 couverte ou prenez un verre et un repas \u00e0 la Gare Maritime\u2026 quel que soit le temps !","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538600.html"},"nl":{"name":"Promenade et d\u00e9couverte : \u201cEn \u00e9t\u00e9, \u00e0 Tour & Taxis\u2026\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.korei.be","email":"info@korei.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538600.html"},"en":{"name":"Promenade et d\u00e9couverte : \u201cEn \u00e9t\u00e9, \u00e0 Tour & Taxis\u2026\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538600.html"},"de":{"name":"Promenade et d\u00e9couverte : \u201cEn \u00e9t\u00e9, \u00e0 Tour & Taxis\u2026\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538600.html"},"it":{"name":"Promenade et d\u00e9couverte : \u201cEn \u00e9t\u00e9, 