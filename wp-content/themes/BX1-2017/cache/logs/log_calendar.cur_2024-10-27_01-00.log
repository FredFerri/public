-9 j.","Jongeren 12-15 j."]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":50011467,"date_start":"2024-03-21","date_end":"2025-03-02","date_next":"2024-10-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-26T03:02:50+02:00","published_at":"2024-06-11T11:15:31+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":302029,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.14230609729250393,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Unexpected Encounters by Francois Coorens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/unexpected-encounters-by-francois-coorens\/","email":"BRUGR_MKT@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011467"},"pt":{"name":"Unexpected Encounters by Francois Coorens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/unexpected-encounters-by-francois-coorens\/","email":"BRUGR_MKT@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011467"},"en":{"name":"Unexpected Encounters by Francois Coorens","shortdescr":"To celebrate the third edition of a one-year art residency, Hilton Brussels Grand Place is thrilled to unveil \u201cUnexpected Encounters,\u201d an exhilarating exhibition by Belgian artist Fran\u00e7ois Coorens. From the vibrant hues adorning our walls to the thought-provoking pieces tucked around every corner, this collection promises to captivate and inspire guests throughout their stay until March 2025.","longdescr":"Within the walls of Hilton Brussels Grand Place, guests will discover a treasure trove of Coorens\u2019 most iconic works, including newly created pieces featuring Belgian icons like Stromae, Ang\u00e8le, and Diane von F\u00fcrstenberg to international icons like Paris Hilton and Lady Gaga with pop culture references. And for those seeking a departure from the figurative, Coorens\u2019 alter-ego, Bus Tomasi, offers a series of abstract pieces that challenge and provoke. The recent vernissage on March 21st welcomed over 200 guests, marking a memorable start to this year-long journey. All the paintings displayed are for sale - for more information, please contact our reception at the hotel.\n\nIn celebration of our partnership with Fran\u00e7ois Coorens, Sentro, our vibrant restaurant & bar, invites guests to embark on a culinary journey inspired by the artist\u2019s vibrant creations. Head Chef Vincent Masson has crafted a menu that pays homage to Coorens\u2019 bold aesthetic, featuring his favourite dish, the Endive and Beef Cheek Parmentier. At the bar, you can complement your meal with Fran\u00e7ois\u2019s recommended beverages, the Mezcal Negroni cocktail and Spicy Apple mocktail, for a truly immersive dining experience.\n\nWe invite everyone to immerse themselves in the captivating world of \u201cUnexpected Encounters\u201d by Fran\u00e7ois Coorens, on display at Hilton Brussels Grand Place until March 2025. This exhibition is open to all, offering a unique opportunity to explore Fran\u00e7ois\u2019s imaginative world and discover the beauty of art, culture, and cuisine converging in unexpected ways.","performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/unexpected-encounters-by-francois-coorens\/","email":"BRUGR_MKT@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011467"},"it":{"name":"Unexpected Encounters by Francois Coorens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/unexpected-encounters-by-francois-coorens\/","email":"BRUGR_MKT@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011467"},"cn":{"name":"Unexpected Encounters by Francois Coorens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/unexpected-encounters-by-francois-coorens\/","email":"BRUGR_MKT@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011467"},"fr":{"name":"Unexpected Encounters by Francois Coorens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/unexpected-encounters-by-francois-coorens\/","email":"BRUGR_MKT@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011467"},"sp":{"name":"Unexpected Encounters by Francois Coorens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happen