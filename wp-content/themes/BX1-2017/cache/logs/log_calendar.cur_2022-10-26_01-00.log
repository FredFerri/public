Moriarty, join Phileas Fogg in his wild adventure around the world or in the Nautilus or dive into the Amazonian jungle to discover a lost ancient temple and try to break an ancestral Mayan curse. Beware, it's a race against the clock! You only have 60 minutes to accomplish your mission and escape...\r\n\r\nLocated at the bottom of Mont des Arts, in the very heart of Brussels, Enygma is an entertaining and unique experience that is located at the crossroads of interactive theater, treasure hunting, and role play.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Enygma Partners sprl","address_street_name":"Place de l'Albertine","address_street_number":"3","address_street_box":null,"email":"info@enygma.be","website":"http:\/\/www.enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de l'Albertine, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Enygma Partners sprl","address_street_name":"Place de l'Albertine","address_street_number":"3","address_street_box":null,"email":"info@enygma.be","website":"http:\/\/www.enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de l'Albertine, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Enygma Partners sprl","address_street_name":"Place de l'Albertine","address_street_number":"3","address_street_box":null,"email":"info@enygma.be","website":"http:\/\/www.enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de l'Albertine, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_orde