nie avec dext\u00e9rit\u00e9 l\u2019art consomm\u00e9 du d\u00e9calage entre l\u2019\u00e9l\u00e9gance de l\u2019emballage et la crudit\u00e9 du propos. Irr\u00e9sistible, comme toujours.","performers":"De et avec Laurence Bibot","boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/bibot-distinguee\/","email":"info@cirqueroyalbruxelles.be","phone_contact":"+32 2 510 05 10","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/515473.html"},"nl":{"name":"Bibot Distingu\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/515473.html"},"en":{"name":"Bibot Distingu\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/515473.html"},"de":{"name":"Bibot Distingu\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/515473.html"},"it":{"name":"Bibot Distingu\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/515473.html"},"sp":{"name":"Bibot Distingu\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/515473.html"},"pt":{"name":"Bibot Distingu\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/515473.html"},"