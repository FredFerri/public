0","end":"16:00:00"},{"day":"2022-12-15","doors":null,"start":"10:00:00","end":"16:00:00"},{"day":"2022-12-16","doors":null,"start":"10:00:00","end":"16:00:00"},{"day":"2022-12-19","doors":null,"start":"10:00:00","end":"16:00:00"},{"day":"2022-12-20","doors":null,"start":"10:00:00","end":"16:00:00"},{"day":"2022-12-21","doors":null,"start":"10:00:00","end":"16:00:00"},{"day":"2022-12-22","doors":null,"start":"10:00:00","end":"16:00:00"},{"day":"2022-12-23","doors":null,"start":"10:00:00","end":"16:00:00"}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"10:00:00","end":"16:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"16:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"16:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"16:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"16:00:00"}]},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi et vendredi: de 10:00 \u00e0 16:00","samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag en vrijdag: van 10:00 tot 16:00","zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday and friday: from 10:00 to 16:00","saturday and sunday: closed"]},"date_start":"2022-10-06","date_end":"2022-12-23","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-10-06","start":"18:00:00","timestamp":"2022-10-06T18:00:00+02:00","end":"20:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T01:35:49+02:00","published_at":"2022-08-17T11:10:56+02:00","backoffice_id":259831,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.29363036713255},{"id":537358,"date_start":"2022-09-29","date_end":"2023-08-15","date_next":"2022-10-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,47],"translations":{"fr":["Mus\u00e9es et art centers","Bande dessin\u00e9e"],"nl":["Musea en kunstcentra","Stripverhaal"],"en":["Museums and art centers","Comicstrip"],"de":["Museen & Kunstzentren","Comics"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Cerise, Lulu et Nelson, les mondes de l'enfance d'Aur\u00e9lie Neyret","shortdescr":null,"longdescr":"L\u2019illustratrice et dessinatrice fran\u00e7aise Aur\u00e9lie Neyret a fait des mondes de l\u2019enfance son univers de cr\u00e9ation. Apr\u00e8s avoir sign\u00e9 de nombreuses illustrations pour des publications jeunesse ou collectives, elle fait ses d\u00e9buts dans la bande dessin\u00e9e aux c\u00f4t\u00e9s de Joris Chamblain avec la s\u00e9rie Les Carnets de Cerise, dont le succ\u00e8s lui apporte la reconnaissance du public comme de la critique. Suivent ensuite les aventures de Lulu et Nelson, un r\u00e9cit \u00e9crit par Charlotte Girard et Jean-Marie Omont. Avec un style dynamique et color\u00e9, la dessinatrice met en sc\u00e8ne de jeunes h\u00e9ros attachants en qu\u00eate d\u2019eux m\u00eame et de libert\u00e9. Un univers sensible et original que l\u2019exposition propose d\u2019explorer pour en d\u00e9couvrir toute la profondeur et la cr\u00e9ativit\u00e9.","performers":"Aur\u00e9lie Neyret (autrice)","boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/les-grandes-expositions-temporaires\/cerise-lulu-et-nelson","email":"visit@cbbd.be","phone_contact":null,"phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537358"},"nl":{"name":"Cerise, Lulu en Nelson, de wereld van de kindertijd volgens Aur\u00e9lie Neyret","shortdescr":null,"longdescr":"De Franse illustratrice en stripauteur Aur\u00e9lie Neyret heeft van de kinderwereld haar creatieve universum gemaakt. Nadat ze talrijke illustraties tekende voor jeugdboeken en collectieve uitgaven, debuteert ze in de stripwereld aan de zijde van Joris Chamblain met de reeks Het dagboek van Cerise, waarmee ze zowel bij het publiek al bij critici het succes en erkenning oogst. Daarna volgen de avonturen van Lulu en Nelson, naar een verhaal van Charlotte Girard en Jean-Marie Omont. In een dynamische en kleurrijke stijl presenteert de illustratrice aandoenlijke jonge helden die op zoek zijn naar zichzelf en naar vrijheid. Een gevoelig en origineel universum dat de tentoonstelling in al zijn diepte en creativiteit wil doen ontdekken.","performers":"Aur\u00e9lie Neyret (auteur)","boxoffice_url":null,"website":"https:\/\/www.stripmuseum.be\/nl\/tentoonstellingen\/tijdelijke-tentoonstellingen\/cerise-lulu-en-nelson","email":"visit@stripmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537358"},"en":{"name":"Cerise, Lulu and Nelson, the world of childhood by Aur\u00e9lie Neyret","shortdescr":null,"longdescr":"The French illustrator and cartoonist Aur\u00e9lie Neyret has made of the world of childhood her creative universe. After numerous illustrated books and collective publications, she made her debut in comics alongside Joris Chamblain with the series Les Carnets de Cerise, the success of which brought her recognition from the public as well as from critics. This was followed by the adventures of Lulu and Nelson, a story written by Charlotte Girard and Jean-Marie Omont. With a dynamic and colourful style, the illustrator presents endearing young heroes in search of themselves and of freedom. A sensitive and original universe that the exhibition proposes to explore and discover all its depth and creativity.","performers":"Aur\u00e9lie Neyret (author)","boxoffice_url":null,"website":"https:\/\/www.comicscenter.net\/en\/exhibitions\/the-great-temporary-exhibitions\/cerise-lulu-and-nelson","email":"visit@comicscenter.net","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537358"},"de":{"name":"Cerise, Lulu et Nelson, les mondes de l'enfance d'Aur\u00e9lie Neyret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537358"},"it":{"name":"Cerise, Lulu et Nelson, les mondes de l'enfance d'Aur\u00e9lie Neyret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537358"},"sp":{"name":"Cerise, Lulu et Nelson, les mondes de l'enfance d'Aur\u00e9lie Neyret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537358"},"pt":{"name":"Cerise, Lulu et Nelson, les mondes de l'enfance d'Aur\u00e9lie Neyret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537358"},"cn":{"name":"Cerise, Lulu et Nelson, les mondes de l'enfance d'Aur\u00e9lie Neyret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537358"}},"place":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Attraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur depuis plus de 25 ans auteurs et h\u00e9ros du 9\u00e8me Art. \r\n\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Tintin et les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite. \r\n\r\nMagnifi\u00e9 par un exceptionnel cadre Art Nouveau con\u00e7u par Victor Horta, le Mus\u00e9e de la Bande Dessin\u00e9e est tout autant un hommage aux pionniers qu'un regard sur la BD actuelle.\r\n\r\nOuvert 7 jours sur 7, de 10h \u00e0 18h pendant les vacances scolaires belges.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stripmuseum","address_street_name":"Zandstraat","address_street_number":"20","address_street_box":null,"email":"visit@stripmuseum.be","website":"http:\/\/www.stripmuseum.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zandstraat, 20","address_line2":"1000 Brussel","description_web":"Het Stripmuseum is voor al wie Brussel bezoekt een \u2018must\u2019 in het hartje van de stad. Al meer dan 25 jaar richt het museum de spots op de auteurs en de helden van de Negende Kunst. \r\n\r\nAan de hand van permanente tentoonstellingen \u2013 die regelmatig vernieuwd worden \u2013 en een afwisselend programma van tijdelijke exposities kan je er als bezoeker kennismaken met de talrijke facetten van het stripverhaal. Kuifje en de Smurfen nemen je mee naar avonturenland, een wereld waar de creativiteit geen grenzen kent. \r\n\r\nHet uitzonderlijke art nouveau-gebouw van Victor Horta geeft een bezoek nog een extra dimensie. Het Stripmuseum is tegelijk een hommage aan de pioniers van het medium als een blik op het hedendaagse stripverhaal.\r\n\r\nOpen van maandag tot zondag van 10 uur tot 18 uur tijdens de Belgische schoolvakanties.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"http:\/\/www.comicscenter.net\/en\/home","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Sables, 20","address_line2":"1000 Brussels","description_web":"An accomplished attraction located in the heart of Brussels, the Belgian Comic Strip Center has been honouring the creators and heroes of the 9th Art for more than 25 years.\r\n\r\nThe regularly renewed permanent exhibitions and a diversified programme of temporary exhibitions enable visitors to discover the countless aspects of comics art. Tintin and the Smurfs lead the way towards further adventures, an encounter with a world where creativity has no limits. \r\n\r\nEnhanced by an exceptional Art Nouveau home designed by Victor Horta, the Belgian Comic Strip Center is just as much a tribute to the pioneers as a glimpse of contemporary comics art.\r\n\r\nOpen every day (7\/7) in July and August and during Belgian school holidays.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Comic-Museum - Centre Belge de la Bande Dessin\u00e9e","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!\r\n\r\nGe\u00f6ffnet von Montag bis Sonntag in Juli und August.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo del Fumetto","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Il Museo del Fumetto CBBD, situato nel cuore storico di Bruxelles, riunisce su pi\u00f9 di 4.000 m\u00b2 tutto ci\u00f2 che riguarda il fumetto. Ospitato in un edificio tempio dell'Art Nouveau disegnato da Victor Horta, il museo \u00e8 il regno di celebri eroi dei fumetti belgi: Tintin, i Puffi, Lucky Luke, Gaston Lagaffe, Blake et Mortimer, Marsupilami... Le esposizioni organizzate, la biblioteca e il centro di documentazione, non solo rendono il museo vivo e dinamico, ma sono veri e propri centri di documentazione sul fumetto il cuicatalogo \u00e8 accessibile on-line. Il centro belga del fumetto organizza conferenze, laboratori creativi ed animazioni, ecc.\r\n\r\n\r\nAperto i giorni festivi eccetto il 25\/12 e 01\/01. Il Centro Belga del Fumetto diverse formule di visita: la visita guidata del museo, quella del Percorso del Fumetto o quella del museo Marc Sleen. Il museo, anzi il centro belga del fumetto-CBBD ospita anche una brasserie dove potete respirare l'inconfondibile atmosfera di Bruxelles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centro belga del c\u00f3mic (CBBD)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Ubicado en el centro de Bruselas, en un edificio Art Nouveau construido por Victor Horta en 1906, el CBBD abri\u00f3 sus puertas el 6 de octubre de 1989. \r\n\r\nEn pocos a\u00f1os, este museo se ha convertido en una de las principales atracciones de Bruselas. \r\n\r\nCada a\u00f1o, m\u00e1s de 200.000 visitantes recorren las exposiciones permanentes y temporales que se celebran en m\u00e1s de 4.000 m 2. \r\n\r\nAunque las exposiciones contribuyen a convertir este templo en un lugar viviente, din\u00e1mico y atrayente, esta herramienta al servicio de la promoci\u00f3n del c\u00f3mic constituye un centro de documentaci\u00f3n moderno, con un cat\u00e1logo accesible online. \r\n\r\nTambi\u00e9n se llevan a cabo conferencias y talleres creativos.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"O Centro Belga da Banda Desenhada","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Atra\u00e7\u00e3o incontorn\u00e1vel situada no centro de Bruxelas, o museu da BD comemora mais de 25 anos de autores e her\u00f3is da 9.\u00aa arte.\r\nAs exposi\u00e7\u00f5es permanentes regularmente renovadas e um vasto programa de exposi\u00e7\u00f5es tempor\u00e1rias levam os visitantes a descobrir as in\u00fameras facetas da banda desenhada. Tintim e os Estrumpfes abrem a porta a outras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":405,"location":{"lat":50.85107181,"lon":4.36006874},"region":"brussels","last_updated_at":"2022-10-14T01:06:31+02:00","published_at":"2013-10-19T01:13:30+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Attraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur depuis plus de 25 ans auteurs et h\u00e9ros du 9\u00e8me Art. \r\n\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Tintin et les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite. \r\n\r\nMagnifi\u00e9 par un exceptionnel cadre Art Nouveau con\u00e7u par Victor Horta, le Mus\u00e9e de la Bande Dessin\u00e9e est tout autant un hommage aux pionniers qu'un regard sur la BD actuelle.\r\n\r\nOuvert 7 jours sur 7, de 10h \u00e0 18h pendant les vacances scolaires belges.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stripmuseum","address_street_name":"Zandstraat","address_street_number":"20","address_street_box":null,"email":"visit@stripmuseum.be","website":"http:\/\/www.stripmuseum.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zandstraat, 20","address_line2":"1000 Brussel","description_web":"Het Stripmuseum is voor al wie Brussel bezoekt een \u2018must\u2019 in het hartje van de stad. Al meer dan 25 jaar richt het museum de spots op de auteurs en de helden van de Negende Kunst. \r\n\r\nAan de hand van permanente tentoonstellingen \u2013 die regelmatig vernieuwd worden \u2013 en een afwisselend programma van tijdelijke exposities kan je er als bezoeker kennismaken met de talrijke facetten van het stripverhaal. Kuifje en de Smurfen nemen je mee naar avonturenland, een wereld waar de creativiteit geen grenzen kent. \r\n\r\nHet uitzonderlijke art nouveau-gebouw van Victor Horta geeft een bezoek nog een extra dimensie. Het Stripmuseum is tegelijk een hommage aan de pioniers van het medium als een blik op het hedendaagse stripverhaal.\r\n\r\nOpen van maandag tot zondag van 10 uur tot 18 uur tijdens de Belgische schoolvakanties.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"http:\/\/www.comicscenter.net\/en\/home","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Sables, 20","address_line2":"1000 Brussels","description_web":"An accomplished attraction located in the heart of Brussels, the Belgian Comic Strip Center has been honouring the creators and heroes of the 9th Art for more than 25 years.\r\n\r\nThe regularly renewed permanent exhibitions and a diversified programme of temporary exhibitions enable visitors to discover the countless aspects of comics art. Tintin and the Smurfs lead the way towards further adventures, an encounter with a world where creativity has no limits. \r\n\r\nEnhanced by an exceptional Art Nouveau home designed by Victor Horta, the Belgian Comic Strip Center is just as much a tribute to the pioneers as a glimpse of contemporary comics art.\r\n\r\nOpen every day (7\/7) in July and August and during Belgian school holidays.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Comic-Museum - Centre Belge de la Bande Dessin\u00e9e","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!\r\n\r\nGe\u00f6ffnet von Montag bis Sonntag in Juli und August.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo del Fumetto","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Il Museo del Fumetto CBBD, situato nel cuore storico di Bruxelles, riunisce su pi\u00f9 di 4.000 m\u00b2 tutto ci\u00f2 che riguarda il fumetto. Ospitato in un edificio tempio dell'Art Nouveau disegnato da Victor Horta, il museo \u00e8 il regno di celebri eroi dei fumetti belgi: Tintin, i Puffi, Lucky Luke, Gaston Lagaffe, Blake et Mortimer, Marsupilami... Le esposizioni organizzate, la biblioteca e il centro di documentazione, non solo rendono il museo vivo e dinamico, ma sono veri e propri centri di documentazione sul fumetto il cuicata