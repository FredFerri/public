pt_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport","de":"Sport","it":"Sport","sp":"Deporte","pt":null,"cn":null}},"others":{"list":[160,75],"translations":{"fr":["Manifestation sportive","Sport de raquettes et ballon"],"nl":["Sportmanifestatie","Bal- en racketsporten"],"en":["Sporting event","Racket sports"],"de":["Sportveranstaltung","Ball- & R\u00fcckschlagsportarten"],"it":["Manifestazioni sportive","Sport con rachette e palla"],"sp":["Evento deportivo","Deporte de raqueta y pelota"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Circus Brussels Padel Open 2023","shortdescr":"Le World Padel Tour fait son retour en Belgique pour la 2e ann\u00e9e cons\u00e9cutive.\r\nL'\u00e9tape Belge du championnat du monde aura de nouveau lieu dans la Gare Maritime de Tour & Taxis pour le plus grand plaisir de tous les fans de padel.\r\n\r\nRetrouvez les meilleurs joueurs et joueuses du monde s'affronter dans un Open de folie.","longdescr":"Au programme, \r\n4 jours de qualifications dans le Tour & Taxis Padel Club (Shed 4)\r\n5 jours de tableau final dans la Gare Maritime\r\nDes soir\u00e9es de folie avec DJ\r\nUn acc\u00e8s au court n\u00b02 et au padel village 100% gratuit","performers":null,"boxoffice_url":null,"website":"http:\/\/brusselspadelopen.be","email":"hello@brusselspadelopen.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554965"},"nl":{"name":"Circus Brussels Padel Open 2023","shortdescr":"De World Padel Tour is voor het tweede achtereenvolgende jaar terug in Belgi\u00eb.\r\nDe Belgische etappe van het wereldkampioenschap padel vindt opnieuw plaats in het Gare Maritime van Tour & Taxis voor het grootste plezier van alle padelfans.\r\n\r\nDe beste spelers ter wereld zullen het tegen elkaar opnemen in een waanzinnige Open.","longdescr":"Op het programma, \r\n4 dagen kwalificaties in de Tour & Taxis Padel Club (Shed 4) \r\n5 dagen final draw in het Gare Maritime\r\nCrazy parties met DJ \r\n100% gratis toegang tot court n\u00b02 en het padeldorp","performers":null,"boxoffice_url":null,"website":"http:\/\/brusselspadelopen.be","email":"hello@brusselspadelopen.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554965"},"en":{"name":"Circus Brussels Padel Open 2023","shortdescr":"The World Padel Tour is back in Belgium for the 2nd consecutive year.\r\nThe Belgian stage of the world championship will again take place in the Gare Maritime from Tour & Taxis for the greatest pleasure of all padel fans.\r\n\r\nThe best players in the world will compete for a unique chance to win in Brussels?","longdescr":"On the program, \r\n4 days qualifications in the Tour & Taxis Padel Club (Shed 4) \r\n5 days final draw in the Gare Maritime\r\nCrazy parties with DJ \r\nFree access to court n\u00b02 and the padel village","performers":null,"boxoffice_url":null,"website":"http:\/\/brusselspadelopen.be","email":"hello@brusselspadelopen.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554965"},"de":{"name":"Circus Brussels Padel Open 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/brusselspadelopen.be","email":"hello@brusselspadelopen.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554965"},"it":{"name":"Circus Brussels Padel Open 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/brusselspadelopen.be","email":"hello@brusselspadelopen.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554965"},"sp":{"name":"Circus Brussels Padel Open 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/brusselspadelopen.be","email":"hello@brusselspadelopen.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.554965"},"pt":{"name":"Circus Brussels Padel Open 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/brusselspadelopen.be","email":"hello@brusselspadelopen.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.554965"},"cn":{"name":"Circus Brussels Padel Open 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/brusselspadelopen.be","email":"hello@brusselspadelopen.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.554965"}},"place":{"id":258279,"translations":{"fr":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"La Gare Maritime : l'ancienne gare de fret devenue jungle urbaine, neutre en \u00e9nergie !\r\n\r\nElle offre le cadre id\u00e9al pour les \u00e9v\u00e9nements culturels innovants, les tournages de films ou s\u00e9ances photo, les march\u00e9s et foires, les lancements et promotions de produits. Les halles de la Gare Maritime ont \u00e9t\u00e9 transform\u00e9es en ville int\u00e9rieure. Elle comportera son propre food hall (\u00e0 partir de septembre 2021), des magasins exclusifs et des bureaux. Dans ce complexe, des espaces uniques et inspirants sont entrecoup\u00e9s de structures en bois chaleureuses. Le b\u00e2timent se pr\u00eate \u00e0 l'organisation de rencontres en petit comit\u00e9 ou de grands happenings. La nef monumentale, attrait architectural, est baign\u00e9e de lumi\u00e8re naturelle indirecte et offre suffisamment d'espace pour les activit\u00e9s int\u00e9rieures bien fr\u00e9quent\u00e9es.\r\nTout \u00e9v\u00e8nement dans la Gare Maritime sera un \u00e9v\u00e8nement \u00e9co-responsable. La durabilit\u00e9 \u00e9tait \u00e0 l'avant-plan pendant les r\u00e9novations du b\u00e2timent. L'\u00e9nergie renouvelable est produite sur place, utilisant la g\u00e9othermie et des panneaux photovolta\u00efques. Sur les promenades vertes bordant la nef centrale, des jardins \u00e0 th\u00e8me et des arbres \u00e0 haut tronc ont \u00e9t\u00e9 amen\u00e9s - comme si le parc voisin se faufile dans le b\u00e2timent. \r\nLa Gare Maritime, un lieu unique : attractif, novateur, ambitieux.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat","address_line2":"1000 Brussel","description_web":"Gare Maritime: van industrieel goederenstation tot energieneutrale urban jungle!\r\n\r\nDe Gare Maritime is de perfecte setting voor innovatieve, culturele evenementen, film- en fotoshoots, markten, beurzen, lanceringen en promoties. De historische stationshallen van de Gare Maritime zijn omgevormd tot overdekte stad, met foodhall (vanaf september 2021), exclusieve winkels en kantoren. Het gebouwencomplex biedt een waaier aan unieke, inspirerende ruimtes afgewisseld met warme houten volumes: perfect voor de organisatie van kleine en grootschalige happenings. D\u00e9 architecturale eyecatcher is de monumentale middenbeuk die baadt in indirect daglicht en over meer dan voldoende ruimte beschikt voor overdekte activiteiten met veel bezoekers.\r\nEen event in de Gare Maritime is een groen event. Tijdens de renovatie van het gebouw was duurzaamheid een speerpunt. Energie wordt ter plaatse hernieuwbaar opgewekt met geothermie en zonnepanelen. De groene wandelboulevards aan weerszijden van de middenbeuk zijn voorzien van thematuinen en hoogstammige bomen, alsof het aangrenzende park het gebouw binnenstroomt. Gare Maritime is een unieke plek: aantrekkelijk, vernieuwend en ambitieus.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard","address_line2":"1000 Brussels","description_web":"The Gare Maritime - From industrial freight station to energy neutral urban jungle!\r\n\r\nIt is the perfect setting for innovative cultural events, film or photo shoots, trade shows, fairs, product launches or promotions. \r\nThe historic station concourse that was part of the Gare Maritime has been transformed into an indoor city with its own food hall (coming September 2021), exclusive shops and offices. Countless unique and inspiring areas and warm, wooden structures alternate in this building complex. It is perfectly suited to accommodate both small and major events. The monumental nave is a true architectural eye-catcher, bathed in indirect sunlight and providing ample space for well-attended indoor activities.\r\nAny event in the Gare Maritime is a green event. Sustainability has been key during the renovation works. The building generates its own energy from renewable sources, using geothermics and solar panels. The green boulevards on either side of the nave are lined with themed gardens and tall trees, as if the adjacent park found its way inside. \r\nThe Gare Maritime is a unique place - attractive, innovative and ambitious.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","a