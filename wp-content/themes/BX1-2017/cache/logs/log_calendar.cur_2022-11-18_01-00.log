03-28T12:18:53+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/0660f363e501358cea1ea6581306f374baf4362e.png","width":1080,"height":1080,"ratio":1,"translations":{"fr":{"title":"5 minutes de gras","copyright":"Carole Lair"},"nl":{"title":"5 minutes de gras","copyright":"Carole Lair"},"en":{"title":"5 minutes de gras","copyright":"Carole Lair"}}}],"dates":[{"day":"2022-11-20","doors":"17:00:00","start":"17:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-18T17:35:03+02:00","published_at":"2022-10-18T17:22:51+02:00","backoffice_id":264323,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":1},{"id":544431,"date_start":"2022-11-20","date_end":"2022-11-20","date_next":"2022-11-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Concert du Dimanche \"Semer la Libert\u00e9\"","shortdescr":"Semer la Libert\u00e9 est un concert d\u00e9di\u00e9 par l'association Femmes Maestros au centenaire du campus ULB du Solbosch","longdescr":"Le concert \"Semer la Libert\u00e9\" est un hommage au centenaire du campus Solbosch \u00e0 travers plusieurs compositeurs symboles de lutte pour la libert\u00e9:\r\nProgramme :\r\n\u00ab Ragtime \u00bb : un style \u00ab pr\u00e9-jazz \u00bb c\u00e9l\u00e8bre dont le compositeur afro-am\u00e9ricain Scott Joplin est le ma\u00eetre reconnu dans ce genre aux variations rythmiques tr\u00e8s typiques des ann\u00e9es 1910.\r\n\r\n\u00ab La Muerte del Angel \u00bb : une des quatre pi\u00e8ces de la Suite de l\u2019Ange, par le grand r\u00e9novateur du tango Astor Piazzola. Cet ange est une m\u00e9taphore des souffrances humaines provoqu\u00e9es par l\u2019ambition et la haine.\r\n\r\n\u00ab Lullaby \u00bb : une pi\u00e8ce ravissante et touchante du grand compositeur am\u00e9ricain G. Gershwin, \u00e9galement auteur du c\u00e9l\u00e8bre Summertime et Porgy & Bess. Compos\u00e9e en 1919,\r\n\r\n\u00ab West Side Story \u00bb (extraits) : une c\u00e9l\u00e8bre m\u00e9taphore du th\u00e8me de Rom\u00e9o et Juliette, transpos\u00e9e dans une guerre entre gangs immigr\u00e9s des bas-fonds new-yorkais par le grand chef d\u2019orchestre Leonard Bernstein.\r\n\r\n\u00ab Adagio \u00bb : haute figure de la r\u00e9sistance contre le nazisme et puis contre la dictature grecque, Mikis Theodorakis a toujours \u00e9troitement m\u00eal\u00e9 sa carri\u00e8re musicale avec son engagement politique. Adagio est une composition extraite de la symphonie N\u00b01.\r\n\r\n\u00ab Danzon n\u00b02 \u00bb : m\u00e9connu en Europe, Arturo Marquez est un monument national dans son pays le Mexique et un inspirateur pour tous les compositeurs latino-am\u00e9ricains actuels.\r\n\r\n\u00ab Concerto pour orchestre-1er mouvement \u2018Allegro\u2019 \u00bb : par la compositrice polonaise Grazyna Bacewicz, une des rares \u00e0 avoir atteint la notori\u00e9t\u00e9 internationale avant la 2\u00e8me guerre mondiale, puis sous le r\u00e9gime communiste.","performers":"Orchestre \u00e0 cordes I Musici Brucellensis dirig\u00e9 par Zofia Wislocka","boxoffice_url":null,"website":"http:\/\/www.femmesmaestros.org","email":"femmes.maestros@gmail.com","phone_contact":"+32 473 28 02 17","pho