utras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":405,"location":{"lat":50.85107181,"lon":4.36006874},"region":"brussels","last_updated_at":"2023-04-24T02:35:54+02:00","published_at":"2013-10-19T01:13:30+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/e7aa4eac840956b41b85053514c5e0ec5867b80c.jpg","width":1754,"height":2480,"ratio":0.71,"translations":{"fr":{"title":"Judith Vanistendael. Art mouvant. ","copyright":null},"nl":{"title":"Judith Vanistendael. Art mouvant. ","copyright":null},"en":{"title":"Judith Vanistendael. Art mouvant. ","copyright":null},"de":{"title":"Judith Vanistendael. Art mouvant. ","copyright":null},"it":{"title":"Judith Vanistendael. Art mouvant. ","copyright":null},"sp":{"title":"Judith Vanistendael. Art mouvant. ","copyright":null},"pt":{"title":"Judith Vanistendael. Art mouvant. ","copyright":null},"cn":{"title":"Judith Vanistendael. Art mouvant. ","copyright":null}}}],"dates":[{"day":"202