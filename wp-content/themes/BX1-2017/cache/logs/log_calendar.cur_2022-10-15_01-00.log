ement un geste d\u2019\u00e9change et de solidarit\u00e9.","performers":"Les fabuleux b\u00e9n\u00e9voles de 1000BXL en Transition","boxoffice_url":null,"website":"http:\/\/1000bxlentransition.be\/all-project-list\/marche-gratuit\/","email":"1000bxlentransition@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.529848"},"nl":{"name":"Gratis markt 1000Bxl en Transition","shortdescr":"Een GRATIS MARKT is een markt waar alles gratis is!","longdescr":"Een GRATIS MARKT is een markt waar alles gratis is!\r\nElke 4de zaterdag van de maand van 14u. tot 16u. in het Steenkoolkaaipark (in de Sint-Katelijnewijk). Kom met wat je niet meer nodig hebt of kom met lege handen. Neem mee wat je kan gebruiken. Het is niet nodig om te geven om te kunnen krijgen.","performers":"De fantastische vrijwilligers van 1000BXL en Transition","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.529848"},"en":{"name":"March\u00e9 Gratuit 1000Bxl en Transition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.529848"},"de":{"name":"March\u00e9 Gratuit 1000Bxl en Transition - 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.529848"},"it":{"name":"March\u00e9 Gratuit 1000Bxl en Transition - 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.529848"},"sp":{"name":"March\u00e9 Gratuit 1000Bxl en Transition