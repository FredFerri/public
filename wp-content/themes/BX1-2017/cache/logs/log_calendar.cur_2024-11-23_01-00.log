l,"boxoffice_url":null,"website":"https:\/\/preventionsida.org\/fr\/expo\/","email":"info@preventionsida.org","phone_contact":"+32 2 733 72 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003226"},"en":{"name":"Expo \"VI(H)VRE, histoire d\u2019une lutte\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/preventionsida.org\/fr\/expo\/","email":"info@preventionsida.org","phone_contact":"+32 2 733 72 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003226"},"it":{"name":"Expo \"VI(H)VRE, histoire d\u2019une lutte\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/preventionsida.org\/fr\/expo\/","email":"info@preventionsida.org","phone_contact":"+32 2 733 72 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003226"},"cn":{"name":"Expo \"VI(H)VRE, histoire d\u2019une lutte\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/preventionsida.org\/fr\/expo\/","email":"info@preventionsida.org","phone_contact":"+32 2 733 72 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003226"},"fr":{"name":"Expo \"VI(H)VRE, histoire d\u2019une lutte\"","shortdescr":"Une expo qui retrace 40 ans de mobilisation contre le VIH\/sida - GRATUIT","longdescr":"Depuis plus de 40 ans, la Belgique et le monde se sont mobilis\u00e9 contre le VIH, un virus qui a profond\u00e9ment affect\u00e9 nos vies et notre soci\u00e9t\u00e9. \u00c0 cette occasion, la Plateforme Pr\u00e9vention Sida vous propose une grande exposition retra\u00e7ant cette lutte contre le virus, l\u2019ignorance et la stigmatisation. Des archives m\u00e9dias, des t\u00e9moignages poignants, une ligne du temps g\u00e9ante, des portrait photos et objets de collection qui ont fait l\u2019histoire du VIH\/sida dans notre pays. \nCet \u00e9v\u00e8nement est un hommage vibrant \u00e0 toute personne touch\u00e9e de pr\u00e8s ou de loin par le VIH. Il c\u00e9l\u00e8bre les progr\u00e8s r\u00e9alis\u00e9s tout en soulignant les d\u00e9fis qu\u2019il reste \u00e0 surmonter. ","performers":null,"boxoffice_url":null,"website":"https:\/\/preventionsida.org\/fr\/expo\/","email":"info@preventionsida.org","phone_contact":"+32 2 733 72 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003226"},"sp":{"name":"Expo \"VI(H)VRE, histoire d\u2019une lutte\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/preventionsida.org\/fr\/expo\/","email":"info@preventionsida.org","phone_contact":"+32 2 733 72 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003226"},"nl":{"name":"Expo \"VI(H)VRE, histoire d\u2019une lutte\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/preventionsida.org\/fr\/expo\/","email":"info@preventionsida.org","phone_contact":"+32 2 733 72 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003226"}},"place":{"id":50000495,"translations":{"de":{"name":"Bourse Brussels","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be","phone_contact":"+32 2 880 47 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Bourse Brussels","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be","phone_contact":"+32 2 880 47 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Bourse Brussels","address_street_name":"Beursplein","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/en","phone_contact":"+32 2 880 47 00","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Beursplein","address_line2":"1000 Brussels","description_web":"La Bourse, a magnificent building that was originally conceived as a home to the financial markets, has currently been transformed into a recreational place for public use. Located in the heart of the city, La Bourse underwent a thorough renovation and it now accomodates Belgian Beer World Experience. In addition, the building comprises spaces for young and old, a restaurant, a rooftop bar, an archaeological museum, co-working spaces, a shop and much more.\n\nThe Bourse building, following its spectacular transformation, is now even more of a vibrant meeting place for the people of Brussels and a must-see site for Belgian and international tourists. \n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Bourse Brussels","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be","phone_contact":"+32 2 880 47 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Bourse Brussels","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be","phone_contact":"+32 2 880 47 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Bourse de Bruxelles","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be","phone_contact":"+32 2 880 47 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":"La Bourse, un magnifique palais con\u00e7u au d\u00e9part pour la finance, s'est transform\u00e9e aujourd\u2019hui en espace de d\u00e9tente et de rencontre publique. Situ\u00e9e au c\u0153ur de Bruxelles la Bourse a \u00e9t\u00e9 repens\u00e9e et r\u00e9nov\u00e9e de la t\u00eate aux pieds. Elle abrite d\u00e9sormais le Belgian Beer World Experience. Le b\u00e2timent comprend : un espace pour petits et grands, un restaurant, un bar en rooftop, un mus\u00e9e arch\u00e9ologique, des salles de co-working, un shop et bien plus encore.\n\nLe b\u00e2timent de la Bourse, apr\u00e8s sa brillante m\u00e9tamorphose, est un espace de vie convivial et un lieu d\u00e9sormais incontournable pour les visiteurs belges et \u00e9trangers. \n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Bourse Brussels","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be","phone_contact":"+32 2 880 47 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Beurs van Brussel","address_street_name":"Beursplein","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/nl","phone_contact":"+32 2 880 47 00","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Beursplein","address_line2":"1000 Brussel","description_web":"De site omvat een indrukwekkend paleis dat oorspronkelijk ontworpen werd voor de handel, maar recent omgetoverd werd tot een openbare plek voor ontspanning en ontmoeting. De Beurs werd heruitgevonden en gerenoveerd, vanaf de kelders tot aan het spectaculaire dakterras. Ze herbergt nu ook Belgian Beer World Experience, met een ruimte voor jong en oud, een plek om te eten en bier te degusteren, een rooftop, een archeologisch museum, coworkingruimtes, een shop en nog veel meer.\n\nHet beursgebouw, na de huidige, fenomenale metamorfose wordt het een uiterst gezellige plek en een niet te missen toeristische hotspot voor bezoekers uit binnen - en buitenland. \n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":41239,"location":{"lat":50.8485722,"lon":4.3495865},"region":"brussels","last_updated_at":"2024-08-19T17:29:27+02:00","published_at":"2023-09-05T13:34:1