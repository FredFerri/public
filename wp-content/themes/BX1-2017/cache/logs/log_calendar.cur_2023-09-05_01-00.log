\/\/www.provelo.org\/events\/la-foret-de-soignes-toute-une-histoire-het-zonienwoud-een-plaats-met-geschiedenis-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561323"},"cn":{"name":"La For\u00eat de Soignes, toute une histoire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/la-foret-de-soignes-toute-une-histoire-het-zonienwoud-een-plaats-met-geschiedenis-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561323"},"fr":{"name":"La For\u00eat de Soignes, toute une histoire","shortdescr":"La for\u00eat de Soignes vous d\u00e9voile ses myst\u00e8res.","longdescr":"A seulement 4 km du centre-ville, la for\u00eat de Soignes s\u2019\u00e9tend sur 45 km\u00b2 aux portes de Bruxelles. Sautez en selle et partez \u00e0 la d\u00e9couverte de ce v\u00e9ritable poumon vert, class\u00e9 au patrimoine mondial de l\u2019UNESCO depuis 2017. Suivez le guide \u00e0 la recherche des lieux-dits et monuments qui pars\u00e8ment la for\u00eat. Retrouvez l\u2019ancienne abbaye de Groenendael, le vallon des enfants noy\u00e9s, la chapelle de la Reine ou encore Notre Dame de Bonne Odeur, autant d\u2019endroits oscillant entre l\u00e9gendes et histoire.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/la-foret-de-soignes-toute-une-histoire-het-zonienwoud-een-plaats-met-geschiedenis-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561323"},"sp":{"name":"La For\u00eat de Soignes, toute une histoire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/la-foret-de-soignes-toute-une-histoire-het-zonienwoud-een-plaats-met-geschiedenis-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561323"},"nl":{"name":"Het Zoni\u00ebnwoud : een plaats met geschiedenis","shortdescr":"Het Zoni\u00ebnwoud onthult zijn mysteries.","longdescr":"Op slechts 4 km van het centrum van de stad strekt het Zoni\u00ebnwoud zich aan de poorten van Brussel uit over 45 km\u00b2. Spring in het zadel en ontdek deze groene long, die sinds 2017 geklasseerd is als UNESCO-werelderfgoed. De gids neemt je op sleeptouw naar plaatsen en monumenten verspreid over het woud. Ontdek de voormalige abdij van Groenendael, de vallei van de verdronken kinderen, de Koninginnekapel of zelfs de Kapel Onze-Lieve-Vrouw van Willerieken, allemaal plaatsen waarvan niemand echt weet of ze legende en geschiedenis zijn.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/la-foret-de-soignes-toute-une-histoire-het-zonienwoud-een-plaats-met-geschiedenis-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561323"}},"place":{"id":280319,"translations":{"de":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":"Cycling for all\r\nIn order to develop and facilitate the use of the bicycle in Belgium, Pro Velo has been supporting individuals, governments, schools and companies since 1992. Our services are aimed at making cycling accessible to everyone through personal support. This way, Pro Velo contributes to a better quality of life!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":"Le v\u00e9lo accessible \u00e0 toutes et tous\r\nPour d\u00e9velopper et faciliter la pratique du v\u00e9lo en Belgique, Pro Velo  soutient les particuliers, les pouvoirs publics, les \u00e9coles et les entreprises depuis 1992.  Notre offre de services vise \u00e0 rendre le v\u00e9lo accessible \u00e0 tous et toutes au travers d\u2019un accompagnement personnalis\u00e9. Pro Velo contribue ainsi \u00e0 une meilleure qualit\u00e9 de vie !","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Pro Velo","address_street_name":"Dublinstraat","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Dublinstraat, 19","address_line2":"1050 Ixelles","description_web":"Fietsen voor iedereen\r\nOm het gebruik van de fiets in Belgi\u00eb te ontwikkelen en te vergemakkelijken steunt Pro Velo sinds 1992 particulieren, overheden, scholen en bedrijven. Onze diensten zijn erop gericht de fiets voor iedereen toegankelijk te maken door middel van persoonlijke ondersteuning. Pro Velo draagt bij tot een betere leven