263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:08:22+02:00","published_at":"2022-01-27T08:04:35+01:00","backoffice_id":246257,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.33974515584373},{"id":534065,"date_start":"2022-06-04","date_end":"2022-06-18","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,35],"translations":{"fr":["Galeries d'art","Bande dessin\u00e9e"],"nl":["Galeries","Stripverhaal"],"en":["Art Galleries","Comicstrip"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Jaime CALDER\u00d3N","shortdescr":"Exposition d'originaux de Jaime Calderon pour sa s\u00e9rie Valois. \r\nDessin de Jorge Calderon et Ester Punzano, fr\u00e8re et \u00e9pouse de Jaime Calderon.","longdescr":"Cr\u00e9abulles a le plaisir de vous annoncer sa prochaine exposition qui se d\u00e9roulera \u00e0 la Galerie Passerelle Louise du 4 au 18 juin 2022 (vernissage le 3 juin en pr\u00e9sence de l'auteur \u2013 s\u00e9ance de d\u00e9dicaces en nombre limit\u00e9 le 4 juin avec inscriptions au pr\u00e9alable lors du vernissage et priorit\u00e9, \u00e9videmment, aux nouveaux acqu\u00e9reurs d'un de ses originaux).\r\nJaime CALDER\u00d3N \u2013 le dessinateur des s\u00e9ries \"Les Voies du Seigneur\" et \"Isabelle La Louve de France\" (coll. Les Reines de Sang) nous fait l\u2019immense honneur et plaisir de revenir exposer des planches, illustrations et story-boards de sa s\u00e9rie Valois (tomes 3 et 4) publi\u00e9e chez Delcourt.\r\nParticiperont \u00e9galement \u00e0 l\u2019exposition Jorge Calder\u00f3n \u2013 bien connu sur le march\u00e9 des collectionneurs, le fr\u00e8re de Jaime Calder\u00f3n, \u00e9galement professeur \u00e0 l\u2019\u00e9cole FemArt de Barcelone, qui pr\u00e9sentera des dessins N&B de super-h\u00e9ros et d\u2019actrices de cin\u00e9ma ainsi qu\u2019Ester Punzano \u2013 dessinatrice\/peintre, la compagne de Jaime Calder\u00f3n, \u00e9galement professeure \u00e0 l\u2019\u00e9cole FemArt de Barcelone, dont nous pr\u00e9senteront plusieurs dessins couleur notamment de super-h\u00e9ros DC et Marvel.\r\nL'expo virtuelle sera \u00e9galement visible sur le site de Cr\u00e9abulles \u00e0 partir du 4 juin. Plus d\u2019infos \u00e0 : info@creabulles.be.\r\nExposition du 4 au 18 juin 2022\r\nGalerie Passerelle Louise\r\n34 rue Dejoncker - 1060 Bruxelles\r\nm\u00e9tro Louise et\/ou trams 8, 92, 93, 97 (Place Louise ou St\u00e9phanie)\r\nparking Louise Village (36 rue Dejoncker)","performers":"Juan Sanz Diaz, Jaime Calder\u00f3n et l'\u00e9quipe Cr\u00e9abulles","boxoffice_url":null,"website":"https:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534065.html"},"nl":{"name":"Jaime CALDER\u00d3N","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534065.html"},"en":{"name":"Jaime CALDER\u00d3N","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534065.html"},"de":{"name":"Expo Jaime CALDER\u00d3N","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/534065.html"},"it":{"name":"Expo Jaime CALDER\u00d3N","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/534065.html"},"sp":{"name":"Expo Jaime CALDER\u00d3N","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/534065.html"},"pt":{"name":"Expo Jaime CALDER\u00d3N","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/534065.html"},"cn":{"name":"Expo Jaime CALDER\u00d3N","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/534065.html"}},"place":{"id":260162,"translations":{"fr":{"name":"Galerie Passerelle Louise","address_street_name":"Rue Dejoncker","address_s