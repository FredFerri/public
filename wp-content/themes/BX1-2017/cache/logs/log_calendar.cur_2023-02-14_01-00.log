00f3n","pt":null,"cn":null}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"],"it":["Gallerie d'arte","Multidisciplinare"],"sp":["Galer\u00edas de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Insomnies en Ukraine","shortdescr":"Cette exposition, \u00e0 d\u00e9couvrir du 17 au 26 f\u00e9vrier 2023 aux KULT XL Ateliers\r\n& expo, permettra de rappeler le courage des Ukrainiens mais aussi la cr\u00e9ativit\u00e9 et le dynamisme d'une g\u00e9n\u00e9ration d'artistes et de d\u00e9veloppeurs qui ont su se mobiliser de fa\u00e7on exemplaire.","longdescr":"Un an apr\u00e8s l\u2019invasion militaire russe, l\u2019exposition \u201cInsomnies en Ukraine\u201d nous replonge dans les premiers jours de ce conflit qui n\u2019en finit pas depuis neuf ans. Les \u0153uvres s\u00e9lectionn\u00e9es retracent l'angoisse v\u00e9cue par la population civile, la m\u00e9tamorphose de la nation ukrainienne et l'h\u00e9ro\u00efsme quotidien de femmes, d\u2019hommes et d\u2019enfants qui ne demandent qu\u2019\u00e0 se rapprocher de l\u2019Europe.\r\n\r\nCette exposition, \u00e0 d\u00e9couvrir du 17 au 26 f\u00e9vrier 2023 aux KULT XL Ateliers\r\n& expo, permettra de rappeler le courage des Ukrainiens mais aussi la cr\u00e9ativit\u00e9 et le dynamisme d'une g\u00e9n\u00e9ration d'artistes et de d\u00e9veloppeurs qui ont su se mobiliser de fa\u00e7on exemplaire.","performers":"Artistes: Anton Abo, Pasha Velychko, Bohdana Davydiuk, Yulia Danilevska, Oksana Drachkovska, Inha Levi, Maria Kinovych, Dasha Klochko, Albina Kolesnichenko, Iryna Kostyshyna, Vika Krokhina, Olena Marchyshyna, Nika Nazarenko, Zhenia Oliinyk, Dasha Podoltseva, Zhenia Polosina, Oleksii Revika, Anna Sarvira, Olha Smyrnova, Sofia Sulii, Lydia Svi, Ivan Shkoropad, Natalia Shulha, Ihor Schultz.","boxoffice_url":null,"website":null,"email":"insomnies@proton.me","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549814"},"nl":{"name":"Slapeloos Oekra\u00efne","shortdescr":"Deze tentoonstelling van 17 tot 26 februari 2023 in KULT XL Ateliers & expo zal ons herinneren aan de moed van het Oekra\u00efense volk, maar ook aan de creativiteit en de dynamiek van een generatie kunstenaars die zich op voorbeeldige wijze wist te mobiliseren.","longdescr":"Een jaar na de Russiche militaire invasie, voert de tentoonstelling \"Slapeloos Oekra\u00efne\" ons terug naar de eerste dagen van dit negen jaar durende conflict. De geselecteerde werken tonen de angst van de burgerbevolking, de metamorfose van de Oekra\u00efense natie en de dagelijkse heldenmoed van vrouwen, mannen en kinderen die alleen maar dichter bij Europa willen komen.\r\n\r\nDeze tentoonstelling van 17 tot 26 februari 2023 in KULT XL Ateliers & expo zal ons herinneren aan de moed van het Oekra\u00efense volk, maar ook aan de creativiteit en de dynamiek van een generatie kunstenaars die zich op voorbeeldige wijze wist te mobiliseren.","performers":"Kunstenaars: Anton Abo, Pasha Velychko, Bohdana Davydiuk, Yulia Danilevska, Oksana Drachkovska, Inha Levi, Maria Kinovych, Dasha Klochko, Albina Kolesnichenko, Iryna Kostyshyna, Vika Krokhina, Olena Marchyshyna, Nika Nazarenko, Zhenia Oliinyk, Dasha Podoltseva, Zhenia Polosina, Oleksii Revika, Anna Sarvira, Olha Smyrnova, Sofia Sulii, Lydia Svi, Ivan Shkoropad, Natalia Shulha, Ihor Schultz.","boxoffice_url":null,"website":null,"email":"insomnies@proton.me","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549814"},"en":{"name":"Sleepless Ukraine","shortdescr":"Discover the creativity and talent of an exemplary generation of Ukrainians artists and IT developers, from 17 to 26 February 2023, at KULT XL Ateliers & expo.","longdescr":"One year after the Russian military invasion, the exhibition \u00ab Sleepless Ukraine \u00bb takes us back to the first days of this 9 years endless conflict. The selected artwork tracks back the civilian population anxiety, the Ukrainian nation metamorphosis and the daily bravery of women, men and children whose only wish is to get closer to Europe.\r\n\r\nDiscover the creativity and talent of an exemplary generation of Ukrainians\r\nartists and IT developers, from 17 to 26 February 2023, at KULT XL Ateliers\r\n& expo.","performers":"Artists: Anton Abo, Pasha Velychko, Bohdana Davydiuk, Yulia Danilevska, Oksana Drachkovska, Inha Levi, Maria Kinovych, Dasha Klochko, Albina Kolesnichenko, Iryna Kostyshyna, Vika Krokhina, Olena Marchyshyna, Nika Nazarenko, Zhenia Oliinyk, Dasha Podoltseva, Zhenia Polosina, Oleksii Revika, Anna Sarvira, Olha Smyrnova, Sofia Sulii, Lydia Svi, Ivan Shkoropad, Natalia Shulha, Ihor Schultz.","boxoffice_url":null,"website":null,"email":"insomnies@proton.me","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549814"},"de":{"name":"Insomnies en Ukraine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"insomnies@proton.me","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.549814"},"it":{"name":"Insomnies en Ukraine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"insomnies@proton.me","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.549814"},"sp":{"name":"Insomnies en Ukraine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"insomnies@proton.me","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.549814"},"pt":{"na