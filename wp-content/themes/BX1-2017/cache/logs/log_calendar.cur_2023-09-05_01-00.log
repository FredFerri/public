nnee_art_nouveau"]},{"id":557943,"date_start":"2023-06-04","date_end":"2023-09-10","date_next":"2023-09-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T02:00:41+02:00","published_at":"2023-05-30T16:25:33+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":277943,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.2723526468810813,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[109],"translations":{"de":["Gr\u00fcnfl\u00e4chen"],"pt":[null],"en":["Green spaces"],"it":["Spazi verdi"],"cn":[null],"fr":["Espaces verts"],"sp":["Espacios verdes:"],"nl":["Groene zones"]}}},"translations":{"de":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.557943"},"pt":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.557943"},"en":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557943"},"it":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.557943"},"cn":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.557943"},"fr":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":"Au d\u00e9part de la Guinguette du Parc de Laeken - Bar Andr\u00e9, un guide Arkadia vous fera d\u00e9couvrir l'histoire du parc et de ses environs. Les visites seront \u00e9galement ax\u00e9es sur l'\u00e9cologie et l'environnement et sensibiliseront les habitants \u00e0 l'importance des espaces verts dans la ville. :)\r\n\r\nLe point de rencontre avec le guide se trouve devant le kiosque de la guinguette.\r\nLes visites auront \u00e9galement lieu en cas de pluie.\r\n\r\nAvec le soutien de Bruxelles Environnement","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557943"},"sp":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.557943"},"nl":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557943"}},"place":{"id":266024,"translations":{"de":{"name":"Parc de Laeken ","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc de Laeken ","address_line2":"1000 Bruxelles","description_web":"Der Parc de Laeken befindet sich in der gleichnamigen Br\u00fcsseler Gemeinde und bildet gemeinsam mit dem Parc Osseghem, dem Parc Sobieski, dem Jardin Colonial und dem Jardin du Fleuriste die k\u00f6nigliche Dom\u00e4ne. Dabei ist das sch\u00f6ne landschaftliche Ensemble nur einen Katzensprung vom Atomium entfernt.\r\n\r\nDer Park im franz\u00f6sischen Stil zeichnet sich durch breite Alleen, gewundene Wege, weitl\u00e4ufige Rasenfl\u00e4chen, Blumenbeete und Baumgruppen aus.\r\n\r\nDie Magnolienallee f\u00fchrt Sie direkt zum Dynastiedenkmal im pr\u00e4chtigen neogotischen Stil. Es birgt ein Standbild von K\u00f6nig Leopold I. Die Turmspitze des Bauwerks \u00e4hnelt der des Br\u00fcsseler Rathauses, w\u00e4hrend die neun, von ebenso vielen Pinakeln \u00fcberragten Arkaden die damalige Anzahl der Provinzen des Landes symbolisieren. Sehenswert sind auch die Kapelle und der Brunnen der Heiligen Anna sowie der ehemalige US-Pavillon der Br\u00fcsseler Weltausstellung 1958.\r\n\r\nBegeben Sie sich dann auf einen Spaziergang durch die benachbarten Gr\u00fcnfl\u00e4chen des Parc de Laeken oder besuchen Sie das Atomium, Mini-Europe, das Planetarium oder das Design Museum Brussels. Nur wenige Schritte vom Park entfernt befinden sich der Japanische Turm und die Museen des Fernen Ostens.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Parque de Laeken","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parque de Laeken","address_line2":"1000 Bruxelles","description_web":"Situado no percurso do Passeio Verde, o parque de Laeken faz parte de um grande conjunto paisag\u00edstico que inclui ainda o Dom\u00ednio Real e v\u00e1rios parques ambientais da zona norte de Bruxelas (Osseghem, Jardins du Fleuriste, Sobieski, Colonial, etc.) O local apresenta uma decora\u00e7\u00e3o paisag\u00edstica de estilo franc\u00eas (um dos raros exemplos na B\u00e9lgica), com largas avenidas, trilhos sinuosos, vastos campos, relvados floridos, bosques, maci\u00e7os de teixo e louro-cereja. Quando faz sol, a disposi\u00e7\u00e3o das \u00e1rvores cria uma decora\u00e7\u00e3o e um jogo de sombras e de luz.O monumento da Dinastia \u00e9 o seu ponto alto, acess\u00edvel por duas vias sinuosas. Equipamentos:-Bancos-Mesa de piquenique-Parque infantil-Campo polidesportivo-M\u00e1quinas de fitness-Zona \u00abc\u00e3es em liberdade\u00bb Acessibilidade: O acesso ao parque de Laeken (regi\u00e3o de Bruxelas) faz-se pelas avenidas do Parque Real, da Dinastia, de Gros Tilleul e de Madrid. O parque est\u00e1 acess\u00edvel a pessoas com mobilidade reduzida.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Laeken Park ","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Laeken Park ","address_line2":"1000 Bruxelles","description_web":"As its name suggests, Laeken Park is located in the northern Brussels district of Laeken. It's part of the Royal Estate, together with the Osseghem and Sobieski parks, and the Colonial Garden and the Florist's Gardens. They form a large, landscaped estate within walking distance of the Atomium.\r\n\r\nThis French-style park has paths, winding walkways, lawns and copses. An avenue of magnolias leads you to the flamboyant neo-Gothic Dynasty monument. It houses a statue of King Leopold I, a spire similar to that of the City of Brussels Town Hall and nine arches topped by nine pinnacles, referring to the number of provinces in the country at the time. Discover also the chapel and the fountain of Saint Anne and the former United States pavilion of the 1958 Universal Exhibition.\r\n\r\nTake a stroll through the green areas surrounding Laeken Park and visit the Atomium, Mini-Europe, the Planetarium and the Design Museum Brussels. The Japanese Tower and the Museums of the Far East are just a stone's throw away.","description_print":"Opposite from the Royal Estate, Laeken Park was laid out in the \u201cEnglish style\u201d between 1876 and 1880 by Edouard Keilig, the landscape architect of the Bois de La Cambre. The site plays host to a rare American Chestnut tree with yellow flowers. ","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc de Laeken ","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc de Laeken ","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Parc de Laeken ","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc de Laeken ","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Parc de Laeken ","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc de Laeken ","address_line2":"1000 Bruxelles","description_web":"Comme son nom l\u2019indique, le parc de Laeken se trouve dans cette commune bruxelloise. Il fait partie du Domaine royal, avec les parcs d\u2019Osseghem et Sobieski, et les jardins Colonial et du Fleuriste. Ils forment ainsi un ensemble paysager \u00e0 deux pas de l\u2019Atomium.\r\n\r\n\u00c0 la fran\u00e7aise, le parc de Laeken poss\u00e8de des all\u00e9es, des sentiers sinueux, des pelouses, des bosquets\u2026 L\u2019all\u00e9e de magnolias vous m\u00e8ne au monument de la Dynastie, de style n\u00e9ogothique flamboyant. Abritant une statue du roi L\u00e9opold Ier, il est dot\u00e9 d\u2019une fl\u00e8che semblable \u00e0 celle de l\u2019H\u00f4tel de Ville de Bruxelles et de neuf arcades surmont\u00e9es de neuf pinacles, faisant r\u00e9f\u00e9rence au nombre de provinces du pays \u00e0 l\u2019\u00e9poque. D\u00e9couvrez aussi la chapelle et la fontaine Sainte-Anne ainsi que l\u2019ancien pavillon des \u00c9tats-Unis de l\u2019Exposition Universelle de 1958.\r\n\r\nPromenez-vous dans les espaces verts voisins du parc de Laeken et rendez-vous \u00e0 l\u2019Atomium mais aussi \u00e0 Mini-Europe, au Plan\u00e9tarium et au Design Museum Brussels. \u00c0 deux pas du parc se trouvent la Tour japonaise et les Mus\u00e9es d\u2019Extr\u00eame-Orient.","description_print":"Face au Domaine royal, le Parc de Laeken a \u00e9t\u00e9 am\u00e9nag\u00e9 \u00ab \u00e0 l\u2019anglaise \u00bb entre 1876 et 1880 par Edouard Keilig, l\u2019architecte paysagiste du Bois de La Cambre. Le site abrite un Marronnier am\u00e9ricain peu commun \u00e0 fleurs jaunes","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Parque Laeken","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parque Laeken","address_line2":"1000 Bruxelles","description_web":"Enfrente del Dominio Real, el parque Laeken se estableci\u00f3 al estilo ingl\u00e9s entre 1876 y 1880 por Edouard Keilig, el arquitecto paisajista del Bosque de la Cambre. El lugar alberga un particular casta\u00f1o con flores amarillas.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Park van Laken ","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Park van Laken ","address_line2":"1000 Bruxelles","description_web":"Dit park maakt, samen met het Ossegempark, het Sobieskipark, de Koloniale Tuinen en de Tuinen van de Bloemist, deel uit van het Koninklijk Domein. Dat is een mooie groene zone vlak bij het Atomium.\r\n\r\nHet park van Laken is aangelegd in Franse stijl. De kronkelende paadjes leiden je naar gazons en bosjes. Zie je de magnoliaplant? Die wijst je de weg naar het monument van de Dynastie. Let op de flamboyante neogotische stijl van het moument. Het herbergt een standbeeld van Koning Leopold I en heeft een spits die lijkt op die van het Stadhuis van Brussel. De negen bogen verwijzen naar het aantal provincies dat er vroeger in Belgi\u00eb was. Je ziet er ook de Sint-Annafontein en de Sint-Annakapel. In deze buurt zijn er nog restanten van de Wereldtentoonstelling van 1958, zoals het vroegere paviljoen van de Verenigde Staten.\r\n\r\nMaak een wandeling door de groene zones rond het park van Laken en bezoek het Atomium, Mini-Europa, het Planetarium en het Design Museum Brussel. De Japanse Toren en de Oosterse Musea liggen op een steenworp afstand van het park.","description_print":"Het Park van Laken, tegenover het Koninklijk Domein, werd tussen 1876 en 1880 aangelegd als een \u201cEngels\u201d landschapspark door Edouard Keilig, de landschapsarchitect die ook tekende voor het Ter Kamerenbos. Hier vinden we onder andere een ongebruikelijke Amerikaanse kastanjeboom met gele bloemen. ","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[1],"translations":{"de":["Heysel"],"pt":[null],"en":["Heysel"],"it":["Heysel"],"cn":[null],"fr":["Heysel"],"sp":["Heysel"],"nl":["Heysel"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":26024,"location":{"lat":50.89253085,"lon":4.348526},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2016-06-08T17:35:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1487,"translations":{"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arkadia","address_street_name":"rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"As specialists in architectural heritage and contemporary art, we make the public (re)discover the city through guided tours and conferences in several languages. \r\n\r\nOur activities :\r\nGuided tours by foot, bus and metro - Educational projects - Exceptional interior visit- Team Building \r\n\r\nArkadia offers a wide selection of guided tours, under different forms: \r\n* For individual, we propose an annual programmation (almost only in French), which will make you take a new and attentive look on the city of Brussels. \r\n* For groups we offer a series of fun and original activities, around history, architecture, art and in exceptional interiors. \r\n* For schools and children, we offer thematic, educational and entertaining tours and stages. \r\n\r\nOur expertise : Our team is made up of 60 guides, historians and art historians. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","ph