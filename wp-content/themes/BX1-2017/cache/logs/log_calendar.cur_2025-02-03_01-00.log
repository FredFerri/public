ducational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700005861,"date_start":"2025-02-08","date_end":"2025-02-08","date_next":"2025-02-08","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-27T17:37:13+01:00","published_at":"2025-01-27T17:28:19+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":316977,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Bl\u00e4serb\u00fcchlein, Ensemble InAlto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005861"},"pt":{"name":"Bl\u00e4serb\u00fcchlein, Ensemble InAlto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005861"},"en":{"name":"Bl\u00e4serb\u00fcchlein, Ensemble InAlto","shortdescr":"This intimate concert offers a spiritual journey, that of the human being, the fisherman in Luther's Germany. From sin to despair, then to the hope of salvation and the joy of redemption.\nThrough the musical evocation of these fundamental principles of the Protestant religion, this concert is a window onto the emotions of 16th and 17th century m","longdescr":"Bl\u00e4serB\u00fcchlein: Chorales by Johann Sebastian Bach, Johann Pachelbel, Christoph Pezel, Gottfried Reiche\n\nSince at least the end of the fifteenth century, the Leipzig City Council has employed professional Stadtpfeiffer (town ringers) to perform at municipal and social events such as dances, during official visits and in private circles at weddings.\nSince the end of the 16th century, they have also played twice a day from the tower of the town hall. In Leipzig, since the introduction of the Lutheran Reformation in 1539, the highest musical post was that of Kantor of St Thomas's Church, one of the city's six main churches.\nEmployed by the City Council, the Kantor was also responsible for conducting the Stadtpfeiffer. The legacy of the Renaissance and the polyphonic tradition has given rise to a close dependence between the vocal and instrumental repertoires.\nMany choral melodies originated in the first decades of the Reformation and bear witness to the naturally introspective dimension of Lutheran spirituality, built around the insistence that the individual recognise his or her own innate sinfulness and the need for inner transformation through grace. ","performers":"Ensemble Inalto, Lambert Colson","boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005861"},"it":{"name":"Bl\u00e4serb\u00fcchlein, Ensemble InAlto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005861"},"cn":{"name":"Bl\u00e4serb\u00fcchlein, Ensemble InAlto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005861"},"fr":{"name":"Bl\u00e4serb\u00fcchlein, Ensemble InAlto","shortdescr":"Ce concert intimiste propose un voyage spirituel, celui de l\u2019\u00eatre humain, du p\u00eacheur dans l\u2019Allemagne de Luther. Trajectoire du p\u00each\u00e9 vers le d\u00e9sespoir, puis l\u2019esp\u00e9rance dusalut et la joie de la r\u00e9demption.\nA travers l\u2019\u00e9vocation musicale de ces principes fondamentaux de la religion protestante, ce concert est une fen\u00eatre ouverte sur les \u00e9motions de l\u2019Homme des XVI\u00e8me et XVII\u00e8me si\u00e8cles. \n","longdescr":"Bl\u00e4serB\u00fcchlein:    Chorals de Johann Sebastian Bach, Johann Pachelbel, Christoph Pezel, Gottfried Reiche\n\nDepuis la fin du XV\u00e8me si\u00e8cle au moins, le Conseil de la ville de Leipzig employait des Stadtpfeiffer (sonneurs de ville) professionnels qui se produisaient lors des \u00e9v\u00e8nements municipaux et sociaux tels que les danses, durant les visites officielles et dans des cercles priv\u00e9s, lors des mariages.\nDepuis la fin du XVI\u00e8me si\u00e8cle, ils jouaient \u00e9galement deux fois par jour depuis la tour de l\u2019h\u00f4tel de ville. A Leipzig et depuis l\u2019introduction de la r\u00e9forme luth\u00e9rienne en 1539, le poste musical le plus \u00e9lev\u00e9 \u00e9tait celui de Kantor de l\u2019\u00e9glise Saint-Thomas, l\u2019une des six principales \u00e9glises de la ville.\nEmploy\u00e9 par le Conseil de la Ville, le Kantor devait \u00e9galement diriger les Stadtpfeiffer. L\u2019h\u00e9ritage de la renaissance et de la tradition polyphonique a fait na\u00eetre une \u00e9troite d\u00e9pendance entre r\u00e9pertoire vocal et instrumental.\nNombre de m\u00e9lodies de choral sont n\u00e9es dans les premi\u00e8res d\u00e9cennies de la R\u00e9forme et t\u00e9moignent de la dimension naturellement introspective de la spiritualit\u00e9 luth\u00e9rienne, construite autour de l\u2019insistance pour que l\u2019individu reconnaisse son propre p\u00each\u00e9 inn\u00e9 et le besoin de transformation int\u00e9rieure par la gr\u00e2ce. \nLoi et Evangile, p\u00each\u00e9 et gr\u00e2ce, damnation ou salut. Ces contrastes trouv\u00e8rent une expression accessible dans la musique du d\u00e9but du baroque.\nD\u00e8s le milieu du XVI\u00e8me si\u00e8cle, les luth\u00e9riens prescrivent un ou deux chorals pour chaque dimanche, en lien avec l\u2019\u00e9vangile. Plus tard, des organistes tels que Johann Walther, Johann Pachelbel ou Johann Sebastian Bach, \u00e9galement attach\u00e9s \u00e0 l\u2019importance des cantica de tempore cr\u00e9ent alors des recueils dans lesquels ces chorals sont organis\u00e9es dansl\u2019ordre de l\u2019ann\u00e9e liturgique, tel que le fameux Orgelb\u00fcchlein de Bach, ou encore les recueils Neumeister (pr\u00e9ludes de choral de jeunesse) ou Kirnberger. Puisant dans\nces recueils ainsi que dans le r\u00e9pertoire sp\u00e9cifique d\u00e9di\u00e9 aux Stadtpfeiffer de Leipzig tels que les collections de Gottfried Reiche et Johann Christoph Pezel, InAlto imagine ici le recueil musical d\u2019un groupe de souffleurs au 18\u00e8me si\u00e8cle.","performers":"Ensemble Inalto, Lambert Colson","boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005861"},"sp":{"name":"Bl\u00e4serb\u00fcchlein, Ensemble InAlto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005861"},"nl":{"name":"Bl\u00e4serb\u00fcchlein, Ensemble InAlto","shortdescr":"Dit intieme concert biedt een spirituele reis, die van de mens, de visser in het Duitsland van Luther. Van zonde naar wanhoop, dan naar de hoop op verlossing en de vreugde van verlossing.\nDoor de muzikale evocatie van deze fundamentele principes van de protestantse religie, is dit concert een venster op de emoties van de 16e en 17e eeuwse mens. ","longdescr":"Ten minste sinds het einde van de vijftiende eeuw heeft het stadsbestuur van Leipzig professionele Stadtpfeiffer (stadsklokkenluiders) in dienst om op te treden bij gemeentelijke en sociale evenementen zoals dansfeesten, tijdens offici\u00eble bezoeken en in priv\u00e9kringen bij bruiloften.\nSinds het einde van de 16e eeuw spelen ze ook twee keer per dag vanaf de toren van het stadhuis. In Leipzig was sinds de invoering van de Lutherse Reformatie in 1539 de hoogste muzikale functie die van Kantor van de Thomaskirche, een van de zes hoofdkerken van de stad.\nIn dienst van het stadsbestuur was de Kantor ook verantwoordelijk voor het dirigeren van de Stadtpfeiffer. De erfenis van de Renaissance en de polyfone traditie heeft geleid tot een nauwe afhankelijkheid tussen het vocale en instrumentale repertoire.\nVeel koraalmelodie\u00ebn ontstonden in de eerste decennia van de Reformatie en getuigen van de van nature introspectieve dimensie van de Lutherse spiritualiteit, opgebouwd rond de eis dat het individu zijn of haar eigen aangeboren zondigheid erkent en de behoefte aan innerlijke transformatie door genade. \n","performers":"Ensemble inalto, LMambert Colson","boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005861"}},"place":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard, 3","address_line2":"1000 Brussels","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Le Baixu","address_street_name":"Picardstraat","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat, 3","address_line2":"1000 Brussel","description_web":"De naam \"Baixu\" betekent \"mooi\" in de taal van de Pataxos indianen die in de zuidelijke staat Bahia (Brazili\u00eb) wonen. Dit woord staat voor de ambitie van het project en de kwaliteit van de culturele evenementen, maar ook voor de verbondenheid van de initiatiefnemers met de Braziliaanse cultuur. \r\nLe Baixu is ondergebracht in een voormalig industrieel gebouw in het hart van de trendy Brusselse Tour & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["N