-19T01:13:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/ba9a35d79bdf3918344b9e2d16d51b2ebf3d8a8e.png","width":1080,"height":1080,"ratio":1,"translations":{"fr":{"title":"Concert de cloture","copyright":"L'entrela"},"nl":{"title":"Concert de cloture","copyright":"L'entrela"},"en":{"title":"Concert de cloture","copyright":"L'entrela"}}}],"dates":[{"day":"2022-09-24","doors":null,"start":"18:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[8,7,11,10],"translations":{"fr":["Jeunes 15-18 ans","Jeunes 12-15 ans","Famille","Seniors"],"nl":["Jongeren 15-18 j.","Jongeren 12-15 j.","Familie","Senioren"],"en":["Youth 15-18  yr.","Youth 12-15  yr.","Family","Seniors"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-08T15:35:37+02:00","published_at":"2022-09-08T15:16:53+02:00","backoffice_id":261364,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":541420,"date_start":"2022-09-24","date_end":"2022-09-24","date_next":"2022-09-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","shortdescr":"Nous vous proposons de d\u00e9couvrir une visite en tandem avec un guide Arkadia et un architecte de la r\u00e9novation du site embl\u00e9matique de l\u2019ancien Hippodrome d\u2019Uccle-Boitsfort.","longdescr":"Notre cycle de \"visite avec expert\" vous propose une visite en tandem avec un guide Arkadia et un expert du lieu \u00e0 d\u00e9couvrir !Nous vous proposons de d\u00e9couvrir une visite en tandem avec un guide Arkadia et un architecte de la r\u00e9novation du site embl\u00e9matique de l\u2019ancien Hippodrome d\u2019Uccle-Boitsfort. Cette balade guid\u00e9e retracera l\u2019histoire du site et sa restauration en cours. Depuis son am\u00e9nagement en 1875 par l\u2019architecte Edouard Keilig \u00e0 l\u2019\u00e9poque de l\u2019engouement pour les courses hippiques, en passant par la p\u00e9riode moderniste des ann\u00e9es 40 et la construction de b\u00e2timents et annexes par l\u2019architecte Breydel, pour terminer par le d\u00e9clin et la d\u00e9gradation du site, jusqu\u2019\u00e0 sa r\u00e9habilitation r\u00e9cente. L'experte Julie Scandolo nous d\u00e9voilera les diff\u00e9rentes \u00e9tapes de cette restauration de longue haleine et notre guide arkadia resituera le b\u00e2timent dans son contexte historique.Une visite insolite, dans un lieu enchanteur.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541420"},"nl":{"name":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541420"},"en":{"name":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541420"},"de":{"name":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541420"},"it":{"name":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541420"},"sp":{"name":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541420"},"pt":{"name":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541420"},"cn":{"name":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541420"}},"place":{"id":266534,"translations":{"fr":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"L'hippodrome de Boitsfort est un parc de loisirs pour tous, au c\u0153ur de la nature et aux portes de la for\u00eat de Soignes. Au programme\u00a0: activit\u00e9s sportives, de d\u00e9tente, culturelles, p\u00e9dagogiques\u00a0; et d\u00e9couverte de la nature et du patrimoine architectural du site. Son concept, unique en Europe, est familial, interg\u00e9n\u00e9rationnel et tourn\u00e9 vers la nature. Apr\u00e8s avoir connu l\u2019\u00e2ge d\u2019or aux XIXe et XXe si\u00e8cles puis le d\u00e9clin \u00e0 partir des ann\u00e9es 1980, l\u2019Hippodrome rena\u00eet.\r\n\r\nBalade guid\u00e9e, accrobranche, golf, frisbee, spectacle \u00e0 la Petite Tribune... Reprenez des forces au Club House, avec une vue imprenable sur le green, ou au restaurant Le Pesage, dans un d\u00e9cor imagin\u00e9 par l\u2019architecte d\u2019int\u00e9rieur Lionel Jadot. Pour les enfants, une plaine de jeux \u00e9co-construite de 9400 m\u00b2\u00a0: labyrinthe, balan\u00e7oire g\u00e9ante, trampoline, tour d\u2019observation\u2026 Ainsi qu\u2019un point de vue unique \u00e0 360\u00b0 sur la for\u00eat de Soignes et sur Bruxelles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Hippodroom van Bosvoorde","address_street_name":"Terhulpensesteenweg","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Terhulpensesteenweg, 53 55","address_line2":"1180 Ukkel","description_web":"De vroegere renbaan van Bosvoorde ligt op het grondgebied van de gemeente Ukkel. Het is een recreatiepark midden in de natuur en vormt de poort van het Zoni\u00ebnwoud. Je kan er bijzonder veel doen. Er is namelijk plaats voor sport, ontspanning, cultuur en educatie. Ga er zeker eens op ontdekking in de natuur. Maar neem ook een kijkje in het gebouw. In de 19e en 20e eeuw trok de renbaan veel volk. Maar in de jaren tachtig kwam het verval. Nu is de Hippodroom weer springlevend, ook al zijn er geen paardenrennen meer.\r\n\r\nJe kan er deelnemen aan rondleidingen, een partijtje golf spelen, boomklimmen of naar een van de vele voorstellingen of feesten. In het Club House kom je weer op krachten en geniet je van het zicht op de green. Er is ook de mooie Pesage ontworpen door binnenhuisarchitect Lionel Jadot. Voor de kinderen is er een ecologische speeltuin van 9400 m\u00b2 met labyrint, reuzenschommel, trampoline, uitkijktoren... en een uniek 360\u00b0 uitzicht op het Zoni\u00ebnwoud en Brussel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Boitsfort Hippodrome","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"Boitsfort hippodrome is today a leisure park that\u2019s open to all, in the heart of nature by the Sonian Forest. It offers sporting, cultural, relaxation and pedagogical activities, along with opportunities to discover nature and the site\u2019s architectural heritage. Its concept, unique in Europe, is family-oriented, intergenerational and focused on nature. After a golden age in the 19th and 20th centuries and then a decline in the 1980s, the Hippodrome has been reborn.\r\n\r\nGuided walks, tree climbing, golf, frisbee, shows at the Petite Tribune... Recharge your batteries at the Club House, with a breathtaking view of the green, or at the Jardin du Pesage, in a setting designed by interior architect Lionel Jadot. For children, there's a 9,400m\u00b2 ecologically-built playground with a labyrinth, a giant swing, a trampoline, an observation tower... and a unique 360\u00b0 view of the Sonian Forest and Brussels.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"DROHME wie droom (Niederl\u00e4ndisch f\u00fcr Traum), aber auch wie drome, \u201edie Bewegung\u201c im Griechischen. Bei dem DROHME Park handelt es sich um die ehemalige Pferderennbahn von Boitsfort, die zu einem Naherholungsgebiet mit Freizeitangebot umgestaltet wurde \u2013 mitten in der Natur, am Rande des Waldes For\u00eat de Soignes. Auf dem Programm stehen sportliche, entspannende, kulturelle und p\u00e4dagogische Aktivit\u00e4ten sowie die Entdeckung der Natur und des architektonischen Erbes der Anlage. Das Konzept, das in Europa einzigartig ist, ist familienfreundlich, generationen\u00fcbergreifend und naturorientiert. Nachdem das Hippodrom im 19. und 20. Jahrhundert sein goldenes Zeitalter erlebt hatte und ab den 1980er-Jahren im Niedergang begriffen war, kann es nun wieder auf eine rosige Zukunft blicken!\r\n\r\nGef\u00fchrte Spazierg\u00e4nge, Hochseilgarten, Golf, Frisbee, Darbietungen in der Petite Tribune... Leckereien im Club House mit einem Blick ins Gr\u00fcne oder im Jardin du Pesage, der von dem Innenarchitekten Lionel Jadot gestaltet wurde. F\u00fcr Kinder gibt es einen 9400 m\u00b2 gro\u00dfen Natur- und Abenteuerspielplatz: Labyrinth, Riesenschaukel, Trampolin, Aussichtsturm... mit 360\u00b0-Ausblick auf den For\u00eat de Soignes und Br\u00fcssel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":26534,"location":{"lat":50.79681453,"lon":4.39647355},"region":"brussels","last_updated_at":"2022-09-09T04:05:38+02:00","published_at":"2016-10-05T10:02:02+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":276946,"translations":{"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+