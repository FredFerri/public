il.50011632"},"cn":{"name":"The Football Village Brussels Goes to  FOX Food Market | FREE ENTRANCE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/thefootballvillage.eu\/","email":"info@thefootballvillage.eu","phone_contact":"+32 495 53 43 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011632"},"fr":{"name":"The Football Village Brussels Goes to  FOX Food Market | FREE ENTRANCE","shortdescr":"The Football Village Brussels goes to\u00a0FOX Food Market | FREE ENTRANCE\nThe Football Village goes upscale in this trendy food court featuring 11 different restaurants in one great location. Entrance is FREE, no charge, no minimum!\nFood and Football, what a great combination \u2013 watch the match on our big screens while enjoying your choice of international delicacies!","longdescr":"The Football Village Brussels goes to\u00a0FOX Food Market | FREE ENTRANCE\n\n+ Like our Page : https:\/\/www.facebook.com\/thefootballvillage\/\n\n+ Like our Instagram : https:\/\/www.instagram.com\/thefootballvillage\/?hl=fr\n\n+ More infos : https:\/\/thefootballvillage.eu\/\n\n\n\n\nThe Football Village goes upscale in this trendy food court featuring 11 different restaurants in one great location. Entrance is FREE, no charge, no minimum!\nFood and Football, what a great combination \u2013 watch the match on our big screens while enjoying your choice of international delicacies!\n\nEasy access by public transport (metro 5, tram 8, bus 95 & 17), bicycle (separate bike path) or car (secure parking onsite).\n\nFox is open all day every day, so feel free to come early and stay late!\n\nThe Football Village since 2010, always the best place in Brussels for fans of all teams to watch international football.\n\n\nFOOD & DRINKS INSIDE & OUTSIDE\nSUNNY AFTERWORK & APERO ON THE TERRACE\nWATCH THE MATCH ON BIG SCREENS\n\n\n\n\n\nDes plats accessibles et raffin\u00e9s pour tous les go\u00fbts\n- Bap & Dak [Korean comfort food]\n- Coast [Ocean cuisine]\n- Lova by C\u00e9sar [For adults only]\n- La Truffe Noire [More than truffle]\n- Manhattns Burger [The ultimate burger]\n- Moza [Naples style]\n- Roca [South American street food]\n- Roru [Sushi Rolls & Bols de riz]\n- Sababa [Middle East cuisine]\n- Meraki [Greek streetonomie]\n- Kawa Club Une exp\u00e9rience sucr\u00e9e\n\ninformation: e-mail corporate@thefootballvillage.eu or call 0495 534 340\n\n\nThe Football Village\nFOX FOOD & FOOT MARKET\nBOULEVARD DU SOUVERAIN 25 - 1170 Brussels","performers":"FOX","boxoffice_url":null,"website":"https:\/\/thefootballvillage.eu\/","email":"info@thefootballvillage.eu","phone_contact":"+32 495 53 43 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011632"},"sp":{"name":"The Football Village Brussels Goes to  FOX Food Market | FREE ENTRANCE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/thefootballvillage.eu\/","email":"info@thefootballvillage.eu","phone_contact":"+32 495 53 43 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011632"},"nl":{"name":"The Football Village Brussels Goes to  FOX Food Market | FREE ENTRANCE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/thefootballvillage.eu\/","email":"info@thefootballvillage.eu","phone_contact":"+32 495 53 43 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011632"}},"place":{"id":50000802,"translations":{"de":{"name":"Mix Brussels","address_street_name":"Boulevard du Souverain","address_street_number":"25\/1","address_street_box":null,"email":"events@mix.brussels","website":"https:\/\/mix.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Boulevard du Souverain, 25\/1","address_line2":"1170 Waterma