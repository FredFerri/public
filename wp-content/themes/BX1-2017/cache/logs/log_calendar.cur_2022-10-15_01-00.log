,"end":"22:30:00"}]},"saturday":{"is_open":true,"hours":[{"start":"20:30:00","end":"22:30:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi et dimanche: ferm\u00e9","mercredi: de 19:30 \u00e0 21:30","jeudi, vendredi et samedi: de 20:30 \u00e0 22:30"],"nl":["maandag, dinsdag en zondag: gesloten","woensdag: van 19:30 tot 21:30","donderdag, vrijdag en zaterdag: van 20:30 tot 22:30"],"en":["monday, tuesday and sunday: closed","wednesday: from 19:30 to 21:30","thursday, friday and saturday: from 20:30 to 22:30"]},"date_start":"2022-09-15","date_end":"2022-10-22","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":26},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":22},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,261,265],"translations":{"fr":["Accessible","Parking accessible","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijke parking","Aangepast toilet"],"en":["Accessible","Accessible parking","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T02:07:03+02:00","published_at":"2022-06-23T15:13:52+02:00","backoffice_id":256818,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.54049193493723},{"id":540420,"date_start":"2022-10-06","date_end":"2022-10-22","date_next":"2022-10-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,35],"translations":{"fr":["Galeries d'art","Bande dessin\u00e9e"],"nl":["Galeries","Stripverhaal"],"en":["Art Galleries","Comicstrip"],"de":["Kunstgalerien","Comics"]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"Laurent Bidot - Apr\u00e8s la rafle du V\u00e9lodrome d'Hiver","shortdescr":null,"longdescr":"Ces planches originales de bande dessin\u00e9e de Laurent Bidot sont publi\u00e9es dans la BD \"Apr\u00e8s la rafle\", sc\u00e9naris\u00e9e par Arnaud Delalande, d\u2019apr\u00e8s l\u2019histoire de Joseph Weismann. Ce r\u00e9cit raconte la rafle du Vel d\u2019Hiv (V\u00e9lodrome d\u2019Hiver) de juillet 1942; l\u2019\u00e9vasion de Joseph Weismann d\u2019un camp d'internement allemand, ainsi que sa vie d\u2019adulte.\r\n\r\nJoseph Weismann est n\u00e9 \u00e0 Paris en 1931. Il a \u00e9t\u00e9 arr\u00eat\u00e9 le 16 juillet 1942 au cours de la rafle et conduit au V\u00e9lodrome d\u2019Hiver avec ses parents et ses deux s\u0153urs. Apr\u00e8s une d\u00e9tention de 15 jours au camp d\u2019internement de Beaune-La Rolande, Joseph est s\u00e9par\u00e9 des siens, et ne reverra jamais ses parents et ses deux s\u0153urs, qui sont d\u00e9port\u00e9s \u00e0 Auschwitz en Pologne.\r\n\r\nLe jour de cette s\u00e9paration, Joseph d\u00e9cide de s\u2019\u00e9vader du camp d\u2019internement. Il n\u2019a que onze ans quand il \u00e9chafaude un plan pour s\u2019enfuir, en compagnie d\u2019un autre enfant, Joseph Kogan. Ensemble, ils parviennent en plein jour \u00e0 se glisser sous 15 m\u00e8tres de barbel\u00e9s qu\u2019ils \u00ab d\u00e9tricotent \u00bb \u00e0 mains nues durant 6 heures. Ils survivront tandis que les autres enfants intern\u00e9s seront envoy\u00e9s \u00e0 la mort.\r\n\r\nPour illustrer ce r\u00e9cit bouleversant, Laurent Bidot malm\u00e8ne quelque peu sa ligne claire habituelle. Vous le constaterez, ses planches de BD d\u00e9voilent des visages souvent chiffonn\u00e9s, et les aplats de noir illustrent avec pertinence la gravit\u00e9 immense de certains instants. Via un encrage qu\u2019on croirait gorg\u00e9 de suie, il insuffle une fluidit\u00e9 remarquable \u00e0 ce r\u00e9cit historique, \u00e9maill\u00e9 de sc\u00e8nes d\u00e9chirantes.","performers":"Laurent Bidot, Joseph Weismann","boxoffice_url":null,"website":"http:\/\/www.lagaleriebd.com","email":"frederic@lagaleriebd.com","phone_contact":null,"phone_booking":"+32 485 98 56 18","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540420"},"nl":{"name":"Laurent Bidot - Apr\u00e8s la rafle du V\u00e9lodrome d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"comicartfactory@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540420"},"en":{"name":"Laurent Bidot - Apr\u00e8s la rafle du V\u00e9lodrome d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"comicartfactory@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540420"},"de":{"name":"Laurent Bidot - Apr\u00e8s la rafle du V\u00e9lodrome d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540420"},"it":{"name":"Laurent Bidot - Apr\u00e8s la rafle du V\u00e9lodrome d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540420"},"sp":{"name":"Laurent Bidot - Apr\u00e8s la rafle du V\u00e9lodrome d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540420"},"pt":{"name":"Laurent Bidot - Apr\u00e8s la rafle du V\u00e9lodrome d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540420"},"cn":{"name":"Laurent Bidot - Apr\u00e8s la rafle du V\u00e9lodrome d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540420"}},"place":{"id":271230,"translations":{"fr":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"237","address_street_box":null,"email":"comicartfactory@gmail.com","website":"https:\/\/www.comicartfactory.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre, 237","address_line2":"1050 Ixelles","description_web":"Situ\u00e9e au c\u0153ur de Bruxelles, proche du Quartier Europ\u00e9en, La galerie de la Bande Dessin\u00e9e est sp\u00e9cialis\u00e9e dans l\u2019exposition, l\u2019achat et la vente de planches originales de bande dessin\u00e9e et d\u2019illustrations originales.\r\n\r\nQue vous soyez passionn\u00e9s de bande dessin\u00e9e, lectrice ou lecteur occasionnel, fan de BD franco-belge ou de comics am\u00e9ricains, nous vous proposons d\u2019acheter les planches BD et les illustrations originales d\u2019autrices et d\u2019auteurs de bande dessin\u00e9e, prometteurs ou confirm\u00e9s.","description_print":"Situ\u00e9e au c\u0153ur de Bruxelles, proche du Quartier Europ\u00e9en, la galerie d\u2019art Comic Art Factory est sp\u00e9cialis\u00e9e dans l\u2019exposition, l\u2019achat et la vente de planches originales de bande dessin\u00e9e et d\u2019illustrations originales.\r\n\r\nQue vous soyez passionn\u00e9s de bande dessin\u00e9e, lectrice ou lecteur occasionnel, fan de BD franco-belge ou de comics am\u00e9ricains, nous vous proposons d\u2019acheter les planches BD et les illustrations originales d\u2019autrices et d\u2019auteurs de bande dessin\u00e9e, prometteurs ou confirm\u00e9s.\r\nNous proposons \u00e9galement un service de conseil pour celles et ceux qui souhaitent commencer une collection ou l\u2019affiner.\r\n\r\nNous sommes ouverts du jeudi au samedi, de 13 \u00e0 19h. Les autres jours sur rendez-vous. Nous vous recevrons avec plaisir, et partagerons avec vous notre passion pour le neuvi\u00e8me art.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Waversesteenweg","address_street_number":"237","address_street_box":null,"email":"comicartfactory@gmail.com","website":"https:\/\/www.comicartfactory.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Waversesteenweg, 237","address_line2":"1050 Elsene","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"237","address_street_box":null,"email":"comicartfactory@gmail.com","website":"https:\/\/www.comicartfactory.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre, 237","address_line2":"1050 Ixelles","description_web":"Based in the heart of Brussels, close to the European District, the gallery specializes in the exhibition, sale and purchase of original comic and illustration art.\r\nWhether you\u2019ve been fond of comic books since childhood or are just discovering this fantastic medium, we offer a selection of more than a thousand pieces from well-known and up-and-coming comic book artists, both European and American. We also showcase the art of children\u2019s book illustrators.","description_print":"Based in the heart of Brussels, close to the European District, the Comic Art Factory gallery specializes in the exhibition, sale and purchase of original comic and illustration art.\r\n\r\nWhether you\u2019ve been fond of comic books since childhood or are just discovering this fantastic medium, we offer a selection of more than a thousand pieces from well-known and up-and-coming comic book artists, both European and American. We also showcase the art of children\u2019s book illustrators.\r\nWe offer consulting services on how to build a collection, and are always interested in buying great pieces of art.\r\n\r\nIt would be a pleasure to have you at our gallery, where you can see our passion for sequential art firsthand. We\u2019re open Thursday through Saturday, 1 PM to 7 PM, as well as other days by appointment.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"237","address_street_box":null,"email":"comicartfactory@gmail.com","website":"https:\/\/www.comicartfactory.com","phone_contact":"+32 485 98 56 18","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre, 237","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La galerie de la Bande Dessin\u00e9e","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"237","address_street_box":null,"email":"comicartfactory@gmail.com","website":"https:\/\/www.comicartfactory.com","phone_contact":"+32