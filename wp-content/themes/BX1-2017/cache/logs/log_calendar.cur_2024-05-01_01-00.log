ss_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Aujourd'hui, plus de 180 nationalite\u0301s vivent ensemble a\u0300 Bruxelles. Le MigratieMuseumMigration raconte l\u2019histoire de la premie\u0300re ge\u0301ne\u0301ration de travailleurs immigre\u0301s invite\u0301s, des premiers arrivants au Petit Cha\u0302teau, des expatrie\u0301s, des re\u0301fugie\u0301s de guerre, des Europe\u0301ens qui se sont de\u0301place\u0301s librement au sein de l\u2019UE et de tous les autres. C\u2019est un muse\u0301e chaleureux ou\u0300 les visiteurs peuvent de\u0301couvrir la ville et la vie des autres a\u0300 travers des souvenirs, mais aussi, et avant tout, un lieu accueillant pour y partager sa propre histoire.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MigratieMuseumMigration","address_street_name":"Werkhuizenstraat","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Werkhuizenstraat, 17","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Vandaag de dag wonen meer dan 180 nationaliteiten samen in Brussel. Het MigratieMuseumMigration geeft de verhalen van de eerste generatiegastarbeiders, van de vroegste bewoners van het Klein Kasteeltje, van de expats, de oorlogsvluchtelingen, de Europeanen die zich vrij bewegen binnen de EU en vele anderen een permanente thuis. Het is een warme omgeving waar bezoekers via herinneringen en kunst op ontdekking gaan in Brussel en in het leven van anderen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":34307,"location":{"lat":50.85769281,"lon":4.34360176},"is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/a4b326867cb48dfd28d525701e186daed622f9b3.png","width":1414,"height":2000,"ratio":0.71,"oEmbed_height":2000,"oEmbed_width":1414,"translations":{"de":{"title":"Les survivants invisibles de l'Holocauste","copyright":"MigratieMuseumMigration"},"pt":{"title":"Les survivants invisibles de l'Holocauste","copyright":"MigratieMuseumMigration"},"en":{"title":"The invisble survivors of the Holocaust","copyright":"MigratieMuseumMigration"},"it":{"title":"Les survivants invisibles de l'Holocauste","copyright":"MigratieMuseumMigration"},"cn":{"title":"Les survivants invisibles de l'Holocauste","copyright":"MigratieMuseumMigration"},"fr":{"title":"Les survivants invisibles de l'Holocauste","copyright":"MigratieMuseumMigration"},"sp":{"title":"Les survivants invisibles de l'Holocauste","copyright":"MigratieMuseumMigration"},"nl":{"title":"De onzichtbare overlevenden van de Holocaust","copyright":"MigratieMuseumMigration"}}}],"dates":[{"day":"2024-04-09","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-04-10","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-04-11","doors":null,"start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":fals