ll],"cn":[null]}},"tags":["exterior","annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-06T14:35:04+01:00","published_at":"2022-11-17T16:22:58+01:00","backoffice_id":265814,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.22232392577062},{"id":540491,"date_start":"2022-10-29","date_end":"2023-07-01","date_next":"2023-03-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"],"it":["Cabaret"],"sp":["Caf\u00e9 teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"MALEDICTION - Spectacle d'improvisation des Y\u00e9tis-Garous","shortdescr":null,"longdescr":"* MALEDICTIONS *\r\n\r\nDescription :Le jour ils sont comme tout le monde, poli, respectable, pr\u00e9sentable, de vrais citoyens. Mais \u00e0 la tomb\u00e9 de la nuit! La mal\u00e9diction s'abat sur eux! tout comme le y\u00e9tis-garous se transforme durant la nuit.\r\nVenez jeter votre mal\u00e9diction sur ces pauvres infortun\u00e9s personnages qui devront trouver ensemble comment s'en lib\u00e9rer.\r\nVenez voir deux histoires de mal\u00e9dictions, le tout racont\u00e9 par un narrateur impitoyable qui se fera un plaisir de voir ses personnages se d\u00e9battre face aux mal\u00e9dictions qui les emp\u00e8cheront de mener leur vie normale.\r\n\r\n\r\nSpectacle tout public des Y\u00e9tis-Garous\r\n\r\n\r\n\r\n-------\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (Vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\nSur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\nSur place : 15\u20ac\/personne","performers":"L'\u00e9quipe des Y\u00e9tis-Garous","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540491"},"nl":{"name":"MALEDICTION - Spectacle d'improvisation des Y\u00e9tis-Garous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540491"},"en":{"name":"MALEDICTION - Spectacle d'improvisation des Y\u00e9tis-Garous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540491"},"de":{"name":"MALEDICTION - Spectacle d'improvisation des Y\u00e9tis-Garous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540491"},"it":{"name":"MALEDICTION - Spectacle d'improvisation des Y\u00e9tis-Garous","shortdescr":null,"long