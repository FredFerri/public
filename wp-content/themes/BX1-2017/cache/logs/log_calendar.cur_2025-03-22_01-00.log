d_at":"2025-02-25T16:52:03+01:00","published_at":"2025-02-06T15:12:46+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317739,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"tour","ranking":0.7937005259840998,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Flagey NIR","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006286"},"pt":{"name":"BANAD Festival - Guided tour of the Flagey NIR","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006286"},"en":{"name":"BANAD Festival - Flagey NIR","shortdescr":null,"longdescr":"\u201eSound factory\" and \"ocean liner Flagey\" \u2013 that's how this building is also sometimes called. It was constructed from 1935 to 1938 by the architect Joseph Diongre who also built the Saint-Jean-Baptiste church in Molenbeek. Its simple aesthetics can be described as a combination of Art Deco and modest international style. Also known worldwide for the quality of its acoustics, the building was designed as a complete work of art, the architect having also designed its furniture. After the television had its big breakthrough in 1953, the building was closed in 1995 and luckily restored and repurposed in 1998. Since then it has become a new vibrant hub of Brussels' cultural life.\n\nArch. Joseph DIONGRE 1935 - 1938","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006286"},"it":{"name":"BANAD Festival - Guided tour of the Flagey NIR","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006286"},"cn":{"name":"BANAD Festival - Guided tour of the Flagey NIR","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006286"},"fr":{"name":"BANAD Festival - INR Flagey","shortdescr":null,"longdescr":"\"Usine \u00e0 son\", \"paquebot Flagey\", tels sont les surnoms de ce b\u00e2timent construit en 1935 et 1938 par l'architecte Joseph Diongre, d\u00e9j\u00e0 auteur de l'\u00e9glise Saint-Jean-baptiste \u00e0 Molenbeek. Son esth\u00e9tique d\u00e9pouill\u00e9e oscille entre Art d\u00e9co et style international mod\u00e9r\u00e9. \u00c9galement reconnu mondialement pour la qualit\u00e9 de son acoustique, le b\u00e2timent a \u00e9t\u00e9 con\u00e7u comme une oeuvre d'art total, l'architecte en ayant \u00e9galement dessin\u00e9 le mobilier. Le b\u00e2timent qui vit en 1953 l'av\u00e8nement de la t\u00e9l\u00e9vision, fut ferm\u00e9 en 1995 et heureusement restaur\u00e9 et r\u00e9affect\u00e9 en 1998. Il constitue depuis plusieurs ann\u00e9es un nouveau p\u00f4le dynamique de la vie culturelle bruxelloise.\n\nArch. Joseph DIONGRE 1935 - 1938","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006286"},"sp":{"name":"BANAD Festival - Guided tour of the Flagey NIR","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006286"},"nl":{"name":"BANAD Festival - Flagey NIR","shortdescr":null,"longdescr":"\"Geluidsfabriek\", het \"Flagey-schip\" zijn enkele bijnamen voor dit gebouw ontworpen tussen 1935 en 1938 door architect Joseph Diongre, die reeds de Sint-Jan-de-Doperkerk in Molenbeek voor zijn rekening had genomen. De ingetogen esthetiek schommelt tussen art deco en een gematigde internationale stijl. Ook wereldwijd erkend voor de kwaliteit van zijn akoestiek, werd het gebouw opgevat als een totaalkunstwerk, waarbij de architect ook het meubilair heeft ontworpen. Het gebouw, dat in 1953 de komst van televisie zag, werd in 1995 gesloten en gelukkig in 1998 hersteld en opnieuw in gebruik genomen. Sinds enkele jaren is het een dynamisch nieuw centrum van het culturele leven in Brussel.\n\nArch. Joseph DIONGRE 1935 - 1938","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agend