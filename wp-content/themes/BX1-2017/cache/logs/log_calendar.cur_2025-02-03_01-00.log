istances","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.577587"},"en":{"name":"Expo: Au Foyer des R\u00e9sistances","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.577587"},"it":{"name":"Expo: Au Foyer des R\u00e9sistances","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.577587"},"cn":{"name":"Expo: Au Foyer des R\u00e9sistances","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.577587"},"fr":{"name":"Expo: Au Foyer des R\u00e9sistances","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.577587"},"sp":{"name":"Expo: Au Foyer des R\u00e9sistances","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.577587"},"nl":{"name":"Expo: Au Foyer des R\u00e9sistances","shortdescr":"Studenten verbeelden het recht op huisvesting. Naar aanleiding van Steden, Labo's voor de Toekomst.","longdescr":"Info in het Nederlands \/ Information in English \/ Infos en fran\u00e7ais\n\nNL\u00a0\u2013 Au Foyer des R\u00e9sistances is een reizende tentoonstelling, geboren uit een samenwerking tussen studenten architectuur en stedenbouw van de ULB en VUB. De expo, oorspronkelijk opgezet in het verlaten caf\u00e9 Au Foyer in de Marollen, belicht de geschiedenis van het Brusselse woonprotest sinds de jaren 60.\n\nNaar aanleiding van Steden, Labo\u2019s voor de Toekomst: Wonen voor iedereen, een gespreksavond over toegankelijke huisvesting en alternatieve woonvormen, is de expo te zien in Muntpunt.\n\nMeer info over de tentoonstelling vind je hier.\n\n- - -\n\n\n\nEN \u2013 Au Foyer des R\u00e9sistances is a traveling exhibition, born from a collaboration between architecture and urban planning students from ULB and VUB. Initially set up in the abandoned caf\u00e9 Au Foyer in the Marolles, the expo sheds light on the history of housing protests in Brussels since the 1960s.\n\nIn the context of\u00a0Steden, Labo\u2019s voor de Toekomst: Wonen voor iedereen, a panel discussion on accessible housing and alternative living models, the exhibition will be on display at Muntpunt.\n\nFind more information about the exhibition\u00a0here.\n\n- - -\n\n\n\nFR\u00a0\u2013 Au Foyer des R\u00e9sistances est une exposition itin\u00e9rante, n\u00e9e d'une collaboration entre des \u00e9tudiant\u00b7es en architecture et en urbanisme de l'ULB et de la VUB. Initialement install\u00e9e dans le caf\u00e9 abandonn\u00e9 Au Foyer des Marolles, l'exposition met en lumi\u00e8re l'histoire des luttes pour le droit au logement \u00e0 Bruxelles depuis les ann\u00e9es 1960.\n\nDans le cadre de Steden, Labo\u2019s voor de Toekomst: Wonen voor iedereen, une soir\u00e9e-d\u00e9bat sur le logement accessible et les formes d\u2019habitat alternatives, l\u2019exposition sera visible \u00e0 Muntpunt.\n\nTrouvez plus d'informations sur l'exposition ici.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.577587"}},"place":{"id":267757,"translations":{"de":{"name":"Muntpunt, Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Muntpunt, Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Muntpunt, Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place de la Monnaie","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Muntpunt, Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie","address_line2":"1000 Bruxelles","description_web":nu