e_url":null,"website":"https:\/\/www.teroubi.be\/festival-2024-bruxelles","email":"info@teroubi.be","phone_contact":"+32 494 45 61 05","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009830"},"cn":{"name":"Festival l'Afrique En Couleurs 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.teroubi.be\/festival-2024-bruxelles","email":"info@teroubi.be","phone_contact":"+32 494 45 61 05","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009830"},"fr":{"name":"Festival l'Afrique En Couleurs 2024","shortdescr":"\nDans quelques mois d\u00e9j\u00e0, quand printemps sera derri\u00e8re nous et que l'\u00e9t\u00e9 sera d\u00e9j\u00e0 bien entam\u00e9, il sera temps de mettre les voiles !\nLes petits et les grands pourront se d\u00e9tendre, prendre du bon temps, pour le plus grand bonheur de leurs papilles gustatives, leurs oreilles, leur savoir, et l'ambiance g\u00e9n\u00e9rale qui s'y d\u00e9gagera, le temps d'un week-end d'\u00e9t\u00e9 !","longdescr":"Quel plaisir de vous convier pour cette 9i\u00e8me \u00e9dition du festival L'Afrique en Couleurs !\nLe Festival l'Afrique en En Couleurs, un moment privil\u00e9gi\u00e9 pour mettre les richesses culturelles de l\u2019Afrique en avant pour le public belge, en pr\u00e9sentant des artistes de tous horizons: musiciens, chanteurs, danseurs, artisans, exposants, cuisiniers\u2026 L\u2019occasion de d\u00e9couvrir diverses communaut\u00e9s culturelles symbolisant le visage cosmopolite de Bruxelles et de ses environs, r\u00e9unies au sein d\u2019une f\u00eate de la fraternit\u00e9 !\nLa tradition du Festival L'Afrique en Couleurs est de faire d\u00e9couvrir tout le panel artistique et culturel du grand continent entre M\u00e9diterran\u00e9e et oc\u00e9an Indien, entre Atlantique et mer Rouge. Un festival tout public, o\u00f9 les familles, les bandes d'ami-e-s et les f\u00eatard-e-s trouveront leur bonheur au gr\u00e9 des stands, des ateliers, des spectacles, des animations pour enfants et pour adultes et des shows sc\u00e9niques !\n","performers":"\u2022 Des concerts d\u2019artistes venants tout droit d'afrique\n\u2022 Des groupes de ballets africains\n\u2022 Des Workshops gratuits de danses et percussions\n\u2022 Des animations de rue au fil de la journ\u00e9e\n\u2022 Des expositions, un march\u00e9 artisanal et un buffet africain\n\u2022 Des kiosques et Eshop commerce \u00e9quitables et durables ainsi que des association s en lien direct o\u00f9 indirecte avec l'Afrique. \n\n","boxoffice_url":null,"website":"https:\/\/www.teroubi.be\/festival-2024-bruxelles","email":"info@teroubi.be","phone_contact":"+32 494 45 61 05","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009830"},"sp":{"name":"Festival l'Afrique En Couleurs 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.teroubi.be\/festival-2024-bruxelles","email":"info@teroubi.be","phone_contact":"+32 494 45 61 05","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009830"},"nl":{"name":"Festival l'Afrique En Couleurs 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.teroubi.be\/festival-2024-bruxelles","email":"info@teroubi.be","phone_contact":"+32 494 45 61 05","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009830"}},"place":{"id":50001244,"translations":{"de":{"name":"Tour et Taxis","address_street_name":"Tour & Taxis, 86C Avenue du Port","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Tour & Taxis, 86C Avenue du Port","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"bo