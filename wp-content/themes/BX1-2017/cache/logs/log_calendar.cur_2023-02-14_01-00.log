ine2":"1050 Ixelles","description_web":"Stieglitz19 has been a gallery specialized in contemporary photography for 15 years, with a strong focus on Chinese and Japanese photography. The artists use the medium of photography as a basis, but are mainly innovators in contemporary photography. In 2022, Stieglitz19 opened a second location in Brussels. The gallery organises four exhibitions a year, participates in a number of art fairs and establishes partnerships with museums in Belgium and abroad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Stieglitz19 Brussels","address_street_name":"Rue Saint-Georges","address_street_number":"24","address_street_box":null,"email":"info@stieglitz19.be","website":"http:\/\/www.stieglitz19.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Saint-Georges, 24","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Stieglitz19 Brussels","address_street_name":"Rue Saint-Georges","address_street_number":"24","address_street_box":null,"email":"info@stieglitz19.be","website":"http:\/\/www.stieglitz19.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Saint-Georges, 24","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Stieglitz19 Brussels","address_street_name":"Rue Saint-Georges","address_street_number":"24","address_street_box":null,"email":"info@stieglitz19.be","website":"http:\/\/www.stieglitz19.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Saint-Georges, 24","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"St