LGTBQIA","Jugendliche 15-18 Jahre"],"it":[null,null,null,null],"sp":[null,null,null,null],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-01-01T01:06:29+01:00","published_at":"2022-08-16T11:16:33+02:00","backoffice_id":259560,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.12483766215501},{"id":509509,"date_start":"2021-03-06","date_end":"2023-08-31","date_next":"2023-01-07","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"],"de":["Ausgefallenes"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L'Art dans le M\u00e9tro Bruxellois","shortdescr":"Descendez avec nous quelques vol\u00e9es d\u2019escalators et partons \u00e0 la d\u00e9couverte du mus\u00e9e le plus tentaculaire de Bruxelles, r\u00e9parti sur -ou plut\u00f4t sous\u2013 toute la superficie de la ville.","longdescr":"Vous ne les voyez pas, ou presque pas, et pourtant elles sont l\u00e0. Le r\u00e9seau m\u00e9tropolitain bruxellois pr\u00e9sente plus de 80 \u0153uvres d\u2019Art r\u00e9parties dans ses 69 stations. Un v\u00e9ritable mus\u00e9e souterrain que visitent chaque jour, presque sans le voir, des dizaines de milliers de personnes !\r\n\r\nBrussels By Foot vous a concoct\u00e9 un parcours in\u00e9dit au d\u00e9tour d\u2019une dizaine de stations pour vous faire d\u00e9couvrir quelques-unes des oeuvres les plus embl\u00e9matiques du m\u00e9tro bruxellois. Une balade conviviale, originale et in\u00e9dite loin du m\u00e9tro-boulot-dodo !\r\n\r\nLe parcours est pens\u00e9 pour vous montrer la plus grande vari\u00e9t\u00e9 d\u2019\u0153uvres, que ce soit au niveau stylistique, de mat\u00e9riaux et techniques utilis\u00e9s ou de th\u00e9matiques abord\u00e9es\u2026\r\n\r\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\r\nAvez-vous d\u00e9j\u00e0 pr\u00eat\u00e9 attention aux \u0153uvres dans le m\u00e9tro ? Pourquoi telle gravure \u00e0 tel endroit ? Pourquoi cette fresque se trouve ici, et cette peinture l\u00e0-bas ? Quels sont leurs liens avec cette station particuli\u00e8re, avec Bruxelles ?\r\n\r\nPour en savoir plus, descendez avec nous quelques vol\u00e9es d\u2019escalators, et partons \u00e0 la d\u00e9couverte des tr\u00e9sors cach\u00e9s du m\u00e9tro bruxellois.\r\n\r\nAu programme de la balade, entre autres\u2026\r\n\r\n\u2013 Le \u201cZigzagramme\u201c, \u00e0 ne pas \u201czyeuter\u201d trop longtemps\u2026 ;\r\n\u2013 Le \u201cPassage inconnu\u201c, de Fran\u00e7ois Schuiten ;\r\n\u2013 Le \u201cMille-feuille\u201d qui \u00e9clairera votre journ\u00e9e \u00e0 coup s\u00fbr ;\r\n\u2013 \u201cHappy Metro To You\u201c, de Marc Mendelson, qui lance un regard amusant sur notre soci\u00e9t\u00e9 ;\r\n\u2013 \u2026Mais aussi, comme dans toutes les visites de Brussels By Foot, de nombreuses petites histoires et anecdotes!\r\n\r\n\r\nINFORMATIONS PRATIQUES\r\n\r\nTours r\u00e9guliers en fran\u00e7ais et en anglais :\r\nPrix  : Libre et conscient\r\nDur\u00e9e : Environ 1h45\r\nRendez-vous : Devant l\u2019entr\u00e9e de la Station Parc (rdv en surface)\r\nAu coin du Parc Royal, 1000 Bruxelles\r\nFin du tour : Arts-Loi\r\n\r\n!! Pr\u00e9voir 2 titres de transport valables par personne !!\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais ou en anglais","performers":"Une visite guid\u00e9e originale de la compagnie de guides ind\u00e9pendants Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/lart-dans-le-metro\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.509509"},"nl":{"name":"L'Art dans le M\u00e9tro Bruxellois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.509509"},"en":{"name":"L'Art dans le M\u00e9tro Bruxellois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.509509"},"de":{"name":"L'Art dans le M\u00e9tro Bruxellois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.509509"},"it":{"name":"L'Art dans le M\u00e9tro Bruxellois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.509509"},"sp":{"name":"L'Art dans le M\u00e9tro Bruxellois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.509509"},"pt":{"name":"L'Art dans le M\u00e9tro Bruxellois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.509509"},"cn":{"name":"L'Art dans le M\u00e9tro Bruxellois",