:false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-07-14T20:15:04+02:00","published_at":"2023-06-26T14:56:01+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":280403,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Le quartier des quais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560403"},"pt":{"name":"Le quartier des quais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560403"},"en":{"name":"Le quartier des quais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560403"},"it":{"name":"Le quartier des quais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560403"},"cn":{"name":"Le quartier des quais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560403"},"fr":{"name":"Le quartier des quais","shortdescr":null,"longdescr":"Le quartier du B\u00e9guinage \u00e0 Bruxelles poss\u00e8de une histoire presque mill\u00e9naire. Les b\u00e9guines qui s\u2019y installent d\u00e8s le XIIIe si\u00e8cle lui donneront son nom et y laisseront un des plus beaux t\u00e9moignages de l\u2019architecture baroque \u00e0 Bruxelles : l\u2019\u00e9glise du B\u00e9guinage. Au d\u00e9but du XIXe si\u00e8cle, le quartier sera compl\u00e8tement r\u00e9am\u00e9nag\u00e9 avec la construction du Grand Hospice qui accueillera mendiants, vieillards et malades derri\u00e8re des murs d\u2019une grande sobri\u00e9t\u00e9, tr\u00e8s repr\u00e9sentatifs de l\u2019architecture n\u00e9oclassique \u00e0 la mode en ce d\u00e9but de si\u00e8cle.\r\n\r\nCette promenade nous emm\u00e8ne dans un quartier peu connu du centre de Bruxelles qui conserve de tr\u00e8s beaux ensembles architecturaux de diff\u00e9rentes p\u00e9riodes qui permettent d\u2019aborder le d\u00e9veloppement de la ville sous un autre angle et de mettre en lumi\u00e8re les grandes tendances de l\u2019architecture bruxelloise, du Moyen-\u00c2ge \u00e0 nos jours.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560403"},"sp":{"name":"Le quartier des quais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-deta