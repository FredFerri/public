third":true,"is_fourth":true,"is_last":true},"time_start":"14:00:00","time_end":"15:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier samedis du mois de 14:00 \u00e0 15:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zaterdags van de maand van 14:00 tot 15:00","en":"Open the first, second, third, fourth and last saturdays of the month from 14:00 to 15:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[16,5,19,11,7,8,12,10],"translations":{"fr":["Ecoles","Enfants 9-12 ans","Enseignants","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","LGTBQIA","Seniors"],"nl":["Scholen","Kinderen 9-12 j.","Leerkrachten","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","LGTBQIA","Senioren"],"en":["Schools","Children 9-12 yr.","Teachers","Family","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors"]}},"tags":["kids"],"accessibilities":{"list":[252,255,261,263,266],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-25T01:09:00+02:00","published_at":"2022-02-17T16:16:24+01:00","backoffice_id":247788,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.13992727562026},{"id":518572,"date_start":"2021-10-02","date_end":"2022-12-03","date_next":"2022-10-01","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal","shortdescr":"Le caf\u00e9 de sp\u00e9cialit\u00e9 est en plein d\u00e9veloppement \u00e0 Bruxelles, avec l'\u00e9mergence de nouveaux caf\u00e9s et d'initiatives comme la Brussels Coffee Week, mais aussi gr\u00e2ce \u00e0 l\u2019impl\u00e9mentation de grains de qualit\u00e9 dans de plus en plus de lieux HoReCa, \u00e9piceries etc.","longdescr":"LES COFFEE TOURS\r\nLe caf\u00e9 de sp\u00e9cialit\u00e9 est en plein d\u00e9veloppement \u00e0 Bruxelles, avec l'\u00e9mergence de nouveaux caf\u00e9s et d'initiatives comme la Brussels Coffee Week, mais aussi gr\u00e2ce \u00e0 l\u2019impl\u00e9mentation de grains de qualit\u00e9 dans de plus en plus de lieux HoReCa, \u00e9piceries etc. Le caf\u00e9 de sp\u00e9cialit\u00e9 reste malgr\u00e9 tout encore bien trop m\u00e9connu, il est temps d'explorer ce que la capitale de l'Europe a \u00e0 offrir. Ces explorations caf\u00e9\u00efn\u00e9es de la ville sont aussi inhabituelles, amusantes qu\u2019instructives et correspondent \u00e0 un cours de base complet sur le caf\u00e9, le fun et la marche en plus.\r\n\r\nPOUR QUI\r\nLes Brussels Coffee Tours s'adressent \u00e0 tout le monde, avec un focus sur l\u2019exp\u00e9rience consommateur\/coffee lovers d\u00e9sireu.x.ses de mieux comprendre leur boisson favorite. Il convient \u00e9galement aux professionnel.le.s de l\u2019HoReCa qui encore souvent ignorent ce qu\u2019est le caf\u00e9 de sp\u00e9cialit\u00e9, les aidant ainsi \u00e0 comprendre le parent pauvre de leur secteur mais aussi \u00e0 mieux appr\u00e9hender l\u2019exp\u00e9rience client li\u00e9e au caf\u00e9. Je suis l\u00e0 pour aider et esp\u00e8re combler le foss\u00e9 entre les amateurs et les professionnels. Aucun pr\u00e9requis n'est n\u00e9cessaire \u00e0 ce tour. Les buveuses et buveurs de th\u00e9 appr\u00e9cient grandement ce tour, m\u00eame quand ils pensent ne pas aimer le caf\u00e9 ;)\r\n\r\nOBJECTIF\r\nLe but des Brussels Coffee Tours est de faire d\u00e9couvrir les lieux innovants lorsqu\u2019il est question de caf\u00e9 de sp\u00e9cialit\u00e9, mais aussi de d\u00e9couvrir et comprendre comment consommer \/ go\u00fbter le caf\u00e9 sur base de crit\u00e8res de qualit\u00e9 objectifs. Comprendre la cha\u00eene de production du champ \u00e0 la tasse, la diff\u00e9rence entre caf\u00e9 de sp\u00e9cialit\u00e9 et caf\u00e9 de commodit\u00e9 et apprendre \u00e0 mieux acheter son caf\u00e9 sont \u00e9galement au c\u0153ur des objectifs des Coffee Tours.\r\n\r\nDISCOVER & TASTE, UN TOUR P\u00c9DAGOGIQUE ! - EDITION DOWNTOWN KANAAL\r\nLors des Brussels Coffee Tours - Discover and Taste - , nous d\u00e9ambulons dans diff\u00e9rents quartiers de Bruxelles, en fonction de l\u2019\u00e9dition, car voyager autour du caf\u00e9 de sp\u00e9cialit\u00e9 est toujours une excellente id\u00e9e pour d\u00e9couvrir les tendances locales. Nous stimulerons vos papilles en go\u00fbtant un espresso, une boisson lact\u00e9e, mais aussi des m\u00e9thodes filtre et parfois m\u00eame des infusions \u00e0 froid, azot\u00e9es ou non, le tout \u00e0 mes frais. Vous ne payez pas d'extra pour vos boissons.\r\n\r\nLors de cette \u00e9dition DOWNTOWN KANAAL, nous visitons 4 \u00e0 5 lieux dans les magnifiques quartiers Monnaie\/Dansaert, avec mini d\u00e9gustation de diff\u00e9rentes fermentations \u00e0 la clef. Nous vous sensibiliserons aux m\u00e9tiers du caf\u00e9 et aborderons diff\u00e9rents sujets tels que : les diff\u00e9rences de philosophies et les nouvelles vagues, les m\u00e9thodes de pr\u00e9paration, les habitudes de consommation, le m\u00e9tier de barista, la science derri\u00e8re le lait, le sucre, le go\u00fbt, la qualit\u00e9, le caf\u00e9 de sp\u00e9cialit\u00e9, les labels, les styles de torr\u00e9faction, les recettes etc\u2026 mais aussi les informations \u00e0 d\u00e9crypter sur les sachets de caf\u00e9 afin de mieux acheter et d\u00e9jouer le marketing global.\r\n\r\nGOOD TO KNOW\r\nLes tours se passent toujours en ext\u00e9rieur. Nous marchons d'un endroit \u00e0 l'autre et jetons un \u0153il aux lieux, mais les groupes \u00e9tant grands par rapport \u00e0 la capacit\u00e9 des lieux, nous ne consommons pas assis \u00e0 l\u2019int\u00e9rieur. Il est pr\u00e9f\u00e9rable de se munir de chaussures confortables, de v\u00eatements CHAUDS en hiver (mieux vaut trop de couches que pas assez !!) et un parapluie en cas de pluie. De l\u2019eau est toujours recommand\u00e9e \u00e9galement. Masque et gel en temps de Covid. \r\n\r\nPetit d\u00e9jeunez avant la visite car nous n'avons pas le temps de manger lors des tours. Pssst, rejoins-nous : INSTA @ok_coffee_tips\r\n\r\nVOTRE GUIDE\r\nThomas Wyngaard est fondateur de OK Coffee et un des rares experts en Caf\u00e9 de Sp\u00e9cialit\u00e9 en Belgique francophone. Il est consultant ind\u00e9pendant, enseignant (certifi\u00e9 par la Specialty Coffee Association de janvier 2018 \u00e0 avril 2021), tour-ist et broadcaster. Apr\u00e8s avoir \u00e9t\u00e9 form\u00e9 en France, en Pologne et en Estonie, il fait ses armes chez les meilleurs en Belgique, pour ensuite migrer pendant presque 2 ans \u00e0 New York o\u00f9 il a offici\u00e9 comme conseiller et formateur. Au-del\u00e0 de la formation sur les m\u00e9tiers du caf\u00e9, il collabore avec des torr\u00e9facteurs belges engag\u00e9s sur la reconnaissance du caf\u00e9 de sp\u00e9cialit\u00e9, \u0153uvrant ainsi \u00e0 un monde meilleur \u201cone bean at a time\u201d.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.518572"},"nl":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.518572"},"en":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal","shortdescr":"Be ready to discover and taste the new waves of coffee during this 4 hours tour in the Downtown Kanaal Brussels area. Hosted in FR & EN.","longdescr":"THE COFFEE TOURS\r\nSpecialty coffee is booming in Brussels, with the emergence of new coffee shops and initiatives like the Brussels Coffee Week, but also thanks to the implementation of quality beans in more and more HoReCa places, grocery stores etc. However, specialty coffee is still far too unknown. Now is the time to explore what the capital city of Europe has to offer. These caffeinated explorations of the city, and also the methods of preparation are unusual, fun as they are highly informative, and match a complete coffee basics course, with an extra sprinkle of fun and walking.\r\n\r\nFOR WHO\r\nThe Brussels Coffee Tours are for everyone, with a focus on the consumer\/coffee lover experience to better understand your favorite beverage! It is also suitable for HoReCa professionals who are often still unaware of what specialty coffee is, helping them to understand the poor relation of their sector but also to better understand the customer experience related to coffee. I'm here to help and hope to bridge the gap between the amateurs and the professionals. No prerequisites are necessary for this tour. Tea drinkers greatly appreciate this tour, even when they think they don't like coffee ;)\r\n\r\nOBJECTIVE\r\nThe goal of the Brussels Coffee Tours is to discover innovative places when it comes to specialty coffee, but also to discover and understand how to consume\/taste coffee based on objective quality criteria. Understanding the production chain from field to cup, the difference between specialty and commodity coffee, and learning how to better buy coffee are also central to the objectives of the Coffee Tours.\r\n\r\nDISCOVER & TASTE, AN EDUCATIONAL TOUR! - DOWNTOWN KANAAL EDITION\r\nDuring the Brussels Coffee Tours - Discover and Taste - , we wander through different areas of Brussels, depending on the edition, because traveling around specialty coffee is always a great idea to discover local trends. We will stimulate your taste buds by tasting espresso, milk drink, but also filter methods and sometimes even cold brew, nitrogen infused or not, all at my expense. You don't pay any extra for your drinks. During this DOWNTOWN KANAAL edition, we visit 4 to 5 places in the beautiful Monnaie\/Dansaert area, including a mini tasting of different fermentation processes of coffee beans. We will make you aware of the different coffee professions and discuss various topics such as: the differences in philosophies and the new waves, preparation methods, consumption habits, the barista's job, the science behind milk, sugar, taste, quality, specialty coffee, labels, roasting styles, recipes etc... but also the information to decipher on the coffee bags in order to buy better and thwart global marketing.\r\n\r\nGOOD TO KNOW\r\nThe tours always take place outdoors. We walk from one place to another and have a look at the places, but the groups being large compared to the capacity of the places, we do not consume sitting inside. It is best to bring comfortable shoes, WARM clothes in winter (better too many layers than not enough!!) and an umbrella in case of rain. Water is always recommended as well. Mask and gel in Covid times.\r\n\r\nHave breakfast beforehand because we don't have time to eat during the tours. Pssst, join us: INSTA @ok_coffee_tips\r\n\r\nYOUR HOST \r\nThomas Wyngaard is the founder of OK Coffee and one of the few Specialty Coffee experts in French-speaking Belgium. He is an independent consultant, teacher (certified by the Specialty Coffee Association from January 2018 to April 2021), tour-ist and broadcaster. After training in France, Poland and Estonia, he worked with the best in Belgium, and then migrated for almost 2 years to New York where he served as a consultant and trainer. In addition to training in the coffee business, he collaborates with Belgian roasters committed to the recognition of specialty coffee, working towards a better world \"one bean at a time\".","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.518572"},"de":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal, Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.518572"},"it":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal, Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.518572"},"sp":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal, Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.518572"},"pt":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal, Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"pho