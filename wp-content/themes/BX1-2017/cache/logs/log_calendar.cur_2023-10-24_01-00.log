l,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fantastic-museum.be","email":"infomafcaf@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003502"},"it":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fantastic-museum.be","email":"infomafcaf@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003502"},"cn":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fantastic-museum.be","email":"infomafcaf@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003502"},"fr":{"name":"Halloween Tram","shortdescr":"L\u2019Halloween Tram est un voyage magique et f\u00e9\u00e9rique au pays des fant\u00f4mes et monstres bizarres qui se d\u00e9roule au sein d\u2019un ancien tramway red\u00e9cor\u00e9 pour l\u2019occasion.","longdescr":"L\u2019Halloween Tram est un voyage magique et f\u00e9\u00e9rique au pays des fant\u00f4mes et monstres bizarres qui se d\u00e9roule au sein d\u2019un ancien tramway red\u00e9cor\u00e9 pour l\u2019occasion. Durant le voyage vous pourrez profiter d\u2019une animation sp\u00e9cifiquement con\u00e7ue pour l\u2019occasion. La formule comprend :\n\n    Le voyage en Tram ( 30 minutes )\n    1 ap\u00e9ritif (avec ou sans alcool)\n    1 soupe au potiron\n\nR\u00e9servation obligatoire ici : https:\/\/www.billetweb.fr\/halloween-tram2\n\nATTENTION ! Il est imp\u00e9ratif de se rendre au minimum 30 minutes avant l\u2019embarquement au Centre d\u2019Art Fantastique (18 rue de la glaci\u00e8re \u2013 1060 \u2013 Bruxelles). Un bracelet d\u2019acc\u00e8s \u00e0 l\u2019Halloween Tram vous sera donn\u00e9 en \u00e9change de votre voucher. L\u2019accueil s\u2019effectuera selon les normes sanitaires en vigueur. Prix unique par participant les billets ne sont ni \u00e9changeables ni rembours\u00e9s.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fantastic-museum.be","email":"infomafcaf@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003502"},"sp":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fantastic-museum.be","email":"infomafcaf@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003502"},"nl":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fantastic-museum.be","email":"infomafcaf@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003502"}},"place":{"id":50000468,"translations":{"de":{"name":"CAF - Centre d'Art Fantastique","address_street_name":null,"address_street_number":"18","address_street_box":null,"email":"infomafcaf@gmail.com","website":"www.fantastic-museum.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"CAF - Centre d'Art Fantastique","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CAF - Centre d'Art Fantastique","address_street_name":null,"address_street_number":"18","address_street_box":null,"email":"infomafcaf@gmail.com","website":"www.fantastic-museum.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"CAF - Centre d'Art Fantastique","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CA