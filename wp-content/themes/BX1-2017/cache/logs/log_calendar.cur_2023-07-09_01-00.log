sone con difficolt\u00e0 di comprensione","Accessibile","Disposizioni per persone non vedenti e ipovedenti","Cane guida","Parcheggio accessibile","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n","Habilitado","Equipos para personas con problemas de visi\u00f3n y audici\u00f3n","Perros gu\u00eda","Estacionamiento habilitado","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null,null,null,null,null],"cn":[null,null,null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-12T02:36:35+02:00","published_at":"2021-09-17T10:30:45+02:00","backoffice_id":239320,"import_origin":null,"sub_type":"brocante","show_in_agenda":true,"ranking":0.22222222222222},{"id":555518,"date_start":"2023-05-14","date_end":"2023-12-10","date_next":"2023-07-09","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","shortdescr":"D\u00e9couvrez en famille l\u2019exposition Diane von Furstenberg. Woman Before Fashion.","longdescr":"D\u00e9couvrez en famille l\u2019exposition Diane von Furstenberg. Woman Before Fashion.\r\nPendant que notre guide vous emm\u00e8ne sur les traces de cette cr\u00e9atrice bruxelloise hors du commun, les enfants r\u00e9v\u00e8lent leurs talents en suivant l\u2019atelier anim\u00e9 par un v\u00e9ritable cr\u00e9ateur de mode.\r\n- A 14h : Visite guid\u00e9e et atelier gratuits\r\n- Dur\u00e9e : 1h\r\n- Entr\u00e9e payante pour les adultes. Pour les enfants, l\u2019entr\u00e9e est gratuite jusqu\u2019\u00e0 18 ans. Les places \u00e9tant limit\u00e9es, les r\u00e9servations pour la visite guid\u00e9e et l\u2019atelier sont obligatoires via notre site web. \r\n- L\u2019entr\u00e9e est comprise dans le ticket de l\u2019atelier ou de la visite guid\u00e9e.\r\n- L\u2019\u00e9quipe du mus\u00e9e encadre les enfants lors de l\u2019atelier mais ils restent sous la responsabilit\u00e9 de leurs parents.","performers":"D\u00e9couvrez en famille l\u2019exposition Diane von Furstenberg. Woman Before Fashion.\r\nPendant que notre guide vous emm\u00e8ne sur les traces de cette cr\u00e9atrice bruxelloise hors du commun, les enfants r\u00e9v\u00e8lent leurs talents en suivant l\u2019atelier anim\u00e9 par un v\u00e9ritable cr\u00e9ateur de mode.","boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555518"},"nl":{"name":"Family Sunday: Diane von Furstenberg. Woman Before Fashion","shortdescr":"Ontdek met uw gezin de tentoonstelling Diane von Furstenberg. Woman Before Fashion.","longdescr":"Ontdek met uw gezin de tentoonstelling Diane von Furstenberg. Woman Before Fashion.\r\nTerwijl onze gids u meeneemt in de voetsporen van deze buitengewone Brusselse ontwerpster, ontdekken de kinderen hun talenten in een creatieve workshop.\r\n- Om 15u30: gratis rondleiding en workshop\r\n- Duur: 1u\r\n- Toegangsprijs voor volwassenen. Voor kinderen tot 18 jaar is de toegang gratis\r\n- De plaatsen voor de rondleiding en de workshop zijn beperkt, dus daarvoor reserveren is verplicht via onze website. De toegang tot het museum is inbegrepen in dit ticket.\r\n- Het museumteam houdt toezicht op de kinderen tijdens de workshop, maar zij blijven onder de verantwoordelijkheid van hun ouders.","performers":"Ontdek met uw gezin de tentoonstelling Diane von Furstenberg. Woman Before Fashion.\r\nTerwijl onze gids u meeneemt in de voetsporen van deze buitengewone Brusselse ontwerpster, ontdekken de kinderen hun talenten in een creatieve workshop.","boxoffice_url":null,"website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555518"},"en":{"name":"Family Sunday: Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fashionandlacemuseum.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555518"},"de":{"name":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555518"},"it":{"name":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555518"},"sp":{"name":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555518"},"pt":{"name":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555518"},"cn":{"name":"Family Sunday : Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555518"}},"place":{"id":1515,"translations":{"fr":{"name":"Mus\u00e9e Mode & Dentelle","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Le Mus\u00e9e Mode & Dentelle pr\u00e9sente ses collections \u00e0 travers de grandes expositions annuelles. Elles abordent tant la cr\u00e9ation que la production et l\u2019usage social du v\u00eatement.\r\nCes expositions vous transportent dans des univers aussi vari\u00e9s que captivants. De l\u2019in\u00e9dit avec Masculinities ou Back Side, de l\u2019historique avec le glamour des ann\u00e9es 30 ou les audacieuses seventies ou encore des expositions consacr\u00e9es \u00e0 des cr\u00e9ateurs de chez nous comme Carine Gilson ou Jean-Paul Lespagnard.\r\n\r\nEn parall\u00e8le \u00e0 ces grandes expositions, le mus\u00e9e propose \u00e9galement :\r\n\r\n- La Fashion Room, cet espace in\u00e9dit en Belgique vous permet de comprendre comment un mus\u00e9e enrichit ses collections. D\u00e9couvrez y des pi\u00e8ces exceptionnelles, hors vitrine, afin d\u2019\u00eatre au plus proche de celles-ci.\r\n\r\n- La Chambre des Dentelles pr\u00e9sente de remarquables pi\u00e8ces illustrant la finesse, la qualit\u00e9 et la beaut\u00e9 de la dentelle de Bruxelles. Explorez l\u2019histoire de cette \u00e9toffe pris\u00e9e des \u00e9lites d\u00e8s le 17e si\u00e8cle et aujourd\u2019hui disparue.\r\n\r\nAbrit\u00e9 au c\u0153ur de Bruxelles, dans un ensemble de maisons historiques, le Mus\u00e9e Mode & Dentelle conserve quelque 15.000 pi\u00e8ces datant du 16e si\u00e8cle \u00e0 nos jours. Il poss\u00e8de les plus importantes collections au monde en ce qui concerne la cr\u00e9ation et la confection bruxelloises, qu\u2019il vise \u00e0 replacer dans un contexte belge et international.\r\nSes collections sont les t\u00e9moins de l\u2019\u00e9volution de la mode mais aussi d\u2019une \u00e9poque, de notre culture, de notre soci\u00e9t\u00e9.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Mode en Kant Museum","address_street_name":"Violetstraat","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussel","address_line1":"Violetstraat, 12","address_line2":"1000 Brussel","description_web":"Het Mode & Kant Museum presenteert zijn collecties tijdens grote jaarlijkse tentoonstellingen. Daarin komen het ontwerp, de productie en de sociale dimensie van kleding aan bod.\r\nDeze tentoonstellingen nemen je telkens mee naar een wereld die even gevarieerd als boeiend is. Je maakt er kennis met het ongeziene in Masculinities en Back Side, of met de historische glamour uit de jaren dertig. Ook de gedurfde jaren zeventig en tentoonstellingen gewijd aan onze eigen ontwerpers, zoals Carine Gilson of Jean-Paul Lespagnard, stonden ooit op het programma.\r\n\r\nNaast deze grote tentoonstellingen laat het museum je ook graag kennismaken met:\r\n- De Fashion Room, een baanbrekend concept in Belgi\u00eb, dat je toont hoe een museum zijn collecties verrijkt. We hebben enkele uitzonderlijke stukken opgesteld buiten de vitrine, zodat je ze in detail kunt bekijken.\r\n\r\n- De Kantkamer, waar opmerkelijke stukken opgesteld staan die de verfijning, de kwaliteit en de schoonheid van het Brusselse kantwerk illustreren. Kom de geschiedenis van deze stof ontdekken, die vanaf de 17e eeuw erg door de elite werd gewaardeerd, maar die nu verdwenen is.\r\nIn hartje  Brussel, in een groep historische huizen, bewaart het Mode & Kant Museum ongeveer 15.000 voorwerpen die dateren van de 16e eeuw tot vandaag. Het bezit de belangrijkste collecties ter wereld rond de Brusselse ontwerpen en kleding, die het in een Belgische en internationale context wil plaatsen.\r\nDe collecties leggen getuigenis af over de evolutie van de mode, maar ook over een tijdperk, onze cultuur en onze maatschappij.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of Fashion & Lace","address_street_name":"rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussels","address_line1":"rue de la Violette, 12","address_line2":"1000 Brussels","description_web":"The Fashion & Lace Museum displays its collections by means of major annual exhibitions. These address both the design and the production and social use of the garments.\r\nThe exhibitions transport you to diverse and captivating worlds. From items never before exhibited, such as in Masculinities or Back Side, through historical themes, such as the glamour of the 1930s or the bold \u201870s, to exhibitions devoted to Belgian designers such as Carine Gilson and Jean-Paul Lespagnard.\r\n\r\nParallel to these major exhibitions, the museum also offers:\r\n\r\n- The Fashion Room, an unparalleled space in Belgium, provides you with the opportunity to understand how a museum builds its collections. Discover exceptional items, not hidden behind glass, in order to see them up close.\r\n\r\n- The Lace Room displays remarkable pieces that illustrate the finesse, high quality and beauty of Brussels lace. Explore the history of this type of fabric, so valued by the elites in the 17th century yet no longer in vogue today.\r\n\r\nHoused in a series of historic houses at the heart of Brussels, the Fashion & Lace Museum holds some 15,000 pieces from the 16th century to the present. The Museum has the most important collections in the world when it comes to Brussels design and production, which it seeks to position in a Belgian and international context.\r\nIts collections attest to the changes in fashion as well as to a specific era of our culture and our society.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Mode et Dentelle - Mode- und Spitzenmuseum (Museen der Stadt Br\u00fcssel)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Das im Jahr 1977 er\u00f6ffnete Mode- und Spitzenmuseum (Mus\u00e9e Mode et Dentelle) hat in Br\u00fcssel eine echte Daseinsberechtigung, denn die Geschichte der Stadt, ja des Landes ist im wahrsten Sinne des Wortes eng mit der Textilkunst verwoben.\r\n\r\nBr\u00fcssel weist ein reiches Erbe auf, was feine Stoffe und Textilwaren angeht. Die Tradition der Textilindustrie, die bis ins 12. Jahrhundert zur\u00fcckreicht und sich bis heute im Bereich Modedesign und Textilhandel zeigt, ist fest in der Br\u00fcsseler Kultur verankert.\r\n\r\nEinen faszinierenden Einblick in diesen Bereich geben die reichen Sammlungen des Mode- und Spitzenmuseums mit alten, aber auch modernen Spitzengeweben, Stickereien, Kost\u00fcmen und extravaganten Accessoires, die im Rahmen regelm\u00e4\u00dfig wechselnder Ausstellungen gezeigt werden.\r\n\r\nParallel zu den gro\u00dfen thematischen Ausstellungen bietet das Mode- und Spitzenmuseum der zeitgen\u00f6ssischen Textilkreation eine besondere Plattform: Seit 2004 empf\u00e4ngt das Museum wechselnde Ausstellungen, die sowohl die Arbeiten von Studierenden im Bereich Textilkunst als auch die Werke bereits etablierter Textilk\u00fcnstler zeigen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo del Traje y Encaje (Museos de la Ciudad de Bruselas)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"El Museo del Traje y el Encaje destaca por su perspectiva din\u00e1mica e innovadora centrada en la moda contempor\u00e1nea. Ideal para ver prendas excepcionales de moda belga y bruselense en exposiciones temporales, como la de Jean-Paul Lespagnard. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"],"de":["Historisches Stadtzentrum"],"it":["Centro storico"],"sp":["Centro hist\u00f3rico"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":197,"location":{"lat":50.84577733,"lon":4.35198995},"region":"brussels","last_updated_at":"2023-06-12T02:36:10+02:00","published_at":"2013-10-19T01:13:21+02:00","import_origin":null,"external_id":null,"is_