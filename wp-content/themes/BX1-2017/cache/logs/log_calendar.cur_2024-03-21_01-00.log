:null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006773"},"pt":{"name":"Jaime CALDER\u00d3N - La Maison Usher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006773"},"en":{"name":"Jaime CALDER\u00d3N - La Maison Usher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006773"},"it":{"name":"Jaime CALDER\u00d3N - La Maison Usher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006773"},"cn":{"name":"Jaime CALDER\u00d3N - La Maison Usher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006773"},"fr":{"name":"Jaime CALDER\u00d3N - La Maison Usher","shortdescr":"Exposition d'originaux du nouvel album de Jaime Calder\u00f3n et Jean Dufaux : La Maison Usher aux \u00e9ditions Delcourt.","longdescr":"Pour sa prochaine exposition \u00e0 la Galerie Passerelle Louise du 8 au 23 mars 2024, Cr\u00e9abulles a l\u2019immense plaisir et est fi\u00e8re de vous annoncer qu\u2019elle pr\u00e9sentera le travail d\u2019illustration de Jaime CALDER\u00d3N sur l\u2019album LA MAISON USHER, \u00e9crit par Jean DUFAUX d'apr\u00e8s la nouvelle fantastique d'Edgar Allan Poe et publi\u00e9 chez Delcourt. Outre ses planches, couvertures et story-boards, l\u2019auteur exposera \u00e9galement plusieurs illustrations.\n\nParticiperont \u00e9galement \u00e0 l\u2019exposition Jorge Calder\u00f3n, le fr\u00e8re de Jaime Calder\u00f3n bien connu sur le march\u00e9 des collectionneurs et professeur de dessin \u00e0 l\u2019\u00e9cole FemArt de Barcelone, qui pr\u00e9sentera divers dessins N&B de super-h\u00e9ros et d\u2019actrices de cin\u00e9ma ainsi qu\u2019Ester Punzano, la compagne de Jaime Calder\u00f3n, professeure de peinture \u00e0 l\u2019\u00e9cole FemArt de Barcelone, qui exposera plusieurs peintures \u00e0 l\u2019huile sur des dessins de Jaime Calder\u00f3n.\n\nVernissage le 7 mars en pr\u00e9sence de l\u2019auteur et de Jean Dufaux et s\u00e9ances de d\u00e9dicaces en nombre limit\u00e9 les 8 et 9 mars, priorit\u00e9 \u00e9tant \u00e9videmment donn\u00e9e aux acqu\u00e9reurs d\u2019un de ses originaux. Et cerise sur le g\u00e2teau, Jos\u00e9 HOMS nous fait l\u2019immense plaisir et honneur de se joindre \u00e0 ces deux s\u00e9ances de d\u00e9dicaces pour le dernier album de sa s\u00e9rie \u00e0 succ\u00e8s, Shi, qui compte \u00e0 ce jour six tomes parus chez Dargaud et plus tard durant l\u2019expo, Cr\u00e9abulles attend d\u2019autres auteurs qui viendront \u00e9galement d\u00e9dicacer leur nouveaut\u00e9.\n\nToutes les pi\u00e8ces expos\u00e9es seront visibles sur le site de Cr\u00e9abulles \u00e0 partir du 8 mars sur une page d\u00e9di\u00e9e. Plus d\u2019infos \u00e0 : info@creabulles.be","performers":"ASBL Cr\u00e9abulles; Jaime Calder\u00f3n; Ester Punzano & Jorge Calder\u00f3n","boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006773"},"sp":{"name":"Jaime CALDER\u00d3N - La Maison Usher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006773"},"nl":{"name":"Jaime CALDER\u00d3N - La Maison Usher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.creabulles.be","email":"info@creabulles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006773"}},"place":{"id":260162,"translations":{"de":{"name":"Galerie Passerelle Louise","address_street_name":"Rue Dejoncker","address_street_number":"34","address_street_box":null,"email":null,"website":"https:\/\/www.passerelle-louise.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Dejoncker, 34","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Galerie Passerelle Louise","address_street_name":"Rue Dejoncker","address_street_number":"34","address_street_box":null,"email":null,"website":"https:\/\/www.passerelle-louise.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Dejoncker, 34","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Galerie Passerelle Louise","address_street_name":"Rue Dejoncker","address_street_number":"34","address_street_box":null,"email":null,"website":"https:\/\/www.passerelle-louise.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Dejoncker, 34","address_line2":"1060 Saint-Gilles","description_web":null,"descript