Seniors"}},"value":4},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"},"de":{"name":"Studierende"},"it":{"name":"Studenti"},"sp":{"name":"Estudiantes"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":4}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-04-27","start":"18:00:00","timestamp":"2023-04-27T18:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-07T16:36:12+02:00","published_at":"2023-03-21T10:48:50+01:00","backoffice_id":273802,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.30285343213869},{"id":555087,"date_start":"2023-04-20","date_end":"2023-06-03","date_next":"2023-04-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"],"it":["Gallerie d'arte","Multidisciplinare"],"sp":["Galer\u00edas de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Mise en Abyme","shortdescr":"Premiere exposition solo de l'artiste Br\u00e9silien en Belgique.","longdescr":"Nous sommes heureux d'annoncer la premi\u00e8re exposition personnelle de Marcelo Moscheta avec la galerie, dans notre espace au Sablon pendant ArtBrussels, intitul\u00e9e \"Mise en Abyme\".\r\n\r\nMarcelo Moscheta challenge notre perception et questionne notre rapport \u00e0 la nature \u00e0 travers diff\u00e9rents m\u00e9diums tels que l\u2019installation, la sculpture, le dessin et le collage. Ancr\u00e9 dans une d\u00e9marche conceptuelle, l\u2019artiste s\u2019inspire de lieux recul\u00e9s qu\u2019il arpente et aborde la question du d\u00e9placement, du territoire et de la m\u00e9moire. Il collecte des \u00e9l\u00e9ments et des images sur place et se r\u00e9-approprie cette mati\u00e8re par le dessin et la cr\u00e9ation d'installations. \r\n\r\n\u2018Mise en abyme\u2019 fait \u00e9cho au proc\u00e9d\u00e9 de la Renaissance visant \u00e0 repr\u00e9senter une oeuvre dans l\u2019oeuvre, ainsi Marcelo Moscheta joue avec les codes de la repr\u00e9sentation en nous proposant une oeuvre totale qui se d\u00e9cline sur plusieurs dimensions. Miroir d\u2019une r\u00e9alit\u00e9 sur l\u2019environnement qui nous entoure, l\u2019artiste \u00e0 la mani\u00e8re d\u2019un arch\u00e9ologue nous am\u00e8ne \u00e0 repenser aux paysages, familiers ou non, et aux souvenirs qui persistent. \r\n\r\nOn retrouve dans l\u2019exposition la s\u00e9rie de collages \u2018Teach us to sit still\u2019 o\u00f9 il r\u00e9-utilise des anciennes cartes postales qui viennent cristalliser la m\u00e9moire d\u2019un lieu et d\u2019une \u00e9poque. Ou encore une s\u00e9rie singuli\u00e8re de dessins \u2018Bianco Puro\u2019 fait au graphite sur pvc noir qui r\u00e9fl\u00e9chissent la lumi\u00e8re et joue avec le concept de mise en abyme. Ici la mati\u00e8re devient miroir et le dessin, selon l\u2019angle de vue, appara\u00eet et se r\u00e9invente sous nos yeux. On ne cesse de se questionner sur le processus de cr\u00e9ation autant que sur le territoire, \u00e0 la fois familier et lointain, cr\u00e9\u00e9 par Marcelo Moscheta. L\u2019oeuvre \u2018Trauma\u2019 faite de pierres collect\u00e9es dans la vall\u00e9e de Trebbia, fait appel \u00e0 la re-signification des objets, ici la pierre \u00e9clat\u00e9e devient un souvenir qui mat\u00e9rialise les traces d\u2019un lourd pass\u00e9. C'est \u00e0 travers l'\u00e9vocation subtile du souvenir que l'artiste nous am\u00e8ne dans un autre espace-temps qui nous fait voyager dans les m\u00e9moires des lieux et des images, o\u00f9 l'homme joue le r\u00f4le d'acteur.\r\n\r\nMoscheta fait parti des collections priv\u00e9es et publiques tels que:  The Clinic | USA, Jameel Art Center | Dubai, El Museo Del Barrio | New York, Deutsche Bank | New York, Lhoist Collection | Brussels, Mus\u00e9e D\u2019art Moderne Et D\u2019art Contemporaine | Li\u00e9ge, Kunstpatrimonium \u2013 Patrimoine Artistique \u2013 Art Collection | Brussels...","performers":"Marcelo Moscheta (Bresil, 1976)","boxoffice_url":null,"website":"https:\/\/gallerynosco.com","email":"contact@gallerynosco.com","phone_contact":"+32 2 511 24 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555087"},"nl":{"name":"Mise en Abyme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/gallerynosco.com","email":"contact@gallerynosco.com","phone_contact":"+32 2 511 24 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555087"},"en":{"name":"Mise en Abyme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/gallerynosco.com","email":"contact@gallerynosco.com","phone_contact":"+32 2 511 24 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555087"},"de":{"name":"Mise en Abyme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/gallerynosco.com","email":"contact@gallerynosco.com","phone_contact":"+32 2 511 24 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555087"},"it":{"name":"Mise en Abyme","shortdescr":nu