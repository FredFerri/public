ions":{}},"tags":[],"opening":{"day":"2023-09-05","end":"21:00:00","start":"19:00:00","timestamp":"2023-09-05T19:00:00"}},{"id":560256,"date_start":"2023-08-10","date_end":"2023-09-22","date_next":"2023-09-04","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T02:00:54+02:00","published_at":"2023-06-22T17:06:22+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":280256,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"expo","ranking":0.35688292775180414,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[43,36],"translations":{"de":["Dekorative K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Decorative art","Museums and art centers"],"it":["Arti decorative","Musei e centri artistici"],"cn":[null,null],"fr":["Arts D\u00e9coratifs","Mus\u00e9es et art centers"],"sp":["Artes decorativas","Museos y centros de arte"],"nl":["Decoratieve kunsten","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Art Nouveau in Japan \u2013 A Return to the Source of Inspiration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560256"},"pt":{"name":"Art Nouveau in Japan \u2013 A Return to the Source of Inspiration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560256"},"en":{"name":"Art Nouveau in Japan \u2013 A Return to the Source of Inspiration","shortdescr":null,"longdescr":"Art Nouveau\u2019s style and ideology were developed as an answer to the need for a new approach to art and design at the end of the nineteenth century. At the backbone of this development was Japanese art (and Japonisme), which provided a major inspiration to the art and design world of the time. However, the popularity and global development of the movement in its turn provided a new impetus to its land of origin. In Japan, Art Nouveau encouraged artists to transcend art and design genres, and to re-evaluate traditional crafts and designs, activities that can be said to be the starting point of modern Japanese craft design.\r\n\r\nThis exhibition introduces the influence and development of Art Nouveau in Japan. It will feature graphic works of artists that were considered central figures linked to the art movement in Japan, and kimono, a medium in which Art Nouveau played an important role.\r\n\r\nThis exhibition is exhibited in two venues: part 1 (chapter 1, 2 and 3) at Les Halles Saint-G\u00e9ry, and part 2 (chapter 4) at the Japan Information and Cultural Centre (JICC) of the Embassy of Japan in Brussels  (Rue Van Maerlant 1, 1000 Bruxelles).\r\n\r\nVernissage: 10\/08\/2023, 18:00~\r\n\r\nOpening hours:\r\nHalles Saint-G\u00e9ry: 7\/7 10:00-18:00\r\nJICC of the Embassy of Japan in Brussels: Monday - Friday. 9:30-17:00","performers":"Curation & Stenography: edited by Saskia Thoelen\r\nSupported by the Embassy of Japan in Brussels.\r\n","boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560256"},"it":{"name":"Art Nouveau in Japan \u2013 A Return to the Source of Inspiration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560256"},"cn":{"name":"Art Nouveau in Japan \u2013 A Return to the Source of Inspiration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560256"},"fr":{"name":"Art Nouveau in Japan \u2013 A Return to the Source of Inspiration","shortdescr":null,"longdescr":"Le style et l'id\u00e9ologie de l'Art nouveau ont \u00e9t\u00e9 d\u00e9velopp\u00e9s en r\u00e9ponse au besoin d'une nouvelle approche de l'art et du design \u00e0 la fin du XIXe si\u00e8cle. A la base de ce d\u00e9veloppement se trouve l'art japonais (et le Japonisme), qui a fourni une inspiration majeure au monde de l'art et du design de l'\u00e9poque. Cependant, la popularit\u00e9 et le d\u00e9veloppement mondial du mouvement donn\u00e8rent \u00e0 leur tour un nouvel \u00e9lan \u00e0 sa terre d'origine. Au Japon, l'Art nouveau a encourag\u00e9 les artistes \u00e0 transcender les genres de l'art et du design et \u00e0 r\u00e9\u00e9valuer l'artisanat et le design traditionnels, activit\u00e9s qui peuvent \u00eatre consid\u00e9r\u00e9es comme le point de d\u00e9part de l'artisanat japonais moderne.\r\n\r\nCette exposition pr\u00e9sente l'influence et le d\u00e9veloppement de l'Art nouveau au Japon.\r\n\r\nElle propose des \u0153uvres graphiques d'artistes consid\u00e9r\u00e9s comme des figures centrales li\u00e9es au mouvement artistique au Japon, et met en exergue le kimono, un m\u00e9dium dans lequel l'Art nouveau a jou\u00e9 un r\u00f4le important.\r\n\r\nCette exposition est pr\u00e9sent\u00e9e dans deux lieux : la partie 1 (chapitre 1, 2 et 3) aux Halles Saint-G\u00e9ry, et la partie 2 (chapitre 4) au Japan Information and Cultural Center (JICC) de l'Ambassade du Japon \u00e0 Bruxelles (Rue Van Maerlant 1, 1000 Bruxelles).\r\n\r\nVernissage: 10\/08\/2023, 18:00~\r\n\r\nHeures d'ouverture:\r\nHalles Saint-G\u00e9ry: 7\/7 10:00-18:00\r\nJICC of the Embassy of Japan in Brussels: Lundi - Vendredi. 9:30-17:00","performers":"Curation & Stenography: edited by Saskia Thoelen\r\nAvec le soutien de l'Ambassade du Japon \u00e0 Bruxelles.","boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560256"},"sp":{"name":"Art Nouveau in Japan \u2013 A Return to the Source of Inspiration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560256"},"nl":{"name":"Art Nouveau in Japan \u2013 A Return to the Source of Inspiration","shortdescr":null,"longdescr":"De stijl en ideologie van Art nouveau werden ontwikkeld aan het eind van de negentiende eeuw als een antwoord op de nood naar een nieuwe aanpak voor kunst en design. De Japanse kunst (en de Japonisme beweging), die een grote invloed hadden op de toenmalige kunst- en designwereld, lagen aan de basis van deze ontwikkeling. Echter, de populariteit en de globale ontwikkeling van de Art nouveau beweging gaf op zich een nieuwe inspiratie aan zijn land van oorsprong. Art nouveau moedigde kunstenaars in Japan aan om kunst- en designgenres te overstijgen en traditionele ambachten en ontwerpen opnieuw te evalueren, activiteiten waarvan kan worden gezegd dat ze het startpunt zijn van modern Japans ambachtelijk ontwerp.\r\n\r\nDeze tentoonstelling introduceert de invloed en ontwikkelingen van de Art nouveau beweging in Japan. Verschillende grafische werken van kunstenaars en designers, erkend als centrale figuren binnen de beweging in Japan, alsook kimono, een medium waarin Art nouveau een belangrijke rol speelde, zullen worden tentoongesteld.\r\n\r\nDe tentoonstelling is verdeeld over 2 ruimten: deel 1 (hoofdstuk 1, 2 and 3) in de Sint Gorikshallen, en deel 2 (hoofdstuk 4) in the Japan Information and Cultural Centre (JICC) van de Japanse Ambassade te Brussel (Van Maerlantstraat 1, 1000 Brussel)\r\n\r\nVernissage: 10\/08\/2023, 18:00~\r\n\r\nOpening huren:\r\nSt. Gorikshallen: 7\/7 10:00-18:00\r\nJICC Japanse Ambassade: Maandag - Vrijdag 9:30-17:00","performers":"Curation& Stenography: edited by Saskia Thoelen\r\nMet de steun van de Japanse Ambassade te Brussel.","boxoffice_url":null,"website":"https:\/\/www.be.emb-japan.go.jp\/itpr_en\/culture_event_jicc.html","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560256"}},"place":{"id":247371,"translations":{"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi...\r\nLe Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi. Sotto il patrocinio della regione di Bruxelles Capitale.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Remarquable t\u00e9moin de l\u2019architecture des march\u00e9s couverts, les Halles Saint-G\u00e9ry  contribuent \u00e0 valoriser le patrimoine de la R\u00e9gion de Bruxelles-Capitale. Centre d\u2019exposition et de manifestation bas\u00e9 en plein coeur du pentagone, elles ont pour vocation de mettre en valeur les traits de d\u00e9marcation du cadre de vie bruxellois et de son identit\u00e9 urbaine par le biais d'une programmation hybride, allant des expositions, aux conf\u00e9rences, concerts, rencontres et performances \u2026\r\nLe Centre Urbain (guichet d\u2019information r\u00e9gional, pour mieux vous conseiller sur l\u2019habitat durable en R\u00e9gion de Bruxelles-Capitale) est \u00e9galement situ\u00e9 au sein des Halles.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Verdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio...\r\nVerdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio y al marco de vida de los bruselenses.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Sint-Gorikshallen","address_street_name":"Sint-Goriksplein","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Sint-Goriksplein","address_line2":"1000 Bruxelles","description_web":"De Sint-Gorikshallen zijn een prachtig architecturaal staaltje van openbare markthallen in het 19de-eeuwse Brussel. Het gebouw werd een aantal jaren geleden volledig gerestaureerd en doet tegenwoordig dienst als permanente informatie-, tentoonstellings- en evenementenruimte gewijd aan het erfgoed en de levenswijzen in de hoofdstad. Op amper twee minuten stappen van de Beurs vormen de Sint-Gorikshallen een gezellige plek om te ontspannen en nieuwe dingen te ontdekken, zowel overdag als bij het vallen van de nacht.\r\nDe hallen herbergen ook de Stadswinkel, een vereniging die de inwoners van het Brussels Hoofdstedelijk Gewest  wil informeren over het leefmilieu en een kwaliteitsvolle leefomgeving, huisvesting, stadsrenovatie, stedenbouw en ruimtelijke ordening, en rationeel energiegebruik. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":9562,"location":{"lat":50.84801328,"lon":4.34683241},"region":"brussels","last_updated_at":"2022-12-19T14:03:38+01:00","published_at":"2013-10-19T01:26:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"orga