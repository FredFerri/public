[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"tags":["kids"],"accessibilities":{"list":[252,255,256,259,261,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-11T01:07:17+02:00","published_at":"2021-09-17T10:30:45+02:00","backoffice_id":239320,"import_origin":null,"sub_type":"brocante","show_in_agenda":true,"ranking":0.1762973200084},{"id":530544,"date_start":"2022-04-14","date_end":"2022-08-20","date_next":"2022-08-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"30 import chrono !","shortdescr":null,"longdescr":"60 minutes,\r\n30 impros,\r\nUn challenge!\r\nCette ann\u00e9e, Vertig\u00d4 revient au Trac avec \u00ab 30 impros chrono \u00bb. Un spectacle freeform o\u00f9 l\u2019impr\u00e9vu est total.\r\nNous ne savons pas ce que nous allons jouer ni combien de temps durera chaque sc\u00e8ne:\r\n3 secondes? 2 minutes ? 20?\r\nLa seule chose que nous savons, c\u2019est qu\u2019\u00e0 la fin du chrono, nous devrons avoir atteint le chiffre exact de 30 improvisations. Pas plus, pas moins.\r\nLibert\u00e9, parole, sentiments, absurde, po\u00e9sie, mouvement, c\u2019est tout le cocktail Vertig\u00d4 qui explose sur sc\u00e8ne \u00e0 travers ce spectacle rythm\u00e9, inspir\u00e9 du concept libre \u00ab 30 \u00bb cr\u00e9\u00e9 par Hugh Tebby.","performers":"LA Troupe du Vertigo","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530544.html"},"nl":{"name":"30 import chrono !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530544.html"},"en":{"name":"30 import chrono !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530544.html"},"de":{"name":"30 import chrono !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530544.html"},"it":{"name":"30 import chrono !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530544.html"},"sp":{"name":"30 import chrono !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contac