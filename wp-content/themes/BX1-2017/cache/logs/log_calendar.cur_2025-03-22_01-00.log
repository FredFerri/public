backoffice_id":239320,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"brocante","ranking":0.4054801330382267,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":71,"translations":{"de":"M\u00e4rkte & Flohm\u00e4rkte","pt":null,"en":"Markets and bric-a-brac stores","it":"Mercati e antiquariato","cn":null,"fr":"March\u00e9s & brocantes","sp":"Mercados y mercadillos","nl":"Markten & brocante"}},"others":{}},"translations":{"de":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Brusselsmakersmarket","email":"brusselsmakersmarket@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.519320"},"pt":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Brusselsmakersmarket","email":"brusselsmakersmarket@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.519320"},"en":{"name":"Brussels Makers Market","shortdescr":"Artisan market of creations and original products of all kinds made by Belgian manufacturers. Special editions at Christmas","longdescr":"The Brussels Makers Market brings together artists, creatives, DIY enthusiasts, etc., in the same space.\r\n\r\nIn this market you will find creations and products from Belgian manufacturers, both professionals and amateurs.\r\n\r\nA selection will be made according to 4 criteria:\r\n- Local or fair trade artisanal production\r\n- Durability\r\n- Originality\r\n- The presence of the creator.\r\n\r\nJewelry, clothing, candles, leather goods, lighting, ceramics, macrame, illustrations, decoration, cosmetics, and many others ...","performers":"Jewelry, clothing, candles, leather goods, lighting, ceramics, macrame, illustrations, decoration, cosmetics, and many others ...","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Brusselsmakersmarket\/","email":"brusselsmakersmarket@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.519320"},"it":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Brusselsmakersmarket","email":"brusselsmakersmarket@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.519320"},"cn":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Brusselsmakersmarket","email":"brusselsmakersmarket@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.519320"},"fr":{"name":"Brussels Makers Market","shortdescr":"March\u00e9 artisanal de cr\u00e9ations et produits originaux de toutes sortes r\u00e9alis\u00e9s par des fabricants belges. Edition sp\u00e9ciale \u00e0 No\u00ebl","longdescr":"Le Brussels Makers Market r\u00e9uni artistes, cr\u00e9atifs, bricoleurs,...,  au sein d\u2019un m\u00eame espace.\r\n\r\nDans ce march\u00e9 vous trouverez des cr\u00e9ations et produits de fabricants belges, aussi bien professionnels qu\u2019amateurs. \r\n\r\nUne s\u00e9lection sera faite en fonction de 4 crit\u00e8res:\r\n- Une fabrication artisanale locale ou \u00e9quitable\r\n- La durabilit\u00e9 \r\n- L\u2019originalit\u00e9\r\n- La pr\u00e9sence du cr\u00e9ateur.\r\n\r\nBijoux, v\u00eatements, bougies, maroquinerie, luminaires, c\u00e9ramique, macram\u00e9s, illustrations, d\u00e9coration, cosm\u00e9tiques, et bien d'autres...","performers":"Bijoux, v\u00eatements, bougies, maroquinerie, luminaires, c\u00e9ramique, macram\u00e9s, illustrations, d\u00e9coration, cosm\u00e9tiques, et bien d'autres...","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Brusselsmakersmarket","email":"brusselsmakersmarket@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.519320"},"sp":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Brusselsmakersmarket","email":"brusselsmakersmarket@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.519320"},"nl":{"name":"Brussels Makers Market","shortdescr":"Ambachtelijke markt van creaties en originele producten van alle soorten gemaakt door Belgische fabrikanten.Speciale editie met Kerstmis","longdescr":"De Brussels Makers Market brengt kunstenaars, creatievelingen, doe-het-zelvers, enz. samen in dezelfde ruimte.\r\n\r\nIn deze markt vind je creaties en producten van Belgische fabrikanten, zowel professionals als amateurs.\r\n\r\nEr wordt een selectie gemaakt op basis van 4 criteria:\r\n- Lokale of fairtrade artisanale productie\r\n- Duurzaamheid\r\n- Originaliteit\r\n- De aanwezigheid van de maker.\r\n\r\nSieraden, kleding, kaarsen, lederwaren, verlichting, keramiek, macram\u00e9, illustraties, decoratie, cosmetica en vele andere ...","performers":"Sieraden, kleding, kaarsen, lederwaren, verlichting, keramiek, macram\u00e9, illustraties, decoratie, cosmetica en vele andere ...","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Brusselsmakersmarket","email":"brusselsmakersmarket@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.519320"}},"place":{"id":258279,"translations":{"de":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Picardstraat","address_line2":"1000 Brussels","description_web":"The Gare Maritime - From industrial freight station to energy neutral urban jungle!\r\n\r\nIt is the perfect setting for innovative cultural events, film or photo shoots, trade shows, fairs, product launches or promotions. \r\nThe historic station concourse that was part of the Gare Maritime has been transformed into an indoor city with its own food hall (coming September 2021), exclusive shops and offices. Countless unique and inspiring areas and warm, wooden structures alternate in this building complex. It is perfectly suited to accommodate both small and major events. The monumental nave is a true architectural eye-catcher, bathed in indirect sunlight and providing ample space for well-attended indoor activities.\r\nAny event in the Gare Maritime is a green event. Sustainability has been key during the renovation works. The building generates its own energy from renewable sources, using geothermics and solar panels. The green boulevards on either side of the nave are lined with themed gardens and tall trees, as if the adjacent park found its way inside. \r\nThe Gare Maritime is a unique place - attractive, innovative and ambitious.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"Der Gare Maritime: Vom ehemaligen G\u00fcterbahnhof zum energieneutralen Urban Jungle!\n\nDer Gare Maritime bietet die ideale Kulisse f\u00fcr Kulturveranstaltungen, Dreharbeiten und Fotosessions, M\u00e4rkte und Messen, Produkt-Launches und Promotion Events. Die Hallen des Gare Maritime wurden in eine Art Stadt in der Stadt umgewandelt, dazu z\u00e4hlen eine eigene Food Hall, exklusive Gesch\u00e4fte und B\u00fcros. Die R\u00e4umlichkeiten mit vielen Holzakzenten eignen sich sowohl f\u00fcr Treffen im kleinen Kreis als auch f\u00fcr gro\u00dfe Happenings. Die architektonisch spektakul\u00e4re zentrale Halle wird von indirektem Tageslicht durchflutet und bietet ausreichend Platz f\u00fcr gr\u00f6\u00dfere Veranstaltungen Innenbereich, wobei Nachhaltigkeit und Umweltfreundlichkeit stets im Vordergrund stehen, denn bei den Renovierungsarbeiten wurde ein besonderes Augenmerk auf diese beiden Kriterien gelegt. Anhand von Geothermie und Photovoltaikanlagen wird direkt vor Ort erneuerbare Energie Ort erzeugt. Entlang der gr\u00fcnen Promenaden, die das Mittelschiff s\u00e4umen, wurden Themeng\u00e4rten und B\u00e4ume gepflanzt, die einen flie\u00dfenden \u00dcbergang  zu dem nahegelegenen Park bilden. \nDer Gare Maritime \u00fcberzeugt als attraktive, innovative und ambitionierte Location.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat","address_line2":"1000 Brussel","description_web":"Gare Maritime: van industrieel goederenstation tot energieneutrale urban jungle!\r\n\r\nDe Gare Maritime is de perfecte setting voor innovatieve, culturele evenementen, film- en fotoshoots, markten, beurzen, lanceringen en promoties. De historische stationshallen van de Gare Maritime zijn omgevormd tot overdekte stad, met foodhall (vanaf september 2021), exclusieve winkels en kantoren. Het gebouwencomplex biedt een waaier aan unieke, inspirerende ruimtes afgewisseld met warme houten volumes: perfect voor de organisatie van kleine en grootschalige happenings. D\u00e9 architecturale eyecatcher is de monumentale middenbeuk die baadt in indirect daglicht en over meer dan voldoende ruimte beschikt voor overdekte activiteiten met veel bezoekers.\r\nEen event in de Gare Maritime is een groen event. Tijdens de renovatie van het gebouw was duurzaamheid een speerpunt. Energie wordt ter plaatse hernieuwbaar opgewekt met geothermie en zonnepanelen. De groene wandelboulevards aan weerszijden van de middenbeuk zijn voorzien van thematuinen en hoogstammige bomen, alsof het aangrenzende park het gebouw binnenstroomt. Gare Maritime is een unieke plek: aantrekkelijk, vernieuwend en ambitieus.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":18279,"location":{"lat":50.8642401,"lon":4.3434934},"region":"brussels","last_updated_at":"2024-07-30T15:05:56+02:00","published_at":"2014-05-14T12:03:05+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":277221,"translations":{"de":{"name":"Quezaco s