d":false,"is_third":false,"is_fourth":true,"is_last":false},"time_start":"14:00:00","time_end":"16:00:00","translations":{"fr":"Ouvert le quatri\u00e8me samedi du mois de 14:00 \u00e0 16:00","nl":"Open op de vierde zaterdag van de maand van 14:00 tot 16:00","en":"Open the fourth saturday of the month from 14:00 to 16:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-26T01:07:53+02:00","published_at":"2022-03-17T08:46:54+01:00","backoffice_id":249848,"import_origin":null,"sub_type":"brocante","show_in_agenda":true,"ranking":0.16797288504298},{"id":511490,"date_start":"2021-05-15","date_end":"2023-05-13","date_next":"2022-07-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[93],"translations":{"fr":["Ev\u00e9nement touristique"],"nl":["Toeristisch evenement"],"en":["Tourist event"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Jeu de Piste avec d\u00e9gustation bi\u00e8re!","shortdescr":"Un jeu de piste originale avec des challenges pour d\u00e9couvrir Bruxelles, ses petites rues, ses monuments incontournable et ... sa bi\u00e8re!","longdescr":"Jeu de piste: Les secrets du lambic\r\nSc\u00e9nario: \r\n\r\n19\u00e8me si\u00e8cle.\r\nGaston Delforge invite le grand scientifique Louis Pasteur pour lui faire part d\u2019une d\u00e9couverte majeure et encore secr\u00e8te sur les levures \u00e0 l\u2019\u0153uvre dans la fermentation du lambic, bi\u00e8re bruxelloise par excellence. \u00c0 son arriv\u00e9e, Louis Pasteur d\u00e9couvre un laboratoire vide et quitt\u00e9 \u00e0 la h\u00e2te. Inqui\u00e9tant ! Ne connaissant pas la ville, il sollicite votre aide afin de retrouver son ami disparu\u2026 et les indices de votre qu\u00eate seront \u00e0 trouver dans la d\u00e9gustation des bi\u00e8res qui jalonneront votre parcours. Livret en main, vous arpentez les rues historiques du centre de Bruxelles. Une mani\u00e8re insolite, ludique, et gourmande de (re)d\u00e9couvrir la capitale Belge, ses monuments incontournables, ses fresques urbaines, le tout au gr\u00e9 des bi\u00e8res.","performers":"Un animateur est pr\u00e9sent pour vous expliquer le jeu et r\u00e9compenser les gagnants du jour!","boxoffice_url":null,"website":"https:\/\/beermyguest.be\/shop\/jeu-de-piste\/","email":"magali@beermyguest.be","phone_contact":"+32 476 78 56 25","phone_booking":"+32 476 78 56 25","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/511490.html"},"nl":{"name":"Jeu de Piste avec d\u00e9gustation bi\u00e8re!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/511490.html"},"en":{"name":"Jeu de Piste avec d\u00e9gustation bi\u00e8re!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/511490.html"},"de":{"name":"Jeu de Piste avec d\u00e9gustation bi\u00e8re!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone