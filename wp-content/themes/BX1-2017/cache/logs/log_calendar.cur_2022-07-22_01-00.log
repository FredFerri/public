2024-01-06","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":35}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:05:57+02:00","published_at":"2021-04-22T12:53:46+02:00","backoffice_id":230880,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.2006711459696},{"id":529660,"date_start":"2022-03-17","date_end":"2022-11-19","date_next":"2022-07-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,37],"translations":{"fr":["Mus\u00e9es et art centers","Arts audiovisuels"],"nl":["Musea en kunstcentra","Audiovisuele kunst"],"en":["Museums and art centers","Audiovisual art"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Frida Kahlo : The Life of an Icon","shortdescr":"PLONGE DANS LA BIOGRAPHIE DE FRIDA KAHLO \u00a9\r\n\r\nL\u2019art digital et ses projections \u00e0 360\u00ba en 3D vous embarquent dans la vie de l\u2019artiste peintre mexicaine FRIDA KAHLO \u00a9. Une plong\u00e9e immersive et color\u00e9e utilisant les derni\u00e8res technologies afin de transformer votre visite en exp\u00e9rience unique.","longdescr":"PLONGE DANS LA BIOGRAPHIE DE FRIDA KAHLO \u00a9\r\n\r\nL\u2019art digital et ses projections \u00e0 360\u00ba en 3D vous embarquent dans la vie de l\u2019artiste peintre mexicaine FRIDA KAHLO \u00a9. Une plong\u00e9e immersive et color\u00e9e utilisant les derni\u00e8res technologies afin de transformer votre visite en exp\u00e9rience unique. Une toute nouvelle mani\u00e8re de se cultiver, d\u2019en apprendre plus sur la vie incroyable de l\u2019artiste.\r\n\r\nLa biographie immersive de FRIDA KAHLO \u00a9 \u00e0 Bruxelles est pr\u00e9sent\u00e9e sans reproductions de peintures de l'artiste avec l'intention de franchir une nouvelle \u00e9tape dans les nouveaux langages immersifs. La proposition innovante explore la biographie de l'artiste \u00e0 travers des collections de photographies historiques, de films originaux, d'environnements num\u00e9riques, d'installations artistiques, d'objets de collection et de musiques nouvellement cr\u00e9\u00e9es qui reproduisent les moments les plus pertinents de sa vie, invitant les visiteurs \u00e0 d\u00e9couvrir l'incroyable histoire qui a construit le mythe.","performers":"Une biographie immersive dans la vie de l'une des artistes les plus influentes au monde!","boxoffice_url":null,"website":"http:\/\/www.fridakahlobrussels.be","email":"info@exhibitionhub.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529660.html"},"nl":{"name":"Frida Kahlo : The Life of an Icon","shortdescr":"DOMPEL JE ONDER IN DE BIOGRAFIE VAN FRIDA KAHLO \u00a9\r\n\r\nDigitale technologie\u00ebn en driedimensionale 360\u00ba-projecties voeren je mee doorheen het leven van de Mexicaanse kunstenares Frida Kahlo \u00a9. De nieuwste technieken veranderen je bezoek in een kleurrijke en unieke ervaring.","longdescr":"DOMPEL JE ONDER IN DE BIOGRAFIE VAN FRIDA KAHLO \u00a9\r\n\r\nDigitale technologie\u00ebn en driedimensionale 360\u00ba-projecties voeren je mee doorheen het leven van de Mexicaanse kunstenares Frida Kahlo \u00a9. De nieuwste technieken veranderen je bezoek in een kleurrijke, immersieve en ronduit unieke ervaring. Ervaar een volledig nieuwe manier om je kennis te vergroten en het ongelooflijke verhaal van deze kunstenares te leren kennen.\r\n\r\nOp de immersieve biografie van FRIDA KAHLO \u00a9 in Brussel worden geen werken van de kunstenares getoond, om specifiek te focussen op wat met immersieve technieken kan worden verwezenlijkt. We brengen de volledige biografie van de kunstenares op een vernieuwende manier tot leven aan de hand van historische foto's, originele films, digitale omgevingen, kunstinstallaties, objecten uit diverse collecties en muziek geschreven als begeleiding bij sleutelgebeurtenissen uit Frida Kahlo's leven. Op die manier laten we bezoekers kennismaken met haar ongelooflijke levensverhaal.","performers":"De immersieve biografie van een van's werelds meest invloedrijke kunstenaars","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529660.html"},"en":{"name":"Frida Kahlo : The Life of an Icon","shortdescr":"DIVE INTO THE FRIDA KAHLO\u00a9'S BIOGRAPHY\r\n\r\nDigital art and its 360\u00ba 3D projections take you on a journey through the life of Mexican painter Frida Kahlo \u00a9. An immersive and colorful adventure, which uses the latest technologies to make your visit a truly unique experience.","longdescr":"DIVE INTO THE FRIDA KAHLO\u00a9'S BIOGRAPHY\r\n\r\nDigital art and its 360\u00ba 3D projections take you on a journey through the life of Mexican painter Frida Kahlo \u00a9. An immersive and colorful adventure, which uses the latest technologies to make your visit a truly unique experience. A whole new way to educate yourself and learn more about the artist's incredible life.\r\n\r\nThe immersive biography of FRIDA KAHLO\u00a9 in Brussels is presented without reproductions of the artist's paintings in an effort to push the limits of immersiveness. The innovative idea explores the artist's biography through collections of historical photographs, original films, digital environments, art installations, collectibles and newly created music that recreate the most significant moments of her life, inviting visitors to discover the incredible story behind the legendary artist.","performers":"An immersive biography of the life of one of the world's most influential artists","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529660.html"},"de":{"name":"Frida Kahlo : The Life of an Icon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529660.html"},"it":{"name":"Frida Kahlo : The Life of an Icon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529660.html"},"sp":{"name":"Frida Kahlo : The Life of an Icon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529660.html"},"pt":{"name":"Frida Kahlo : The Life of an Icon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529660.html"},"cn":{"name":"Frida Kahlo : The Life of an Icon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529660.html"}},"place":{"id":252589,"translations":{"fr":{"name":"Galerie Horta","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"116","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 116","address_line2":"1000 Bruxelles","description_web":