z d\u00e8s maintenant vos places pour un \u00e9v\u00e9nement incontournable !\n\nProgramme \nD.Shostakovich : Valse n\u00b02\nC.Chaminade : Concertino pour fl\u00fbte \nP.I.Tcha\u00efkovsky : Air de Lensky\nW.A.Mozart : Andante & Rondo\nC.Debussy : Claire de lune\nBizet-Sarasate : Fantaisie sur Carmen\nA.Piazzolla : Oblivion\nC.Saint-Sa\u00ebns : Introduction & Rondo Capriccioso","performers":"Ensemble Music\u00e2me France\n\nFl\u00fbtes Issam Garfi ; Violon-solo Hraschya Avanesyan, 2nd violon Nadim Garfi ; Alto Vincent Hepp ; Violoncelle Lionel Allemand","boxoffice_url":null,"website":"https:\/\/musicamefrance.com\/concert\/concert-a-bruxelles-shostakovich-bach-saint-saens-piazzolla-tchaikovsky\/","email":"musicame.france@gmail.com","phone_contact":"0749979708","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007148"},"sp":{"name":"Shostakovich, Bach, Saint-Sa\u00ebns, Piazzolla, Tcha\u00efkovsky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/musicamefrance.com\/concert\/concert-a-bruxelles-shostakovich-bach-saint-saens-piazzolla-tchaikovsky\/","email":"musicame.france@gmail.com","phone_contact":"0749979708","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007148"},"nl":{"name":"Shostakovich, Bach, Saint-Sa\u00ebns, Piazzolla, Tcha\u00efkovsky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/musicamefrance.com\/concert\/concert-a-bruxelles-shostakovich-bach-saint-saens-piazzolla-tchaikovsky\/","email":"musicame.france@gmail.com","phone_contact":"0749979708","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007148"}},"place":{"id":50003013,"translations":{"de":{"name":"Espace Lumen","address_street_name":"Chauss\u00e9e de Boondael","address_street_number":"36","address_street_box":null,"email":null,"website":null,"phone_co