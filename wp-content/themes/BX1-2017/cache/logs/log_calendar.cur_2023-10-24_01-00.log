ogique adapt\u00e9e \u00e0 chacun d'entre vous dans une ambiance cr\u00e9ative et conviviale, que vous soyez d\u00e9butants ou avanc\u00e9s, que vous soyez attir\u00e9s par la peinture figurative ou abstraite.\r\nAvec Ana Tzaneva\r\n\r\na partir de 16ans\r\n\r\nLocal Studio \r\n\r\nD\u00e9s le 18 septembre, les lundis de 19:00 \u00e0 22:00","performers":"Avec Ana Tzaneva","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/peinture-2023-2024-119\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559488"},"sp":{"name":"Peinture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/peinture-2023-2024-119\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559488"},"nl":{"name":"Peinture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/peinture-2023-2024-119\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559488"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours