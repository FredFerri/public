s with agility, sports and intellectual games\r\n\r\n- Open 7 days a week, flexible hours, competitive prices, close to public transport and free parking.\r\n\r\nYou will leave with your head in the stars.","performers":"The Team of Space Fun Games","boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungames.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 499 83 95 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535886"},"de":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungames.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 499 83 95 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535886"},"it":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungames.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 499 83 95 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535886"},"sp":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungames.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 499 83 95 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.535886"},"pt":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungames.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 499 83 95 30","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.535886"},"cn":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"web