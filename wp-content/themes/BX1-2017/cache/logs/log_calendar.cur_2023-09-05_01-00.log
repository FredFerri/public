tps:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553334"},"it":{"name":"Chasse au tr\u00e9sor - Que cache Bruce Helle ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com","email":"guillaume@quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":"+32 2 318 36 07","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.553334"},"cn":{"name":"Chasse au tr\u00e9sor - Que cache Bruce Helle ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com","email":"guillaume@quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":"+32 2 318 36 07","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.553334"},"fr":{"name":"Chasse au tr\u00e9sor - Que cache Bruce Helle ?","shortdescr":"Participez \u00e0 une activit\u00e9 du type chasse au tr\u00e9sor avec les jeux dynamiques et insolites \u00e0 Bruxelles de Quiveutpister! Menez l'enqu\u00eate, suivez la piste et tentez de faire la lumi\u00e8re sur cette affaire!","longdescr":"Avec Quiveutpister, d\u00e9couvrez des lieux connus et m\u00e9connus de Bruxelles en vous amusant. R\u00e9partis en plusieurs \u00e9quipes, retrouvez des indices, r\u00e9solvez une enqu\u00eate et parcourez un itin\u00e9raire. Des r\u00e9compenses viendront r\u00e9compenser les meilleures \u00e9quipes.\r\n\r\nSur le jeu Que cache Bruce Helle, vous devrez partir sur les traces d'un myst\u00e9rieux kidnappeur terrorisant la famille Leclerq. Le garde du corps Victor Lambert a \u00e9t\u00e9 appel\u00e9 pour la prot\u00e9ger. C\u2019est lors d\u2019une filature qu\u2019il va entendre parler d\u2019un projet secret impliquant cette famille\u2009: le projet Bruce Helle\u2026\r\n\r\nSaurez-vous d\u00e9couvrir ce qui se cache derri\u00e8re ce projet? Bonne chance!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com","email":"guillaume@quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":"+32 2 318 36 07","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553334"},"sp":{"name":"Chasse au tr\u00e9sor - Que cache Bruce Helle ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com","email":"guillaume@quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":"+32 2 318 36 07","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.553334"},"nl":{"name":"Chasse au tr\u00e9sor - Que cache Bruce Helle ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com","email":"guillaume@quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":"+32 2 318 36 07","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553334"}},"place":{"id":258844,"translations":{"de":{"name":"Quiveutpister","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"guillaume@quiveutpisterbruxelles.com","website":"https:\/\/www.quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quiveutpister","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Quiveutpister","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"guillaume@quiveutpisterbruxelles.com","website":"https:\/\/www.quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quiveutpister","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual