isive","Musei e centri artistici"],"cn":[null,null],"fr":["Arts audiovisuels","Mus\u00e9es et art centers"],"sp":["Artes audiovisuales","Museos y centros de arte"],"nl":["Audiovisuele kunst","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Belgian Hip-Hop Legacy : Expo \u2013 Listening App \u2013 DJ Sets \u2013 Talk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melodiggerz.be","email":"info@melodiggerz.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000841"},"pt":{"name":"Belgian Hip-Hop Legacy : Expo \u2013 Listening App \u2013 DJ Sets \u2013 Talk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melodiggerz.be","email":"info@melodiggerz.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000841"},"en":{"name":"Belgian Hip-Hop Legacy : Expo \u2013 Listening App \u2013 DJ Sets \u2013 Talk","shortdescr":"Dive into the memory of Belgian Hip-Hop with our carefully curated collection of 60 Belgian Hip-Hop vinyls and enjoy them using our exclusive listening app.","longdescr":"As part of the Belgian Hip-Hop Legacy exhibition, Melodiggerz invites you to discover 60 carefully selected Belgian Hip-Hop vinyl records.\n\nThese records, some famous and others more confidential, have marked the history of a culture that transcends borders and generations. From 1990 to 2020, they bear witness to the aspirations, struggles and creations of Belgian hip-hop artists.\n\nThe Melodiggerz app gives you an immersive experience!\n\nWith a simple scan on your phone, immerse yourself in the rhythms, rhymes and emotions of these iconic vinyl records.","performers":"Sonny Mariano, Belgian hip-hop collector and archivist","boxoffice_url":null,"website":"http:\/\/www.melodiggerz.be","email":"info@melodiggerz.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000841"},"it":{"name":"Belgian Hip-Hop Legacy : Expo \u2013 Listening App \u2013 DJ Sets \u2013 Talk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melodiggerz.be","email":"info@melodiggerz.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000841"},"cn":{"name":"Belgian Hip-Hop Legacy : Expo \u2013 Listening App \u2013 DJ Sets \u2013 Talk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melodiggerz.be","email":"info@melodiggerz.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000841"},"fr":{"name":"Belgian Hip-Hop Legacy : Expo \u2013 Listening App \u2013 DJ Sets \u2013 Talk","shortdescr":"Plongez dans la m\u00e9moire du Hip-Hop belge gr\u00e2ce notre collection soigneusement s\u00e9lectionn\u00e9e de 60 vinyles de hip-hop belge et profitez-en gr\u00e2ce \u00e0 notre application d'\u00e9coute exclusive !","longdescr":"Dans le cadre de l\u2019exposition Belgian Hip-Hop Legacy, Melodiggerz vous invite \u00e0 d\u00e9couvrir 60 vinyles Hip-Hop belge soigneusement s\u00e9lectionn\u00e9s.\n\nCes disques, certains c\u00e9l\u00e8bres et d\u2019autres plus confidentiels, ont marqu\u00e9 l\u2019histoire d\u2019une culture qui transcende les fronti\u00e8res et les g\u00e9n\u00e9rations. De 1990 \u00e0 2020, ils ont \u00e9t\u00e9 les t\u00e9moins privil\u00e9gi\u00e9s des aspirations, des luttes et des cr\u00e9ations des artistes hip-hop belges.\n\nL\u2019application Melodiggerz vous offre une exp\u00e9rience immersive !\n\nD\u2019un simple scan avec votre t\u00e9l\u00e9phone, plongez dans les rythmes, les rimes et les \u00e9motions de ces vinyles embl\u00e9matiques.","performers":"Sonny Mariano, collectionneur et archiviste Hip-Hop Belge","boxoffice_url":null,"website":"http:\/\/www.melodiggerz.be","email":"info@melodiggerz.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000841"},"sp":{"name":"Belgian Hip-Hop Legacy : Expo \u2013 Listening App \u2013 DJ Sets \u2013 Talk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melodiggerz.be","email":"info@melodiggerz.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000841"},"nl":{"name":"Belgian Hip-Hop Legacy : Expo \u2013 Listening App \u2013 DJ Sets \u2013 Talk","shortdescr":"Duik in de herinnering van Belgische hiphop met onze zorgvuldig samengestelde collectie van 60 Belgische hiphop-vinyls en geniet ervan met onze exclusieve luisterapp.","longdescr":"In het kader van de tentoonstelling Belgian Hip-Hop Legacy nodigt Melodiggerz u uit om 60 zorgvuldig geselecteerde Belgische Hip-Hop vinylplaten te ontdekken.\n\nDeze platen, sommige beroemd en andere meer vertrouwelijk, hebben de geschiedenis gemarkeerd van een cultuur die grenzen en generaties overstijgt. Van 1990 tot 2020 waren ze bevoorrechte getuigen van de aspiraties, strijd en creaties van Belgische hiphopartiesten.\n\nDe Melodiggerz app geeft u een meeslepende ervaring!\n\nMet een simpele scan op uw telefoon dompel u jezelf onder in de ritmes, rijms en emoties van deze iconische vinylplaten.","performers":"Sonny Mariano, Belgische Hip-Hop verzamelaar en archivaris","boxoffice_url":null,"website":"http:\/\/www.melodiggerz.be","email":"info@melodiggerz.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000841"}},"place":{"id":262208,"translations":{"de":{"name":"[PIAS] Belgium","address_street_name":"Rue Saint-Laurent","address_street_number":"36 38","address_street_box":null,"email":null,"website":null,"phone_contact":null,"