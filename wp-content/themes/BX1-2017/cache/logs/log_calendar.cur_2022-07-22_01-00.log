:538173,"date_start":"2022-07-08","date_end":"2022-09-12","date_next":"2022-07-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Mirage et Virage","shortdescr":"Durant tout l'\u00e9t\u00e9 la photographe Yseult D et l'auteur St\u00e9phane Maton-Vann vous pr\u00e9sentent le travail de trois jeunes artistes \u00e9mergents.\r\nUn dialogue tout en bleu !","longdescr":"Cet \u00e9t\u00e9, le Studio 84 Art & Culture[s] expose les cr\u00e9ations de trois jeunes artistes \u00e9mergents. Les couleurs et la lumi\u00e8re de la saison estivale seront \u00e0 l'honneur.\r\n\r\nAutour du th\u00e8me Mirage & Virage, Yseult D. et St\u00e9phane Maton-Vann ont choisi trois univers diff\u00e9rents et uniques : \r\nCha Ve ou l'art du pointillisme sous-marin sur le surf\r\nElise Hameau ou l'art de l'inspiration aborig\u00e8ne aux couleurs chatoyantes\r\nLukcash ou art morphique influenc\u00e9 par Miro et Matisse","performers":"Cha Ve\r\nElise Hameau\r\nLukcash\r\nYseult D\r\nSt\u00e9phane Maton-Vann","boxoffice_url":null,"website":"https:\/\/www.yseultd.com\/","email":"yseult2006@yahoo.fr","phone_contact":"+32 475 85 03 57","phone_booking":"+32 475 85 03 57","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538173.html"},"nl":{"name":"Mirage et virage","shortdescr":"De hele zomer stellen fotografe Yseult D en auteur St\u00e9phane Maton-Vann het werk voor van drie jonge opkomende kunstenaars.\r\nEen dialoog helemaal in het blauw!","longdescr":"Studio 84 Art & Culture[s] exposeert deze zomer de creaties van drie jonge, opkomende kunstenaars. De kleuren en het licht van het zomerseizoen zullen in de schijnwerpers staan.\r\n\r\nRond het thema Mirage & Virage hebben Yseult D. en St\u00e9phane Maton-Vann drie verschillende en unieke werelden gekozen: \r\nCha Ve of de kunst van het onderwater pointillisme in de branding\r\nElise Hameau of de kunst van aboriginal inspiratie met glinsterende kleuren\r\nLukcash of morfische kunst be\u00efnvloed door Miro en Matisse","performers":"Cha Ve\r\nElise Hameau\r\nLukcash\r\nYseult D\r\nSt\u00e9phane Maton-Vann","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538173.html"},"en":{"name":"Mirage et virage","shortdescr":"Throughout the summer, photographer Yseult D and author St\u00e9phane Maton-Vann present the work of three young emerging artists.\r\nA dialogue all in blue!","longdescr":"This summer, Studio 84 Art & Culture[s] is exhibiting the creations of three young artists in the making. The colors and the light of the summer season will be honored.\r\n\r\nAround the theme Mirage & Virage, Yseult D. and St\u00e9phane Maton-Vann have chosen three different and unique universes: \r\nCha Ve or the art of underwater pointillism on the surf\r\nElise Hameau or the art of aboriginal inspiration with shimmering colors\r\nLukcash or morphic art influenced by Miro and Matisse","performers":"Cha Ve\r\nElise Hameau\r\nLukcash\r\nYseult D\r\nSt\u00e9phane Maton-Vann","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538173.html"},"de":{"name":"Mirage et Virage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussel