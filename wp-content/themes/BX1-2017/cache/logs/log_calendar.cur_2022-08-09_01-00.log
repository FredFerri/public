"},{"day":"2022-08-23","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-08-24","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-08-25","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-08-26","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-08-27","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-08-30","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-08-31","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-09-01","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-09-02","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-09-03","doors":null,"start":"11:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi et dimanche: ferm\u00e9","mardi, mercredi, jeudi, vendredi et samedi: de 11:00 \u00e0 18:00"],"nl":["maandag en zondag: gesloten","dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 11:00 tot 18:00"],"en":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"]},"date_start":"2022-05-17","date_end":"2022-09-04","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-07T01:09:01+02:00","published_at":"2022-06-20T09:18:48+02:00","backoffice_id":256328,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.20807776469269},{"id":537125,"date_start":"2022-07-08","date_end":"2023-03-05","date_next":"2022-08-09","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,45],"translations":{"fr":["Mus\u00e9es et art centers","Mode"],"nl":["Musea en kunstcentra","Mode"],"en":["Museums and art centers","Fashion"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":"La mode pour enfants se porte mieux que jamais. Plus inclusive, plus \u00e9cologique, privil\u00e9giant le fait-main, chaque ann\u00e9e de nouveaux labels voient le jour. Mais habiller un enfant n\u2019est pas toujours facile ! \u00c0 travers un parcours \u00e0 la fois th\u00e9matique et chronologique, cette nouvelle exposition pose un regard sur la mode actuelle \u00e0 la lumi\u00e8re des tenues enfantines port\u00e9es depuis 1820.","longdescr":"La mode pour enfants se porte mieux que jamais. Plus inclusive, plus \u00e9cologique, privil\u00e9giant le fait-main, chaque ann\u00e9e de nouveaux labels voient le jour. Mais habiller un enfant n\u2019est pas toujours facile ! La mode reste avant tout un ph\u00e9nom\u00e8ne social et les enfants aussi attachent de l\u2019importance \u00e0 ce qu\u2019ils portent.\r\n \r\n\u00c0 travers un parcours \u00e0 la fois th\u00e9matique et chronologique, cette nouvelle exposition pose un regard sur la mode actuelle \u00e0 la lumi\u00e8re des tenues enfantines port\u00e9es depuis 1820.\r\n\r\nEn puisant dans ses collections r\u00e9cemment enrichies de pi\u00e8ces belges mais aussi gr\u00e2ce \u00e0 plusieurs pr\u00eats prestigieux, le mus\u00e9e questionne entre autres la construction des genres, le d\u00e9veloppement de la mode mixte ou unisexe, le mim\u00e9tisme avec la mode adulte mais \u00e9galement l\u2019int\u00e9r\u00eat grandissant de l\u2019industrie du luxe pour les kids. Plus qu\u2019une exposition de mode, Kidorama raconte la place de l\u2019enfant et le d\u00e9veloppement de sa personnalit\u00e9 au sein de notre soci\u00e9t\u00e9.\r\n\r\nUne exposition \u00e0 voir avec des yeux d\u2019enfants !\r\n\r\nL\u2019exposition s\u2019adresse bien entendu aux adultes mais \u00e9galement aux enfants, d\u00e9couvrez toutes les activit\u00e9s du mus\u00e9e sur notre site (parcours ludique, carnet de coloriage, atelier paper dolls ...)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 213 44 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537125"},"nl":{"name":"Kidorama, 200 jaar kindermode","shortdescr":"Kindermode doet het beter dan ooit. Meer en meer inclusief, ecologisch, met handgemaakte producten en elk jaar nieuwe merken. Maar kinderen kleden is niet altijd gemakkelijk!  Deze nieuwe tentoonstelling verkent thematisch en chronologisch de invloed van de kinderkleding sinds 1820 op onze hedendaagse kindermode.","longdescr":"Kindermode doet het beter dan ooit. Meer en meer inclusief, ecologisch, met handgemaakte producten en elk jaar nieuwe merken. Maar kinderen kleden is niet altijd gemakkelijk! Mode blijft een sociaal verschijnsel en ook kinderen hechten belang aan wat ze dragen.\r\n\r\nDeze nieuwe tentoonstelling verkent thematisch en chronologisch de invloed van de kinderkleding sinds 1820 op onze hedendaagse kindermode.\r\n\r\nKidoroma toont de evolutie van genderconstructies, de ontwikkeling van genderneutrale mode, de invloed van mode voor volwassenen en de groeiende belangstelling van de luxemerken voor kinderen. Het museum put daarvoor uit zijn rijke collecties, onlangs aangevuld met Belgische stukken, maar ook uit verschillende prestigieuze bruiklenen. Kidorama is meer dan een modetentoonstelling. Ze vertelt het verhaal van de plaats van het kind en de ontwikkeling van zijn persoonlijkheid binnen onze samenleving.\r\n\r\nEen tentoonstelling die het kind in ons weer tot leven brengt!\r\n\r\nDe tentoonstelling richt zich uiteraard zowel tot volwassenen als tot kinderen. Ontdek alle activiteiten van het museum  op onze website (speelse rondleiding, kleurboekje, workshops paper dolls ...)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/nl\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537125"},"en":{"name":"Kidorama, 200 year of children's fashion","shortdescr":"Children\u2019s fashion is healthier than ever. More inclusive, more environmentally friendly, with an emphasis on handmade items: new labels appear each year. But dressing a child is not always easy!  Through a trajectory that is both thematic and chronological, this new exhibition casts its eye on current fashion in the light of children\u2019s wear since 1820.","longdescr":"Children\u2019s fashion is healthier than ever. More inclusive, more environmentally friendly, with an emphasis on handmade items: new labels appear each year. But dressing a child is not always easy! Fashion is first and foremost a social phenomenon and children also care about what they wear.\r\n\r\nThrough a trajectory that is both thematic and chronological, this new exhibition casts its eye on current fashion in the light of children\u2019s wear since 1820.\r\n\r\nBy delving into its collections, recently enriched by Belgian items as well as several prestigious loans, the museum raises questions about issues such as construction of gender, the development of mixed or unisex fashion, imitation of adult fashion as well as the growing interest in the luxury industry for kids. More than just a fashion exhibition, Kidorama tells the story of the place of the child and the development of his\/her personality within our society.\r\n\r\nAn exhibition to enjoy through children\u2019s eyes!\r\n\r\nThe exhibition is of course aimed at adults but also at children, discover all the activities of the museum on our website (interactive modules, coloring book ...)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/en\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537125"},"de":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537125"},"it":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537125"},"sp":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537125"},"pt":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537125"},"cn":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537125"}},"place":{"id":278879