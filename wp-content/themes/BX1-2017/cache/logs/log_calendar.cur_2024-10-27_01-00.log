\/","email":"heloise.lauener@solarimpulse.com","phone_contact":"+41 79 501 50 84","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001110"},"it":{"name":"City of Tomorrow","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ville-de-demain.solarimpulse.com\/","email":"heloise.lauener@solarimpulse.com","phone_contact":"+41 79 501 50 84","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001110"},"cn":{"name":"City of Tomorrow","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ville-de-demain.solarimpulse.com\/","email":"heloise.lauener@solarimpulse.com","phone_contact":"+41 79 501 50 84","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001110"},"fr":{"name":"Ville de Demain","shortdescr":"L\u2019exposition \u00ab Ville de demain, une exploration en 1000+ Solutions \u00bb de la Fondation Solar Impulse, \u00e0 Tour & Taxis du 2 septembre 2024 au 10 janvier 2025, pr\u00e9sente des solutions innovantes pour la transition \u00e9cologique en milieu urbain. Elle propose des approches concr\u00e8tes en \u00e9nergie, eau, construction, habitat durable, mobilit\u00e9 et gestion des d\u00e9chets pour imaginer une ville durable.","longdescr":"Apr\u00e8s son succ\u00e8s l\u2019an dernier \u00e0 la Cit\u00e9 des Sciences et de l\u2019Industrie de Paris, l\u2019exposition \u00abVille de demain, une exploration en 1000+ Solutions\u00bb fait escale \u00e0 Tour & Taxis du 2 septembre 2024 au 10 janvier 2025. Con\u00e7ue par la Fondation Solar Impulse, cette exposition, centr\u00e9e sur les enjeux de la transition \u00e9cologique en milieu urbain, invite le public \u00e0 explorer les multiples approches novatrices que les technologies d\u2019aujourd\u2019hui proposent pour prot\u00e9ger l\u2019environnement tout en favorisant le d\u00e9veloppement \u00e9conomique. \u00c0 travers un parcours ludique, les visiteurs partent \u00e0 la d\u00e9couverte de propositions concr\u00e8tes et efficientes, d\u00e9velopp\u00e9es dans les domaines de l\u2019\u00e9nergie, de l\u2019eau, de la construction, de l\u2019habitat durable, de la mobilit\u00e9 ou encore de la gestion des d\u00e9chets. Ville de demain pr\u00e9sente l\u2019\u00e9ventail des possibles pour une ville durable, apportant sa pierre \u00e0 la construction d\u2019un futur d\u00e9sirable.","performers":"\n\n\n","boxoffice_url":null,"website":"https:\/\/ville-de-demain.solarimpulse.com\/","email":"heloise.lauener@solarimpulse.com","phone_contact":"+41 79 501 50 84","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001110"},"sp":{"name":"City of Tomorrow","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ville-de-demain.solarimpulse.com\/","email":"heloise.lauener@solarimpulse.com","phone_contact":"+41 79 501 50 84","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001110"},"nl":{"name":"Stad van Morgen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ville-de-demain.solarimpulse.com\/","email":"heloise.lauener@solarimpulse.com","phone_contact":"+41 79 501 50 84","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001110"}},"place":{"id":50001950,"translations":{"de":{"name":"Gare Maritime","address_street_name":"Picard","address_street_number":"7","address_street_box":null,"email":"info@designmarket.be","website":"https:\/\/designmarket.be\/uk\/","phone_contact":"+32 2 349 35 57","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Picard, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}