"2024-06-13","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-14","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-15","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-16","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-17","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-18","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-19","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-20","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-21","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-22","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-23","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-24","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-25","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-26","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-27","doors":null,"start":"00:01:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-28","doors":null,"start":"