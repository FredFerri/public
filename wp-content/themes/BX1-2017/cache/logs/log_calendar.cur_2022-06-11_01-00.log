,"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-06T01:07:41+02:00","published_at":"2021-04-12T11:38:28+02:00","backoffice_id":230572,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.12710335460633},{"id":530805,"date_start":"2022-06-12","date_end":"2022-11-13","date_next":"2022-06-12","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Quand le chemin de fer se fait promenade verte, entre Saint-Josse et Schaerbeek","shortdescr":"Au milieu du 19e si\u00e8cle, l\u2019est bruxellois accueille une nouvelle voie de chemin de fer, destin\u00e9e \u00e0 relier les gares du Nord et du Luxembourg.","longdescr":"Au milieu du 19e si\u00e8cle, l\u2019est bruxellois accueille une nouvelle voie de chemin de fer, destin\u00e9e \u00e0 relier les gares du Nord et du Luxembourg. Rapidement consid\u00e9r\u00e9e comme un obstacle \u00e0 la croissance des communes de Schaerbeek et de Saint-Josse-ten-Noode, alors en plein boom d\u00e9mographique, elle sera d\u00e9plac\u00e9e et enterr\u00e9e, au tournant du si\u00e8cle. La ligne marquera profond\u00e9ment ces communes en fa\u00e7onnant un paysage urbain particulier. \u00c0 travers plusieurs ensembles patrimoniaux remarquables, tels le quartier des Squares \u00e0 Bruxelles, le square Armand Steurs \u00e0 Saint-Josse ou l\u2019avenue Paul Deschanel \u00e0 Schaerbeek, l\u2019ARAU vous propose de partir sur les traces de cette voie ferr\u00e9e et de d\u00e9couvrir l\u2019influence qu\u2019elle a eu sur le d\u00e9veloppement de ces quartiers : le r\u00f4le de \u00ab fronti\u00e8re \u00bb qu\u2019elle a jou\u00e9 jadis est, par endroits, encore bien perceptible.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530805.html"},"nl":{"name":"Quand le chemin de fer se fait promenade verte, entre Saint-Josse et Schaerbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530805.html"},"en":{"name":"Quand le chemin de fer se fait promenade verte, entre Saint-Josse et Schaerbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530805.html"},"de":{"name":"Quand le chemin de fer se fait promenade verte, entre Saint-Josse et Schaerbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530805.html"},"it":{"name":"Quand le chemin de fer se fait promenade verte, entre Saint-Josse et Schaerbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530805.html"},"sp":{"name":"Quand le chemin de fer se fait promenade verte, entre Saint-Josse et Schaerbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/530805.htm