blished_at":"2021-08-24T09:12:39+02:00","backoffice_id":237605,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.066405354169464},{"id":541361,"date_start":"2022-09-17","date_end":"2022-09-17","date_next":"2022-09-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,11],"translations":{"fr":["Pop, rock, jazz\u2026","Hip hop, rnb, rap"],"nl":["Pop, rock, jazz\u2026","Hip hop, r&b, rap"],"en":["Pop, rock, jazz\u2026","Hip hop, rnb, rap"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Soir\u00e9e compos\u00e9e: Boa Joo x Beka","shortdescr":"Les talentueuses princesses du hip-hop bruxellois Boa Joo et Beka vous donnent rendez-vous pour un concert haut en couleurs!","longdescr":"BOA JOO\r\nAuteure, compositrice et interpr\u00e8te bruxelloise d\u2019origine Belgo-Rwandaise, Boa Joo tire son nom d\u2019une imp\u00e9ratrice amazone que l\u2019on retrouve dans la s\u00e9rie manga One Piece. Elle s\u2019impose sur la sc\u00e8ne hip hop avec un flow saccad\u00e9 doux-amer qui d\u00e9range, elle bouscule certains st\u00e9r\u00e9otypes sexistes et s\u2019affirme sans complexe avec un flow actuel. Que ce soit dans ses clips ou sur sc\u00e8ne, on la retrouve avec style et \u00e9l\u00e9gance mettant en avant un souci du d\u00e9tail esth\u00e9tique qui refl\u00e8te une atmosph\u00e8re lyrique \u00e0 la fois sombre et r\u00e9aliste.\r\n\r\nBEKA\r\nBeka, de son vrai nom Emmanuella Rebecca, est une artiste belge d\u2019origine congolaise. Elle d\u00e9bute sa carri\u00e8re avec plusieurs compositions personnelles dont le single \u201cBenda\u201d, qui atteindra plus d\u2019un million de vues sur YouTube et qui va la propulser sur le devant de la sc\u00e8ne musicale en 2022. L\u2019artiste ne se d\u00e9finit pas comme appartenant \u00e0 un seul style en particulier: elle se qualifie comme \u00ab multisysth\u00e8me \u00bb car elle allie plusieurs r\u00e9f\u00e9rences musicales et plusieurs genres diff\u00e9rents dans ses morceaux. La talentueuse chanteuse dispose d\u2019une technique vocale et d\u2019une pr\u00e9sence sc\u00e9nique qui lui permettent de chanter avec \u00e9motions des sujets de la vie quotidienne mais \u00e9galement de partager son propre v\u00e9cu. \u00c0 travers son histoire personnelle, Beka transmet au public les r\u00e9cits de vie du  milieu dans lequel elle a grandi.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541361"},"nl":{"name":"Soir\u00e9e compos\u00e9e: Boa Joo x Beka","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541361"},"en":{"name":"Soir\u00e9e compos\u00e9e: Boa Joo x Beka","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541361"},"de":{"name":"Soir\u00e9e compos\u00e9e: Boa Joo x Beka","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541361"},"it":{"name":"Soir\u00e9e compos\u00e9e: Boa Joo x Beka","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":n