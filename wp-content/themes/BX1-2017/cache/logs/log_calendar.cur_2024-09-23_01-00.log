erie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000877"},"fr":{"name":"Boire et manger","shortdescr":"\t\n\nBoire et manger sont des activit\u00e9s usuelles normales et quotidiennes. Cependant les innovations techniques introduites par la r\u00e9volution industrielle ont boulevers\u00e9 les m\u00e9thodes de production et de conservation, avec des cons\u00e9quences consid\u00e9rables sur nos habitudes alimentaires et culinaires.","longdescr":"La Fonderie vous invite \u00e0 la d\u00e9couverte des lieux de production alimentaire entre la place de la Duchesse (Molenbeek) et les abattoirs de Cureghem. Lors de votre balade, vous allez d\u00e9couvrir des raffineries de sucre, brasseries, entrep\u00f4ts frigorifiques, fabriques de bo\u00eetes de conserves \u2026 et d\u2019autres t\u00e9moins de l\u2019\u00e9mergence d\u2019une industrie agroalimentaire \u00e0 Bruxelles.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lafonderie.be\/2023\/03\/23\/boire-et-manger\/","email":"reservation@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000877"},"sp":{"name":"Boire et manger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lafonderie.be\/2023\/03\/23\/boire-et-manger\/","email":"reservation@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000877"},"nl":{"name":"Boire et manger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lafonderie.be\/2023\/03\/23\/boire-et-manger\/","email":"reservation@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000877"}},"place":{"id":214813,"translations":{"de":{"name":"La Fonderie - Br\u00fcsseler Museum f\u00fcr Industrie und Arbeit","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"La Fonderie bietet seit rund 30 Jahren Stadtf\u00fchrungen mit dem Schiff oder zu Fu\u00df. Das j\u00e4hrlich erneuerte und erweiterte Programm bietet eine gro\u00dfe Themenvielfalt, die zahlreiche Besucher anzieht. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Fonderie - Mus\u00e9e bruxellois des industries et du travail","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Fonderie - Brussels museum of work and industry","address_street_name":"Ransfortstraat 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Ransfortstraat 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":" La Fonderie's tour guides invite visitors to discover Brussels so they may better understand and analyse the city.\r\nThe urban guided tours with their varied themes address questions deeply rooted in the past but which relate to modern, everyday life such as: work, industrial techniques, urban growth, immigration, social welfare and housing. Some visits concentrate on a neighbourhood; others ask questions related to economic, political or social issues. More than twenty tours are available in several languages for a large and diverse public.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Fonderie","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Fonderie - Mus\u00e9e bruxellois des industries et du travail","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Fonderie - Mus\u00e9e bruxellois des industries et du travail","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"La Fonderie propose depuis pr\u00e8s de 30 ans des visites guid\u00e9es en ville. R\u00e9guli\u00e8rement mises \u00e0 jour, et compl\u00e9t\u00e9es chaque ann\u00e9e de nouveaux th\u00e8mes ou dispositifs, ces visites ont fait notre renomm\u00e9e et drainent chaque ann\u00e9e plusieurs milliers de visiteurs. \n\nAllant des enfants  jusqu\u2019aux groupes de seniors, le public vis\u00e9 par nos parcours est large. La plupart des visites sont disponibles \u00e0 la fois selon un calendrier fix\u00e9 pour les individuels et familles, et pour les groupes sur demande. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Fonderie - Museo de la Industria y del Trabajo de Bruselas","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Desde hace casi 30 a\u00f1os, la Fonderie ofrece visitas guiadas de la ciudad, tanto en barco como a pie. Estas visitas, que son famosas y atraen a varios miles de visitantes al a\u00f1o, se actualizan con regularidad y se completan todos los a\u00f1os con nuevos temas o dispositivos. El p\u00fablico objetivo de estas rutas es amplio: desde ni\u00f1os hasta grupos de adultos. La mayor\u00eda de las visitas est\u00e1n disponibles tanto para individuos y familias como para grupos que los soliciten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Fonderie - Brussels museum voor arbeid en industrie","address_street_name":"Ransfortstraat 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Ransfortstraat 27, 27","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Hebt u wat tijd om op ontdekkingstocht te gaan in Brussel? Zin om de hoofdstad op een originele manier te verkennen? Dan zijn onze rondleidingen beslist iets voor u!\r\nDeze stadsroutes met verschillende thema's behandelen kwesties die diep geworteld zitten in het verleden, maar waarvan het heden ons dagelijks interpelleert: wie arbeid of industrie zegt, spreekt meteen ook over stedelijke groei, immigratie, sociale hulp, woningen. Sommige bezoeken zijn geconcentreerd op een wijk, andere gaan over economische, politieke of sociale kwesties. Er zijn een twintigtal routes voor een gevarieerd publiek beschikbaar in meerdere talen. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[23],"translations":{"de":["Westen"],"pt":[null],"en":["West"],"it":["Ovest"],"cn":[null],"fr":["Ouest"],"sp":["Oeste"],"nl":["West"]}},"neca":null,"facebook_id":null,"backoffice_id":522,"location":{"lat":50.8524203,"lon":4.3358247},"region":"brussels","last_updated_at":"2024-08-29T16:41:59+02:00","published_at":"2013-10-19T01:13:36+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":214813,"translations":{"de":{"name":"La Fonderie - Br\u00fcsseler Museum f\u00fcr Industrie und Arbeit","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Mol