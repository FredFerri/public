l.5700003645"},"pt":{"name":"The Asmara-Addis Literary Festival (In Exile)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/asmaraaddisfestivalinexile.com\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003645"},"en":{"name":"The Asmara-Addis Literary Festival (In Exile)","shortdescr":"A vagabond, multilingual festival in the heart of Europe, rooted in pan-African and feminist values.","longdescr":"AALFIE, a literary festival in Brussels, aims to showcase the rich linguistic wealth and diversity of European artists with international backgrounds. The sixth edition of the festival hosts thirty speakers: poets, painters, musicians, dancers, performers, actors, and thinkers - extraordinary artists with backgrounds in over 30 countries and performing in many languages. The theme this year is 'The body's languages'.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/asmaraaddisfestivalinexile.com\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003645"},"it":{"name":"The Asmara-Addis Literary Festival (In Exile)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/asmaraaddisfestivalinexile.com\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003645"},"cn":{"name":"The Asmara-Addis Literary Festival (In Exile)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/asmaraaddisfestivalinexile.com\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003645"},"fr":{"name":"The Asmara-Addis Literary Festival (In Exile)","shortdescr":"Un festival vagabond et multilingue au coeur de l'Europe, ancr\u00e9 dans les valeurs panafricaines et f\u00e9ministes.","longdescr":"AALFIE, un festival litt\u00e9raire \u00e0 Bruxelles, vise \u00e0 mettre en valeur la richesse linguistique et la diversit\u00e9 des artistes europ\u00e9ens d'origine internationale. La sixi\u00e8me \u00e9dition du festival accueille trente intervenants : po\u00e8tes, peintres, musiciens, danseurs, performeurs, acteurs et penseurs - des artistes extraordinaires avec des racines dans plus de 30 pays parlant de nombreuses langues. Le th\u00e8me de cette ann\u00e9e est 'les langues du corps'.\u00a0","performers":null,"boxoffice_url":null,"website":"https:\/\/asmaraaddisfestivalinexile.com\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003645"},"sp":{"name":"The Asmara-Addis Literary Festival (In Exile)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/asmaraaddisfestivalinexile.com\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003645"},"nl":{"name":"The Asmara-Addis Literary Festival (In Exile)","shortdescr":"Een rondzwervend meertalig festival in het hart van Europa, geworteld in pan-Afrikaanse en feministische waarden.","longdescr":"AALFIE, een literair festival in Brussel, wil de taalrijkdom en diversiteit van Europese artiesten met een internationale achtergrond in de kijker zetten. De zesde editie van het festival verwelkomt dertig sprekers: dichters, schilders, muzikanten, dansers, performers, acteurs en denkers - bijzondere kunstenaars met achtergronden in meer dan 30 landen en optredens in vele talen. Het thema van dit jaar is 'de talen van het lichaam'.","performers":null,"boxoffice_url":null,"website":"https:\/\/asmaraaddisfestivalinexile.com\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/eve