nces"],"sp":["Campamentos vacacionales"],"nl":["Vakantiekampen"]}}},"translations":{"de":{"name":"stage d'automne : C'est du propre !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/cest-du-propre","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001478"},"pt":{"name":"stage d'automne : C'est du propre !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/cest-du-propre","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001478"},"en":{"name":"Stage d'automne : C'est du propre !","shortdescr":"Un stage pour d\u00e9couvrir les secrets de beaut\u00e9 de nos anc\u00eatres.","longdescr":"Le mus\u00e9e regorge d\u2019objets rigolos qui \u00e9taient utilis\u00e9s, autrefois, pour \u00eatre propre et se faire une petite beaut\u00e9\u2026 : une palette \u00e0 fard \u00e9gyptienne en forme de poisson, un robinet en bronze de l\u2019ancienne ville de Rome avec une t\u00eate qui semble cracher l\u2019eau, des strigiles de la Gr\u00e8ce antiques pour se racler la peau \u00e0 la mani\u00e8re d\u2019un gant de toilette, de petites bouteilles \u00e0 parfum du monde musulman ou des anciennes bouteilles d\u2019eau de Spa\u2026 A voir, sentir, essayer, \u00e9clabousser, dessiner\u2026 et en conna\u00eetre plus sur les petites habitudes de propret\u00e9 (ou non) dans l\u2019histoire et le monde.\n\n \n\nStage pour enfants du 1e au 6e primaire du lu 28.10 au je 31.10.24\n\nActivit\u00e9s de 9:30 \u00e0 16:30, garderie de 8:30 \u00e0 9:30 et de 16:30 \u00e0 17:30\n\n100 \u20ac - 80 \u20ac \u00e0pd 2i\u00e8me enfant (fr\u00e8res et s\u0153urs)\n\nN'oublie pas d'apporter un pique-nique, collation de 10:00 et ta gourde, nous nous chargeons du go\u00fbter et de l'eau.\n\nATTENTION : Il y aura 2 groupes : 1 en n\u00e9erlandais et 1 en fran\u00e7ais avec un maximum de 15 enfants par groupe. Si vous souhaitez inscrire vos enfants dans le groupe francophone, merci de le faire en suivant les pages en fran\u00e7ais. Si vous pr\u00e9f\u00e9rez les inscrire pour le groupe n\u00e9erlandophone, suivez les liens en N\u00e9erlandais, aussi dans le webshop. \n\nPlus d'infos ? Envoyez votre question \u00e0 public@kmkg-mrah.be ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/cest-du-propre","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001478"},"it":{"name":"stage d'automne : C'est du propre !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/cest-du-propre","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001478"},"cn":{"name":"stage d'automne : C'est du propre !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/cest-du-propre","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001478"},"fr":{"name":"Stage d'automne : C'est du propre !","shortdescr":"Un stage pour d\u00e9couvrir les secrets de beaut\u00e9 de nos anc\u00eatres.","longdescr":"Le mus\u00e9e regorge d\u2019objets rigolos qui \u00e9taient utilis\u00e9s, autrefois, pour \u00eatre propre et se faire une petite beaut\u00e9\u2026 : une palette \u00e0 fard \u00e9gyptienne en forme de poisson, un robinet en bronze de l\u2019ancienne ville de Rome avec une t\u00eate qui semble cracher l\u2019eau, des strigiles de la Gr\u00e8ce antiques pour se racler la peau \u00e0 la mani\u00e8re d\u2019un gant de toilette, de petites bouteilles \u00e0 parfum du monde musulman ou des anciennes bouteilles d\u2019eau de Spa\u2026 A voir, sentir, essayer, \u00e9clabousser, dessiner\u2026 et en conna\u00eetre plus sur les petites habitudes de propret\u00e9 (ou non) dans l\u2019histoire et le monde.\n\n \n\nStage pour enfants du 1e au 6e primaire du lu 28.10 au je 31.10.24\n\nActivit\u00e9s de 9:30 \u00e0 16:30, garderie de 8:30 \u00e0 9:30 et de 16:30 \u00e0 17:30\n\n100 \u20ac - 80 \u20ac \u00e0pd 2i\u00e8me enfant (fr\u00e8res et s\u0153urs)\n\nN'oublie pas d'apporter un pique-nique, collation de 10:00 et ta gourde, nous nous chargeons du go\u00fbter et de l'eau.\n\nATTENTION : Il y aura 2 groupes : 1 en n\u00e9erlandais et 1 en fran\u00e7ais avec un maximum de 15 enfants par groupe. Si vous souhaitez inscrire vos enfants dans le groupe francophone, merci de le faire en suivant les pages en fran\u00e7ais. Si vous pr\u00e9f\u00e9rez les inscrire pour le groupe n\u00e9erlandophone, suivez les liens en N\u00e9erlandais, aussi dans le webshop. \n\nPlus d'infos ? Envoyez votre question \u00e0 public@kmkg-mrah.be ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/cest-du-propre","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001478"},"sp":{"name":"stage d'automne : C'est du propre !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/cest-du-propre","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001478"},"nl":{"name":"Herfstatelier: 't Is proper!","shortdescr":"Deze herfstvakantie verdiepen we ons in de schoonheidsgeheimen van onze voorouders.","longdescr":"In de zalen van het Museum Kunst en Geschiedenis zijn heel wat voorwerpen te vinden die mensen gebruiken om zich mooi te maken. Wat dacht je van te gekke schminkpaletten uit het Oude Egypte in de vorm van vissen en andere dieren, een bronzen kraantje uit het Oude Rome waarbij het lijkt of een mannetje water spuwt, Oudgriekse strigilla die baders gebruikten om olie en vuil van hun vel te schrapen, elegante waterbekkens en parfumflesjes uit de islamitische wereld of souvenirs uit het kuuroord van Spa? Kijk, probeer, ruik, spetter, teken en kom meer te weten over frisse en onfrisse gewoontes van over de hele wereld.\n\nHerfstatelier voor kinderen van het 1e t.e.m. het 6e leerjaar van ma 28.10 t.e.m. do 31.10.24\n\nActiviteiten van 9:30 tot 16:30, opvang van 8:30 tot 9:30 en van 16:30 tot 17:30\n\n\u20ac 100 - \u20ac 80 vanaf het tweede kind (broers of zussen)\n\nBreng zeker een lunchpakket, 10-uurtje en drinkbus mee, wij voorzien elke dag een vieruurtje en voldoende water om te drinken\n\nOPGELET: We maken twee groepen: eentje in het Nederlands en \u00e9\u00e9n in het Frans, met maximum 15 kinderen per groep. Als je je kind graag in de Nederlandstalige groep wil, gelieve dan de pagina's in het Nederlands te volgen. Als je je kind liever in de Franstalige groep wil inschrijven, volg dan de Franstalige pagina's, ook in de webshop. \n\nMeer info? Stel je vraag via public@kmkg-mrah.be","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/nl\/activity\/t-proper","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001478"}},"place":{"id":61,"translations":{"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Brussels","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un fascinant voyage \u00e0 travers l'art et l'histoire. Venez fl\u00e2ner parmi les momies \u00e9gyptiennes et les silex pr\u00e9historiques, vous promener entre les verres anciens et prendre du recul pour mieux contempler d'impressionnantes tapisseries m\u00e9di\u00e9vales. Venez vous immerger dans le monde oriental en croisant des Bouddhas d'Asie et voyager jusqu'\u00e0 l'autre bout de la terre pour apercevoir une gigantesque statue de l'\u00eele de P\u00e2ques. La magnifique collection d'Art Nouveau vous attend au bout du voyage.\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s.\r\n\r\n\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s. ","description_print":"Le Mus\u00e9e du Cinquantenaire illustre les activit\u00e9s humaines et artistiques des cinq continents \u2013 hormis l\u2019Afrique noire \u2013, de la Pr\u00e9histoire \u00e0 nos jours. Les collections remplissent quatre b\u00e2timents et sont regroup\u00e9es en quatre d\u00e9partements: l\u2019Antiquit\u00e9, les civilisations extra-europ\u00e9ennes, l\u2019arch\u00e9ologie nationale et les arts d\u00e9coratifs europ\u00e9ens.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo de Arte e Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Ad\u00e9ntrate en este edificio hist\u00f3rico, uno de los mayores museos de B\u00e9lgica erigido por el anterior rey belga Leopoldo II. Descubre una gran cantidad de objetos desde la prehistoria hasta la antig\u00fcedad y de las artes aplicadas europeas hasta una amplia colecci\u00f3n de arte no europea. Explora todo, incluyendo las interesantes exposiciones temporales, conferencias y otras actividades. Desafortunadamente, la p\u00e1gina web no es tan amplia como para mostrar toda nuestra colecci\u00f3n, compuesta por miles de tesoros del arte y objetos hist\u00f3ricos. Sin embargo, esperamos que nos visites y disfrutes descubriendo o redescubriendo el inmenso patrimonio que gestionamos y exhibimos. De hecho, para nosotros el arte y la historia no son muerte y temas pasados, si no una viva y constante fuente de inspiraci\u00f3n y diversi\u00f3n.\r\n\r\nEl Museo de Arte e Historia es parte de los Museos Reales de Arte e Historia(MRAH), que incluye el Museo de Instrumentos Musicales(MIM), la Puerta de Hal y los Museos del Lejano Oriente(recientemente cerrado por renovaciones).\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Museum Kunst & Geschiedenis (KMKG)","address_street_name":"Jubelpark","address_street_number":"10","address_street_box":null,"email":"info@kmkg.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 10","address_line2":"1000 Brussel","description_web":"Maak een wereldreis door de geschiedenis! Wandel van prehistorische vuistbijlen naar Egyptische mummies. Snuistert tussen betoverende glas en zet een stap achteruit om de indrukwekkende Brusselse wandtapijten te bekijken. Ga de oosterse toer op tussen de Aziatische boeddha\u2019s en steek de Atlantische Oceaan over om Kuifjes \u2018beeldje met het gebroken oor\u2019. En dan is er nog de mooie collectie van Belgische art nouveau\u2026 U komt ogen en oren te kort!\r\n\r\nHet Museum Kunst & Geschiedenis maakt deel uit van de Koninklijke Musea voor Kunst en Geschiedenis (KMKG) die ook het Muziekinstrumentenmuseum (MIM), de Hallepoort en de Musea van het Verre Oosten (gesloten voor renovatie) bundelen.","description_print":"Het Jubelparkmuseum kan bogen op een imposante collectie kunstschatten en archeologische vondsten afkomstig uit de vijf continenten \u2013 met uitzondering van Zwart-Afrika \u2013 van de prehistorie tot op heden. De verzamelingen vullen vier gebouwen en zijn ingedeeld in evenveel departementen: Oudheid (het Nabije Oosten, Egypte, Griekenland, Rome en Byzantium), Niet-Europese Beschavingen (Islam, Azi\u00eb, Polynesi\u00eb & Micronesi\u00eb en Amerika), Nationale Archeologie en Europese Sierkunsten.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":12,"location":{"lat":50.83935087,"lon":4.3917188},"region":"brussels","last_updated_at":"2024-07-12T09:22:43+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":61,"translations":{"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Brussels","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un fascinant voyage \u00e0 travers l'art et l'histoire. Venez fl\u00e2ner parmi les momies \u00e9gyptiennes et les silex pr\u00e9historiques, vous promener entre les verres anciens et prendre du recul pour mieux contempler d'impressionnantes tapisseries m\u00e9di\u00e9vales. Venez vous immerger dans le monde oriental en croisant des Bouddhas d'Asie et voyager jusqu'\u00e0 l'autre bout de la terre pour apercevoir une gigantesque statue de l'\u00eele de P\u00e2ques. La magnifique collection d'Art Nouveau vous attend au bout du voyage.\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s.\r\n\r\n\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s. ","description_print":"Le Mus\u00e9e du Cinquantenaire illustre les activit\u00e9s humaines et artistiques des cinq continents \u2013 hormis l\u2019Afrique noire \u2013, de la Pr\u00e9histoire \u00e0 nos jours. Les collections remplissent quatre b\u00e2timents et sont regroup\u00e9es en quatre d\u00e9partements: l\u2019Antiquit\u00e9, les civilisations extra-europ\u00e9ennes, l\u2019arch\u00e9ologie nationale et les arts d\u00e9coratifs europ\u00e9ens.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo de Arte e Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Ad\u00e9ntrate en este edificio hist\u00f3rico, uno de los mayores museos de B\u00e9lgica erigido por el anterior rey belga Leopoldo II. Descubre una gran cantidad de objetos desde la prehistoria hasta la antig\u00fcedad y de las artes aplicadas europeas hasta una amplia colecci\u00f3n de arte no europea. Explora todo, incluyendo las interesantes exposiciones temporales, conferencias y otras actividades. Desafortunadamente, la p\u00e1gina web no es tan amplia como para mostrar toda nuestra colecci\u00f3n, compuesta por miles de tesoros del arte y objetos hist\u00f3ricos. Sin embargo, esperamos que nos visites y disfrutes descubriendo o redescubriendo el inmenso patrimonio que gestionamos y exhibimos. De hecho, para nosotros el arte y la historia no son muerte y temas pasados, si no una viva y constante fuente de inspiraci\u00f3n y diversi\u00f3n.\r\n\r\nEl Museo de Arte e Historia es parte de los Museos Reales de Arte e Historia(MRAH), que incluye el Museo de Instrumentos Musicales(MIM), la Puerta de Hal y los Museos del Lejano Oriente(recientemente cerrado por renovaciones).\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Museum Kunst & Geschiedenis (KMKG)","address_street_name":"Jubelpark","address_street_number":"10","address_street_box":null,"email":"info@kmkg.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 10","address_line2":"1000 Brussel","description_web":"Maak een wereldreis door de geschiedenis! Wandel van prehistorische vuistbijlen naar Egyptische mummies. Snuistert tussen betoverende glas en zet een stap achteruit om de indrukwekkende Brusselse wandtapijten te bekijken. Ga de oosterse toer op tussen de Aziatische boeddha\u2019s en steek de Atlantische Oceaan over om Kuifjes \u2018beeldje met het gebroken oor\u2019. En dan is er nog de mooie collectie van Belgische art nouveau\u2026 U komt ogen en oren te kort!\r\n\r\nHet Museum Kunst & Geschiedenis maakt deel uit van de Koninklijke Musea voor Kunst en Geschiedenis (KMKG) die ook het Muziekinstrumentenmuseum (MIM), de Hallepoort en de Musea van het Verre Oosten (gesloten voor renovatie) bundelen.","description_print":"Het Jubelparkmuseum kan bogen op een imposante collectie kunstschatten en archeologische vondsten afkomstig uit de vijf continenten \u2013 met uitzondering van Zwart-Afrika \u2013 van de prehistorie tot op heden. De verzamelingen vullen vier gebouwen en zijn ingedeeld in evenveel departementen: Oudheid (het Nabije Oosten, Egypte, Griekenland, Rome en Byzantium), Niet-Europese Beschavingen (Islam, Azi\u00eb, Polynesi\u00eb & Micronesi\u00eb en Amerika), Nationale Archeologie en Europese Sierkunsten.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":12,"location":{"lat":50.83935087,"lon":4.3917188},"last_updated_at":"2024-07-12T09:22:43+02:00","published_at":"2013-10-19T01:13:13+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/9ac987c9320d765a2d34815871d681aa2a27c5a3.jpg","width":2346,"height":1160,"ratio":2.02,"oEmbed_height":1160,"oEmbed_width":2346,"translations":{"de":{"title":"Stage d'automne : C'est du propre !","copyright":"KMKG-MRAH"},"pt":{"title":"Stage d'automne : C'est du propre !","copyright":"KMKG-MRAH"},"en":{"title":"Stage d'automne : C'est du propre !","copyright":"KMKG-MRAH"},"it":{"title":"Stage d'automne : C'est du propre !","copyright":"KMKG-MRAH"},"cn":{"title":"Stage d'automne : C'est du propre !","copyright":"KMKG-MRAH"},"fr":{"title":"Stage d'automne : C'est du propre !","copyright":"KMKG-MRAH"},"sp":{"title":"Stage d'automne : C'est du p