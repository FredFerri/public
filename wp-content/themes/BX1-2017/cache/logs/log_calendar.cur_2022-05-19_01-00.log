00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":["major_event"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-11T15:35:33+02:00","published_at":"2022-03-16T17:42:02+01:00","backoffice_id":249834,"import_origin":null,"sub_type":"foire","show_in_agenda":true,"ranking":1.1006424162982},{"id":533532,"date_start":"2022-05-16","date_end":"2022-05-20","date_next":"2022-05-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visites insolites au MoMuse","shortdescr":"D\u00e9couvrir un mus\u00e9e, un lieu du patrimoine, cela peut se faire de mille fa\u00e7ons !\r\nLe projet Curieuze Neuze vous entra\u00eene dans quatre lieux bruxellois avec des \u00e9couteurs sur les oreilles ! Le ou la guide vous emm\u00e8nera dans une promenade sonore faite de bruitages et d\u2019histoires loufoques pour vivre le Patrimoine diff\u00e9remment.","longdescr":"Bienvenue au MoMuse Mus\u00e9e Molenbeek Museum pour une aventure d\u00e9cal\u00e9e autour du Patrimoine.\r\nLe lundi 16 mai, le mardi 17 mai, le vendredi 20 mai \u00e0 16h.\r\nInscription et infos : visitecasquee@gmail.com \/ 0470 06 82 73\r\nLes balades sont accessibles \u00e0 partir de 7 ans, et durent une petite heure.\r\nUn projet de l\u2019association Patrimoine \u00e0 Roulettes, dans le cadre du projet Curieuze Neuze avec le soutien de la R\u00e9gion Bruxelloise et des mus\u00e9es partenaires.\r\n\r\nO\u00f9 :\r\nMomuse\r\nRue Mommaerts 2a\r\n1080 Molenbeek-Saint-Jean\r\nT\u00e9l\u00e9phone :\r\n0470 06 82 73\r\nTarif :\r\nGratuit\r\nPublic :\r\n\u00e0 partir de 7 ans\r\nInternet :\r\nhttps:\/\/patrimoinearoulettes.org\/curieuze-neuze\/","performers":"Patrimoine \u00e0 Roulettes","boxoffice_url":null,"website":"https:\/\/patrimoinearoulettes.org\/","email":"visitecasquee@gmail.com","phone_contact":"+32 470 06 82 73","phone_booking":"+32 470 06 82 73","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533532.html"},"nl":{"name":"Visites insolites au MoMuse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"visitecasquee@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533532.html"},"en":{"name":"Visites insolites au MoMuse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"visitecasquee@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533532.html"},"de":{"name":"Visites insolites au MoMuse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533532.html"},"it":{"name":"Visites insolites au MoMuse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533532.html"},"sp":{"name":"Visites insolites au MoMuse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533532.html"},"pt":{"name":"Visites insolites au MoMuse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533532.html"},"cn":{"name":"Visites insolites au MoMuse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533532.html"}},"place":{"id":270182,"translations":{"fr":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Une commune, c\u2019est avant tout une histoire. Et celle de Molenbeek est loin d\u2019\u00eatre anodine. Le MoMuse est une vitrine du patrimoine historique de la commune, depuis ses origines jusqu\u2019\u00e0 aujourd\u2019hui, avec un accent tout particulier mis sur les XIXe et XXe si\u00e8cles. Le mus\u00e9e permettra aux visiteurs de comprendre l\u2019\u00e9volution de ce petit territoire de quelques 6km2, ayant d\u2019abord connu un d\u00e9veloppement rural durant de nombreux si\u00e8cles, puis une industrialisation intense \u00e0 partir des ann\u00e9es 1840, suivie d\u2019une d\u00e9sindustrialisation non sans cons\u00e9quences, et enfin, \u00e0 l\u2019aube des ann\u00e9es 1960, une croissance urbanistique intense. Autant d\u2019\u00e9v\u00e9nements qui ont profond\u00e9ment modifi\u00e9 les modes de vie et l\u2019essence m\u00eame de la commune.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"MoMuse - Gemeentelijk Museum van Sint-Jans Molenbeek","address_street_name":"Mommaertsstraat","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Mommaertsstraat, 2A","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"De geschiedenis van de gemeente Sint-Jans-Molenbeek is verre van triviaal. Het MoMuse exposeert het historische erfgoed van de gemeente, vanaf zijn ontstaan tot nu, met speciale nadruk op de negentiende en twintigste eeuw. De bezoekers zullen de evolutie doorlopen van dit kleine grondgebied van ongeveer 6 km2, die begint met een eeuwenlange plattelandsontwikkeling, dan een intense industrialisatie vanaf de jaren 1840, gevolgd door een afbouw van de industrialisatie die niet zonder gevolgen is gebleven, en tenslotte, aan het begin van de jaren zestig, een intense stedelijke groei. Al deze gebeurtenissen hebben de levenswijze en de essentie zelve van de gemeente grondig veranderd.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Municipal Museum of Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"The MoMuse exhibits the historical heritage of Molenbeek, from its origins to the present day, with a special emphasis on the 19th and 20th centuries. This small territory of some 6km\u00b2, has evolved over many centuries. From humble rural beginnings, it experienced an intense industrialisation in the 1840s, followed by a deindustrialisation not without consequences, and finally, at the dawn of the 1960s, an intense urban growth. All these events have profoundly changed the way of life, and essence of the commune.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","websit