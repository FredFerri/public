in_vb_export":false,"resto_ranking":0},"organizer":{"id":252336,"translations":{"fr":{"name":"Chorus Erasmus","address_street_name":"Rue des Papillons","address_street_number":"289","address_street_box":null,"email":"webmaster@choruserasmus.be","website":"https:\/\/www.choruserasmus.be\/","phone_contact":"+32 2 527 11 92","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue des Papillons, 289","address_line2":"1070 Anderlecht","description_web":"Chorus Erasmus est un ch\u0153ur polyphonique bilingue \u00e0 Anderlecht cr\u00e9\u00e9 en 2000. Nous sommes une trentaine de chanteurs amateurs qui prenons plaisir \u00e0 nous retrouver trois samedis par mois \u00e0 Anderlecht, pour chanter ensemble. Certains d\u2019entre nous ont re\u00e7u une formation musicale pouss\u00e9e, d\u2019autres n\u2019ont qu\u2019une connaissance de base du solf\u00e8ge, mais nous partageons tous l\u2019amour de la musique. Nous organisons deux \u00e0 trois concerts par an.\r\nContactez-nous si vous d\u00e9sirez nous rejoindre.\r\n","description_print":"Chorus Erasmus est un ch\u0153ur polyphonique bilingue \u00e0 Anderlecht cr\u00e9\u00e9 en 2000. Nous sommes une trentaine de chanteurs amateurs qui prenons plaisir \u00e0 nous retrouver trois samedis par mois \u00e0 Anderlecht, pour chanter ensemble. Certains d\u2019entre nous ont re\u00e7u une formation musicale pouss\u00e9e, d\u2019autres n\u2019ont qu\u2019une connaissance de base du solf\u00e8ge, mais nous partageons tous l\u2019amour de la musique. Nous organisons deux \u00e0 trois concerts par an.\r\nContactez-nous si vous d\u00e9sirez nous rejoindre.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Chorus Erasmus","address_street_name":"Vlindersstraat","address_street_number":"289","address_street_box":null,"email":"webmaster@choruserasmus.be","website":"https:\/\/www.choruserasmus.be\/","phone_contact":"+32 2 527 11 92","phone_booking":null,"address_zip":"1070","address_