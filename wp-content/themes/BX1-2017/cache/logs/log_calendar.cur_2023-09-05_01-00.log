es"}},"others":{}},"translations":{"de":{"name":"No Dancing At The Library: Startfeest 10 Jaar Muntpunt","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.562668"},"pt":{"name":"No Dancing At The Library: Startfeest 10 Jaar Muntpunt","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.562668"},"en":{"name":"No Dancing At The Library: Startfeest 10 Jaar Muntpunt","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.562668"},"it":{"name":"No Dancing At The Library: Startfeest 10 Jaar Muntpunt","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.562668"},"cn":{"name":"No Dancing At The Library: Startfeest 10 Jaar Muntpunt","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.562668"},"fr":{"name":"No Dancing At The Library: Startfeest 10 Jaar Muntpunt","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.562668"},"sp":{"name":"No Dancing At The Library: Startfeest 10 Jaar Muntpunt","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.562668"},"nl":{"name":"No Dancing at the Library: Startfeest 10 Jaar Muntpunt","shortdescr":"Een fuif in de bibliotheek?! We trappen de verjaardagsfestiviteiten af met een klein dansfeest in het Muntpunt Caf\u00e9. Plaatjesdraaiers van dienst: Lamia, Fatoosan en SAHRA.","longdescr":"Als je 10 wordt, dan mag je wat meer. Stilte in de bib! Geen eten en drinken! Nou, deze keer dus wel. Het feestelijke startschot van 10 Jaar Muntpunt\u00a0is, zoals het een tiener betaamt, een heuse fuif.\n\nVier de verjaardag van Muntpunt en gooi de benen los in het Muntpunt Caf\u00e9. DJ's Lamia,\u00a0Fatoosan\u00a0en SAHRA\u00a0draaien eclectische beats die zelfs de boeken doen swingen in hun rekken.\n\nOntdek het volledige programma van 10 Jaar Muntpunt\n\nEN -\u00a0A party in the library?! We're kicking off the birthday celebrations with a small dance party at the Muntpunt Caf\u00e9. At the wheels of steel: Lamia, Fatoosan and SAHRA.\n\nFR - Une f\u00eate dans la biblioth\u00e8que ?! Nous lan\u00e7ons les festivit\u00e9s d'anniversaire avec une petite soir\u00e9e dansante au Muntpunt Caf\u00e9. DJs de service : Lamia, Fatoosan et SAHRA.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.562668"}},"place":{"id":279769,"translations":{"de":{"name":"Muntpunt Caf\u00e9","address_street_name":"Leopoldstraat 2","address_street_number":null,"address_street_box":nu