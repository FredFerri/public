_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003787"},"pt":{"name":"Les \u00c9pitres de Tol\u00e9rance |\u00a0Joey Elmaleh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joey-elmaleh\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003787"},"en":{"name":"Les \u00c9pitres de Tol\u00e9rance |\u00a0Joey Elmaleh","shortdescr":"Un drag-show satirique et politique \u00e0 ne pas manquer ! ","longdescr":"D\u00e9jant\u00e9e, incorrecte, corporate et campy, voici \"Tol\u00e9rance Z\u00e9ro\" : Cette femme d\u2019ordre, un rien excessive, vous invite \u00e0 d\u00e9couvrir ses lettres, ses flamboyantes \u00e9p\u00eetres. Dans cette correspondance, elle t\u00e9moigne des changements \u00e0 l\u2019\u0153uvre dans nos soci\u00e9t\u00e9s, qui ne sont pas pour la rassurer\u2026 Est-elle pr\u00eate \u00e0 se remettre en question ? Et vous ?  Quelque part entre Val\u00e9rie P\u00e9cresse et Eddie-Suzy Izzard, elle inaugure le drag de droite et vient accomplir sur sc\u00e8ne son destin litt\u00e9raire et politique.\n\nTol\u00e9rance, ic\u00f4ne r\u00e9actionnaire, aussi probl\u00e9matique qu\u2019embl\u00e9matique, questionne nos biais et nos complaisances. De satire en catharsis, ce spectacle \u00e0 l\u2019humour acide expose et inqui\u00e8te les privil\u00e8ges de genre, de classe et de race.\n\n\u00c0 propos de Joey Elmaleh\nAuteur\u00b7rice et performeur\u00b7euse, Joey explore la queerness et la litt\u00e9rarit\u00e9 dans des cr\u00e9ations uniques. Dipl\u00f4m\u00e9\u00b7e de l\u2019INSAS, iel se lance dans des performances th\u00e9\u00e2trales audacieuses et po\u00e9tiques. Avec Tol\u00e9rance Z\u00e9ro, Joey signe une \u0153uvre personnelle, politique et percutante.","performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joey-elmaleh\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003787"},"it":{"name":"Les \u00c9pitres de Tol\u00e9rance |\u00a0Joey Elmaleh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joey-elmaleh\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003787"},"cn":{"name":"Les \u00c9pitres de Tol\u00e9rance |\u00a0Joey Elmaleh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joey-elmaleh\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003787"},"fr":{"name":"Les \u00c9pitres de Tol\u00e9rance |\u00a0Joey Elmaleh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joey-elmaleh\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003787"},"sp":{"name":"Les \u00c9pitres de Tol\u00e9rance |\u00a0Joey Elmaleh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joey-elmaleh\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003787"},"nl":{"name":"Les \u00c9pitres de Tol\u00e9rance |\u00a0Joey Elmaleh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joey-elmaleh\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003787"}},"place":{"id":278685,"translations":{"de":{"n