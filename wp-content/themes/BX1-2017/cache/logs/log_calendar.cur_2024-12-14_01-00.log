ssels\/pt\/visitors\/agenda\/event-detail.5700001917"},"en":{"name":"La R\u00e9sistance \u00e0 Koekelberg","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001917"},"it":{"name":"La R\u00e9sistance \u00e0 Koekelberg","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001917"},"cn":{"name":"La R\u00e9sistance \u00e0 Koekelberg","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001917"},"fr":{"name":"La R\u00e9sistance \u00e0 Koekelberg","shortdescr":null,"longdescr":"Nombreux sont les habitants de Koekelberg qui se sont engag\u00e9s dans la R\u00e9sistance durant la Seconde Guerre mondiale.\nIls et elles \u00e9taient lyc\u00e9ens, professeurs, policiers, postiers, coiffeurs ou vendeurs de journaux...\nBelges ou \u00e9trangers, ils ont h\u00e9berg\u00e9 des clandestins, cach\u00e9 des armes et du mat\u00e9riel, diffus\u00e9 la presse clandestine, pr\u00e9par\u00e9 des sabotages et organis\u00e9 le d\u00e9part au \u00ab maquis \u00bb de ceux qui refusaient d\u2019aller travailler en Allemagne.\nCertains ont subi la r\u00e9pression. Ce sont leurs parcours, parfois tragiques, que nous d\u00e9couvrirons au cours de cette promenade, \u00e0 travers les lieux o\u00f9 ils ont habit\u00e9, travaill\u00e9, agi.\n\nDe l'\u00e9cole Armand Swartenbroeks \u00e0 la basilique de Koekelberg, cette promenade met en lumi\u00e8re les nombreuses facettes de l'action r\u00e9sistante durant la Seconde Guerre mondiale.\n\nCette visite guid\u00e9e est organis\u00e9e en collaboration avec le Mus\u00e9e des R\u00e9sistances, dans le cadre du 80e anniversaire de la Lib\u00e9ration de Bruxelles. Deux autres visites sont organis\u00e9es : le 26 octobre dans les Marolles et le 23 novembre \u00e0 Anderlecht.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001917"},"sp":{"name":"La R\u00e9sistance \u00e0 Koekelberg","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001917"},"nl":{"name":"La R\u00e9sistance \u00e0 Koekelberg","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001917"}},"place":{"id":50002467,"translations":{"de":{"name":"Ecole Armand Swartenbroeks","address_street_name":"Rue des Tisserands","address_street_number":"24","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Rue des Tisserands, 24","address_line2":"1081 Koekelberg","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Ecole Armand 