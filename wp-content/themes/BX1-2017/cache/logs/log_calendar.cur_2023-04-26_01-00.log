":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Mekhitar Garabedian - I copied this page in one country and the other page in another land","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":"+32 2 512 92 95","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554487"},"nl":{"name":"Mekhitar Garabedian - I copied this page in one country and the other page in another land","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":"+32 2 512 92 95","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554487"},"en":{"name":"Mekhitar Garabedian - I copied this page in one country and the other page in another land","shortdescr":"For his third exhibition at Baronian, Mekhitar Garabedian is reinterpreting the miniatures of the copyists, and the edges of the image in particular. By appropriating himself various visual and textual sources, Garabedian explores the fragility of heritage.","longdescr":"\u201cI am asking for forgiveness for my scribal errors, because my friend is a babbling chatterbox.\u201d The Armenian copyist Aleksianos complained in the fourteenth century about the conditions in which he had to perform his duties as a monk. During the Middle Ages, a unique tradition emerged among Armenian copyists to outline in the colophon the political, social \u2013 or personal \u2013 context in which they did their work. The constant threat of hostile populations is a recurring theme in these colophons. Today, Armenian cultural heritage is still under pressure, as it was after the capture of Artsakh (or Nagorno-Karabakh) by the Azerbaijani army in 2020. For his third exhibition at Baronian, Mekhitar Garabedian is reinterpreting the miniatures of the copyists, and the edges of the image in particular. The decorative patterns were the monks\u2019 preferred place to improvise and deviate from the norm. By appropriating himself various visual and textual sources, Garabedian explores the fragility of heritage.","performers":"For his third exhibition at Baronian, Mekhitar Garabedian is reinterpreting the miniatures of the copyists, and the edges of the image in particular. By appropriating himself various visual and textual sources, Garabedian explores the fragility of heritage.","boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":"+32 2 512 92 95","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554487"},"de":{"name":"Mekhitar Garabedian - I copied this page in one country and the other page in another land","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":"+32 2 512 92 95","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554487"},"it":{"name":"Mekhitar Garabedian - I copied this page in one country and the other page in another land","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":"+32 2 512 92 95","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554487"},"sp":{"name":"Mekhitar Garabedian - I copied this page in one country and the other page in another land","shortdescr":null,"longdescr":null,"performers":null,"boxoff