descr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010986"},"en":{"name":"Cours de th\u00e9\u00e2tre adultes avanc\u00e9 - Training de l'acteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010986"},"it":{"name":"Cours de th\u00e9\u00e2tre adultes avanc\u00e9 - Training de l'acteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010986"},"cn":{"name":"Cours de th\u00e9\u00e2tre adultes avanc\u00e9 - Training de l'acteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010986"},"fr":{"name":"Cours de th\u00e9\u00e2tre adultes avanc\u00e9 - Training de l'acteur","shortdescr":null,"longdescr":"Le cours de th\u00e9\u00e2tre dirig\u00e9 par Luca Franceschi et Carole Ventura vous permettra de :\n- D\u00e9velopper votre cr\u00e9ativit\u00e9,\n- Acqu\u00e9rir confiance en vous et en l\u2019autre,\n- D\u00e9couvrir et travailler votre voix, diction, langage,\n- Am\u00e9liorer votre gestuelle, l'expressivit\u00e9 de votre corps,\n- R\u00e9veiller la curiosit\u00e9, l\u2019instinct, apprendre \u00e0 l\u00e2cher prise,\n- Accepter l\u2019impr\u00e9vu et d\u00e9couvrir un autre soi, plus audacieux et courageux.\n\nD\u00e9roulement des cours :\n- Travail sur les rythmes, les impulsions, les \u00e9motions,\n- Le corps dans l\u2019espace, le corps en sc\u00e8ne,\n- D\u00e9couverte de la po\u00e9sie du corps en mouvement,\n- D\u00e9veloppement de l'imaginaire et de la cr\u00e9ativit\u00e9,\n- D\u00e9couverte de plusieurs textes du r\u00e9pertoire (classique et contemporain),\n- Le texte, le sous-texte, la situation, les enjeux dramatiques,\n- La construction du personnage,\n- La hi\u00e9rarchie, rapport dominant\/domin\u00e9, la situation dramatique, l\u2019accident,\n- Les conflits int\u00e9rieurs, entre les personnages, avec le public.","performers":"Luca Franceschi et Carole Ventura","boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010986"},"sp":{"name":"Cours de th\u00e9\u00e2tre adultes avanc\u00e9 - Training de l'acteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010986"},"nl":{"name":"Cours de th\u00e9\u00e2tre adultes avanc\u00e9 - Training de l'acteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010986"}},"place":{"id":275475,"translations":{"de":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"adm@theatrecreanova.be","website":"http:\/\/theatrecreanova.be","phone_contact":"+32 490 25 97 76","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gi