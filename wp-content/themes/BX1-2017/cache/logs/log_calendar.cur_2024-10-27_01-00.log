\u2019autres, vous entrerez dans son atelier pour d\u00e9couvrir les coulisses de la fabrication d\u2019une image et en ressortir avec le sourire. Satisfait ou rembours\u00e9.\n\nINFOS Pratiques\n\nVernissage le vendredi 4 octobre de 18h \u00e0 22h30 au Centre Culturel d'Uccle\nExposition du 5 octobre au 3 novembre\nOuvert du mardi au vendredi de 11h \u00e0 18h, le samedi de 14h \u00e0 18h et 1h avant les spectacles\nRue Rouge 47 - 1180 Uccle\nPlus d\u2019infos : 02\/605.15.30 - ","performers":"Fr\u00e9d\u00e9ric duBus","boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002070"},"sp":{"name":"Exposition r\u00e9trospective des \u0153uvres de Fr\u00e9d\u00e9ric duBus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002070"},"nl":{"name":"Exposition r\u00e9trospective des \u0153uvres de Fr\u00e9d\u00e9ric duBus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002070"}},"place":{"id":50002417,"translations":{"de":{"name":"Centre culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre culturel 