ptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[{"day":"monday","occurences":{"is_last":true,"is_first":true,"is_second":true,"is_third":true,"is_fourth":true},"time_start":"10:30:00","time_end":"11:30:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier lundis du mois de 10:30 \u00e0 11:30","nl":"Open op de eerste, tweede, derde, vierde en laatste maandags van de maand van 10:30 tot 11:30","en":"Open the first, second, third, fourth and last mondays of the month from 10:30 to 11:30"}}],"targets":{"list":[10],"translations":{"de":["Senioren"],"pt":[null],"en":["Seniors"],"it":["Anziani"],"cn":[null],"fr":["Seniors"],"sp":["Personas de la tercera edad"],"nl":["Senioren"]}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":553940,"date_start":"2023-02-01","date_end":"2029-12-31","date_next":"2024-03-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-19T01:02:40+01:00","published_at":"2023-03-23T09:03:13+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":273940,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.0925121732163657,"languages":{"spoken":["en","es","nl","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Visites de l'Hotel de Ville de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brussels.be\/city-hall","email":"cityhall@bmeo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.553940"},"pt":{"name":"Visites de l'Hotel de Ville de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brussels.be\/city-hall","email":"cityhall@bmeo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.553940"},"en":{"name":"Visits of the City Hall of Brussels","shortdescr":"Discover the City Hall like you've never seen it before !","longdescr":"This surprising building consists of two stylistically very different parts. \r\nThe first (Gothic) was built in the 15th century and is the only existing medieval remains of the Grand-Place. \r\nThe second, the classical-style extension at the rear of the building was built in the 18th century.\r\nTwo tour options are available as of 1 February. These new routes  allow visitors to discover areas of the Town Hall which were not previously accessible to the public.\r\n\r\n-The traditional route: this allows you to learn more about the context of the different periods of construction of the building by observing the main fa\u00e7ade overlooking the Grand Place and the courtyard. \r\nVisitors then enter the Town Hall to admire the ceremonial offices, all the main rooms and the galleries (Burgomaster's Office, Town Council Chamber, Maximilian Hall, Wedding Hall, Gothic Hall, Portrait Gallery, Grang\u00e9 Gallery, etc.).\r\nThese tours take place on Mondays, Wednesdays, Fridays, Saturdays and Sundays in French, Dutch, Spanish or English and in groups of up to 25 people.\r\n\r\n-The Panoramic: offers the opportunity to discover two of the main halls (the Wedding Hall and the Gothic Hall). Visitors will then be directed to the prestigious balcony of the Town Hall to enjoy a bird's eye view of the Grand Place, world-famous for its decorative richness.\r\nThe visit continues with an ascent to the tower of the Town Hall, reached by a spiral staircase. The visitor is rewarded at the top by an exceptional view of Brussels from its nerve centre.\r\nVisits take place on Saturdays, in French or English and in groups of up to 15 people.\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.brussels.be\/city-hall","email":"cityhall@bmeo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553940"},"it":{"name":"Visites de l'Hotel de Ville de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brussels.be\/city-hall","email":"cityhall@bmeo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.553940"},"cn":{"name":"Visites de l'Hotel de Ville de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brussels.be\/city-hall","email":"cityhall@bmeo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.553940"},"fr":{"name":"Visites de l'Hotel de Ville de Bruxelles","shortdescr":"D\u00e9couvrez l\u2019H\u00f4tel de Ville comme vous ne l\u2019avez jamais vu !","longdescr":"Cet \u00e9difice surprenant est constitu\u00e9 de deux parties stylistiquement tr\u00e8s diff\u00e9rentes, \r\nla premi\u00e8re, gothique, a \u00e9t\u00e9 construite au XVe si\u00e8cle et constitue le seul vestige m\u00e9di\u00e9val de la Grand-Place. \r\nLa deuxi\u00e8me, l\u2019extension de style classique \u00e0 l\u2019arri\u00e8re du b\u00e2timent a \u00e9t\u00e9 \u00e9difi\u00e9e au XVIIIe si\u00e8cle.\r\nD\u00e8s le 1er f\u00e9vrier deux formules de visites sont disponibles, ces nouveaux itin\u00e9raires  permettent aux visiteurs de d\u00e9couvrir des espaces de l\u2019H\u00f4tel de Ville jusqu\u2019ici non-accessibles au public.\r\n\r\n-La classique : qui permet d\u2019en apprendre davantage sur le contexte des diff\u00e9rentes p\u00e9riodes de construction du b\u00e2timent en observant la fa\u00e7ade principale donnant sur la Grand Place et la cour. \r\nLes visiteurs entrent ensuite dans l'h\u00f4tel de ville pour admirer les bureaux d\u2019apparat, toutes les salles principales et les galeries (Cabinet du Bourgmestre, Salle du Conseil Communal, Salle Maximilienne, Salle des Mariages, salle Gothique, Galerie des Portraits, Galerie Grang\u00e9, etc.).\r\nCes visites ont lieu le lundi, mercredi, vendredi, samedi et dimanche en fran\u00e7ais, n\u00e9erlandais, espagnol ou anglais et par groupe de 25 personnes maximum.\r\n\r\n-La Panoramique : qui offre l\u2019opportunit\u00e9 de d\u00e9couvrir deux des salles principales (salle des Mariages et salle Gothique), les visiteurs seront dirig\u00e9s ensuite vers le prestigieux balcon de l\u2019H\u00f4tel de Ville pour profiter d\u2019une vue plongeante sur la Grand Place, mondialement renomm\u00e9e pour sa richesse ornementale.\r\nLa visite continue avec l\u2019ascension dans la tour de l\u2019H\u00f4tel de Ville, on y acc\u00e8de par un escalier en colima\u00e7on pour \u00eatre r\u00e9compens\u00e9 au sommet par une vue exceptionnelle de Bruxelles depuis son c\u0153ur n\u00e9vralgique.\r\nLes visites se d\u00e9roulent le samedi, en fran\u00e7ais ou anglais et par groupe de 15 personnes maximum.\r\n\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.brussels.be\/city-hall","email":"cityhall@bmeo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553940"},"sp":{"name":"Visita al Ayuntamiento de Bruselas","shortdescr":null,"longdescr":"Este sorprendente edificio consta de dos partes estil\u00edsticamente muy diferentes: la primera, g\u00f3tica, se construy\u00f3 en el siglo XV y es el \u00fanico vestigio medieval de la Grand Place. La segunda se trata de una la ampliaci\u00f3n de estilo cl\u00e1sico, situada en la parte trasera del edificio, que se construy\u00f3 en el siglo XVIII. Estos nuevos itinerarios dan a los visitantes la posibilidad de descubrir algunas zonas del Ayuntamiento que antes no eran accesibles al p\u00fablico. Hay dos tipos de visita disponibles:\r\n- La cl\u00e1sica: con esta opci\u00f3n, puedes aprender m\u00e1s sobre los diferentes periodos de construcci\u00f3n del edificio mediante la observaci\u00f3n de la fachada principal que da a la Grand-Place y al patio. A continuaci\u00f3n, los visitantes acceden al Ayuntamiento para visitar los despachos de ceremonias, todas las salas principales y las galer\u00edas (el despacho del alcalde, la sala del pleno, el sal\u00f3n Maximiliano, el sal\u00f3n de Bodas, el sal\u00f3n G\u00f3tico, la Galer\u00eda de Retratos, la Galer\u00eda Grang\u00e9...). Estas visitas tienen lugar los lunes, mi\u00e9rcoles, viernes, s\u00e1bados y domingos; est\u00e1n disponibles en franc\u00e9s, neerland\u00e9s, espa\u00f1ol o ingl\u00e9s y en grupos de hasta 25 personas.\r\n- La panor\u00e1mica: esta opci\u00f3n te ofrece la oportunidad de descubrir dos de las salas principales (el sal\u00f3n de bodas y el sal\u00f3n G\u00f3tico) y te lleva al prestigioso balc\u00f3n del Ayuntamiento para disfrutar de una vista de p\u00e1jaro de la Grand-Place, famosa en todo el mundo por su riqueza ornamental. La visita contin\u00faa con la subida a la torre del Ayuntamiento, a la que se accede por una escalera de caracol, desde donde podr\u00e1s disfrutar de tu recompensa tras haber subido todos esos escalones: una vista excepcional de Bruselas, como en ning\u00fan otro sitio, desde su centro neur\u00e1lgico. Las visitas tienen lugar los s\u00e1bados, en franc\u00e9s o ingl\u00e9s y en grupos de 15 personas como m\u00e1ximo.\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.brussels.be\/city-hall","email":"cityhall@bmeo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.553940"},"nl":{"name":"Rondleidingen Stadhuis van Brussel","shortdescr":"Ontdek het Stadhuis zoals u het nog nooit gezien heeft!","longdescr":"Het Stadhuis zoals je het nog nooit zag\r\nDit verrassende gebouw bestaat uit twee stilistisch zeer verschillende delen: \r\nhet gotische gedeelte, gebouwd in de 15e eeuw, is het enige middeleeuwse overblijfsel van de Grote Markt. \r\nHet tweede deel, de aanbouw in klassieke stijl aan de achterzijde van het gebouw, dateert uit de 18e eeuw.\r\nVanaf 1 februari zijn er twee rondleidingen mogelijk. De nieuwe routes laten bezoekers delen van het stadhuis ontdekken die voorheen niet toegankelijk waren voor het publiek.\r\n\r\n-De klassieke rondleiding: aan de hand van een gedetailleerde observatie van de voorgevel, die uitziet op de Grote Markt en de binnenplaats, komen de bezoekers meer te weten over de achtergrond van de verschillende bouwperioden van het gebouw. \r\nVervolgens gaan ze het stadhuis binnen om de ceremoni\u00eble kantoren, alle grote zalen en de galerijen (Kabinet van de Burgemeester, Gemeenteraadszaal, Maximiliaanzaal, Trouwzaal, Gotische zaal, Portrettengalerij, Grang\u00e9-galerij, enz.) te bewonderen. \r\nDeze rondleidingen vinden plaats op maandag, woensdag, vrijdag, zaterdag en zondag in het Frans, Nederlands, Spaans of Engels en in groepen van maximaal 25 personen.\r\n\r\n-De panoramische rondleiding: de bezoekers bezichtigen twee van de belangrijkste zalen (de Trouwzaal en de Gotische zaal), waarna ze naar het schitterende balkon van het stadhuis worden geleid om er te genieten van een panoramisch uitzicht op de Grote Markt, wereldberoemd om haar rijke ornamenten.\r\nDe rondleiding gaat verder langs de wenteltrap in de toren van het stadhuis \u2013 een steile klim. Bovenaan wordt de inspanning beloond met een uitzonderlijk uitzicht over Brussel vanuit zijn bestuurlijke centrum.\r\nDe rondleidingen vinden plaats op zaterdag in het Frans of Engels en in groepen van maximaal 15 personen. \r\n\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.brussels.be\/city-hall","email":"cityhall@bmeo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553940"}},"place":{"id":475,"translations":{"de":{"name":"Rathaus Br\u00fcssel","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.brussels.be\/city-hall","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Rathaus ist ein elegantes Bauwerk aus dem 15. Jahrhundert, gelegen auf dem pr\u00e4chtigen Grand-Place im Herzen des historischen Stadtzentrums. \r\n\r\nEs gilt als das architektonische Meisterwerk eines der sch\u00f6nsten Pl\u00e4tze der Welt und z\u00e4hlt dar\u00fcber hinaus zu den wahrscheinlich eindrucksvollsten Bauwerken Belgiens, das Sie bei Ihrem Besuch in Br\u00fcssel unbedingt besichtigen sollten. Zu verfehlen ist es kaum, denn sein majest\u00e4tischer Turm ragt hoch in den Br\u00fcsseler Himmel hinein.  \r\n\r\nEin Augenschmaus \r\n\r\nInsbesondere seine imposanten Dimensionen, seine bemerkenswerten skulpturalen Verzierungen und seine asymmetrische Fassade fallen sofort ins Auge. Und wenn man Gl\u00fcck hat, kann man auf dem majest\u00e4tischen Balkon einen Blick auf ein frischgebackenes Brautpaar erhaschen. \r\n\r\nAuch das Innere des Rathauses ist einen Besuch wert, denn die Aufteilung und die Anordnung der verschiedenen S\u00e4le dieses architektonischen Meisterwerks sind absolut sehenswert. Es finden regelm\u00e4\u00dfig F\u00fchrungen durch das Br\u00fcsseler Rathaus statt, die spannende Einblicke in die Reicht\u00fcmer des Interieurs gew\u00e4hren, das die Besucher immer wieder aufs Neue begeistert. \r\n\r\nDie Entstehung eines einzigartigen Geb\u00e4udes \r\n\r\nDer Bau des Rathauses erstreckte sich \u00fcber einen relativ langen Zeitraum und war das Werk mehrerer Architekten. Urspr\u00fcnglich bestand das Geb\u00e4ude nur aus einem Glockenturm und dem bis heute unver\u00e4nderten linken Geb\u00e4udefl\u00fcgel. Der Glockenturm hingegen wurde schon bald durch den heutigen Turm ersetzt, als sich die H\u00e4user der verschiedenen Handwerksz\u00fcnfte am Grand-Place niederlie\u00dfen. Um das Geb\u00e4ude noch harmonischer in das Stadtbild einzuf\u00fcgen, wurde ein zus\u00e4tzlicher Fl\u00fcgel auf der rechten Seite hinzugef\u00fcgt. \r\n\r\nAn der Spitze des neuen, mehr als 90 m hohen Turms  thront der Erzengel Michael, der Schutzpatron der Stadt Br\u00fcssel. Die vergoldete Kupferstatue dient eigentlich als Wetterfigur \u2013 und wenn der Wind g\u00fcnstig steht, k\u00f6nnen Sie beobachten, wie die die Engelsfigur den Drachen besiegt! \r\n\r\nDerzeit beherbergt dieses Kleinod des Br\u00fcsseler Architekturerbes das Tourismusb\u00fcro.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"C\u00e2mara Municipal de Bruxelas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.bruxelles.be\/hotel-de-ville","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"O edif\u00edcio da C\u00e2mara Municipal de Bruxelas \u00e9 uma obra de arte da arquitetura civil g\u00f3tica do s\u00e9culo XV. No s\u00e9culo XVIII, foi-lhe adicionada uma ala de estilo cl\u00e1ssico. As in\u00fameras salas competem entre si em aparato. S\u00e3o notavelmente ornamentadas por tape\u00e7arias excecionais que evocam epis\u00f3dios locais e nacionais da hist\u00f3ria belga. Exposi\u00e7\u00f5es ocupam pontualmente os espa\u00e7os.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"City of Brussels Town Hall","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.brussels.be\/city-hall","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"Of all of the town halls in the country, the City of Brussels town hall is undoubtedly one of the most majestic! This Gothic building, built in the 15th century, is enhanced by its setting on the Grand-Place, often described as the most beautiful square in the world... Admire the accuracy of its proportions, the countless sculptures that adorn its facades and the incomparable brilliance of its tower, whose spire supports the archangel Saint Michael, the city's protector. This City of Brussels laid the first stone of the sumptuous building back in 1401. In 1695, during the bombardment of the city by Louis XIV's troops, the town hall was burned down, but the walls and the tower remained standing. Its reception rooms and aldermen's chambers contain beautiful Brussels tapestries from the 16th, 17th and 18th centuries, sumptuous Gothic woodwork, coats of arms of the old guilds and paintings from the City of Brussels museum's collections.","description_print":"18\/07\/2022\r\nAn elegant building dating back to the 15th century, the City of Brussels Town Hall is located in the heart of the historical centre, on the sumptuous Grand-Place.\r\nOften considered to be the centrepiece of the most beautiful square in the world, it is undoubtedly one of the most stunning buildings in Belgium and definitely one of the unmissable highlights of your stay in Brussels. Its splendid tower stands as a landmark both for day-trippers and Belgians passing through the centre of the capital.\r\n\r\nA feast for the eyes\r\nParticularly imposing due to its size, its remarkable sculpted decorations and its asymmetrical facade, it quickly catches the eye. Walking in front of this prestigious building, you might spot newlyweds celebrating their union on the balconies.\r\nThe Town Hall's interior is also well worth a visit. It attracts the curiosity of those who want to know more about the layout and arrangement of the different rooms of this architectural masterpiece. Guided tours of the City of Brussels Town Hall are regularly organised and let you discover the richness of this interior which never fails to dazzle its visitors.\r\n\r\nThe evolution of a unique building\r\nIts construction was spread out over a long period of time and is the work of several architects. Originally, the building had only a belfry and the left part of the building has remained the same until today. The belfry, on the other hand, was quickly replaced by the current tower when the houses of the various trade guilds moved into the square. An additional wing was also added on the right to better incorporate these buildings into this exceptional setting.\r\nAt the top of the new tower, more than 90m high, the spire is crowned with the Archangel Saint-Michel, the patron saint of the City of Brussels. This gilded copper statue is actually used as a weather vane. If the winds blow the right way, you can admire the city's hero as he defeats the dragon!\r\nThis jewel of Brussels' architectural heritage currently houses the Tourist Office.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Municipio di Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.bruxelles.be\/hotel-de-ville","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Elegante edificio risalente al 15\u00b0 secolo, il municipio di Bruxelles si trova nel cuore del centro storico, nella sontuosa Grand-Place. \r\n\r\nSpesso considerato come l\u2019elemento centrale della piazza pi\u00f9 bella del mondo, \u00e8 probabilmente uno degli edifici pi\u00f9 belli del paese e sicuramente uno dei monumenti da non perdere quando si visita Bruxelles. La sua splendida torre funge da punto di riferimento sia per i turisti che per i belgi di passaggio nel centro della capitale. \r\n\r\nUna festa per gli occhi \r\n\r\nParticolarmente imponente per le sue dimensioni, le sue stupende decorazioni scolpite e la sua facciata asimmetrica, cattura rapidamente l\u2019attenzione. Passeggiando davanti a tale edificio prestigioso, \u00e8 possibile scorgere sui balconi gli sposi novelli intenti a festeggiare il loro matrimonio. \r\n\r\nVale la pena visitare anche gli interni del municipio. Suscitano la curiosit\u00e0 di chi desidera scoprire la disposizione e l\u2019arredamento delle varie sale di questo capolavoro architettonico. Vengono periodicamente organizzate visite guidate al municipio di Bruxelles durante le quali \u00e8 possibile ammirare la ricchezza degli interni che non smettono mai di affascinare i visitatori. \r\n\r\nL\u2019evoluzione di un edificio eccezionale \r\n\r\nLa sua costruzione avviene nel corso di un lungo periodo di tempo e vede l\u2019avvicendarsi di vari architetti. In origine, l\u2019edificio comprendeva solo una torre campanaria e la parte sinistra, rimasta identica fino ai nostri giorni. La torre campanaria \u00e8 stata invece sostituita rapidamente dalla torre attuale quando le case delle varie corporazioni sono state trasferite nella piazza. \u00c8 stata peraltro aggiunta un\u2019altra ala sulla destra per accogliere al meglio tali edifici in questa cornice dalla bellezza incomparabile. \r\n\r\nIn cima alla nuova torre, alta pi\u00f9 di 90 m, la guglia \u00e8 coronata da San Michele arcangelo, santo patrono della citt\u00e0 di Bruxelles. Tale raffigurazione in rame dorato funge in realt\u00e0 da segnavento. Se il vento soffia nella direzione giusta, avrete modo di ammirare per bene l\u2019eroe della citt\u00e0 che sconfigge il drago! \r\n\r\nQuesto gioiello del patrimonio di Bruxelles ospita attualmente l\u2019ufficio del Turismo. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.bruxelles.be\/hotel-de-ville","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.bruxelles.be\/hotel-de-ville","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Parmi tous, l'H\u00f4tel de Ville de Bruxelles est sans conteste l'un des plus majestueux du pays\u202f! Cet \u00e9difice, b\u00e2ti au 15e si\u00e8cle en style gothique, est sublim\u00e9 par le d\u00e9cor qu\u2019offre la Grand-Place, souvent qualifi\u00e9e de plus belle au monde... Vous admirerez la justesse de ses proportions, les innombrables sculptures qui ornent ses fa\u00e7ades, ou encore l\u2019\u00e9clat incomparable de sa tour, dont la fl\u00e8che supporte l'archange saint Michel, protecteur de la ville. Bruxelles posa la premi\u00e8re pierre du somptueux \u00e9difice en 1401. En 1695, lors du bombardement de la ville par les troupes de Louis XIV, l'H\u00f4tel de Ville fut incendi\u00e9, mais les murs et la tour resteront debout. Ses salles de r\u00e9ceptions et cabinets \u00e9chevinaux renferment de belles tapisseries bruxelloises des XVI\u00e8me, XVII\u00e8me et XVIII\u00e8me si\u00e8cles, de somptueuses boiseries gothiques, \u00e9cussons des anciennes corporations et tableaux des collections du mus\u00e9e de la ville. \r\n ","description_print":"18\/07\/2022\r\n\u00c9l\u00e9gant b\u00e2timent datant du 15\u00e8me si\u00e8cle, l\u2019H\u00f4tel de Ville de Bruxelles se situe au c\u0153ur du centre historique, sur la somptueuse Grand-Place.\r\nSouvent consid\u00e9r\u00e9 comme la pi\u00e8ce ma\u00eetresse de la plus belle place du monde, il est probablement l\u2019un des plus beaux \u00e9difices du pays et \u00e9videmment l\u2019un des monuments \u00e0 ne pas manquer lors de votre s\u00e9jour \u00e0 Bruxelles. Sa splendide tour se dresse tel un rep\u00e8re aussi bien pour les curieux d\u2019un jour que les belges de passage dans le centre de la capitale.\r\nUn r\u00e9gal pour les yeux\r\nParticuli\u00e8rement imposant par ses dimensions, ses remarquables d\u00e9cors sculpt\u00e9s et sa fa\u00e7ade asym\u00e9trique, il attire rapidement les regards. En vous promenant devant ce prestigieux b\u00e2timent, peut-\u00eatre que vous apercevrez aux balcons de jeunes mari\u00e9s c\u00e9l\u00e9brer leur union.\r\nL\u2019int\u00e9rieur de l\u2019H\u00f4tel de Ville vaut \u00e9galement le d\u00e9tour. Il attise la curiosit\u00e9 de ceux qui souhaitent d\u00e9couvrir la disposition et l\u2019am\u00e9nagement des diff\u00e9rentes salles de ce chef-d\u2019\u0153uvre architectural. Des visites guid\u00e9es de l\u2019H\u00f4tel de Ville de Bruxelles sont r\u00e9guli\u00e8rement organis\u00e9es afin de d\u00e9couvrir la richesse de cet int\u00e9rieur qui ne cesse d\u2019\u00e9blouir les visiteurs.\r\nL\u2019\u00e9volution d\u2019un b\u00e2timent singulier\r\nSa construction s'\u00e9tale sur une longue p\u00e9riode et voit d\u00e9filer plusieurs architectes. \u00c0 l\u2019origine, l\u2019\u00e9difice ne comptait qu\u2019un beffroi et la partie gauche qui elle est rest\u00e9e identique jusqu\u2019\u00e0 aujourd\u2019hui. Le beffroi, quant \u00e0 lui, est par contre rapidement remplac\u00e9 par la tour actuelle lorsque les maisons des diff\u00e9rentes corporations de m\u00e9tiers s\u2019installent sur la place. Une aile suppl\u00e9mentaire est \u00e9galement ajout\u00e9e sur la droite pour inclure au mieux ces immeubles dans cet incomparable d\u00e9cor.\r\nAu sommet de la nouvelle tour, haute de plus de 90m, la fl\u00e8che est couronn\u00e9e de l\u2019archange Saint-Michel, grand Patron de la ville de Bruxelles. Cette statue en cuivre dor\u00e9 sert en r\u00e9alit\u00e9 de girouette. Si les vents vous sont favorables, vous aurez l\u2019occasion de pouvoir admirer convenablement la mani\u00e8re dont cet embl\u00e8me vient \u00e0 bout du dragon !\r\nActuellement, ce joyau du patrimoine bruxellois abrite l\u2019office du Tourisme.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Ayuntamiento de Bruselas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.bruxelles.be\/hotel-de-ville","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"El elegante edificio del siglo XV del ayuntamiento de Bruselas se encuentra en el coraz\u00f3n del centro hist\u00f3rico de la ciudad, en la suntuosa Grand-Place. \r\n\r\nConsiderado a menudo como la pieza clave de la plaza m\u00e1s bella del mundo es probablemente uno de los edificios m\u00e1s hermosos del pa\u00eds y evidentemente uno de los monumentos que no debes perderte en tu visita a Bruselas. Su espl\u00e9ndida torre se alza como punto de referencia, tanto para los visitantes del d\u00eda como para los belgas que pasan por el centro de la capital. \r\n\r\nUn regalo para la vista \r\n\r\nEste monumento, imponente por sus dimensiones, sus adornos esculpidos y su fachada asim\u00e9trica, llama r\u00e1pidamente la atenci\u00f3n de los transe\u00fantes. No es extra\u00f1o que al pasear delante de este prestigioso edificio veas en los balcones a alguna pareja de reci\u00e9n casados celebrando su enlace en los balcones. \r\n\r\nEl interior del ayuntamiento tambi\u00e9n merece una visita. Despierta la curiosidad de quienes desean descubrir la disposici\u00f3n y dise\u00f1o de las salas de esta obra maestra arquitect\u00f3nica. Se organizan con regularidad visitas guiadas al ayuntamiento para descubrir la riqueza de su interior que fascina a los visitantes. \r\n\r\nLa evoluci\u00f3n de un edificio singular \r\n\r\nSu construcci\u00f3n abarc\u00f3 un largo periodo y cont\u00f3 con la direcci\u00f3n de varios arquitectos. En un principio, el edificio \u00fanicamente contaba con un campanario y la parte izquierda que se ha conservado intacta hasta el d\u00eda de hoy. El campanario fue r\u00e1pidamente sustituido por la torre actual, cuando las casas de los diferentes gremios se instalaron en la plaza. Asimismo, se a\u00f1adi\u00f3 un ala adicional en la parte derecha para integrar mejor los nuevos edificios en este incomparable decorado. \r\n\r\nEn la cima de la nueva torre, de m\u00e1s de 90 m de altura, el arc\u00e1ngel San Miguel, patr\u00f3n de la ciudad de Bruselas, corona la aguja. Esta estatua de cobre dorado sirve de veleta. Si el viento sopla a su favor, tendr\u00e1s la ocasi\u00f3n de admirar de la mejor forma \u00a1c\u00f3mo San Miguel vence al drag\u00f3n! \r\n\r\nActualmente, esta joya del patrimonio bruselense alberga la oficina de turismo. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Stadhuis Brussel","address_street_name":"Grote Markt","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.brussel.be\/stadhuis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"Als je het ons vraagt, is het stadhuis van Brussel is een van de meest majestueuze van het land! Dit gebouw op de Grote Markt, een van de mooiste pleinen ter wereld, werd ontworpen in de 15e eeuw in gotische stijl. Ontelbare beeldhouwwerken sieren de gevels, en op de toren prijkt de aartsengel Sint-Michiel, de beschermer van de stad. Brussel legde de eerste steen van het weelderige gebouw in 1401. In 1695, tijdens een bombardement door de troepen van Lodewijk XIV, werd het stadhuis in brand gestoken, maar de muren en de toren bleven overeind. In de ontvangstzalen en de schepenkamers bevinden zich prachtige Brusselse wandtapijten uit de 16e, 17e en 18e eeuw, weelderig gotisch houtwerk, wapenschilden van de oude gilden en schilderijen uit de collecties van het stedelijk museum. ","description_print":"18\/07\/2022\r\nHet elegante stadhuis van Brussel dateert uit de 15de eeuw en ligt in het historische hart van de stad, op de prachtige Grote Markt. \r\n\r\nHet wordt vaak beschouwd als het absolute pronkstuk van het mooiste plein ter wereld en is wellicht een van de mooiste gebouwen van het land. Het is dan ook een niet te missen monument tijdens je bezoek aan Brussel. Zijn prachtige toren is een herkenningspunt voor zowel de dagjestoeristen als de Belgen die door het stadscentrum kuieren. \r\nEen lust voor het oog \r\nNiet alleen de indrukwekkende afmetingen van het gebouw, maar ook de opmerkelijke gebeeldhouwde ornamenten en de asymmetrische gevel trekken meteen de aandacht. En terwijl je dit prestigieuze gebouw voorbij wandelt, word je misschien toegewuifd door een pasgetrouwd stel op het balkon ... \r\nHet interieur van het stadhuis is eveneens een omweg waard. Wie wil, kan een blik werpen op de indeling en de inrichting van de verschillende zalen van dit architecturale meesterwerk. Er worden regelmatig rondleidingen in het Brussels stadhuis georganiseerd om de rijkdom van het interieur aan de bezoekers te tonen. \r\nEvolutie van een uniek gebouw \r\nHet gebouw werd over een lange periode ontworpen door verschillende architecten. Oorspronkelijk bestond het enkel uit een belfort en het linkerdeel, dat ongewijzigd is gebleven. Het belfort daarentegen werd al snel vervangen door de huidige toren, toen de huizen van de verschillende gilden zich op de grote markt begonnen te vestigen. Aan de rechterkant werd een extra vleugel bijgebouwd, om deze gebouwen beter in dit unieke decor op te nemen. \r\nBovenaan de meer dan 90 meter hoge, nieuwe toren, werd de torenspits bekroond met aartsengel Micha\u00ebl, de beschermheilige van de stad Brussel. Het standbeeld in verguld koper doet in werkelijkheid dienst als windwijzer. Bij gunstige wind kan je zelfs zien hoe dit embleem de draak velt! \r\nMomenteel is de toeristische dienst ondergebracht in dit pronkstuk van het Brusselse erfgoed. ","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":112,"location":{"lat":50.8466937,"lon":4.35252339},"region":"brussels","last_updated_at":"2023-03-23T10:42:26+01:00","published_at":"2013-10-19T01:13:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":251434,"translations":{"de":{"name":"Brussels Major Events - BME","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bru