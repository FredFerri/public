\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001777"},"it":{"name":"Dimanche \u00e0 v\u00e9lo - Brusselse menhirs, Zoni\u00ebnwoud","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-velo\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001777"},"cn":{"name":"Dimanche \u00e0 v\u00e9lo - Brusselse menhirs, Zoni\u00ebnwoud","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-velo\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001777"},"fr":{"name":"Dimanche \u00e0 v\u00e9lo - Brusselse menhirs, Zoni\u00ebnwoud","shortdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. Une agr\u00e9able promenade \u00e0 v\u00e9lo, une excellente dose de mouvement et l'id\u00e9al pour rencontrer d'autres Bruxellois \u00e0 v\u00e9lo et d\u00e9couvrir de nouveaux endroits ! ","longdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. Une balade \u00e0 v\u00e9lo agr\u00e9able, une excellente dose de mouvement et id\u00e9ale pour rencontrer d'autres Bruxellois ! Une balade \u00e0 v\u00e9lo qui nous emm\u00e8ne \u00e0 la for\u00eat de Soignes \u00e0 la d\u00e9couverte des menhirs de Bruxelles (+\/- 16km aller). Nous arrivons vers midi. Nous apportons quelque chose \u00e0 boire. N'h\u00e9sites pas \u00e0 apporter votre petit pique-nique!\n\nD\u00e9part \u00e0 10:00 au Grand Hospice\nGratuit - Inscriptions: info@cactus.brussels \n","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-velo\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001777"},"sp":{"name":"Dimanche \u00e0 v\u00e9lo - Brusselse menhirs, Zoni\u00ebnwoud","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-velo\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001777"},"nl":{"name":"Dimanche \u00e0 v\u00e9lo - Brusselse menhirs, Zoni\u00ebnwoud","shortdescr":"Geniet mee van de nog stille ontwakende stad op zondagochtend.  Een gezellige fietstocht, een gezonde dosis beweging en ideaal om andere Brusselaars te ontmoeten en nieuwe plekken te ontdekken met de fiets!","longdescr":"Geniet van het stille ontwaken van de stad op zondagochtend. Een aangename fietstocht, een goede dosis beweging, ideaal om andere Brusselaars te ontmoeten en nieuwe plekken te ontdekken met de fiets! \n\nDe fietstocht leidt ons naar het Zoni\u00ebnwoud. We ontdekken er het verhaal achter de Brusselse Menhirs (+\/- 16 km heen). We komen rond het middaguur aan op onze bestemming waar we ook even pauzeren alvorens terug te keren. We voorzien iets om te drinken. Aarzel niet om je eigen picknick meebrengen!\n\nVertrek 10:00 aan de Grand Hospice\nGratis | Inschrijven: Info@cactus.brussels","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-velo\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001777"}},"place":{"id":277608,"translations":{"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo is an association of local volunteer guides with a passion for Brussels and cycling. They enthusiastically share their passion for the city and cycling with visitors to Brussels and other Brussels residents. On their bikes they find the right pace to immerse you in the city and offer an authentic Brussels experience. Above all, they prefer to guide you off the beaten track in a friendly atmosphere. Experience Brussels in all its splendour by bike and discover more than you think.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","