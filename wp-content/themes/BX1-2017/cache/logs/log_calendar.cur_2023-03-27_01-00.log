 arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Le monde invisible","shortdescr":null,"longdescr":"L\u2019imaginaire est et \u00e0 toujours \u00e9t\u00e9, depuis le d\u00e9but des temps et au-del\u00e0 des instants\u2026 Encr\u00e9 en chaque \u00eatre vivants\u2026tatou\u00e9 dans l\u2019antre du c\u0153ur de chaque enfant\u2026 La cr\u00e9ation est inn\u00e9 en vous\u2026vous \u00eates dot\u00e9 par le pouvoir de la pens\u00e9e, d\u2019engendrer \u00e0 partir de rien une multitudes de tout\u2026 Croyez toujours en vous, ayez foi en vos capacit\u00e9s\u2026ne dout\u00e9 point car l\u2019infinit\u00e9\u2026c\u2019est vous. - Jabien Lionthiel \r\n\r\n\r\nVernissage: jeudi 16.03.2023 de 18:00 jusqu'\u00e0 21:00\r\nL'expo se d\u00e9roule de 16.03.2023 jusqu'\u00e0 17.04.2023\r\nEntr\u00e9e libre, ouvert de lundi jusqu'\u00e0 vendredi, 09:30-17:00\r\nFerm\u00e9 pendant le weekend et les jours f\u00e9riers.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552127"},"nl":{"name":"The invisible world","shortdescr":null,"longdescr":"Het denkbeeldige was er altijd al, sinds het begin der tijden. Geijkt in elk levend wezen, geschreven in het hart van elk kind. Het potentieel zit in ons, de kracht van de gedachte, de capaciteit om uit het niets een veelheid van alles te genereren. Geloof daarom altijd in jezelf, heb vertrouwen in je kunnen, twijfel niet tot in het oneindige... jij bent het. \u2013 Jabien Lionthiel\r\n\r\n\r\nVernissage: donderdag 16.03.2023 van 18:00 tot 21:00\r\nExpo loopt van 16.03.2023 tot 17.04.2023\r\nVrije toegang, open van ma tot vrij 09:30-17:00\r\nGesloten in het weekend en op feestdagen.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552127"},"en":{"name":"Le monde invisible","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552127"},"de":{"name":"The invisible world","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552127"},"it":{"name":"The invisible world","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552127"},"sp":{"name":"The invisible world","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552127"},"pt":{"name":"The invisible world","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552127"},"cn":{"name":"The invisible world","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552127"}},"place":{"id":3232,"translations":{"fr":{"name":"Zinnema","address_street_name":"Rue de Veeweyde","address_street_number":"24 26","address_street_box":null,"email":"info@zinnema.be","website":"http:\/\/www.zinnema.be","phone_contact":"+32 2 555 06 00","phone_booking":"+32 2 555 06 00","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Veeweyde, 24 26","address_line2":"1070 Anderlecht","description_web":"Zinnema, Maison Ouverte aux Talents \u00e0 Bruxelles, soutient, d\u00e9veloppe et fait conna\u00eetre des projets d\u2019individus et groupes qui donnent libre cours \u00e0 leur imagination dans l\u2019une ou l\u2019autre discipline artistique \u00e0 Bruxelles ou son environnement.  Cela se passe bottom-up, par des initiatives propres, des workshops ou par leur travail de soutien.\r\nPersuad\u00e9s de l\u2019importance et de la force de l\u2019ouverture, la diversit\u00e9, l\u2019encadrement professionnel, la co\u00f6p\u00e9ration et la qualit\u00e9, Zinnema appr\u00e9cie les artistes et encourage en m\u00eame temps le renouvellement et l\u2019exp\u00e9rimentation dans le laboratoire urbain dynamique qui s\u2019appelle Bruxelles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Zinnema","address_street_name":"Veeweidestraat","address_street_number":"24 26","address_street_box":null,"email":"info@zinnema.be","website":"http:\/\/www.zinnema.be","phone_contact":"+32 2 555 06 00","phone_booking":"+32 2 555 06 00","address_zip":"1070","address_city":"Anderlecht","address_line1":"Veeweidestraat, 24 26","address_line2":"1070 Anderlecht","description_web":"Zinnema, Open Talentenhuis in Brussel, ondersteunt, promoot en ontwikkelt projecten van individuen en groepen die in Brussel of de Rand in hun vrije tijd uiting geven aan hun verbeelding in \u00e9\u00e9n of andere artistieke discipline. Dit gebeurt bottom-up, via eigen initiatieven, workshops en de ondersteunende werking. Overtuigd van het belang en de kracht van openheid, diversiteit, professionele omkadering, samenwerking en kwaliteit koestert Zinnema artiesten, en moedigt tegelijkertijd vernieuwing en experiment aan in het dynamische stadslaboratorium dat Brussel heet.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Zinnema","address_street_name":"Rue de Veeweyde","address_street_number":"24 26","address_street_box":null,"email":"info@zinnema.be","website":"http:\/\/www.zinnema.be","phone_contact":"+32 2 555 06 00","phone_booking":"+32 2 555 06 00","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Veeweyde, 24 26","address_line2":"1070 Anderlecht","description_web":"Zinnema\u2019s doors are wide open for amateur artists looking to flourish within the rich and diverse atmosphere of a big city. Zinnema is an Open Talents House that encourages artists to explore their inner most selves and find inspiration in both familiar and unfamiliar places. It is a professional home for projects, but also a platform for support and collaboration.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Zinnema","address_street_name":"Rue de Veeweyde","address_street_number":"24 26","address_street_box":null,"email":"info@zinnema.be","website":"http:\/\/www.zinnema.be","phone_contact":"+32 2 555 06 00","phone_booking":"+32 2 555 06 00","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Veeweyde, 24 26","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Zinnema","address_street_name":"Rue de Veeweyde","address_street_number":"24 26","address_street_box":null,"email":"info@zinnema.be","website":"http:\/\/www.zinnema.be","phone_contact":"+32 2 555 06 00","phone_booking":"+32 2 555 06 00","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Veeweyde, 24 26","address_line2":"1070 And