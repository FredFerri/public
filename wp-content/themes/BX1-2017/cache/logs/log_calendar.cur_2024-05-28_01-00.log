l,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{}},"translations":{"de":{"name":"\"Antigraffitisme\" : Rencontre avec l'auteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010423"},"pt":{"name":"\"Antigraffitisme\" : Rencontre avec l'auteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010423"},"en":{"name":"\"Antigraffitisme\" : Rencontre avec l'auteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010423"},"it":{"name":"\"Antigraffitisme\" : Rencontre avec l'auteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010423"},"cn":{"name":"\"Antigraffitisme\" : Rencontre avec l'auteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010423"},"fr":{"name":"\"Antigraffitisme\" et \"Vigilante Vigilante\"","shortdescr":"Pr\u00e9sentation du livre \"Antigraffitisme\" par un de ses auteurs, Timoth\u00e9e Engasser.\nProjection du documentaire \"Vigilante Vigilante\"","longdescr":"- Pr\u00e9sentation du livre \"Antigraffitisme\" par un de ses auteurs, Timoth\u00e9e Engasser.\n\n\"Alors que le street art se monnaie dans les galeries d\u2019art, dans les rues, les graffitis sont la cible d\u2019une lutte acharn\u00e9e. Tous les ans, ce sont plusieurs milliards d\u2019euros qui sont investis au niveau mondial dans des syst\u00e8mes de s\u00e9curit\u00e9, de nettoyage et de pr\u00e9vention. Graffeurs eux-m\u00eames, les auteurs ont ainsi vu leurs inscriptions dispara\u00eetre de plus en plus rapidement. Leur regard s\u2019est alors d\u00e9cal\u00e9 du graffiti \u00e0 son effacement.\nDe l\u2019av\u00e8nement au XVIIIe si\u00e8cle de l\u2019hygi\u00e9nisme \u00e0 la mise en place d\u2019un v\u00e9ritable march\u00e9 s\u00e9curitaire \u00e0 partir des ann\u00e9es 1980, les auteurs retracent l\u2019histoire de la r\u00e9pression de ce geste d\u2019apparence anodine. Ils cherchent ainsi \u00e0 comprendre ce qui se joue dans la gouvernance des espaces urbains contemporains et alertent sur ces effacements, signes avant-coureurs de logiques de contr\u00f4le bien plus insidieuses, qui ne concernent plus seulement celles et ceux qui \u00e9crivent dans la ville.\"\n\nAntigraffitisme de Jean-Baptiste Barra et  Timoth\u00e9e Engasser\n160 pages, Ed. Le passager clandestin, 2023\n\n- Projection du documentaire \u00ab\u00a0Vigilante Vigilante\u00a0\u00bb de Max Good \n\n87', 2011, VOSTFR\n\nUne nouvelle sorte de combattants du crime hante le paysage urbain : le justicier anti-graffiti. Ces guerriers d'un genre particulier ne reculent devant rien pour d\u00e9barrasser leur quartier et les villes des graffitis, autocollants et autres affiches. \n\nBande annonce\u00a0: https:\/\/www.youtube.com\/watch?v=lP_Ah7vnXZk\n\n\u200b\n\n","performers":"Timoth\u00e9e Engasser, auteur du livre \"Antigraffitisme\"\nCaroline Vercruysse, Fais le trottoir ASBL","boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010423"},"sp":{"name":"\"Antigraffitisme\" : Rencontre avec l'auteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010423"},"nl":{"name":"\"Antigraffitisme\" : Rencontre avec l'auteur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010423"}},"place":{"last_updated_at":"2023-09-20T11:39:47+02:00","published_at":"2020-10-07T10:42:32+02:00","id":276067,"translations":{"de":{"name":"Pianofabriek","address_street_name":"Rue du Fort","address_street_number":"35","address_street_box":null,"email":"info@pianofabriek.be","website":"http:\/\/www.pianofabriek.be","phone_contact":"+32 2 541 01 70","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 35","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Pianofabriek","address_street_name":"Rue du Fort","address_street_number":"35","address_street_box":null,"email":"info@pianofabriek.be","website":"http:\/\/www.pianofabriek.be","phone_contact":"+32 2 541 01 70","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 35","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"GC Pianofabriek","address