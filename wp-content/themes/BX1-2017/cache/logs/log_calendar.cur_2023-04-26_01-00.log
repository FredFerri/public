"Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":31867,"location":{"lat":50.84784818,"lon":4.33940704},"region":"brussels","last_updated_at":"2023-04-25T03:06:05+02:00","published_at":"2018-09-06T10:33:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":271867,"translations":{"fr":{"name":"Tour \u00e0 Plomb Centre Culturel et Sportif","address_street_name":"rue de l'Abattoir","address_street_number":"20-26","address_street_box":null,"email":"touraplomb@brucity.be","website":"https:\/\/touraplomb.be\/","phone_contact":"+32 2 279 59 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de l'Abattoir, 20-26","address_line2":"1000 Bruxelles","description_web":"Le Centre Tour \u00e0 Plomb est un centre de proximit\u00e9, du Service de la Jeunesse de la Ville de Bruxelles, d\u00e9di\u00e9 aux diverses formes de r\u00e9flexions, d\u2019expressions et de cr\u00e9ation, qu\u2019elles soient culturelles, socioculturelles, artistiques ou sportives. En tant qu\u2019infrastructure de proximit\u00e9, le Centre Tour \u00e0 Plomb est mis prioritairement \u00e0 la disposition des bruxellois et plus sp\u00e9cifiquement des habitants et des groupes structur\u00e9s (associations sans but lucratif, services et institutions publics, \u2026) du quartier Jardin aux Fleurs.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Hageltoren Sport- en Cultureel Centrum","address_street_name":"Slachthuisstraat","address_street_number":"20-26","address_street_box":null,"email":"touraplomb@brucity.be","website":"https:\/\/touraplomb.be\/","phone_contact":"+32 2 279 59 10","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Slachthuisstraat, 20-26","address_line2":"1000 Brussel","description_web":"Het Centrum Hageltoren is een buurtcentrum van de Jeugddienst van de Stad Brussel, dat bestemd is voor verschillende vormen van reflectie, expressie en creatie, of het nu gaat om culturele, sociaal-culturele, artistieke of sportieve activiteiten. Als wijkinfrastructuur staat de Hageltoren in de eerste plaats ter beschikking van de Brusselaars en meer bepaald van de inwoners en de georganiseerde groepen (verenigingen zonder winstoogmerk, openbare diensten en instellingen...) van de Bloemenhofwijk.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Culturel et Sportif Tour \u00e0 Plomb","address_street_name":"rue de l'Abattoir","address_street_number":"20-26","address_street_box":null,"email":"touraplomb@brucity.be","website":"https:\/\/touraplomb.be\/","phone_contact":"+32 2 279 59 10","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de l'Abattoir, 20-26","address_line2":"1000 Brussels","description_web":"The Tour \u00e0 Plomb Center is a neighborhood center of the Youth Service of the City of Brussels, dedicated to various forms of reflection, expression and creation, whether cultural, socio-cultural, artistic or sporting. As a neighborhood infrastructure, the Tour \u00e0 Plomb is first and foremost available to the residents of Brussels and more specifically to the residents and organized groups (non-profit associations, public services and institutions...) of the Jardin aux Fleurs neighborhood.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Culturel et Sportif Tour \u00e0 Plomb","address_street_name":"rue de l'Abattoir","address_street_number":"20-26","address_street_box":null,"email":"touraplomb@brucity.be","website":"https:\/\/touraplomb.be\/","phone_contact":"+32 2 279 59 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de l'Abattoir, 20-26","address_line2":"1