026 c\u2019est qui la plus grande des deux ? C\u2019est moi !\n\nGrandir, oui mais comment ? Oui mais pour quoi ?\nQu\u2019est-ce qu\u2019on vaut ? Qu\u2019est-ce qu\u2019on doit ?\nFaut-il suivre les r\u00e8gles ?\nQu\u2019est-ce que je ressens et que je ne m'autorise pas ?\nQuelle place notre soci\u00e9t\u00e9 donne-t-elle \u00e0 l'enfance ?\nComment grandir et rester soi ?","performers":"Interpr\u00e9tation Zo\u00e9 Coutentin, Gwladys Lefeuvre, Pierre Decuypere. Conception Isabelle Verlaine avec l'aide de Alice Verlaine Corbion\u200b. \u00c9criture Isabelle Verlaine; Alice Verlaine Corbion et les improvisations de Zo\u00e9 Coutentin, Gwladys Lefeuvre et Pierre Decuypere.\u200b Mise en sc\u00e8ne \u200bIsabelle Verlaine. ","boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/adieu-mochi","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003043"},"sp":{"name":"Adieu Mochi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/adieu-mochi","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003043"},"nl":{"name":"Adieu Mochi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/adieu-mochi","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003043"}},"place":{"id":231528,"translations":{"de":{"name":"La Roseraie","address_street_name":"Chauss\u00e9e d'Alsemberg","address_street_number":"1299","address_street_box":null,"email":"secretariat@roseraie.org","website":"http:\/\/www.roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","address_zip":"1180","address_city":"Uc