ess_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"La Zinne, c\u2019est aussi et surtout une exp\u00e9rience citoyenne : un ensemble d\u2019objectifs, de valeurs et de crit\u00e8res, qui mat\u00e9rialise dans de jolis billets color\u00e9s la volont\u00e9 de faire vivre la Bruxelles que l\u2019on aime.\n\nL\u00e9galement, une monnaie locale compl\u00e9mentaire \u00e0 l\u2019euro est reconnue comme \u00ab bon de soutien \u00e0 l\u2019\u00e9conomie locale \u00bb, en R\u00e9gion bruxelloise. C\u2019est pour la g\u00e9rer et la faire grandir que la structure Zinne ASBL a \u00e9t\u00e9 cr\u00e9\u00e9e en 2019.\n\nNos missions principales, en tant qu\u2019ASBL, sont de veiller au respect de la charte de valeurs et aux objectifs du projet, promouvoir l\u2019utilisation des Zinnes en s\u2019activant pour \u00e9largir en permanence le r\u00e9seau o\u00f9 il est possible de les d\u00e9penser, travailler sur les fili\u00e8res professionnelles (fournisseurs, prestataires de services, etc.), afin qu\u2019une Zinne puisse circuler toujours plus longtemps au sein de notre \u00e9conomie locale","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Zinne","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussel","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":42112,"location":{"lat":50.8535147,"lon":4.3501198},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"last_updated_at":"2024-05-03T17:35:37+02:00","published_at":"2024-03-20T11:02:48+01:00","id":50001368,"translations":{"de":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"in