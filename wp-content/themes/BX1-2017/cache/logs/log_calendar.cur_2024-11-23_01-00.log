"backoffice_id":306115,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"BxlSurSc\u00e8nes \u2013 Duo George Van Dam, violin, & Daan Vandewalle, piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ateliermarcelhastir.eu\/agenda\/2024-11-30-duo-george-van-dam-violon-daan-vandewalle-piano\/","email":"ateliermarcelhastir@gmail.com","phone_contact":"+32 498 16 32 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000306"},"pt":{"name":"BxlSurSc\u00e8nes \u2013 Duo George Van Dam, violin, & Daan Vandewalle, piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ateliermarcelhastir.eu\/agenda\/2024-11-30-duo-george-van-dam-violon-daan-vandewalle-piano\/","email":"ateliermarcelhastir@gmail.com","phone_contact":"+32 498 16 32 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000306"},"en":{"name":"BxlSurSc\u00e8nes \u2013 Duo George Van Dam, violin, & Daan Vandewalle, piano","shortdescr":null,"longdescr":"George Alexander van Dam, violin :\n\nNamibian-born violinist George Alexander van Dam has been a dedicated performer of contemporary music since the beginning of his career. \nHe has worked with some of today's foremost composers - Ad\u00e8s, Aperghis, Benjamin, Chin, E\u00f6tvos, Francesconi, Goeyvaerts, Harvey, Hosokawa, Kagel, Kurt\u00e0g, Ligeti, Mamiya, Reich, Saariaho, Stockhausen and Joji Yuasa, among others - as a soloist or as part of contemporary music ensembles such as Ensemble Modern Frankfurt, MusikFabrik and Ictus, of which he is a founding member. Thanks to close collaboration with the younger generation of composers - Cassol, De Mey, Harada, Hus, Vermeersch and others - several new works have been written especially for him, such as Mochizuki's Homeobox, which was premiered with the Junge Deutsche Philharmonie. He takes master classes with Dorothy DeLay, Z. Gilels, A. Markov, A. Rosand and Rainer Kussmaul, and studied at the Brussels Conservatoire with Georges Octors and Arie van Lysebeth. In 2012, he returned to the harpsichord - with Robert Kohnen - to rekindle his childhood fascination with early keyboard music. His own work as a composer includes chamber music, the Engel-Lieder song cycles for James Bowman, Lorca Songs, Melanchotopia Songs (improvisations with Claron McFadden) for Witte de With, Rotterdam 2011, a violin concerto with timbila orchestra for Drumming Grupo Percuss\u00e3o. Porto, music for film (silent), theatre and dance performances - Ballet de Marseille, Needcompany, Ultima Vez and others - and collaborates with visual artists such as Manon de Boer, Angela Bulloch, Trudo Engels and Ana Torfs.\n\nhttps:\/\/georgevandam.com\/about\/\n\nDaan Vandewalle, piano:\n\nPianist Daan Vandewalle is an internationally renowned interpreter of piano music of the 20th and 21st centuries. His repertoire includes hundreds of pieces including works by some of the 20th century's best-known composers. He maintains very close collaborations with contemporary composers, allowing him to present numerous premieres.  He has performed on a wide variety of stages, from the small clubs of the underground experimental music scene to established venues such as the Prague Spring Festival (Elliott Carter's Dialogues), New York's Lincoln Center and Th\u00e9\u00e2tre du Ch\u00e2telet in Paris. Special projects include his lifelong collaboration with American composer Alvin Curran that resulted in a series of marathon 6-hour performances of the piano cycle Inner Cities. \nHe is one of the only pianists in the world to perform Keikhosru Sorabji's entire Opus Clavicembalisticum and Clarence Barlow's highly complex \u00c7o\u011fluotob\u00fcsi\u015fletmesi. Since 2001, he has taught piano at the Royal Conservatory in Ghent. In 2013, he performed Ligeti's Piano Concerto at Carnegie Hall in New York and at the Spring Festival in Prague. In March 2015, he was the solo pianist at the world premiere of Fr\u00e9d\u00e9ric Rzewski's Piano Concerto with the ASKO\/Sch\u00f6nberg Ensemble and Peter Rundel. A long-time soloist at the Ostrava Days, he has performed major works from the 20th and 21st centuries at the festival - in this context, his performance of Rzewski's masterpiece The People United Will Never Be Defeated was an unforgettable experience. He will perform this and other compositions by Rzewski in a concert at Prague's DOX+ on 21 November 2023.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/ateliermarcelhastir.eu\/agenda\/2024-11-30-duo-george-van-dam-violon-daan-vandewalle-piano\/","email":"ateliermarcelhastir@gmail.com","phone_contact":"+32 498 16 32 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000306"},"it":{"name":"BxlSurSc\u00e8nes \u2013 Duo George Van Dam, violin, & Daan Vandewalle, piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ateliermarcelhastir.eu\/agenda\/2024-11-30-duo-george-van-dam-violon-daan-vandewalle-piano\/","email":"ateliermarcelhastir@gmail.com","phone_contact":"+32 498 16 32 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000306"},"cn":{"name":"BxlSurSc\u00e8nes \u2013 Duo George Van Dam, violin, & Daan Vandewalle, piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ateliermarcelhastir.eu\/agenda\/2024-11-30-duo-george-van-dam-violon-daan-vandewalle-piano\/","email":"ateliermarcelhastir@gmail.com","phone_contact":"+32 498 16 32 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000306"},"fr":{"name":"BxlSurSc\u00e8nes \u2013 Duo George Van Dam, violon, & Daan Vandewalle, piano","shortdescr":"Programme :\n \nArnold Schoenberg \u2013 Fantaise pour  violon et piano, Op. 47 (1949) 9\u2032\nIgor Stravinsky \u2013  Duo Concertante pour  violon et piano (1932) 16\u2032\nFrederic Rzewski \u2013  Nanosonata (2008) 6\u2032\n\u2013 \u2013 \u2013 \u2013 \u2013 \u2013 \u2013 \u2013 \u2013 \u2013\nAnton Webern  \u2013 Vier St\u00fccke poir violon et piano Op. 7 5\u2032\nGeorge Antheil  \u2013  Sonate pur violon  No. 1 (1923) 24\u2032","longdescr":"George Alexander van Dam, violon. Le violoniste d\u2019origine namibienne George Alexander van Dam est un interpr\u00e8te engag\u00e9 de musique contemporaine depuis le d\u00e9but de sa carri\u00e8re. Il a travaill\u00e9 avec les plus grands compositeurs actuels : Ad\u00e8s, Aperghis, Benjamin, Chin, E\u00f6tvos, Francesconi, Goeyvaerts, Harvey, Hosokawa, Kagel, Kurt\u00e0g, Ligeti, Mamiya, Reich, Saariaho, Stockhausen, Joji Yuasa, entre autres \u2013, en tant que soliste ou dans le cadre d\u2019ensembles de musique contemporaine tels que l\u2019Ensemble Modern Frankfurt, MusikFabrik ou Ictus, dont il est membre fondateur. Gr\u00e2ce \u00e0 une \u00e9troite\ncollaboration avec la jeune g\u00e9n\u00e9ration de compositeurs : Cassol, De Mey, Harada,\nHus, Vermeersch et d\u2019autres \u2013, plusieurs nouvelles \u0153uvres ont \u00e9t\u00e9 \u00e9crites sp\u00e9cialement pour lui, par ex. Homeobox de Mochizuki, cr\u00e9\u00e9 avec la Junge Deutsche Philharmonie. Il suit des master classes avec Dorothy DeLay, Z. Gilels, A. Markov, A. Rosand, Rainer Kussmaul et \u00e9tudie au Conservatoire de Bruxelles avec Georges Octors et Arie van Lysebeth. En 2012, il reprend l\u2019\u00e9tude du clavecin \u2013 avec Robert\nKohnen \u2013 ravivant sa fascination d\u2019enfance pour la musique ancienne pour clavier. Son propre travail en tant que compositeur comprend de la musique de chambre, les cycles de chansons Engel-Lieder pour James Bowman, Lorca Songs, Melanchotopia Songs (improvisations avec Claron McFadden) pour Witte de With, Rotterdam 2011, un concerto pour violon avec orchestre de timbila pour Drumming Grupo Percuss\u00e3o. Porto, musique pour film (muet), pour spectacles de th\u00e9\u00e2tre et de danse \u2013 Ballet de\nMarseille, Needcompany, Ultima Vez i.a. \u2013 et travaille avec des artistes plasticiens tels que Manon de Boer, Angela Bulloch, Trudo Engels et Ana Torfs.\n\nDaan Vandewalle, piano. Le pianiste Daan Vandewalle est un interpr\u00e8te de renomm\u00e9e internationale de la\nmusique pour piano des 20e et 21e si\u00e8cles. Son r\u00e9pertoire comprend des centaines de pi\u00e8ces dont des \u0153uvres de plusieurs des compositeurs les plus connus du XXe si\u00e8cle. Il entretient des collaborations tr\u00e8s \u00e9troites avec des compositeurs contemporains, ce qui lui permet de pr\u00e9senter de nombreuses premi\u00e8res. Il s\u2019est produit dans des salles tr\u00e8s diverses, depuis les petits clubs de la sc\u00e8ne musicale exp\u00e9rimentale underground jusqu\u2019aux lieux bien \u00e9tablis comme le festival du Printemps de Prague (Elliott Carter\u2019s Dialogues), le Lincoln Center de New York et le Th\u00e9\u00e2tre du Ch\u00e2telet \u00e0 Paris. Les projets sp\u00e9ciaux incluent sa collaboration de toute une vie avec le compositeur am\u00e9ricain Alvin Curran qui a abouti \u00e0 une s\u00e9rie de\nperformances marathon de 6 heures du cycle pour piano Inner Cities. Il est l\u2019un des seuls pianistes au monde \u00e0 jouer l\u2019int\u00e9gralit\u00e9 de l\u2019Opus Clavicembalisticum de Keikhosru Sorabji et le extr\u00eamement complexe \u00c7o\u011fluotob\u00fcsi\u015fletmesi de Clarence Barlow. Depuis 2001, il enseigne le piano au Conservatoire Royal de Gand. En 2013, il joue le Concerto pour piano de Ligeti au Carnegie Hall de New York et au festival du Printemps de Prague. En mars 2015, il \u00e9tait le pianiste soliste de la premi\u00e8re mondiale du Concerto pour piano de Fr\u00e9d\u00e9ric Rzewski avec l\u2019ASKO\/Sch\u00f6nberg Ensemble et Peter Rundel. Il est soliste de longue date aux Journ\u00e9es d\u2019Ostrava et il a interpr\u00e9t\u00e9 des \u0153uvres majeures des XXe et XXIe si\u00e8cles dans le cadre du festival \u2013 \u00e0 cet \u00e9gard, son interpr\u00e9tation du chef-d\u2019\u0153uvre de Rzewski, The People United Will Never Be Defeated, a \u00e9t\u00e9 une exp\u00e9rience inoubliable. Il jouera cette composition ainsi\nque d\u2019autres compositions de Rzewski lors d\u2019un concert le 21 novembre 2023 au DOX+ de Prague.\n\n ","performers":null,"boxoffice_url":null,"website":"https:\/\/ateliermarcelhastir.eu\/agenda\/2024-11-30-duo-george-van-dam-violon-daan-vandewalle-piano\/","email":"ateliermarcelhastir@gmail.com","phone_contact":"+32 498 16 32 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000306"},"sp":{"name":"BxlSurSc\u00e8nes \u2013 Duo George Van Dam, violin, & Daan Vandewalle, piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ateliermarcelhastir.eu\/agenda\/2024-11-30-duo-george-van-dam-violon-daan-vandewalle-piano\/","email":"ateliermarcelhastir@gmail.com","phone_contact":"+32 498 16 32 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000306"},"nl":{"name":"BxlSurSc\u00e8nes \u2013 Duo George Van Dam, viool, & Daan Vandewalle, piano","shortdescr":null,"longdescr":"George Alexander van Dam, viool :\n\nDe in Namibi\u00eb geboren violist George Alexander van Dam is sinds het begin van zijn carri\u00e8re een toegewijd uitvoerder van hedendaagse muziek. \nHij heeft gewerkt met een aantal van de meest vooraanstaande componisten van vandaag - Ad\u00e8s, Aperghis, Benjamin, Chin, E\u00f6tvos, Francesconi, Goeyvaerts, Harvey, Hosokawa, Kagel, Kurt\u00e0g, Ligeti, Mamiya, Reich, Saariaho, Stockhausen en Joji Yuasa, onder anderen - als solist of als onderdeel van hedendaagse muziek ensembles zoals Ensemble Modern Frankfurt, MusikFabrik en Ictus, waarvan hij een van de oprichters is. Dankzij nauwe samenwerking met de jongere generatie componisten - Cassol, De Mey, Harada, Hus, Vermeersch en anderen - zijn er verschillende nieuwe werken speciaal voor hem geschreven, zoals Mochizuki's Homeobox, dat in premi\u00e8re ging met de Junge Deutsche Philharmonie. Hij volgt masterclasses bij Dorothy DeLay, Z. Gilels, A. Markov, A. Rosand en Rainer Kussmaul, en studeert aan het Conservatorium van Brussel bij Georges Octors en Arie van Lysebeth. In 2012 keerde hij terug naar het klavecimbel - bij Robert Kohnen - om zijn jeugdfascinatie voor oude klaviermuziek weer op te rakelen. Zijn eigen werk als componist omvat kamermuziek, de Engel-Lieder liederencycli voor James Bowman, Lorca Songs, Melanchotopia Songs (improvisaties met Claron McFadden) voor Witte de With, Rotterdam 2011, een vioolconcert met timbila-orkest voor Drumming Grupo Percuss\u00e3o. Porto, muziek voor film (silent), theater- en dansvoorstellingen - Ballet de Marseille, Needcompany, Ultima Vez e.a. - en werkt samen met beeldend kunstenaars als Manon de Boer, Angela Bulloch, Trudo Engels en Ana Torfs.\n\nhttps:\/\/georgevandam.com\/about\/\n\nDaan Vandewalle, piano:\n\nPianist Daan Vandewalle is een internationaal gerenommeerd vertolker van \npianomuziek van de 20e en 21e eeuw. Zijn repertoire omvat honderden stukken\nwaaronder werken van enkele van de bekendste componisten uit de 20e eeuw.\nHij onderhoudt zeer nauwe samenwerkingsverbanden met hedendaagse \ncomponisten, waardoor hij talrijke premi\u00e8res kon presenteren. \nHij heeft opgetreden op de meest uiteenlopende podia, van de kleine clubs van de underground experimentele muziekscene tot gevestigde podia zoals het Praagse Lentefestival \n(Elliott Carter's Dialogues), New York's Lincoln Center en Th\u00e9\u00e2tre du Ch\u00e2telet in Parijs. Speciale projecten zijn onder andere zijn levenslange samenwerking met de Amerikaanse componist Alvin Curran die resulteerde in een serie van marathonuitvoeringen van 6 uur van de pianocyclus Inner Cities. \nHij is een van de enige pianisten ter wereld die het gehele Opus Clavicembalisticum van \nKeikhosru Sorabji en de uiterst complexe \u00c7o\u011fluotob\u00fcsi\u015fletmesi van Clarence Barlow. Sinds 2001 doceert hij piano aan het Koninklijk Conservatorium in Gent. In 2013 voerde hij Ligeti's Pianoconcert uit in de Carnegie Hall in New York en op het Lentefestival in Praag. In maart 2015 was hij de solopianist bij de wereldpremi\u00e8re van het Pianoconcerto van Fr\u00e9d\u00e9ric Rzewski met het ASKO\/Sch\u00f6nberg Ensemble en Peter Rundel. Hij is al lange tijd solist bij de Ostrava Days en heeft op het festival grote werken uit de 20e en 21e eeuw uitgevoerd - in dit verband was zijn uitvoering van Rzewski's meesterwerk The People United Will Never Be Defeated een onvergetelijke ervaring. Hij zal dit en andere composities van Rzewski uitvoeren tijdens een concert in het Praagse DOX+ op 21 november 2023.\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/ateliermarcelhastir.eu\/agenda\/2024-11-30-duo-george-van-dam-violon-daan-vandewalle-piano\/","email":"ateliermarcelhastir@gmail.com","phone_contact":"+32 498 16 32 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000306"}},"place":{"id":242272,"translations":{"de":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":"Das Atelier Marcel Hastir ist ein Ort der Kunst, der kulturellen und k\u00fcnstlerischen Begegnungen, der 1935 von dem Maler Marcel Hastir in seinem K\u00fcnstleratelier in der Rue du Commerce 51 eingerichtet wurde. Das ungew\u00f6hnliche Haus hei\u00dft seit Jahrzehnten inmitten der Kunstwerke sowohl junge K\u00fcnstler als auch gro\u00dfe Namen der belgischen und internationalen Musik- und Theaterszene willkommen - ein Ort, der mit seiner ganz besonderen Atmosph\u00e4re verzaubert.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Atelier Marcel Hastir","address_street_name":"Handelsstraat","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Handelsstraat, 51","address_line2":"1000 Brussels","description_web":"The Atelier Marcel Hastir is a magical place where culture lovers and artists meet in the midst of Marcel Hastir's paintings, in the intimate setting of what has been his place of work since 1935.\r\nMarcel Hastir was a Belgian painter, theosofist and resistance fighter. His studio in the Leopold district served also as a concert hall for young musicians, and during the Second World War this \"painters school\" actually served as a relatively safe meeting place for young artists, students and resistance fighters. A team of passionate volunteers work for the preservation of his work and home organising concerts with both young and confirmed talent from Belgium and abroad.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":"Le nom Marcel Hastir vous dit quelque chose ?  Ce peintre, th\u00e9osophe et r\u00e9sistant belge a v\u00e9cu durant 76 ans (de 1935 jusqu\u2019\u00e0 sa mort) dans la rue du Commerce situ\u00e9e dans le quartier L\u00e9opold \u00e0 Bruxelles. Vous pouvez toujours y admirer ses toiles tout en appr\u00e9ciant de la musique classique ou du th\u00e9\u00e2tre. De grands noms du monde de la musique viennent dans ce lieu sp\u00e9cial depuis des d\u00e9cennies. L'atmosph\u00e8re intime et magique ne vous laissera pas indiff\u00e9rent.    \r\n\r\n","description_print":null,"booking_url":"https:\/\/ateliermarcelhastir.eu\/agenda\/","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Atelier Marcel Hastir","address_street_name":"Handelsstraat","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Handelsstraat, 51","address_line2":"1000 Brussel","description_web":"Zegt de naam Marcel Hastir je wat? Hij was een Belgisch kunstschilder, theosoof en verzetsstrijder. Van 1935 tot aan zijn dood 76 jaar later woonde hij in de Handelsstraat in de Brusselse Leopoldwijk. Je kan er zijn doeken nog steeds bewonderen terwijl je geniet van klassieke muziek of theater. Al decennialang komen op deze bijzondere plek grote namen uit de muziekwereld over de vloer. De intieme en magische sfeer zal je niet onberoerd laten.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":"AtelierMarcelHastir","backoffice_id":4704,"location":{"lat":50.8420134,"lon":4.3685574},"region":"brussels","last_updated_at":"2024-10-24T10:12:29+02:00","published_at":"2013-10-19T01:17:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":242272,"translations":{"de":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":"Das Atelier Marcel Hastir ist ein Ort der Kunst, der kulturellen und k\u00fcnstlerischen Begegnungen, der 1935 von dem Maler Marcel Hastir in seinem K\u00fcnstleratelier in der Rue du Commerce 51 eingerichtet wurde. Das ungew\u00f6hnliche Haus hei\u00dft seit Jahrzehnten inmitten der Kunstwerke sowohl junge K\u00fcnstler als auch gro\u00dfe Namen der belgischen und internationalen Musik- und Theaterszene willkommen - ein Ort, der mit seiner ganz besonderen Atmosph\u00e4re verzaubert.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Atelier Marcel Hastir","address_street_name":"Handelsstraat","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Handelsstraat, 51","address_line2":"1000 Brussels","description_web":"The Atelier Marcel Hastir is a magical place where culture lovers and artists meet in the midst of Marcel Hastir's paintings, in the intimate setting of what has been his place of work since 1935.\r\nMarcel Hastir was a Belgian painter, theosofist and resistance fighter. His studio in the Leopold district served also as a concert hall for young musicians, and during the Second World War this \"painters school\" actually served as a relatively safe meeting place for young artists, students and resistance fighters. A team of passionate volunteers work for the preservation of his work and home organising concerts with both young and confirmed talent from Belgium and abroad.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":"Le nom Marcel Hastir vous dit quelque chose ?  Ce peintre, th\u00e9osophe et r\u00e9sistant belge a v\u00e9cu durant 76 ans (de 1935 jusqu\u2019\u00e0 sa mort) dans la rue du Commerce situ\u00e9e dans le quartier L\u00e9opold \u00e0 Bruxelles. Vous pouvez toujours y admirer ses toiles tout en appr\u00e9ciant de la musique classique ou du th\u00e9\u00e2tre. De grands noms du monde de la musique viennent dans ce lieu sp\u00e9cial depuis des d\u00e9cennies. L'atmosph\u00e8re intime et magique ne vous laissera pas indiff\u00e9rent.    \r\n\r\n","description_print":null,"booking_url":"https:\/\/ateliermarcelhastir.eu\/agenda\/","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Atelier Marcel Hastir","address_street_name