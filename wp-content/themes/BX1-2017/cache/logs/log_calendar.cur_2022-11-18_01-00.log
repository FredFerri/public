:["Accessible","Parking accessible","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijke parking","Aangepast toilet"],"en":["Accessible","Accessible parking","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-17T02:35:44+01:00","published_at":"2022-03-15T11:48:07+01:00","backoffice_id":249660,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.20053619559536},{"id":540190,"date_start":"2022-09-08","date_end":"2023-05-18","date_next":"2022-11-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"EN EXCLUSIVITE - Spectacle D'improvisation de Laurence Post et Alban Schuiten","shortdescr":null,"longdescr":"\" EN EXCLUSIVITE  \"\r\n\r\n\r\nEn exclusivit\u00e9 c\u2019est un projet mis sur pieds par Alban Schuiten et Laurence Poot. \r\n\r\nLeur envie : tester des concepts, des techniques, des univers,\u2026 peu ou pas jou\u00e9s en improvisation.\r\n\r\nLe spectacle: \u00ab un autre monde \u00bb\r\nLes improvisateurs explorent un \u00ab autre monde \u00bb bas\u00e9 sur un paradigme qui n\u2019existe pas dans notre monde. \r\n\r\nPar exemple, dans cet autre monde, tout le monde connait la dur\u00e9e d\u2019une relation (amicale, amoureuse, de travail,\u2026) d\u00e8s que celle-ci d\u00e9bute. \r\n\r\nQu'est ce que cela changerait dans nos mani\u00e8res de vivre? De construire nos relations?\r\n\r\nL\u2019objectif : Vous proposer toutes sortes de situations d\u00e9coulant de ce nouveau paradigme. \r\n\r\nCe sera parfois touchant, parfois dr\u00f4le, parfois effrayant, parfois le tout en m\u00eame temps.\r\nEt surtout\u2026 On pourra continuer d\u2019en discuter au bar apr\u00e8s le spectacle. Assur\u00e9ment, un spectacle qui fait r\u00e9fl\u00e9chir ! \r\n\r\nBien s\u00fbr, nous proposerons \u00e9videment un autre paradigme","performers":"Laurence Poot, Alban Schuiten et des invit\u00e9.e.s tous meilleur.e.s les un.e.s que les autres !","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540190"},"nl":{"name":"EN EXCLUSIVITE - Spectacle D'improvisation de Laurence Post et Alban Schuiten","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540190"},"en":{"name":"EN EXCLUSIVITE - Spectacle D'improvisation de Laurence Post et Alban Schuiten","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540190"},"de":{"name":"EN EXCLUSIVITE - Spectacle D'improvisation de Laurence Post et Alban Schuiten","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540190"},"it":{"name":"EN EXCLUSIVITE - Spectacle D'improvisation de Laurence Post et Alban Schuiten","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540190"},"sp":