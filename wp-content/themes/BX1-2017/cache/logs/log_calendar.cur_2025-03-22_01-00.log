\u2019est notre mission. Pour cette fois, c\u2019est l\u2019\u00e9quipe artistique nouvelle formule qui donnera voix aux murs d\u2019Evere, rien que pour vous.  \n\nEt ils en ont des choses \u00e0 dire, ceux-l\u00e0 ! On vous murmurera \u00e0 leurs pieds les mots et sons qui les habitent. Ensemble, faisons-le (le mur), direction le souffle des histoires.","longdescr":null,"performers":"Conteuses : Muriel Durant, Carole Lwazo & Umm\u00e9e Shah ","boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/les-oreilles-ont-des-murs\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005285"},"sp":{"name":"Les oreilles ont des murs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/les-oreilles-ont-des-murs\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005285"},"nl":{"name":"Les oreilles ont des murs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/les-oreilles-ont-des-murs\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005285"}},"place":{"id":277904,"translations":{"de":{"name":"PCS de l\u00e0 haut","address_street_name":"Avenue Platon","address_street_number":"21","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Avenue Platon, 21","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"PCS de l\u00e0 haut","address_stre