punt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560578"},"pt":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560578"},"en":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560578"},"it":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560578"},"cn":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560578"},"fr":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560578"},"sp":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560578"},"nl":{"name":"Boekenverkoop","shortdescr":"Trakteer jezelf op een karrenvracht boeken, strips, cd\u2019s en dvd\u2019s voor spotprijzen. Onze jaarlijkse Boekenverkoop is een feest voor je boekenkast \u00e9n je portemonnee.","longdescr":"Naar jaarlijkse traditie opent Muntpunt op Autoloze zondag zijn deuren voor een grote boekenverkoop. Daar kan je voor een prikje een nieuwe boeken-, muziek- of filmcollectie bij elkaar kopen.\u00a0\u00a0Alle titels gaan de deur uit voor\u00a0\u20ac 2,\u00a0\u20ac 5 of \u20ac 10. Zo maken we plaats in de Muntpuntrekken voor nieuwe materialen.\n\nTweedehands, maar daarom niet oud\nAlles wat je kan kopen, is natuurlijk tweedehands, maar dat wil niet zeggen dat je enkel stoffige werken tegenkomt. Ook recente titels waarvan meerdere exemplaren beschikbaar waren in de bibliotheek, vinden hun weg naar de verkoop.\n\nPaspartoe-omruilvoordeel\nVlijtig Paspartoepunten gespaard? Dit is je kans om ze te verzilveren! Kom naar de Paspartoestand in Muntpunt en geniet van dit interessante omruilvoordeel: voor 5 punten krijg je een jeton ter waarde van \u20ac 1. Deze kan je dan weer uitgeven op de boekenverkoop (max. 5 jetons per persoon).\n\n10 Jaar Muntpunt\nOmdat het 10 Jaar Muntpunt is, zorgen we dit jaar voor enkele feestelijke extra's tijdens de Boekenverkoop: een voorleesuurtje met dragqueens, een dj die plaatjes draait uit de verkoopbakken en coole (fiets)tasjes en boekberschermers, vervaardigd uit oude bachen uit het Muntpuntarchief.\n\nOntdek het volledige programma van 10 Jaar Muntpunt\n\n\u00a0\n\nBook Sale\n\nIt has become an annual tradition: on Car Free Sunday, Muntpunt opens its doors for a big book sale. Buy yourself a new book, music of film collection for next to nothing! All titles are sold for \u20ac 2, \u20ac 5 or \u20ac 10.\u00a0This way, we make room\u00a0for new materials on our shelves.\n\nSecond-hand, but not old\nOf course, the titles for sale are\u00a0second-hand, but that doesn't mean you'll only find dusty old works. Recent titles, of which the library own multiples, also find their way to the book sale.\n\nPaspartoe\nBeen saving Paspartoe points? This is your chance to redeem them! Come to the Paspartoe desk\u00a0in Muntpunt\u00a0and exchange 5 points for a token worth \u20ac 1. You can then spend these tokens in the book sale (maximum 5 tokens per person).\n\n10 Jaar Muntpunt\nBecause it's our 10 year anniversary (10 Jaar Muntpunt), we have some festive extras during the Book Sale: a reading hour with drag queens, a DJ spinning records from the sale bins and cool (bike) bags and book covers made from old stuff from the Muntpunt archives.\n\nDiscover the full program of 10 Jaar Muntpunt\n\n\u00a0\n\nVente de livres\n\nC'est devenu une tradition annuelle : le Dimanche sans voiture, Muntpunt ouvre ses portes pour une grande vente de livres. Achetez une nouvelle collection de livres, de musique ou de films pour un prix d\u00e9risoire ! Tous les titres sont vendus au prix de \u20ac 2, \u20ac 5 ou \u20ac 10. De cette mani\u00e8re, nous faisons de la place pour de nouveaux ouvrages sur nos \u00e9tag\u00e8res.\n\nDe seconde main, mais pas vieux\nBien s\u00fbr, les titres mis en vente sont d'occasion, mais cela ne veut pas dire que vous n'y trouverez que de vieux ouvrages poussi\u00e9reux. Des titres r\u00e9cents, dont la biblioth\u00e8que poss\u00e8de de nombreux exemplaires, sont \u00e9galement propos\u00e9s \u00e0 la vente.\n\nPaspartoe\nVous avez \u00e9pargn\u00e9 des points Paspartoe ? C'est l'occasion de les \u00e9changer ! Venez au guichet Paspartoe \u00e0 Muntpunt et \u00e9changez 5 points contre un jeton d'une valeur de \u20ac 1. Vous pouvez ensuite d\u00e9penser ces jetons dans la vente de livres (maximum 5 jetons par personne).\n\n10 Jaar Muntpunt\nParce que c'est notre 10e anniversaire (10 Jaar Muntpunt), nous avons quelques extras festifs pendant la Vente de livres : une heure de lecture avec des drag queens, un DJ faisant tourner des disques provenant des bacs de vente et des sacs (de v\u00e9lo) et des couvertures de livres fabriqu\u00e9es de vieux objets provenant des archives de Muntpunt.\n\nD\u00e9couvrez le programma complet de 10 Jaar Muntpunt","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560578"}},"place":{"id":275830,"translations":{"de":{"name":"Muntpunt,  Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Muntpunt,  Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muntpunt,  Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Muntpunt,  Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"P