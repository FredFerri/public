d_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50011654,"date_start":"2024-06-17","date_end":"2024-07-07","date_next":"2024-06-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-24T02:00:38+02:00","published_at":"2024-06-17T17:12:29+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":302391,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.45667114039629425,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[27,24],"translations":{"de":["Fotografie","Kunstgalerien"],"pt":[null,null],"en":["Photography","Art Galleries"],"it":["Fotografia","Gallerie d'arte"],"cn":[null,null],"fr":["Photographie","Galeries d'art"],"sp":["Fotograf\u00eda","Galer\u00edas de arte"],"nl":["Fotografie","Galeries"]}}},"translations":{"de":{"name":"Finissage exposition Perceptions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011654"},"pt":{"name":"Finissage exposition Perceptions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011654"},"en":{"name":"\"Perceptions\" exhibition - Wild Fox","shortdescr":"The \"Perceptions\" exhibition presents unique and singular works created with cyanotype by the Belgian artist Wild F.O.X.\nThe cyanotype is one of the first photographic methods invented.\nFrom a chemical mixture applied to paper or fabric, a unique blue and white work of art appears.","longdescr":"W.Fox is a Belgian artist who lived from Mumbai to Montreal, and Lisbon to London in the last 10 years. Living in different environments has pushed forward their comprehension of the cultural impact on our ways of understanding our surroundings and each other.\n\nThe process started in 2015 in the Quebec capital when Fox was introduced to the Cyanotype printing method. At the time, working in documentary and fashion photography, the photographer began a passion for understanding the way humans read imagery and playing within those rules. Perceptions started there.\n\nBeing neurodivergent, they also saw and perceived life through their unique lens. Through social adaptation to the condition, their interest in the distinctions in discernment grew.\n\nAfter exhibiting around the world, it is a pleasure for the artist to return to their home country and have conversations within the culture that made their education and started all those questions.","performers":"Wild F.O.X. - Belgian artist known for his cyanotype work.","boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011654"},"it":{"name":"Finissage exposition Perceptions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011654"},"cn":{"name":"Finissage exposition Perceptions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011654"},"fr":{"name":"Exposition \"Perceptions\" - Wild Fox","shortdescr":"L'exposition \"Perceptions\" pr\u00e9sente les oeuvres uniques et singuli\u00e8res r\u00e9alis\u00e9es au cyanotype par l'artiste belge Wild F.O.X. \nLe cyanotype est l'une des premi\u00e8res m\u00e9thodes photographiques invent\u00e9es. \nD'un m\u00e9lange chimique appliqu\u00e9 sur du papier ou du tissu, appara\u00eet une \u0153uvre d'art unique bleue et blanche.","longdescr":"W.Fox est un artiste belge qui a v\u00e9cu de Mumbai \u00e0 Montr\u00e9al et de Lisbonne \u00e0 Londres au cours des 10 derni\u00e8res ann\u00e9es. Vivre dans des environnements diff\u00e9rents a fait progresser leur compr\u00e9hension de l\u2019impact culturel sur nos fa\u00e7ons de comprendre notre environnement et les uns les autres.\n\nLe processus a d\u00e9but\u00e9 en 2015 dans la capitale qu\u00e9b\u00e9coise lorsque Fox s'est initi\u00e9 \u00e0 la m\u00e9thode d'impression cyanotype. \u00c0 l\u2019\u00e9poque, travaillant dans la photographie documentaire et de mode, le photographe a commenc\u00e9 \u00e0 se passionner et tenter de comprendre la fa\u00e7on dont les humains lisent les images, pour ensuite jouer avec ces regles de visions. Perceptions commen\u00e7a l\u00e0.\n\n\u00c9tant neurodivergents, iel voyait et percevait \u00e9galement la vie \u00e0 travers leur lentille unique. Gr\u00e2ce \u00e0 l'adaptation sociale \u00e0 leur condition, leur int\u00e9r\u00eat pour les distinctions en mati\u00e8re de discernement s'est accru.\n\nApr\u00e8s avoir expos\u00e9 \u00e0 travers le monde, c'est un plaisir pour l'artiste de retourner dans son pays d'origine et d'avoir des conversations au sein de la culture qui a fait son \u00e9ducation et qui a d\u00e9clench\u00e9 toutes ces questions. \n","performers":"Wild F.O.X. - artiste belge connu pour son travail au cyanotype.","boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011654"},"sp":{"name":"Finissage exposition Perceptions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011654"},"nl":{"name":"Tentoonstelling \"Percepties\" - Wild Fox","shortdescr":"De tentoonstelling \"Perceptions\" presenteert unieke en bijzondere werken gemaakt met cyanotype van de Belgische kunstenaar Wild F.O.X.\nHet cyanotype is een van de eerste fotografische methoden die is uitgevonden.\nUit een chemisch mengsel dat op papier of stof wordt aangebracht, ontstaat een uniek blauw-wit kunstwerk.","longdescr":"W.Fox is een Belgische kunstenaar die de afgelopen 10 jaar van Mumbai tot Montreal en van Lissabon tot Londen heeft gewoond. Het leven in verschillende omgevingen zorgde voor een beter inzicht in de culturele impact op de manier waarop we onze omgeving en elkaar begrijpen.\n\nHet proces begon in 2015 in de hoofdstad van Quebec toen Fox kennis maakte met de cyanotype-afdrukmethode. De fotograaf werkte destijds in de documentaire- en modefotografie en begon een passie te krijgen voor het proberen te begrijpen hoe mensen beelden lezen, en vervolgens te spelen met deze visieregels. Waarnemingen zijn daar begonnen.\n\nOmdat ze neurodivergerend waren, zagen en observeerden ze het leven ook door hun unieke lens. Door sociale aanpassing aan hun toestand nam hun belangstelling voor onderscheid in onderscheidingsvermogen toe.\n\nNa over de hele wereld te hebben ge\u00ebxposeerd, is het een genoegen voor de kunstenaar om terug te keren naar zijn thuisland en gesprekken te voeren binnen de cultuur die hem heeft opgeleid en al deze vragen heeft aangewakkerd.","performers":"Wilde vos. - Belgische kunstenaar bekend om zijn cyanotypiewerk.","boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011654"}},"place":{"id":256649,"translations":{"de":{"name":"Studio Baxton","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"29","address_street_box":null,"email":"info@studiobaxton.com","website":"https:\/\/www.studiobaxton.com\/","phone_contact":"+32 2 513 22 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Studio Baxton","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"29","address_street_box":null,"email":"info@studiobaxton.com","website":"https:\/\/www.studiobaxton.com\/","phone_contact":"+32 2 513 22 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vieille Halle aux Bl\u00e9s, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Studio Baxton","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"29","address_street_box":null,"email":"info@studiobaxton.com","website":"https:\/\/www.studiobaxton.co