,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":32222,"location":{"lat":50.81434148,"lon":4.44283848},"region":"brussels","last_updated_at":"2022-05-12T09:05:06+02:00","published_at":"2018-10-04T11:28:46+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/57992ab17de7acc6c91268c456f9e4d192e112cb.png","width":1200,"height":628,"ratio":1.91,"translations":{"fr":{"title":"Festival Paroles de r\u00e9sistance - 4i\u00e8me \u00e9dition ","copyright":null},"nl":{"title":"Festival Paroles de r\u00e9sistance - 4i\u00e8me \u00e9dition ","copyright":null},"en":{"title":"Festival Paroles de r\u00e9sistance - 4i\u00e8me \u00e9dition ","copyright":null}}}],"dates":[],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":12},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":6},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":6},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":6},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Jobseekers"}},"value":6},{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groepen"},"en":{"name":"Group"}},"value":4},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["major_event"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-12T09:05:06+02:00","published_at":"2022-05-12T09:01:53+02:00","backoffice_id":253592,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.7937005259841},{"id":534600,"date_start":"2022-06-25","date_end":"2022-06-26","date_next":"2022-06-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":57,"translations":{"fr":"Clubbing","nl":"Clubbing","en":"Clubbing"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Mu Delta","shortdescr":"Nous sommes impatients de vous accueillir de nouveau au stammbar le vendredi 25 juin, nous accueillerons notre nouveau r\u00e9sident dj MU DELTA.","longdescr":"Nous sommes impatients de vous accueillir de nouveau au stammbar le vendredi 25 juin, nous accueillerons notre nouveau r\u00e9sident dj MU DELTA.\r\n\r\nBien que nous soyons excit\u00e9s de rouvrir, cela d\u00e9pend de notre confiance \u00e0 pouvoir le faire en toute s\u00e9curit\u00e9 selon les protocoles covid\u00e9s sanctionn\u00e9s par le gouvernement ; nous le faisons parce que nous sommes s\u00fbrs que nous pouvons avoir la meilleure exp\u00e9rience chez nous, l\u00e0 o\u00f9 nous appartenons.\r\n\r\nNous vous aimons tous \u00e0 Stammbar, restez en s\u00e9curit\u00e9, et on se voit sur le dancefloor et dans la chambre noire.\r\n\r\nStammbar s'efforce de cr\u00e9er un espace ouvert et s\u00fbr pour les artistes, les clubbers et les visiteurs. Nous appliquons une politique de tol\u00e9rance z\u00e9ro envers le racisme, la transphobie, le sexisme, l'\u00e2gisme et toute forme de discrimination. Nous demandons \u00e0 toute notre communaut\u00e9 d'aider \u00e0 am\u00e9liorer notre espace. Si vous \u00eates t\u00e9moin d'un comportement qui n'a pas sa place dans notre lieu, veuillez nous le signaler.","performers":"Mu Delta","boxoffice_url":null,"website":"http:\/\/stammbarbxl.com","email":"info@stammbarbxl.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534600.html"},"nl":{"name":"Mu Delta","shortdescr":"We kunnen niet wachten om jullie allemaal terug te verwelkomen in Stammbar op vrijdag 25 juni, we zullen onze nieuwe resident dj MU DELTA hosten.","longdescr":"We kunnen niet wachten om jullie allemaal terug te verwelkomen in Stammbar op vrijdag 25 juni, we zullen onze nieuwe resident dj MU DELTA hosten.\r\n\r\nHoewel we enthousiast zijn om te heropenen, is dit afhankelijk van ons vertrouwen om het veilig te kunnen doen onder de door de overheid goedgekeurde covid protocollen; we doen het omdat we er zeker van zijn dat we de beste ervaring kunnen hebben thuis waar we thuishoren.\r\n\r\nGroeten van ons allemaal bij stammbar, blijf veilig, en tot ziens op de dansvloer en in de donkere kamer\r\n\r\nStammbar streeft naar een open en veilige ruimte voor artiesten, clubbers en bezoekers; we hanteren een zero tolerance beleid ten aanzien van racisme, transfobie, sexisme, ageisme en elke vorm van discriminatie. We vragen onze hele gemeenschap om te helpen onze ruimte te verbeteren. Als je gedrag ziet dat niet op onze locatie thuishoort, laat het ons dan weten.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534600.html"},"en":{"name":"Mu Delta","shortdescr":"We can\u2019t wait to welcome you all back to stammbar on friday 25th of June, we will host our new resident dj MU DELTA.","longdescr":"We can\u2019t wait to welcome you all back to stammbar on friday 25th of June, we will host our new resident dj MU DELTA.\r\n\r\nWhile we are excited to reopen, this is dependent on our confidence in being able to do it safely under government sanctioned covid protocols; we do it because we are sure that we can have the best experience back home where we belong.\r\n\r\nLove from all of us at stammbar, stay safe, and see you on the dancefloor and the darkroom\r\n\r\nStammbar strives to create an open and safe space for artists, clubbers and visitors; we operate a zero tolerance policy to racism, transphobia, sexism, ageism and any form of discrimination. We ask for all of our community to help improve our space. If you see behaviour that has no place on our venue, please tell us.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534600.html"},"de":{"name":"Mu Delta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/534600.html"},"it":{"name":"Mu Delta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/534600.html"},"sp":{"name":"Mu Delta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/534600.html"},"pt":{"name":"Mu Delta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/534600.html"},"cn":{"name":"Mu Delta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/534600.html"}},"place":{"id":265588,"translations":{"fr":{"name":"Stammbar","address_street_name":"Rue du March\u00e9 au Charbon","address_street_number":"114","address_street_box":null,"email":"fredsvott@me.com","website":"http:\/\/stammbar.be\/","phone_contact":"+32 471 80 14 39","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 au Charbon, 114","address_line2":"1000 Bruxelles","description_web":"Stammbar est le lieu de rencontre des f\u00eatards, des freaks, des aventuriers, des personnalit\u00e9s et des personnes qui font briller la nuit Bruxelloise. Ce lieu, v\u00e9ritable melting pot de rencontre des noctambules en qu\u00eates de plaisirs, offre une atmosph\u00e8re d\u00e9contract\u00e9e dans un cadre moderne et immacul\u00e9.\r\nA la fois bar de jour et lieu de cruising, le Stammbar accueil \u00e9galement des expositions et des soir\u00e9es \u00e0 th\u00e8me, en plus de sa s\u00e9lection musicale affirm\u00e9e.\r\nEtabli depuis plusieurs ann\u00e9es sur la sc\u00e8ne Bruxelloise, chaque soir ses portes s\u2019ouvrent pour les amis et les \u00e9trangers \u00e0 la recherche d\u2019une exp\u00e9rience m\u00e9morable.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stammbar","address_street_name":"Kolenmarkt","address_street_number":"114","address_street_box":null,"email":"fredsvott@me.com","website":"http:\/\/stammbar.be\/","phone_contact":"+32 471 80 14 39","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Kolenmarkt, 114","address_line2":"1000 Brussel","description_web":"Stammbar is de ontmoetingsplaats voor feestvierders, freaks, avonturiers, creatievelingen enzovoort. Deze plek, een echte smeltroes voor nachtraven op zoek naar plezier, biedt een ontspannen sfeer aan in een modern en onberispelijk decor.\r\nDe Stammbar is zowel een plek voor overdag als een uitgaansgelegenheid. Daarnaast zijn er ook tentoonstellingen en thema-avonden, naast een uitgemeten muziekaanbod.\r\nDeze bar is al enkele jaren een gevestigde waarde in Brussel en elke avond gaan de deuren open voor vrienden en onbekenden die op zoek zijn naar een memorabele ervaring.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Stammbar","address_street_name":"Rue du March\u00e9 au Charbon","address_street_number":"114","address_street_box":null,"email":"fredsvott@me.com","website":"http:\/\/stammbar.be\/","phone_contact":"+32 471 80 14 39","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du March\u00e9 au Charbon, 114","address_line2":"1000 Brussels","description_web":"Stammbar is the meeting place for partygoers, freaks, adventurers, creative personalities and people who shape the night. This bar, a real melting pot for night owls in search of fun, offers a relaxed atmosphere in an immaculate, modern setting.\r\nBoth a daytime bar and a cruising spot, Stammbar hosts exhibitions and themed nights in addition to music shows.\r\nPresent on the Brussels scene for several years now, every night its doors open to friends and strangers looking for a memorable experience.\r\nOpen 7 nights a week, with an additional daytime session from 3pm on Sundays.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Stammbar","address_street_name":"Rue du March\u00e9 au Charbon","address_street_number":"114","address_street_box":null,"email":"fredsvott@me.com","website":"http:\/\/stammbar.be\/","phone_contact":"+32 471 80 14 39","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 au Charbon, 114","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Stammbar","address_street_name":"Rue du March\u00e9 au Charbon","address_street_number":"114","address_street_box":null,"email":"fredsvott@me.com","website":"http:\/\/stammbar.be\/","phone_contact":"+32 471 80 14 39","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 au Charbon, 114","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"s