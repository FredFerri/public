cation_state":"public","last_updated_at":"2022-07-13T04:05:27+02:00","published_at":"2022-07-13T03:30:16+02:00","backoffice_id":258330,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1.2599210498949},{"id":534956,"date_start":"2022-08-20","date_end":"2022-08-20","date_next":"2022-08-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Big Bang","shortdescr":"Un spectacle de th\u00e9\u00e2tre de rue excr\u00e9ment organique et d\u00e9tonnant !","longdescr":"Cet \u00e9t\u00e9, La Villa vous propose un spectacle jeune public en plein air \u00e0 la Ferme Chez\/Bij Th\u00e9o & Jeanine le 20 ao\u00fbt \u00e0 15h! \u00c0 travers leur expos\u00e9 lib\u00e9rateur, Kim et Karel vous invitent \u00e0 revisiter un sujet trop souvent tabou et pourtant excr\u00e9ment passionnant !\r\n\r\nDeux agents de transit accueillent leur client\u00e8le dans leur lieu d\u2019aisance et proposent un accompagnement personnalis\u00e9 pour que \u00ab\u00e7a\u00bb aille bien. \r\n\r\nL\u2019objectif des deux agents est que chacun.e puisse vivre son transit en toute conscience et d\u00e9contraction.\r\n\r\nGr\u00e2ce \u00e0 leur st\u00e9thoscope g\u00e9ant, ils vont \u00e0 l\u2019\u00e9coute du syst\u00e8me \u00abgastro-infestinal\u00bb de leur client\u00e8le, pour d\u00e9bloquer toutes les m\u00e9moires qui pourraient contrarier leur transit. \r\n\r\nEn effet, ils ont compris que prendre soin de son ventre, c\u2019est aussi prendre soin de la terre et de ce qu\u2019ils vont en r\u00e9colter\u2026\r\n\r\n* Du cycle digestif au cycle de la terre, le grand pas de l\u2019intime \u00e0 l\u2019universel *","performers":"Compagnie Compost\r\nDe et avec: Nathalie Gillet et Tom Mannaerts\r\nMise en sc\u00e8ne: Laurent Taquin\r\nCoach jeu et personnages: Olivier Mahiant\r\nCr\u00e9ation son: Loic Le Foll et Mathieu Calant\r\nSc\u00e9nographie: Irma Morin\r\nCostumes: Isabelle Airaud\r\nConstruction: Xavier Decoux et Tom Mannaerts\r\nR\u00e9gie: Peter Flodrops \/ Kelly Furtado\r\n\r\n\u00a9 Dieter Hoeven","boxoffice_url":null,"website":"http:\/\/www.lavillaculture.be","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534956.html"},"nl":{"name":"Big Bang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534956.html"},"en":{"name":"Big Bang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534956.html"},"de":{"name":"Big Bang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/534956.html"},"it":{"name":"Big Bang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/534956.html"},"sp":{"name":"Big Bang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/534956.html"},"pt":{"name":"Big Bang","shortdescr":