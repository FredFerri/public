e de g\u00e9orgiens sans papiers. Le fait-elle pour de bonnes raisons ?\n\nLa nouvelle pi\u00e8ce de Jean-Philippe Daguerre est une com\u00e9die pleine d\u2019humanit\u00e9.","performers":"Com\u00e9die de Jean-Philippe Daguerre, avec Florence PERNEL, Bernard MALAKA, Charlotte MATZNEFF, Marc SIEMIATYCKI, Antoine GUIRAUD et Tanguy VRIGNAULT","boxoffice_url":null,"website":"https:\/\/ccauderghem.be","email":"accueil@ccauderghem.be","phone_contact":"+32 2 660 03 03","phone_booking":"+32 2 660 03 03","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003661"},"sp":{"name":"Le huiti\u00e8me ciel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccauderghem.be","email":"accueil@ccauderghem.be","phone_contact":"+32 2 660 03 03","phone_booking":"+32 2 660 03 03","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003661"},"nl":{"name":"Le huiti\u00e8me ciel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccauderghem.be","email":"accueil@ccauderghem.be","phone_contact":"+32 2 660 03 03","phone_booking":"+32 2 660 03 03","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003661"}},"place":{"id":136,"translations":{"de":{"name":"Centre Culturel d'Auderghem","address_street_name":"Boulevard du Souverain","address_street_number":"183","address_street_box":null,"email":"accueil@ccauderghem.be","website":"http:\/\/www.ccauderghem.be","phone_contact":"+32 2 660 03 03","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Boulevard du Souverain, 183","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel d'Auderghem","address_street_name":"Boulevard du Souverain","address_street_number":"183","address_street_box":null,"email":"accueil@ccauderghem.be