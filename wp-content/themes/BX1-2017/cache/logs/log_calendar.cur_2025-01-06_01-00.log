":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003905"},"pt":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003905"},"en":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003905"},"it":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003905"},"cn":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003905"},"fr":{"name":"Art Pops - Belfius Art Gallery","shortdescr":"Nouvelle exposition, nouvelles \u00e9motions. Art Pops vous invite \u00e0 une immersion artistique surprenante au c\u0153ur de la Belfius Art Gallery.","longdescr":"Nouvelle exposition, nouvelles \u00e9motions. Art Pops vous invite \u00e0 une immersion artistique surprenante au c\u0153ur de la Belfius Art Gallery. Oubliez la visite classique et vivez l'art plus intens\u00e9ment !\n\u00c9coutez, sentez, touchez\u2026 et ressentez une connexion encore plus forte avec chaque \u0153uvre.\n\nPlongez dans des installations \u00e9clatantes de couleurs et vibrantes d'\u00e9nergie, qui vous invitent \u00e0 c\u00e9l\u00e9brer l\u2019expression artistique dans toutes ses textures. Sentir l\u2019invisible, flotter dans un nuage, humer l\u2019art, voyager \u00e0 travers l\u2019imaginaire\u2026 Art Pops n\u2019est pas une simple exposition : c\u2019est un voyage sensoriel et une rencontre personnelle avec l\u2019art.\n\nL\u2019exposition vous invite \u00e0 explorer les pouvoirs extraordinaires de l\u2019art \u00e0 travers une s\u00e9lection d\u2019\u0153uvres qui au-del\u00e0 de la toile expriment le pouvoir de la musique gr\u00e2ce \u00e0 une cr\u00e9ation originale de Jasper Steverlinck, la civilisation des odeurs dans les oeuvres majestueuses de Peter de Cupere ainsi que le langage du toucher et du tactile et l\u2019empire du go\u00fbt au travers entre autres des \u0153uvres de Stefan Peters, Aur\u00e9lie Gravas, Lionel Est\u00e8ve, Louise Delanghe, Warre Mulder, Kristof Santy r\u00e9cemment accueillies au sein de la de la Belfius Art Collection.\n\nVivez l\u2019inattendu et explorez l\u2019art \u00e0 travers tous vos sens !\n\nSi vous participez \u00e0 une visite Arkadia merci de ne pas vous inscrire sur le site de Belfius. Votre place sera automatiquement r\u00e9serv\u00e9e. Veuillez arriver 10 min en avance car il y a un contr\u00f4le d'identit\u00e9 \u00e0 l'entr\u00e9e (ne pas oublier sa carte d'identit\u00e9). Vous retrouverez le guide apr\u00e8s le contr\u00f4le \u00e0 la borne \"point de rencontre\".\n\nBelfius demande \u00e0 chaque visiteur une contribution de 5 euros \u00e0 r\u00e9gler sur place en soutien aux actions Viva for Life (en faveur des enfants et leurs familles vivant sous le seuil de pauvret\u00e9) et JEZ! (en faveur d'organisations intervenant aupr\u00e8s des jeunes). Cette participation est facultative pour les clients Belfius munis de leur carte de banque ou de l\u2019app Belfius Mobile.\n\nLa Belfius Art Gallery se situe au c\u0153ur de Bruxelles, au 32e \u00e9tage de la Tour Belfius.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003905"},"sp":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003905"},"nl":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003905"}},"place":{"id":266601,"translations":{"de":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":"11","a