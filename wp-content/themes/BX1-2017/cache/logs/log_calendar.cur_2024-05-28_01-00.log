ast toilet"]}},"visit_profile":{"list":[337],"translations":{"de":["Highlight"],"pt":[null],"en":["Highlight"],"it":["Highlight"],"cn":[null],"fr":["Highlight"],"sp":["Highlight"],"nl":["Highlight"]},"values":null,"externalReferenceList":null},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["major_event","exterior"]},{"id":50011084,"date_start":"2024-05-22","date_end":"2024-06-30","date_next":"2024-05-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-05-27T02:00:40+02:00","published_at":"2024-05-24T16:52:05+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":300819,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2924017738212866,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Yuiko R\u00e1yka: \"Unknown Power\", Japanese gold leaf art exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/viewing-room\/30-yuiko-rayka-unknown-power-art-of-japanese-genuine-gold-leaf\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011084"},"pt":{"name":"Yuiko R\u00e1yka: \"Unknown Power\", Japanese gold leaf art exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/viewing-room\/30-yuiko-rayka-unknown-power-art-of-japanese-genuine-gold-leaf\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011084"},"en":{"name":"Yuiko R\u00e1yka: \"Unknown Power\", Japanese gold leaf art exhibition","shortdescr":"\u2022 Yuiko R\u00e1yka is a Japanese contemporary artist, born and currently lives in Tokyo, Japan.\n\n","longdescr":"\u2022 Her body of work focuses on the unknown potentials and latent abilities within each of us as human beings, and our evolving spirit towards a new era. Inspired by her own interdimensional experiences, her works are multidimensionally expressed through installations that emphasize on perceptual experiences.\n\"UNKNOWN POWER\"\n\u2022 The series, \"Unknown Power,\" was born out of an experience I had in Sedona, which I visited in early 2019. As I was meditating at Bell Rock, one of Sedona's powerful vortexes, I experienced a vision of a huge circle of light spreading across the sky. It was golden and shining with high vibrational energy, and it was approaching me, emitting rays of light. I couldn't and cannot define what this circle of light was - a dream, an illusion, a divine being, a spirit existing in this land, or something else.\nWhat we usually perceive as \"knowing\" is only a small part of the whole (unknowing). And if we only look with what we \"know,\" the world is limited.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/viewing-room\/30-yuiko-rayka-unknown-power-art-of-japanese-genuine-gold-leaf\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011084"},"it":{"name":"Yuiko R\u00e1yka: \"Unknown Power\", Japanese gold leaf art exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/viewing-room\/30-yuiko-rayka-unknown-power-art-of-japanese-genuine-gold-leaf\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011084"},"cn":{"name":"Yuiko R\u00e1yka: \"Unknown Power\", Japanese gold leaf art exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/viewing-room\/30-yuiko-rayka-unknown-power-art-of-japanese-genuine-gold-leaf\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011084"},"fr":{"name":"Yuiko R\u00e1yka : \"Unknown Power\", exposition d'art japonais \u00e0 la feuille d'or","shortdescr":"\u2022 Yuiko R\u00e1yka est une artiste contemporaine japonaise, n\u00e9e et vivant actuellement \u00e0 Tokyo, au Japon.","longdescr":"\u2022 Son \u0153uvre se concentre sur les potentiels inconnus et les capacit\u00e9s latentes en chacun de nous en tant qu'\u00eatres humains, ainsi que sur notre esprit \u00e9voluant vers une nouvelle \u00e8re. Inspir\u00e9es par ses propres exp\u00e9riences interdimensionnelles, ses \u0153uvres sont exprim\u00e9es de mani\u00e8re multidimensionnelle \u00e0 travers des installations qui mettent l'accent sur les exp\u00e9riences perceptuelle.\n\"POUVOIR INCONNU\"\n\u2022 La s\u00e9rie \"Pouvoir Inconnu\" est n\u00e9e d'une exp\u00e9rience que j'ai eue \u00e0 Sedona, que j'ai visit\u00e9e au d\u00e9but de l'ann\u00e9e 2019. Alors que je m\u00e9ditais \u00e0 Bell Rock, l'un des puissants vortex de Sedona, j'ai eu la vision d'un immense cercle de lumi\u00e8re se r\u00e9pandant dans le ciel. Il \u00e9tait dor\u00e9 et brillant avec une \u00e9nergie vibratoire \u00e9lev\u00e9e, et il s'approchait de moi, \u00e9mettant des rayons de lumi\u00e8re. Je ne pouvais pas et je ne peux toujours pas d\u00e9finir ce qu'\u00e9tait ce cercle de lumi\u00e8re - un r\u00eave, une illusion, un \u00eatre divin, un esprit existant sur cette terre, ou autre chose.\nCe que nous percevons habituellement comme \"savoir\" n'est qu'une petite partie de l'ensemble (l'inconnu). Et si nous regardons uniquement avec ce que nous \"savons\", le monde est limit\u00e9.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/viewing-room\/30-yuiko-rayka-unknown-power-art-of-japanese-genuine-gold-leaf\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011084"},"sp":{"name":"Yuiko R\u00e1yka: \"Unknown Power\", Japanese gold leaf art exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/viewing-room\/30-yuiko-rayka-unknown-power-art-of-japanese-genuine-gold-leaf\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011084"},"nl":{"name":"Yuiko R\u00e1yka: \"Onbekende kracht\", Japanse kunsttentoonstelling met bladgoud","shortdescr":"\u2022 Yuiko R\u00e1yka is een Japanse hedendaagse kunstenaar, geboren en momenteel woonachtig in Tokio, Japan.","longdescr":"\u2022 Haar oeuvre richt zich op de onbekende potenties en latente capaciteiten binnenin ieder van ons als mens, en op onze evoluerende geest naar een nieuw tijdperk. Ge\u00efnspireerd door haar eigen interdimensionale ervaringen, worden haar werken multidimensionaal uitgedrukt door installaties die de nadruk leggen op perceptuele ervaringen.\n \nView works.\nDragon's nest, 2021\n \nDELEN\n \n\"ONBEKENDE KRACHT\"\n\u2022 De serie \"Onbekende Kracht\" is ontstaan uit een ervaring die ik had in Sedona, die ik begin 2019 bezocht. Terwijl ik aan het mediteren was bij Bell Rock, een van de krachtige vortexen van Sedona, kreeg ik een visioen van een enorme cirkel van licht die zich over de lucht verspreidde. Het was goudkleurig en straalde een hoge vibratie-energie uit, en het naderde me, terwijl het stralen van licht uitzond. Ik kon en kan nog steeds niet defini\u00ebren wat deze cirkel van licht was - een droom, een illusie, een goddelijk wezen, een geest die in dit land bestaat, of iets anders.\nWat we meestal waarnemen als \"weten\" is slechts een klein deel van het geheel (het niet-weten). En als we alleen kijken met wat we \"weten,\" is de wereld beperkt.","performers":"\n","boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/nl\/viewing-room\/30-yuiko-rayka-unknown-power-art-of-japanese-genuine-gold-leaf\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011084"}},"place":{"last_updated_at":"2023-05-11T15:22:17+02:00","published_at":"2023-02-01T13:55:51+01:00","id":279896,"translations":{"de":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Brussels","description_web":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","description_print":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com","visit_url":null},"it":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","description_print":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com\/fr\/","visit_url":null},"sp":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Art Yi","address_street_name":"Magdalenasteenweg","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Magdalenasteenweg, 59","address_line2":"1000 Brussel","description_web":" Gelegen in het Monts des Arts Museum gebied en vlakbij het Brussel-Centraal station en de Grote Markt, is Art Y\u012b een hedendaagse kunstgalerie die jaarlijks miljoenen internationale toeristen ontvangt en kunstverzamelaars van over de hele wereld bedient.\r\n \r\n\u2022 Art Y\u012b biedt een unieke ervaring van hedendaagse kunst uit verschillende culturen. De galerie presenteert een brede selectie van beeldhouwwerken en schilderijen uit Europa en Azi\u00eb. Opgericht door Shuo LIU, heeft Art Y\u012b een rijke erfenis van 40 jaar Belgische galerie.\r\n\r\nOnze 5 categorie\u00ebn\r\n\u2022 Beeldhouwwerken\r\n\u2022 Schilderijen\r\n\u2022 Installatie kunst\r\n\u2022 Keramiek\r\n\u2022 Antiek\r\n\r\n\u2022 Een vorm van samensmelting in de kunst, een reis van traditie naar hedendaags, van oost naar west, leidend tot diversiteit die buiten tijd en ruimte leeft. We bieden een unieke versie van hedendaagse kunst die spreekt tot iedereen in een universele taal. \r\n\r\n\u2022 Of u nu een ervaren verzamelaar bent of pas begint met het verkennen van de kunstwereld, voor professionele doeleinden of priv\u00e9verzameling, we hebben iets te bieden. Onze collectie omvat een diverse selectie van hoogwaardige kunstwerken, vari\u00ebrend van hedendaagse tot traditionele stukken. We stellen elke kunstwerk zorgvuldig samen om ervoor te zorgen dat het voldoet aan onze hoge normen van kwaliteit en excellentie.\r\n \r\n\u2022 Bij Art Y\u012b, naast onze uitzonderlijke collectie, zijn we toegewijd aan het bieden van een onge\u00ebvenaarde ervaring aan onze klanten. Het verwerven van een kunstwerk is een uniek moment. Om deze magie mogelijk te maken, biedt Art Y\u012b verschillende financieringsoplossingen zoals Art Leasing en\/of Art Renting met een koopoptie die het best past bij het professionele profiel en voordelen biedt om kunst te verwerven. Ons team van experts staat altijd klaar om persoonlijke begeleiding en ondersteuning te bieden, van het selecteren van het perfecte stuk tot het vinden van de beste financi\u00eble oplossingen.\r\n \r\n\u2022 Bij Art Y\u012b zijn we gepassioneerd door kunst en toegewijd om onze klanten het allerbeste te bieden. Sluit u aan bij ons op onze missie om kunst naar de wereld te brengen en ontdek de exclusieve voordelen van het verzamelen van kunst bij ons:\r\n- Ontvang ons gepersonaliseerde lidmaatschapsaanbod voor uw 1e collectie!\r\n- Geniet van gratis wereldwijde kunstverzending\r\n- Heb als eerste toegang tot onze nieuwe kunstwerken & tentoonstellingen\r\n- Woon onze Vernissages & Kunstbeurzen bij met VIP-toegang","description_print":" Gelegen in het Monts des Arts Museum gebied en vlakbij het Brussel-Centraal station en de Grote Markt, is Art Y\u012b een hedendaagse kunstgalerie die jaarlijks miljoenen internationale toeristen ontvangt en kunstverzamelaars van over de hele wereld bedient.\r\n \r\n\u2022 Art Y\u012b biedt een unieke ervaring van hedendaagse kunst uit verschillende culturen. De galerie presenteert een brede selectie van beeldhouwwerken en schilderijen uit Europa en Azi\u00eb. Opgericht door Shuo LIU, heeft Art Y\u012b een rijke erfenis van 40 jaar Belgische galerie.\r\n\r\nOnze 5 categorie\u00ebn\r\n\u2022 Beeldhouwwerken\r\n\u2022 Schilderijen\r\n\u2022 Installatie kunst\r\n\u2022 Keramiek\r\n\u2022 Antiek\r\n\r\n\u2022 Een vorm van samensmelting in de kunst, een reis van traditie naar hedendaags, van oost naar west, leidend tot diversiteit die buiten tijd en ruimte leeft. We bieden een unieke versie van hedendaagse kunst die spreekt tot iedereen in een universele taal. \r\n\r\n\u2022 Of u nu een ervaren verzamelaar bent of pas begint met het verkennen van de kunstwereld, voor professionele doeleinden of priv\u00e9verzameling, we hebben iets te bieden. Onze collectie omvat een diverse selectie van hoogwaardige kunstwerken, vari\u00ebrend van hedendaagse tot traditionele stukken. We stellen elke kunstwerk zorgvuldig samen om ervoor te zorgen dat het voldoet aan onze hoge normen van kwaliteit en excellentie.\r\n \r\n\u2022 Bij Art Y\u012b, naast onze uitzonderlijke collectie, zijn we toegewijd aan het bieden van een onge\u00ebvenaarde ervaring aan onze klanten. Het verwerven van een kunstwerk is een uniek moment. Om deze magie mogelijk te maken, biedt Art Y\u012b verschillende financieringsoplossingen zoals Art Leasing en\/of Art Renting met een koopoptie die het best past bij het professionele profiel en voordelen biedt om kunst te verwerven. Ons team van experts staat altijd klaar om persoonlijke begeleiding en ondersteuning te bieden, van het selecteren van het perfecte stuk tot het vinden van de beste financi\u00eble oplossingen.\r\n \r\n\u2022 Bij Art Y\u012b zijn we gepassioneerd door kunst en toegewijd om onze klanten het allerbeste te bieden. Sluit u aan bij ons op onze missie om kunst naar de wereld te brengen en ontdek de exclusieve voordelen van het verzamelen van kunst bij ons:\r\n- Ontvang ons gepersonaliseerde lidmaatschapsaanbod voor uw 1e collectie!\r\n- Geniet van gratis wereldwijde kunstverzending\r\n- Heb als eerste toegang tot onze nieuwe kunstwerken & tentoonstellingen\r\n- Woon onze Vernissages & Kunstbeurzen bij met VIP-toegang","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com\/nl\/","visit_url":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":39896,"location":{"lat":50.84475553,"lon":4.35527958},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"last_updated_at":"2023-05-11T15:22:17+02:00","published_at":"2023-02-01T13:55:51+01:00","id":279896,"translations":{"de":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Brussels","description_web":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","description_print":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com","visit_url":null},"it":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","description_print":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com\/fr\/","visit_url":null},"sp":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Art Yi","address_street_name":"Magdalenasteenweg","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Magdalenasteenweg, 59","address_line2":"1000 Brussel","description_web":" Gelegen in het Monts des Arts Museum gebied en vlakbij het Brussel-Centraal station en de Grote Markt, is Art Y\u012b een hedendaagse kunstgalerie die jaarlijks miljoenen internationale toeristen ontvangt en kunstverzamelaars van over de hele wereld bedient.\r\n \r\n\u2022 Art Y\u012b biedt een unieke ervaring van hedendaagse kunst uit verschillende culturen. De galerie presenteert een brede selectie van beeldhouwwerken en schilderijen uit Europa en Azi\u00eb. Opgericht door Shuo LIU, heeft Art Y\u012b een rijke erfenis van 40 jaar Belgische galerie.\r\n\r\nOnze 5 categorie\u00ebn\r\n\u2022 Beeldhouwwerken\r\n\u2022 Schilderijen\r\n\u2022 Installatie kunst\r\n\u2022 Keramiek\r\n\u2022 Antiek\r\n\r\n\u2022 Een vorm van samensmelting in de kunst, een reis van traditie naar hedendaags, van oost naar west, leidend tot diversiteit die buiten tijd en ruimte leeft. We bieden een unieke versie van hedendaagse kunst die spreekt tot iedereen in een universele taal. \r\n\r\n\u2022 Of u nu een ervaren verzamelaar bent of pas begint met het verkennen van de kunstwereld, voor professionele doeleinden of priv\u00e9verzameling, we hebben iets te bieden. Onze collectie omvat een diverse selectie van hoogwaardige kunstwerken, vari\u00ebrend van hedendaagse tot traditionele stukken. We stellen elke kunstwerk zorgvuldig samen om ervoor te zorgen dat het voldoet aan onze hoge normen van kwaliteit en excellentie.\r\n \r\n\u2022 Bij Art Y\u012b, naast onze uitzonderlijke collectie, zijn we toegewijd aan het bieden van een onge\u00ebvenaarde ervaring aan onze klanten. Het verwerven van een kunstwerk is een uniek moment. Om deze magie mogelijk te maken, biedt Art Y\u012b verschillende financieringsoplossingen zoals Art Leasing en\/of Art Renting met een koopoptie die het best past bij het professionele profiel en voordelen biedt om kunst te verwerven. Ons team van experts staat altijd klaar om persoonlijke begeleiding en ondersteuning te bieden, van het selecteren van het perfecte stuk tot het vinden van de beste financi\u00eble oplossingen.\r\n \r\n\u2022 Bij Art Y\u012b zijn we gepassioneerd door kunst en toegewijd om onze klanten het allerbeste te bieden. Sluit u aan bij ons op onze missie om kunst naar de wereld te brengen en ontdek de exclusieve voordelen van het verzamelen van kunst bij ons:\r\n- Ontvang ons gepersonaliseerde lidmaatschapsaanbod voor uw 1e collectie!\r\n- Geniet van gratis wereldwijde kunstverzending\r\n- Heb als eerste toegang tot onze nieuwe kunstwerken & tentoonstellingen\r\n- Woon onze Vernissages & Kunstbeurzen bij met VIP-toegang","description_print":" Gelegen in het Monts des Arts Museum gebied en vlakbij het Brussel-Centraal station en de Grote Markt, is Art Y\u012b een hedendaagse kunstgalerie die jaarlijks miljoenen internationale toeristen ontvangt en kunstverzamelaars van over de hele wereld bedient.\r\n \r\n\u2022 Art Y\u012b biedt een unieke ervaring van hedendaagse kunst uit verschillende culturen. De galerie presenteert een brede selectie van beeldhouwwerken en schilderijen uit Europa en Azi\u00eb. Opgericht door Shuo LIU, heeft Art Y\u012b een rijke erfenis van 40 jaar Belgische galerie.\r\n\r\nOnze 5 categorie\u00ebn\r\n\u2022 Beeldhouwwerken\r\n\u2022 Schilderijen\r\n\u2022 Installatie kunst\r\n\u2022 Keramiek\r\n\u2022 Antiek\r\n\r\n\u2022 Een vorm van samensmelting in de kunst, een reis van traditie naar hedendaags, van oost naar west, leidend tot diversiteit die buiten tijd en ruimte leeft. We bieden een unieke versie van hedendaagse kunst die spreekt tot iedereen in een universele taal. \r\n\r\n\u2022 Of u nu een ervaren verzamelaar bent of pas begint met het verkennen van de kunstwereld, voor professionele doeleinden of priv\u00e9verzameling, we hebben iets te bieden. Onze collectie omvat een diverse selectie van hoogwaardige kunstwerken, vari\u00ebrend van hedendaagse tot traditionele stukken. We stellen elke kunstwerk zorgvuldig samen om ervoor te zorgen dat het voldoet aan onze hoge normen van kwaliteit en excellentie.\r\n \r\n\u2022 Bij Art Y\u012b, naast onze uitzonderlijke collectie, zijn we toegewijd aan het bieden van een onge\u00ebvenaarde ervaring aan onze klanten. Het verwerven van een kunstwerk is een uniek moment. Om deze magie mogelijk te maken, biedt Art Y\u012b verschillende financieringsoplossingen zoals Art Leasing en\/of Art Renting met een koopoptie die het best past bij het professionele profiel en voordelen biedt om kunst te verwerven. Ons team van experts staat altijd klaar om persoonlijke begeleiding en ondersteuning te bieden, van het selecteren van het perfecte stuk tot het vinden van de beste financi\u00eble oplossingen.\r\n \r\n\u2022 Bij Art Y\u012b zijn we gepassioneerd door kunst en toegewijd om onze klanten het allerbeste te bieden. Sluit u aan bij ons op onze missie om kunst naar de wereld te brengen en ontdek de exclusieve voordelen van het verzamelen van kunst bij ons:\r\n- Ontvang ons gepersonaliseerde lidmaatschapsaanbod voor uw 1e collectie!\r\n- Geniet van gratis wereldwijde kunstverzending\r\n- Heb als eerste toegang tot onze nieuwe kunstwerken & tentoonstellingen\r\n- Woon onze Vernissages & Kunstbeurzen bij met VIP-toegang","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com\/nl\/","visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":39896,"location":{"lat":50.84475553,"lon":4.35527958},"is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/80ef0b41769ae3258d40fb14a994d92b1a4db941.jpg","width":2048,"height":189