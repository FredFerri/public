n je leven lang. Van beginners tot meesters, van 3 tot 99 jaar... Iedereen is welkom aan onze borden.","longdescr":"Muntpunt Schaakclub is een wekelijkse bijeenkomst voor schaakliefhebbers van alle leeftijden.Samen schaken bevordert je concentratievermogen, leert je vooruit denken, oplossingen vinden, beslissingen nemen onder druk, vindingrijk zijn en creatief denken. Schaakboeken, beroemde partijen, analyses en toernooien komen ook aan bod.\n\nDaarnaast kan je elke eerste woensdag van de maand een voedselpakket van het Groot Eiland winnen als\u00a0je\u00a0aanschuift bij de schaakborden van de Muntpunt schaakclub!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.577172"}},"place":{"id":267757,"translations":{"de":{"name":"Muntpunt, Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Muntpunt, Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Muntpunt, Agora 0","address_street_name":"Place de la Monnaie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"addr