ight_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700006932,"date_start":"2025-03-21","date_end":"2025-03-23","date_next":"2025-03-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-11T12:22:02+01:00","published_at":"2025-02-20T16:13:43+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":318695,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"foire","ranking":0.6933612743506347,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":70,"translations":{"de":"Messe & Ausstellung","pt":null,"en":"Fairs and shows","it":"Fiere ed esposizioni","cn":null,"fr":"Foire & salon","sp":"Feria y exhibici\u00f3n","nl":"Beurzen & salons"}},"others":{}},"translations":{"de":{"name":"BIKE BRUSSELS 2025 \/ Expo \/ Urban Mobility","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"eb@bike-expo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006932"},"pt":{"name":"BIKE BRUSSELS 2025 \/ Expo \/ Urban Mobility","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"eb@bike-expo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006932"},"en":{"name":"BIKE BRUSSELS 2025 \/ Expo \/ Urban Mobility","shortdescr":"Bike Brussels 2025, the fair for cycling and sustainable mobility, runs from March 21-23 at Tour & Taxis. Test e-bikes, cargo bikes, and accessories, enjoy workshops and activities. A must-attend event for enthusiasts, families, and professionals driving the cycling transition!","longdescr":"Bike Brussels 2025, the must-attend fair for cycling and sustainable urban mobility, returns from March 21 to 23, 2025 at the Gare Maritime \u2013 Tour & Taxis, Brussels. Showcasing the latest trends, the event highlights e-bikes, cargo bikes, urban bikes, foldable models, and longtails, along with accessories and active mobility solutions.\n\nWhat to expect:\n- Over 120 exhibitors presenting innovations, equipment, and services.\n- Hands-on workshops and activities to explore the latest cycling trends.\n- Indoor & outdoor test tracks to try out bikes, cargo bikes, and accessories.\n- Fun activities for all ages, including interactive test rides and engaging experiences.\n\nPractical info:\n- Location: Gare Maritime \u2013 Tour & Taxis, Brussels\n- Dates: March 21-23, 2025\n- Tickets: Pricing and registration at www.bike-brussels.be\n- Access: Prefer public transport (train, tram, metro, bike)\n\nWhether you\u2019re a cycling enthusiast, a family, or a professional, Bike Brussels 2025 is the perfect event to explore the future of sustainable mobility!","performers":"Etienne Bertrand, the evolution of the urban cycling sector.","boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/en\/","email":"eb@bike-expo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006932"},"it":{"name":"BIKE BRUSSELS 2025 \/ Expo \/ Urban Mobility","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"eb@bike-expo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006932"},"cn":{"name":"BIKE BRUSSELS 2025 \/ Expo \/ Urban Mobility","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"eb@bike-expo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006932"},"fr":{"name":"BIKE BRUSSELS 2025 \/ Salon \/ Mobilit\u00e9 Urbaine","shortdescr":"Bike Brussels 2025, le salon du v\u00e9lo et de la mobilit\u00e9 durable, revient du 21 au 23 mars \u00e0 Tour & Taxis. Testez v\u00e9los \u00e9lectriques, cargo-bikes et accessoires, profitez d\u2019ateliers et animations. Un \u00e9v\u00e9nement cl\u00e9 pour passionn\u00e9s, familles et professionnels engag\u00e9s dans la transition cyclable !","longdescr":"Bike Brussels 2025, le salon incontournable du v\u00e9lo et de la mobilit\u00e9 urbaine durable, revient du 21 au 23 mars 2025 \u00e0 la Gare Maritime \u2013 Tour & Taxis, Bruxelles. V\u00e9ritable vitrine des derni\u00e8res tendances, l\u2019\u00e9v\u00e9nement met en avant v\u00e9los \u00e9lectriques, cargo-bikes, v\u00e9los urbains, pliables et longtails, ainsi que les accessoires et solutions de mobilit\u00e9 active.\n\nCe que vous y trouverez :\n- Plus de 120 exposants pr\u00e9sentant innovations, \u00e9quipements et services.\n- Des ateliers pratiques et animations pour d\u00e9couvrir les nouvelles tendances du v\u00e9lo.\n- Des pistes d\u2019essai indoor & outdoor pour tester v\u00e9los, cargo-bikes et \u00e9quipements.\n- Des animations pour toute la famille, avec parcours ludiques et tests interactifs.\n\nInfos pratiques :\n- Lieu : Gare Maritime \u2013 Tour & Taxis, Bruxelles\n- Dates : 21-23 mars 2025\n- Billetterie : Tarifs et inscriptions sur www.bike-brussels.be\n- Acc\u00e8s : Privil\u00e9giez les transports en commun (train, tram, m\u00e9tro, v\u00e9lo)\n\nQue vous soyez cycliste passionn\u00e9, famille ou professionnel, Bike Brussels 2025 est le rendez-vous id\u00e9al pour explorer l\u2019avenir de la mobilit\u00e9 douce !","performers":"Etienne Bertrand, l'\u00e9volution du secteur v\u00e9lo urbain.","boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"eb@bike-expo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006932"},"sp":{"name":"BIKE BRUSSELS 2025 \/ Expo \/ Urban Mobility","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be\/fr\/","email":"eb@bike-expo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006932"},"nl":{"name":"BIKE BRUSSELS 2025 \/ Beurs \/ Stedelijke mobiliteit","shortdescr":"Bike Brussels 2025, de beurs voor fietsen en duurzame mobiliteit, vindt plaats van 21 tot 23 maart in Tour & Taxis. Test e-bikes, bakfietsen en accessoires, geniet van workshops en animaties. D\u00e9 afspraak voor liefhebbers, gezinnen en professionals in de fietstransitie!","longdescr":"Bike Brussels 2025, de onmisbare fiets- en duurzame mobiliteitsbeurs, keert terug van 21 tot 23 maart 2025 in de Gare Maritime \u2013 Tour & Taxis, Brussel. Dit evenement zet de nieuwste trends in de kijker: elektrische fietsen, bakfietsen, stadsfietsen, plooifietsen en longtails, evenals accessoires en oplossingen voor actieve mobiliteit.\n\nWat u kunt verwachten:\n- Meer dan 120 exposanten met de nieuwste innovaties, uitrusting en diensten.\n- Praktische workshops en animaties om de nieuwste fietstrends te ontdekken.\n- Indoor & outdoor testparcours om fietsen, bakfietsen en accessoires uit te proberen.\n- Animaties voor jong en oud, inclusief leuke parcours en interactieve tests.\n\nPraktische info:\n- Locatie: Gare Maritime \u2013 Tour & Taxis, Brussel\n- Data: 21-23 maart 2025\n- Tickets: Prijzen en registratie op www.bike-brussels.be\n- Bereikbaarheid: Kom bij voorkeur met het openbaar vervoer (trein, tram, metro, fiets)\n\nOf u nu een fietsliefhebber, een gezin of een professional bent, Bike Brussels 2025 is d\u00e9 plek om de toekomst van zachte mobiliteit te ontdekken!","performers":"Etienne Bertrand, de evolutie van de stedelijke fietsector.","boxoffice_url":null,"website":"https:\/\/www.bikebrussels.be","email":"eb@bike-expo.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006932"}},"place":{"id":279735,"translations":{"de":{"name":"Food Market- Gare Maritime- Tour & Taxis","address_street_name":"Rue Picard ","address_street_number":"9","address_street_box":null,"email":"bojohnson@spacefungame.com","website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard , 9","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Food Market- Gare Maritime- Tour & Taxis","address_street_name":"Rue Picard ","address_street_number":"9","address_street_box":null,"email":"bojohnson@spacefungame.com","website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard , 9","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Food Market- Gare Maritime- Tour & Taxis","address_street_name":"Rue Picard ","address_street_number":"9","address_street_box":null,"email":"bojohnson@spacefungame.com","website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard , 9","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit