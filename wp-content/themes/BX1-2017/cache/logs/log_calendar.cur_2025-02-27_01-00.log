lse},"friday":{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:00:00"}]}},"translations":{"en":["monday, tuesday, wednesday and thursday: closed","friday and saturday: from 14:00 to 18:00","sunday: from 14:00 to 17:00"],"fr":["lundi, mardi, mercredi et jeudi: ferm\u00e9","vendredi et samedi: de 14:00 \u00e0 18:00","dimanche: de 14:00 \u00e0 17:00"],"nl":["maandag, dinsdag, woensdag en donderdag: gesloten","vrijdag en zaterdag: van 14:00 tot 18:00","zondag: van 14:00 tot 17:00"]},"date_start":"2025-01-23","date_end":"2025-03-02","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2025-01-23","end":"21:00:00","start":"18:00:00","timestamp":"2025-01-23T18:00:00"}},{"id":5700006631,"date_start":"2025-02-28","date_end":"2025-04-20","date_next":"2025-02-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-13T12:07:02+01:00","published_at":"2025-02-13T11:58:42+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":318270,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2679161449185622,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[41,36],"translations":{"de":["Installation, Performance","Museen & Kunstzentren"],"pt":[null,null],"en":["Installation, performance","Museums and art centers"],"it":["Installazioni, performance","Musei e centri artistici"],"cn":[null,null],"fr":["Installation, performance","Mus\u00e9es et art centers"],"sp":["Instalaci\u00f3n, performance","Museos y centros de arte"],"nl":["Installatie, performance","Musea en kunstcentra"]}}},"translations":{"de":{"name":"01L():{Liquid Larvae Robot Specimens}","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006631"},"pt":{"name":"01L():{Liquid Larvae Robot Specimens}","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006631"},"en":{"name":"01L():{Liquid Larvae Robot Specimens}","shortdescr":"Immersion cooling is an emerging technology increasingly used in data centers. All the computers are submerged in a special oil. In an early exploration of this new environment, Igor will present larval-state robot creatures in the process of becoming.","longdescr":"Immersion cooling is an emerging technology increasingly used in data centers. All the computers are submerged in a special oil, a supposedly more efficient cooling solution than \u201ctraditional\u201d air conditioning and ventilation. Since oil lacks the corrosive effects of oxygen, it is in a sense a more suitable environment for electrical and mechanical components.\n\nThis begs the question: if the data centers of the future are going to be submerged in oil, possibly in more and more compact ways, would this eventually prevent humans from direct physical access to the machines? Will maintenance jobs be relegated to robotic fish, crabs or trilobites? Pre-historic species re-emerging in a \u201cpost-historical\u201d world? On the other side, will hackers devise a saboteur counterpart - e.g. bionic eels that could insert a usb-stick somewhere, or mechanical lobsters that cut wires here and there? It could become a sort of ecosystem of artificial sea-creatures, autonomous and remotely controlled, living and reproducing in oil.\n\nIn an early exploration of this new environment, Igor will present larval-state robot creatures in the process of becoming.\n\n***\nJoin us at Constant\u2019s office for the opening of this installation on Thursday 27 February 2025 from 18:00 on!\n***\n\nIgor Bobeldijk experiments with robot prototypes, physical interfaces, and code. His works highlight the science fiction condition of today, often referencing the absurd. Submarine cables, data centers immersed in oil, and robot warehouses are examples of the real infrastructure of this moment. Igor uses discarded electronics and basic materials in an attempt to get a head start on the future while mimicking these inaccessible high-tech forms.\n\nThis installation is part of Constant_V, a series of small exhibitions in the window of our office.","performers":"Igor Bobeldijk (artist)","boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006631"},"it":{"name":"01L():{Liquid Larvae Robot Specimens}","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006631"},"cn":{"name":"01L():{Liquid Larvae Robot Specimens}","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006631"},"fr":{"name":"01L():{Liquid Larvae Robot Specimens}","shortdescr":"Le refroidissement par immersion est une technologie \u00e9mergente de plus en plus utilis\u00e9e dans les data centers. Tous les ordinateurs sont immerg\u00e9s dans une huile sp\u00e9ciale. Dans une premi\u00e8re exploration de ce nouvel environnement, Igor pr\u00e9sentera, dans la vitrine de Constant, des cr\u00e9atures robotiques \u00e0 l\u2019\u00e9tat larvaire en cours de formation.","longdescr":"Le refroidissement par immersion est une technologie \u00e9mergente de plus en plus utilis\u00e9e dans les data centers. Tous les ordinateurs sont immerg\u00e9s dans une huile sp\u00e9ciale, une solution de refroidissement suppos\u00e9e plus efficace que la climatisation et la ventilation \u00ab traditionnelles \u00bb. L\u2019huile n\u2019ayant pas les effets corrosifs de l\u2019oxyg\u00e8ne, elle constitue en quelque sorte un environnement plus appropri\u00e9 pour les composants \u00e9lectriques et m\u00e9caniques.\n\nUne question se pose alors : si les data centers du futur sont immerg\u00e9s dans l\u2019huile, \u00e9ventuellement de mani\u00e8re de plus en plus compacte, cela emp\u00eachera-t-il un jour l\u2019homme d\u2019avoir un acc\u00e8s physique direct aux machines ? Les t\u00e2ches de maintenance seront-elles rel\u00e9gu\u00e9es \u00e0 des robots poissons, crabes ou trilobites ? Des esp\u00e8ces pr\u00e9historiques r\u00e9apparaissant dans un monde \u00ab post-historique \u00bb ? D\u2019un autre c\u00f4t\u00e9, les pirates informatiques pourront imaginer des homologues de sabotage - par exemple des anguilles bioniques capables d\u2019ins\u00e9rer une cl\u00e9 USB quelque part, ou des homards m\u00e9caniques capables de couper des c\u00e2bles ici et l\u00e0 ? Il pourrait s\u2019agir d\u2019une sorte d\u2019\u00e9cosyst\u00e8me de cr\u00e9atures marines artificielles, autonomes et contr\u00f4l\u00e9es \u00e0 distance, vivant et se reproduisant dans le p\u00e9trole.\n\nDans une premi\u00e8re exploration de ce nouvel environnement, Igor pr\u00e9sentera des cr\u00e9atures robotiques \u00e0 l\u2019\u00e9tat larvaire en cours de formation.\n\n***\nRendez-vous pour le vernissage de cette installation dans le bureau de Constant le jeudi 27 f\u00e9vrier 2025 d\u00e8s 18h00 !\n***\n\nIgor Bobeldijk exp\u00e9rimente avec des prototypes de robots, des interfaces physiques et du code. Ses \u0153uvres mettent en \u00e9vidence la condition de science-fiction d\u2019aujourd\u2019hui, en faisant souvent r\u00e9f\u00e9rence \u00e0 l\u2019absurde. Les c\u00e2bles sous-marins, les centres de donn\u00e9es immerg\u00e9s dans le p\u00e9trole et les entrep\u00f4ts robotis\u00e9s sont des exemples de l\u2019infrastructure r\u00e9elle de notre \u00e9poque. Igor utilise de l\u2019\u00e9lectronique et des mat\u00e9riaux de base mis au rebut pour tenter de prendre une longueur d\u2019avance sur l\u2019avenir tout en imitant ces formes high-tech inaccessibles.\n\nCette installation fait partie de Constant_V, une s\u00e9rie d\u2019expositions \u00e0 petite \u00e9chelle dans la vitrine de notre bureau.","performers":"Igor Bobeldijk (artiste)","boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006631"},"sp":{"name":"01L():{Liquid Larvae Robot Specimens}","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006631"},"nl":{"name":"01L():{Liquid Larvae Robot Specimens}","shortdescr":"Immersiekoeling is een opkomende technologie die steeds vaker wordt gebruikt in datacentra. Alle computers worden ondergedompeld in een speciale olie. In een vroege verkenning van deze nieuwe omgeving zal Igor in de vitrine van Constant robotwezens in larvestadium presenteren die zich bevinden in het proces van verwezenlijking.","longdescr":"Immersiekoeling is een opkomende technologie die steeds vaker wordt gebruikt in datacentra. Alle computers worden ondergedompeld in een speciale olie, een zogenaamd effici\u00ebntere koeloplossing dan \"traditionele\" airconditioning en ventilatie. Omdat olie niet de corrosieve effecten van zuurstof kent, is het in zekere zin een geschiktere omgeving voor elektrische en mechanische onderdelen.\n\nDit roept de vraag op: als de datacenters van de toekomst ondergedompeld worden in olie, mogelijk op steeds compactere manieren, zou dit uiteindelijk mensen ervan weerhouden om rechtstreeks fysiek toegang te krijgen tot de machines? Worden onderhoudswerkzaamheden gedelegeerd aan robotachtige vissen, krabben of trilobieten? Prehistorische soorten die opnieuw opduiken in een \"posthistorische\" wereld? Aan de andere kant, zullen hackers een saboteur-tegenhanger bedenken - bijvoorbeeld bionische palingen die ergens een usb-stick in kunnen steken, of mechanische kreeften die hier en daar draden doorknippen? Het zou een soort ecosysteem kunnen worden van kunstmatige zeedieren, autonoom en op afstand bestuurbaar, die leven en zich voortplanten in olie.\n\nIn een vroege verkenning van deze nieuwe omgeving zal Igor robotwezens in larvestadium presenteren die zich bevinden in het proces van verwezenlijking.\n\n***\nKom naar de opening van deze installatie in het kantoor van Constant op donderdag 27 februari 2025 vanaf 18u!\n***\n\nIgor Bobeldijk experimenteert met robot prototypen, fysieke interfaces en code. Zijn werken benadrukken de sciencefictionconditie van vandaag, waarbij ze vaak verwijzen naar het absurde. Onderzeekabels, oliegekoelde datacentra, en robot warenhuizen zijn voorbeelden van de werkelijke infrastructuur van dit moment. Igor gebruikt weggeworpen elektronica en simpele materialen in een poging een voorsprong te krijgen op de toekomst door deze ontoegankelijke hightechvormen na te bootsen.\n\nDeze installatie maakt deel uit van Constant_V, een reeks kleinschalige tentoonstellingen in het raam van ons kantoor.","performers":"Igor Bobeldijk (kunstenaar)","boxoffice_url":null,"website":"https:\/\/constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006631"}},"place":{"id":243917,"translations":{"de":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Constant","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 