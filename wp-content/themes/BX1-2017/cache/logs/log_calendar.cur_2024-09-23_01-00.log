 donner un r\u00e9sultat doux et subtil de deux moments d'intervention non coordonn\u00e9s.","performers":"Fais le trottoir ASBL","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010422"},"sp":{"name":"Visite guid\u00e9e - effa\u00e7age et graffiti","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010422"},"nl":{"name":"Effa\u00e7age et graffiti","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010422"}},"place":{"last_updated_at":"2024-05-02T23:01:10+02:00","published_at":"2013-10-19T01:22:45+02:00","id":245448,"translations":{"de":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Various places in Brussels","address_street_name":null,"address_street_number":null,"addr