les-traces-de-karl-marx\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006314"},"en":{"name":"Visite guid\u00e9e : Sur les Traces de Karl Marx","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006314"},"it":{"name":"Visite guid\u00e9e : Sur les Traces de Karl Marx","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006314"},"cn":{"name":"Visite guid\u00e9e : Sur les Traces de Karl Marx","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006314"},"fr":{"name":"Visite guid\u00e9e : Sur les Traces de Karl Marx","shortdescr":"Entre 1845 et 1848, la famille Marx s\u00e9journe \u00e0 Bruxelles. Pendant son s\u00e9jour, Karl Marx \u00e9crit, en compagnie Friedrich Engels, plusieurs livres, dont le Manifeste du Parti Communiste. Ce dernier est devenu la base du socialisme mondial.\n\nSuivez le philosophe et l\u2019\u00e9volution de sa pens\u00e9e dans les rues de Bruxelles. ","longdescr":"Cette promenade nous conduit \u00e0 travers le centre de Bruxelles le long des rues et des places o\u00f9 Marx a s\u00e9journ\u00e9 et travaill\u00e9.\nCette balade est aussi une immersion dans la toute jeune Belgique, tout juste ind\u00e9pendante. \u00c0 cette \u00e9poque de capitalisme d\u00e9complex\u00e9, ce tout petit pays \u00e9tait la deuxi\u00e8me puissance industrielle du monde !\n\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\nInd\u00e9sirable en Allemagne et en France en raison de ses id\u00e9es, Karl Marx s\u2019exile \u00e0 Bruxelles en 1845, alors terre d\u2019asile pour les r\u00e9volutionnaires. La Belgique lui offre un titre de s\u00e9jour \u00ab \u00e0 la conditon qu\u2019il ne publie pas sur la situation politique actuelle \u00bb. Marx, accompagn\u00e9 de son ami Engels, y \u00e9crira n\u00e9anmoins une des oeuvres phares de sa vie de philosophe : Le Manifeste du Parti Communiste !\n\nLe bouillonnement de la ville, son terreau r\u00e9volutionnaire, mais aussi le tournant capitaliste que prend la soci\u00e9t\u00e9 feront du s\u00e9jour belge de Marx un tournant dans sa pens\u00e9e et dans son travail.\n\nCette promenade nous conduit \u00e0 travers le centre de Bruxelles le long des rues et des places o\u00f9 Marx a s\u00e9journ\u00e9 et travaill\u00e9.\n\nAu programme de la balade, entre autres :\n\u2013 Les Galeries Saint Hubert au milieu du 19\u00e8me si\u00e8cle\n\u2013 Son s\u00e9jour pr\u00e8s de la cath\u00e9drale Sainte Gudule\n\u2013 Place Royale: son contact avec les r\u00e9volutionnaires de la r\u00e9volution Belge\n\u2013 Les discussion qu\u2019il menait sur un appartement au Grand Sablon\n\u2013 Son arrestation et expulsion \u00e0 la prison Amigo\n\nBalade \u00e0 disponibilit\u00e9 r\u00e9duite. Le guide qui vous accompagne, jeune retrait\u00e9 et sp\u00e9cialiste de Marx, n\u2019est pas \u00e0 Bruxelles \u00e0 temps plein : Pensez \u00e0 r\u00e9server bien \u00e0 l\u2019avance !\n\n","performers":"Hendrick Vermeersch, sp\u00e9cialiste de Karl Marx","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006314"},"sp":{"name":"Visite guid\u00e9e : Sur les Traces de Karl Marx","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006314"},"nl":{"name":"Visite guid\u00e9e : Sur les Traces de Karl Marx","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006314"}},"place":{"id":50001075,"translations":{"de":{"name":"Brussels By Foot","address_street_name":"\u00c0 la jonction entre la Galerie de la Reine et la Galerie du Roi (devant le restaurant \u00ab Le Marmiton \u00bb)","address_street_number":null,"address_street_box":null,"email":"info@brusselsbyfoot.com","website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","phone_contact":"+32 472 39 82 17","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"\u00c0 la jonction entre la Galerie de la Reine et la Galerie du Roi (devant le restaurant \u00ab Le Marmiton \u00bb)","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Brussels By Foot","address_street_name":"\u00c0 la jonction entre la Galerie de la Reine et la Galerie du Roi (devant le restaurant \u00ab Le Marmiton \u00bb)","address_street_number":null,"address_street_box":null,"email":"info@brusselsbyfoot.com","website":"https:\/\/br