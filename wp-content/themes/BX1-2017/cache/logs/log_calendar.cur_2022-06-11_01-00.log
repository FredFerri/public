":"2022-04-19T11:10:00+02:00","backoffice_id":252152,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25687154396614},{"id":529945,"date_start":"2022-03-25","date_end":"2022-06-26","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Piss & Love","shortdescr":"En \u00e9cho \u00e0 l\u2019exposition \"Oh ! \u00c7a ne coule pas de source\", le projet \u201cPiss and Love\u201d vient se nicher dans un \u00ab petit coin \u00bb de La Fonderie et approche la question des toilettes publiques dans l\u2019espace urbain bruxellois, en m\u00ealant photographie et art plastique, intrigue et revendication.","longdescr":"En \u00e9cho \u00e0 l\u2019exposition Oh ! \u00c7a ne coule pas de source, le projet \u201cPiss and Love\u201d vient se nicher dans un \u00ab petit coin \u00bb de La Fonderie et approche la question des toilettes publiques dans l\u2019espace urbain bruxellois, en m\u00ealant photographie et art plastique, intrigue et revendication.\r\n\r\nVenez donc admirer les photographies de Patrice Niset et les incroyables carnets de dessins rassembl\u00e9s par Cristina Cerqueira qui officie comme \u201cMadame Pipi\u201d au Beursschouwburg\u201d. Le graffeur Danger Dan contribue \u00e0 faire dialoguer ces oeuvres au travers d\u2019une direction artistique de l\u2019expo et d\u2019une signal\u00e9tique percutante.\r\n\r\nL\u2019inauguration de cette exposition aura lieu le vendredi 25 mars \u00e0 18h30. Tout un chacun est le bienvenu, sans r\u00e9servation !\r\n\r\nPlus d'infos sur l'expo : https:\/\/bit.ly\/37IWyGH","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lafonderie.be\/2022\/02\/28\/piss-love\/","email":"parcours@lafonderie.be","phone_contact":null,"phone_booking":"+32 2 410 99 50","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529945.html"},"nl":{"name":"Piss & Love","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529945.html"},"en":{"name":"Piss & Love","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529945.html"},"de":{"name":"Piss & Love","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529945.html"},"it":{"name":"Piss & Love","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529945.html"},"sp":{"name":"Piss & Love","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529945.html"},"pt":{"name":"Piss & Love","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529945.html"},"cn":{"name":"Piss & Love","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529945.html"}},"place":{"id":214813,"translations":{"fr":{"name":"La Fonderie - Mus\u00e9e bruxellois des industries et du travail","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"La Fonderie propose depuis pr\u00e8s de 30 ans des visites guid\u00e9es en ville, en bateau et \u00e0 pied. R\u00e9guli\u00e8rement mises \u00e0 jour, et compl\u00e9t\u00e9es chaque ann\u00e9e de nouveaux th\u00e8mes ou dispositifs, ces visites ont fait notre renomm\u00e9e et drainent chaque ann\u00e9e plusieurs milliers de visiteurs. \r\n\r\nAllant des enfants  jusqu\u2019aux groupes de seniors, le public vis\u00e9 par nos parcours est large. La plupart des visites sont disponibles \u00e0 la fois selon un calendrier fix\u00e9 pour les individuels et familles, et pour les groupes sur demande. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"La Fonderie - Brussels museum voor arbeid en industrie","address_street_name":"Ransfortstraat 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Ransfortstraat 27, 27","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Hebt u wat tijd om op ontdekkingstocht te gaan in Brussel? Zin om de hoofdstad op een originele manier te verkennen? Dan zijn onze rondleidingen beslist iets voor u!\r\nDeze stadsroutes met verschillende thema's behandelen kwesties die diep geworteld zitten in het verleden, maar waarvan het heden ons dagelijks interpelleert: wie arbeid of industrie zegt, spreekt meteen ook over stedelijke groei, immigratie, sociale hulp, woningen. Sommige bezoeken zijn geconcentreerd op een wijk, andere gaan over economische, politieke of sociale kwesties. Er zijn een twintigtal routes voor een gevarieerd publiek beschikbaar in meerdere talen. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Fonderie - Brussels museum of work and industry","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":" La Fonderie's tour guides invite visitors to discover Brussels so they may better understand and analyse the city.\r\nThe urban guided tours with their varied themes address questions deeply rooted in the past but which relate to modern, everyday life such as: work, industrial techniques, urban growth, immigration, social welfare and housing. Some visits concentrate on a neighbourhood; others ask questions related to economic, political or social issues. More than twenty tours are available in several languages for a large and diverse public.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"La Fonderie - Br\u00fcsseler Museum f\u00fcr Industrie und Arbeit","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"La Fonderie bietet seit rund 30 Jahren Stadtf\u00fchrungen mit dem Schiff oder zu Fu\u00df. Das j\u00e4hrlich erneuerte und erweiterte Programm bietet eine gro\u00dfe Themenvielfalt, die zahlreiche Besucher anzieht. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La Fonderie","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"La Fonderie - Museo de la Industria y del Trabajo de Bruselas","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Desde hace casi 30 a\u00f1os, la Fonderie ofrece visitas guiadas de la ciudad, tanto en barco como a pie. Estas visitas, que son famosas y atraen a varios miles de visitantes al a\u00f1o, se actualizan con regularidad y se completan todos los a\u00f1os con nuevos temas o dispositivos. El p\u00fablico objetivo de estas rutas es amplio: desde ni\u00f1os hasta grupos de adultos. La mayor\u00eda de las visitas est\u00e1n disponibles tanto para individuos y familias como para grupos que los soliciten.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La Fonderie - Mus\