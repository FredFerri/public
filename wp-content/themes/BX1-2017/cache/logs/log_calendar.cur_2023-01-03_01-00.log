":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"L\u2019invitation Au Voyage","shortdescr":"Une performance hybride qui r\u00e9unit les mondes de trois artistes : l\u2019histoire de trois amis qui s\u2019inspirent de leurs diff\u00e9rences pour recr\u00e9er un langage musical unique.","longdescr":"Ouvrant le concert par L\u2019invitation au voyage d\u2019Henri Duparc, Camille Bordet (mezzo-soprano) et J\u00e9r\u00f4me Bertier (pianiste) donnent le ton d\u2019un p\u00e9riple \u00e0 travers les \u00e9poques, les styles et les pays. Aux m\u00e9lodies pour chant et piano des compositeurs fran\u00e7ais r\u00eavant d\u2019Orient, r\u00e9pond par ses r\u00e9cits le kamancheh de Mostafa Taleb. Peu \u00e0 peu se forme un trio qui improvise, chacun dans son langage, autour de pi\u00e8ces issues du r\u00e9pertoire persan et de la musique ancienne europ\u00e9enne. Cette performance hybride r\u00e9unit les mondes des trois artistes : l\u2019histoire de trois amis qui s\u2019inspirent de leurs diff\u00e9rences pour recr\u00e9er un langage musical unique.","performers":"Camille Bordet (mezzo-soprano), Mostafa Taleb (kamancheh) et J\u00e9r\u00f4me Bertier (Piano\u00e0","boxoffice_url":null,"website":"https:\/\/www.jardinmusical.org\/infos-evenement\/camille-bordet-mostafa-taleb-jerome-bertier","email":"info@jardinmusical.org","phone_contact":"+32 456 04 35 05","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547926"},"nl":{"name":"L\u2019invitation Au Voyage","shortdescr":"Een hybride voorstelling dat de werelden van drie kunstenaars samenbrengt: het verhaal van drie vrienden die zich laten inspireren door hun verschillen om een unieke muzikale taal te vormen.","longdescr":"Camille Bordet (mezzosopraan) en J\u00e9r\u00f4me Bertier (pianist) openen het concert met L'invitation au voyage van Henri Duparc en zetten de toon voor een reis door tijdperken, stijlen en landen. De melodie\u00ebn voor zang en piano van Franse componisten die dromen van de Oosterse wereld worden beantwoord door de kamancheh van Mostafa Taleb. Gaandeweg ontstaat een trio, dat elk in zijn eigen taal improviseert rond stukken uit het Perzische repertoire en de vroeg-Europese muziek. Deze hybride voorstelling brengt de werelden van de drie kunstenaars samen: het verhaal van drie vrienden die zich laten inspireren door hun verschillen om een unieke muzikale taal te vormen.","performers":"Camille Bordet (mezzo-sopraan) , Mostafa Taleb (kamancheh) en J\u00e9r\u00f4me Bertier (piano)","boxoffice_url":null,"website":null,"email":"info@jardinmusical.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547926"},"en":{"name":"L\u2019invitation Au Voyage","shortdescr":"A hybrid performance that brings the worlds of three artists together : the story of three friends who draw inspiration from their differences to recreate a unique musical language.","longdescr":"Opening the concert with Henri Duparc's L'invitation au voyage, Camille Bordet (mezzo-soprano) and J\u00e9r\u00f4me Bertier (pianist) set the tone for a journey through eras, styles and countries. To the melodies for song and piano of French composers dreaming of the Orient, the kamancheh of Mostafa Taleb responds with its stories. Little by little, a trio is formed that improvises, each in his own language, around pieces from the Persian repertoire and early European music. This hybrid performance brings together the worlds of the three artists: the story of three friends who draw inspiration from their differences to recreate a unique musical language.","performers":"Camille Bordet (mezzo-soprano), Mostafa Taleb (kamancheh) and J\u00e9r\u00f4me Bertier (piano)","boxoffice_url":null,"website":null,"email":"info@jardinmusical.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547926"},"de":{"name":"L\u2019invitation Au Voyage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547926"},"it":{"name":"L\u2019invitation Au Voyage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547926"},"sp":{"name":"L\u2019invitation Au Voyage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547926"},"pt":{"name":"L\u2019invitation Au Voyage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547926"},"cn":{"name":"L\u2019invitation Au Voyage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547926"}},"place":{"id":276657,"translations":{"fr":{"name":"Jardin Musical","ad