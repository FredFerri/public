":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":297853,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.45849784440401103,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"De Stripfabriek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/gallery\/fabrika-bd","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009272"},"pt":{"name":"De Stripfabriek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/gallery\/fabrika-bd","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009272"},"en":{"name":"De Stripfabriek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/gallery\/fabrika-bd","email":"visit@comicscenter.net","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009272"},"it":{"name":"De Stripfabriek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/gallery\/fabrika-bd","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009272"},"cn":{"name":"De Stripfabriek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/gallery\/fabrika-bd","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009272"},"fr":{"name":"Fabrika BD","shortdescr":"Sais-tu ce qu\u2019est une bande dessin\u00e9e ? Et sais-tu comment on la fabrique ? D\u00e9couvre-le gr\u00e2ce \u00e0 la Fabrika BD !","longdescr":"Bienvenue \u00e0 toi, jeune lecteur ou lectrice ! Oui, toi ! Sais-tu ce qu\u2019est une bande dessin\u00e9e ? C\u2019est une histoire en images. Et sais-tu comment on la fabrique ? Pas vraiment, n\u2019est-ce pas ? L\u2019exposition Fabrika BD va te permettre de d\u00e9couvrir les diff\u00e9rentes \u00e9tapes de sa r\u00e9alisation, ses codes mais aussi tous les m\u00e9tiers n\u00e9cessaires pour que la BD arrive jusque dans tes mains.\n\nPour ce voyage, tu seras avec Sam et Snake, deux meilleurs amis et personnages invent\u00e9s par l\u2019autrice de BD Karolina Szejda. Ils t\u2019emm\u00e8neront dans le monde de la bande dessin\u00e9e : de la bulle aux diff\u00e9rents genres, en passant par le sc\u00e9nario et le dessin. Et le meilleur dans tout \u00e7a ? L\u2019exposition est interactive, tu pourras participer au processus de cr\u00e9ation de la BD!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/gallery\/fabrika-bd","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009272"},"sp":{"name":"De Stripfabriek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/gallery\/fabrika-bd","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009272"},"nl":{"name":"De Stripfabriek","shortdescr":"Wat is een stripverhaal? En hoe wordt het eigenlijk gemaakt? Je ontdekt het in de Stripfabriek!","longdescr":"Hey, jij daar! Ja, jij! Weet jij eigenlijk hoe een stripverhaal wordt gemaakt? Nee? Goed nieuws, want je kan het vanaf nu ontdekken in \u201cDe Stripfabriek\u201d, een tentoonstelling waarin je wordt meegenomen in het maakproces van een stripverhaal: van idee tot het boek dat jij in je handen kan houden.\n\nJe trekt op pad met Sam en Snake, twee beste vrienden en personages bedacht door stripauteur Karolina Szejda. Met z\u2019n drie\u00ebn nemen ze jou mee in de stripwereld: je leert alles over tekstbalonnen, de verschillende genres, het scenario en de tekeningen. En het leukste van al? Je mag ook zelf meedenken en -doen!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.stripmuseum.be\/nl\/tentoonstellingen\/gallery\/de-stripfabriek","email":"visit@stripmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009272"}},"place":{"last_updated_at":"2023-07-06T15:38:58+02:00","published_at":"2013-10-19T01:13:30+02:00","id":202864,"translations":{"de":{"name":"Comic-Museum (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!\r\n\r\nGe\u00f6ffnet von Montag bis Sonntag in Juli und August.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"O Centro Belga da Banda Desenhada","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Atra\u00e7\u00e3o incontorn\u00e1vel situada no centro de Bruxelas, o museu da BD comemora mais de 25 anos de autores e her\u00f3is da 9.\u00aa arte.\r\nAs exposi\u00e7\u00f5es permanentes regularmente renovadas e um vasto programa de exposi\u00e7\u00f5es tempor\u00e1rias levam os visitantes a descobrir as in\u00fameras facetas da banda desenhada. Tintim e os Estrumpfes abrem a porta a outras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Comic Strip Museum  (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"http:\/\/www.comicscenter.net\/en\/home","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Sables, 20","address_line2":"1000 Brussels","description_web":"A world full of comics\r\n\r\nAn accomplished attraction located in the heart of Brussels, the Comics Art Museum has been honouring the creators and heroes of the 9th Art for 30 years.\r\nThe regularly renewed permanent exhibitions and a diversified programme of temporary exhibitions \r\nenable visitors to discover the countless aspects of comics art. \r\nFamous characters lead the way towards new adventures, an encounter with a world where creativity has no limits.\r\nEnhanced by an exceptional Art Nouveau home designed by Victor Horta, the Comics Art Museum is just as much a tribute \r\nto the pioneers as a glimpse of contemporary comics art.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo del Fumetto ","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Il Museo del Fumetto CBBD, situato nel cuore storico di Bruxelles, riunisce su pi\u00f9 di 4.000 m\u00b2 tutto ci\u00f2 che riguarda il fumetto. Ospitato in un edificio tempio dell'Art Nouveau disegnato da Victor Horta, il museo \u00e8 il regno di celebri eroi dei fumetti belgi: Tintin, i Puffi, Lucky Luke, Gaston Lagaffe, Blake et Mortimer, Marsupilami... Le esposizioni organizzate, la biblioteca e il centro di documentazione, non solo rendono il museo vivo e dinamico, ma sono veri e propri centri di documentazione sul fumetto il cuicatalogo \u00e8 accessibile on-line. Il centro belga del fumetto organizza conferenze, laboratori creativi ed animazioni, ecc.\r\n\r\n\r\nAperto i giorni festivi eccetto il 25\/12 e 01\/01. Il Centro Belga del Fumetto diverse formule di visita: la visita guidata del museo, quella del Percorso del Fumetto o quella del museo Marc Sleen. Il museo, anzi il centro belga del fumetto-CBBD ospita anche una brasserie dove potete respirare l'inconfondibile atmosfera di Bruxelles.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"The Belgian Comic Strip Center ","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Un monde merveilleux o\u00f9 la BD est Reine\r\nAttraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur le 9e Art depuis plus de 30 ans.\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \r\n\u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite.\r\nDe nombreuses planches originales, des documents in\u00e9dits, des reconstitutions 3D et des jeux sont ainsi rassembl\u00e9s pour vous permettre de passer un bon moment \r\net ravir tous les amateurs et passionn\u00e9s du Neuvi\u00e8me Art de tous \u00e2ges. La dur\u00e9e de la visite est estim\u00e9e \u00e0 environ 1 heure 30, que vous pourrez ensuite poursuivre \u00e0 la Brasserie Horta.\r\nMagnifi\u00e9 par un exceptionnel cadre Art Nouveau con\u00e7u par Victor Horta, le Mus\u00e9e de la Bande Dessin\u00e9e est tout autant un hommage aux pionniers qu'un regard sur la BD actuelle.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Centro belga del c\u00f3mic (CBBD)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Ubicado en el centro de Bruselas, en un edificio Art Nouveau construido por Victor Horta en 1906, el CBBD abri\u00f3 sus puertas el 6 de octubre de 1989. \r\n\r\nEn pocos a\u00f1os, este museo se ha convertido en una de las principales atracciones de Bruselas. \r\n\r\nCada a\u00f1o, m\u00e1s de 200.000 visitantes recorren las exposiciones permanentes y temporales que se celebran en m\u00e1s de 4.000 m 2. \r\n\r\nAunque las exposiciones contribuyen a convertir este templo en un lugar viviente, din\u00e1mico y atrayente, esta herramienta al servicio de la promoci\u00f3n del c\u00f3mic constituye un centro de documentaci\u00f3n moderno, con un cat\u00e1logo accesible online. \r\n\r\nTambi\u00e9n se llevan a cabo conferencias y talleres creativos.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Stripmuseum (Belgisch Stripcentrum)","address_street_name":"Zandstraat","address_street_number":"20","address_street_box":null,"email":"visit@stripmuseum.be","website":"http:\/\/www.stripmuseum.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zandstraat, 20","address_line2":"1000 Brussel","description_web":"Een wondere wereld vol strips\r\n\r\nHet Stripmuseum is een ontmoetingsplek voor alle stripliefhebbers in hartje Brussel.\r\nAan de hand van permanente tentoonstellingen \u2013 die regelmatig vernieuwd worden \u2013 en een afwisselend programma van tijdelijke expo's kan je er \r\nals bezoeker kennismaken met de talrijke facetten van het stripverhaal.\r\nDe Smurfen nemen je mee naar een land vol avonturen, waar de creativiteit geen grenzen kent.\r\nTalrijke originele platen, nooit eerder geziene documenten, decors in 3D en ludieke elementen worden verzameld \r\nom alle fans en liefhebbers van de Negende Kunst te kunnen boeien!\r\nHet uitzonderlijke art nouveau-gebouw van Victor Horta geeft een bezoek nog een extra dimensie. \r\nHet Stripmuseum brengt tegelijk een hommage aan de klassiekers van het medium en een blik op het hedendaagse stripverhaal.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":405,"location":{"lat":50.85107181,"lon":4.36006874},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2023-07-06T15:38:58+02:00","published_at":"2013-10-19T01:13:30+02:00","id":202864,"translations":{"de":{"name":"Comic-Museum (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!\r\n\r\nGe\u00f6ffnet von Montag bis Sonntag in Juli und August.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"O Centro Belga da Banda Desenhada","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Atra\u00e7\u00e3o incontorn\u00e1vel situada no centro de Bruxelas, o museu da BD comemora mais de 25 anos de autores e her\u00f3is da 9.\u00aa arte.\r\nAs exposi\u00e7\u00f5es permanentes regularmente renovadas e um vasto programa de exposi\u00e7\u00f5es tempor\u00e1rias levam os visitantes a descobrir as in\u00fameras facetas da banda desenhada. Tintim e os Estrumpfes abrem a porta a outras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":null,"booking_url":null,"sort_order":nu