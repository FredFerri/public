ull,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006291"},"pt":{"name":"BANAD Festival - Guided tour of Palais de la Folle Chanson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006291"},"en":{"name":"BANAD Festival - Palais de la Folle Chanson","shortdescr":null,"longdescr":"This corner Art Deco apartment building was built in 1928 by Antoine Courtens, and well-deserves its \"palace\" name. The entrance hall's decorative scheme is particularly sophisticated, with its marble and wrought-iron features. The apartment building will host an exhibition by the Artists.B.Collective, including works by Philippe Leblanc, Bettina K\u00fbsel, Jorge de la Torre and Wim Taciturn.\n\nArch. Antoine COURTENS 1928-1932","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006291"},"it":{"name":"BANAD Festival - Guided tour of Palais de la Folle Chanson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006291"},"cn":{"name":"BANAD Festival - Guided tour of Palais de la Folle Chanson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006291"},"fr":{"name":"BANAD Festival - Palais de la Folle Chanson","shortdescr":null,"longdescr":"Cet immeuble d'angle Art D\u00e9co, construit en 1928 par Antoine Courtens, m\u00e9rite bien son appellation de palais. Le hall d'entr\u00e9e pr\u00e9sente une d\u00e9coration particuli\u00e8rement raffin\u00e9e faite de marbres et de ferronneries. Au dernier \u00e9tage, de la coupole \u00e9toil\u00e9e, une vue in\u00e9dite s'offre au visiteur. L'immeuble accueillera une exposition de l'asbl Artists.B.Collective avec Philippe Leblanc, Bettina Kusel, Jorge de la Torre et Wim Taciturn.\n\nArch. Antoine COURTENS 1928-1932","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006291"},"sp":{"name":"BANAD Festival - Guided tour of Palais de la Folle Chanson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006291"},"nl":{"name":"BANAD Festival - Palais de la Folle Chanson","shortdescr":null,"longdescr":"Dit hoekappartementsgebouw in art deco-stijl, gebouwd in 1928 door Antoine Courtens, verdient wel degelijk om een paleis genoemd te worden. In de inkomhal is er een uiterst verfijnde decoratie te zien die gemaakt is van marmersoorten en siersmeedwerk. Op de bovenverdieping krijgt de bezoeker een onge\u00ebvenaard zicht vanuit de sterrenkoepel. In het gebouw zal een tentoonstelling doorgaan van de vzw Artists.B.Collective met Philippe Leblanc, Bettina K\u00fbsel, Jorge de la Torre en Wim Taciturn.\n\n\n\nArch. Antoine COURTENS 1928-1932","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006291"}},"place":{"id":259404,"translations":{"de":{"name":"Palais de la Folle Chanson","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"2","address_street_box":"14","email":"philippe.leblanc@skynet.be","website":null,"phone_contact":"+32 2 644 05 51","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Boulevard G\u00e9n\u00e9ral Jacques, 2 \/ 14","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Palais de la Folle Chanson","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"2","address_street_box":"14","email":"philippe.leblanc@skynet.be","website":null,"phone_contact":"+32 2 644 05 51","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Boulevard G\u00e9n\u00e9ral Jacques, 2 \/ 14","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Palais de la Folle Chanson","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"2","address_street_box":"14","email":"philippe.leblanc@skynet.be","website":null,"phone_contact":"+32 2 644 05 51","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Boulevard G\u00e9n\u00e9ral Jacques, 2 \/ 14","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Palais de la Folle Chanson","address_street_nam