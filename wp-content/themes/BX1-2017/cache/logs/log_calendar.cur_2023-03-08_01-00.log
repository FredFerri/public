,{"day":"2023-06-06","doors":null,"start":"18:00:00","end":"19:00:00"},{"day":"2023-06-13","doors":null,"start":"18:00:00","end":"19:00:00"},{"day":"2023-06-20","doors":null,"start":"18:00:00","end":"19:00:00"},{"day":"2023-06-27","doors":null,"start":"18:00:00","end":"19:00:00"}],"recurring":[{"day":"tuesday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"18:00:00","time_end":"19:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier mardis du mois de 18:00 \u00e0 19:00","nl":"Open op de eerste, tweede, derde, vierde en laatste dinsdags van de maand van 18:00 tot 19:00","en":"Open the first, second, third, fourth and last tuesdays of the month from 18:00 to 19:00","de":"Open the first, second, third, fourth and last tuesdays of the month from 18:00 to 19:00","it":"Open the first, second, third, fourth and last tuesdays of the month from 18:00 to 19:00","sp":"Open the first, second, third, fourth and last tuesdays of the month from 18:00 to 19:00","pt":"Open the first, second, third, fourth and last tuesdays of the month from 18:00 to 19:00","cn":"Open the first, second, third, fourth and last tuesdays of the month from 18:00 to 19:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":4}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"],"de":["Familie"],"it":["Famiglie"],"sp":["Familias"],"pt":[null],"cn":[null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-01T02:36:34+01:00","published_at":"2023-01-03T10:18:31+01:00","backoffice_id":268317,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.15142671606934},{"id":548326,"date_start":"2022-09-13","date_end":"2023-06-27","date_next":"2023-03-07","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport","de":"Sport","it":"Sport","sp":"Deporte","pt":null,"cn":null}},"others":{"list":[159,167],"translations":{"fr":["Activit\u00e9 sportive","Sport traditionnel"],"nl":["Sportieve activiteit","Volkssporten"],"en":["Sporting activity","Traditional sport"],"de":["Sportliche Aktivit\u00e4t","Traditioneller Sport"],"it":["Attivit\u00e0 sportive","Sport tradizionali"],"sp":["Actividad deportiva","Deporte tradicional"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Gymnastique\/Body sculpt Saint-Josse","shortdescr":"Nos cours de gymnastique d'entretien ont pour but d'affiner la silhouette et de tonifier le corps. La gymnastique est aussi un moyen de se d\u00e9fouler apr\u00e8s une journ\u00e9e de travail. Enfin, pour allier exercice et d\u00e9tente, la s\u00e9ance se termine par quelques minutes de stretching et de relaxation. Les cours de gymnastique d'entretien sont donn\u00e9s par des kin\u00e9sith\u00e9rapeutes dipl\u00f4m\u00e9s.","longdescr":"INSCRIPTION \r\n> Le cours se paie :\r\n- Soit 4\u20ac \u00e0 la s\u00e9ance directement au moniteur (hors entr\u00e9e de piscine);\r\n- Soit avec une carte de 10 s\u00e9ances, valable 4 mois \u00e0 dater de la premi\u00e8re s\u00e9ance\r\neffective et jusqu\u2019en juin 2023, co\u00fbtant 32 \u20ac (soit 10 s\u00e9ances pour le prix de 8 s\u00e9ances), qui se commande jusqu\u2019au 24 f\u00e9vrier 2023 (une carte par cours) ;\r\n- Soit avec un abonnement valable de septembre \u00e0 juin, co\u00fbtant 90 \u20ac (soit 36 s\u00e9ances\r\npour le prix de 22 s\u00e9ances), qui s\u2019ach\u00e8te jusqu\u2019au 9 octobre 2022 (un abonnement\r\npar cours).\r\n\r\n> Comment proc\u00e9der ?\r\n- Par e-mail : loisirs.sante@solidaris.be \r\n- Par courrier : rue des Moineaux 17-19, 1000 Bruxelles \r\n\r\nEn mentionnant: nom \/ pr\u00e9nom \/ adresse \/ date de naissance \/ Gsm \/ le(s) cours choisi(s) (commune et horaire) \/ n\u00b0 de membre Loisirs et Sant\u00e9 ou n\u00b0 de mutuelle. \r\nD\u00e8s que vous avez fait votre demande pour une carte de 10 s\u00e9ances ou un abonnement, vous pouvez effectuer le paiement sur le compte de Loisirs et Sant\u00e9 asbl (BE 22 3101 3243 0247) avec en communication libre : votre n\u00b0 de membre, le cours suivi, et la commune. \r\nPr\u00e9sentez votre preuve de paiement au professeur de sport, sinon le tarif \u00e0 la s\u00e9ance vous sera demand\u00e9 et ne sera pas remboursable. L\u2019abonnement ou la carte est envoy\u00e9(e) au moniteur.\r\n\r\n> D\u00e9but et fin des cours\r\nLa saison 2022-2023 reprendra le 12 septembre 2022 et se termine le 30 juin 2023. Les cours ont lieu tous les mardis  sauf pendant les cong\u00e9s scolaires.\r\n\r\n> Remarque\r\nPour la bonne marche des cours, ceux-ci sont strictement r\u00e9serv\u00e9s aux adultes en \u00e2ge d\u2019exercer une activit\u00e9 professionnelle et sont mixtes. \r\n> L'affiliation\r\nL'affiliation peut \u00eatre demand\u00e9e par toute personne en \u00e2ge d'exercer une activit\u00e9 professionnelle.\r\nLa cotisation pour l'affiliation \u00e0 l'asbl Loisirs & Sant\u00e9 est de 50 \u20ac par an (septembre\/juin). Les membres de Solidaris Brabant qui s'affilient \u00e0 l'asbl Loisirs & Sant\u00e9 obtiennent une intervention de 50 \u20ac dans le prix pay\u00e9 pour l'affiliation. De ce fait, l'affiliation \u00e0 l'asbl Loisirs & Sant\u00e9 est gratuite pour les membres.\r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante Vous inscrire implique que vous en ayez pris connaissance.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548326"},"nl":{"name":"Gymnastique\/Body sculpt Saint-Josse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548326"},"en":{"name":"Gymnastique\/Body sculpt Saint-Josse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548326"},"de":{"name":"Gymnastique\/Body sculpt Saint-Josse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.548326"},"it":{"name":"Gymnastique\/Body sculpt Saint-Josse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.548326"},"sp":{"name":"Gymnastique\/Body sculpt Saint-Josse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":