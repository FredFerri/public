 in conjunction with the Brussels tourism office. We practice responsible tourism while respecting the local economy. Our employees are professional guides and we have a team of freelance guides trained in the \u201cHaute \u00c9coles\u201d of Brussels.\r\n\u200bWe work in partnership with local businesses and can call on a range of quality service providers to suit your needs.\r\nWe specialize in providing tailor-made tours, based on the interests of our clients and mindful of the need to balance culture and relaxation.\r\n\u200bOur strengths: experience, local guides, enthusiastic and charismatic staff.\r\nOur values: responsible tourism, professionalism, respect of the historical and cultural heritage, protection of the environment, sustainable competitiveness.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,