":531273,"date_start":"2022-10-16","date_end":"2022-11-13","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Molenbeek : le petit Manchester","shortdescr":"Au XIX\u00e8me si\u00e8cle, Bruxelles fut la deuxi\u00e8me ville la plus industrialis\u00e9e en Europe, juste derri\u00e8re Manchester en Angleterre...","longdescr":"Le Vieux Molenbeek est commun\u00e9ment appel\u00e9 \u201cle petit Manchester belge\u201d. En effet, il fut un temps o\u00f9 Bruxelles \u00e9tait la deuxi\u00e8me ville la plus industrialis\u00e9e au monde - juste derri\u00e8re Manchester, en Angleterre. Et la commune de Molenbeek \u00e9tait l\u2019un des principaux centres industriels de la r\u00e9gion. Usines et fabriques ont ainsi d\u00e9termin\u00e9 l\u2019univers urbain et social de ce territoire jusqu\u2019\u00e0 aujourd\u2019hui. Peu de quartiers ont connu une histoire sociale aussi intense. Des premi\u00e8res coop\u00e9ratives au tissu associatif actuel, Molenbeek pr\u00e9sente une constante ind\u00e9niable : l\u2019importance de ses r\u00e9seaux de solidarit\u00e9. Notre visite guid\u00e9e vous invite \u00e0 explorer le quartier au travers de son histoire et de ses enjeux contemporains.\nNotre visite commencera au Momuse et s\u2019ach\u00e8vera au mus\u00e9e des industries et du travail, dont l\u2019entr\u00e9e aux expositions vous sera offerte.\nTarif normal : 10 euros - tarif seniors, demandeurs d'emploi, \u00e9tudiants : 9 euros","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"parcours@lafonderie.be","phone_contact":null,"phone_booking":"+32 2 410 99 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.531273"},"nl":{"name":"Molenbeek : le petit Manchester","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"parcours@lafonderie.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.531273"},"en":{"name":"Molenbeek : le petit Manchester","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.531273"},"de":{"name":"Molenbeek : le petit Manchester","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"parcours@lafonderie.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.531273"},"it":{"name":"Molenbeek : le petit Manchester","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.531273"},"sp":{"name":"Molenbeek : le petit Manchester","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.531273"},"pt":{"name":"Molenbeek : le petit Manchester","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.531273"},"cn":{"name":"Molenbeek : le petit Manchester","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.531273"}},"place":{"id":270182,"translations":{"fr":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Une commune, c\u2019est avant tout une histoire. Et celle de Molenbeek est loin d\u2019\u00eatre anodine. Le MoMuse est une vitrine du patrimoine historique de la commune, depuis ses origines jusqu\u2019\u00e0 aujourd\u2019hui, avec un accent tout particulier mis sur les XIXe et XXe si\u00e8cles. Le mus\u00e9e permettra aux visiteurs de comprendre l\u2019\u00e9volution de ce petit territoire de quelques 6km2, ayant d\u2019abord connu un d\u00e9veloppement rural durant de nombreux si\u00e8cles, puis une industrialisation intense \u00e0 partir des ann\u00e9es 1840, suivie d\u2019une d\u00e9sindustrialisation non sans cons\u00e9quences, et enfin, \u00e0 l\u2019aube des ann\u00e9es 1960, une croissance urbanistique intense. Autant d\u2019\u00e9v\u00e9nements qui ont profond\u00e9ment modifi\u00e9 les modes de vie et l\u2019essence m\u00eame de la commune.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"MoMuse - Gemeentelijk Museum van Sint-Jans Molenbeek","address_street_name":"Mommaertsstraat","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Mommaertsstraat, 2A","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"De geschiedenis van de gemeente Sint-Jans-Molenbeek is verre van triviaal. Het MoMuse exposeert het historische erfgoed van de gemeente, vanaf zijn ontstaan tot nu, met speciale nadruk op de negentiende en twintigste eeuw. De bezoekers zullen de evolutie doorlopen van dit kleine grondgebied van ongeveer 6 km2, die begint met een eeuwenlange plattelandsontwikkeling, dan een intense industrialisatie vanaf de jaren 1840, gevolgd door een afbouw van de industrialisatie die niet zonder gevolgen is gebleven, en tenslotte, aan het begin van de jaren zestig, een intense stedelijke groei. Al deze gebeurtenissen hebben de levenswijze en de essentie zelve van de gemeente grondig veranderd.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Municipal Museum of Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"The MoMuse exhibits the historical heritage of Molenbeek, from its origins to the present day, with a special emphasis on the 19th and 20th centuries. This small territory of some 6km\u00b2, has evolved over many centuries. From humble rural beginnings, it experienced an intense industrialisation in the 1840s, followed by a deindustrialisation not without consequences, and finally, at the dawn of the 1960s, an intense urban growth. All these events have profoundly changed the way of life, and essence of the commune.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts","address_street_number":"2A","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts, 2A","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[23],"translations":{"fr":["Ouest"],"nl":["West"],"en":["West"]}},"neca":null,"facebook_id":null,"backoffice_id":30182,"location":{"lat":50.85738825,"lon":4.33784505},"region":"brussels","last_updated_at":"2022-10-10T23:05:19+02:00","published_at":"2017-10-16T15:14:36+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":214813,"translations":{"fr":{"name":"La Fonderie - Mus\u00e9e bruxellois des industries et du travail","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"La Fonderie propose depuis pr\u00e8s de 30 ans des visites guid\u00e9es en ville, en bateau et \u00e0 pied. R\u00e9guli\u00e8rement mises \u00e0 jour, et compl\u00e9t\u00e9es chaque ann\u00e9e de nouveaux th\u00e8mes ou dispositifs, ces visites ont fait notre renomm\u00e9e et drainent chaque ann\u00e9e plusieurs milliers de visiteurs. \r\n\r\nAllant des enfants  jusqu\u2019aux groupes de seniors, le public vis\u00e9 par nos parcours est large. La plupart des visites sont disponibles \u00e0 la fois selon un calendrier fix\u00e9 pour les individuels et familles, et pour les groupes sur demande. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"La Fonderie - Brussels museum voor arbeid en industrie","address_street_name":"Ransfortstraat 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Ransfortstraat 27, 27","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Hebt u wat tijd om op ontdekkingstocht te gaan in Brussel? Zin om de hoofdstad op een originele manier te verkennen? Dan zijn onze rondleidingen beslist iets voor u!\r\nDeze stadsroutes met verschillende thema's behandelen kwesties die diep geworteld zitten in het verleden, maar waarvan het heden ons dagelijks interpelleert: wie arbeid of industrie zegt, spreekt meteen ook over stedelijke groei, immigratie, sociale hulp, woningen. Sommige bezoeken zijn geconcentreerd op een wijk, andere gaan over economische, politieke of sociale kwesties. Er zijn een twintigtal routes voor een gevarieerd publiek beschikbaar in meerdere talen. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Fonderie - Brussels museum of work and industry","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":" La Fonderie's tour guides invite visitors to discover Brussels so they may better understand and analyse the city.\r\nThe urban guided tours with their varied themes address questions deeply rooted in the past but which relate to modern, everyday life such as: work, industrial techniques, urban growth, immigration, social welfare and housing. Some visits concentrate on a neighbourhood; others ask questions related to economic, political or social issues. More than twenty tours are available in several languages for a large and diverse public.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"La Fonderie - Br\u00fcsseler Museum f\u00fcr Industrie und Arbeit","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"La Fonderie bietet seit rund 30 Jahren Stadtf\u00fchrungen mit dem Schiff oder zu Fu\u00df. Das j\u00e4hrlich erneuerte und erweiterte Programm bietet eine gro\u00dfe Themenvielfalt, die zahlreiche Besucher anzieht. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La Fonderie","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"La Fonderie - Museo de la Industria y del Trabajo de Bruselas","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Desde hace casi 30 a\u00f1os, la Fonderie ofrece visitas guiadas de la ciudad, tanto en barco como a pie. Estas visitas, que son famosas y atraen a varios miles de visitantes al a\u00f1o, se actualizan con regularidad y se completan todos los a\u00f1os con nuevos temas o dispositivos. El p\u00fablico objetivo de estas rutas es amplio: desde ni\u00f1os hasta grupos de adultos. La mayor\u00eda de las visitas est\u00e1n disponibles tanto para individuos y familias como para grupos que los soliciten.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La Fonderie - Mus\u00e9e bruxellois des industries et du travail","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"La Fonderie - Mus\u00e9e bruxellois des industries et du travail","address_street_name":"Rue Ransfort 27","address_street_number":"27","address_street_box":null,"email":"parcours@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":"+32 2 410 99 50","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort 27, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":522,"location":{"lat":50.85241705,"lon":4.33576794},"region":"brussels","last_updated_at":"2022-10-10T23:05:19+02:00","published_at":"2013-10-19T01:13:36+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/explore-daee8f37329765c5fb2e699873fb40c47b5a798f.jpg","width":1164,"height":582,"ratio":2,"translations":{"fr":{"title":"Molenbeek : le petit Manchester","copyright":null},"nl":{"title":"Molenbeek : le petit Manchester","copyright":null},"en":{"title":"Molenbeek : le petit Manchester","copyright":null}}}],"dates":[{"day":"2022-10-16","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-11-13","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T23:05:19+02:00","published_at":"2022-04-09T03:30:12+02:00","backoffice_id":251273,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":0.41008825631569},{"id":541835,"date_start":"2022-09-18","date_end":"2022-12-11","date_next":"2022-10-16","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Nouvelle Saison 2022-2023  Concerts Escapades","shortdescr":"Apr\u00e8s un petit repos estival, nous avons finalis\u00e9 durant l\u2019\u00e9t\u00e9 le programme de la nouvelle saison, jusqu\u2019\u00e0 la fin de l\u2019ann\u00e9e : \r\nEn septembre, nouvelle salle, nouveau d\u00e9cor, nouvelle saison \u201cEscapades\u201d \u00e0 la Tricoterie.  \r\nLa Tricoterie, l\u2019endroit Saint-Gillois o\u00f9 l\u2019on fabrique des liens sera notre nouveau repaire pour vous pr\u00e9senter quatre concerts de septembre \u00e0 d\u00e9cembre :","longdescr":"Concerts Escapades est une r\u00e9gie du CRIT de l\u2019ASBL l\u2019\u00c9quipe qui organise des concerts de musique classique, en collaboration avec \u201cMusic Project For Brussels\u201d et la prison de Forest.\r\nLe 18 septembre \u00e0 20H30, le premier concert, Lubimov+, nom de l\u2019exceptionnel pianiste russe qui a poursuivi son jeu malgr\u00e9 la police lors d\u2019un concert \u00e0 Moscou le 13 avril dernier. Il nous jouera sans a priori des pi\u00e8ces de Silvestrov compositeur ukrainien, Arvo Part l\u2019estonien, Schubert et Haydn les autrichiens. \r\nNous continuerons avec Joy+ le 16 octobre, avec Yu Sheng Jiang, formant un groupe de jazz avec deux autres acolytes ainsi que le quatuor \u00e0 cordes portugais Quiron.\r\nLe 13 novembre, Belgo+, place aux compositeurs belges Lekeu et Ysaye. \r\nEnfin, le 11 d\u00e9cembre, le concert O+, qui console l\u2019\u00e2me, chasse la m\u00e9lancolie par le rem\u00e8de du oud, du th\u00e9orbe et luth avec Sofie Vanden Eynde et Saad Mahmoud Jawad.","performers":"Concert LUBIMOV+ : Alexei Lubimov (piano) 18 sept\r\nConcert JOY+ : Yusheng Jiang (bass), David Yih-Shiou Sung (Piano), Gionata Giardana (drums), Quiron Quatuor (string quartet) 16 oct\/okt\r\nConcert BELGO+ : Kristie Su (violon), Yu-Fen Chang 13 nov\r\nConcert \u00d4+ : Sofie Vanden Eynde (lute,theorbe) Saad Mahmood Jawad (oud), Vladimir Gorlinsky (new work), Aftab Darvishi (new work), Golden Oldies 11 dec","boxoffice_url":null,"website":"https:\/\/www.mpfb.org\/home.php","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541835"},"nl":{"name":"Nieuw seizoen 2022-2023 Concerts Escapades","shortdescr":"Na een korte zomerstop hebben wij de laatste hand gelegd aan het programma voor de eerste maanden van het nieuwe seizoen: \r\nIn september, nieuwe zaal, nieuw scene, een nieuw seizoen \u201cEscapades\u201d bij La Tricoterie.  \r\nLa Tricoterie, de plaats in Sint-Gillis waar verbinding gebeurt, wordt onze nieuwe ontmoetingsplaats om van september tot december vier concerten voor te stellen:","longdescr":"Concerts Escapades is een concertmanagement van het CRIT van de VZW l'\u00c9quipe dat klassieke muziekconcerten organiseert in samenwerking met \"Music Project For Brussels\" en de gevangenis van Vorst.\r\nOp 18 december om 20.30 uur is het eerste concert, Lubimov+, genoemd naar de uitzonderlijke Russische pianist die ondanks de politie doorging met spelen tijdens een concert in Moskou op 13 april. Hij zal stukken spelen van de Oekra\u00efense componist Silvestrov, de Estse Arvo Part, de \u2018Oostenrijkers\u2019 Schubert en Haydn.\r\nWe gaan verder met Joy+ op 16 oktober, met Yusheng Jiang, die met twee acolieten een jazztrio vormt , en het Portugese strijkkwartet Quiron.\r\nOp 13 november staan de Belgische componisten Lekeu en Ysaye op het programma van Belgo+. \r\nOp 11 december ten slotte, het O+ concert, dat de ziel troost en de melancholie verdrijft met de remedie van de oud, de theorbe en de luit met Sofie Vanden Eynde en Saad Mahmoud Jawad.","performers":"Concert LUBIMOV+ : Alexei Lubimov (piano) 18 sept\r\nConcert JOY+ : Yusheng Jiang (bass), David Yih-Shiou Sung (Piano), Gionata Giardana (drums), Quiron Quatuor (string quartet) 16 oct\/okt\r\nConcert BELGO+ : Kristie Su (violon), Yu-Fen Chang 13 nov\r\nConcert \u00d4+ : Sofie Vanden Eynde (lute,theorbe) Saad Mahmood Jawad (oud), Vladimir Gorlinsky (new work), Aftab Darvishi (new work), Golden Oldies 11 dec","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541835"},"en":{"name":"New Season 2022-2023 Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541835"},"de":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541835"},"it":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541835"},"sp":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541835"},"pt":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541835"},"cn":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541835"}},"place":{"id":252101,"translations":{"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"joelle@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie se d\u00e9finit comme un lieu pluridisciplinaire avec 4 axes d'activit\u00e9s: l'\u00e9v\u00e9nementiel, le culturel, la formation et les initiatives \u00abcitoyennes \u00bb. Les activit\u00e9s sont de deux types. D'une part, les productions propres, qui constituent la saison, avec la programmation d'artistes associ\u00e9s, un march\u00e9 bio, des soir\u00e9es th\u00e9matiques ou encore des animations de quartier. D'autre part, le lieu est un outil mis \u00e0 disposition d'organisations externes et d'entreprises. Une foule de f\u00eates tr\u00e8s int\u00e9ressantes y ont lieu ! ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"joelle@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"joelle@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"joelle@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9