d\u00e9co"],"nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552677"},"pt":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552677"},"en":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552677"},"it":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552677"},"cn":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552677"},"fr":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":"Au tournant du 19\u00e8me et du 20\u00e8me si\u00e8cle, Bruxelles conna\u00eet bien des bouleversement ! La r\u00e9volution industrielle, le d\u00e9veloppement urbain vont m\u00e9tamorphos\u00e9 la vie des bruxellois !\n\nLa vie \u00e9conomique est florissante, les arts se d\u00e9veloppent, on a un int\u00e9r\u00eat grandissant pour les activit\u00e9s culturelles. Un courant artistique voit le jour \u00e0 Bruxelles : l\u2019Art Nouveau","longdescr":"QU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\nNous vous emmenons plus de 120 ans en arri\u00e8re, dans un quartier qui a \u00e9t\u00e9 le t\u00e9moins privil\u00e9gi\u00e9 de la Belle \u00c9poque \u00e0 bien des \u00e9gards\u2026\n\nAvec une attention toute particuli\u00e8re au mouvement Art Nouveau, on retrace avec vous les grandes \u00e9tapes de cette transformation urbaine afin de mieux comprendre cette \u00e9poque, mais aussi les enjeux urbains plus actuels dans un quartier qui n\u2019a pas arr\u00eat\u00e9 sa mue \u00e0 la Belle \u00c9poque, loin s\u2019en faut !\n\nAu cours de cette promenade, vous d\u00e9couvrirez :\n\u2013 la Maison personnelle de Paul Cauchie\n\u2013 Le palais et le parc du Cinquantenaire\n\u2013 Les b\u00e2tisseurs de Villes par Van der Stappen\n\u2013 Le monument \u00ab \u00e0 la m\u00e9moire des Belges morts pour l\u2019\u0153uvre coloniale\u201d, par Thomas Vin\u00e7otte\n\u2013 le Pavillon des Passions Humaines (V Horta)\n\u2013 la maison de l\u2019architecte Edouard Ramakers\n\u2013 une composition sculpturale de Jacques de Lalaing qui pr\u00e9sente des All\u00e9gories des trois \u00e2ges de l\u2019humanit\u00e9.\n\u2013 La fameuse Maison Saint-Cyr par Gustave Streuven. \n\n\nINFORMATIONS PRATIQUES\nTours r\u00e9guliers en fran\u00e7ais :\nPrix  : Libre et conscient* (3\u20ac \u00e0 l\u2019inscription, puis le montant qui vous semble juste \u00e0 la fin de la visite)\nDur\u00e9e : Environ 2 heures\nGroupe maximum : +\/- 25 personnes\nRendez-vous : Merode\nSur l\u2019esplanade devant l\u2019entr\u00e9e du Parc, \u00e0 c\u00f4t\u00e9 du Rond Point\n1040 Bruxelles\nTour priv\u00e9 sur demande en fran\u00e7ais, russe ou anglais\n","performers":"Une visite guid\u00e9e originale de Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552677"},"sp":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552677"},"nl":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552677"}},"place":{"id":50002807,"translations":{"de":{"name":"Rond Point Merode (devant la grille \u00e0 l'entr\u00e9e du Parc du Cinquantenaire)","address_street_name":"Av. de Tervueren","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Av. de Tervueren, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Rond Point Merod