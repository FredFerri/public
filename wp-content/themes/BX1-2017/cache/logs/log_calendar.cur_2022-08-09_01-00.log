le 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[534205],"targets":{"list":[11,19,5,7,12,8,10],"translations":{"fr":["Famille","Enseignants","Enfants 9-12 ans","Jeunes 12-15 ans","LGTBQIA","Jeunes 15-18 ans","Seniors"],"nl":["Familie","Leerkrachten","Kinderen 9-12 j.","Jongeren 12-15 j.","LGTBQIA","Jongeren 15-18 j.","Senioren"],"en":["Family","Teachers","Children 9-12 yr.","Youth 12-15  yr.","LGTBQIA","Youth 15-18  yr.","Seniors"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-07T09:35:07+02:00","published_at":"2022-07-06T16:09:09+02:00","backoffice_id":257968,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":539349,"date_start":"2022-08-25","date_end":"2022-08-25","date_next":"2022-08-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Bi\u00e8re et chocolat : une d\u00e9gustation en harmonie","shortdescr":"Une exp\u00e9rience immanquable durant laquelle vous go\u00fbterez des produits locaux de qualit\u00e9 : les bi\u00e8res artisanales de la brasserie de la Senne avec quelques d\u00e9lices de 2 des meilleurs chocolatiers belges: Laurent Gerbaut et Fr\u00e9d\u00e9ric Blondeel.","longdescr":"Le monde entier envie la Belgique pour ses sp\u00e9cialit\u00e9s ! Nos gaufres, nos bi\u00e8res et nos chocolats en font fondre plus d\u2019un. Que diriez-vous de sortir des sentiers battus et de croiser deux univers apparemment incompatibles ? Lors de cette d\u00e9gustation unique en son genre, la bi\u00e8re rencontre le chocolat. Les saveurs se r\u00e9pondent, la puissance de l\u2019un s\u2019allie \u00e0 la vigueur de l\u2019autre, la d\u00e9licatesse s\u2019unit \u00e0 la fra\u00eecheur. Une exp\u00e9rience immanquable durant laquelle vous go\u00fbterez des produits locaux de qualit\u00e9 : les bi\u00e8res artisanales de la brasserie de la Senne avec quelques d\u00e9lices de 2 des meilleurs chocolatiers belges: Laurent Gerbaut et Fr\u00e9d\u00e9ric Blondeel.\r\nChocolats travaill\u00e9s par les meilleurs et bi\u00e8res artisanales brass\u00e9es avec amour, nos sp\u00e9cialistes vous ont concoct\u00e9 des associations d\u00e9licates dont vos papilles se souviendront longtemps !\r\nR\u00e9servation n\u00e9cessaire\r\nAlso available in English","performers":null,"boxoffice_url":null,"website":"https:\/\/onceinbrussels.be\/produit\/biere-et-chocolat-une-degustation-en-harmonie\/","email":"melanie@onceinbrussels.be","phone_contact":null,"phone_booking":"+32 2 850 60 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539349"},"nl":{"name":"Bi\u00e8re et chocolat : une d\u00e9gustation en harmonie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"melanie@onceinbrussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539349"},"en":{"name":"Bi\u00e8re et chocolat : une d\u00e9gustation en harmonie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"melanie@onceinbrussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539349"},"de":{"name":"Bi\u00e8re et chocolat : une d\u00e9gustation en harmonie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,