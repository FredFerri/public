":"2024-08-25","date_next":"2024-06-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-24T02:00:48+02:00","published_at":"2024-04-23T09:37:53+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":298348,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.19493451588085775,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{}},"translations":{"de":{"name":"Horizon 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.horizon2030bxl.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009618"},"pt":{"name":"Horizon 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.horizon2030bxl.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009618"},"en":{"name":"Horizon 2030","shortdescr":"Horizon 2030 breathes new life into the Cinquantenaire to make it Brussels' leading socio-cultural center by 2030. Thanks to the support of the National Lottery, the \"Horizon 2030\" project offers a rich program combining heritage, knowledge and culture, transforming the site into a meeting point for the people of Brussels.\n","longdescr":"Thanks to the support of National Lottery players, the non-profit organization Horizon 50-200 is creating a new dynamic and a strong ambition for 2030.\n\nIn the run-up to Belgium's bicentenary in 2030, the Cinquantenaire invites you to rediscover its exceptional museum collections and the park in a new light, one of innovation and encounters. The Horizon 2030 event offers a range of festivities and activities at this iconic site, providing unforgettable moments for friends and family alike.\n\nBetween tradition and innovation, Horizon 2030 brings together already popular events such as the Bright Festival, the 20 km of Brussels and the F\u00eate Nationale, as well as new and upcoming events based on heritage, scientific research and culture. You'll be able to discover exhibitions, workshops, talks and moments of relaxation that will take place in the park and its museums, with the support of our institutions and partners.\n\nFrom spring through to the end of summer, we look forward to seeing you at Cinquantenaire.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.horizon2030bxl.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009618"},"it":{"name":"Horizon 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.horizon2030bxl.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009618"},"cn":{"name":"Horizon 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.horizon2030bxl.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009618"},"fr":{"name":"Horizon 2030","shortdescr":"Horizon 2030 donne une nouvelle vie au Cinquantenaire pour en faire le principal centre socio-culturel de Bruxelles d'ici 2030. Gr\u00e2ce au soutien de la Loterie Nationale, le projet \"Horizon 2030\" offre une programmation riche m\u00ealant patrimoine, savoir et culture, transformant ce lieu en un point de rencontre incontournable pour les Bruxellois.","longdescr":"L\u2019asbl Horizon 50-200 impulse une nouvelle dynamique et une ambition forte \u00e0 l\u2019horizon 2030, gr\u00e2ce au soutien des joueurs de la Loterie Nationale.\n\u00c0 l\u2019horizon du bicentenaire de la Belgique en 2030, le Cinquantenaire vous invite \u00e0 red\u00e9couvrir ses collections mus\u00e9ales exceptionnelles et \u00e0 red\u00e9couvrir le parc sous un nouveau regard, celui de l\u2019innovation et de la rencontre. L\u2019\u00e9v\u00e9nement Horizon 2030 propose un \u00e9ventail de festivit\u00e9s et d\u2019activit\u00e9s dans ce lieu iconique, qui vous feront passer des moments inoubliables entre amis ou en famille.\nEntre tradition et innovation, Horizon 2030 rassemble des \u00e9v\u00e9nements d\u00e9j\u00e0 populaires tels que le Bright Festival, les 20 km de Bruxelles, la F\u00eate Nationale, mais aussi des \u00e9v\u00e9nements in\u00e9dits \u00e0 venir, articul\u00e9s autour du patrimoine, de la recherche scientifique et de la culture. Vous pourrez y d\u00e9couvrir des expositions, des ateliers, des prises de parole et des moments de d\u00e9tente qui prendront place dans le parc et dans les mus\u00e9es qui l\u2019habitent, avec le soutien des institutions et de nos partenaires.\nDu printemps et jusqu\u2019\u00e0 la fin de l\u2019\u00e9t\u00e9, on se donne rendez-vous au Cinquantenaire.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.horizon2030bxl.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009618"},"sp":{"name":"Horizon 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.horizon2030bxl.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009618"},"nl":{"name":"Horizon 2030","shortdescr":"Horizon 2030 blaast het Jubelpark nieuw leven in om er tegen 2030 het belangrijkste sociaal-culturele centrum van Brussel van te maken. Dankzij de steun van de Nationale Loterij biedt het project \"Horizon 2030\" een rijk programma dat erfgoed, kennis en cultuur combineert en deze locatie omvormt tot een niet te missen ontmoetingsplaats voor de Brusselaars.","longdescr":"De vzw Horizon 50-200 geeft een nieuw elan met een sterke ambitie voor  2030, dankzij de steun van de spelers van de Nationale Loterij.\n\nIn de aanloop naar het tweehonderdjarig bestaan van Belgi\u00eb in 2030 nodigt het Jubelpark u uit om zijn uitzonderlijke museumcollecties en het park te herontdekken vanuit een nieuw perspectief, een van vernieuwing en ontmoeting. Het evenement Horizon 2030 biedt een waaier aan festiviteiten en activiteiten op deze iconische locatie, die garant staan voor onvergetelijke momenten met vrienden en familie.\n\nHorizon 2030 is een mix van traditie en innovatie en brengt populaire evenementen zoals het Bright Festival, de 20 km van Brussel en de Nationale Feestdag samen met nieuwe evenementen rond erfgoed, wetenschappelijk onderzoek en cultuur. U kunt tentoonstellingen, workshops, lezingen en ontspanningsmomenten ontdekken in het park en zijn musea, met de steun van de instellingen en onze partners.\n\nVanaf de lente tot het einde van de zomer zien we u graag in het Jubelpark.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.horizon2030bxl.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009618"}},"place":{"id":50001755,"translations":{"de":{"name":"Horizon2030","address_street_name":"Parc du Cinquantenaire","address_street_number":"11","address_