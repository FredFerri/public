ar Schepenijlaan en onthult architectonische schatten die vaak over het hoofd worden gezien. ","longdescr":"Ontdek de Art Deco in de wijk Coghen! Deze route neemt je mee van Square Coghen naar Schepenijlaan  en onthult architectonische schatten die vaak over het hoofd worden gezien. Bewonder de werken van L\u00e9on Sneyers, Rapha\u00ebl Delville en Louis Herman De Koninck, meesters van het Belgische modernisme. Kom dit unieke erfgoed ontdekken en laat je verleiden door de creativiteit die hier leeft. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005246"}},"place":{"id":251246,"translations":{"de":{"name":"Eglise Saint Augustin","address_street_name":"Place de l'Altitude Cent","address_street_number":"100","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Place de l'Altitude Cent, 100","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Eglise Saint Augustin","address_street_name":"Place de l'Altitude Cent","address_street_number":"100","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Place de l'Altitude Cent, 100","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Eglise Saint Augustin","address_street_name":"Place de l'Altitude Cent","address_street_number":"100","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","ad