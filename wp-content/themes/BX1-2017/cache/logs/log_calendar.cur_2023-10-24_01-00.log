igin":null,"is_part_of":null,"sub_type":"tour","ranking":0.13617632344054065,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[112],"translations":{"de":["Ausgefallenes"],"pt":[null],"en":["Unusual"],"it":["Insolito"],"cn":[null],"fr":["Insolite"],"sp":["Ins\u00f3lito"],"nl":["Ongewoon"]}}},"translations":{"de":{"name":"Mais qui a tu\u00e9 Monsieur le Comte?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546508"},"pt":{"name":"Mais qui a tu\u00e9 Monsieur le Comte?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.546508"},"en":{"name":"Mais qui a tu\u00e9 Monsieur le Comte?","shortdescr":"A cultural City Game in the historical heart of Brussels","longdescr":"That's the question you'll have to try to answer. Like the world's most famous detective, you'll have to scour the city for clues that could lead you to the killer.\r\nYou will be a team of aspiring detectives looking for information about the city.\r\nDiscover its traditions, its artists, its must-see places, and complete your investigation with precision to earn more clues.\r\nYour roadmap will also take you to some places where the victim would have been spotted on his last day.\r\nThere you will take tests to try to earn extra points.\r\nGood luck, and don't forget to use your \"little grey cells\".\r\n\r\n\r\nDiscover our teaser: https:\/\/youtu.be\/YHB74T9P5xI \r\n\r\nOrganized on demand, from 10 to 3000 participants.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546508"},"it":{"name":"Mais qui a tu\u00e9 Monsieur le Comte?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546508"},"cn":{"name":"Mais qui a tu\u00e9 Monsieur le Comte?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.546508"},"fr":{"name":"Mais qui a tu\u00e9 Monsieur le Comte?","shortdescr":"Un City Game culturel en plein coeur de Bruxelles","longdescr":"C\u2019est la question \u00e0 laquelle vous allez devoir tenter de r\u00e9pondre. A l\u2019instar du plus illustre d\u00e9tective au monde, nous vous proposons de sillonner la ville \u00e0 la recherche d\u2019indices qui pourront vous mettre sur la piste de l\u2019assassin.\r\nVous incarnerez une \u00e9quipe d\u2019 aspirants d\u00e9tectives \u00e0 la recherche d\u2019informations sur la ville.\r\nD\u00e9couvrez ses traditions, ses artistes, ses endroits incontournables, et compl\u00e9tez votre enqu\u00eate avec pr\u00e9cision pour m\u00e9riter davantage d\u2019indices.\r\nVotre carte muette vous am\u00e8nera \u00e9galement dans certains lieux o\u00f9 la victime aurait \u00e9t\u00e9 rep\u00e9r\u00e9e lors de son ultime journ\u00e9e.\r\nVous y passerez des \u00e9preuves pour tenter de gagner des points suppl\u00e9mentaires.\r\nBonne chance, et n\u2019oubliez pas de faire fonctionner vos \u00ab petites cellules grises \u00bb.\r\n\r\nVotre guide vous emm\u00e8nera \u00e9galement dans certains lieux o\u00f9 la victime aurait \u00e9t\u00e9 rep\u00e9r\u00e9e lors de son ultime journ\u00e9e. Vous y passerez des \u00e9preuves pour tenter de gagner des points suppl\u00e9mentaires.\r\n\r\nBonne chance, et n\u2019oubliez pas de faire fonctionner vos \u00ab petites cellules grises \u00bb.\r\n\r\nLa Bande Annonce: https:\/\/youtu.be\/YHB74T9P5xI \r\n\r\nOrganis\u00e9 sur mesure, de 10 \u00e0 3000 personnes.\r\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546508"},"sp":{"name":"Mais qui a tu\u00e9 Monsieur le Comte?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546508"},"nl":{"name":"Mais qui a tu\u00e9 Monsieur le Comte?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546508"}},"place":{"id":276699,"translations":{"de":{"name":"Centre ville","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Centre ville","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Centre ville","address_street_name":null,"addres