46","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9e en 1984 par la danseuse et chor\u00e9graphe belge Patricia Kuypers, Contredanse s\u2019est donn\u00e9e pour mission, d\u00e8s l\u2019origine, de  soutenir la cr\u00e9ation chor\u00e9graphique. Elle souhaite offrir des outils et des ressources aux chor\u00e9graphes et aux danseurs pour leur permettre de relier leur travail en studio \u00e0 une analyse de la pens\u00e9e du mouvement, du corps, de la composition, de l\u2019histoire de leur discipline. \r\nSes activit\u00e9s sont orient\u00e9es principalement vers  l\u2019information et la documentation, l\u2019\u00e9dition ainsi que la formation. Contredanse d\u00e9veloppe \u00e9galement des partenariats en s\u2019associant \u00e0 des projets tels que tables rondes, conf\u00e9rences et ateliers de r\u00e9flexion en liaison avec la danse.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Contredanse","address_street_name":"Vlaamsesteenweg","address_street_number":"46","address_street_box":null,"email":"contredanse@contredanse.org","website":"http:\/\/www.contredanse.org","phone_contact":"+32 2 502 03 27","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Vlaamsesteenweg, 46","address_line2":"1000 Brussel","description_web":"Opgericht in 1984 door de Belgische danseres en choreografe Patricia Kuypers. Contredanse heeft als doel choreografisch werk te ondersteunen en aan te moedigen d.m.v. het verschaffen van documentatie en informatie, publicaties en vormingen. Er wordt ook samengewerkt met andere organisaties voor het organiseren van colloquia, stages en trefmomenten.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Contredanse","address_street_name":"Rue de Flandre","address_street_number":"46","address_street_box":null,"email":"contredanse@contredanse.org","website":"http:\/\/www.contredanse.org","phone_contact":"+32 2 502 03 27","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Flandre, 46","address_line2":"1000 Brussels","description_web":"Founded in 1984 by the Belgian dancer and choreographer, Patricia Kuypers, Contredanse has, since its inception, taken on the mission of supporting choreographic creation. It wishes to provide tools and resources for choreographers and dancers in order to enable them link their studio work to an analysis of the philosophy of movement, body, composition, and history of their discipline. These activities are oriented towards information and documentation, publishing and training. Contredanse is also developing partnerships in associating itself with projects such as round tables, conferences and workshops.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Contredanse","address_street_name":"Rue de Flandre","address_street_number":"46","address_street_box":null,"email":"contredanse@contredanse.org","website":"http:\/\/www.contredanse.org","phone_contact":"+32 2 502 03 27","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 46","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Contredanse","address_street_name":"Rue de Flandre","address_street_number":"46","address_street_box":null,"email":"contredanse@contredanse.org","website":"http:\/\/www.contredanse.org","phone_contact":"+32 2 502 03 27","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 46","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Contredanse","address_street_name":"Rue de Flandre","address_street_number":"46","address_street_box":null,"email":"contredanse@contredanse.org","website":"http:\/\/www.contredanse.org","phone_contact":"+32 2 502 03 27","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 46","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Contredanse","address_street_name":"Rue de Flandre","address_street_number":"46","address_street_box":null,"email":"contredanse@contredanse.org","website":"http:\/\/www.contredanse.org","phone_contact":"+32 2 502 03 27","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Contredanse","address_street_name":"Rue de Flandre","address_street_number":"46","address_street_box":null,"email":"contredanse@contredanse.org","website":"http:\/\/www.contredanse.org","phone_contact":"+32 2 502 03 27","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Flandre, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":442,"location":{"lat":50.85135235,"lon":4.34638954},"region":"brussels","last_updated_at":"2022-09-12T01:07:30+02:00","published_at":"2013-10-19T01:13:32+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/af44321886c9b2d18392eac281e400c641d56b9b.jpg","width":800,"height":799,"ratio":1,"translations":{"fr":{"title":"Si t\u2019y danses \u2013 balades urbaines","copyright":null},"nl":{"title":"Si t\u2019y danses \u2013 balades urbaines","copyright":null},"en":{"title":"Si t\u2019y danses \u2013 balades urbaines","copyright":null}}},{"type":"photo","link":"https:\/\/agen