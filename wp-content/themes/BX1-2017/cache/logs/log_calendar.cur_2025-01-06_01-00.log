lidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-23T15:07:01+01:00","published_at":"2024-10-17T16:10:27+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":309990,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.5848035476425733,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[119],"translations":{"de":["Kino"],"pt":[null],"en":["Cinema  "],"it":["Cinema"],"cn":[null],"fr":["Cin\u00e9ma"],"sp":["Cine"],"nl":["Cinema"]}}},"translations":{"de":{"name":"Festivals Courts + Queer Mais Trash 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/courtsmaistrash.net\/","email":"info@courtsmaistrash.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002725"},"pt":{"name":"Festivals Courts + Queer Mais Trash 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/courtsmaistrash.net\/","email":"info@courtsmaistrash.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002725"},"en":{"name":"Festivals Courts + Queer Mais Trash 2025","shortdescr":"Depuis 2005, Courts Mais Trash c\u00e9l\u00e8bre les courts m\u00e9trages underground. Pour marquer notre 20\u00e8me anniversaire, nous voyons les choses en grand avec une \u00e9dition XXL ! Pour vous accueillir en plus grand nombre, nous d\u00e9m\u00e9nageons \u00e0 l\u2019Espace Magh, en plein c\u0153ur de Bruxelles, \u00e0 deux pas de Manneken Pis. Une nouvelle salle de 350 places et un grand foyer vous attendent pour 9 jours de festivit\u00e9s !","longdescr":"Cr\u00e9\u00e9 en 2005, Courts Mais Trash c\u00e9l\u00e8bre les courts m\u00e9trages underground, d\u00e9cal\u00e9s et ind\u00e9pendants. \n\n\nPour son 20\u00e8me anniversaire, le festival voit les choses en grand avec une \u00e9dition XXL et s\u2019associe pour la premi\u00e8re fois \u00e0 l\u2019Espace Magh. Pr\u00e9parez-vous \u00e0 d\u00e9couvrir le meilleur du cin\u00e9ma alternatif, politique, dr\u00f4le, fauch\u00e9 et trash !\n\n\nLes festivit\u00e9s d\u00e9marrent avec Queer Mais Trash du vendredi 31.01 au dimanche 2.02: trois jours pour explorer les th\u00e9matiques LGBTQIA+ et les s\u00e9ances f\u00e9ministes \u00ab Female Trouble \u00bb. Au programme : des films inclusifs et engag\u00e9s, et des \u00e9v\u00e9nements d\u00e9jant\u00e9s comme le Bingo Mais Trash anim\u00e9 par Edna Sorgelsen.\n\n\nEnsuite, Courts Mais Trash encha\u00eene du mardi 4.02 au dimanche 9.02. Cette \u00e9dition sp\u00e9ciale vous r\u00e9serve des Best of, des nouveaut\u00e9s comme des Longs Mais Trash, une grande exposition, des r\u00e9trospectives, des \u00e9v\u00e9nements pros, des s\u00e9ances scolaires et des After Trash Parties !\n\n\nPour pouvoir tou.te.s vous accueillir, le festival d\u00e9m\u00e9nage \u00e0 l\u2019Espace Magh et vous accueillera dans une ambiance conviviale et alternative !","performers":null,"boxoffice_url":null,"website":"https:\/\/courtsmaistrash.net\/","email":"info@courtsmaistrash.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002725"},"it":{"name":"Festivals Courts + Queer Mais Trash 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/courtsmaistrash.net\/","email":"info@courtsmaistrash.be","phone_contact":null,"phone_booking":null,"agenda_url":