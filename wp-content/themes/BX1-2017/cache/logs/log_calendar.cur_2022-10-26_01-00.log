at":"2022-10-11T02:35:17+02:00","published_at":"2022-09-05T17:25:18+02:00","backoffice_id":261062,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":541463,"date_start":"2022-10-28","date_end":"2022-10-28","date_next":"2022-10-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Halloween Tram","shortdescr":"L\u2019Halloween Tram est un voyage magique et f\u00e9\u00e9rique au pays des fant\u00f4mes et monstres bizarres qui se d\u00e9roule au sein d\u2019un ancien tramway red\u00e9cor\u00e9 pour l\u2019occasion.","longdescr":"L\u2019Halloween Tram est un voyage magique et f\u00e9\u00e9rique au pays des fant\u00f4mes et monstres bizarres qui se d\u00e9roule au sein d\u2019un ancien tramway red\u00e9cor\u00e9 pour l\u2019occasion. Durant le voyage vous pourrez profiter d\u2019une animation sp\u00e9cifiquement con\u00e7ue pour l\u2019occasion. La formule comprend :\r\n\r\n    Le voyage en Tram ( 30 minutes )\r\n    1 ap\u00e9ritif (avec ou sans alcool)\r\n    1 soupe au potiron\r\n\r\nR\u00e9servation obligatoire ici : https:\/\/www.billetweb.fr\/halloween-tram1\r\n\r\nATTENTION ! Il est imp\u00e9ratif de se rendre au minimum 30 minutes avant l\u2019embarquement au Centre d\u2019Art Fantastique (18 rue de la glaci\u00e8re \u2013 1060 \u2013 Bruxelles). Un bracelet d\u2019acc\u00e8s \u00e0 l\u2019Halloween Tram vous sera donn\u00e9 en \u00e9change de votre voucher. L\u2019accueil s\u2019effectuera selon les normes sanitaires en vigueur. Prix unique par participant les billets ne sont ni \u00e9changeables ni rembours\u00e9s.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fantastic-museum.be","email":"infomafcaf@gmail.com","phone_contact":null,"phone_booking":"+32 475 41 29 18","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541463"},"nl":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541463"},"en":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541463"},"de":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541463"},"it":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541463"},"sp":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541463"},"pt":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541463"},"cn":{"name":"Halloween Tram","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":nu