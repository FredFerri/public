"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000169"},"cn":{"name":"L'h\u00f4tel van Eetvelde et son bureau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-van-eetvelde-et-son-bureau","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000169"},"fr":{"name":"L'h\u00f4tel van Eetvelde et son bureau","shortdescr":"L'h\u00f4tel van Eetvelde vient de r\u00e9ouvrir apr\u00e8s une restauration compl\u00e8te de la verri\u00e8re centrale. Cet h\u00f4tel particulier fut construit en 1895 par Victor Horta pour Edmond van Eetvelde, secr\u00e9taire g\u00e9n\u00e9ral pour le Congo, qui voulait montrer sa r\u00e9ussite sociale avec une habitation pouvant accueillir de belles r\u00e9ceptions. ","longdescr":"L'h\u00f4tel van Eetvelde vient de r\u00e9ouvrir apr\u00e8s une restauration compl\u00e8te de la verri\u00e8re centrale. Cet h\u00f4tel particulier fut construit en 1895 par Victor Horta pour Edmond van Eetvelde, secr\u00e9taire g\u00e9n\u00e9ral pour le Congo, qui voulait montrer sa r\u00e9ussite sociale avec une habitation pouvant accueillir de belles r\u00e9ceptions. Caract\u00e9ristique du style Horta, la maison pr\u00e9sente une superbe verri\u00e8re en rotonde et de nombreux \u00e9l\u00e9ments d'origine. Elle fut class\u00e9e \"patrimoine mondial de l'Unesco\" en 2000. La visite se poursuit dans la maison voisine o\u00f9 van Eetvelde avait son bureau tout aussi exceptionnel en dimensions que sa maison de prestige. C'est la premi\u00e8re fois que son bureau est ouvert au public !\nVous aurez ensuite l'occasion de visiter librement l'exposition sur \"les pierres de la fa\u00e7ade de l'H\u00f4tel Aubecq\" sauv\u00e9es lors de la destruction du b\u00e2timent en 1950 et con\u00e7u en 1902 lui aussi par Victor Horta.\n\nLe prix comprend le ticket d'entr\u00e9e de 12\u20ac.\n\nAucune photo n'est autoris\u00e9e \u00e0 l'int\u00e9rieur du lieu.\n\n(enfants de -12 ans non-admis)","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-van-eetvelde-et-son-bureau","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000169"},"sp":{"name":"L'h\u00f4tel van Eetvelde et son bureau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-van-eetvelde-et-son-bureau","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000169"},"nl":{"name":"L'h\u00f4tel van Eetvelde et son bureau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/lhotel-van-eetvelde-et-son-bureau","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000169"}},"place":{"id":50000967,"translations":{"de":{"name":"H\u00f4tel van Eetvelde","address_street_name":"Avenue Palmerston","address_street_number":"4","address_street_box":null,"email":"info@lab-an.be","website":"https:\/\/www.lab-an.be","phone_contact":"+32 2 303 48 94","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Palmerston, 4","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel van Eetvelde","address_street_name":"Avenue Palmerston","address_street_number":"4","address_street_box"