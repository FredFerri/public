s Instrumentos Musicais, que pertence ao conjunto dos Museus Reais de Arte e da Hist\u00f3ria. Este museu assenta no cora\u00e7\u00e3o dos velhos edif\u00edcios Old England, um dos edif\u00edcios mais belos de estilo Art Nouveau de Bruxelas, datando de 1899. Este museu \u00e9 um dos mais ricos do mundo: cerca de 1200 instrumentos encontram-se a\u00ed expostos. Consta da programa\u00e7\u00e3o de interessantes anima\u00e7\u00f5es e in\u00fameros concertos.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":359,"location":{"lat":50.84274286,"lon":4.35903823},"region":"brussels","last_updated_at":"2023-07-08T03:05:34+02:00","published_at":"2013-10-19T01:13:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/9790da3c47a34ec3d77198a79ce3f7c0ce7390de.png","width":2000,"height":2000,"ratio":1,"translations":{"fr":{"title":"Les tr\u00e9sors de la Mouche au Mus\u00e9e des Instruments de Musique ! ","copyright":null},"nl":{"title":"Les tr\u00e9sors de la Mouche au Mus\u00e9e des Instruments de Musique ! ","copyright":null},"en":{"title":"Les tr\u00e9sors de la Mouche au Mus\u00e9e des Instruments de Musique ! ","copyright":null},"de":{"title":"Les tr\u00e9sors de la Mouche au Mus\u00e9e des Instruments de Musique ! ","copyright":null},"it":{"title":"Les tr