"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-03T03:05:35+02:00","published_at":"2023-06-27T16:35:05+02:00","backoffice_id":280535,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.38157141418444},{"id":558531,"date_start":"2023-07-02","date_end":"2023-08-06","date_next":"2023-08-06","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"],"de":["Stadtteile"],"it":["Quartieri"],"sp":["Barrios"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le Coin du Balai, un t\u00e9moin vivant entre ville et nature (balade en cal\u00e8che)","shortdescr":null,"longdescr":"Adoss\u00e9 \u00e0 la For\u00eat de Soignes, terrain de chasse de Charles Quint, le Coin du Balai allie le pittoresque d\u2019un village \u00e0 une histoire qui conjugue plaisirs princiers et labeur forestier. C\u2019est cet air pur et ce cadre verdoyant qui s\u00e9duisirent le peintre et sculpteur Rik Wouters: il y r\u00e9alisa la plupart de ses chefs-d\u2019\u0153uvre. Le quartier accueille toujours des artistes mais aussi toute une population amoureuse d\u2019une atmosph\u00e8re unique qui entend perp\u00e9tuer les traditions et le folklore d\u2019antan... Nous le d\u00e9couvrirons au pas des chevaux d\u2019une cal\u00e8che sp\u00e9cialement adapt\u00e9e pour accueillir familles et personnes \u00e0 mobilit\u00e9 r\u00e9duite. Une formule \u00e0 la fois conviviale et interg\u00e9n\u00e9rationnelle.\r\n\r\nVisite organis\u00e9e en collaboration avec Hyppy et CAP Patrimoine dans le cadre du programme \u00ab Tourisme vert pour tous \u00bb avec le soutien de Visit.brussels.\r\n\r\nAttention : places limit\u00e9es !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":"+32 488 94 18 13","phone_booking":"+32 488 94 18 13","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558531"},"nl":{"name":"Le Coin du Balai, un t\u00e9moin vivant entre ville et nature (balade en cal\u00e8che)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":"+32 488 94 18 13","phone_booking":"+32 488 94 18 13","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558531"},"en":{"name":"Le Coin du Balai, un t\u00e9moin vivant entre ville et nature (balade en cal\u00e8che)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":"+32 488 94 18 13","phone_booking":"+32 488 94 18 13","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558531"},"de":{"name":"Le Coin du Balai, en lisi\u00e8re de for\u00eat, un t\u00e9moin vivant entre ville et nature (balade en cal\u00e8che)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":"+32 488 94 18 13","phone_booking":"+32 488 94 18 13","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558531"},"it":{"name":"Le Coin du Balai, en lisi\u00e8re de for\u00eat, un t\u00e9moin vivant entre ville et nature (balade en cal\u00e8che)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brux