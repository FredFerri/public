"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":20}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[255],"translations":{"de":["Barrierefrei"],"pt":[null],"en":["Accessible"],"it":["Accessibile"],"cn":[null],"fr":["Accessible"],"sp":["Habilitado"],"nl":["Toegankelijk"]}},"visit_profile":{"list":[454],"translations":{"de":["Bier"],"pt":[null],"en":["Beer"],"it":["Birra"],"cn":[null],"fr":["Bi\u00e8re"],"sp":["Cerveza"],"nl":["Bier"]}},"recurring":[{"day":"saturday","occurences":{"is_second":true,"is_third":true,"is_fourth":true,"is_last":true,"is_first":true},"time_start":"16:00:00","time_end":"17:30:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier samedis du mois de 16:00 \u00e0 17:30","nl":"Open op de eerste, tweede, derde, vierde en laatste zaterdags van de maand van 16:00 tot 17:30","en":"Open the first, second, third, fourth and last saturdays of the month from 16:00 to 17:30"}}],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":384958,"date_start":"2022-08-12","date_end":"2024-01-06","date_next":"2023-10-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":true,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-22T02:05:25+02:00","published_at":"2016-03-31T14:12:13+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":104958,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.15738773190289448,"languages":{"spoken":["es","fr","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Belgian Chocolate Tasting Tour - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 495 32 03 62","phone_booking":"+32 470 60 35 05","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.384958"},"pt":{"name":"Belgian Chocolate Tasting Tour - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 495 32 03 62","phone_booking":"+32 470 60 35 05","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.384958"},"en":{"name":"Belgian Chocolate Tasting Tour - Brussels","shortdescr":"Brussels beer tasting tour.\r\nDiscover and taste some of the best Belgian beers in Brussels. The \u201cBrussels beer tasting tour\u201d tour includes information about the Belgian nightlife, anecdotes on must-see places, the history of Belgian beer and, the best part, the tasting of special beers in some of the most legendary bars of the historical center.","longdescr":"\r\nProgram:\r\n\r\nGrand-Place, the house of the Brewers guild.\r\nBar: La Mort Subite.\r\nRoyal Theatre Toone, traditional puppet theater.\r\nBar: \u00c0 l\u2019image de Notre-Dame.\r\nBar: Delirium tremens.\r\nThe former market hall on Place Saint-G\u00e9ry.\r\n\r\nPractical information:\r\n\r\nPrice: 50\u20ac\r\n\r\nWhen: Every Saturday.\r\n\r\nStarting time: 3pm\r\n\r\nMeeting point: Grand-Place in front of the City Hall. Find our guides! They hold a white umbrella.\r\n\r\nDuration: 2,5 hours.\r\n\r\nLanguage: English; French; Spanish\r\n\r\nIncluded:\r\nProfessional guides (English-speaking).\r\nTasting of 6 special Belgian beers.\r\n\r\nNot included:\r\nAdditional drinks.\r\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 495 32 03 62","phone_booking":"+32 470 60 35 05","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.384958"},"it":{"name":"Belgian Chocolate Tasting Tour - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 495 32 03 62","phone_booking":"+32 470 60 35 05","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.384958"},"cn":{"name":"Belgian Chocolate Tasting Tour - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 495 32 03 62","phone_booking":"+32 470 60 35 05","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.384958"},"fr":{"name":"Belgian Chocolate Tasting Tour - Brussels","shortdescr":"Parcours de d\u00e9gustation de bi\u00e8res belges \u00e0 Bruxelles.\r\nAccompagn\u00e9 de notre guide sp\u00e9cialiste de la bi\u00e8re, cette visite guid\u00e9e te permettra de d\u00e9couvrir l\u2019histoire de la bi\u00e8re en Belgique, v\u00e9ritable boisson embl\u00e9matique du pays. C\u2019est un tour guid\u00e9 incontournable \u00e0 r\u00e9aliser entre amis ou coll\u00e8gues lors de ton s\u00e9jour \u00e0 Bruxelles.\r\n","longdescr":"Programme :\r\n\r\nGrand-Place, pr\u00e9sentation de la maison de la corporation des brasseurs.\r\nLe bar A la Mort Subite.\r\nTh\u00e9\u00e2tre de Marionnettes de Toone.\r\nLe bar A L\u2019Imaige Nostre-Dame.\r\nLe Delirium Caf\u00e9.\r\nL\u2019ancien march\u00e9 Les Halles Saint-G\u00e9ry.\r\nD\u00e9gustation de bi\u00e8res belges :\r\nUne bi\u00e8re Lambic \u2013 bi\u00e8re de fermentation spontan\u00e9e.\r\nUne bi\u00e8re blanche \u2013 bi\u00e8re de basse fermentation.\r\nUne bi\u00e8re rouge \u2013 bi\u00e8re de fermentation mixte.\r\nUne bi\u00e8re d\u2019abbaye \u2013 bi\u00e8re de haute fermentation.\r\nUne bi\u00e8re Ales ou Stout ou IPA \u2013 bi\u00e8re de haute fermentation.\r\nUne bi\u00e8re trappiste \u2013 bi\u00e8re de haute fermentation.\r\n\r\nInformations pratiques :\r\n\r\nPrix : 50\u20ac\r\n\r\nQuand : Tous les samedis.\r\n\r\nHeures de d\u00e9part : 15h\r\n\r\nPoint de rencontre : La Grand-Place de Bruxelles, en face de l\u2019H\u00f4tel de ville. Vous reconna\u00eetrez nos guides gr\u00e2ce \u00e0 leur parapluie blanc muni du logo Bravo Discovery.\r\n\r\nDur\u00e9e : 2h30\r\n\r\nLangue : Fran\u00e7ais.\r\n\r\nInclus :\r\nVisite guid\u00e9e par un expert en d\u00e9gustation de bi\u00e8res belges et en histoire.\r\nD\u00e9gustation de 6 bi\u00e8res belges sp\u00e9ciales.\r\n\r\nNon inclus :\r\nConsommations suppl\u00e9mentaires.\r\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 495 32 03 62","phone_booking":"+32 470 60 35 05","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.384958"},"sp":{"name":"Belgian Chocolate Tasting Tour - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 495 32 03 62","phone_booking":"+32 470 60 35 05","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.384958"},"nl":{"name":"Belgian Chocolate Tasting Tour - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":"+32 495 32 03 62","phone_booking":"+32 470 60 35 05","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.384958"}},"place":{"id":3743,"translations":{"de":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Der Grand-Place in Br\u00fcssel z\u00e4hlt zum UNESCO-Weltkulturerbe und gilt als einer der sch\u00f6nsten Pl\u00e4tze der Welt.\r\n\r\nArchitektonische Perlen: Hier l\u00e4sst sich eine \u00e4u\u00dferst gelungene Mischung verschiedener architektonischer Stilrichtungen bewundern, charakteristisch f\u00fcr die Kultur und die Gesellschaft einer wohlhabenden, nordeurop\u00e4ischen Stadt. Eingerahmt wird der Grand-Place von majest\u00e4tischen Zunfth\u00e4usern, die \u00fcberwiegend aus dem 17. Jahrhundert stammen. Das Rathaus von Br\u00fcssel, das Anfang des 15. Jahrhunderts (1402) erbaut wurde, dominiert das architektonische Gesamtbild.\r\n\r\nSpektakul\u00e4re Veranstaltungen auf dem Grand-Place: Der Grand-Place wird regelm\u00e4\u00dfig Schauplatz verschiedener Gro\u00dfereignisse, darunter das mittelalterliche Spektakel Ommegang und der ber\u00fchmte Blumenteppich, bei dem der gesamte Platz mit einem riesigen Blumenmeer ausgelegt wird\r\n\r\nSie befinden sich \u00fcbrigens in bester Gesellschaft, denn schon Schriftsteller wie Baudelaire und Victor Hugo und sogar Karl Marx verfielen dem Charme des Grand-Place. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Classificada como Patrim\u00f3nio Mundial da Unesco, a Grand-Place come\u00e7a a construir-se no s\u00e9culo XV: de in\u00edcio, os sal\u00f5es de algumas sedes de guildas, e, depois, a C\u00e2mara Municipal como sede da autoridade deste local de com\u00e9rcio. Bombardeada durante 3 dias pelas tropas francesas em 1695, fica quase totalmente destru\u00edda, mas, tal como uma f\u00e9nix, renascer\u00e1 das suas cinzas em menos de 5 anos. Por este motivo, quatro estilos coexistem e, por vezes, at\u00e9 se sobrep\u00f5em; \u00e9 uma esp\u00e9cie de mistura de g\u00f3tico, de barroco opulento, de neocl\u00e1ssico e de neog\u00f3tico. A torre da C\u00e2mara Municipal mede, mais ou menos, 96 metros de altura.\r\n\r\nUm local hist\u00f3rico\r\n\r\nLocal hist\u00f3rico, a Grand-Place assistiu ao desenvolvimento de acontecimentos felizes e tr\u00e1gicos:\r\n\r\nEm 1523, os primeiros m\u00e1rtires protestantes, Henri Voes e Jean Van Eschen, foram a\u00ed queimados pela Inquisi\u00e7\u00e3o.\r\nEm 1568, os condes de Egmont e de Hornes foram a\u00ed decapitados.\r\nEm agosto de 1695, durante a Guerra da Liga de Augsburgo, a maior parte das casas que rodeavam a Grand-Place, algumas das quais ainda conservavam a sua constru\u00e7\u00e3o de madeira, foram destru\u00eddas durante o bombardeamento da cidade pelas tropas francesas dirigidas pelo marechal de Villeroy. Apenas a fachada e a torre da C\u00e2mara Municipal, que servia de alvo para os artilheiros, e algumas paredes de pedra resistiram \u00e0s balas de canh\u00e3o. As casas que rodeavam a pra\u00e7a foram rapidamente reconstru\u00eddas, desta feita, usando pedra, pelas diferentes guildas. De entre elas, a sede da guilda dos Cervejeiros que hoje acolhe o Museu os Cervejeiros.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Often considered the most beautiful square in the world, the Grand-Place of Brussels' reputation precedes it!  \r\n \r\nToday, it still has a political and administrative function as it houses the City of Brussels Town Hall, which remains the workplace of the mayor and most of their aldermen.  \r\n \r\nAs a prestigious venue, it hosts many festive events - concerts, fairs, folklore events, the Christmas tree and nativity scene, sound and light shows, the flower carpet in the summer, etc. - or symbolic events, such as the celebration of sportsmen and women after fine performances.  \r\n \r\nIts story began as a market square in the 12th century. Gradually, the square was filled with houses and halls, then primarily made of wood. The splendid Gothic town hall was built in the 15th century in three phases; the same 15th century saw the installation of trade guilds in the houses that border the Grand-Place. Even more so than at present, the square was the nerve centre of Brussels life: economically, as already mentioned, with intense sales activity (several halls devoted to the sale of bread - the present King's House or Broodhuis in Dutch -, meat, linen, etc.), culturally (theatrical performances), judicially (with executions taking place on the square) and, of course, local politics.  \r\n \r\nIt was bombarded by Louis XIV's troops in 1695 and was subsequently almost entirely rebuilt. It underwent further major renovations and modifications during the following centuries, especially in the 19th century, which gave it its current appearance.  \r\n \r\nThe Grand-Place of Brussels has been a UNESCO World Heritage Site since 1998. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"La costruzione della Grand-Place, sito che rientra nella lista dei Patrimoni Mondiali dell'Unesco, inizia nel Quindicesimo secolo; dapprima qualche mercato coperto, le case delle corporazioni, poi l'H\u00f4tel de Ville per rilanciare l'autorit\u00e0 di questo sito commerciale. Bombardata per 3 giorni dall'esercito francese nel 1695, la piazza fu quasi completamente distrutta, ma, come una fenice, rinascer\u00e0 dalle proprie ceneri in meno di 5 anni. Ecco perch\u00e9 sono quattro gli stili che si affiancano e, a volte, si sovrappongono; notiamo una miscela di gotico, opulento barocco, neoclassico e neogotico. La torre dell'H\u00f4tel de Ville \u00e8 alta circa 96 metri.\r\n\r\nUn luogo storico\r\n\r\nLuogo storico, la Grand-Place \u00e8 stata teatro di molti eventi, sia lieti che tragici:\r\n\r\nNel 1523, i primi martiri protestanti, Henri Voes e Jean Van Eschen, vengono bruciati vivi dall'Inquisizione proprio nella Piazza,\r\n1568, i conti di Egmont e Hornes vengono decapitati.\r\nAgosto 1695, nel corso della Guerra della Grande Alleanza, la maggior parte delle case che si affacciano sulla Grand-Place, delle quali alcune sono ancora in legno, vengono distrutte dal bombardamento della citt\u00e0 ad opera delle truppe francesi guidate dal maresciallo di Villeroy. Solamente la facciata e la torre dell'H\u00f4tel de Ville, che fungeva da bersaglio per l'artiglieria, e qualche muro di pietra resistono alle bombe incendiarie. Le case che davano sulla piazza vengono ricostruite rapidamente dalle varie corporazioni che, a questo punto, scelgono come materiale la pietra. Tra esse, spicca la casa della corporazione dei Birrai che oggi accoglie il Mus\u00e9e des Brasseurs (Museo della Birra).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Souvent consid\u00e9r\u00e9e comme la plus belle du monde, la r\u00e9putation de la Grand-Place de Bruxelles n\u2019est plus \u00e0 \u00e9tablir !  \r\n \r\nAujourd\u2019hui encore, elle conserve une fonction politico-administrative en accueillant l\u2019H\u00f4tel de Ville de Bruxelles, qui demeure le lieu de travail du bourgmestre et de la plupart des \u00e9chevins.  \r\n \r\nEn tant que lieu de prestige, elle h\u00e9berge de nombreux \u00e9v\u00e9nements festifs \u2014 concerts, foires, manifestations folkloriques, sapin et cr\u00e8che de No\u00ebl, son et lumi\u00e8re, tapis de fleurs en \u00e9t\u00e9, etc. \u2014 ou symboliques, comme par ex. la r\u00e9ception de sportifs suite \u00e0 leurs performances.  \r\n \r\nSon histoire commence en tant que lieu de march\u00e9 au 12e si\u00e8cle. Progressivement, la place se garnit de maisons et de halles, encore principalement en bois. Le splendide H\u00f4tel de Ville gothique est construit au 15e si\u00e8cle en trois phases ; ce m\u00eame 15e si\u00e8cle voit l\u2019installation des corporations de m\u00e9tiers dans les maisons bordant la Grand-Place. Plus encore qu\u2019actuellement, la place est le centre n\u00e9vralgique de la vie bruxelloise : sur le plan \u00e9conomique donc, comme d\u00e9j\u00e0 mentionn\u00e9, avec une intense activit\u00e9 de vente (plusieurs halles consacr\u00e9es \u00e0 la vente du pain \u2014 actuelle Maison du Roi ou Broodhuis en n\u00e9erlandais \u2014, de la viande, des draps, etc.), sur le plan culturel (repr\u00e9sentations th\u00e9\u00e2trales), sur le plan judiciaire (avec des ex\u00e9cutions qui ont lieu sur la place), et \u00e9videmment sur le plan de la politique locale.  \r\n \r\nSujette \u00e0 un bombardement par les troupes de Louis XIV en 1695, elle est presque enti\u00e8rement reconstruite \u00e0 cette occasion. Elle subit encore d\u2019importantes r\u00e9novations et modifications durant les si\u00e8cles suivants, et ce surtout au 19e si\u00e8cle, pour lui conf\u00e9rer son aspect actuel.  \r\n \r\nLa Grand-Place de Bruxelles est inscrite sur la liste du patrimoine mondial de l\u2019UNESCO depuis 1998. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Inscrita en la lista del Patrimonio Mundial de la UNESCO, la Grand Place comienza a construirse en el siglo XV. Primeramente, se erigen el mercado y algunas casas gremiales; despu\u00e9s, un Ayuntamiento con el que asentar la autoridad de dicho espacio de comercio. V\u00edctima del bombardeo perpetrado por el Ej\u00e9rcito franc\u00e9s durante 3 d\u00edas en 1695, la plaza queda pr\u00e1cticamente destruida pero, como si de un f\u00e9nix se tratase, resurgir\u00e1 de sus cenizas en menos de 5 a\u00f1os. Esa es la raz\u00f3n subyacente en el eclecticismo de la plaza: en ella, cuatro estilos conviven e incluso se superponen en ocasiones: g\u00f3tico, barroco opulento, neocl\u00e1sico y neog\u00f3tico. La torre del Ayuntamiento tiene una altitud aproximada de 96 metros.\r\n\r\nUn emplazamiento hist\u00f3rico\r\n\r\nLugar hist\u00f3rico, la Grand Place ha asistido a numerosos acontecimientos tanto alegres como tr\u00e1gicos:\r\n\r\nen 1523, los primeros m\u00e1rtires protestantes, Henri Voes y Jean Van Eschen, son quemados a manos de la Inquisici\u00f3n,\r\nen 1568, los condes de Egmont y de Hornes son decapitados.\r\nEn agosto de 1695, durante la Guerra de la Liga de Augsburgo, la mayor\u00eda de casas aleda\u00f1as a la Grand Place, algunas de ellas construidas a\u00fan en madera, son arrasadas durante el bombardeo de la ciudad a manos de las tropas francesas dirigidas por el mariscal de Villeroy. \u00danicamente la fachada y la torre del Ayuntamiento, que serv\u00eda de objetivo a los artilleros, as\u00ed como ciertos muros en piedra, resisten a las bolas incendiarias. Varios gremios se encargan de la r\u00e1pida reconstrucci\u00f3n de las casas que enmarcan la plaza, esta vez, en piedra. Entre ellas, se encuentra la casa gremial de los maestros cerveceros, que alberga hoy el Mus\u00e9e des Brasseurs (Museo de los Maestros Cerveceros).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Grote Markt","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grote Markt","address_line2":"1000 Bruxelles","description_web":"De Brusselse Grote Markt, die te boek staat als een van de mooiste pleinen ter wereld, is een must-see op het toeristische trekpleisterlijstje.  \r\n \r\nDoor de aanwezigheid van het stadhuis van Brussel heeft het plein ook nog steeds een politieke en administratieve functie: de burgemeester en de meeste schepenen werken hier.  \r\n\r\nHet is ook een plek die aanzien uitstraalt. Getuige daarvan zijn de vele plechtige, feestelijke of symbolische evenementen die er plaatsvinden: concerten, braderie\u00ebn, volksfeesten, de jaarlijkse kerstboom en -kribbe, klank- en lichtspelen, het bloementapijt in de zomer en de huldiging van sporters na een uitzonderlijke prestatie (denk bijvoorbeeld aan het WK voetbal in 2018). \r\n\r\nDe geschiedenis van de Grote Markt als 'marktplaats' gaat terug tot de twaalfde eeuw. Na verloop van tijd werden rondom het plein huizen en hallen opgetrokken, voornamelijk van hout. De bouw van het prachtige gotische stadhuis in de vijftiende eeuw verliep in drie fasen. Vanaf die periode zouden ook de gildehuizen het uitzicht van de Grote Markt mee bepalen. Meer nog dan vandaag was de Grote Markt in die tijd het kloppende hart van de stad, op economisch, cultureel en gerechtelijk vlak. Zo werd er duchtig handel gedreven (in de hallen gingen brood \u2013 het huidige Broodhuis \u2013 vlees, stoffen enzovoort over de toonbank), kon je op het plein theatervoorstellingen bijwonen en vonden er openbare terechtstellingen plaats. Het was uiteraard ook de plek waar het lokale beleid werd uitgetekend. \r\n\r\nNa een bombardement door de troepen van Lodewijk XIV in 1695 werd de Grote Markt zo goed als volledig heropgebouwd. Tijdens de eeuwen daarna ondergingen nog heel wat gebouwen grootschalige renovaties en aanpassingen. Vooral in de negentiende eeuw werd het plein in zijn huidige gedaante vastgelegd. \r\n\r\nDe Grote Markt van Brussel staat sinds 1998 op de Werelderfgoedlijst van de Unesco. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":266,"location":{"lat":50.84644089,"lon":4.35147641},"region":"brussels","last_updated_at":"2023-08-14T16:33:08+02:00","published_at":"2013-10-19T01:13:24+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":258936,"translations":{"de":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":"Bravo Discovery offers you a quality tour guide service anywhere in Belgium.\r\nWe work in conjunction with the Brussels tourism office. We practice responsible tourism while respecting the local economy. Our employees are professional guides and we have a team of freelance guides trained in the \u201cHaute \u00c9coles\u201d of Brussels.\r\n\u200bWe work in partnership with local businesses and can call on a range of quality service providers to suit your needs.\r\nWe specialize in providing tailor-made tours, based on the interests of our clients and mindful of the need to balance culture and relaxation.\r\n\u200bOur strengths: experience, local guides, enthusiastic and charismatic staff.\r\nOur values: responsible tourism, professionalism, respect of the historical and cultural heritage, protection of the environment, sustainable competitiveness.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":"Bravo Discovery vous offre un service de qualit\u00e9 sur toute la Belgique, avec l'\u00e9thique d'un tourisme responsable.\r\nNous travaillons en partenariat avec l'Office du Tourisme bruxellois (visit.brussels). Nos collaborateurs sont des guides professionnels et nous avons une \u00e9quipe de guides free-lance dont la plupart ont \u00e9t\u00e9 form\u00e9s dans les Hautes \u00c9coles bruxelloises.\r\n\u200bNotre sp\u00e9cialisation : nous sommes sp\u00e9cialis\u00e9s dans les visites guid\u00e9es faites sur mesure, adapt\u00e9es aux attentes de nos clients. Nous sommes \u00e9galement attentifs \u00e0 l'\u00e9quilibre entre culture et d\u00e9lassement.\r\n\u200bNotre force : exp\u00e9rience, guides locaux, collaborateurs passionn\u00e9s.\r\nNos valeurs : professionnalisme, passion du patrimoine, tourisme responsable.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Bravo Discovery sprl","address_street_name":"ZuitStaat","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"ZuitStaat, 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":18936,"location":{"lat":50.8456244,"lon":4.34948132},"last_updated_at":"2022-10-10T10:25:09+02:00