ren 9-12 yr.","Teachers","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors"],"de":["Familie","Schulen","Kinder 3-6 Jahre","Kinder 6-9 Jahre","Kinder 9-12 Jahre","Lehrkr\u00e4fte","Jugendliche 12-15 Jahre","Jugendliche 15-18 Jahre","LGTBQIA","Senioren"],"it":["Famiglie","Scuole","Bambini 3-6 anni","Bambini 6-9 anni","Bambini 9-12 anni","Insegnanti","Ragazzi 12-15 anni","Ragazzi 15-18 anni","LGTBQIA","Anziani"],"sp":["Familias","Escuelas","Ni\u00f1os de 3 a 6 a\u00f1os","Ni\u00f1os de 6 a 9 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os","Profesores","J\u00f3venes de 12 a 15 a\u00f1os","J\u00f3venes de 15 a 18 a\u00f1os","LGTBQIA","Personas de la tercera edad"],"pt":[null,null,null,null,null,null,null,null,null,null],"cn":[null,null,null,null,null,null,null,null,null,null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-24T02:08:09+02:00","published_at":"2022-08-11T16:56:56+02:00","backoffice_id":259551,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.12483766215501},{"id":509499,"date_start":"2021-03-07","date_end":"2023-08-31","date_next":"2023-04-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"],"de":["Ausgefallenes"],"it":["Insolito"],"sp":["Ins\u00f3lito"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortdescr":"D\u00e9couvrez les gentils, les m\u00e9chants, les beaux, les laids, les stars et les anonymes,\u2026 Tous ceux qui ont forg\u00e9 Bruxelles, depuis que Bruxelles existe et jusqu\u2019\u00e0 aujourd\u2019hui.","longdescr":"- Visite guid\u00e9e insolite \u00e0 prix libre : Payez en fin de tour la prix qui vous semble juste -\r\n\r\nPartez \u00e0 la rencontre des Brusseleirs. Les gentils, les m\u00e9chants, les beaux, les laids, les stars et les inconnus,\u2026 Tous ceux qui ont fait Bruxelles depuis que Bruxelles existe et jusqu\u2019\u00e0 aujourd\u2019hui.\r\n\r\nFaites la connaissance des Bruxellois les plus marquants de l\u2019Histoire, ceux sans qui rien ne serait pareil\u2026 Parce que ce qui fait Bruxelles, avant tout, ce sont les bruxellois !\r\n\r\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\r\nLe tour \u201cBrusseleirs d\u2019Hier et d\u2019Aujourd\u2019hui\u201d vous emm\u00e8ne sur les traces de quelques personnages embl\u00e9matiques qui ont marqu\u00e9 l\u2019Histoire de la ville (en bien ou en mal).\r\n\r\nAinsi, au fil d\u2019une agr\u00e9able balade hors des circuits classiques, vous ferez connaissance avec les dikkeneks (grandes gueules), les zwanzeurs et les kweebus (fous, tordus) de l\u2019Histoire\u2026\r\n\r\nLes personnages pr\u00e9sent\u00e9s sont on ne peut plus vari\u00e9s et \u00e9clectiques :\r\n\u2013 Audrey Hepburn\r\n\u2013 Stromae\r\n\u2013 Andr\u00e9 V\u00e9sale\r\n\u2013 Bonom\r\n\u2013 Madame Chapeau\r\n\u2013 \u2026\r\n\r\n\r\n\r\nINFORMATIONS PRATIQUES\r\n\r\nTours r\u00e9guliers en fran\u00e7ais, n\u00e9erlandais, anglais :\r\nPrix  : Libre et conscient*\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : Place Poelaert (au pied du Monument aux Morts), 1000 Bruxelles\r\nFin du tour : Vers la place Fontainas\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais, anglais, n\u00e9erandais ou espagnol","performers":"Visite guid\u00e9e originale de la compagnie de guide ind\u00e9pendants Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/brusseleirs-dhier-et-daujourdhui\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.509499"},"nl":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/brusseleirs-dhier-et-daujourdhui\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.509499"},"en":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/brusseleirs-dhier-et-daujourdhui\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.509499"},"de":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/brusseleirs-dhier-et-daujourdhui\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.509499"},"it":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/brusseleirs-dhier-et-daujourdhui\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.509499"},"sp":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/brusseleirs-dhier-et-daujourdhui\/","email":"info@brusselsbyfoot.com