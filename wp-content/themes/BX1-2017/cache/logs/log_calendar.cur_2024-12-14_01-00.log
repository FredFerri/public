riemartel.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004222"},"en":{"name":"\u00c9ric Lamb\u00e9 | 19m\u00b2 \u2014 Antipodes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004222"},"it":{"name":"Exposition | \u00c9ric Lamb\u00e9 | 19m\u00b2 \u2014 Antipodes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004222"},"cn":{"name":"Exposition | \u00c9ric Lamb\u00e9 | 19m\u00b2 \u2014 Antipodes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004222"},"fr":{"name":"\u00c9ric Lamb\u00e9 | 19m\u00b2 \u2014 Antipodes","shortdescr":null,"longdescr":"Se plonger dans l\u2019univers d\u2019\u00c9ric Lamb\u00e9, c\u2019est entreprendre une \u00e9pop\u00e9e graphique et narrative des plus singuli\u00e8res. L\u2019artiste belge, qui explore diff\u00e9rentes techniques de dessin, fa\u00e7onne une \u0153uvre aux sc\u00e8nes riches, o\u00f9 foisonnent les personnages intrigants. La Galerie Martel BXL se r\u00e9jouit de pouvoir exposer, \u00e0 partir du 14 d\u00e9cembre 2024, une s\u00e9lection d\u2019originaux issus de ses cr\u00e9ations \"19m\u00b2\" (Sigaretten, 2024) et \"Antipodes\" (Casterman, 2024).\n\nFigure importante de la sc\u00e8ne artistique belge, \u00c9ric Lamb\u00e9 a \u00e9t\u00e9 couronn\u00e9 en 2017, aux c\u00f4t\u00e9s de Philippe de Pierpont, du Fauve d\u2019or du meilleur album au Festival d'Angoul\u00eame pour \u201cPaysage apr\u00e8s la bataille\u201d (co\u00e9dition Fr\u00e9mok\/Actes Sud).\n\nEn 2024, plusieurs de ses cr\u00e9ations sont expos\u00e9es au Centre Pompidou, \u00e0 Paris, dans le cadre de l\u2019exposition \u201cLa bande dessin\u00e9e au Mus\u00e9e\u201d. L\u2019institution fera par la suite l\u2019acquisition de sept originaux issus de son ouvrage \u201cLe Fils du Roi\" (Fr\u00e9mok, 2012)\n","performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004222"},"sp":{"name":"Exposition | \u00c9ric Lamb\u00e9 | 19m\u00b2 \u2014 Antipodes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004222"},"nl":{"name":"\u00c9ric Lamb\u00e9 | 19m\u00b2 \u2014 Antipodes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004222"}},"place":{"id":50002691,"translations":{"de":{"name":"Galerie Martel BXL","address_street_name":"Chauss\u00e9e d'Ixelles","address_street_number":"337","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e d'Ixelles, 337","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Galerie Martel BXL","address_street_name":"Chauss\u00e9e