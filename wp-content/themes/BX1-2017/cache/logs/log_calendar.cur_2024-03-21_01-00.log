:false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-20T01:01:40+01:00","published_at":"2024-03-07T13:24:48+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296102,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.31833136784577337,"languages":{"spoken":["nl","de","it","fr","es","en","pl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Artists and Paintings. Iszchan Nazarian and Monika Rossa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008195"},"pt":{"name":"Artists and Paintings. Iszchan Nazarian and Monika Rossa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008195"},"en":{"name":"Artists and Paintings. Iszchan Nazarian and Monika Rossa","shortdescr":"The Katarzyna Napi\u00f3rkowska Art Gallery in Brussels will host an exhibition entitled Artists & Paintings, presenting the work of Ishchan Nazarian and Monika Rossa.","longdescr":"Ishchan Nazarian is of Armenian origin. He lives and works in the United States. However, his biography also has a Polish thread \u2013 he studied at the Academy of Fine Arts in Warsaw. After these studies, his career began many years ago. He was, among others, the winner of the Palme d\u2019Or at the Monte Carlo painting festival. The most important topic in Nazarian\u2019s painting is man. In an expressive formula, Nazarian tries to record emotional states. He always shows the characters in his art in a specific context, indicating that the paintings have their source and inspiration in life. He often creates self-referential paintings that talk about the artist\u2019s condition. He dedicated several of his works to Van Gogh, an artist who determined the artist\u2019s relationship to the world for several new generations.\n\nMonika Rossa studied painting and drawing, among others, at the Acad\u00e9mie des Beaux-Arts in Paris and at the Escuela de Dise\u00f1o in Barcelona. She has been living and working in the United States for many years. For many years, she created almost exclusively figurative works. Unexpected \u2013 she abandoned literalism in favour of abstraction. However, even seemingly \u201cradically\u201d non-representational works contain the suggestions of a landscape. Monika Rossa\u2019s painting comes from a careful, humble and admiring observation of nature, to which the artist gives autonomously more distinct rhythms and tensions.\n\nArtists and Paintings. Ishchan Nazarian \/ Monika Rossa\nGalerie de Katarzyna Napiorkowska\nMont des Arts 8, Brussels\nOpening: March 8, 2024 at 7 p.m\nExhibition: until April 8, 2024","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008195"},"it":{"name":"Artists and Paintings. Iszchan Nazarian and Monika Rossa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008195"},"cn":{"name":"Artists and Paintings. Iszchan Nazarian and Monika Rossa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008195"},"fr":{"name":"Artistes et tableaux. Iszchan Nazarian et Monika Rossa","shortdescr":null,"longdescr":"Ishchan Nazarian est d'origine arm\u00e9nienne. Il vit et travaille aux \u00c9tats-Unis. Cependant, sa biographie a aussi un fil conducteur polonais : il a \u00e9tudi\u00e9 \u00e0 l\u2019Acad\u00e9mie des Beaux-Arts de Varsovie. Apr\u00e8s ces \u00e9tudes, sa carri\u00e8re a d\u00e9but\u00e9 il y a de nombreuses ann\u00e9es. Il fut, entre autres, laur\u00e9at de la Palme d\u2019Or au festival de peinture de Monte-Carlo. Le th\u00e8me le plus important dans la peinture de Nazarian est l\u2019homme. Dans une formule expressive, Nazarian tente d'enregistrer les \u00e9tats \u00e9motionnels. Il montre toujours les personnages de son art dans un contexte sp\u00e9cifique, indiquant que les peintures trouvent leur source et leur inspiration dans la vie. Il cr\u00e9e souvent des peintures autor\u00e9f\u00e9rentielles qui parlent de la condition de l\u2019artiste. Il a d\u00e9di\u00e9 plusieurs de ses \u0153uvres \u00e0 Van Gogh, un artiste qui a d\u00e9termin\u00e9 le rapport de l\u2019artiste au monde pour plusieurs nouvelles g\u00e9n\u00e9rations.\n\nMonika Rossa a \u00e9tudi\u00e9, entre autres, la peinture et le dessin \u00e0 l'Acad\u00e9mie des Beaux-Arts de Paris et \u00e0 l'Escuela de Dise\u00f1o de Barcelone. Elle vit et travaille aux \u00c9tats-Unis depuis de nombreuses ann\u00e9es. Pendant de nombreuses ann\u00e9es, elle cr\u00e9e des \u0153uvres presque exclusivement figuratives. Inattendu \u2013 elle abandonne le litt\u00e9ralisme au profit de l\u2019abstraction. Cependant, m\u00eame les \u0153uvres apparemment \u00ab radicalement \u00bb non figuratives contiennent les suggestions d\u2019un paysage. La peinture de Monika Rossa est issue d\u2019une observation attentive, humble et admirative de la nature, \u00e0 laquelle l\u2019artiste donne de mani\u00e8re autonome des rythmes et des tensions plus distincts.\n\nArtistes et peintures. Ishchan Nazarian \/ Monika Rossa\nGalerie de Katarzyna Napiorkowska\nMont des Arts 8, Bruxelles\nVernissage : 8 mars 2024 \u00e0 19h\nExposition : jusqu'au 8 avril 2024","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008195"},"sp":{"name":"Artists and Paintings. Iszchan Nazarian and Monika Rossa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008195"},"nl":{"name":"Artists and Paintings. Iszchan Nazarian and Monika Rossa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008195"}},"place":{"id":251322,"translations":{"de":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"website":"http:\/\/www.napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Mont des Arts, 8","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"we