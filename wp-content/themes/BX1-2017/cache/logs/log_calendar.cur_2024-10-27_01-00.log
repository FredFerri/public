nt":false,"backoffice_id":307149,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.35163388691695935,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[27,24],"translations":{"de":["Fotografie","Kunstgalerien"],"pt":[null,null],"en":["Photography","Art Galleries"],"it":["Fotografia","Gallerie d'arte"],"cn":[null,null],"fr":["Photographie","Galeries d'art"],"sp":["Fotograf\u00eda","Galer\u00edas de arte"],"nl":["Fotografie","Galeries"]}}},"translations":{"de":{"name":"Exposition Proche Orient - Baudoin Lotin - Michel Eisenlohr","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000916"},"pt":{"name":"Exposition Proche Orient - Baudoin Lotin - Michel Eisenlohr","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000916"},"en":{"name":"Exhibition \"Middle East\" - Baudoin Lotin - Michel Eisenlohr","shortdescr":"Kurdistan - Syria. This new exhibition brings together the views of Baudoin Lotin and Michel Eisenlohr on these two countries before the conflicts.\nBetween 1999 and 2002, they were able to capture moments of life and magnificent landscapes.\nTwo unique and yet complementary views on the history of these two countries.","longdescr":"Kurdistan - Syria.\nTwo countries that have been living in a civil war since 2011.\n\nThe work of a photographer is a testimony of a moment, as if he wanted to stop time at the moment he chose to trigger and immortalize the scene that he sublimates with his gaze.\n\nThis new exhibition brings together the views of Baudoin Lotin and Michel Eisenlohr on these two countries before the conflicts.\nBetween 1999 and 2002, they were able to capture moments of life and magnificent landscapes.\nTwo unique and yet complementary views on the history of these two countries.","performers":"Baudoin Lotin, Belgian photographer, discovered photography at the Ecole Sup\u00e9rieure Artistique le 75 in Brussels under the direction of Yves Auquier. He is represented by the Le R\u00e9verb\u00e8re gallery in Lyon (France)\n\nMichel Eisenlohr, a French author-photographer for about fifteen years, produces his reports in France and abroad.","boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000916"},"it":{"name":"Exposition Proche Orient - Baudoin Lotin - Michel Eisenlohr","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000916"},"cn":{"name":"Exposition Proche Orient - Baudoin Lotin - Michel Eisenlohr","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000916"},"fr":{"name":"Exposition Proche Orient - Baudoin Lotin - Michel Eisenlohr","shortdescr":"Kurdistan - Syrie. Cette nouvelle exposition met en vis-\u00e0-vis les regards de Baudoin Lotin et Michel Eisenlohr sur ces deux pays avant les conflits.\nEntre 1999 et 2002, ils ont pu capturer des moments de vie et des paysages magnifiques.\nDeux regards singuliers et pourtant compl\u00e9mentaires sur l\u2019histoire de ces deux pays.","longdescr":"Kurdistan - Syrie.\nDeux pays qui vivent dans une guerre civile depuis 2011.\n\nLe travail d\u2019un photographe est un t\u00e9moignage d\u2019un moment, comme s\u2019il voulait arr\u00eater le temps a l\u2019instant o\u00f9 il \u00e0 choisi de d\u00e9clencher et d\u2019immortaliser la sc\u00e8ne qu\u2019il sublime par son regard.\n\nCette nouvelle exposition met en vis-\u00e0-vis les regards de Baudoin Lotin et Michel Eisenlohr sur ces deux pays avant les conflits.\nEntre 1999 et 2002, ils ont pu capturer des moments de vie et des paysages magnifiques.\nDeux regards singuliers et pourtant compl\u00e9mentaires sur l\u2019histoire de ces deux pays.","performers":"Baudoin Lotin, photographe belge, d\u00e9couvre la  photographie \u00e0 l\u2019Ecole Sup\u00e9rieure Artistique le 75 \u00e0 Bruxelles sous la direction d\u2019Yves Auquier. Il est repr\u00e9sent\u00e9 par la galerie Le R\u00e9verb\u00e8re \u00e0 Lyon (France)\n\nMichel Eisenlohr, auteur-photographe fran\u00e7ais depuis une quinzaine d\u2019ann\u00e9es, r\u00e9alise ses reportages en France et \u00e0 l\u2019\u00e9tranger.","boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000916"},"sp":{"name":"Exposition Proche Orient - Baudoin Lotin - Michel Eisenlohr","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000916"},"nl":{"name":"Midden-Oostententoonstelling - Baudoin Lotin - Michel Eisenlohr","shortdescr":"Koerdistan - Syri\u00eb. Deze nieuwe tentoonstelling brengt de opvattingen van Baudoin Lotin en Michel Eisenlohr over deze twee landen v\u00f3\u00f3r de conflicten samen.\nTussen 1999 en 2002 waren ze in staat momenten van het leven en prachtige landschappen vast te leggen.\nTwee unieke en toch complementaire perspectieven op de geschiedenis van deze twee landen.","longdescr":"Koerdistan - Syri\u00eb.\nTwee landen die sinds 2011 in een burgeroorlog leven.\n\nHet werk van een fotograaf is een getuigenis van een moment, alsof hij de tijd wil stopzetten op het moment dat hij ervoor kiest de sc\u00e8ne die hij met zijn blik sublimeert, te triggeren en te vereeuwigen.\n\nDeze nieuwe tentoonstelling brengt de opvattingen van Baudoin Lotin en Michel Eisenlohr over deze twee landen v\u00f3\u00f3r de conflicten samen.\nTussen 1999 en 2002 waren ze in staat momenten van het leven en prachtige landschappen vast te leggen.\nTwee unieke en toch complementaire perspectieven op de geschiedenis van deze twee landen.","performers":"Baudoin Lotin, Belgische fotograaf, ontdekte fotografie aan de Ecole Sup\u00e9rieure Artistique le 75 in Brussel onder leiding van Yves Auquier. Hij wordt vertegenwoordigd door de galerie Le R\u00e9verb\u00e8re in Lyon (Frankrijk)\n\nMichel Eisenlohr, al zo'n vijftien jaar een Franse auteur-fotograaf, produceert zijn reportages in Frankrijk en in het buitenland.","boxoffice_url":null,"website":"http:\/\/studiobaxton.com","email":"info@studiobaxton.com","phone_contact":"+32 2 513 22 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000916"}},"place":{"id":256649,"translations":{"de":{"name":"Studio Baxton","address_street_name":"Place de la Vieille Halle aux Bl\u00e9s","address_street_number":"29","address_street_box":null,"email":"info@studiobaxton.com","website":"https:\/\/www.studiobaxton.com\/","phone_contact":"+32 2 513 22 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Vie