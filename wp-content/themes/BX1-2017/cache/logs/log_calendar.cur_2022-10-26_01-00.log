":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/0b966f1394edfdeec4a50e5280ecb99ffa5224bc.jpg","width":1872,"height":2808,"ratio":0.67,"translations":{"fr":{"title":"Carlou D (S\u00e9n\u00e9gal)","copyright":"Sidy"},"nl":{"title":"Carlou D (S\u00e9n\u00e9gal)","copyright":"Sidy"},"en":{"title":"Carlou D (S\u00e9n\u00e9gal)","copyright":"Sidy"}}}],"dates":[{"day":"2022-10-29","doors":null,"start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":20},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":18},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[10,12,8,7,11,19,5],"translations":{"fr":["Seniors","LGTBQIA","Jeunes 15-18 ans","Jeunes 12-15 ans","Famille","Enseignants","Enfants 9-12 ans"],"nl":["Senioren","LGTBQIA","Jongeren 15-18 j.","Jongeren 12-15 j.","Familie","Leerkrachten","Kinderen 9-12 j."],"en":["Seniors","LGTBQIA","Youth 15-18  yr.","Youth 12-15  yr.","Family","Teachers","Children 9-12 yr."]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T02:06:14+02:00","published_at":"2022-09-05T17:25:14+02:00","backoffice_id":261065,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":542078,"date_start":"2022-10-29","date_end":"2022-10-29","date_next":"2022-10-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":"SAM 29\/10\r\nReconnaissable par sa voix claire, Carlou D est un artiste qui combine la musique mystique et spirituelle Zikr des Baye Fall, une communaut\u00e9 soufie du S\u00e9n\u00e9gal, avec les grooves du funk, des \u00e9l\u00e9ments du mbalax s\u00e9n\u00e9galais et de l\u2019afro-pop pour cr\u00e9er un style authentique.","longdescr":"Carlou D, de son vrai nom Ibrahima Loucard, est n\u00e9 dans la banlieue de Dakar, la capitale du S\u00e9n\u00e9gal. Il a commenc\u00e9 sa carri\u00e8re musicale en tant que membre du Positive Black Soul : l\u2019un des groupes de hip-hop les plus c\u00e9l\u00e8bres du pays, et il a \u00e9t\u00e9 soutenu par le l\u00e9gendaire Youssou N\u2019Dour avant de collaborer avec lui. Aujourd\u2019hui il a peut-\u00eatre laiss\u00e9 le hip-hop un peu derri\u00e8re lui, mais il n\u2019en a pas perdu l\u2019esprit : \u00ab La part de hip-hop que j\u2019ai gard\u00e9e dans ma musique, c\u2019est le courage d\u2019\u00eatre direct \u00bb, confie le guitariste, chanteur et danseur d\u2019exception. Profond\u00e9ment enracin\u00e9 dans les rythmes africains, le chanteur et interpr\u00e8te s\u00e9n\u00e9galais \u00e0 succ\u00e8s porte des paroles engag\u00e9es avec une dimension et une extase mystique. Carlou D est ind\u00e9niablement l\u2019un des grands noms du S\u00e9n\u00e9gal contemporain.","performers":"Carlou D: voix, guitare\r\nMouhamadou Doumbouya: percussions\r\nIbrahima Ndir: calebasse\r\nDjiby Diabate: balafon\r\nFabrice Devienne: clavier\r\nVieux Kante Magassa : percussions","boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20221029-carlou-d-senegal\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542078"},"nl":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542078"},"en":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542078"},"de":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542078"},"it":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542078"},"sp":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542078"},"pt":{"name":"Carlou D (S\u00e9n\u00e9gal) The king of the Zikr-grooves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_u