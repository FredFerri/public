-08-14T17:00:25+02:00","published_at":"2023-08-11T16:38:55+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283135,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"tour","ranking":1,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[104],"translations":{"de":["Jugendstil, Art d\u00e9co"],"pt":[null],"en":["Art Nouveau, Art D\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"cn":[null],"fr":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"Heritage days Train World 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/heritage-days-2023","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000936"},"pt":{"name":"Heritage days Train World 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/heritage-days-2023","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000936"},"en":{"name":"Heritage days Train World 2023","shortdescr":"On Saturday 16 and Sunday 17 September 2023 the Heritage Days will take place in the Brussels Region and on the territory of the City of Brussels. The 2023 theme is 'Art Nouveau, art for all?'. Train World participates the whole weekend.","longdescr":"On Saturday 16 and Sunday 17 September 2023 the Heritage Days will take place in the Brussels Region and on the territory of the City of Brussels.\n\nDiscover the wealth of buildings, institutions and real-estate in Brussels during these two days. Every year a specific theme allows to discover Brussels from another point of view. The 2023 theme is 'Art Nouveau, art for all?'.\n\nTrain World participates as well. The old train station of Schaerbeek will be made accessible with a guide. A visit of Train World is not included!\n\nHours : 10 am, 11 am, 12 am, 2 pm, 3 pm\n\nYou want more information or you want to book your visit? Follow this link: https:\/\/heritagedays.urban.brussels\/","performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/en\/heritage-days-2023","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000936"},"it":{"name":"Heritage days Train World 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/heritage-days-2023","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000936"},"cn":{"name":"Heritage days Train World 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/heritage-days-2023","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000936"},"fr":{"name":"Heritage days Train World 2023","shortdescr":"Le samedi 16 et le dimanche 17 septembre 2023 auront lieu les \"Heritage Days\" (Journ\u00e9es du patrimoine) dans toute la R\u00e9gion bruxelloise et sur le territoire de la Ville de Bruxelles. Le th\u00e8me de cette ann\u00e9e est Art Nouveau, art for all? (Art nouveau, art pour tou\u00b7te\u00b7s?). Train World participe tout le weekend.","longdescr":"Le samedi 16 et le dimanche 17 septembre 2023 auront lieu les \"Heritage Days\" (Journ\u00e9es du patrimoine) dans toute la R\u00e9gion bruxelloise et sur le territoire de la Ville de Bruxelles.\n\nDeux journ\u00e9es incontournables pour d\u00e9couvrir la richesse architecturale de la capitale. Les \u201cHeritage Days\u201d permettent de sensibiliser la population aux merveilles de l\u2019architecture. Chaque ann\u00e9e, une nouvelle th\u00e9matique permet de d\u00e9couvrir Bruxelles sous un nouveau jour. Le th\u00e8me de cette ann\u00e9e est Art Nouveau, art for all? (Art nouveau, art pour tou\u00b7te\u00b7s?).\n\nTrain World participe \u00e9galement \u00e0 cet \u00e9v\u00e8nement. Vous aurez l\u2019occasion de visiter l\u2019ancienne gare de Schaerbeek en compagnie d\u2019un\/une guide. L\u2019entr\u00e9e au reste du mus\u00e9e n\u2019est pas incluse.\n\nHoraires : 10h, 10h30, 11h, 11h30, 12h, 13h30, 14h, 14h30, 15h, 15h30\n\nVous souhaitez plus d\u2019informations ou vous voulez vous inscrire \u00e0 une des visites guid\u00e9es ? Alors suivez le lien suivant : https:\/\/heritagedays.urban.brussels\/\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/heritage-days-2023","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000936"},"sp":{"name":"Heritage days Train World 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/heritage-days-2023","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000936"},"nl":{"name":"Heritage days Train World 2023","shortdescr":"Op zaterdag 16 en zondag 17 september 2023 vinden de Heritage Days (Open Monumentendagen) plaats in heel het Brussels Hoofdstedelijk Gewest en op het grondgebied van de Stad Brussel. Het thema dit jaar is Art Nouveau, art for all? (Art nouveau, kunst voor iedereen?). Train World neemt het ganse weekend deel.","longdescr":"Op zaterdag 16 en zondag 17 september 2023 vinden de Heritage Days (Open Monumentendagen) plaats in heel het Brussels Hoofdstedelijk Gewest en op het grondgebied van de Stad Brussel.\n\nBezoekers kunnen kennismaken met het rijke architecturale erfgoed van de hoofdstad. De Heritage Days zijn dagen om de bevolking te sensibiliseren voor de wonderlijke architectuur. Het thema dit jaar is Art Nouveau, art for all? (Art nouveau, kunst voor iedereen?).\n\nOok Train World neemt deel aan dit event. Het oude station van Schaarbeek zal te bezichtigen zijn onder begeleiding van een gids. Een bezoek aan Train World is niet inbegrepen!\n\nUren : 10u30, 11u30, 13u30, 14u30, 15u30\n\nMeer info of wil je je inschrijven voor een rondleiding? Volg deze link: https:\/\/heritagedays.urban.brussels\/ ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/nl\/heritage-days-2023","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000936"}},"place":{"id":252663,"translations":{"de":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"N\u00e4chste Haltestelle Train World... kleine und gro\u00dfe Eisenbahnfreunde erwartet in Br\u00fcssel ein neues \u201eMekka\": In dem historischen Geb\u00e4ude des ehemaligen Bahnhofs von Schaerbeek erwartet Sie das spektakul\u00e4re Eisenbahnmuseum Train World, dessen Szenographie aus der Feder des belgischen Comic-K\u00fcnstlers Fran\u00e7ois Schuiten stammt.\r\n\r\nSch\u00e4tze aus der Welt der Eisenbahn: Von der \u00e4ltesten Dampflokomotive Belgiens \u00fcber prunkvolle k\u00f6nigliche Wagons bis hin zu den modernen Hochgeschwindigkeitsz\u00fcgen - Train World f\u00fchrt die Besucher durch die belgische Eisenbahngeschichte. Neben historischem und technischem Wissen gibt es auch Anekdoten und Kuriosit\u00e4ten aus der Welt der Eisenbahn zu entdecken. Wie ist eine Schiene aufgebaut, wie schnell fuhren die ersten Dampfloks, wie reisten einst die K\u00f6nige? Antworten auf all diese Fragen geben die Erkl\u00e4rungstafeln, die auch auf Deutsch zur Verf\u00fcgung stehen, sowie die kostenlosen Audioguides (ebenfalls auf Deutsch).\r\n\r\nFahrsimulator: Sie haben schon immer davon getr\u00e4umt, Lokomotivf\u00fchrer zu werden? Dann nehmen Sie Platz im F\u00fchrerstand des Fahrsimulators und begeben sich auf eine Reise durch die Eisenbahngeschichte.\r\n\r\nLeibliches Wohl:\r\n\r\nIn der Brasserie \"RN Express\", die in dem historischen Bahnhofsgeb\u00e4ude untergebracht ist, gibt es Speisen und Getr\u00e4nke. Tiefblaue W\u00e4nde, gl\u00e4serne Kugellampen und Holzmobiliar sorgen f\u00fcr ein besonderes Ambiente.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World, o novo polo de atra\u00e7\u00e3o de Bruxelas\r\nTrain World, a montra dos caminhos de ferro de ontem, de hoje e de amanh\u00e3, \u00e9 a nova atra\u00e7\u00e3o tur\u00edstica de Bruxelas desde setembro de 2015. O local situa-se em Schaerbeek, a alguns minutos de comboio da Esta\u00e7\u00e3o Central (pr\u00f3ximo da Grand-Place).\r\nN\u00e3o est\u00e3o a\u00ed expostas apenas as pe\u00e7as mais belas da cole\u00e7\u00e3o de locomotivas e de ve\u00edculos hist\u00f3ricos dos caminhos de ferro belgas, mas tamb\u00e9m \u00e9 ilustrado o papel importante do comboio na mobilidade atual e do futuro. Train World \u00e9 mais do que um museu, trata-se de um centro de interpreta\u00e7\u00e3o. A cenografia original \u2013 desenvolvida pelo artista Fran\u00e7ois Schuiten- cria uma experi\u00eancia interativa durante a qual o p\u00fablico pode olhar, ouvir, tocar e deixar-se surpreender por hist\u00f3rias apaixonantes do mundo ferrovi\u00e1rio.\r\nO local, situado ao longo do tra\u00e7ado da primeira linha de caminhos de ferro do continente europeu (Bruxelas\u2013Mechelen, 1835), inclui a esta\u00e7\u00e3o renovada de Schaerbeek, onde se encontra a bilheteira, e uma constru\u00e7\u00e3o nova de 8000 m\u00b2. Note-se que a esta\u00e7\u00e3o, constru\u00edda em 1887, \u00e9 um dos baluartes da arquitetura ferrovi\u00e1ria belga e um monumento classificado. Um estabelecimento de hoteleira e restaura\u00e7\u00e3o situado na esta\u00e7\u00e3o completa a oferta de Train World.\r\nUma oferta muito diversificada destinada a todo o mundo\r\nTrain World aloja in\u00fameros tesouros a descobrir. Por exemplo, \u00e9 poss\u00edvel a\u00ed admirar a locomotiva a vapor mais antiga mantida na B\u00e9lgica, a \u201cPa\u00eds de Waes\u201d. Ou ainda a locomotiva a vapor de carenagem \u201ctipo 12\u201d, que estabeleceu um novo recorde de velocidade em 1939. Tamb\u00e9m \u00e9 poss\u00edvel contemplar aut\u00eanticos e sumptuosos ve\u00edculos reais ou penetrar um dos ve\u00edculos TEE inox, antecessor dos comboios de grande velocidade, que percorriam a Europa na \u00e9poca. Com vontade de assumir o comando de um comboio?\r\nPoder\u00e1 experiment\u00e1-lo, num simulador de condu\u00e7\u00e3o. No lugar do condutor, poder\u00e1 observar as mudan\u00e7as no ambiente das linhas ao longo dos anos.\r\nTrain World apresenta igualmente centenas de objetos do mundo ferrovi\u00e1rio, como uniformes, pinturas ou maquetas de comboios e de esta\u00e7\u00f5es, assim como in\u00fameras fotos e videoclipes. A notar igualmente: a apresenta\u00e7\u00e3o de uma aut\u00eantica casinha de guarda das passagens de n\u00edvel, retomada na nova constru\u00e7\u00e3o de Train World. Estar\u00e1 mobilada com uma decora\u00e7\u00e3o dos anos 50. No s\u00f3t\u00e3o, ser\u00e3o expostos comboios miniatura.\r\nAs escolas e as fam\u00edlias com crian\u00e7as pequenas poder\u00e3o aproveitar uma oferta espec\u00edfica que acentua tanto o aspeto educativo como o l\u00fadico. As crian\u00e7as poder\u00e3o dar espa\u00e7o \u00e0 sua alegria num espa\u00e7o de jogos, como m\u00ednimo, original, especialmente concebido para elas: uma locomotiva a vapor que emerge do solo.\r\nGra\u00e7as \u00e0 colabora\u00e7\u00e3o com os construtores de comboios, as tecnologias modernas e os desenvolvimentos futuros ser\u00e3o tamb\u00e9m abordados. Desse modo, o p\u00fablico poder\u00e1 admirar, por exemplo, tr\u00eas comboios de \u00faltima gera\u00e7\u00e3o.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World is a unique railway experience that takes you from the very first steam locomotives to the flashing high-speed trains! It is a universe that appeals to all the senses in order to grasp the many different dimensions of the railways. A visit to Train World is an active and surprising outing. You can walk among locomotives, take a seat in 100-year-old trains, visit a railway house and walk across a real railway bridge. You will even experience how it feels to drive a train!\r\n\r\n\r\n","description_print":"Train World, the showcase for the railways of yesterday, today and tomorrow, is a must-see tourist attraction in Brussels. The site is located a few minutes by train from Brussels Central station (near the Grand Place)\r\nHere you will be able to admire the loveliest pieces from the collection of historical locomotives and carriages from the Belgian railways, but it will also illustrate the significant role of the train in the mobility of today and in future. Train World is more than a museum: it will be an experience centre. An original scenography \u2013 designed by artist Fran\u00e7ois Schuiten \u2013 will provide an experience in which the audience can look, listen, touch and be surprised by scintillating stories from the world of trains.\r\nThe site comprises the renovated Schaerbeek station, where the ticket office is located, and a new 8,000 m\u00b2 building. A restaurant and a book & gift shop in the station completes the offering. It will also be possible to have a picnic: a restored carriage will be available in the transit area from the station to the new building for this purpose.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World. Il museo nazionale del treno aprir\u00e0 le porte alla stazione di Schaerbeek.\r\nTesori del mondo ferroviario\r\nTrain World custodir\u00e0 numerosi tesori: la pi\u00f9 antica locomotiva conservata in Belgio, la \u201cpaese di Waes\u201d, o la locomotive a vapore carenata \u201ctipo 12\u201d che aveva stabilito un record di velocit\u00e0 nel 1939.\r\n\r\nSimulatore di guida\r\n\r\nAvete sempre avuto voglia di guidare un treno ? Train World vi sistema in un simulatore di guida! Nel posto dell\u2019autista, potrete osservare i cambi dell\u2019ambiente lungo le linee ferroviarie nel corso degli anni.\r\n\r\nScuole e famiglie\r\n\r\nI vostri bambini potranno approfittare di un\u2019offerta specifica che mette l\u2019accanto sia sul aspetto educativo che divertente. Potranno approfittare di un spazio giochi originale.\r\n\r\nSala eventi\r\n\r\nTrain World entra in stazione e Bruxelles si dota di un nuovo luogo per eventi! Con 550 m\u00b2, la magnifica sala degli sportelli della stazione di Schaerbeek, risalendo al 1913, offrir\u00e0 un quadro unico per eventi. Sar\u00e0 dotata di un\u2019installazione audiovisuale moderna. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World est une exp\u00e9rience ferroviaire unique qui vous emm\u00e8ne des toutes premi\u00e8res locomotives \u00e0 vapeur aux trains \u00e0 grande vitesse flamboyants ! C'est un univers qui fait appel \u00e0 tous les sens pour appr\u00e9hender les multiples dimensions du chemin de fer. Une visite \u00e0 Train World est une sortie active et surprenante. Vous pouvez vous promener parmi les locomotives, prendre place dans des trains centenaires, visiter une maison de chemin de fer et traverser un v\u00e9ritable pont ferroviaire. Vous ferez m\u00eame l'exp\u00e9rience de la conduite d'un train !","description_print":"Vitrine du pass\u00e9, du pr\u00e9sent et du futur sur le monde ferroviaire, Train World est le nom du nouveau mus\u00e9e des chemins de fer, actuellement en construction pr\u00e8s de la gare de Schaerbeek. Il abritera les pi\u00e8ces les plus pr\u00e9cieuses du patrimoine historique.Train World rendra hommage \u00e0 la riche histoire du train, mais d\u00e9montrera aussi que les chemins de fer n'ont pas fini de jouer un r\u00f4le important dans le d\u00e9veloppement de notre pays.","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World, la nueva atracci\u00f3n tur\u00edstica de Bruselas.\r\n\r\nTrain World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\n\r\n","description_print":"Train World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\nTrain World will exceptionally be completely closed to the public from Monday 14 October to Monday 21 October 2019 and from Monday 16 March to Tuesday 17 March 2020 because of the assembly and dismantling of our exhibition dedicated to Paul Delvaux.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Prinses Elisabethplein","address_line2":"1030 Schaerbeek","description_web":"Train World is een unieke spoorervaring die je van de allereerste stoomlocomotieven tot de flitsende hogesnelheidstreinen brengt! Het is een universum dat een beroep doet op alle zintuigen om de vele verschillende dimensies van de spoorwegen te kunnen bevatten. Een bezoek aan Train World is een actieve en verrassende uitstap. Je wandelt tussen locomotieven, neemt plaats in treinen van 100 jaar oud, bezoekt een spoorweghuisje en loopt over een echte spoorwegbrug. Je ervaart zelfs hoe het voelt om een trein te besturen!","description_print":"Train World is sinds september 2015 het uitstalraam voor de spoorwegen van gisteren, vandaag en morgen in Brussel. De site bevindt zich in Schaarbeek, op nauwelijks 10 minuten met de trein vanuit Brussel-Centraal (bij de Grote Markt). \r\n\r\nDe mooiste stukken uit de collectie historische locomotieven en rijtuigen van de Belgische spoorwegen zijn er te bewonderen, maar daarnaast wordt er ook de belangrijke rol van de trein in de mobiliteit van vandaag en de toekomst ge\u00efllustreerd. Train World is meer dan een museum: het is een belevingscentrum. Een originele scenografie \u2013 ontworpen door kunstenaar Fran\u00e7ois Schuiten - zorgt voor een ervaring waarbij je kan kijken, luisteren, aanraken en verrast worden door de boeiende verhalen uit de wereld van de trein.\r\n\r\n22-10-2019> 15-03-2020 : Tentoonstelling: Paul Delvaux, de man die van treinen hield \r\n\r\nPaul Delvaux (1897-1994) schilderde een meesterlijk oeuvre bijeen, met als inspiratiebron de wereld van de spoorwegen. Zijn surrealistische werken gaan moeiteloos op in de adembenemende scenografie van Train World. Als vanzelf ontstaat een boeiende dialoog.\r\n\r\nDeze expo is h\u00e9t uitgelezen moment om de artistieke evolutie van deze spoorwegliefhebber te ontdekken in een magische setting: van tekeningen, aquarellen en schilderijen uit de jaren 1920 tot monumentale werken uit de jaren 1970, maar ook persoonlijke objecten van de artiest voegen verrassende accenten toe. Dat de schilder in 1984 tot erestationschef van Louvain-la-Neuve werd benoemd, is veelbetekenend.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":14733,"location":{"lat":50.87762766,"lon":4.37866751},"region":"brussels","last_updated_at":"2023-08-14T16:25:03+02:00","published_at":"2013-10-19T01:54:59+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":252663,"translations":{"de":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"N\u00e4chste Haltestelle Train World... kleine und gro\u00dfe Eisenbahnfreunde erwartet in Br\u00fcssel ein neues \u201eMekka\": In dem historischen Geb\u00e4ude des ehemaligen Bahnhofs von Schaerbeek erwartet Sie das spektakul\u00e4re Eisenbahnmuseum Train World, dessen Szenographie aus der Feder des belgischen Comic-K\u00fcnstlers Fran\u00e7ois Schuiten stammt.\r\n\r\nSch\u00e4tze aus der Welt der Eisenbahn: Von der \u00e4ltesten Dampflokomotive Belgiens \u00fcber prunkvolle k\u00f6nigliche Wagons bis hin zu den modernen Hochgeschwindigkeitsz\u00fcgen - Train World f\u00fchrt die Besucher durch die belgische Eisenbahngeschichte. Neben historischem und technischem Wissen gibt es auch Anekdoten und Kuriosit\u00e4ten aus der Welt der Eisenbahn zu entdecken. Wie ist eine Schiene aufgebaut, wie schnell fuhren die ersten Dampfloks, wie reisten einst die K\u00f6nige? Antworten auf all diese Fragen geben die Erkl\u00e4rungstafeln, die auch auf Deutsch zur Verf\u00fcgung stehen, sowie die kostenlosen Audioguides (ebenfalls auf Deutsch).\r\n\r\nFahrsimulator: Sie haben schon immer davon getr\u00e4umt, Lokomotivf\u00fchrer zu werden? Dann nehmen Sie Platz im F\u00fchrerstand des Fahrsimulators und begeben sich auf eine Reise durch die Eisenbahngeschichte.\r\n\r\nLeibliches Wohl:\r\n\r\nIn der Brasserie \"RN Express\", die in dem historischen Bahnhofsgeb\u00e4ude untergebracht ist, gibt es Speisen und Getr\u00e4nke. Tiefblaue W\u00e4nde, gl\u00e4serne Kugellampen und Holzmobiliar sorgen f\u00fcr ein besonderes Ambiente.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World, o novo polo de atra\u00e7\u00e3o de Bruxelas\r\nTrain World, a montra dos caminhos de ferro de ontem, de hoje e de amanh\u00e3, \u00e9 a nova atra\u00e7\u00e3o tur\u00edstica de Bruxelas desde setembro de 2015. O local situa-se em Schaerbeek, a alguns minutos de comboio da Esta\u00e7\u00e3o Central (pr\u00f3ximo da Grand-Place).\r\nN\u00e3o est\u00e3o a\u00ed expostas apenas as pe\u00e7as mais belas da cole\u00e7\u00e3o de locomotivas e de ve\u00edculos hist\u00f3ricos dos caminhos de ferro belgas, mas tamb\u00e9m \u00e9 ilustrado o papel importante do comboio na mobilidade atual e do futuro. Train World \u00e9 mais do que um museu, trata-se de um centro de interpreta\u00e7\u00e3o. A cenografia original \u2013 desenvolvida pelo artista Fran\u00e7ois Schuiten- cria uma experi\u00eancia interativa durante a qual o p\u00fablico pode olhar, ouvir, tocar e deixar-se surpreender por hist\u00f3rias apaixonantes do mundo ferrovi\u00e1rio.\r\nO local, situado ao longo do tra\u00e7ado da primeira linha de caminhos de ferro do continente europeu (Bruxelas\u2013Mechelen, 1835), inclui a esta\u00e7\u00e3o renovada de Schaerbeek, onde se encontra a bilheteira, e uma constru\u00e7\u00e3o nova de 8000 m\u00b2. Note-se que a esta\u00e7\u00e3o, constru\u00edda em 1887, \u00e9 um dos baluartes da arquitetura ferrovi\u00e1ria belga e um monumento classificado. Um estabelecimento de hoteleira e restaura\u00e7\u00e3o situado na esta\u00e7\u00e3o completa a oferta de Train World.\r\nUma oferta muito diversificada destinada a todo o mundo\r\nTrain World aloja in\u00fameros tesouros a descobrir. Por exemplo, \u00e9 poss\u00edvel a\u00ed admirar a locomotiva a vapor mais antiga mantida na B\u00e9lgica, a \u201cPa\u00eds de Waes\u201d. Ou ainda a locomotiva a vapor de carenagem \u201ctipo 12\u201d, que estabeleceu um novo recorde de velocidade em 1939. Tamb\u00e9m \u00e9 poss\u00edvel contemplar aut\u00eanticos e sumptuosos ve\u00edculos reais ou penetrar um dos ve\u00edculos TEE inox, antecessor dos comboios de grande velocidade, que percorriam a Europa na \u00e9poca. Com vontade de assumir o comando de um comboio?\r\nPoder\u00e1 experiment\u00e1-lo, num simulador de condu\u00e7\u00e3o. No lugar do condutor, poder\u00e1 observar as mudan\u00e7as no ambiente das linhas ao longo dos anos.\r\nTrain World apresenta igualmente centenas de objetos do mundo ferrovi\u00e1rio, como uniformes, pinturas ou maquetas de comboios e de esta\u00e7\u00f5es, assim como in\u00fameras fotos e videoclipes. A notar igualmente: a apresenta\u00e7\u00e3o de uma aut\u00eantica casinha de guarda das passagens de n\u00edvel, retomada na nova constru\u00e7\u00e3o de Train World. Estar\u00e1 mobilada com uma decora\u00e7\u00e3o dos anos 50. No s\u00f3t\u00e3o, ser\u00e3o expostos comboios miniatura.\r\nAs escolas e as fam\u00edlias com crian\u00e7as pequenas poder\u00e3o aproveitar uma oferta espec\u00edfica que acentua tanto o aspeto educativo como o l\u00fadico. As crian\u00e7as poder\u00e3o dar espa\u00e7o \u00e0 sua alegria num espa\u00e7o de jogos, como m\u00ednimo, original, especialmente concebido para elas: uma locomotiva a vapor que emerge do solo.\r\nGra\u00e7as \u00e0 colabora\u00e7\u00e3o com os construtores de comboios, as tecnologias modernas e os desenvolvimentos futuros ser\u00e3o tamb\u00e9m abordados. Desse modo, o p\u00fablico poder\u00e1 admirar, por exemplo, tr\u00eas comboios de \u00faltima gera\u00e7\u00e3o.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World is a unique railway experience that takes you from the very first steam locomotives to the flashing high-speed trains! It is a universe that appeals to all the senses in order to grasp the many different dimensions of the railways. A visit to Train World is an active and surprising outing. You can walk among locomotives, take a seat in 100-year-old trains, visit a railway house and walk across a real railway bridge. You will even experience how it feels to drive a train!\r\n\r\n\r\n","description_print":"Train World, the showcase for the railways of yesterday, today and tomorrow, is a must-see tourist attraction in Brussels. The site is located a few minutes by train from Brussels Central station (near the Grand Place)\r\nHere you will be able to admire the loveliest pieces from the collection of historical locomotives and carriages from the Belgian railways, but it will also illustrate the significant role of the train in the mobility of today and in future. Train World is more than a museum: it will be an experience centre. An original scenography \u2013 designed by artist Fran\u00e7ois Schuiten \u2013 will provide an experience in which the audience can look, listen, touch and be surprised by scintillating stories from the world of trains.\r\nThe site comprises the renovated Schaerbeek station, where the ticket office is located, and a new 8,000 m\u00b2 building. A restaurant and a book & gift shop in the station completes the offering. It will also be possible to have a picnic: a restored carriage will be available in the transit area from the station to the new building for this purpose.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World. Il museo nazionale del treno aprir\u00e0 le porte alla stazione di Schaerbeek.\r\nTesori del mondo ferroviario\r\nTrain World custodir\u00e0 numerosi tesori: la pi\u00f9 antica locomotiva conservata in Belgio, la \u201cpaese di Waes\u201d, o la locomotive a vapore carenata \u201ctipo 12\u201d che aveva stabilito un record di velocit\u00e0 nel 1939.\r\n\r\nSimulatore di guida\r\n\r\nAvete sempre avuto voglia di guidare un treno ? Train World vi sistema in un simulatore di guida! Nel posto dell\u2019autista, potrete osservare i cambi dell\u2019ambiente lungo le linee ferroviarie nel corso degli anni.\r\n\r\nScuole e famiglie\r\n\r\nI vostri bambini potranno approfittare di un\u2019offerta specifica che mette l\u2019accanto sia sul aspetto educativo che divertente. Potranno approfittare di un spazio giochi originale.\r\n\r\nSala eventi\r\n\r\nTrain World entra in stazione e Bruxelles si dota di un nuovo luogo per eventi! Con 550 m\u00b2, la magnifica sala degli sportelli della stazione di Schaerbeek, risalendo al 1913, offrir\u00e0 un quadro unico per eventi. Sar\u00e0 dotata di un\u2019installazione audiovisuale moderna. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World est une exp\u00e9rience ferroviaire unique qui vous emm\u00e8ne des toutes premi\u00e8res locomotives \u00e0 vapeur aux trains \u00e0 grande vitesse flamboyants ! C'est un univers qui fait appel \u00e0 tous les sens pour appr\u00e9hender les multiples dimensions du chemin de fer. Une visite \u00e0 Train World est une sortie active et surprenante. Vous pouvez vous promener parmi les locomotives, prendre place dans des trains centenaires, visiter une maison de chemin de fer et traverser un v\u00e9ritable pont ferroviaire. Vous ferez m\u00eame l'exp\u00e9rience de la conduite d'un train !","description_print":"Vitrine du pass\u00e9, du pr\u00e9sent et du futur sur le monde ferroviaire, Train World est le nom du nouveau mus\u00e9e des chemins de fer, actuellement en construction pr\u00e8s de la gare de Schaerbeek. Il abritera les pi\u00e8ces les plus pr\u00e9cieuses du patrimoine historique.Train World rendra hommage \u00e0 la riche histoire du train, mais d\u00e9montrera aussi que les chemins de fer n'ont pas fini de jouer un r\u00f4le important dans le d\u00e9veloppement de notre pays.","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World, la nueva atracci\u00f3n tur\u00edstica de Bruselas.\r\n\r\nTrain World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\n\r\n","description_print":"Train World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\nTrain World will exceptionally be completely closed to the public from Monday 14 October to Monday 21 October 2019 and from Monday 16 March to Tuesday 17 March 2020 because of the assembly and dismantling of our exhibition dedicated to Paul Delvaux.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Prinses Elisabethplein","address_line2":"1030 Schaerbeek","description_web":"Train World is een unieke spoorervaring die je van de allereerste stoomlocomotieven tot de flitsende hogesnelheidstreinen brengt! Het is een universum dat een beroep doet op alle zintuigen om de vele verschillende dimensies van de spoorwegen te kunnen bevatten. Een bezoek aan Train World is een actieve en verrassende uitstap. Je wandelt tussen locomotieven, neemt plaats in treinen van 100 jaar oud, bezoekt een spoorweghuisje en loopt over een echte spoorwegbrug. Je ervaart zelfs hoe het voelt om een trein te besturen!","description_print":"Train World is sinds september 2015 het uitstalraam voor de spoorwegen van gisteren, vandaag en morgen in Brussel. De site bevindt zich in Schaarbeek, op nauwelijks 10 minuten met de trein vanuit Brussel-Centraal (bij de Grote Markt). \r\n\r\nDe mooiste stukken uit de collectie historische locomotieven en rijtuigen van de Belgische spoorwegen zijn er te bewonderen, maar daarnaast wordt er ook de belangrijke rol van de trein in de mobiliteit van vandaag en de toekomst ge\u00efllustreerd. Train World is meer dan een museum: het is een belevingscentrum. Een originele scenografie \u2013 ontworpen door kunstenaar Fran\u00e7ois Schuiten - zorgt voor een ervaring waarbij je kan kijken, luisteren, aanraken en verrast worden door de boeiende verhalen uit de wereld van de trein.\r\n\r\n22-10-2019> 15-03-2020 : Tentoonstelling: Paul Delvaux, de man die van treinen hield \r\n\r\nPaul Delvaux (1897-1994) schilderde een meesterlijk oeuvre bijeen, met als inspiratiebron de wereld van de spoorwegen. Zijn surrealistische werken gaan moeiteloos op in de adembenemende scenografie van Train World. Als vanzelf ontstaat een boeiende dialoog.\r\n\r\nDeze expo is h\u00e9t uitgelezen moment om de artistieke evolutie van deze spoorwegliefhebber te ontdekken in een magische setting: van tekeningen, aquarellen en schilderijen uit de jaren 1920 tot monumentale werken uit de jaren 1970, maar ook persoonlijke objecten van de artiest voegen verrassende accenten toe. Dat de schilder in 1984 tot erestationschef van Louvain-la-Neuve werd benoemd, is veelbetekenend.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":14733,"location":{"lat":50.87762766,"lon":4.37866751},"last_updated_at":"2023-08-14T16:25:03+02:00","published_at":"2013-10-19T01:54:59+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/2b0381e2ad2768b065b2acf6a26b15e955b64b97.jpg","width":2362,"height":1588,"ratio":1,"oEmbed_height":1588,"oEmbed_width":2362,"translations":{"de":{"title":"Grote Lokettenzaal Train World","copyright":"Train World"},"pt":{"title":"Grote Lokettenzaal Train World","copyright":"Train World"},"en":{"title":"Grote Lokettenzaal Train World","copyright":"Train World"},"it":{"title":"Grote Lokettenzaal Train World","copyright":"Train World"},"cn":{"title":"Grote Lokettenzaal Train World","copyright":"Train World"},"fr":{"title":"Grote Lokettenzaal Train World","copyright":"Train World"},"sp":{"title":"Grote Lokettenzaal Train World","copyright":"Train World"},"nl":{"title":"Grote Lokettenzaal Train World","copyright":"Train World"}}}],"dates":[{"day":"2023-09-16","doors":"10:00:00","start":"10:00:00","end":"15:30:00","is_soldout":false,"is_canceled":false},{"day":"2023-09-17","doors":"10:00:00","start":"10:00:00","end":"15:30:00","is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[255,263,265,261],"translations":{"de":["Barrierefrei","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC","Barrierefreier Parkplatz"],"pt":[null,null,null,null],"en":["Accessible","Accessible to pedestrians with mobility aids","Adapted toilet","Accessible parking"],"it":["Accessibile","Accessibile ai pedoni con supporti","WC idoneo","Parcheggio accessibile"],"cn":[null,null,null,null],"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Parking accessible"],"sp":["Habilitado","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados","Estacionamiento habilitado"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Toegankelijke parking"]}},"recurring":[],"targets":{"list":[10,11],"translations":{"de":["Senioren","Familie"],"pt":[null,null],"en":["Seniors","Family"],"it":["Anziani","Famiglie"],"cn":[null,null],"fr":["Seniors","Famille"],"sp":["Personas de la tercera edad","Familias"],"nl":["Senioren","Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["exterior","kids","annee_art_nouveau"]},{"id":50001695,"date_start":"2023-09-16","date_end":"2023-09-17","date_next":"2023-09-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T11:45:01+02:00","published_at":"2023-09-01T14:51:28+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284467,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[255],"translations":{"de":["Besuche von Ausstellungen"],"pt":[null],"en":["Exhibition guided tours"],"it":["Visite a esposizioni"],"cn":[null],"fr":["Visites d'expositions"],"sp":["Visitas a las exposiciones"],"nl":["Tentoonstelling"]}}},"translations":{"de":{"name":"Heritage Days Erasmushouse & Beguinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2023\/08\/1617-09-journees-du-patrimoine-heritage-days\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001695"},"pt":{"name":"Heritage Days Erasmushouse & Beguinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2023\/08\/1617-09-journees-du-patrimoine-heritage-days\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001695"},"en":{"name":"Heritage Days Erasmushouse & Beguinage","shortdescr":"At the Erasmus House and the beguinage\nGuided tours, Exhibition Make Haste Slowly, workshops (Latin)\nFree","longdescr":"PROGRAMMING > ERASMUS HOUSE\nRue de Formanoirstraat, 31, 1070 Anderlecht\n\n>> Guided tour Erasmus House and its philosophical garden\n+ Exhibition Make Haste Slowly \/ Duo Faste\n\nIn French: Saturday and Sunday at 10.30 a.m., 1.00 p.m., 1.30 p.m., and 3.30 p.m.\nIn Dutch: Saturday and Sunday at 10.30 a.m. and 1.30 p.m.\n\n>> Workshop Discovering Living Latin\n\nSaturday and Sunday at 2.30 and 4.30 p.m. (bilingual in French & Dutch)\n\nLength: 45 min.\n\nPROGRAMMING > BEGUINAGE\nRue du Chapelain 8, 1070 Anderlecht\n\n>> Guided tour\n\nIn French: Saturday at 11.30 a.m., 2.00 p.m., 2.30 p.m. and 4.30 p.m. and Sunday at 11.30 a.m., 2.00 p.m., and 2.30 p.m.\nIn Dutch: Saturday and Sunday at 11.30 a.m. and 2.30 p.m.\nLength: 30 min.\n\nThe Anderlecht beguinage is a remarkable heritage site in Brussels and in Belgium. It is in an exceptional state of preservation, which has revealed in recent years the presence of an old wooden panelled building dating from the beginning of the 15th century, enlarged in the 16th century, then finally preserved in part in the heart of new traditional-style buildings in brick and white stone, erected for the most part at the beginning of the 18th century. A guide invites you to discover its history.\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/en\/2023\/08\/1617-09-heritage-days\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001695"},"it":{"name":"Heritage Days Erasmushouse & Beguinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2023\/08\/1617-09-journees-du-patrimoine-heritage-days\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001695"},"cn":{"name":"Heritage Days Erasmushouse & Beguinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2023\/08\/1617-09-journees-du-patrimoine-heritage-days\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001695"},"fr":{"name":"Heritage Days Maison d\u2019\u00c9rasme & B\u00e9guinage","shortdescr":"A la Maison d\u2019\u00c9rasme et au b\u00e9guinage d\u2019Anderlecht\nVisites guid\u00e9es, exposition H\u00e2te-toi lentement \/ FAste (\u0153uvres c\u00e9ramiques), ateliers d\u00e9couverte du latin vivant (les Adages d\u2019\u00c9rasme), jeu \"carnet des familles\" pour les enfants","longdescr":"PROGRAMME MAISON D\u2019\u00c9RASME\n\n>> Visites guid\u00e9es La Maison d\u2019\u00c9rasme et son jardin philosophique\n+ Exposition H\u00e2te-toi lentement \/ FAste\n\nSamedi et dimanche \u00e0 10h30, 13h, 13h30 et 15h30\nDur\u00e9e : 45 min\n\nCette maison, o\u00f9 \u00c9rasme, l\u2019humaniste de Rotterdam, s\u00e9journa en 1521, est l\u2019une des plus anciennes de Bruxelles (1450-1515). Le mus\u00e9e h\u00e9berge une collection unique de mobilier Renaissance, de peintures (Bosch, Metsys, van der Weyden), de gravures (Holbein, D\u00fcrer) et une biblioth\u00e8que riche de milliers d\u2019\u00e9ditions anciennes. Le Jardin de plantes m\u00e9dicinales et le Jardin philosophique allient plaisirs et savoirs.\n\nLa visite int\u00e9grera aussi l\u2019exposition temporaire H\u00e2te-toi lentement (5 mai-29 octobre 2023) qui pr\u00e9sente les \u0153uvres c\u00e9ramiques cr\u00e9\u00e9es autour des Adages d\u2019\u00c9rasme par le duo d\u2019artistes FAste (Caroline Andrin et \u00c9tienne Fleury).\n\n>> Atelier D\u00e9couverte du latin vivant\nSamedi et dimanche \u00e0 14h30 et 16h30\n\nQu\u2019est-ce qu\u2019un adage? \u00c0 quand l\u2019expression remonte-t-elle?\nNous d\u00e9couvrirons le monument que constituent les Adages d\u2019\u00c9rasme, dans le cadre de l\u2019exposition temporaire FAste, H\u00e2te-toi lentement. Nous verrons que ces petites phrases riches de sens n\u2019ont rien perdu de leur actualit\u00e9, malgr\u00e9 les cinq si\u00e8cles qui nous s\u00e9parent du prince des humanistes.\nNous proposerons une petite initiation au latin par le biais d\u2019une dizaine de ces Adages, abordant l\u2019\u00e9tymologie de nombreux mots latins et quelques notions de grammaire de base. Pour les plus chevronn\u00e9s, nous lirons les passages latins qui leur correspondent, pour p\u00e9n\u00e9trer plus en profondeur le sens de ces courtes phrases.\n\nDur\u00e9e : 45 min\n\n>> Carnet des familles \"Explorez par vous-m\u00eames\"\n\nCe carnet vous accompagne, parents et enfants, pour une visite de la Maison d\u2019\u00c9rasme \u00ab cl\u00e9s en mains \u00bb. Il prend la forme d\u2019un carnet d\u2019observation qui m\u00e8nera vos enfants de pi\u00e8ce en pi\u00e8ce, jusqu\u2019au jardin. Vous y trouverez \u00e9galement toutes les r\u00e9ponses aux questions et \u00e9nigmes que vous pouvez partager ensemble.\n\nPROGRAMME B\u00c9GUINAGE\n\nRue du Chapelain, 8\n\nVisites guid\u00e9es\nSamedi et dimanche \u00e0 11h30, 14h, 14h30 et 16h30\nDur\u00e9e : 30 min\n\nLe b\u00e9guinage d\u2019Anderlecht est un site patrimonial remarquable \u00e0 Bruxelles et en Belgique. Il pr\u00e9sente un \u00e9tat de conservation exceptionnel, qui a r\u00e9v\u00e9l\u00e9 ces derni\u00e8res ann\u00e9es la pr\u00e9sence d\u2019un b\u00e2timent ancien en pan de bois dat\u00e9 du d\u00e9but du 15e si\u00e8cle, agrandi au 16e si\u00e8cle, puis finalement conserv\u00e9 pour partie au c\u0153ur de nouvelles constructions de style traditionnel en brique et pierre blanche \u00e9rig\u00e9es pour l\u2019essentiel au d\u00e9but du 18e si\u00e8cle. Un guide vous emm\u00e8ne \u00e0 la d\u00e9couverte de son histoire.","performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2023\/08\/1617-09-journees-du-patrimoine-heritage-days\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001695"},"sp":{"name":"Heritage Days Erasmushouse & Beguinage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2023\/08\/1617-09-journees-du-patrimoine-heritage-days\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001695"},"nl":{"name":"Heritage Days Erasmushuis & Begijnhof","shortdescr":"In het Erasmushuis en het begijnhof van Anderlecht\nRondleidingen, workshops Latijn, tentoonstelling Haast je langzaam \/ FAste, spel voor kinderen \"famile parcours\"","longdescr":"PROGRAMMA > ERASMUSHUIS\n\n>> Rondleiding Het Erasmushuis en haar filosofische tuin\n+ Tentoonstelling Haast je langzaam \/ FAste\n\nZaterdag en zondag om 10u30 en 13u30\nDuur: 45 min\n\nDit huis, waar de humanist van Rotterdam verbleef in 1521, is \u00e9\u00e9n van de oudste te Brussel (1460-1515). Het herbergt een unieke verzameling Renaissance meubilair, schilderijen (Bosch, Metsys, van der Weyden), gravures (Holbein, D\u00fcrer) en een bibliotheek rijk van duizenden oude drukken. De Tuin van geneeskrachtige planten en de Filosofische tuin zijn er om van te genieten en van te leren. Het bezoek omvat ook de tijdelijke tentoonstelling FAste \u2013 Haast je langzaam (5 mei-29 oktober 2023) die de keramische werken toont die het kunstenaarsduo FAste (Caroline Andrin en \u00c9tienne Fleury) rond de Adagia van Erasmus heeft gemaakt.\n\n>> Workshop Latijn\n\nFR\/NL Zaterdag en zondag om 14.30 uur en 16.30 uur\n\nWat is een adagium? Hoe oud is de uitdrukking? In deze twee workshops verkennen we het monument dat de Adagia van Erasmus zijn, als onderdeel van de tijdelijke tentoonstelling Haast je langzaam (FASte).\n\nDuur: 45 min.\n\n>> \"Ga zelf op ontdekkingstocht\", Doe-boekje voor de hele familie\n\nDit doe-boekje begeleidt jullie, ouders en kindjes, voor een bezoek aan het Erasmushuis volgens de \u2018sleutelklare\u2019 formule zodat jullie daarmee zelf van kamer tot kamer kunnen gaan tot in de tuin.\n\nPROGRAMMA > BEGIJNHOF\n\n>> Rondleidingen\n\nZaterdag en zondag om 11.30 uur en 14.30 uur\nDuur: 30 min\n\nHet begijnhof van Anderlecht is een schitterende erfgoedsite in Brussel en in Belgi\u00eb. De bewaringstoestand is uitzonderlijk en de afgelopen jaren kwam er een oud gebouw in vakwerk aan het licht dat uit het begin van de 15de eeuw dateert, in de 16de eeuw werd vergroot en uiteindelijk gedeeltelijk bewaard bleef in het hart van nieuwe traditionele constructies in baksteen en witte kalksteen uit het begin van de 18de eeuw. Een gids nodigt u uit om de geschiedenis ervan te ontdekken.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/nl\/2023\/08\/1617-09-open-monumentendagen-heritage-days\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001695"}},"place":{"id":8600,"translations":{"de":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nDas \u201eMaison d\u2019Erasme\u201c in der Br\u00fcsseler Gemeinde Anderlecht wurde Ende des 15. Jahrhunderts im Auftrag eines Stiftsherrn der nahegelegenen Stiftskirche St. Peter und St. Guido  im sp\u00e4tgotischen Stil errichtet.\r\n\r\nDas Haus beherbergte im Jahr 1521 den bedeutenden niederl\u00e4ndischen Gelehrten des Renaissance-Humanismus Erasmus von Rotterdam, der hier, fernab von den gro\u00dfen Machtzentren und den dort herrschenden Religionskriegen, die Ruhe und Abgeschiedenheit der Natur suchte.\r\n\r\nDas im Maison d\u2019Erasme untergebrachte Museum zeigt sowohl eine Gem\u00e4ldesammlung mit Werken von Holbein, Bosch und Metsys als auch eine reich mit alten B\u00fccherausgaben best\u00fcckte Bibliothek. Der umliegende Garten besteht aus einem \u201eJardin des Maladies\u201c \u2013 dem \u201eGarten der Krankheiten\u201c mit zahlreichen Heilpflanzen \u2013 und einem \u201eJardin philosophique\u201c \u2013 dem \u201ePhilosophischen Garten\u201c.","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Erasmus House & Beguinage Museums","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"The Erasmus House, beguinage, and collegiate church of Saints Peter and Guido form a magnificent historical ensemble, right in the heart of the commune. Erasmus House \u2013 in which the famous philosopher and scholar stayed from May to October 1521 \u2013 is one of the oldest Gothic houses in the Belgian capital. It hosts a sublime collection of paintings, prints and sculptures by 15th-17th century masters like Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys\u2026 not to mention portraits of Erasmus inspired by Hans Holbein and Quentin Metsys. A rich collection of 16th century books is a nod to the singular humanist\u2019s thinking.  \r\n\r\nA medicinal plant garden \u2013 designed by landscape architect Ren\u00e9 Pech\u00e8re \u2013 presents around one hundred medicinal plants that were known to 16th century physicians. Beyond it stretches a philosophical garden that is home to the works of contemporary artists like Marie-Jo Lafontaine and Bob Verschueren. \r\n\r\nThe beguinage of Anderlecht is Belgium\u2019s smallest. Founded in 1252, today it consists of two wings framing an enclosed garden with its own well. It housed beguines right up until the French Revolution and has been completely and lovingly restored, meaning it could, once again, be re-opened to the public! A new museum project is currently in the pipeline and should be finalised in autumn 2023. ","description_print":"21\/09\/2022\r\nFor several months, this house, which looks like a cloister, was home to the brilliant 16th-century humanist. Works of art, engravings, books, and archives bear witness to life in that era. End your visit in the philosophical and medicinal garden.","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nLa Casa di Erasmo deve il suo nome e la sua fama ad Erasmo da Rotterdam, che vi soggiorn\u00f2 nel 1521. Divenuta un museo dedicato al grande umanista rinascimentale, \u00e8 luogo di esposizione di una collezione unica composta da opere d'arte - sculture e dipinti di maestri fiamminghi -, mobili e libri antichi, molti dei quali scritti dallo stesso Erasmo. Se la Casa di Erasmo \u00e8 una delle pi\u00f9 antiche di Bruxelles - costruita in tre fasi nel corso dei secoli XV e XVI -, nel 1932 \u00e8 stata oggetto di un restauro completo voluto, nello spirito del pi\u00f9 puro storicismo, da Daniel Van Damme, fondatore del museo, con l'aiuto dell'architetto Charles Van Elst, che costru\u00ec anche la casa di Maurice Car\u00eame.  Gli spazi interni sono stati poi riconvertiti in sale del museo. Queste sono state decorate (una stanza con le pareti completamente rivestite di sontuose pelli di Cordoba) ed arredate con mobili provenienti dall'antica collezione del Ministro Vandenpeereboom. Gli interni sono quindi ricostruzioni con lo scopo di dare ai visitatori un'idea di quello che poteva essere una residenza rinascimentale. Le ricostruzioni sono in parte basate su documenti storici (lo studio di Erasmo che d\u00e0 sul giardino) ed in parte su ritrovamenti archeologici quali lo splendido fregio affrescato del primo piano. Nella parte posteriore della casa, un ampio giardino ombreggiato da grandi alberi conserva alcuni resti archeologici dell'antico castello di Anderlecht, poeticamente abbinati a diverse installazioni di artisti contemporanei. ","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Maison d\u2019\u00c9rasme et le b\u00e9guinage, voisins de la coll\u00e9giale des Saints-Pierre-et-Guidon, constituent un ensemble historique remarquable au c\u0153ur de la commune d\u2019Anderlecht.  \r\nLa Maison d\u2019\u00c9rasme est une des plus anciennes demeures de la r\u00e9gion de Bruxelles. \u00c9rasme y r\u00e9sida de mai \u00e0 octobre 1521. On y d\u00e9couvre des sculptures, peintures et gravures de ma\u00eetres des 15e au 17e si\u00e8cles : Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... ainsi que des portraits d\u2019\u00c9rasme, inspir\u00e9s de Hans Holbein et de Quentin Metsys. Une riche collection de livres du 16e si\u00e8cle refl\u00e8te la pens\u00e9e d'\u00c9rasme, le \u00ab Prince des humanistes \u00bb. \r\nUn Jardin de plantes m\u00e9dicinales, dessin\u00e9 par le paysagiste Ren\u00e9 Pech\u00e8re, pr\u00e9sente une centaine de plantes connues du 16e si\u00e8cle. Au-del\u00e0, s\u2019\u00e9tend un Jardin philosophique qui abrite des \u0153uvres d\u2019artistes contemporains dont Marie-Jo Lafontaine et Bob Verschueren. \r\n\r\nLe b\u00e9guinage d\u2019Anderlecht est le plus petit b\u00e9guinage de Belgique. Fond\u00e9 en 1252, il se compose de deux ailes encadrant un jardin clos. Il accueillait des b\u00e9guines jusqu\u2019\u00e0 la R\u00e9volution fran\u00e7aise. Le b\u00e9guinage a subi une restauration approfondie et est d\u00e9sormais ouvert aux visiteurs. Un nouveau projet mus\u00e9al sera finalis\u00e9 \u00e0 l\u2019automne 2023. ","description_print":"21\/09\/2022\r\n\u00c9rasme a s\u00e9journ\u00e9 en 1521 dans cette maison gothique (1450-1515) qui rassemble \u00e0\r\nla fois une collection de peintures, gravures et scuptures (Albrecht Du\u0308rer, Joos Van\r\nCleve, Pieter Huys, Cornelis Metsys, Frans Francken le Jeune \u2026), une biblioth\u00e8que\r\nsp\u00e9cialis\u00e9e dans les \u00e9ditions princeps, c\u2019est-\u00e0-dire les premi\u00e8res \u00e9ditions d\u2019une \u0153uvre\r\nchez diff\u00e9rents imprimeurs, un Jardin philosophique et un Jardin de plantes\r\nm\u00e9dicinales. Le mus\u00e9e publie des livres et organise des conf\u00e9rences, des concerts,\r\ndes expositions d\u2019art contemporain et historiques, des activit\u00e9s p\u00e9dagogiques, des\r\nvisites guid\u00e9es pour groupes.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nLa Casa de Erasmo debe su nombre y prestigio a la temporada que pas\u00f3 en ella Erasmo de R\u00f3terdam en 1521. Convertida en un museo dedicado a este gran humanista del Renacimiento, es el envoltorio de una colecci\u00f3n \u00fanica compuesta por obras de arte (esculturas y pinturas de maestros flamencos), muebles y libros antiguos, entre ellos numerosas ediciones erasmianas. Si la Casa de Erasmo es una de las m\u00e1s antiguas de Bruselas (construida en tres fases a lo largo de los siglos XV y XVI), a partir de 1932 fue objeto de una restauraci\u00f3n completa llevada a cabo, en el m\u00e1s puro historicismo, por Daniel Van Damme, fundador del museo, con la ayuda del arquitecto Charles Van Elst, que tambi\u00e9n construy\u00f3 la casa de Maurice Car\u00eame. Los espacios interiores se reorganizaron entonces en salas de museo que fueron decoradas (entre ellas, una sala con las paredes totalmente cubiertas por suntuosas pieles de C\u00f3rdoba) y amuebladas con mobiliario procedente de la antigua colecci\u00f3n del ministro Vandenpeereboom. El interior es, por tanto, una reproducci\u00f3n cuyo fin es dar a los visitantes la idea de lo que podr\u00eda haber sido una residencia en el Renacimiento, basada en parte en documentos hist\u00f3ricos (despacho de Erasmo frente al jard\u00edn) y en hallazgos arqueol\u00f3gicos como el maravilloso friso pintado al fresco del primer piso. Detr\u00e1s de la casa, un vasto jard\u00edn con grandes \u00e1rboles que le dan sombra conserva algunos restos arqueol\u00f3gicos del antiguo castillo de Anderlecht, los cuales se encuentran, po\u00e9ticamente, cerca de varias instalaciones de artistas contempor\u00e1neos. ","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Erasmushuis & Begijnhofmusea","address_street_name":"Formanoirstraat","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Formanoirstraat, 31","address_line2":"1070 Anderlecht","description_web":"Het Erasmushuis, het begijnhof en de collegiale Sint-Pieter-en Sint-Guidokerk vormen een uitzonderlijk historisch geheel in het centrum van de gemeente Anderlecht. Het Erasmushuis is een van de oudste huizen in Brussel waar Erasmus verbleef van mei tot oktober 1521. In de verschillende vertrekken kun je schilderijen en prenten van de meesters uit de 15de tot de 17de eeuw ontdekken, zoals Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... alsook portretten van Erasmus naar het voorbeeld van Hans Holbein en Quentin Metsys. Een rijke collectie boeken uit de 16de eeuw vertegenwoordigt het gedachtegoed van deze bijzondere humanist.  \r\n\r\nAchter het huis bevindt zich een tuin met geneeskrachtige planten ontworpen door landschapsarchitect Ren\u00e9 Pech\u00e8re. Hier worden zo\u2019n honderd geneeskrachtige planten gekweekt die bekend waren bij de geneesheren uit de 16de eeuw. Daarachter bevindt zich een filosofische tuin met werken van hedendaagse kunstenaars, zoals Marie-Jo Lafontaine en Bob Verschueren.  \r\n\r\nHet begijnhof van Anderlecht is het kleinste van Belgi\u00eb. Het werd gesticht in 1252 en bestaat tegenwoordig uit twee vleugels rondom een ommuurde tuin met waterput. Hier vonden begijnen onderdak tot aan de Franse Revolutie. Na een grondige restauratie staat het begijnhof voortaan weer open voor bezoekers! Momenteel wordt een nieuw museumproject uitgewerkt dat tegen de herfst 2023 voltooid zou moeten zijn. \r\n","description_print":"21\/09\/2022\r\nIn 1521 verbleef Erasmus in dit gotische huis (1450-1515) waar zich niet alleen een collectie bevindt van schilderijen, prenten en beeldhouwwerken (Albrecht Du\u0308rer, Joos\r\nVan Cleve, Pieter Huys, Cornelis Metsys, Frans Francken de Jongere\u2026), maar ook een\r\nbibliotheek gespecialiseerd in \u2018editiones principes\u2019, dat wil zeggen de eerste uitgaven\r\nvan een werk bij verschillende drukkers. Verder bevindt zich buiten nog een Filosofische\r\ntuin en een tuin met Geneeskrachtige planten.\r\nDaarnaast publiceert het museum boeken en organiseert voordrachten, concerten,\r\ntentoonstellingen met een historisch thema en tentoonstellingen Hedendaagse kunst,\r\npedagogische activiteiten en rondleidingen voor groepen.","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":327,"location":{"lat":50.83592263,"lon":4.3077579},"region":"brussels","last_updated_at":"2022-11-03T16:17:09+01:00","published_at":"2013-10-19T01:13:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":8600,"translations":{"de":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nDas \u201eMaison d\u2019Erasme\u201c in der Br\u00fcsseler Gemeinde Anderlecht wurde Ende des 15. Jahrhunderts im Auftrag eines Stiftsherrn der nahegelegenen Stiftskirche St. Peter und St. Guido  im sp\u00e4tgotischen Stil errichtet.\r\n\r\nDas Haus beherbergte im Jahr 1521 den bedeutenden niederl\u00e4ndischen Gelehrten des Renaissance-Humanismus Erasmus von Rotterdam, der hier, fernab von den gro\u00dfen Machtzentren und den dort herrschenden Religionskriegen, die Ruhe und Abgeschiedenheit der Natur suchte.\r\n\r\nDas im Maison d\u2019Erasme untergebrachte Museum zeigt sowohl eine Gem\u00e4ldesammlung mit Werken von Holbein, Bosch und Metsys als auch eine reich mit alten B\u00fccherausgaben best\u00fcckte Bibliothek. Der umliegende Garten besteht aus einem \u201eJardin des Maladies\u201c \u2013 dem \u201eGarten der Krankheiten\u201c mit zahlreichen Heilpflanzen \u2013 und einem \u201eJardin philosophique\u201c \u2013 dem \u201ePhilosophischen Garten\u201c.","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Erasmus House & Beguinage Museums","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"The Erasmus House, beguinage, and collegiate church of Saints Peter and Guido form a magnificent historical ensemble, right in the heart of the commune. Erasmus House \u2013 in which the famous philosopher and scholar stayed from May to October 1521 \u2013 is one of the oldest Gothic houses in the Belgian capital. It hosts a sublime collection of paintings, prints and sculptures by 15th-17th century masters like Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys\u2026 not to mention portraits of Erasmus inspired by Hans Holbein and Quentin Metsys. A rich collection of 16th century books is a nod to the singular humanist\u2019s thinking.  \r\n\r\nA medicinal plant garden \u2013 designed by landscape architect Ren\u00e9 Pech\u00e8re \u2013 presents around one hundred medicinal plants that were known to 16th century physicians. Beyond it stretches a philosophical garden that is home to the works of contemporary artists like Marie-Jo Lafontaine and Bob Verschueren. \r\n\r\nThe beguinage of Anderlecht is Belgium\u2019s smallest. Founded in 1252, today it consists of two wings framing an enclosed garden with its own well. It housed beguines right up until the French Revolution and has been completely and lovingly restored, meaning it could, once again, be re-opened to the public! A new museum project is currently in the pipeline and should be finalised in autumn 2023. ","description_print":"21\/09\/2022\r\nFor several months, this house, which looks like a cloister, was home to the brilliant 16th-century humanist. Works of art, engravings, books, and archives bear witness to life in that era. End your visit in the philosophical and medicinal garden.","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nLa Casa di Erasmo deve il suo nome e la sua fama ad Erasmo da Rotterdam, che vi soggiorn\u00f2 nel 1521. Divenuta un museo dedicato al grande umanista rinascimentale, \u00e8 luogo di esposizione di una collezione unica composta da opere d'arte - sculture e dipinti di maestri fiamminghi -, mobili e libri antichi, molti dei quali scritti dallo stesso Erasmo. Se la Casa di Erasmo \u00e8 una delle pi\u00f9 antiche di Bruxelles - costruita in tre fasi nel corso dei secoli XV e XVI -, nel 1932 \u00e8 stata oggetto di un restauro completo voluto, nello spirito del pi\u00f9 puro storicismo, da Daniel Van Damme, fondatore del museo, con l'aiuto dell'architetto Charles Van Elst, che costru\u00ec anche la casa di Maurice Car\u00eame.  Gli spazi interni sono stati poi riconvertiti in sale del museo. Queste sono state decorate (una stanza con le pareti completamente rivestite di sontuose pelli di Cordoba) ed arredate con mobili provenienti dall'antica collezione del Ministro Vandenpeereboom. Gli interni sono quindi ricostruzioni con lo scopo di dare ai visitatori un'idea di quello che poteva essere una residenza rinascimentale. Le ricostruzioni sono in parte basate su documenti storici (lo studio di Erasmo che d\u00e0 sul giardino) ed in parte su ritrovamenti archeologici quali lo splendido fregio affrescato del primo piano. Nella parte posteriore della casa, un ampio giardino ombreggiato da grandi alberi conserva alcuni resti archeologici dell'antico castello di Anderlecht, poeticamente abbinati a diverse installazioni di artisti contemporanei. ","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Maison d\u2019\u00c9rasme et le b\u00e9guinage, voisins de la coll\u00e9giale des Saints-Pierre-et-Guidon, constituent un ensemble historique remarquable au c\u0153ur de la commune d\u2019Anderlecht.  \r\nLa Maison d\u2019\u00c9rasme est une des plus anciennes demeures de la r\u00e9gion de Bruxelles. \u00c9rasme y r\u00e9sida de mai \u00e0 octobre 1521. On y d\u00e9couvre des sculptures, peintures et gravures de ma\u00eetres des 15e au 17e si\u00e8cles : Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... ainsi que des portraits d\u2019\u00c9rasme, inspir\u00e9s de Hans Holbein et de Quentin Metsys. Une riche collection de livres du 16e si\u00e8cle refl\u00e8te la pens\u00e9e d'\u00c9rasme, le \u00ab Prince des humanistes \u00bb. \r\nUn Jardin de plantes m\u00e9dicinales, dessin\u00e9 par le paysagiste Ren\u00e9 Pech\u00e8re, pr\u00e9sente une centaine de plantes connues du 16e si\u00e8cle. Au-del\u00e0, s\u2019\u00e9tend un Jardin philosophique qui abrite des \u0153uvres d\u2019artistes contemporains dont Marie-Jo Lafontaine et Bob Verschueren. \r\n\r\nLe b\u00e9guinage d\u2019Anderlecht est le plus petit b\u00e9guinage de Belgique. Fond\u00e9 en 1252, il se compose de deux ailes encadrant un jardin clos. Il accueillait des b\u00e9guines jusqu\u2019\u00e0 la R\u00e9volution fran\u00e7aise. Le b\u00e9guinage a subi une restauration approfondie et est d\u00e9sormais ouvert aux visiteurs. Un nouveau projet mus\u00e9al sera finalis\u00e9 \u00e0 l\u2019automne 2023. ","description_print":"21\/09\/2022\r\n\u00c9rasme a s\u00e9journ\u00e9 en 1521 dans cette maison gothique (1450-1515) qui rassemble \u00e0\r\nla fois une collection de peintures, gravures et scuptures (Albrecht Du\u0308rer, Joos Van\r\nCleve, Pieter Huys, Cornelis Metsys, Frans Francken le Jeune \u2026), une biblioth\u00e8que\r\nsp\u00e9cialis\u00e9e dans les \u00e9ditions princeps, c\u2019est-\u00e0-dire les premi\u00e8res \u00e9ditions d\u2019une \u0153uvre\r\nchez diff\u00e9rents imprimeurs, un Jardin philosophique et un Jardin de plantes\r\nm\u00e9dicinales. Le mus\u00e9e publie des livres et organise des conf\u00e9rences, des concerts,\r\ndes expositions d\u2019art contemporain et historiques, des activit\u00e9s p\u00e9dagogiques, des\r\nvisites guid\u00e9es pour groupes.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":null,"description_print":"21\/09\/2022\r\nLa Casa de Erasmo debe su nombre y prestigio a la temporada que pas\u00f3 en ella Erasmo de R\u00f3terdam en 1521. Convertida en un museo dedicado a este gran humanista del Renacimiento, es el envoltorio de una colecci\u00f3n \u00fanica compuesta por obras de arte (esculturas y pinturas de maestros flamencos), muebles y libros antiguos, entre ellos numerosas ediciones erasmianas. Si la Casa de Erasmo es una de las m\u00e1s antiguas de Bruselas (construida en tres fases a lo largo de los siglos XV y XVI), a partir de 1932 fue objeto de una restauraci\u00f3n completa llevada a cabo, en el m\u00e1s puro historicismo, por Daniel Van Damme, fundador del museo, con la ayuda del arquitecto Charles Van Elst, que tambi\u00e9n construy\u00f3 la casa de Maurice Car\u00eame. Los espacios interiores se reorganizaron entonces en salas de museo que fueron decoradas (entre ellas, una sala con las paredes totalmente cubiertas por suntuosas pieles de C\u00f3rdoba) y amuebladas con mobiliario procedente de la antigua colecci\u00f3n del ministro Vandenpeereboom. El interior es, por tanto, una reproducci\u00f3n cuyo fin es dar a los visitantes la idea de lo que podr\u00eda haber sido una residencia en el Renacimiento, basada en parte en documentos hist\u00f3ricos (despacho de Erasmo frente al jard\u00edn) y en hallazgos arqueol\u00f3gicos como el maravilloso friso pintado al fresco del primer piso. Detr\u00e1s de la casa, un vasto jard\u00edn con grandes \u00e1rboles que le dan sombra conserva algunos restos arqueol\u00f3gicos del antiguo castillo de Anderlecht, los cuales se encuentran, po\u00e9ticamente, cerca de varias instalaciones de artistas contempor\u00e1neos. ","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Erasmushuis & Begijnhofmusea","address_street_name":"Formanoirstraat","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Formanoirstraat, 31","address_line2":"1070 Anderlecht","description_web":"Het Erasmushuis, het begijnhof en de collegiale Sint-Pieter-en Sint-Guidokerk vormen een uitzonderlijk historisch geheel in het centrum van de gemeente Anderlecht. Het Erasmushuis is een van de oudste huizen in Brussel waar Erasmus verbleef van mei tot oktober 1521. In de verschillende vertrekken kun je schilderijen en prenten van de meesters uit de 15de tot de 17de eeuw ontdekken, zoals Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... alsook portretten van Erasmus naar het voorbeeld van Hans Holbein en Quentin Metsys. Een rijke collectie boeken uit de 16de eeuw vertegenwoordigt het gedachtegoed van deze bijzondere humanist.  \r\n\r\nAchter het huis bevindt zich een tuin met geneeskrachtige planten ontworpen door landschapsarchitect Ren\u00e9 Pech\u00e8re. Hier worden zo\u2019n honderd geneeskrachtige planten gekweekt die bekend waren bij de geneesheren uit de 16de eeuw. Daarachter bevindt zich een filosofische tuin met werken van hedendaagse kunstenaars, zoals Marie-Jo Lafontaine en Bob Verschueren.  \r\n\r\nHet begijnhof van Anderlecht is het kleinste van Belgi\u00eb. Het werd gesticht in 1252 en bestaat tegenwoordig uit twee vleugels rondom een ommuurde tuin met waterput. Hier vonden begijnen onderdak tot aan de Franse Revolutie. Na een grondige restauratie staat het begijnhof voortaan weer open voor bezoekers! Momenteel wordt een nieuw museumproject uitgewerkt dat tegen de herfst 2023 voltooid zou moeten zijn. \r\n","description_print":"21\/09\/2022\r\nIn 1521 verbleef Erasmus in dit gotische huis (1450-1515) waar zich niet alleen een collectie bevindt van schilderijen, prenten en beeldhouwwerken (Albrecht Du\u0308rer, Joos\r\nVan Cleve, Pieter Huys, Cornelis Metsys, Frans Francken de Jongere\u2026), maar ook een\r\nbibliotheek gespecialiseerd in \u2018editiones principes\u2019, dat wil zeggen de eerste uitgaven\r\nvan een werk bij verschillende drukkers. Verder bevindt zich buiten nog een Filosofische\r\ntuin en een tuin met Geneeskrachtige planten.\r\nDaarnaast publiceert het museum boeken en organiseert voordrachten, concerten,\r\ntentoonstellingen met een historisch thema en tentoonstellingen Hedendaagse kunst,\r\npedagogische activiteiten en rondleidingen voor groepen.","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":327,"location":{"lat":50.83592263,"lon":4.3077579},"last_updated_at":"2022-11-03T16:17:09+01:00","published_at":"2013-10-19T01:13:26+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/a43823c63f3d37cce26c09bc4d81fe5a52f1dc3b.jpg","width":1200,"height":1200,"ratio":1,"oEmbed_height":1200,"oEmbed_width":1200,"translations":{"de":{"title":"Heritage Days ","copyright":"Heritage Days "},"pt":{"title":"Heritage Days ","copyright":"Heritage Days "},"en":{"title":"Heritage Days ","copyright":"Heritage Days "},"it":{"title":"Heritage Days ","copyright":"Heritage Days "},"cn":{"title":"Heritage Days ","copyright":"Heritage Days "},"fr":{"title":"Heritage Days ","copyright":"Heritage Days "},"sp":{"title":"Heritage Days ","copyright":"Heritage Days "},"nl":{"title":"Heritage Days ","copyright":"Heritage Days "}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/5e372574b72dc4b8337f3fff1b2ac250633fccfc.jpg","width":1575,"height":1575,"ratio":1,"oEmbed_height":1575,"oEmbed_width":1575,"translations":{"de":{"title":"Faire le Poulpe, FAste, H\u00e2te-toi lentement","copyright":"\u00a9Ivan Citelli"},"pt":{"title":"Faire le Poulpe, FAste, H\u00e2te-toi lentement","copyright":"\u00a9Ivan Citelli"},"en":{"title":"Faire le Poulpe, FAste, H\u00e2te-toi lentement","copyright":"\u00a9Ivan Citelli"},"it":{"title":"Faire le Poulpe, FAste, H\u00e2te-toi lentement","copyright":"\u00a9Ivan Citelli"},"cn":{"title":"Faire le Poulpe, FAste, H\u00e2te-toi lentement","copyright":"\u00a9Ivan Citelli"},"fr":{"title":"Faire le Poulpe, FAste, H\u00e2te-toi lentement","copyright":"\u00a9Ivan Citelli"},"sp":{"title":"Faire le Poulpe, FAste, H\u00e2te-toi lentement","copyright":"\u00a9Ivan Citelli"},"nl":{"title":"Faire le Poulpe, FAste, H\u00e2te-toi lentement","copyright":"\u00a9Ivan Citelli"}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/b75eda0793addc288196507bb9434cba2f0ebd4d.jpg","width":2362,"height":1575,"ratio":1,"oEmbed_height":1575,"oEmbed_width":2362,"translations":{"de":{"title":"Maison d'Erasme","copyright":"\u00a9Jonathan Sommereyns"},"pt":{"title":"Maison d'Erasme","copyright":"\u00a9Jonathan Sommereyns"},"en":{"title":"Maison d'Erasme","copyright":"\u00a9Jonathan Sommereyns"},"it":{"title":"Maison d'Erasme","copyright":"\u00a9Jonathan Sommereyns"},"cn":{"title":"Maison d'Erasme","copyright":"\u00a9Jonathan Sommereyns"},"fr":{"title":"Maison d'Erasme","copyright":"\u00a9Jonathan Sommereyns"},"sp":{"title":"Maison d'Erasme","copyright":"\u00a9Jonathan Sommereyns"},"nl":{"title":"Maison d'Erasme","copyright":"\u00a9Jonathan Sommereyns"}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/867d92d59a4705dfe5b1af9aa102b79e662d5e63.jpg","width":788,"height":1181,"ratio":0,"oEmbed_height":1181,"oEmbed_width":788,"translations":{"de":{"title":"Le cycle de l'Apocalypse_ La grande Prostitu\u00e9e et la B\u00eate de l'Apocalypse, FAste","copyright":"\u00a9Ivan Citelli"},"pt":{"title":"Le cycle de l'Apocalypse_ La grande Prostitu\u00e9e et la B\u00eate de l'Apocalypse, FAste","copyright":"\u00a9Ivan Citelli"},"en":{"title":"Le cycle de l'Apocalypse_ La grande Prostitu\u00e9e et la B\u00eate de l'Apocalypse, FAste","copyright":"\u00a9Ivan Citelli"},"it":{"title":"Le cycle de l'Apocalypse_ La grande Prostitu\u00e9e et la B\u00eate de l'Apocalypse, FAste","copyright":"\u00a9Ivan Citelli"},"cn":{"title":"Le cycle de l'Apocalypse_ La grande Prostitu\u00e9e et la B\u00eate de l'Apocalypse, FAste","copyright":"\u00a9Ivan Citelli"},"fr":{"title":"Le cycle de l'Apocalypse_ La grande Prostitu\u00e9e et la B\u00eate de l'Apocalypse, FAste","copyright":"\u00a9Ivan Citelli"},"sp":{"title":"Le cycle de l'Apocalypse_ La grande Prostitu\u00e9e et la B\u00eate de l'Apocalypse, FAste","copyright":"\u00a9Ivan Citelli"},"nl":{"title":"Le cycle de l'Apocaly