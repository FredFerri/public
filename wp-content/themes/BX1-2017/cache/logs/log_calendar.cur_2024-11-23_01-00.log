50012122],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"visit_content":{"list":[360],"values":["cafe-theatre"]}},{"id":50011773,"date_start":"2024-11-26","date_end":"2024-12-31","date_next":"2024-11-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-27T20:22:53+02:00","published_at":"2024-06-21T09:05:19+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":302665,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5503212081491045,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Le Dieu du carnage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011773"},"pt":{"name":"Le Dieu du carnage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011773"},"en":{"name":"Le Dieu du carnage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011773"},"it":{"name":"Le Dieu du carnage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011773"},"cn":{"name":"Le Dieu du carnage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011773"},"fr":{"name":"Le Dieu du carnage","shortdescr":null,"longdescr":"Au square, Ferdinand attaque Bruno \u00e0 coups de b\u00e2ton qui laisse quelques dents sur le b\u00e9ton !\nUrbains, cordiaux, les parents se donnent rendez-vous pour r\u00e9gler le litige \u00e0 l\u2019amiable, entre personnes civilis\u00e9es ! Mais tr\u00e8s vite les sourires se craqu\u00e8lent et l\u2019atmosph\u00e8re s\u2019envenime.\nRencontre au sommet entre parents \u00e9nerv\u00e9s, qui p\u00e8tent un plomb d\u00e8s qu\u2019on touche \u00e0 leur prog\u00e9niture, leurs habitudes, leurs petites certitudes ou leurs r\u00e9putations. La tension va progressivement venir \u00e0 bout de toutes les bonnes intentions et les digues vont l\u00e2cher. C\u2019est la d\u00e9bandade, le chacun pour soi, le conflit ouvert, la guerre de tranch\u00e9es.\n\nUne dent cass\u00e9e, et Reza d\u00e9roule le fil de nos paradoxes : la politesse de fa\u00e7ade et la brutalit\u00e9 rentr\u00e9e, tout le d\u00e9risoire des grandes d\u00e9clarations altruistes qui s\u2019effondrent \u00e0 la moindre anicroche. Et surtout, sous le vernis, la rage. On se croirait sur les r\u00e9seaux sociaux.\n\n\u00c0 partir d\u2019un tout petit fait tir\u00e9 du quotidien, Yasmina Reza jubile et trace \u00e0 la ligne claire et au vitriol, le portrait de bobos satisfaits et s\u00fbrs de leurs droits. Le tableau qu\u2019elle nous peint n\u2019est pas joli, joli, c\u2019est un carnage. Mais c\u2019est \u00e0 mourir de rire.\n\nReprise d\u2019un immense succ\u00e8s de l\u2019ann\u00e9e derni\u00e8re, cette pi\u00e8ce maitresse du rire f\u00e9roce, offrira des soir\u00e9es de rire en d\u00e9cembre, juste bien pour les f\u00eates.\n__________\n\nDe Yasmina Reza \/ Mise en sc\u00e8ne : Arthur Jugnot \/ Avec : Nicolas Buysse, Thibaut N\u00e8ve, Ariane Rousseau et St\u00e9phanie Van Vyve \/ Assistante \u00e0 la mise en sc\u00e8ne : Barbara Borguet \/ Sc\u00e9nographie : Sophie Hazebrouck \/ Costumes : Chandra Vellut \/ Lumi\u00e8re : Laurent Kaye \/ Avec, pour cette reprise, l\u2019\u0153il ext\u00e9rieur d\u2019Isabelle Paternotte, assist\u00e9e par Diane Delangre\n__________\n\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC L\u2019AIDE DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES \u2013 DIRECTION DU TH\u00c9\u00c2TRE, ET LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011773"},"sp":{"name":"Le Dieu du carnage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011773"},"nl":{"name":"Le Dieu du carnage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"co