"is_canceled":false},{"day":"2022-07-03","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-08-28","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-18T17:05:13+02:00","published_at":"2022-03-03T11:57:25+01:00","backoffice_id":248907,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":535887,"date_start":"2022-08-30","date_end":"2022-09-01","date_next":"2022-08-30","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Venise sous la neige","shortdescr":"Un d\u00eener qui vole en \u00e9clats!\r\n\u00abVenise sous la neige\u00bb est une com\u00e9die dynamique et savoureuse tournant autour d\u2019un \u00e9norme malentendu. On se prend tr\u00e8s vite au jeu en observant ces 2 couples si diff\u00e9rents, dont l\u2019un d\u2019eux pourrait sortir tout droit du fameux \u00abD\u00eener de cons\u00bb.","longdescr":"Entra\u00een\u00e9e par son compagnon avec lequel elle vient de se disputer, Patricia arrive furieuse \u00e0 un d\u00eener \u00ab entre amis \u00bb o\u00f9 elle ne conna\u00eet personne. Comme elle ne dit pas un mot, on la prend pour une \u00e9trang\u00e8re. Elle entretient alors le quiproquo et fait voler la soir\u00e9e en \u00e9clats...\r\n\r\nEntre d\u00e9chirures amoureuses et d\u00e9clarations de mariage, les r\u00f4les vont s\u2019inverser et la soir\u00e9e va accumuler les catastrophes hilarantes pour notre plus grand plaisir.","performers":"Mise en sc\u00e8ne: Victor Scheffer \u25aa Avec: Laure Godisiabois, Fr\u00e9d\u00e9ric Nyssen, Marc Weiss, Christel Pedrinelli","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=FR","website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":null,"phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535887"},"nl":{"name":"Venise sous la neige","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=NL","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535887"},"en":{"name":"Venise sous la neige","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=EN","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535887"},"de":{"name":"Venise sous la neige","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535887"},"it":{"name":"Venise sous la neige","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535887"},"sp":{"name":"Venise sous la neige","shortdescr":null,"longdescr":n