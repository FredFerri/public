lication_state":"public","last_updated_at":"2022-10-11T06:36:38+02:00","published_at":"2022-09-16T15:50:12+02:00","backoffice_id":262083,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":543896,"date_start":"2022-10-15","date_end":"2022-10-15","date_next":"2022-10-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[3],"translations":{"fr":["Musique Contemporaine"],"nl":["Hedendaagse Muziek"],"en":["Contemporary music"],"de":["Zeitgen\u00f6ssische Musik"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"KAZE TO ARASHI : Cin\u00e9 Concert \/ Musique Contemporaine","shortdescr":"Qui a dit que la musique contemporaine \u00e9tait \u00e9litiste, inaudible ou m\u00eame rigide ?","longdescr":"David Achenberg manie la plume du compositeur, l'archet du violoniste et la baguette du chef d'orchestre. Cet artiste belge, volontiers iconoclaste, dissout ces clich\u00e9s gr\u00e2ce \u00e0 une sensibilit\u00e9 au dialogue, entre classicisme et extr\u00eame modernit\u00e9.\r\n\r\nAuteur d'une trentaine d'opus, dont certains lui valent une reconnaissance internationale (Tribune Internationale des Compositeurs), son oeuvre est aussi dense qu'expressive.\r\n\r\nEn s'associant au cin\u00e9aste Rambalac et \u00e0 l'ensemble belge Fractales, David Achenberg nous invite au voyage.\r\n\r\nAu cours d'un cin\u00e9-concert de pr\u00e8s d'une heure, c'est une d\u00e9ambulation romanesque et musicale au pays du soleil levant qui s'offre \u00e0 nous : Kaze to Arashi, ou comment se perdre dans Edo, le vieux quartier de Tokyo...\r\nUne premi\u00e8re mondiale en co-production avec le Jardin Musical.","performers":"Ensemble Fractales, David Achenberg, Rambalac","boxoffice_url":null,"website":"https:\/\/www.jardinmusical.org\/agenda-billetterie","email":"info@jardinmusical.org","phone_contact":"+32 456 04 35 05","phone_booking":"+32 456 04 35 05","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543896"},"nl":{"name":"KAZE TO ARASHI : Cin\u00e9 Concert \/ Musique Contemporaine","shortdescr":"Wie zei dat hedendaagse muziek elitair, onhoorbaar of zelfs rigide was?","longdescr":"David Achenberg hanteert de pen van de componist, de strijkstok van de violist en het stokje van de dirigent. Deze Belgische kunstenaar, graag iconoclastisch, lost bovengenoemde clich\u00e9s op dankzij zijn gevoeligheid voor samenspraak, tussen classicisme en extreme moderniteit.\r\nAls auteur van een dertigtal werken, waarvan sommige hem internationale erkenning hebben opgeleverd (Tribune Internationale des Compositeurs), is zijn werk even compact als expressief.\r\n\r\nIn een samenwerking tussen filmmaker Rambalac en het Belgische ensemble Fractales, nodigt David Achenberg ons uit op een reis.\r\nTijdens een film-concert van bijna een uur wordt ons een romantische en muzikale omzwerving in het land van de rijzende zon aangeboden: Kaze tot Arashi, , of het verhaal van hoe je in Edo, de oude wijk van Tokyo, kan verdwalen...\r\nEen wereldprimeur in coproductie met de Jardin Musical.","performers":"Ensemble Fractales, David Achenberg, Rambalac","boxoffice_url":null,"website":null,"email":"info@jardinmusical.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543896"},"en":{"name":"KAZE TO ARASHI : Cin\u00e9 Concert \/ Musique Contemporaine","shortdescr":"Who said that contemporary music was elitist, inaudible or even rigid?","longdescr":"David Achenberg wields the composer's pen, the violinist's bow and the conductor's baton. This Belgian artist, willingly iconoclastic, dissolves these clich\u00e9s thanks to a sensitivity to dialogue, between classicism and extreme modernity.\r\n\r\nAuthor of more than thirty opuses, some of which have earned him international recognition (International Tribune of Composers), his work is as dense as it is expressive.\r\n\r\nIn association with the filmmaker Rambalac and the Belgian ensemble Fractales, David Achenberg invites us on a journey.\r\n\r\nDuring the film-concert lasting nearly an hour, we are offered a romantic and musical wander through the land of the rising sun: Kaze to Arashi, or how to get lost in Edo, the old district of Tokyo...\r\nA world premiere coproduced by Jardin Musical.","performers":"Ensemble Fractales, David Achenberg, Rambalac","boxoffice_url":null,"website":null,"email":"info@jardinmusical.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543896"},"de":{"name":"KAZE TO ARASHI : Cin\u00e9 Concert \/ Musique Contemporaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543896"},"it":{"name":"KAZE TO ARASHI : Cin\u00e9 Concert \/ Musique Contemporaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543896"},"sp":{"name":"KAZE TO ARASHI : Cin\u00e9 Concert \/ Musique Contemporaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543896"},"pt":{"name":"KAZE TO ARASHI : Cin\u00e9 Concert \/ Musique Contemporaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543896"},"cn":{"name":"KAZE TO ARASHI : Cin\u00e9 Concert \/ Musique Contemporaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543896"}},"place":{"id":276657,"translations":{"fr":{"name":"Jardin Musical","address_street_name":"Quai aux Briques","address_street_number":"62","address_street_box":null,"email":"info@jardinmusical.org","website":"https:\/\/www.jardinmusical.org\/","phone_contact":"+32 456 04 35 05","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai aux Briques, 62","address_line2":"1000 Bruxelles","description_web":"un \u00e9cosyst\u00e8me cr\u00e9atif form\u00e9 par des artistes, pour des artistes.\r\n\r\n \r\n\r\nEn plein c\u0153ur historique de Bruxelles, dans l\u2019atelier de son fondateur le pianiste Julien Brocal, le Jardin Musical ouvre un salon \u00e0 \u00e9chelle humaine pour y mettre en lumi\u00e8re un terroir d\u2019artistes qu'il fait rayonner \u00e0 l\u2019international.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Jardin Musical","address_street_name":"Baksteenkaai","address_street_number":"62","address_street_box":null,"email":"info@jardinmusical.org","website":"https:\/\/www.jardinmusical.org\/","phone_contact":"+32 456 04 35 05","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Baksteenkaai, 62","address_line2":"1000 Brussel","description_web":"Een creatief ecosysteem gevormd door artiesten, voor artiesten.\r\n\r\n \r\n\r\nIn het historisch hartje van Brussel, in het muzikaal atelier van zijn oprichter, de pianist Julien Brocal, opent de Jardin Musical haar armen en een leefruimte op menselijke schaal met een hu