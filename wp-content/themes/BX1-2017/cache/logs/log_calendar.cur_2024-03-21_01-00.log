,"ratio":1.33,"oEmbed_height":900,"oEmbed_width":1200,"translations":{"de":{"title":"Jakuta Alikavazovic","copyright":"Francesca Mantovani"},"pt":{"title":"Jakuta Alikavazovic","copyright":"Francesca Mantovani"},"en":{"title":"Jakuta Alikavazovic","copyright":"Francesca Mantovani"},"it":{"title":"Jakuta Alikavazovic","copyright":"Francesca Mantovani"},"cn":{"title":"Jakuta Alikavazovic","copyright":"Francesca Mantovani"},"fr":{"title":"Jakuta Alikavazovic","copyright":"Francesca Mantovani"},"sp":{"title":"Jakuta Alikavazovic","copyright":"Francesca Mantovani"},"nl":{"title":"Jakuta Alikavazovic","copyright":"Francesca Mantovani"}}}],"dates":[{"day":"2024-03-22","doors":null,"start":"14:00:00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Kategorie 1"},"en":{"name":"Category 1"},"it":{"name":"Categoria 1"},"fr":{"name":"Cat\u00e9gorie 1"},"sp":{"name":"Categoria 1"},"nl":{"name":"Categorie 1"}},"value":9},{"translations":{"de":{"name":"Kategorie 2"},"en":{"name":"Category 2"},"it":{"name":"Categoria 2"},"fr":{"name":"Cat\u00e9gorie 2"},"sp":{"name":"Categoria 2"},"nl":{"name":"Categorie 2"}},"value":12},{"translations":{"de":{"name":"Article 27"},"pt":{"name":"Article 27"},"en":{"name":"Article 27"},"it":{"name":"Article 27"},"cn":{"name":"Article 27"},"fr":{"name":"Article 27"},"sp":{"name":"Article 27"},"nl":{"name":"Artikel 27"}},"value":1.25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50008126,"date_start":"2024-03-22","date_end":"2024-03-22","date_next":"2024-03-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-12T08:30:01+01:00","published_at":"2024-03-06T12:55:28+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296014,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":1.2599210498948732,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[125],"translations":{"de":["Chanson"],"pt":[null],"en":["Song"],"it":["Canzone"],"cn":[null],"fr":["Chanson"],"sp":["Chanson"],"nl":["Kleinkunst"]}}},"translations":{"de":{"name":"De Rossistische podcast: Ginger Art Curation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/fr\/agenda\/de-rossistische-podcast","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008126"},"pt":{"name":"De Rossistische podcast: Ginger Art Curation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/fr\/agenda\/de-rossistische-podcast","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008126"},"en":{"name":"De Rossistische podcast: Ginger Art Curation","shortdescr":"Ginger hair is unique and it stands out. That's why De Rossistische Podcast and Recyclart are organising the first 'Ginger Art Festival' in Belgium. Come celebrate gingerhood on March 22nd with a ginger curated art fair, a screening of 2 short films, live dance and music performances and a Q&A with fragments of the podcast. ","longdescr":"Seppe Poelvoorde\n\nPoelie was barely 13 when he bought his first DJ set and practiced almost every day. He already played at Bomboclat Festival and StuDay where he opened for Faisal and Vunzige Deuntjes Soundsystem. While rooted in Hip Hop, Poelie has ventured into a diverse range of genres, blending electronic music with Afrobeat, Dancehall and Latin. His sets combine classics with new music and always know how to come up with a surprise.\n\n+\n\nThe Redhead Crab\n\nThe Redhead Crab est une artiste autodidacte li\u00e9geoise dont les masques et trucs textiles d\u00e9veloppent une mystique de l\u2019incongru. Il y a dans les mise en sc\u00e8nes de ces pi\u00e8ces subtiles, souvent crochet\u00e9es et pleines de d\u00e9tails, quelque chose de rauque contrastant avec les couleurs et les mati\u00e8res. Le subtil y c\u00f4toie le cru, l\u2019adorable le laid, c\u2019est un spectacle organique et vivant. \n\nCe nom d'artiste est la contraction des 2 sujets de moquerie r\u00e9currents durant l'enfance : mes cheveux roux et mon nom de famille. \u201cAujourd'hui, je m'en amuse et en ai fait une force\u201d\n\nThe Redhead Crab is a self-taught artist from Li\u00e8ge whose masks and textile creations develop a mystique of the incongruous. There is something hoarse in the staging of these subtle pieces, often crocheted and full of details, contrasting with the colors and materials. The subtle coexists with the raw, the adorable with the ugly; it's an organic and lively spectacle. \n\nThis artist's name is a combination of the two recurring subjects of mockery during childhood: my red hair and my last name. \"Today, I play with it and have turned it into a strength.\"\n\n+\n \nMarius La Nuit\nMarius La Nuit - Marius la Nuit \u00e9crit des chansons. Avec sa guitare elle chante, r\u00eave, pleure et s'indigne.  Malgr\u00e9 les orages et les nuages, elle \u00e9crit. Des chansons bleues et des chansons rouges. Qui oscillent entre douceur et col\u00e8re. Des chansons sinc\u00e8res qui serrent la gorge, les poings et les zygomatiques. Elle travaille d\u00e9sormais avec deux musicien.nes pour partager son univers et ses nouvelles chansons sur sc\u00e8ne.\n\n+\n\nOksana\n\nMon travail ? Cr\u00e9er un univers imaginaire o\u00f9 la faune, la flore sous-marine, les champignons et bien d'autres s'entrem\u00ealent dans une fusion organique. J'aime brouiller les fronti\u00e8res entre les esp\u00e8ces, explorant les transformations \u00e0 travers le dessin, la gravure et la sculpture. Mes cheveux roux sont comme une premi\u00e8re porte vers l'art, m'inspirant des tableaux pr\u00e9rapha\u00e9lites. Il y a une bonne quantit\u00e9 de peintures de muses rousses o\u00f9, m\u00eame inconsciemment, ont pu me rendre fi\u00e8re de mes cheveux et vouloir appartenir \u00e0 un monde o\u00f9 ils \u00e9taient mis en avant. Ils refl\u00e8tent aussi mes \u00e9motions, s'affaiblissant quand je vais mal. Je les ch\u00e9ris, cherchant \u00e0 retrouver leur \u00e9clat d'antan.\n\n+\n\nRobbe Schepens\n\nJ'ai grandi en Chine, o\u00f9 mes cheveux roux \u00e9taient consid\u00e9r\u00e9s comme sp\u00e9ciaux et chanceux. Cela attirait beaucoup d'attention, mais lorsque je suis revenu en Belgique, j'ai \u00e9t\u00e9 victime d'harc\u00e8lement \u00e0 cause de mes cheveux roux. Cela m'a conduit \u00e0 l'univers fantastique des bandes dessin\u00e9es, o\u00f9 j'ai commenc\u00e9 \u00e0 cr\u00e9er mes propres mondes. Mon art se concentre principalement sur l'illustration, mais j'aime aussi exp\u00e9rimenter la peinture, les m\u00e9dias num\u00e9riques et les techniques graphiques telles que l'impression sur lino et l'impression au gel.\n\n+\n\nLeen Van Dommelen\n\nMeet Leen Van Dommelen, a Belgian performance maker and visual artist based in Brussels. With a background in sculpture and a master's degree in visual art and choreography, her work revolves around performances and installations, inviting viewers into a vulnerable interaction with introspective themes.\n\n\"I'm fascinated by the connection between red hair and transparent skin, which creates an illusion of revealing one's inner self - the blue veins, the blush of embarrassment. This sense of the body 'betraying' the inner world has deeply influenced my identity as both an individual and an artist. I'm drawn to the idea of the 'uncontrollable body' - blushing, trembling, fainting, rapid blinking - and how attempts to suppress these reactions only amplify them. This tension between psyche and body, control and loss of control, inspires my exploration of how the inner world manifests in physicality. I delve into the mechanisms beneath the surface, navigating societal norms and expectations.\"\n\nhttps:\/\/vimeo.com\/325606114\n\n+\n\nFlorencia Papaleo Yaccuzzi\nFlorencia Papaleo Yaccuzzi is an Argentinian performer born in 1994.\n\nShe moved to Brussels in 2018. During these years she has been working in dance and theater projects and films directed by Paola Madrid, Susanne Bentley and John Turturro, among others. \n\nFlorencia is a founding member of Les Sudakas Collective, a group of South-American artists based in Belgium.\n\n+\n\nCeleste\n\nMy name is Celeste. I am a Brussels-based, part-time crocheter working out my life\u2019s musings, joys, frustrations, and everything in-between, one loving stitch at a time. For the ginger art festival, I am inspired by my ginger pride and bring you works that stand out as much as we gingers do! I am also a member of the Crochet Club Antwerp, which meets weekly Wednesday evenings, beginners welcome.\n\n+\n\nMart Pool\nHello! My name is Mart im a 3rd years film student at the HKU in Utrecht(the Netherlands) I like to make movies but furniture making and animating are also things i love to do! I like stuff thats handmade and i try to give this feeling to everything i make!\n\nBesides this im also a dj and i really love sound! I think its the best way to get a person into a certain mood! I've been redhead al my life! Who would have thought at first getting called some names wasnt really fun but ive gotten over it and think thats also just part of growing up! \n\n+ \n \nMaegan - frip avant d'entrer\nJe suis Maegan, la fondatrice d'une friperie en ligne o\u00f9 je partage ma passion pour les v\u00eatements vintage depuis un an d\u00e9j\u00e0. Depuis toujours, j'adore d\u00e9nicher des pi\u00e8ces avec une histoire, que ce soit en les empruntant \u00e0 ma m\u00e8re ou en les r\u00e9cup\u00e9rant de mes amies. Mais ce que j'aime encore plus, c'est de voir ces v\u00eatements prendre vie sur d'autres personnes et les rendre trop styl\u00e9es ! En ce qui concerne mes cheveux, j'ai longtemps h\u00e9sit\u00e9 \u00e0 les teindre, mais avec le temps, j'ai appris \u00e0 aimer ma couleur naturelle, un roux auburn unique. Je la vois comme un h\u00e9ritage, avec sa dose de myst\u00e8re puisqu'aucun de mes parents n'est roux\n\n+ \n\nOtis\n\nBased in Brussels, Otis is a belgo-english peotry performer. They mingle words fluidly from french to English, from spoken word to signing, exploring the themes of intimacy, healing, relationships and existence in a capitalist context. \n\nThey studies acting at IAD and then developed their personal expression through dance, writing and singing. They are a member of the \"Collectif P\u00e8se-Moi\", a slam collective composed of women and non-binary people. \n\n+ \n\nElla Marion\n\nFrom an early age, I went to the drawing academy Sint-Lucas in Ghent and later finished my secondary education there. I don't like woolly stories about art, my art is my hobby and was created to deal with stress. When I experience stress, I find peace in drawing, painting and modelling.\nBoth my parents are not gingers but my ginger can be explained as my father was an Englishman ( and part Scottish). In England, gingers are not exactly loved, at least, this is from my own experience. More so, during my birth, my father clearly pointed out again 'If it's a ginger, it certainly isn't mine!'. Jokes on you dad!\n\n+ \n\nRoos-Marie van den Bogaerd\n\nFor the past two years, I've been immersed in drawing, experimenting with various materials and styles. Currently, I'm drawn to contrasts, textures, geometric shapes, and primary colors. My art is fueled by daily life and reflections on social phenomena. I love depicting people, exaggerating expressions and features to convey stories and emotions.\n\nGrowing up, I was surrounded by graphic design and printing press due to my father's work, and I've always valued artistic expression in my education. This background has fueled my passion for creativity and visual storytelling. In the future, I aspire to collaborate with projects promoting social justice and awareness through visual art.\n\n+ \n \nDovydas Strimaitis\n\nMeet Dovydas Strimaitis, a Lithuanian dancer and choreographer based in France and Belgium. His works delve into questioning dance history and future, exploring the relationship between dance content and context. In his upcoming piece \"Hairy 2.0\", he places his hair at the forefront, examining its role as both subject and object in dance. Hair, unlike other body parts, cannot be moved voluntarily, posing a challenge in choreography. This tension of controlling the uncontrollable is the essence of \"Hairy 2.0\".\n\n+ \n\nOlga Boisnard\nN\u00e9e \u00e0 Paris en 1997, Olga Boisnard est entour\u00e9e par une famille travaillant dans l\u2019image, ce qui cr\u00e9e rapidement une passion pour la photographie.\n\nElle a commenc\u00e9 des projets de photographie num\u00e9rique avec le projet \u00ab Submarine Skins \u00bb, r\u00e9alis\u00e9 pour le talent show du lyc\u00e9e fran\u00e7ais de Bruxelles. Il prend forme \u00e0 partir de photographies sous-marines prises par son p\u00e8re, Arthur Boisnard, puis projet\u00e9es sur des mod\u00e8les vivants, donnant ainsi naissance \u00e0 des corps sous-marins.\n\nToujours attir\u00e9e par la compl\u00e9mentarit\u00e9 des couleurs et des motifs, elle continue aujourd\u2019hui principalement \u00e0 l\u2019argentique, photographiant son quotidien et ses d\u00e9couvertes.\n\n ","performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/fr\/agenda\/de-rossistische-podcast","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008126"},"it":{"name":"De Rossistische podcast: Ginger Art Curation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/fr\/agenda\/de-rossistische-podcast","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008126"},"cn":{"name":"De Rossistische podcast: Ginger Art Curation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/fr\/agenda\/de-rossistische-podcast","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008126"},"fr":{"name":"De Rossistische podcast: Ginger Art Curation","shortdescr":"Les cheveux roux sont uniques et se distinguent des autres. De la sexualisation au ridicule, de la science \u00e0 l'histoire, De Rossistische podcast examine en profondeur ce que signifie exactement \u00eatre roux, d'o\u00f9 \u00e7a vient et la discrimination \u00e0 l'\u00e9gard des roux. Venez f\u00eater la rouxit\u00e9 avec une foire d'art, des projections, des spectacles de danse, de la musique et un Q&A avec des extraits du podcast.","longdescr":"Seppe Poelvoorde\n\nPoelie was barely 13 when he bought his first DJ set and practiced almost every day. He already played at Bomboclat Festival and StuDay where he opened for Faisal and Vunzige Deuntjes Soundsystem. While rooted in Hip Hop, Poelie has ventured into a diverse range of genres, blending electronic music with Afrobeat, Dancehall and Latin. His sets combine classics with new music and always know how to come up with a surprise.\n\n+\n\nThe Redhead Crab\n\nThe Redhead Crab est une artiste autodidacte li\u00e9geoise dont les masques et trucs textiles d\u00e9veloppent une mystique de l\u2019incongru. Il y a dans les mise en sc\u00e8nes de ces pi\u00e8ces subtiles, souvent crochet\u00e9es et pleines de d\u00e9tails, quelque chose de rauque contrastant avec les couleurs et les mati\u00e8res. Le subtil y c\u00f4toie le cru, l\u2019adorable le laid, c\u2019est un spectacle organique et vivant. \n\nCe nom d'artiste est la contraction des 2 sujets de moquerie r\u00e9currents durant l'enfance : mes cheveux roux et mon nom de famille. \u201cAujourd'hui, je m'en amuse et en ai fait une force\u201d\n\nThe Redhead Crab is a self-taught artist from Li\u00e8ge whose masks and textile creations develop a mystique of the incongruous. There is something hoarse in the staging of these subtle pieces, often crocheted and full of details, contrasting with the colors and materials. The subtle coexists with the raw, the adorable with the ugly; it's an organic and lively spectacle. \n\nThis artist's name is a combination of the two recurring subjects of mockery during childhood: my red hair and my last name. \"Today, I play with it and have turned it into a strength.\"\n\n+\n \nMarius La Nuit\nMarius La Nuit - Marius la Nuit \u00e9crit des chansons. Avec sa guitare elle chante, r\u00eave, pleure et s'indigne.  Malgr\u00e9 les orages et les nuages, elle \u00e9crit. Des chansons bleues et des chansons rouges. Qui oscillent entre douceur et col\u00e8re. Des chansons sinc\u00e8res qui serrent la gorge, les poings et les zygomatiques. Elle travaille d\u00e9sormais avec deux musicien.nes pour partager son univers et ses nouvelles chansons sur sc\u00e8ne.\n\n+\n\nOksana\n\nMon travail ? Cr\u00e9er un univers imaginaire o\u00f9 la faune, la flore sous-marine, les champignons et bien d'autres s'entrem\u00ealent dans une fusion organique. J'aime brouiller les fronti\u00e8res entre les esp\u00e8ces, explorant les transformations \u00e0 travers le dessin, la gravure et la sculpture. Mes cheveux roux sont comme une premi\u00e8re porte vers l'art, m'inspirant des tableaux pr\u00e9rapha\u00e9lites. Il y a une bonne quantit\u00e9 de peintures de muses rousses o\u00f9, m\u00eame inconsciemment, ont pu me rendre fi\u00e8re de mes cheveux et vouloir appartenir \u00e0 un monde o\u00f9 ils \u00e9taient mis en avant. Ils refl\u00e8tent aussi mes \u00e9motions, s'affaiblissant quand je vais mal. Je les ch\u00e9ris, cherchant \u00e0 retrouver leur \u00e9clat d'antan.\n\n+\n\nRobbe Schepens\n\nJ'ai grandi en Chine, o\u00f9 mes cheveux roux \u00e9taient consid\u00e9r\u00e9s comme sp\u00e9ciaux et chanceux. Cela attirait beaucoup d'attention, mais lorsque je suis revenu en Belgique, j'ai \u00e9t\u00e9 victime d'harc\u00e8lement \u00e0 cause de mes cheveux roux. Cela m'a conduit \u00e0 l'univers fantastique des bandes dessin\u00e9es, o\u00f9 j'ai commenc\u00e9 \u00e0 cr\u00e9er mes propres mondes. Mon art se concentre principalement sur l'illustration, mais j'aime aussi exp\u00e9rimenter la peinture, les m\u00e9dias num\u00e9riques et les techniques graphiques telles que l'impression sur lino et l'impression au gel.\n\n+\n\nLeen Van Dommelen\n\nMeet Leen Van Dommelen, a Belgian performance maker and visual artist based in Brussels. With a background in sculpture and a master's degree in visual art and choreography, her work revolves around performances and installations, inviting viewers into a vulnerable interaction with introspective themes.\n\n\"I'm fascinated by the connection between red hair and transparent skin, which creates an illusion of revealing one's inner self - the blue veins, the blush of embarrassment. This sense of the body 'betraying' the inner world has deeply influenced my identity as both an individual and an artist. I'm drawn to the idea of the 'uncontrollable body' - blushing, trembling, fainting, rapid blinking - and how attempts to suppress these reactions only amplify them. This tension between psyche and body, control and loss of control, inspires my exploration of how the inner world manifests in physicality. I delve into the mechanisms beneath the surface, navigating societal norms and expectations.\"\n\nhttps:\/\/vimeo.com\/325606114\n\n+\n\nFlorencia Papaleo Yaccuzzi\nFlorencia Papaleo Yaccuzzi is an Argentinian performer born in 1994.\n\nShe moved to Brussels in 2018. During these years she has been working in dance and theater projects and films directed by Paola Madrid, Susanne Bentley and John Turturro, among others. \n\nFlorencia is a founding member of Les Sudakas Collective, a group of South-American artists based in Belgium.\n\n+\n\nCeleste\n\nMy name is Celeste. I am a Brussels-based, part-time crocheter working out my life\u2019s musings, joys, frustrations, and everything in-between, one loving stitch at a time. For the ginger art festival, I am inspired by my ginger pride and bring you works that stand out as much as we gingers do! I am also a member of the Crochet Club Antwerp, which meets weekly Wednesday evenings, beginners welcome.\n\n+\n\nMart Pool\nHello! My name is Mart im a 3rd years film student at the HKU in Utrecht(the Netherlands) I like to make movies but furniture making and animating are also things i love to do! I like stuff thats handmade and i try to give this feeling to everything i make!\n\nBesides this im also a dj and i really love sound! I think its the best way to get a person into a certain mood! I've been redhead al my life! Who would have thought at first getting called some names wasnt really fun but ive gotten over it and think thats also just part of growing up! \n\n+ \n \nMaegan - frip avant d'entrer\nJe suis Maegan, la fondatrice d'une friperie en ligne o\u00f9 je partage ma passion pour les v\u00eatements vintage depuis un an d\u00e9j\u00e0. Depuis toujours, j'adore d\u00e9nicher des pi\u00e8ces avec une histoire, que ce soit en les empruntant \u00e0 ma m\u00e8re ou en les r\u00e9cup\u00e9rant de mes amies. Mais ce que j'aime encore plus, c'est de voir ces v\u00eatements prendre vie sur d'autres personnes et les rendre trop styl\u00e9es ! En ce qui concerne mes cheveux, j'ai longtemps h\u00e9sit\u00e9 \u00e0 les teindre, mais avec le temps, j'ai appris \u00e0 aimer ma couleur naturelle, un roux auburn unique. Je la vois comme un h\u00e9ritage, avec sa dose de myst\u00e8re puisqu'aucun de mes parents n'est roux\n\n+ \n\nOtis\n\nBased in Brussels, Otis is a belgo-english peotry performer. They mingle words fluidly from french to English, from spoken word to signing, exploring the themes of intimacy, healing, relationships and existence in a capitalist context. \n\nThey studies acting at IAD and then developed their personal expression through dance, writing and singing. They are a member of the \"Collectif P\u00e8se-Moi\", a slam collective composed of women and non-binary people. \n\n+ \n\nElla Marion\n\nFrom an early age, I went to the drawing academy Sint-Lucas in Ghent and later finished my secondary education there. I don't like woolly stories about art, my art is my hobby and was created to deal with stress. When I experience stress, I find peace in drawing, painting and modelling.\nBoth my parents are not gingers but my ginger can be explained as my father was an Englishman ( and part Scottish). In England, gingers are not exactly loved, at least, this is from my own experience. More so, during my birth, my father clearly pointed out again 'If it's a ginger, it certainly isn't mine!'. Jokes on you dad!\n\n+ \n\nRoos-Marie van den Bogaerd\n\nFor the past two years, I've been immersed in drawing, experimenting with various materials and styles. Currently, I'm drawn to contrasts, textures, geometric shapes, and primary colors. My art is fueled by daily life and reflections on social phenomena. I love depicting people, exaggerating expressions and features to convey stories and emotions.\n\nGrowing up, I was surrounded by graphic design and printing press due to my father's work, and I've always valued artistic expression in my education. This background has fueled my passion for creativity and visual storytelling. In the future, I aspire to collaborate with projects promoting social justice and awareness through visual art.\n\n+ \n \nDovydas Strimaitis\n\nMeet Dovydas Strimaitis, a Lithuanian dancer and choreographer based in France and Belgium. His works delve into questioning dance history and future, exploring the relationship between dance content and context. In his upcoming piece \"Hairy 2.0\", he places his hair at the forefront, examining its role as both subject and object in dance. Hair, unlike other body parts, cannot be moved voluntarily, posing a challenge in choreography. This tension of controlling the uncontrollable is the essence of \"Hairy 2.0\".\n\n+ \n\nOlga Boisnard\nN\u00e9e \u00e0 Paris en 1997, Olga Boisnard est entour\u00e9e par une famille travaillant dans l\u2019image, ce qui cr\u00e9e rapidement une passion pour la photographie.\n\nElle a commenc\u00e9 des projets de photographie num\u00e9rique avec le projet \u00ab Submarine Skins \u00bb, r\u00e9alis\u00e9 pour le talent show du lyc\u00e9e fran\u00e7ais de Bruxelles. Il prend forme \u00e0 partir de photographies sous-marines prises par son p\u00e8re, Arthur Boisnard, puis projet\u00e9es sur des mod\u00e8les vivants, donnant ainsi naissance \u00e0 des corps sous-marins.\n\nToujours attir\u00e9e par la compl\u00e9mentarit\u00e9 des couleurs et des motifs, elle continue aujourd\u2019hui principalement \u00e0 l\u2019argentique, photographiant son quotidien et ses d\u00e9couvertes.\n\n ","performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/fr\/agenda\/de-rossistische-podcast","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008126"},"sp":{"name":"De Rossistische podcast: Ginger Art Curation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/fr\/agenda\/de-rossistische-podcast","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008126"},"nl":{"name":"De Rossistische podcast: Ginger Art Curation","shortdescr":"Rost haar is uniek en valt op. Daarom organiseren De Rossistische Podcast en Recyclart het eerste \u2018Ginger Art Festival\u2019 in Belgi\u00eb. Kom op 22 maart gingerhood vieren met een ginger curated kunstbeurs, een screening van 2 kortfilms, live dans- en muziekoptredens, een Q&A met fragmenten van de podcast en gratis goodiebags met al je ginger essentials!  ","longdescr":" \n LINE UP: \n\nSeppe Poelvoorde\n\nPoelie was barely 13 when he bought his first DJ set and practiced almost every day. He already played at Bomboclat Festival and StuDay where he opened for Faisal and Vunzige Deuntjes Soundsystem. While rooted in Hip Hop, Poelie has ventured into a diverse range of genres, blending electronic music with Afrobeat, Dancehall and Latin. His sets combine classics with new music and always know how to come up with a surprise.\n\n+\n\nThe Redhead Crab\n\nThe Redhead Crab is a self-taught artist from Li\u00e8ge whose masks and textile creations develop a mystique of the incongruous. There is something hoarse in the staging of these subtle pieces, often crocheted and full of details, contrasting with the colors and materials. The subtle coexists with the raw, the adorable with the ugly; it's an organic and lively spectacle. \n\nThis artist's name is a combination of the two recurring subjects of mockery during childhood: my red hair and my last name. \"Today, I play with it and have turned it into a strength.\"\n\n+\n \nMarius La Nuit\nMarius La Nuit - Marius la Nuit \u00e9crit des chansons. Avec sa guitare elle chante, r\u00eave, pleure et s'indigne.  Malgr\u00e9 les orages et les nuages, elle \u00e9crit. Des chansons bleues et des chansons rouges. Qui oscillent entre douceur et col\u00e8re. Des chansons sinc\u00e8res qui serrent la gorge, les poings et les zygomatiques. Elle travaille d\u00e9sormais avec deux musicien.nes pour partager son univers et ses nouvelles chansons sur sc\u00e8ne.\n\n+\n\nOksana\n\nHello everyone! I'm Oksana Baudemont, an artist from the North of France. My work? Creating an imaginary universe where fauna, underwater flora, mushrooms, and many others intertwine in an organic fusion. I enjoy blurring the boundaries between species, exploring transformations through drawing, engraving, and sculpture. My red hair is like a gateway to art, inspiring me from Pre-Raphaelite paintings. There is a good amount of paintings of redheaded muses where, even unconsciously, they may have made me proud of my hair and want to belong to a world where they were highlighted. They also reflect my emotions, weakening when I am feeling down. I cherish them, seeking to regain their former shine.\n\n+\n\nRobbe Schepens\n\nIk ben Robbe Schepens, 23 jaar oud en woon in Gent. Als kind groeide ik op in China waar mijn rossige haar als speciaal en gelukbrengend werd beschouwd. Dit trok veel aandacht, maar toen ik terug naar Belgi\u00eb verhuisde, werd ik gepest. Dit leidde me naar de fantasiewereld van stripverhalen, waar ik mijn eigen werelden begon te cre\u00ebren. Mijn kunst richt zich voornamelijk op illustratie, maar ik experimenteer ook graag met schilderen, digitale media en grafische technieken zoals linodruk en gel printen.\n\n+\n\nLeen Van Dommelen\n\nMeet Leen Van Dommelen, a Belgian performance maker and visual artist based in Brussels. With a background in sculpture and a master's degree in visual art and choreography, her work revolves around performances and installations, inviting viewers into a vulnerable interaction with introspective themes.\n\n\"I'm fascinated by the connection between red hair and transparent skin, which creates an illusion of revealing one's inner self - the blue veins, the blush of embarrassment. This sense of the body 'betraying' the inner world has deeply influenced my identity as both an individual and an artist. I'm drawn to the idea of the 'uncontrollable body' - blushing, trembling, fainting, rapid blinking - and how attempts to suppress these reactions only amplify them. This tension between psyche and body, control and loss of control, inspires my exploration of how the inner world manifests in physicality. I delve into the mechanisms beneath the surface, navigating societal norms and expectations.\"\n\nhttps:\/\/vimeo.com\/325606114\n\n+\n \nFlorencia Papaleo Yaccuzzi\nFlorencia Papaleo Yaccuzzi is an Argentinian performer born in 1994.\n\nShe moved to Brussels in 2018. During these years she has been working in dance and theater projects and films directed by Paola Madrid, Susanne Bentley and John Turturro, among others. \n\nFlorencia is a founding member of Les Sudakas Collective, a group of South-American artists based in Belgium.\n\n+\n \nCeleste\n \nMy name is Celeste. I am a Brussels-based, part-time crocheter working out my life\u2019s musings, joys, frustrations, and everything in-between, one loving stitch at a time. For the ginger art festival, I am inspired by my ginger pride and bring you works that stand out as much as we gingers do! I am also a member of the Crochet Club Antwerp, which meets weekly Wednesday evenings, beginners welcome.\n \n+\n \nMart Pool\nHello! My name is Mart im a 3rd years film student at the HKU in Utrecht(the Netherlands) I like to make movies but furniture making and animating are also things i love to do! I like stuff thats handmade and i try to give this feeling to everything i make!\n\nBesides this im also a dj and i really love sound! I think its the best way to get a person into a certain mood! I've been redhead al my life! Who would have thought at first getting called some names wasnt really fun but ive gotten over it and think thats also just part of growing up! \n\n+ \n \nMaegan - frip avant d'entrer\nJe suis Maegan, la fondatrice d'une friperie en ligne o\u00f9 je partage ma passion pour les v\u00eatements vintage depuis un an d\u00e9j\u00e0. Depuis toujours, j'adore d\u00e9nicher des pi\u00e8ces avec une histoire, que ce soit en les empruntant \u00e0 ma m\u00e8re ou en les r\u00e9cup\u00e9rant de mes amies. Mais ce que j'aime encore plus, c'est de voir ces v\u00eatements prendre vie sur d'autres personnes et les rendre trop styl\u00e9es ! En ce qui concerne mes cheveux, j'ai longtemps h\u00e9sit\u00e9 \u00e0 les teindre, mais avec le temps, j'ai appris \u00e0 aimer ma couleur naturelle, un roux auburn unique. \n\n+ \n\nOtis\n\nBased in Brussels, Otis is a belgo-english peotry performer. They mingle words fluidly from french to English, from spoken word to signing, exploring the themes of intimacy, healing, relationships and existence in a capitalist context. \n\nThey studies acting at IAD and then developed their personal expression through dance, writing and singing. They are a member of the \"Collectif P\u00e8se-Moi\", a slam collective composed of women and non-binary people. \n\n+ \n\nElla Marion\n\nAl van jongs af aan ging ik naar de tekenacademie Sint-Lucas te Gent en heb daar dan later ook mijn Middelbaar afgewerkt. Ik houd niet van zweverige verhaaltjes over kunst, mijn kunst is mijn hobby en kwam tot stand om om te gaan met stress. Als ik stress ervaar, vind ik rust bij tekenen, schilderen en boetseren. \n\nMijn beide ouders zijn niet rost maar mijn rost valt wel te verklaren aangezien mijn vader een Engelsman ( en een deeltje Schots) was. In Engeland zijn gingers niet bepaald geliefd, althans, dit is uit eigen ervaring. Meer nog, tijdens mijn geboorte wees mijn vader er duidelijk nog eens op \u2018If it\u2019s a ginger, it certainly isn\u2019t mine!\u2019. Jokes on you dad\n\n\n+ \n\nRoos-Marie van den Bogaerd\n\nFor the past two years, I've been immersed in drawing, experimenting with various materials and styles. Currently, I'm drawn to contrasts, textures, geometric shapes, and primary colors. My art is fueled by daily life and reflections on social phenomena. I love depicting people, exaggerating expressions and features to convey stories and emotions.\n\nGrowing up, I was surrounded by graphic design and printing press due to my father's work, and I've always valued artistic expression in my education. This background has fueled my passion for creativity and visual storytelling. In the future, I aspire to collaborate with projects promoting social justice and awareness through visual art.\n\n+ \n\nDovydas Strimaitis\n\nMeet Dovydas Strimaitis, a Lithuanian dancer and choreographer based in France and Belgium. His works delve into questioning dance history and future, exploring the relationship between dance content and context. In his upcoming piece \"Hairy 2.0\", he places his hair at the forefront, examining its role as both subject and object in dance. Hair, unlike other body parts, cannot be moved voluntarily, posing a challenge in choreography. This tension of controlling the uncontrollable is the essence of \"Hairy 2.0\".\n\n+ \n \nOlga Boisnard\nN\u00e9e \u00e0 Paris en 1997, Olga Boisnard est entour\u00e9e par une famille travaillant dans l\u2019image, ce qui cr\u00e9e rapidement une passion pour la photographie.\n\nElle a commenc\u00e9 des projets de photographie num\u00e9rique avec le projet \u00ab Submarine Skins \u00bb, r\u00e9alis\u00e9 pour le talent show du lyc\u00e9e fran\u00e7ais de Bruxelles. Il prend forme \u00e0 partir de photographies sous-marines prises par son p\u00e8re, Arthur Boisnard, puis projet\u00e9es sur des mod\u00e8les vivants, donnant ainsi naissance \u00e0 des corps sous-marins.\n\nToujours attir\u00e9e par la compl\u00e9mentarit\u00e9 des couleurs et des motifs, elle continue aujourd\u2019hui principalement \u00e0 l\u2019argentique, photographiant son quotidien et ses d\u00e9couvertes.\n\n ","performers":"De Rossistische Podcast x Recyclart","boxoffice_url":null,"website":"https:\/\/recyclart.be\/fr\/agenda\/de-rossistische-podcast","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008126"}},"place":{"id":231699,"translations":{"de":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Die alternative Kunst-, Kultur- und Stadtteilinitiative Recyclart betreibt einen der dynamischsten Orte der Stadt. Zwischen Kunst und gesellschaftlichen Themen bietet Recyclart eine bunte und eklektische Vielfalt an Veranstaltungen und Initiativen. Und seit dem Standortwechsel von dem stillgelegten Bahnhof Bruxelles-Chapelle in ein sch\u00f6nes Geb\u00e4ude mit charmanter Terrasse in einem fast schon Berlinerisch anmutenden Innenhof weht seit 2018 abermals ein frischer Wind. Das Projekt f\u00e4chert sich in drei Bereiche auf: Ein Kunstzentrum, die Bar Recyclart (Bar und Restaurant) und die Recyclart Fabrik (Infra-\/Holz-\/Metallwerkst\u00e4tten) mit Wiedereingliederungsma\u00dfnahmen f\u00fcr Langzeitarbeitslose.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Created in 2000 and now located in Molenbeek since 2018, Recyclart is a multidisciplinary urban project that draws inspiration from the city and its district. A landmark in the history of underground culture in Brussels, it is composed of an ARTS CENTRE and two socio-professional integration projects, namely the RECYCLART BAR and the RECYCLART FABRIK (infra\/wood\/metal workshops).\r\n\r\nAs an art centre, Recyclart connects art to the urban context in which it is embedded. This context acts as a source of inspiration for the artistic activities and, conversely, Recyclart also uses its artistic programme as a catalyst to open up this same urban context and make it more liveable. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Cr\u00e9\u00e9 en 2000 et relocalis\u00e9 depuis 2018 \u00e0 Molenbeek, Recyclart est un projet urbain pluridisciplinaire qui s'inspire de la ville et de son quartier. Haut lieu de l\u2019histoire de la culture underground \u00e0 Bruxelles, il se compose d\u2019un CENTRE D\u2019ARTS et de deux projets d\u2019insertion socioprofessionnelle que sont le BAR RECYCLART et le RECYCLART FABRIK (ateliers infra\/bois\/m\u00e9tal).\r\n\r\nEn tant que centre artistique, Recyclart relie l'art au contexte urbain dans lequel il s'inscrit. Ce contexte sert de source d'inspiration pour les activit\u00e9s artistiques et, inversement, Recyclart utilise \u00e9galement son programme artistique comme un catalyseur pour ouvrir ce m\u00eame contexte urbain et le rendre plus vivable. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Recyclart","address_street_name":"Manchesterstraat ","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Manchesterstraat , 13-15","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Het multidisciplinaire stadsproject Recyclart bestaat sinds 2000 en verhuisde in 2018 naar Molenbeek, waar het zich blijft inspireren op de stad en de wijk.  Als een van de belangrijkste plekken in de Brusselse underground-geschiedenis combineert het een KUNSTENCENTRUM met twee sociale integratieprojecten, BAR RECYCLART en RECYCLART FABRIK (werkplaats voor hout-, metaal- en infrastructuurwerk).\r\n\r\nMet het kunstencentrum verbindt Recyclart kunst met de stedelijke context waar het deel van uitmaakt. De stad dient als inspiratiebron voor de artistieke activiteiten, maar ook omgekeerd zet Recyclart haar artistieke programma in als katalysator, om zo diezelfde stedelijke context toegankelijker en leefbaarder te maken.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[23],"translations":{"de":["Westen"],"pt":[null],"en":["West"],"it":["Ovest"],"cn":[null],"fr":["Ouest"],"sp":["Oeste"],"nl":["West"]}},"neca":null,"facebook_id":"RECYCLARTBXL","backoffice_id":973,"location":{"lat":50.84757339,"lon":4.32864108},"region":"brussels","last_updated_at":"2023-09-19T16:52:47+02:00","published_at":"2013-10-19T01:13:57+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231699,"translations":{"de":{"name":"Recyclart","address_street_name":"rue de Manches