losed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-23T02:03:47+02:00","published_at":"2023-03-13T12:52:18+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":273296,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.24807684691733564,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[45,36],"translations":{"de":["Mode","Museen & Kunstzentren"],"pt":[null,null],"en":["Fashion","Museums and art centers"],"it":["Moda","Musei e centri artistici"],"cn":[null,null],"fr":["Mode","Mus\u00e9es et art centers"],"sp":["Moda","Museos y centros de arte"],"nl":["Mode","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.553296"},"pt":{"name":"Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.553296"},"en":{"name":"Diane von Furstenberg. Woman Before Fashion","shortdescr":"The emblematic wrap dress turns 50 this year. A great opportunity for the museum to devote its new exhibition to the fashion designer Diane von Furstenberg. A first in Europe! Discover the inspiring career of this native of Brussels who became an international figure of fashion.","longdescr":"Woman Before Fashion is not a retrospective. It is a free approach to the Diane von Furstenberg\u2019s work. The exhibition presents the creations of the famous Belgo-American fashion designer and the person behind them. Comprising a selection of over 50 models and a wide-ranging iconography, the experience begins with fashion and ends with the woman. Through an interplay of visions and a juxtaposition of creations, this ground-breaking exhibition provides the keys to understanding the incredible career of a female designer who understands women. Along with personal photographs, visitors will perceive the diversity and timelessness of her prints. The designer has a specific language of colours and prints, one that she also applies to her must-have wrap dress. Visitors will discover Diane von Furstenberg\u2019s many sources of inspiration, such as: freedom, which motivates her in her work but also in her daily life, \r\nthe role played by art in her creations with the work of friends like Andy Warhol, Konstantin Kakanias and Fran\u00e7ois-Marie Banier or more broadly abstract painting, art and architecture. The exhibition also looks at Diane von Furstenberg\u2019s phenomenal and unique career. As soon as she arrived in New York, she noticed the variety of the outfits worn by women there. These \u201ccrazy looks\u201d fuelled her desire to introduce \u201cthe little dress\u201d in America. The wrap dress quickly became a worldwide lifestyle.","performers":"Born in Brussels after the 2nd world war, Diane Halfin began her schooling at the Lyc\u00e9e Dachsbeck before going to boarding school in Switzerland. In 1970 she moved to New York with a suitcase full of dresses. She created the iconic wrap dress.","boxoffice_url":null,"website":"http:\/\/www.fashionandlacemuseum.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553296"},"it":{"name":"Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.553296"},"cn":{"name":"Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.553296"},"fr":{"name":"Diane von Furstenberg. Woman Before Fashion","shortdescr":"La wrap dress, l\u2019embl\u00e9matique robe portefeuille, f\u00eate cette ann\u00e9e ses 50 ans. L\u2019occasion pour le mus\u00e9e de consacrer sa nouvelle exposition \u00e0 la cr\u00e9atrice, Diane von Furstenberg. Une premi\u00e8re en Europe ! D\u00e9couvrez le parcours inspirant de cette Bruxelloise devenue une figure internationale de la mode.","longdescr":"Woman Before Fashion n\u2019est pas une r\u00e9trospective. C\u2019est une mani\u00e8re d\u2019aborder de fa\u00e7on libre le travail de Diane von Furstenberg. L\u2019exposition pr\u00e9sente l\u2019\u0153uvre et la personne de la c\u00e9l\u00e8bre cr\u00e9atrice de mode belgo-am\u00e9ricaine. \u00c0 travers une s\u00e9lection de plus de 50 mod\u00e8les et une vaste iconographie, le parcours prend pour point de d\u00e9part la mode pour se terminer sur la femme. Entre jeux de regards et confrontation de cr\u00e9ations, cette exposition in\u00e9dite donne les cl\u00e9s pour comprendre l\u2019incroyable carri\u00e8re d\u2019une femme cr\u00e9atrice ayant compris les femmes.\r\nAux c\u00f4t\u00e9s de photographies personnelles, le visiteur appr\u00e9hende la diversit\u00e9 et l\u2019intemporalit\u00e9 des imprim\u00e9s. Un langage sp\u00e9cifique de couleurs et d\u2019imprim\u00e9s que la cr\u00e9atrice applique \u00e0 son incontournable robe portefeuille. Le visiteur s\u2019impr\u00e8gne \u00e9galement des multiples inspirations de Diane von Furstenberg dont : la libert\u00e9 qui l\u2019inspire dans son travail mais \u00e9galement dans sa vie quotidienne, le r\u00f4le jou\u00e9 par l\u2019art dans ses cr\u00e9ations avec des \u0153uvres d\u2019amis tels qu\u2019Andy Warhol, Konstantin Kakanias et Fran\u00e7ois-Marie Banier ou plus largement la peinture abstraite, l\u2019art et l\u2019architecture. L\u2019exposition revient \u00e9galement sur la carri\u00e8re ph\u00e9nom\u00e9nale et singuli\u00e8re de Diane von Furstenberg. D\u00e8s son arriv\u00e9e \u00e0 New York, elle remarque la diversit\u00e9 des tenues port\u00e9es par les femmes. Ces \u00ab crazy looks \u00bb alimentent son d\u00e9sir d\u2019introduire en Am\u00e9rique \u00ab la petite robe \u00bb. La wrap dress devient rapidement un style de vie mondial.","performers":"N\u00e9e \u00e0 Bruxelles apr\u00e8s la Seconde Guerre mondiale, Diane Halfin d\u00e9bute sa scolarit\u00e9 au Lyc\u00e9e Dachsbeck avant de partir en pension en Suisse. En 1970, elle s'installe \u00e0 New York avec une valise pleine de robes et cr\u00e9e l'embl\u00e9matique robe portefeuille. ","boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553296"},"sp":{"name":"Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.553296"},"nl":{"name":"Diane von Furstenberg. Woman Before Fashion","shortdescr":"De wrapdress, de bekende wikkeljurk, bestaat dit jaar 50 jaar. De ideale gelegenheid voor het museum om in zijn nieuwe tentoonstelling te focussen op de ontwerpster ervan, Diane von Furstenberg. Een primeur in Europa! Ontdek de inspirerende carri\u00e8re van deze Brusselse, die het schopte tot internationale modefiguur.","longdescr":"Woman Before Fashion is geen retrospectieve, maar veeleer een vrije benadering van het werk van Diane von Furstenberg. De tentoonstelling laat ons kennismaken met het werk en de persoon van deze vermaarde Belgisch-Amerikaanse modeontwerpster. Via een selectie van meer dan vijftig modellen en uitgebreid illustratiemateriaal start de tentoonstelling bij de mode, om te eindigen bij de vrouw. Tussen het spel van de looks en de confrontatie van de diverse ontwerpen biedt deze unieke tentoonstelling een kijk op de uitzonderlijke carri\u00e8re van een ontwerpster die begreep wat vrouwen willen. De persoonlijke foto\u2019s bieden de bezoeker inzicht in de diversiteit en tijdloosheid van de prints. Een specifieke taal van kleuren en prints die de ontwerpster toepast op haar bekende wikkeljurk. De bezoeker ontdekt ook de veelzijdige inspiratiebronnen van Diane von Furstenberg zoals: de vrijheid die haar werk maar ook haar dagelijks leven inspireert, de rol die de kunst in haar creaties speelt met werken van vrienden als Andy Warhol, Konstantin Kakanias en Fran\u00e7ois-Marie Banier tot abstracte schilderkunst, kunst en architectuur. De tentoonstelling biedt ook een terugblik op de fenomenale en unieke carri\u00e8re van Diane von Furstenberg. Zodra ze in New York aankwam, viel het haar op hoe divers de outfits van vrouwen waren. Deze \u2018crazy looks\u2019 voedden haar verlangen om \u2018het jurkje\u2019 in Amerika te introduceren. De wikkeljurk werd al snel een wereldwijde levensstijl.","performers":"Diane Halfin werd in 1946 in Brussel geboren en groeide er ook op. Ze begon haar opleiding aan het Lyc\u00e9e Dachsbeck en verhuisde daarna naar Zwitserland. T Diane von Furstenberg, gevestigd in New York, ontwierp de wikkeljurk in 1973. In twee jaar tijd werden er meer dan een miljoen exemplaren van verkocht. ","boxoffice_url":null,"website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553296"}},"place":{"id":1515,"translations":{"de":{"name":"Mus\u00e9e Mode et Dentelle - Mode- und Spitzenmuseum (Museen der Stadt Br\u00fcssel)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Das im Jahr 1977 er\u00f6ffnete Mode- und Spitzenmuseum (Mus\u00e9e Mode et Dentelle) hat in Br\u00fcssel eine echte Daseinsberechtigung, denn die Geschichte der Stadt, ja des Landes ist im wahrsten Sinne des Wortes eng mit der Textilkunst verwoben.\r\n\r\nBr\u00fcssel weist ein reiches Erbe auf, was feine Stoffe und Textilwaren angeht. Die Tradition der Textilindustrie, die bis ins 12. Jahrhundert zur\u00fcckreicht und sich bis heute im Bereich Modedesign und Textilhandel zeigt, ist fest in der Br\u00fcsseler Kultur verankert.\r\n\r\nEinen faszinierenden Einblick in diesen Bereich geben die reichen Sammlungen des Mode- und Spitzenmuseums mit alten, aber auch modernen Spitzengeweben, Stickereien, Kost\u00fcmen und extravaganten Accessoires, die im Rahmen regelm\u00e4\u00dfig wechselnder Ausstellungen gezeigt werden.\r\n\r\nParallel zu den gro\u00dfen thematischen Ausstellungen bietet das Mode- und Spitzenmuseum der zeitgen\u00f6ssischen Textilkreation eine besondere Plattform: Seit 2004 empf\u00e4ngt das Museum wechselnde Ausstellungen, die sowohl die Arbeiten von Studierenden im Bereich Textilkunst als auch die Werke bereits etablierter Textilk\u00fcnstler zeigen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of Fashion & Lace ","address_street_name":"rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"The Fashion & Lace Museum displays its collections by means of major annual exhibitions. These address both the design and the production and social use of the garments.\r\nThe exhibitions transport you to diverse and captivating worlds. From items never before exhibited, such as in Masculinities or Back Side, through historical themes, such as the glamour of the 1930s or the bold \u201870s, to exhibitions devoted to Belgian designers such as Carine Gilson and Jean-Paul Lespagnard.\r\n\r\nParallel to these major exhibitions, the museum also offers:\r\n\r\n- The Fashion Room, an unparalleled space in Belgium, provides you with the opportunity to understand how a museum builds its collections. Discover exceptional items, not hidden behind glass, in order to see them up close.\r\n\r\n- The Lace Room displays remarkable pieces that illustrate the finesse, high quality and beauty of Brussels lace. Explore the history of this type of fabric, so valued by the elites in the 17th century yet no longer in vogue today.\r\n\r\nHoused in a series of historic houses at the heart of Brussels, the Fashion & Lace Museum holds some 15,000 pieces from the 16th century to the present. The Museum has the most important collections in the world when it comes to Brussels design and production, which it seeks to position in a Belgian and international context.\r\nIts collections attest to the changes in fashion as well as to a specific era of our culture and our society.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9e Mode & Dentelle","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Le Mus\u00e9e Mode & Dentelle pr\u00e9sente ses collections \u00e0 travers de grandes expositions annuelles. Elles abordent tant la cr\u00e9ation que la production et l\u2019usage social du v\u00eatement.\r\nCes expositions vous transportent dans des univers aussi vari\u00e9s que captivants. De l\u2019in\u00e9dit avec Masculinities ou Back Side, de l\u2019historique avec le glamour des ann\u00e9es 30 ou les audacieuses seventies ou encore des expositions consacr\u00e9es \u00e0 des cr\u00e9ateurs de chez nous comme Carine Gilson ou Jean-Paul Lespagnard.\r\n\r\nEn parall\u00e8le \u00e0 ces grandes expositions, le mus\u00e9e propose \u00e9galement :\r\n\r\n- La Fashion Room, cet espace in\u00e9dit en Belgique vous permet de comprendre comment un mus\u00e9e enrichit ses collections. D\u00e9couvrez y des pi\u00e8ces exceptionnelles, hors vitrine, afin d\u2019\u00eatre au plus proche de celles-ci.\r\n\r\n- La Chambre des Dentelles pr\u00e9sente de remarquables pi\u00e8ces illustrant la finesse, la qualit\u00e9 et la beaut\u00e9 de la dentelle de Bruxelles. Explorez l\u2019histoire de cette \u00e9toffe pris\u00e9e des \u00e9lites d\u00e8s le 17e si\u00e8cle et aujourd\u2019hui disparue.\r\n\r\nAbrit\u00e9 au c\u0153ur de Bruxelles, dans un ensemble de maisons historiques, le Mus\u00e9e Mode & Dentelle conserve quelque 15.000 pi\u00e8ces datant du 16e si\u00e8cle \u00e0 nos jours. Il poss\u00e8de les plus importantes collections au monde en ce qui concerne la cr\u00e9ation et la confection bruxelloises, qu\u2019il vise \u00e0 replacer dans un contexte belge et international.\r\nSes collections sont les t\u00e9moins de l\u2019\u00e9volution de la mode mais aussi d\u2019une \u00e9poque, de notre culture, de notre soci\u00e9t\u00e9.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo del Traje y Encaje (Museos de la Ciudad de Bruselas)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"El Museo del Traje y el Encaje destaca por su perspectiva din\u00e1mica e innovadora centrada en la moda contempor\u00e1nea. Ideal para ver prendas excepcionales de moda belga y bruselense en exposiciones temporales, como la de Jean-Paul Lespagnard. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Mode en Kant Museum ","address_street_name":"Violetstraat","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Violetstraat, 12","address_line2":"1000 Bruxelles","description_web":"Het Mode & Kant Museum presenteert zijn collecties tijdens grote jaarlijkse tentoonstellingen. Daarin komen het ontwerp, de productie en de sociale dimensie van kleding aan bod.\r\nDeze tentoonstellingen nemen je telkens mee naar een wereld die even gevarieerd als boeiend is. Je maakt er kennis met het ongeziene in Masculinities en Back Side, of met de historische glamour uit de jaren dertig. Ook de gedurfde jaren zeventig en tentoonstellingen gewijd aan onze eigen ontwerpers, zoals Carine Gilson of Jean-Paul Lespagnard, stonden ooit op het programma.\r\n\r\nNaast deze grote tentoonstellingen laat het museum je ook graag kennismaken met:\r\n- De Fashion Room, een baanbrekend concept in Belgi\u00eb, dat je toont hoe een museum zijn collecties verrijkt. We hebben enkele uitzonderlijke stukken opgesteld buiten de vitrine, zodat je ze in detail kunt bekijken.\r\n\r\n- De Kantkamer, waar opmerkelijke stukken opgesteld staan die de verfijning, de kwaliteit en de schoonheid van het Brusselse kantwerk illustreren. Kom de geschiedenis van deze stof ontdekken, die vanaf de 17e eeuw erg door de elite werd gewaardeerd, maar die nu verdwenen is.\r\nIn hartje  Brussel, in een groep historische huizen, bewaart het Mode & Kant Museum ongeveer 15.000 voorwerpen die dateren van de 16e eeuw tot vandaag. Het bezit de belangrijkste collecties ter wereld rond de Brusselse ontwerpen en kleding, die het in een Belgische en internationale context wil plaatsen.\r\nDe collecties leggen getuigenis af over de evolutie van de mode, maar ook over een tijdperk, onze cultuur en onze maatschappij.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":197,"location":{"lat":50.84577733,"lon":4.35198995},"region":"brussels","last_updated_at":"2023-05-16T12:16:17+02:00","published_at":"2013-10-19T01:13:21+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1515,"translations":{"de":{"name":"Mus\u00e9e Mode et Dentelle - Mode- und Spitzenmuseum (Museen der Stadt Br\u00fcssel)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Das im Jahr 1977 er\u00f6ffnete Mode- und Spitzenmuseum (Mus\u00e9e Mode et Dentelle) hat in Br\u00fcssel eine echte Daseinsberechtigung, denn die Geschichte der Stadt, ja des Landes ist im wahrsten Sinne des Wortes eng mit der Textilkunst verwoben.\r\n\r\nBr\u00fcssel weist ein reiches Erbe auf, was feine Stoffe und Textilwaren angeht. Die Tradition der Textilindustrie, die bis ins 12. Jahrhundert zur\u00fcckreicht und sich bis heute im Bereich Modedesign und Textilhandel zeigt, ist fest in der Br\u00fcsseler Kultur verankert.\r\n\r\nEinen faszinierenden Einblick in diesen Bereich geben die reichen Sammlungen des Mode- und Spitzenmuseums mit alten, aber auch modernen Spitzengeweben, Stickereien, Kost\u00fcmen und extravaganten Accessoires, die im Rahmen regelm\u00e4\u00dfig wechselnder Ausstellungen gezeigt werden.\r\n\r\nParallel zu den gro\u00dfen thematischen Ausstellungen bietet das Mode- und Spitzenmuseum der zeitgen\u00f6ssischen Textilkreation eine besondere Plattform: Seit 2004 empf\u00e4ngt das Museum wechselnde Ausstellungen, die sowohl die Arbeiten von Studierenden im Bereich Textilkunst als auch die Werke bereits etablierter Textilk\u00fcnstler zeigen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_bo