tart":"19:00:00","end":"23:59:00"}]},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, samedi et dimanche: ferm\u00e9","mercredi, jeudi et vendredi: de 19:00 \u00e0 23:59"],"nl":["maandag, dinsdag, zaterdag en zondag: gesloten","woensdag, donderdag en vrijdag: van 19:00 tot 23:59"],"en":["monday, tuesday, saturday and sunday: closed","wednesday, thursday and friday: from 19:00 to 23:59"]},"date_start":"2022-11-16","date_end":"2022-11-18","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":52}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,256,257,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-17T02:35:53+01:00","published_at":"2022-09-19T17:23:30+02:00","backoffice_id":262197,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":0.8735804647363},{"id":538298,"date_start":"2022-11-17","date_end":"2022-11-19","date_next":"2022-11-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"D\u00e9faut d'origine","shortdescr":null,"longdescr":"Enfant issue d\u2019un couple mixte ill\u00e9gitime belgo-marocain dans les ann\u00e9es 70, maintenue dans la non-reconnaissance des diversit\u00e9s qui la constitue, expos\u00e9e a\u0300 la violence ordinaire, Yasmine grandit dans la honte d\u2019un corps, d\u2019une couleur de peau et d\u2019une texture de cheveux qu\u2019elle porte comme des stigmates, attributs physiques associ\u00e9s a\u0300 des communaut\u00e9s m\u00e9pris\u00e9es et d\u00e9nigr\u00e9es.\r\n \r\nAdolescente, a\u0300 la mort brutale de son p\u00e8re, elle d\u00e9veloppe, par haine de son corps et de ce qui est \u00ab \u00e9tranger \u00bb en elle, une maladie de peau qui la handicape au quotidien et qu\u2019elle cache... car ce nouveau stigmate, elle peut enfin le dissimuler.\r\n \r\nSur le plateau, les voix du passe\u0301 dialoguent avec la voix de la femme devenue adulte, qui, devant nous, transforme sa honte, en outil de libert\u00e9.\r\n \r\nBien que faisant sans cesse r\u00e9f\u00e9rence a\u0300 l\u2019histoire collective, ce spectacle autobiographique raconte l\u2019histoire particuli\u00e8re de Yasmine, histoire qui d\u00e9fie la logique et d\u00e9samorce les clich\u00e9s. Il sera le r\u00e9cit d\u2019une enqu\u00eate intime, remplie de troubles et de flous identitaires , de honte, de col\u00e8re, de haine de soi et de fiert\u00e9.\r\n \r\nSur sc\u00e8ne, Yasmine reconstruit devant nous le puzzle d\u2019une existence emp\u00each\u00e9e par un d\u00e9faut d\u2019origine. Par la franchise et l\u2019humour avec lesquels elle a pu se confronter aux questions li\u00e9es a\u0300 son identit\u00e9, elle nous permet d\u2019aborder avec originalit\u00e9 et l\u00e9g\u00e8ret\u00e9 la question des conflits int\u00e9rieurs auxquels nous sommes confront\u00e9s lorsque nous portons une double culture ou, de mani\u00e8re plus large lorsque nous nous sentons peu reconnu dans notre diff\u00e9rence.\r\n \r\n\u00c9criture : Bouchra Ezzahir et Yasmine Laassal  l Conception et mise en sc\u00e8ne : Bouchra Ezzahir l Jeu : Yasmine Laassal l Cr\u00e9ateur lumi\u00e8re : Ga\u00ebtan van den Berg\r\n \r\nUne cr\u00e9ation Espace Magh en coproduction avec le Th\u00e9\u00e2tre des Chardons.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538298"},"nl":{"name":"D\u00e9faut d'origine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538298"},"en":{"name":"D\u00e9faut d'origine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538298"},"de":{"name":"D\u00e9faut d'origine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538298"},"it":{"name":"D\u00e9faut d'origine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_co