e_next":"2024-09-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-22T02:01:51+02:00","published_at":"2024-09-04T15:58:11+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307178,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.37810239113357186,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Mazel Galerie & Sato Gallery Present \"Natsukashii\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000945"},"pt":{"name":"Mazel Galerie & Sato Gallery Present \"Natsukashii\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000945"},"en":{"name":"Mazel Galerie & Sato Gallery Present \"Natsukashii\"","shortdescr":"For our new group show Natsukashii, we are delighted to invite SatoGallery to bring together some of our respective artists to discuss this conceptual word. Natsukashii is a Japanese word for which there is no French equivalent. The closest word would be nostalgia, but this word refers to the desire to return to the past, whereas the Japanese word evokes the pleasure of recalling good times.","longdescr":"A specific smell, image, sound or taste, which evokes a beautiful memory with tenderness, triggers the Natsukashii. Fifteen artists, both native and Western, are invited to share our exhibition space. It will be interesting to observe the creative and cultural exchanges as well as the points of convergence and differences between the non-Japanese artists of Mazel Galerie and the Japanese artists of Sato Gallery.\nJapan may seem a long way away to Westerners, but it's omnipresent in our culture, to the point of being an integral part of it. Judo, manga, cartoons, sushi, origami, matcha and many other things are part of our daily lives and populate our memories. More sophisticated concepts such as umami (the 5th flavor) and kawaii (cute) have even become relatively common terms in Europe.\nAn exhibition that celebrates Japanese culture in all its aspects, through the eyes of those who embody it and those who observe it.","performers":"Bordalo II -  Flog -  Murmure -  Gabriela Noelle -  Laurina Paperina -  PEZ - Austyn Taylor\nTakeru Amano -  Excalibur - Shun Okada -  Daijiro Hama -  Mayumi Nakao -  Fantasista Utamaro -  Samy San - ","boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000945"},"it":{"name":"Mazel Galerie & Sato Gallery Present \"Natsukashii\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/ww