{"data":[{"id":50010819,"date_start":"2024-11-19","date_end":"2024-11-23","date_next":"2024-11-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:00:35+01:00","published_at":"2024-05-16T17:37:05+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":300436,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1.0626585691826111,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"L'amour c'est pour du beurre by Eline Shumacher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lestanneurs.be\/spectacle\/lamour-cest-pour-du-beurre-24-25\/","email":"info@lestanneurs.be","phone_contact":"+32 2 502 37 43","phone_booking":"+32 2 512 17 84","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010819"},"pt":{"name":"L'amour c'est pour du beurre by Eline Shumacher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lestanneurs.be\/spectacle\/lamour-cest-pour-du-beurre-24-25\/","email":"info@lestanneurs.be","phone_contact":"+32 2 502 37 43","phone_booking":"+32 2 512 17 84","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010819"},"en":{"name":"L'amour c'est pour du beurre by Eline Shumacher","shortdescr":"A big hit for the 2023-2024 programme, \"L\u2019amour c\u2019est pour du beurre\" is a humanist love comedy. Set against the backdrop of William Shakespeare\u2019s extremely \u2018playful\u2019 \"Twelfth Night\", Eline Schumacher sheds light on the theatrical experience.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lestanneurs.be\/spectacle\/lamour-cest-pour-du-beurre-24-25\/","email":"info@lestanneurs.be","phone_contact":"+32 2 502 37 43","phone_booking":"+32 2 512 17 84","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010819"},"it":{"name":"L'amour c'est pour du beurre by Eline Shumacher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lestanneurs.be\/spectacle\/lamour-cest-pour-du-beurre-24-25\/","email":"info@lestanneurs.be","phone_contact":"+32 2 502 37 43","phone_booking":"+32 2 512 17 84","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010819"},"cn":{"name":"L'amour c'est pour du beurre by Eline Shumacher","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lestanneurs.be\/spectacle\/lamour-cest-pour-du-beurre-24-25\/","email":"info@lestanneurs.be","phone_contact":"+32 2 502 37 43","phone_booking":"+32 2 512 17 84","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010819"},"fr":{"name":"L'amour c'est pour du beurre d'Eline Shumacher","shortdescr":"Grand succ\u00e8s de la saison 2023-2024, \"L\u2019amour c\u2019est pour du beurre\" est une com\u00e9die d\u2019amour humaniste, sur fond d\u2019ambiance carnavalesque, de jeux sur le langage, de quiproquos et d\u2019accidents. En explorant en toile de fond \"La Nuit des rois\" de William Shakespeare, texte extr\u00eamement \u00ab jouant \u00bb, Eline Schumacher met en lumi\u00e8re la pulsion du th\u00e9\u00e2tre.","longdescr":"Tout le monde a mal quelque part : au corps, \u00e0 la t\u00eate ou au c\u0153ur. Six personnes viennent se soigner au sein d\u2019un groupe, r\u00e9unies par une animatrice, doux m\u00e9lange entre une artiste et une assistante sociale. Ces \u00eatres ing\u00e9nus viennent faire du th\u00e9\u00e2tre pour \u00ab aller mieux \u00bb et tout le monde est de bonne volont\u00e9 pour essayer de monter \"La Nuit des rois\" de Shakespeare, dans une salle de gym. Mais un jour, l\u2019animatrice n\u2019est pas l\u00e0. Elle ne viendra plus. Que faire alors ? On doit faire un spectacle ! Co\u00fbte que co\u00fbte, les r\u00e9p\u00e9titions continuent. Leurs failles se d\u00e9voilent, le stress monte et les quiproquos se multiplient\u2026 Le soir de la premi\u00e8re, ce n\u2019est plus pour du beurre.\n\nCe groupe est jou\u00e9 par des acteur\u00b7ices masqu\u00e9\u00b7es, couche suppl\u00e9mentaire pour sonder l\u2019\u00e2me humaine. Ces masques, tels une seconde peau, brouillent les genres et mettent en exergue l\u2019expressivit\u00e9 des corps. Le trouble de l\u2019identit\u00e9 est \u00e0 l\u2019\u0153uvre.\n\nComme dans \"La Nuit des rois\", on se travestit. Au contraire de \"La Nuit des rois\", on n\u2019arrive pas \u00e0 s\u2019aimer si facilement. \"L\u2019amour c\u2019est pour du beurre\" est une ode au th\u00e9\u00e2tre, aux \u00eatres humains, \u00e0 leurs failles et \u00e0 la complexit\u00e9 des \u00e9motions.","performers":"Mise en sc\u00e8ne et \u00e9criture Eline Schumacher\nAssistanat \u00e0 la mise en sc\u00e8ne Julien Jaillot\nJeu Lucile Charnier, Mathylde Demarez, Thomas Dubot, Sarah Lefe\u0300vre, Titouan Quittot, Noe\u0301mie Zurletti\nSc\u00e9nographie Zouzou Leyens, avec l\u2019aide de Jarod Dhuyvetter, assistant stagiaire, et Aicha Compaore\u0301\nCr\u00e9ation lumi\u00e8re Aurore Leduc\nCr\u00e9ation sonore Noam Rzewski\nR\u00e9gie g\u00e9n\u00e9rale et plateau Marc Defrise","boxoffice_url":null,"website":"https:\/\/lestanneurs.be\/spectacle\/lamour-cest-pour-du-beurre-24-25\/","ema