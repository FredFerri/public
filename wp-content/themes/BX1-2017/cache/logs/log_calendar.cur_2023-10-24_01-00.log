":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[99],"translations":{"de":["Gastronomie"],"pt":[null],"en":["Gastronomy"],"it":["Cucina"],"cn":[null],"fr":["Gastronomie"],"sp":["Gastronom\u00eda"],"nl":["Gastronomie"]}}},"translations":{"de":{"name":"Atelier met La Ferme du Chaudron","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lafermeduchaudron.be\/","email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001658"},"pt":{"name":"Atelier met La Ferme du Chaudron","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lafermeduchaudron.be\/","email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001658"},"en":{"name":"Atelier met La Ferme du Chaudron","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lafermeduchaudron.be\/","email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001658"},"it":{"name":"Atelier met La Ferme du Chaudron","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lafermeduchaudron.be\/","email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001658"},"cn":{"name":"Atelier met La Ferme du Chaudron","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lafermeduchaudron.be\/","email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001658"},"fr":{"name":"Atelier met La Ferme du Chaudron","shortdescr":"Tous les mardis, la Ferme du Chaudron ouvre les portes de la salle Le Cap \u00e0 Bizet. L'espace se transforme en un lieu polyvalent. Tout le monde y est le bienvenu pour une tasse de caf\u00e9 ou de th\u00e9 gratuite. Et en plus, un atelier sans engagement est toujours propos\u00e9 o\u00f9 l'on s'inspire mutuellement autour de pratiques nutritionnelles respectueuses de notre corps, de notre soci\u00e9t\u00e9 et de l'environnement.","longdescr":"Programme d\u2019octobre:\n3\/10 : ATELIER : m\u00e9langer des \u00e9pices\n10\/10: REPAS DE QUARTIER*: couscous\n17\/10 : ATELIER : essai de recettes avec des noix\/ ch\u00e2taignes\n24\/10: les 1000 possibilit\u00e9s de la farine - Traditions turques\n31\/10 : ATELIER : exp\u00e9riences cr\u00e9atives avec le potiron (sucr\u00e9 et sal\u00e9)\n\n* (Tous les deuxi\u00e8mes mardis du mois, un repas complet est pr\u00e9par\u00e9 ensemble. C'est gratuit mais n\u00e9cessite une inscription au 0456590309 ou via rika@lafermeduchaudron.be)","performers":null,"boxoffice_url":null,"website":"https:\/\/lafermeduchaudron.be\/","email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001658"},"sp":{"name":"Atelier met La Ferme du Chaudron","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lafermeduchaudron.be\/","email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001658"},"nl":{"name":"Atelier met La Ferme du Chaudron","shortdescr":"Elke dinsdag opent La Ferme du Chaudron de deuren van Salle Le Cap in Bizet van 12u tot 16u. De ruimte transformeert zich tot multi-purpose plek. Iedereen is er welkom voor een gratis kopje koffie of thee. En daarnaast wordt er steeds een vrijblijvende workshop aangeboden waarin we elkaar onderling inspireren rond voedingspraktijken die ons lichaam, onze maatschappij en het milieu respecteren. ","longdescr":"Programma van oktober:\n3\/10: ATELIER: kruiden mengen\n10\/10: BUURTKEUKEN*: couscous\n17\/10: ATELIER: aan de slag met walnoten\/ kastanjes\n24\/10 : ATELIER: de 1000 mogelijkheden van bloem - Turkse tradities\n31\/10: ATELIER: creatieve probeersels met pompoen (zoet en zout)\n\n* (Elke tweede dinsdag van de maand wordt er samen een volledige maaltijd gekookt. Deze is gratis maar vereist inschrijving via 0456590309 of via rika@lafermeduchaudron.be)\n","performers":"La Ferme du Chaudron ASBL, oganisation qui s'engage pour une alimentation bien et local, faisant vivre concr\u00e8tement la d\u00e9mocratie alimentaire.\n","boxoffice_url":null,"website":"https:\/\/lafermeduchaudron.be\/","email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001658"}},"place":{"id":50000025,"translations":{"de":{"name":"La Ferme du Chaudron","address_street_name":"Rue du Chaudron","address_street_number":"62","address_street_box":null,"email":"info@lafermeduchaudron.be","website":"https:\/\/lafermeduchaudron.be\/","phone_contact":"+32 484 34 59 55","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue du Chaudron, 62","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La Ferme du Chaudron","address_street_name":"Rue du Chaudron","address_street_number":"62","address_street_box":null,"email":"info@lafermeduchaudron.be","website":"https:\/\/lafer