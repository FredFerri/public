21 64 91","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50002558"},"pt":{"name":"Cl\u00e9one","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-action.be","email":"billetterie@theatre-action.be","phone_contact":"+32 64 21 64 91","phone_booking":"+32 64 21 64 91","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002558"},"en":{"name":"Cl\u00e9one","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-action.be","email":"billetterie@theatre-action.be","phone_contact":"+32 64 21 64 91","phone_booking":"+32 64 21 64 91","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002558"},"it":{"name":"Cl\u00e9one","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-action.be","email":"billetterie@theatre-action.be","phone_contact":"+32 64 21 64 91","phone_booking":"+32 64 21 64 91","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002558"},"cn":{"name":"Cl\u00e9one","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-action.be","email":"billetterie@theatre-action.be","phone_contact":"+32 64 21 64 91","phone_booking":"+32 64 21 64 91","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002558"},"fr":{"name":"Cl\u00e9one","shortdescr":"Sorci\u00e8re intemporelle et contemporaine, Cl\u00e9one est une esclave en fuite, \u201cl\u2019archive inconsol\u00e9e des f\u00e9minicides\u201d. Rejointe par quelques compagnons d\u2019\u00e9vasion, elle affronte avec eux \u201cla m\u00e9moire des viols subis\u201d, et \u00e9voque les luttes du pass\u00e9 et les col\u00e8res actuelles. Palais, centres commerciaux,  bourses n\u2019ont qu\u2019\u00e0 bien se tenir ! ","longdescr":"Cl\u00e9one est une sorci\u00e8re intemporelle et contemporaine. Esclave en fuite, marronne, elle questionne po\u00e9tiquement le d\u00e9sordre du monde. \"Je suis l'archive inconsol\u00e9e des f\u00e9minicides\". Vite rejointe par quelques compagnons d'\u00e9vasion, ils affrontent ensemble \"la m\u00e9moire des viols subis\". Ils moquent le patriarcat, tournent en ridicule les exploitations multiples, \u00e9voquent luttes du pass\u00e9 et col\u00e8res actuelles, main coup\u00e9e des esclaves noirs, doigts arrach\u00e9s des gilets jaunes. Dans leur course folle, ils se font le \"miroir de nos vies traqu\u00e9es\" tout en refusant le r\u00f4le de victimes. Palais, centres commerciaux, bourses et banques n'ont qu'\u00e0 bien se tenir ! \"Nous sommes feu de joie\", fredonnent-ils. Mais qui sont ces femmes et ces hommes qui, comme les sorci\u00e8res d'autrefois, bousculent aujourd'hui l'ordre \u00e9tabli par leur seul refus d'une normalit\u00e9 ?","performers":"Le Festival International de Th\u00e9\u00e2tre Action (FITA 2023) pr\u00e9sente : Cl\u00e9one, par la compagnie Arca Azzura (Italie) et le Collectif Libertalia (Belgique). Jeu : Marco Borgheresi, Aur\u00e9lie Cami, Robin Carton, In\u00e8s Deraedemacker, Marine Haelterman, Aur\u00e9lie Henceval, Samuel Osman, Fernando Zamora. Conception et mise en sc\u00e8ne : Patrick Duquesne. Production : Collectif Libertalia. ","boxoffice_url":null,"website":"http:\/\/www.theatre-action.be","email":"billetterie@theatre-action.be","phone_contact":"+32 64 21 64 91","phone_booking":"+32 64 21 64 91","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002558"},"sp":{"name":"Cl\u00e9one","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-action.be","email":"billetterie@theatre-action.be","phone_contact":"+32 64 21 64 91","phone_booking":"+32 64 21 64 91","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002558"},"nl":{"name":"Cl\u00e9one","shortdescr":null,"longdescr":null,"performers":null,"boxoffice