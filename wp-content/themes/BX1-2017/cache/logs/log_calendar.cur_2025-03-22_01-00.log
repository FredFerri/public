rste, woensdag van de maand van 09:30 tot 12:00","en":"Open the first, wednesday of the month from 09:30 to 12:00"}}],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700002428,"date_start":"2024-10-17","date_end":"2025-06-27","date_next":"2025-04-03","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-21T01:03:21+01:00","published_at":"2024-10-10T09:59:11+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":309512,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.19894457138304456,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[51],"translations":{"de":["Kabarett"],"pt":[null],"en":["Cabaret"],"it":["Cabaret"],"cn":[null],"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"sp":["Caf\u00e9 teatro"],"nl":["Cabaret"]}}},"translations":{"de":{"name":"En exclusivit\u00e9 - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002428"},"pt":{"name":"En exclusivit\u00e9 - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002428"},"en":{"name":"En exclusivit\u00e9 - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002428"},"it":{"name":"En exclusivit\u00e9 - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002428"},"cn":{"name":"En exclusivit\u00e9 - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002428"},"fr":{"name":"En exclusivit\u00e9 - Spectacle d'improvisation","shortdescr":"Plongez dans une saison unique d'improvisation r\u00e9volutionnaire. Alban Schuiten et Laurence Poot repoussent les fronti\u00e8res du th\u00e9\u00e2tre pour vous offrir une exp\u00e9rience explosive. Ne ratez pas cette aventure th\u00e9\u00e2trale \u00e9ph\u00e9m\u00e8re \u2013 une exclusivit\u00e9 \u00e0 ne pas manquer !","longdescr":"EN EXCLUSIVIT\u00c9 : Un Spectacle d'Improvisation Unique ! \n\nPr\u00e9parez-vous \u00e0 vivre une exp\u00e9rience d'improvisation comme jamais auparavant ! Alban Schuiten et Laurence Poot vous pr\u00e9sentent EN EXCLUSIVIT\u00c9, un spectacle con\u00e7u sp\u00e9cialement pour VOUS et uniquement pour cette saison. \n\nIci, tout est in\u00e9dit : des concepts surprenants, des techniques innovantes et des univers encore jamais explor\u00e9s sur sc\u00e8ne. Ces deux esprits cr\u00e9atifs se sont lanc\u00e9s dans l'aventure de repousser les limites de l'improvisation pour vous offrir un spectacle que vous ne reverrez nulle part ailleurs. \n\nChaque repr\u00e9sentation est une nouvelle d\u00e9couverte, une plong\u00e9e dans l'inconnu, o\u00f9 l'audace et la cr\u00e9ativit\u00e9 sont les ma\u00eetres-mots. Soyez pr\u00eats \u00e0 \u00eatre \u00e9merveill\u00e9s par des performances qui d\u00e9fient les conventions et vous transportent dans des mondes encore inexplor\u00e9s. \n\nNe manquez pas cette occasion unique de d\u00e9couvrir EN EXCLUSIVIT\u00c9 un spectacle qui ne ressemble \u00e0 aucun autre. C'est l'improvisation \u00e0 l'\u00e9tat pur, repens\u00e9e, r\u00e9invent\u00e9e, et r\u00e9serv\u00e9e rien que pour vous ! ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002428"},"sp":{"name":"En exclusivit\u00e9 - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002428"},"nl":{"name":"En exclusivit\u00e9 - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002428"}},"place":{"id":267378,"translations":{"de":{"name":"Le TRAC","address_street_name":"Rue Albert Meunier","address_street_number":"110","address_street_box":null,"email":"info@letrac.be","website":"http:\/\/www.letrac.be\/","phone_contact":"+32 470 50 04 75","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue Albert Meunier, 110","address_line2":"1160 Auderghem","description_web":nul