":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-08T17:07:02+01:00","published_at":"2024-11-08T17:02:13+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311239,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":2,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{}},"translations":{"de":{"name":"En Avant ! F\u00eate des droits de l'enfant et des jeunes - F\u00eate \u00e0 Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/enavant.cfwb.be\/","email":"enavant@cfwb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003477"},"pt":{"name":"En Avant ! F\u00eate des droits de l'enfant et des jeunes - F\u00eate \u00e0 Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/enavant.cfwb.be\/","email":"enavant@cfwb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003477"},"en":{"name":"En Avant ! F\u00eate des droits de l'enfant et des jeunes - F\u00eate \u00e0 Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/enavant.cfwb.be\/","email":"enavant@cfwb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003477"},"it":{"name":"En Avant ! F\u00eate des droits de l'enfant et des jeunes - F\u00eate \u00e0 Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/enavant.cfwb.be\/","email":"enavant@cfwb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003477"},"cn":{"name":"En Avant ! F\u00eate des droits de l'enfant et des jeunes - F\u00eate \u00e0 Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/enavant.cfwb.be\/","email":"enavant@cfwb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003477"},"fr":{"name":"En Avant ! F\u00eate des droits de l'enfant et des jeunes - F\u00eate \u00e0 Flagey","shortdescr":"En Avant ! est un \u00e9v\u00e9nement unique, une f\u00eate, enti\u00e8rement gratuite, qui fait conna\u00eetre les droits de l\u2019enfant de mani\u00e8re ludique. Un rendez-vous pour tous les enfants et les jeunes de 0 \u00e0 18 ans, quelles que soient leur situation familiale, les conditions \u00e9conomiques dans lesquelles ils vivent, leurs origines, leurs diff\u00e9rences\u2026","longdescr":"En Avant ! est un \u00e9v\u00e9nement unique, une f\u00eate, enti\u00e8rement gratuite, qui fait conna\u00eetre les droits de l\u2019enfant de mani\u00e8re ludique. Un rendez-vous pour tous les enfants et les jeunes de 0 \u00e0 18 ans, quelles que soient leur situation familiale, les conditions \u00e9conomiques dans lesquelles ils vivent, leurs origines, leurs diff\u00e9rences\u2026\n\nAu programme : des ateliers cr\u00e9atifs, de la psychomotricit\u00e9, des s\u00e9ances de cin\u00e9ma, de la musique, de la danse, un breakomaton, un atelier de customisation de v\u00eatement, des philo-clowns, des expos, des ateliers culinaires et encore plein d'autres choses \u00e0 d\u00e9couvrir... pour les petits comme pour les grands\n\nEn Avant ! est une initiative de la F\u00e9d\u00e9ration Wallonie-Bruxelles, mise en \u0153uvre par l'ASBL Badje et la Coordination des ONG pour les Droits de l'Enfant, en \u00e9troite collaboration avec Yellow Events et le soutien de la Cocof.","performers":null,"boxoffice_url":null,"website":"https:\/\/enavant.cfwb.be\/","email":"enavant@cfwb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003477"},"sp":{"name":"En Avant ! F\u00eate des droits de l'enfant et des jeunes - F\u00eate \u00e0 Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/enavant.cfwb.be\/","email":"enavant@cfwb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003477"},"nl":{"name":"En Avant ! F\u00eate des droits de l'enfant et des jeunes - F\u00eate \u00e0 Flagey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/enavant.cfwb.be\/","email":"enavant@cfwb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003477"}},"place":{"id":237158,"translations":{"de":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Das ehemalige Rundfunkgeb\u00e4ude mit Blick auf den Place Flagey und die Teiche von Ixelles ist heute mehr denn je ein Ort der Begegnungen f\u00fcr unterschiedliche k\u00fcnstlerische Disziplinen. Das kulturelle Angebot ist ebenso beeindruckend wie das Art-d\u00e9co-Geb\u00e4ude selbst: Jazz, traditionelle Musik, klassische und zeitgen\u00f6ssische Musik, Film- und Videokunst\u2026 Dank der hervorragenden Akustik haben verschiedene Festivals den Konzertsaal des Flagey zu ihrer B\u00fchne auserkoren, darunter die Flagey Piano Days und das Brussels Jazz Festival. Doch auch junge (belgische) Talente bekommen hier die Gelegenheit, ihr Talent unter Beweis zu stellen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Flagey","address_street_name":"place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Located on the edge of the Flagey square and next to the Ixelles ponds, this building \u2013 formerly the headquarters of the national radio and television institution \u2013 has now more than ever become a crossroad where artistic disciplines can meet and exchange ideas. Culture lovers of all ages are welcome in this beautiful Art Deco building, to take part in various events which range from concerts of jazz, world, classical and contemporary music, to film events and video projects. Each year, Flagey has the honor of receiving some of the world\u2019s most prominent artists, yet it still insists on offering opportunities to younger (Belgian) talents.\r\n\r\nThanks to the structural support of the different Belgian communities, and because of the exceptional acoustic qualities of the concert studios, the diversity of programming and events such as the Flagey Piano Days and the Brussels Jazz Festival, Flagey is today one of the leading culture houses on the national as well as the international scene.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Flagey","address_street_name":"place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"place Sainte-Croix","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Avec un regard tourn\u00e9 vers la place Flagey, vers les \u00e9tangs d'Ixelles, cet ancien b\u00e2timent de radio et de t\u00e9l\u00e9diffusion nationale est aujourd'hui plus que jamais un point de rencontre o\u00f9 diff\u00e9rentes disciplines artistiques se croisent dans un esprit de dialogue. Les amoureux de la culture de tous \u00e2ges sont les bienvenus dans ce magnifique b\u00e2timent Art d\u00e9co pour des concerts de jazz, de musique traditionnelle, de musique classique et contemporaine, mais c\u2019est \u00e9galement une place de choix pour le cin\u00e9ma et la vid\u00e9o.\r\nChaque ann\u00e9e, Flagey accueille les plus grands artistes d\u2019ici et d\u2019ailleurs mais est \u00e9galement une vitrine pour les jeunes talents (belges). \r\nGr\u00e2ce \u00e0 l'appui structurel des diff\u00e9rentes communaut\u00e9s belges, et par les qualit\u00e9s acoustiques exceptionnelles de ses salles, sa programmation vari\u00e9e ainsi que ses festivals telles que les Flagey Piano Days et le Brussels Jazz Festival, Flagey est devenu l'une des plus importantes maisons de la culture en Belgique et \u00e0 l'\u00e9tranger.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Situado al borde de la plaza Flagey y cerca de los estanques de Ixelles, este edificio \u2013 anteriormente la sede central de la radio nacional y la televisi\u00f3n p\u00fablica \u2013 ahora m\u00e1s que nunca se ha convertido en un cruce donde las disciplinas art\u00edsticas pueden encontrarse y compartir ideas. Los amantes de la cultura de todas las edades son bienvenidos a este hermoso edificio Art D\u00e9co, para tomar parte en diversos eventos que var\u00edan desde conciertos de jazz, m\u00fasica universal, cl\u00e1sica y m\u00fasica contempor\u00e1nea hasta eventos cinematogr\u00e1ficos y proyecciones de video. Cada a\u00f1o, Flagey tiene el honor de recibir a algunos de los artistas m\u00e1s destacados del mundo, pero a\u00fan as\u00ed insiste en ofrecer una oportunidad a j\u00f3venes talentos.\r\n\r\nGracias al apoyo estructural de las diferentes comunidades belgas y a las excepcionales cualidades ac\u00fasticas de las salas de conciertos, la diversidad de programas y eventos tales como Flagey Piano Days y el Brussels Jazz Festival, Flagey es hoy una de las casas l\u00edderes en cultura en el plano nacional, as\u00ed como en el internacional.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Flagey","address_street_name":"Heilig-Kruisplein","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Elsene","address_line1":"Heilig-Kruisplein","address_line2":"1050 Elsene","description_web":"Gelegen aan het Flageyplein naast de vijvers van Elsene, is dit voormalige nationale radio- en televisiegebouw een plek waar  verschillende artistieke disciplines elkaar kruisen. Cultuurliefhebbers van alle leeftijden kunnen terecht in dit prachtige art deco gebouw voor zowel jazz, wereldmuziek, als klassieke en hedendaagse muziek, maar ook voor films en videoprojecten. \r\nFlagey ontvangt jaarlijks de allergrootste artiesten uit binnen- en buitenland en wil ook kansen bieden aan jong (Belgisch) talent. \r\nDankzij de structurele steun van de verschillende Belgische gemeenschappen, door de uitzonderlijke akoestische kwaliteiten van de zalen, de gevarieerde programmatie, en door eigen festivals zoals de Flagey Piano Days en het Brussels Jazz Festival, is Flagey uitgegroeid tot \u00e9\u00e9n van de belangrijkste cultuurhuizen in binnen- en buitenland.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":1708,"location":{"lat":50.82686549,"lon":4.37279903},"region":"brussels","last_updated_at":"2024-06-06T15:51:33+02:00","published_at":"2013-10-19T01:14:34+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":270229,"translations":{"de":{"name":"Badje ASBL","address_street_name":"Rue Emile Feron","address_street_number":"153","address_street_box":null,"email":null,"website":"http:\/\/www.badje.be","phone_contact":"+322481729","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Emile Feron, 153","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Badje ASBL","address_street_name":"Rue Emile Feron","address_street_number":"153","address_street_box":null,"email":null,"website":"http:\/\/www.badje.be","phone_contact":"+322481729","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Emile Feron, 153","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Badje ASBL","address_street_name":"Emile Feronstraat","address_street_number":"153","address_street_box":null,"email":null,"website":"http:\/\/www.badje.be","phone_contact":"+322481729","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Emile Feronstraat, 153","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Badje ASBL","address_street_name":"Rue Em