or_event":false,"backoffice_id":303637,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.4496443130226092,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[95],"translations":{"de":["Kulturerbe"],"pt":[null],"en":["Heritage"],"it":["Patrimonio culturale"],"cn":[null],"fr":["Patrimoine"],"sp":["Patrimonio"],"nl":["Erfgoed"]}}},"translations":{"de":{"name":"Art & History Family Studio 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/art-history-family-studio-2030","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012269"},"pt":{"name":"Art & History Family Studio 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/art-history-family-studio-2030","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012269"},"en":{"name":"Art & History Family Studio 2030","shortdescr":"Art Basics for Children and Museum A&H present: the ART & HISTORY FAMILY STUDIO 2030, a large discovery area situated in the main hall of the Museum.","longdescr":"Art Basics for Children and Museum A&H present: the ART & HISTORY FAMILY STUDIO 2030, a large discovery area situated in the main hall of the Museum.\nUnleash your creativity using interesting materials at the ATELIER tables or come and play with toys for all ages. Attend a kamishibai storytelling session, browse through the library, or just hang out. Spend a couple of hours, or a whole day, we promise you you will not be bored!\nWant to go further? Then sign up for the FESTIVAL SPECIALS! On Thursdays, we will dive deeper into the Festival's theme: Belgium's (upcoming) 200th anniversary. Facing that horizon, we first travel back to the 18th century, a time of elaborate wigs and chocolate, of revolutions and inventions. It\u2019s here that the idea of a Belgian state first emerged.\nThursday 8.08 \u2013 DESIGN\nThursday 15.08 \u2013 GRAPHICS\nThursday 22.08 \u2013 SCIENCE\nThursday 29.08 \u2013 PARTY!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/en\/activity\/art-history-family-studio-2030","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012269"},"it":{"name":"Art & History Family Studio 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/art-history-family-studio-2030","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012269"},"cn":{"name":"Art & History Family Studio 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/art-history-family-studio-2030","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012269"},"fr":{"name":"Art & History Family Studio 2030","shortdescr":"Art Basics for Children et le Mus\u00e9e Art & Histoire vous invitent au ART & HISTORY FAMILY STUDIO 2030, un grand espace de jeu dans le Grand Narthex du Mus\u00e9e.","longdescr":"Art Basics for Children et le Mus\u00e9e Art & Histoire vous invitent au ART & HISTORY FAMILY STUDIO 2030, un grand espace de jeu dans le Grand Narthex du Mus\u00e9e.\nLaissez libre court \u00e0 votre cr\u00e9ativit\u00e9 avec des mat\u00e9riaux amusants. Venez vous divertir avec des jouets adapt\u00e9s \u00e0 tous les \u00e2ges, m\u00eame au plus petits. Assistez \u00e0 une s\u00e9ance de th\u00e9\u00e2tre kamishibai. Venez fureter dans la biblioth\u00e8que. Installez-vous \u00e0 une des tables de l\u2019ATELIER permanent pour une activit\u00e9 stimulante \u2026 Bref, ne ratez pas ce moment inoubliable !\nVous en voulez plus ? Inscrivez-vous au SPECIALS FESTIVAL ! Pendant quatre jeudis, nous d\u00e9velopperons d\u00e9j\u00e0 le th\u00e8me du Festival 2030 (pour le 200e anniversaire de la Belgique) en retournant d\u2019abord au 18e si\u00e8cle, l\u2019\u00e9poque des perruques et du chocolat, des r\u00e9volutions et des inventions. C\u2019est, en effet, \u00e0 cette \u00e9poque qu\u2019appara\u00eet une premi\u00e8re id\u00e9e de la Belgique.\nJeudi 8.08 - DESIGN\nJeudi 15.08 \u2013 GRAPHISME\nJeudi 22.08 \u2013 SCIENCES\nJeudi 29.08 \u2013 F\u00caTE !","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/art-history-family-studio-2030","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012269"},"sp":{"name":"Art & History Family Studio 2030","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/art-history-family-studio-2030","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012269"},"nl":{"name":"Art & History Family Studio 2030","shortdescr":"Art Basics for Children en Museum Kunst & Geschiedenis stellen voor: de ART & HISTORY FAMILY STUDIO 2030!","longdescr":"Art Basics for Children en Museum Kunst & Geschiedenis stellen voor: de ART & HISTORY FAMILY STUDIO 2030!\nVerwacht je aan een museaal speellandschap in de grote hal van het Museum. Laat je creativiteit de vrije loop aan de hand van uitnodigende materialen, of kom je uitleven met speelgoed voor alle leeftijden, ook de allerjongsten. Pik een kamishibai vertelsessie mee, snuister door de zinnenprikkelende bibliotheek, of kom gewoon wat rondhangen. Tot slot vind je aan een van de ATELIERtafels vast een uitdagende activiteit: gewoon aanschuiven is de boodschap.\nZin in meer? Schrijf je dan in voor de FESTIVAL SPECIALS! Vier donderdagen lang duiken we dieper in het thema van het Festival: de (bijna) 200ste verjaardag van Belgi\u00eb. Om voorbij die horizon te kijken, reizen we eerst terug naar de 18e eeuw, tijd van pruiken en chocola, van revoluties en uitvindingen. Het is in dit tijdperk dat de kiem van Belgi\u00eb begint.\nDonderdag 8.08 - DESIGN\nDonderdag 15.08 \u2013 GRAFIEK\nDonderdag 22.08 \u2013 WETENSCHAP\nDonderdag 29.08 \u2013 FEEST!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/nl\/activity\/family-studio-2030-festival-special-design","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012269"}},"place":{"id":61,"translations":{"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Brussels","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un fascinant voyage \u00e0 travers l'art et l'histoire. Venez fl\u00e2ner parmi les momies \u00e9gyptiennes et les silex pr\u00e9historiques, vous promener entre les verres anciens et prendre du recul pour mieux contempler d'impressionnantes tapisseries m\u00e9di\u00e9vales. Venez vous immerger dans le monde oriental en croisant des Bouddhas d'Asie et voyager jusqu'\u00e0 l'autre bout de la terre pour apercevoir une gigantesque statue de l'\u00eele de P\u00e2ques. La magnifique collection d'Art Nouveau vous attend au bout du voyage.\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s.\r\n\r\n\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s. ","description_print":"Le Mus\u00e9e du Cinquantenaire illustre les activit\u00e9s humaines et artistiques des cinq continents \u2013 hormis l\u2019Afrique noire \u2013, de la Pr\u00e9histoire \u00e0 nos jours. Les collections remplissent quatre b\u00e2timents et sont regroup\u00e9es en quatre d\u00e9partements: l\u2019Antiquit\u00e9, les civilisations extra-europ\u00e9ennes, l\u2019arch\u00e9ologie nationale et les arts d\u00e9coratifs europ\u00e9ens.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo de Arte e Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Ad\u00e9ntrate en este edificio hist\u00f3rico, uno de los mayores museos de B\u00e9lgica erigido por el anterior rey belga Leopoldo II. Descubre una gran cantidad de objetos desde la prehistoria hasta la antig\u00fcedad y de las artes aplicadas europeas hasta una amplia colecci\u00f3n de arte no europea. Explora todo, incluyendo las interesantes exposiciones temporales, conferencias y otras actividades. Desafortunadamente, la p\u00e1gina web no es tan amplia como para mostrar toda nuestra colecci\u00f3n, compuesta por miles de tesoros del arte y objetos hist\u00f3ricos. Sin embargo, esperamos que nos visites y disfrutes descubriendo o redescubriendo el inmenso patrimonio que gestionamos y exhibimos. De hecho, para nosotros el arte y la historia no son muerte y temas pasados, si no una viva y constante fuente de inspiraci\u00f3n y diversi\u00f3n.\r\n\r\nEl Museo de Arte e Historia es parte de los Museos Reales de Arte e Historia(MRAH), que incluye el Museo de Instrumentos Musicales(MIM), la Puerta de Hal y los Museos del Lejano Oriente(recientemente cerrado por renovaciones).\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Museum Kunst & Geschiedenis (KMKG)","address_street_name":"Jubelpark","address_street_number":"10","address_street_box":null,"email":"info@kmkg.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 10","address_line2":"1000 Brussel","description_web":"Maak een wereldreis door de geschiedenis! Wandel van prehistorische vuistbijlen naar Egyptische mummies. Snuistert tussen betoverende glas en zet een stap achteruit om de indrukwekkende Brusselse wandtapijten te bekijken. Ga de oosterse toer op tussen de Aziatische boeddha\u2019s en steek de Atlantische Oceaan over om Kuifjes \u2018beeldje met het gebroken oor\u2019. En dan is er nog de mooie collectie van Belgische art nouveau\u2026 U komt ogen en oren te kort!\r\n\r\nHet Museum Kunst & Geschiedenis maakt deel uit van de Koninklijke Musea voor Kunst en Geschiedenis (KMKG) die ook het Muziekinstrumentenmuseum (MIM), de Hallepoort en de Musea van het Verre Oosten (gesloten voor renovatie) bundelen.","description_print":"Het Jubelparkmuseum kan bogen op een imposante collectie kunstschatten en archeologische vondsten afkomstig uit de vijf continenten \u2013 met uitzondering van Zwart-Afrika \u2013 van de prehistorie tot op heden. De verzamelingen vullen vier gebouwen en zijn ingedeeld in evenveel departementen: Oudheid (het Nabije Oosten, Egypte, Griekenland, Rome en Byzantium), Niet-Europese Beschavingen (Islam, Azi\u00eb, Polynesi\u00eb & Micronesi\u00eb en Amerika), Nationale Archeologie en Europese Sierkunsten.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":12,"location":{"lat":50.83935087,"lon":4.3917188},"region":"brussels","last_updated_at":"2024-07-12T09:22:43+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":61,"translations":{"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Brussels","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un fascinant voyage \u00e0 travers l'art et l'histoire. Venez fl\u00e2ner parmi les momies \u00e9gyptiennes et les silex pr\u00e9historiques, vous promener entre les verres anciens et prendre du recul pour mieux contempler d'impressionnantes tapisseries m\u00e9di\u00e9vales. Venez vous immerger dans le monde oriental en croisant des Bouddhas d'Asie et voyager jusqu'\u00e0 l'autre bout de la terre pour apercevoir une gigantesque statue de l'\u00eele de P\u00e2ques. La magnifique collection d'Art Nouveau vous attend au bout du voyage.\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s.\r\n\r\n\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s. ","description_print":"Le Mus\u00e9e du Cinquantenaire illustre les activit\u00e9s humaines et artistiques des cinq continents \u2013 hormis l\u2019Afrique noire \u2013, de la Pr\u00e9histoire \u00e0 nos jours. Les collections remplissent quatre b\u00e2timents et sont regroup\u00e9es en quatre d\u00e9partements: l\u2019Antiquit\u00e9, les civilisations extra-europ\u00e9ennes, l\u2019arch\u00e9ologie nationale et les arts d\u00e9coratifs europ\u00e9ens.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo de Arte e Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Ad\u00e9ntrate en este edificio hist\u00f3rico, uno de los mayores museos de B\u00e9lgica erigido por el anterior rey belga Leopoldo II. Descubre una gran cantidad de objetos desde la prehistoria hasta la antig\u00fcedad y de las artes aplicadas europeas hasta una amplia colecci\u00f3n de arte no europea. Explora todo, incluyendo las interesantes exposiciones temporales, conferencias y otras actividades. Desafortunadamente, la p\u00e1gina web no es tan amplia como para mostrar toda nuestra colecci\u00f3n, compuesta por miles de tesoros del arte y objetos hist\u00f3ricos. Sin embargo, esperamos que nos visites y disfrutes descubriendo o redescubriendo el inmenso patrimonio que gestionamos y exhibimos. De hecho, para nosotros el arte y la historia no son muerte y temas pasados, si no una viva y constante fuente de inspiraci\u00f3n y diversi\u00f3n.\r\n\r\nEl Museo de Arte e Historia es parte de los Museos Reales de Arte e Historia(MRAH), que incluye el Museo de Instrumentos Musicales(MIM), la Puerta de Hal y los Museos del Lejano Oriente(recientemente cerrado por renovaciones).\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Museum Kunst & Geschiedenis (KMKG)","address_street_name":"Jubelpark","address_street_number":"10","address_street_box":null,"email":"info@kmkg.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 10","address_line2":"1000 Brussel","description_web":"Maak een wereldreis door de geschiedenis! Wandel van prehistorische vuistbijlen naar Egyptische mummies. Snuistert tussen betoverende glas en zet een stap achteruit om de indrukwekkende Brusselse wandtapijten te bekijken. Ga de oosterse toer op tussen de Aziatische boeddha\u2019s en steek de Atlantische Oceaan over om Kuifjes \u2018beeldje met het gebroken oor\u2019. En dan is er nog de mooie collectie van Belgische art nouveau\u2026 U komt ogen en oren te kort!\r\n\r\nHet Museum Kunst & Geschiedenis maakt deel uit van de Koninklijke Musea voor Kunst en Geschiedenis (KMKG) die ook het Muziekinstrumentenmuseum (MIM), de Hallepoort en de Musea van het Verre Oosten (gesloten voor renovatie) bundelen.","description_print":"Het Jubelparkmuseum kan bogen op een imposante collectie kunstschatten en archeologische vondsten afkomstig uit de vijf continenten \u2013 met uitzondering van Zwart-Afrika \u2013 van de prehistorie tot op heden. De verzamelingen vullen vier gebouwen en zijn ingedeeld in evenveel departementen: Oudheid (het Nabije Oosten, Egypte, Griekenland, Rome en Byzantium), Niet-Europese Beschavingen (Islam, Azi\u00eb, Polynesi\u00eb & Micronesi\u00eb en Amerika), Nationale Archeologie en Europese Sierkunsten.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":12,"location":{"lat":50.83935087,"lon":4.3917188},"last_updated_at":"2024-07-12T09:22:43+02:00","published_at":"2013-10-19T01:13:13+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/9120e161ac628890075788fb16e43cf85b275f39.jpg","width":1280,"height":853,"ratio":1.5,"oEmbed_height":853,"oEmbed_width":1280,"translations":{"de":{"title":"Art & History Family Studio 2030","copyright":null},"pt":{"title":"Art & History Family Studio 2030","copyright":null},"en":{"title":"Art & History Family Studio 2030","copyright":null},"it":{"title":"Art & History Family Studio 2030","copyright":null},"cn":{"title":"Art & History Family Studio 2030","copyright":null},"fr":{"title":"Art & History Family Studio 2030","copyright":null},"sp":{"title":"Art & History Family Studio 2030","copyright":null},"nl":{"title":"Art & History Family Studio 2030","copyright":null}}}],"dates":[{"day":"2024-08-08","doors":"14:00:00","start":"14:00:00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-08-15","doors":"14:00:00","start":"14:00:00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-08-22","doors":"14:00:00","start":"14:00:00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-08-29","doors":"14:00:00","start":"14:00:00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Kinder"},"en":{"name":"Children"},"it":