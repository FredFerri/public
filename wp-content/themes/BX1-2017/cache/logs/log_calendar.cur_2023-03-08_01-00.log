ice_id":230572,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.085803768349643},{"id":550726,"date_start":"2023-03-13","date_end":"2023-03-13","date_next":"2023-03-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[54],"translations":{"fr":["One man Show et humour"],"nl":["Onemanshow en humor"],"en":["One man show and comedy"],"de":["One Man Show & Comedy"],"it":["One man Show e comicit\u00e0"],"sp":["Espect\u00e1culo unipersonal y humor"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le live de Marie-Patrick","shortdescr":"\"Il vaut mieux trop que trop peu\" telle est la devise de Marie-Patrick du Colvert.\r\n\r\nVeuve \u00e9mancip\u00e9e et femme de prestance aussi gauche que provocante, a\u0300 mi-chemin entre Genevie\u0300ve de Fontenay et Tatie Danielle","longdescr":"\"Il vaut mieux trop que trop peu\" telle est la devise de Marie-Patrick du Colvert.\r\n\r\nVeuve \u00e9mancip\u00e9e et femme de prestance aussi gauche que provocante, a\u0300 mi-chemin entre Genevie\u0300ve de Fontenay et Tatie Danielle, Marie-Patrick a ve\u0301cu une vie de luxe et d'abondance mais ennuyeuse \u00e0 Rhode-Saint-Gene\u0300se. Lorsqu\u2019elle d\u00e9couvre les re\u0301seaux sociaux, Marie-Patrick revit en s\u2019exposant en vide\u0301o. Avec son avis tranche\u0301 sur de nombreux sujets de socie\u0301te\u0301, elle tente de trouver sa place sur le web en tant qu\u2019influenceuse et attirer des millions de followers pour \u00e9chapper \u00e0 sa r\u00e9alit\u00e9.\r\n\r\nMarie-Patrick re\u0301invente son monde et le no\u0302tre en explorant les interdits de sa nouvelle vie de personnalite\u0301 publique, avec ce petit grain de folie insolent qui la caracte\u0301rise. Ce soir, le champagne est au frais et Marie-Patrick vous attend pour son live en live sur sc\u00e8ne!","performers":"sur une id\u00e9e originale d'Evelyne Demaude\r\nMise en sc\u00e8ne: Patrice Thibaud et Patrick Chaboud","boxoffice_url":null,"website":"http:\/\/www.fourire.be","email":"reservations@fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 483 59 92 29","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550726"},"nl":{"name":"Le live de Marie-Patrick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fourire.be","email":"reservations@fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 483 59 92 29","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550726"},"en":{"name":"Le live de Marie-Patrick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fourire.be","email":"reservations@fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 483 59 92 29","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550726"},"de":{"name":"Le live de Marie-Patrick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fourire.be","email":"reservations@fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 483 59 92 29","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550726"},"it":{"name":"Le live de Marie-Patrick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fourire.be","email":"reservations@fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 483 59 92 29","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550726"},"sp":{"n