":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-24T13:05:11+01:00","published_at":"2022-11-24T12:17:47+01:00","backoffice_id":266126,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":543929,"date_start":"2023-01-22","date_end":"2023-01-22","date_next":"2023-01-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[3],"translations":{"fr":["Musique Contemporaine"],"nl":["Hedendaagse Muziek"],"en":["Contemporary music"],"de":["Zeitgen\u00f6ssische Musik"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Go\u00fbter du Karreveld : JenliSisters","shortdescr":"Les Jeunesses Musicales de Bruxelles vous convient \u00e0 un rendez-vous musical familial dans le cadre exceptionnel du Ch\u00e2teau du Karreveld ! Le temps d\u2019un apr\u00e8s-midi, familles, amis et artistes se retrouvent pour faire et \u00e9couter de la musique ensemble.","longdescr":"Les Jeunesses Musicales de Bruxelles vous convient \u00e0 un rendez-vous musical familial dans le cadre exceptionnel du Ch\u00e2teau du Karreveld ! Le temps d\u2019un apr\u00e8s-midi, familles, amis et artistes se retrouvent pour faire et \u00e9couter de la musique ensemble.\r\n\r\nMathilde et H\u00e9lo\u00efse, telles deux h\u00e9ro\u00efnes sorties tout droit d\u2019un film de Disney, nous emm\u00e8nent, au travers d\u2019un spectacle audio-visuel dont elles seules ont le secret, dans la for\u00eat enchant\u00e9e. Un parcours cont\u00e9 initiatique et tout en magie, jalonn\u00e9 d\u2019airs de dessins anim\u00e9s, de musique celtique, classique, pop, jazz et de leurs propres compositions.\r\n\r\nUne synergie entre l\u2019histoire cont\u00e9e, la musique et l\u2019image, la fiction et la r\u00e9alit\u00e9, un voyage dans l\u2019espace-temps qui exalte la cr\u00e9ativit\u00e9 et l\u2019imaginaire de l\u2019enfant, l\u2019initie \u00e0 la musique, le sensibilise \u00e0 la nature, aux th\u00e9matiques universelles, \u2026 produisant la sensation de faire partie int\u00e9grante du spectacle.\r\n\r\nMathilde (violon) et H\u00e9lo\u00efse (harpe) sont titulaires d\u2019un master du Conservatoire Royal de Bruxelles. Depuis, Mathilde a obtenu un master en musique traditionnelle irlandaise au DIT Conservatory of Music and Drama de Dublin, a dirig\u00e9 des ensembles d\u2019enfants et de jeunes et coordonn\u00e9 l\u2019Ensemble Est-Ouest qui produit notamment Pierre et le Loup avec Alex Vizorek. H\u00e9lo\u00efse est titulaire d\u2019un master soliste\/orchestre au Conservatoire Giuseppe Verdi di Milano et de l\u2019Agr\u00e9gation \u00e0 l\u2019IMEP (Namur).","performers":"H\u00e9lo\u00efse de Jenlis\r\nMathilde de Jenlis","boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/jenlisisters-chateau-du-karreveld\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543929"},"nl":{"name":"Go\u00fbter du Karreveld : JenliSisters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543929"},"en":{"name":"Go\u00fbter du Karreveld : JenliSisters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543929"},"de":{"name":"Go\u00fbter du Karreveld : JenliSisters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543929"},"it":{"name":"Go\u00fbter du Karreveld : JenliSisters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543929"},"sp":{"name":"Go\u00fbter du Karreveld : JenliSisters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543929"},"pt":{"name":"Go\u00fbter du Karreveld : JenliSisters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543929"},"cn":{"name":"Go\u00fbter du Karreveld : JenliSisters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543929"}},"place":{"id":2507,"translations":{"fr":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Le Karreveld n'est pas qu'un parc mais c'est aussi une \"ferme-ch\u00e2teau\" devenue un espace culturel au centre du parc entour\u00e9 d'arbres et d'un \u00e9tang.\r\n\r\nVous pourrez vous y promener, visiter une exposition, fl\u00e2ner le long des chemins en d\u00e9couvrant ces \u00e9co-syst\u00e8mes.\r\n\r\nAu coeur du parc, ce trouve une ancienne ferme-ch\u00e2teau devenu le lieu des c\u00e9r\u00e9monies officielles de mariages des Molenbeekois mais \u00e9galement un espace culturel accueillant des expositions, concerts, spectacles, march\u00e9 artisanal (March\u00e9 de No\u00ebl), ...","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Karreveldkasteel","address_street_name":"Jean de la Hoeselaan","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Jean de la Hoeselaan, 3","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"\r\nHet Karreveld is niet alleen een park, maar ook een \"kasteelboerderij\" die een culturele ruimte is geworden in het midden van het park, omringd door bomen en een vijver.\r\n\r\nU kunt er rondwandelen, een tentoonstelling bezoeken, over de paden wandelen en deze ecosystemen ontdekken.\r\n\r\nIn het hart van het park bevindt zich een voormalige boerderij-kasteel waar offici\u00eble huwelijksceremonies van de Molenbeekenaars plaatsvinden, maar ook een culturele ruimte waar tentoonstellingen, concerten, voorstellingen, een ambachtsmarkt (kerstmarkt), ... plaatsvinden.\r\n\r\nOm (opnieuw) ontdekt te word","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","descri