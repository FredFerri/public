d":263877,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":1},{"id":542673,"date_start":"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"\u00c0 la recherche des sources de la Woluwe \u00e0 Boitsfort","shortdescr":null,"longdescr":"Vous \u00eates-vous d\u00e9j\u00e0 demand\u00e9 d'o\u00f9 vient r\u00e9ellement l'eau de la Woluwe ? Lors de cette balade guid\u00e9e, nous vous invitons \u00e0 venir d\u00e9couvrir les sources de la Woluwe \u00e0 Watermael-Boitsfort en for\u00eat de Soignes, mais aussi les ruisseaux et les \u00e9tangs qu'elles alimentent, comme le Karregatbeek, le Vuylbeek et le Zwanewijdebeek, qui donnent naissance \u00e0 la Woluwe apr\u00e8s leur confluence dans l'\u00e9tang de Boitsfort.\r\nSans inscriptions (Journ\u00e9e de la for\u00eat de Soignes). D\u00e9but de la promenade aux stands sur la place derri\u00e8re la tribune principale. En cas de trop grand int\u00e9r\u00eat, la priorit\u00e9 sera donn\u00e9e aux premiers arriv\u00e9s.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coordinationsenne.be","email":"contact@coordinationsenne.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542673"},"nl":{"name":"Op zoek naar de bronnen van de Woluwe in Bosvoorde","shortdescr":null,"longdescr":"Heeft u zich ooit al afgevraagd waar het water van de Woluwe eigenlijk vandaan komt? Bij deze gegidste wandeling nodigen we u uit om de bronnen van de Woluwe in Watermaal-Bosvoorde in het Zoni\u00ebnwoud te komen ontdekken, maar ook de beekjes en de vijvers die ze voeden, zoals de Karregatbeek, de Vuilbeek en de Zwanewijdebeek, die de Woluwe doen ontstaan na hun samenvloeiing in de vijver van Bosvoorde. \r\nZonder inschrijving (Dag van het Zoni\u00ebnwoud). Start van de wandeling aan de standjes op het plein achter de hoofdtribune. In geval van teveel belangstelling wordt voorrang gegeven aan de eerst aanwezigen.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coordinatiezenne.be","email":"contact@coordinatiezenne.be","phone_contact":"+32 2 206 12 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542673"},"en":{"name":"Op zoek naar de bronnen van de Woluwe in Bosvoorde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542673"},"de":{"name":"Op zoek naar de bronnen van de Woluwe in Bosvoorde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542673"},"it":{"name":"Op zoek naar de bronnen van de Woluwe in Bosvoorde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542673"},"sp":{"name":"Op zoek naar de bronnen van de Woluwe in Bosvoorde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/vis