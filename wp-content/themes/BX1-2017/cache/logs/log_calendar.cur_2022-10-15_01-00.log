a, Het Paleis voor Schone Kunsten van Brussel, het Muziekinstrumentenmuseum en anderen.  \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Koninklijk Conservatorium van Brussel vzw","address_street_name":"Regentschapsstraat","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 2 213 41 10","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Regentschapsstraat","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Koninklijk Conservatorium van Brussel vzw","address_street_name":"Rue de la R\u00e9gence","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 2 213 41 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Koninklijk Conservatorium van Brussel vzw","address_street_name":"Rue de la R\u00e9gence","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 2 213 41 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Koninklijk Conservatorium van Brussel vzw","address_street_name":"Rue de la R\u00e9gence","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 2 213 41 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence","address_line2":"