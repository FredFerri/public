ation des R\u00eaveurs.\r\n\r\nOuverture des portes \u00e0 20h, entr\u00e9e 5euros payable sur place. Un chapeau circulera pendant les d\u00e9couvertes afin de soutenir chaque artiste.\r\n\r\nTu as toi aussi envie de tenter ta chance ? Inscris-toi !\r\n\r\nMusique : lesdecouvertes.musique@gmail.com","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lacompagniedesreveurs.com\/event","email":"administration@lacompagniedesreveurs.com","phone_contact":null,"phone_booking":"+32 485 20 93 83","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/527163.html"},"nl":{"name":"Les D\u00e9couvertes - Sc\u00e8nes ouvertes musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/527163.html"},"en":{"name":"Les D\u00e9couvertes - Sc\u00e8nes ouvertes musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/527163.html"},"de":{"name":"Les D\u00e9couvertes - Sc\u00e8nes ouvertes musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/527163.html"},"it":{"name":"Les D\u00e9couvertes - Sc\u00e8nes ouvertes musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/527163.html"},"sp":{"name":"Les D\u00e9couvertes - Sc\u00e8nes ouvertes musique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/527163.html"},"pt":{"name":"