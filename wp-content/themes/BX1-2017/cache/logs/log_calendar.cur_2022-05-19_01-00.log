9f3a.jpg","width":1542,"height":1026,"ratio":1.5,"translations":{"fr":{"title":"Visite \u00e0 la cit\u00e9-jardins Bouvier-Washer \u00e0 Kraainem","copyright":null},"nl":{"title":"Visite \u00e0 la cit\u00e9-jardins Bouvier-Washer \u00e0 Kraainem","copyright":null},"en":{"title":"Visite \u00e0 la cit\u00e9-jardins Bouvier-Washer \u00e0 Kraainem","copyright":null}}}],"dates":[{"day":"2022-05-22","doors":null,"start":"15:00:00","end":"16:30:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-04T03:35:50+02:00","published_at":"2022-05-03T12:38:43+02:00","backoffice_id":252982,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":528912,"date_start":"2022-05-22","date_end":"2022-05-22","date_next":"2022-05-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Centenaire des cit\u00e9s-jardins  : La Roue","shortdescr":"Festivit\u00e9s \u00e0 La Roue","longdescr":"En mai, nous c\u00e9l\u00e9brons le centenaire des cit\u00e9s-jardins de Bruxelles. \u00c0 Anderlecht, les trois cit\u00e9s-jardins seront c\u00e9l\u00e9br\u00e9s le week-end du 21 et 22 mai avec ce programme de la commune d'Anderlecht.\r\n\r\nProgramme 22.05 - La Roue - Ecole de La Roue (P21):\r\n\r\n14:00 > 15:30- Visite guid\u00e9e de la cit\u00e9-jardin et de l\u2019\u00e9cole Art D\u00e9co. Plus d'info? tourisme@anderlecht.brussels\r\n\r\n15:00 > 18:00: Animations, \u266b concerts de Ander Brass, spectacle Therese & Josephine - Ah mon amour, d\u00e9couverte de l\u2019\u00e9cole Art D\u00e9co P21, pr\u00e9sentation des projets du collectif de La Roue, visite d\u2019une maison r\u00e9nov\u00e9e par le Foyer Anderlechtois, \u00abJeugdjaren van Anderlechtenaren - verhalen uit Het Rad\u00bb: courts m\u00e9trages par De Swaene, Fedos Anderlecht et Beeldenstorm (NL)\r\n\r\n15:30 > 18:00: Pr\u00e9sentation de \u00ab1070 Stories - Histoires de La Roue\u00bb par Arno Boey\r\n+ Exposition \"\u00c7a roule\" par Julie Van Kerckhoven @ Wasserette Chauss\u00e9e de Mons 1139 Anderlecht\r\n\r\n\r\nO\u00f9? Ecole La Roue P21, rue Van Winghen 1, \u00e0 Anderlecht  \r\n\r\nNous vous invitons \u00e9galement dans les deux autres cit\u00e9s-jardins d\u2019Anderlecht: \r\n21.05: Moortebeek: https:\/\/agenda.brussels\/fr\/528888\/centenaire-des-cites-jardins-moortebeek\r\n21.05: Bon Air: https:\/\/agenda.brussels\/fr\/528906\/centenaire-des-cites-jardins-bon-air","performers":null,"boxoffice_url":null,"website":null,"email":"tourisme@anderlecht.brussels","phone_contact":"+32 2 526 83 51","phone_booking":"+32 2 526 83 65","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528912.html"},"nl":{"name":"100 jaar tuinwijken: het Rad","shortdescr":"Festiviteiten in Het Rad","longdescr":"In mei vieren we het honderdjarig bestaan van de Brusselse tuinwijken. In Anderlecht worden de drie tuinwijken tijdens het weekend van 21 en 22 mei gevierd met dit programma van Dienst Toerisme en de Nederlandstalige Cultuurdienst.van de Gemeente van Anderlecht.\r\n\r\nProgramma 22.05 - Het Rad - Ecole de La Roue (P21):\r\n\r\n14:00 > 15:30: Rondleiding door de tuinwijk en van  de Art Deco school. Meer info? toerisme@anderlecht.brussels\r\n\r\n15:30: voorstelling van \u201c1070 Stories \u2013 Verhalen van Het Rad\u201d door Arno Boey\r\n\r\n15:00 > 18:00: animaties, \u266b concerten Ander Brass, spektakel Therese & Josephine - Ah mon amour, bezoek de Art Deco school P21, voorstelling van de projecten van het collectief Het Rad, bezoek aan een huis dat door Anderlechtse Haard werd gerenoveerd, \u00abJeugdjaren van Anderlechtenaren - verhalen uit Het Rad\u00bb: kortfilms door De Swaene, Fedos Anderlecht en Beeldenstorm\r\n\r\n+ Expositie \"\u00c7a roule\" door Julie Van Kerckhoven @ Wasserette Bergensesteenweg 1139 Anderlecht\r\n \r\nWaar? School P21, Van Winghenstraat 1, Anderlecht  \r\n \r\nWe nodigen je ook graag uit in de twee andere Anderlechtse tuinwijken:\r\n21.05: Moortebeek: https:\/\/agenda.brussels\/nl\/528888\/100-jaar-tuinwijken-moortebeek \r\n21.05: Goede Lucht - Bon Air: https:\/\/agenda.brussels\/nl\/528906\/100-jaar-tuinwijken-goede-lucht","performers":null,"boxoffice_url":null,"website":null,"email":"toerisme@anderlecht.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528912.html"},"en":{"name":"100th anniversary of the Garden Cities : La Roue \/ Het Rad","shortdescr":"Festivities in La Roue \/ Het Rad","longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528912.html"},"de":{"name":"Centenaire des cit\u00e9s-jardins  : programme \u00e0 La Roue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528912.html"},"it":{"name":"Centenaire des cit\u00e9s-jardins  : programme \u00e0 La Roue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528912.html"},"sp":{"name":"Centenaire des cit\u00e9s-jardins  : programme \u00e0 La Roue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528912.html"},"pt":{"name":"Centenaire des cit\u00e9s-jardins  : programme \u00e0 La Roue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528912.html"},"cn":{"name":"Centenaire des cit\u00e9s-jardins  : programme \u00e0 La Roue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528912.html"}},"place":{"id":273619,"translations":{"fr":{"name":"Cit\u00e9-jardin La Roue","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Cit\u00e9-jardin La Roue","address_line2":"1070 Anderlecht","description_web":"La commune d\u2019Anderlecht compte 3 cit\u00e9s-jardins, ce qui la place en t\u00eate des communes bruxelloises en termes de quantit\u00e9. La Soci\u00e9t\u00e9 du Foyer Anderlechtois, constitu\u00e9e en 1907, a donc \u00e9t\u00e9 tr\u00e8s active dans cette commune du sud-ouest de la r\u00e9gion. La cit\u00e9 de la Roue est n\u00e9e pr\u00e9cocement puisque les premiers logements sortent de terre, dans les rues des Citoyens et des Colombophiles, en 1907-1908. Largement agrandie dans les ann\u00e9es 20, pour compter pr\u00e8s de 700 maisons, la cit\u00e9 de la Roue est abondamment pourvue de parcs et d\u2019espaces verts \u00e0 destination de la collectivit\u00e9. La plaine des Loisirs constitue l\u2019espace vert principal. L\u2019\u00e9glise Saint-Joseph se situe \u00e9galement sur un beau parc arbor\u00e9, \u00e0 l\u2019entr\u00e9e de la cit\u00e9.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Tuinwijk Het Rad","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Tuinwijk Het Rad","address_line2":"1070 Anderlecht","description_web":"De gemeente Anderlecht telt drie tuinwijken en staat hiermee op nummer \u00e9\u00e9n op de lijst van Brusselse gemeentes. De huisvestingsmaatschappij de Anderlechtse Haard werd opgericht in 1907 en was heel actief in deze gemeente in het zuidwesten van Brussel. Tuinwijk het Rad zag al vroeg het levenslicht. In 1907-1908 werden de eerste woningen opgetrokken in de Burgerstraat en de Duivenmelkersstraat. De wijk breidde in de jaren 20 fors uit tot bijna 700 huizen en is rijkelijk voorzien van parken en groene ruimtes voor de inwoners. Het Lustplein vormt daar de belangrijkste van. Ook de Sint-Jozefkerk is gelegen in een mooi bosrijk park aan de ingang van de wijk.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Roue Garden City","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"La Roue Garden City","address_line2":"1070 Anderlecht","description_web":"Anderlecht has three garden cities, which puts it first among Brussels\u2019 communes in terms of quantity. The Soci\u00e9t\u00e9 du Foyer Anderlectois housing association, formed in 1907, was very active in this commune in the west of the region. La Roue Garden City was built early, with the first properties erected in the rue des Citoyens and the rue des Colombophiles in 1907-1908. Broadly extended in the 1920s to number nearly 700 houses, La Roue Garden City is blessed with parks and green spaces. The recreation ground is the main green space. St Joseph\u2019s Church is also in a beautiful tree-filled park, at the entrance to the city. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Cit\u00e9-jardin La Roue","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Cit\u00e9-jardin La Roue","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Cit\u00e9-jardin La Roue","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Cit\u00e9-jardin La Roue","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Cit\u00e9-jardin La Roue","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Cit\u00e9-jardin La Roue","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Cit\u00e9-jardin La Roue","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Cit\u00e9-jardin La Roue","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Cit\u00e9-jardin La Roue","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"add