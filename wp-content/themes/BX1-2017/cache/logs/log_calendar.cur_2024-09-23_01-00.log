null,"virtual_visit":null,"visit_url":null},"sp":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"BRONKS ","address_street_name":"Varkensmarkt","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Brussel","address_line1":"Varkensmarkt, 15-17","address_line2":"1000 Brussel","description_web":"BRONKS is het Nederlandstalige theater voor een jong publiek in Brussel. Sedert  21 maart 2009 gevestigd in het opvallende gebouw ontworpen door MDMA (Martine De Maeseneer Architects) aan de Varkensmarkt, maakt en toont BRONKS bijzonder, relevant en kwaliteitsvol theater voor en met kinderen en jongeren. Het programma wordt samengesteld vanuit de wil om te verrassen, risico\u2019s te nemen, te confronteren en blijk te geven van intelligentie en humor, zowel in de eigen voorstellingen als in de diverse en doordachte gastprogrammatie. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Cen