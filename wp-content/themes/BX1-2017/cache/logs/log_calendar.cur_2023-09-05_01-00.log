tutions europ\u00e9ennes mais aussi par des entreprises, des ONG ou encore des repr\u00e9sentants de gouvernements \u00e9trangers, qui d\u00e9fendent leurs propres int\u00e9r\u00eats et cherchent \u00e0 influencer les d\u00e9cisions de l\u2019Union Europ\u00e9enne. Cette visite met en lumi\u00e8re le fonctionnement de ces professionnels aux bureaux tr\u00e8s discrets mais hautement politiques.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560982"},"sp":{"name":"Le quartier europ\u00e9en a ses lobbys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560982"},"nl":{"name":"Le quartier europ\u00e9en a ses lobbys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560982"}},"place":{"id":270166,"translations":{"de":{"name":"Au centre du rond-point Schuman","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Au centre du rond-point Schuman","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Au centre du rond-point Schuman","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Au centre du ron