"en":"Open the first, second, third, fourth and mondays of the month from 19:30 to 22:30"}}],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50006416,"date_start":"2024-01-29","date_end":"2024-06-10","date_next":"2024-02-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-13T01:02:29+01:00","published_at":"2024-01-24T10:34:58+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292973,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"sport","ranking":0.2462115368990136,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":74,"translations":{"de":"Sport","pt":null,"en":"Sport","it":"Sport","cn":null,"fr":"Sport","sp":"Deporte","nl":"Sport"}},"others":{"list":[167,159],"translations":{"de":["Traditioneller Sport","Sportliche Aktivit\u00e4t"],"pt":[null,null],"en":["Traditional sport","Sporting activity"],"it":["Sport tradizionali","Attivit\u00e0 sportive"],"cn":[null,null],"fr":["Sport traditionnel","Activit\u00e9 sportive"],"sp":["Deporte tradicional","Actividad deportiva"],"nl":["Volkssporten","Sportieve activiteit"]}}},"translations":{"de":{"name":"Kundalini Yoga","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/kundalini-yoga-2622?id_evenement=5975","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006416"},"pt":{"name":"Kundalini Yoga","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/kundalini-yoga-2622?id_evenement=5975","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006416"},"en":{"name":"Kundalini Yoga","shortdescr":"Ce yoga de l\u2019Energie et de la conscience est \u00e0 chaque s\u00e9ance diff\u00e9rent. Il explore les 84 postures que nous avons tou\u00b7tes faites dans le ventre maternel, associ\u00e9es \u00e0 de multiples techniques de respiration et de m\u00e9ditation, et \u00e0 l\u2019exploration sonore par les mantras.","longdescr":"Dans le corps humain, la Kundalini appara\u00eet comme un r\u00e9servoir d\u2019\u00e9nergie aux propri\u00e9t\u00e9s cr\u00e9atives. De la procr\u00e9ation \u00e0 l\u2019expression de l\u2019imaginaire, jusqu\u2019\u00e0 l\u2019union de la conscience individuelle avec la conscience universelle, l\u2019expression qu\u2019elle prend d\u00e9pend de la qualit\u00e9 de conscience que l\u2019on a de celle-ci.\n\nLe Kundalini Yoga (union) est l\u2019acte de faire converger les \u00e9l\u00e9ments dispers\u00e9s de la conscience ordinaire dans l\u2019unit\u00e9 de la vibration originelle.\n\nCe yoga de l\u2019Energie et de la conscience est \u00e0 chaque s\u00e9ance diff\u00e9rent. Il explore les 84 postures que nous avons tou\u00b7tes faites dans le ventre maternel, associ\u00e9es \u00e0 de multiples techniques de respiration et de m\u00e9ditation, et \u00e0 l\u2019exploration sonore par les mantras.\n\nCette pratique, \u00e0 la fois dynamique et int\u00e9rieure, aussi joyeuse que respectueuse de la philosophie du yoga et de ses racines profond\u00e9ment spirituelles, permet de d\u00e9conditionner les m\u00e9moires corporelles et d\u2019explorer notre conscience de ce qui se passe en nous, du moment pr\u00e9sent et de l\u2019infini possible.\n\nTenue souple recommand\u00e9e, les v\u00eatements de couleur blanche sont appr\u00e9ci\u00e9s mais pas obligatoires, coussin de m\u00e9ditation si vous en avez un pour votre confort. Les tapis sont fournis.\nPas de niveau pr\u00e9alable requis, classe unique.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/kundalini-yoga-2622?id_evenement=5975","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006416"},"it":{"name":"Kundalini Yoga","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/kundalini-yoga-2622?id_evenement=5975","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006416"},"cn":{"name":"Kundalini Yoga","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/kundalini-yoga-2622?id_evenement=5975","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006416"},"fr":{"name":"Kundalini Yoga","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/kundalini-yoga-2622?id_evenement=5975","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006416"},"sp":{"name":"Kundalini Yoga","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/kundalini-yoga-2622?id_evenement=5975","email":"reservations@tricoterie.be","phone_contact":"+32 2 53