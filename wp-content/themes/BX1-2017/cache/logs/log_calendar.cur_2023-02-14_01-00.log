"publication_state":"public","last_updated_at":"2023-02-11T00:35:32+01:00","published_at":"2022-10-14T11:16:15+02:00","backoffice_id":264153,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.3568829277518},{"id":549366,"date_start":"2023-01-13","date_end":"2023-02-26","date_next":"2023-02-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,27],"translations":{"fr":["Galeries d'art","Photographie"],"nl":["Galeries","Fotografie"],"en":["Art Galleries","Photography"],"de":["Kunstgalerien","Fotografie"],"it":["Gallerie d'arte","Fotografia"],"sp":["Galer\u00edas de arte","Fotograf\u00eda"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Herbarium par l'artiste photographe Anne Greuzat","shortdescr":"Come and discover Flowers a way you haven't done it yet!","longdescr":"Here is her words about her new work.\r\n\"Herbarium is the name of a series of photographs I started in 2020.\r\nThis period of confinement has reshaped my way of photographing. Nonetheless, the object of my research remains the same: it is the landscape as an object of contemplation and more particularly the natural landscape, untouched by human intervention.\r\n\r\nIn my previous series Rhizomes, the landscape represented was abundant - green undergrowth, luxuriant forests, rock faces - and its restitution implied that I immerse myself in this original nature.\r\n\r\nHerbarium is the antithesis of abundance, of profusion. Herbarium is on the side of denudation, of stripping down, of restraint. The multitude has given way to the individual. Each plant is isolated, extracted from its context and photographed on a white background, indoors, in a studio. The vastness of the landscape has given way to a more restricted, more confined universe. The distance between the lens and its subject has been reduced. Nevertheless, the intention, the aim is identical because the gaze, which was lost in the ramifications of trees and roots, is absorbed here in the contemplation of the details of a flower, its texture, its colors, its forms. The pleasure experienced then is of the same nature as that experienced in larger spaces. \"","performers":"We are thrilled to have you next Thursday and make you discover the work HERBARIUM by @anne.greuzat\r\nDelicate and subtile like the beginning of the New Year! Happy to show you !!","boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@me.com","phone_contact":"+32 474 86 42 45","phone_booking":"+32 474 86 42 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549366"},"nl":{"name":"Herbarium van Anne Greuzat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@me.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549366"},"en":{"name":"Herbarium by the photographer Anne Greuzat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@me.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549366"},"de":{"name":"Herbarium par l'artiste photographe Anne Greuzat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@me.com","phone_contact":null,"phone_booking":null,"