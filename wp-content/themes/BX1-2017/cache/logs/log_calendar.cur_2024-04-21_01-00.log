44+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":230072,"translations":{"de":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":"CULTURAL EVENTS SINCE 1986 \r\nAre you looking for fresh and creative incentive, team-building, or social programs for your clients? Contact us and fi nd out what\u2019s on the \u201cmenu\u201d: \r\n\u2022  Unforgettable rallies: CULTURAL CITY GAME\r\nNEW! \u201cBloody inquiry, become one of our most famous detective\u201d On foot, tuk tuk,... \r\n\u2022  Dine Around (3 courses in 3 differents venues)\r\n\u2022  Private Castles for exclusive events & atmosphere and exclusive tours\r\n\u2022  Thematic Diner: Ex: Art Nouveau, possibilities of : costumed guides, live band, a Jacques Brel singer,... \r\n\u2022  Custom-tailored itineraires: Art Nouveau, Trendy Antwerp, Brel and Brussels by night, Beer and chocolate, another Bruges, Simenon and Maigret, Fashion workshops, design, Brussels is there for you, the Gay Brussels, \u201cWho killed Sir the Count?\u201d, Sustainable Brussels.\r\n\r\nIn Brussels and all Belgium. Our programs are exclusive and interactive.\r\nOur team: \r\n\u2022  2 specialists who ensure that your program meets your objectives and exceeds your clients expectations. \r\n\u2022  100 multilingual guides, entertainers, coordinators, hotesses, ... specialists in Belgium\u2019s off  the beaten path treasures. \r\n\u2022  We answer 7 days a week \r\n\u2022 Our aim: to live art as an \u201cArt de Vivre\u201d ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Itin\u0