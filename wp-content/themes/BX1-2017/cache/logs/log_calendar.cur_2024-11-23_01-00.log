ll,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002612"},"en":{"name":"Petite enfance de Bernadette Gervais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002612"},"it":{"name":"Une exposition Petite enfance de Bernadette Gervais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002612"},"cn":{"name":"Une exposition Petite enfance de Bernadette Gervais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002612"},"fr":{"name":"Petite enfance de Bernadette Gervais","shortdescr":"Venez en famille d\u00e9couvrir l\u2019univers artistique de Bernadette Gervais, autrice-illustratrice belge, qui a \u00e9tudi\u00e9 aux Beaux-Arts de Mons et vit \u00e0 Bruxelles.","longdescr":"Venez en famille d\u00e9couvrir l\u2019univers artistique de Bernadette Gervais, autrice-illustratrice belge, qui a \u00e9tudi\u00e9 aux Beaux-Arts de Mons et vit \u00e0 Bruxelles.\n\nPassionn\u00e9e de photographie, de livres anciens pour enfants et grande amoureuse de la nature, elle a recours \u00e0 des techniques tr\u00e8s diverses comme le pochoir et la gravure, adapt\u00e9es au concept de chacun de ses ouvrages. Son travail n\u2019en est pas moins tr\u00e8s reconnaissable, dans ses repr\u00e9sentations \u00e0 la fois simples et sophistiqu\u00e9es qui enchantent le r\u00e9el. Elle a publi\u00e9 plus d\u2019une centaine d\u2019ouvrages jeunesse, des livres dr\u00f4les, des livres-objets, toujours inventifs et parfaitement adapt\u00e9s aux enfants.\n\nL\u2019exposition est extr\u00eamement ludique et les enfants, ainsi que les b\u00e9b\u00e9s, auront l\u2019occasion de jouer avec des puzzles, de pratiquer la p\u00eache, de dessiner.","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002612"},"sp":{"name":"Une exposition Petite enfance de Bernadette Gervais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002612"},"nl":{"name":"Petite enfance de Bernadette Gervais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaison1080hethuis.be\/","email":"contact@lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002612"}},"place":{"id":243578,"translations":{"de":{"name":"Maison des Cultures et de la coh\u00e9sion sociale de Molenbeek (MCCS)","address_street_name":"Rue Mommaerts","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city"