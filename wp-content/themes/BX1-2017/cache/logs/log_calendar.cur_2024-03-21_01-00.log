}},"others":{}},"translations":{"de":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006180"},"pt":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006180"},"en":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006180"},"it":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006180"},"cn":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006180"},"fr":{"name":"La maison Hannon","shortdescr":null,"longdescr":"La Maison Hannon est un des chefs-d\u2019\u0153uvre de l\u2019Art nouveau \u00e0 Bruxelles, unissant l\u2019art nouveau belge \u00e0 l\u2019art nouveau fran\u00e7ais, dans un univers symboliste et onirique. Construite sur l\u2019angle des avenues Brugmann et de la Jonction \u00e0 Saint-Gilles, elle est command\u00e9e par le couple Hannon dont elle porte le nom, \u00e0 leur ami architecte Jules Brunfaut en 1902. La maison refl\u00e8te les go\u00fbts de Marie pour la botanique et d\u2019\u00c9douard pour la po\u00e9sie, l\u2019Antiquit\u00e9 et la technologie. Les vastes fresques de Paul Baudouin (1844-1931), disciple du Fran\u00e7ais Puvis de Chavannes, se d\u00e9ploient telles des tapisseries dans la cage d\u2019escalier et la salle de r\u00e9ception. La maison est encore en r\u00e9novation mais vous aurez l'occasion de visiter les parties d\u00e9j\u00e0 restaur\u00e9es ainsi que l'exposition \u00ab Art(s) Nouveau(x) Belge(s) \u00bb qui pr\u00e9sente l\u2019art nouveau dans sa pluralit\u00e9, au travers d\u2019\u0153uvres diverses issues des plus grandes collections belges...\n\nLe prix de la visite comprend le ticket d'entr\u00e9e (14\u20ac). Ce montant permet de participer en partie aux travaux de restauration du lieu.\n\nLa visite guid\u00e9e dure 1h10 heure pour vister la maison et l'exposition.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006180"},"sp":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006180"},"nl":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006180"}},"place":{"id":244861,"translations":{"de":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"Edouard Hannon, Ingenieur der Gesellschaft Solvay und einer der Vertreter der industriellen Bourgeoisie, erwarb 1902 ein Grundst\u00fcck an der Avenue Brugman und beauftragte den Architekten Jules Brunfaut mit dem Bau eines prachtvollen Herrenhauses im Jugendstil.\r\n\r\nJules Brunfaut z\u00e4hlte bis dato nicht zu den Jugendstil-Architekten. Er bediente sich dieses Stils lediglich, um seinem Freund und Gesch\u00e4ftspartner einen Gefallen zu tun. 1903, als sich der Jugendstil auch international durchgesetzt hatte, wagte er sich an neue Stilelemente heran: Ihm sind die Fenster im Tiffany-Stil zu verdanken. Und es wird deutlich, wer Brunfauts Vorbilder waren: Victor Horta und Octave van Rijsselberghe (der Architekt des H\u00f4tel Otlet und H\u00f4tel de Brouck\u00e8re).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison Hannon","address_street_name":"Verbindingslaan","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Verbindingslaan, 1","address_line2":"1060 Saint-Gilles","description_web":"The Maison Hannon, on the corner of Avenue Brugmann and Avenue de la Jonction, was built in 1902, at the request of the couple Marie and \u00c9douard Hannon, by their friend, the architect Jules Brunfaut. Conceived as a symbolist and dreamlike universe, the house is one of the masterpieces of art nouveau in Brussels, a union of Belgian and French art of the time. \r\nJules Brunfaut, unfamiliar with the new style, was inspired by other architects' houses, such as those of Victor Horta (personal house, Tassel and Wessinger hotels), Ernest Bl\u00e9rot (personal house, now destroyed) and Octave Van Rysselbeghe and Henry Van de Velde (Otlet hotel). \r\nCombining the beaux-arts style with that of modernity, or art nouveau at that period, the Maison Hannon is a singular work, an intimate and personal house, bringing together the tastes and passions of its commissioners. \r\n\r\nThe Maison Hannon will open its doors to the public on June 1, 2023, as a house museum. ","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=089B0E9A-DB73-AE2D-92E9-879659B7E80B&lg=en","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"La Maison Hannon, \u00e0 l\u2019angle des avenues Brugmann et de la Jonction, a \u00e9t\u00e9 construite en 1902, \u00e0 la demande du couple Marie et \u00c9douard Hannon, par leur ami l\u2019architecte Jules Brunfaut. Con\u00e7ue comme univers symboliste et onirique, la maison est un des chefs-d\u2019\u0153uvre de l\u2019art nouveau \u00e0 Bruxelles, union de l\u2019art belge et de l\u2019art fran\u00e7ais de l\u2019\u00e9poque. \r\n\r\nJules Brunfaut, peu familier au style nouveau, s\u2019inspirera d\u2019autres maisons d\u2019architectes de l\u2019\u00e9poque, tel que celles de Victor Horta (maison personnelle, h\u00f4tels Tassel et Wessinger), d\u2019Ernest Bl\u00e9rot (maison personnelle, aujourd\u2019hui d\u00e9truite) et d\u2019Octave Van Rysselbeghe et Henry Van de Velde (h\u00f4tel Otlet). \r\n\r\nAlliant style beaux-arts \u00e0 celui de la modernit\u00e9, soit l\u2019art nouveau \u00e0 l\u2019\u00e9poque, la Maison Hannon est une \u0153uvre singuli\u00e8re, une maison intime et personnelle, r\u00e9unissant les go\u00fbts et passions de ses commanditaires. \r\n\r\nLa Maison Hannon ouvre ses portes au public le 1er juin 2023, en tant que maison-mus\u00e9e.\r\n","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=089B0E9A-DB73-AE2D-92E9-879659B7E80B&lg=fr","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Maison Hannon","address_street_name":"Verbindingslaan","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Verbindingslaan, 1","address_line2":"1060 Sint-Gillis","description_web":"Het Maison Hannon werd in 1902 gebouwd op de hoek van de Brugmannlaan en de Verbindingslaan in Sint-Gillis door de architect Jules Brunfaut op verzoek van het echtpaar Marie en \u00c9douard Hannon. Het huis, opgevat als een droomachtig, symbolistische omsloten wereld, is een van de meesterwerken van de Brusselse art nouveau, een vereniging van Belgische en Franse kunst uit die tijd.\r\n\r\nJules Brunfaut, onbekend met de nouveau-stijl, liet zich inspireren door de huizen van andere architecten uit die tijd, zoals die van Victor Horta (persoonlijk huis, hotels Tassel en Wessinger), Ernest Bl\u00e9rot (persoonlijk huis, nu vernietigd) en Octave Van Rysselbeghe en Henry Van de Velde (hotel Otlet). \r\nHet Maison Hannon combineert de Beaux-Arts stijl met die van de moderniteit, de toenmalige art nouveau, en is een uniek werk, een intiem en persoonlijk huis dat de smaak en de passies van zijn opdrachtgevers samenbrengt. \r\n\r\nHet Maison Hannon zal op 1 juni 2023 de deuren voor het publiek openen als huis-museum.","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=089B0E9A-DB73-AE2D-92E9-879659B7E80B&lg=nl","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[6,7],"translations":{"de":["Chatelain\/Bailli","Saint-Gilles Zentrum"],"pt":[null,null],"en":["Chatelain\/Bailli","Saint-Gilles Centre"],"it":["Chatelain\/Bailli","Saint-Gilles Centre"],"cn":[null,null],"fr":["Chatelain\/Bailli","Saint-Gilles Centre"],"sp":["Ch\u00e2telain\/Bailli","Saint-Gilles Centre"],"nl":["Kasteleinswijk\/Baljuw","Sint-Gillis centrum"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":7146,"location":{"lat":50.820883,"lon":4.3522286},"region":"brussels","last_updated_at":"2023-09-21T14:32:39+02:00","published_at":"2013-10-19T01:21:40+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36946,"location":{"lat":50.84145283,"lon":4.35976257},"last_updated_at":"2023-06-08T12:25:28+02:00","published_at":"2021-07-23T14:48:31+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/e7a4aa6de24ec5f7a3dfa1b12816421d392048df.jpeg","width":3024,"height":4032,"ratio":0.75,"oEmbed_height":4032,"oEmbed_width":3024,"translations":{"de":{"title":"La maison Hannon","copyright":null},"pt":{"title":"La maison Hannon","copyright":null},"en":{"title":"La maison Hannon","copyright":null},"it":{"title":"La maison Hannon","copyright":null},"cn":{"title":"La maison Hannon","copyright":null},"fr":{"title":"La maison Hannon","copyright":null},"sp":{"title":"La maison Hannon","copyright":null},"nl":{"title":"La maison Hannon","copyright":null}}}],"dates":[{"day":"2024-03-31","doors":null,"start":"09:00:00","end":"10:10:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-04-07","doors":null,"start":"09:00:00","end":"10:10:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-04-28","doors":null,"start":"09:00:00","end":"10:10:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":24}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50001408,"date_start":"2023-09-24","date_end":"2024-06-16","date_next":"2024-03-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-20T17:15:01+01:00","published_at":"2023-08-28T13:59:42+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284079,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.15529694517976908,"languages":{"spoken":["fr","de","en","nl"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[99],"translations":{"de":["Gastronomie"],"pt":[null],"en":["Gastronomy"],"it":["Cucina"],"cn":[null],"fr":["Gastronomie"],"sp":["Gastronom\u00eda"],"nl":["Gastronomie"]}}},"translations":{"de":{"name":"The Dominican Exclusive Sunday Brunch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/thedominican.be\/fr","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":"+32 2 203 08 08","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001408"},"pt":{"name":"The Dominican Exclusive Sunday Brunch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/thedominican.be\/fr","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":"+32 2 203 08 08","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001408"},"en":{"name":"The Dominican Exclusive Sunday Brunch","shortdescr":"Discover The Dominican Exclusive Sunday Brunch every month! Enjoy a luxurious brunch with friends and family. ","longdescr":"Unforgettable moments await, reserve now and be part of this remarkable event.\nAt The Dominican, there is a unique brunch experience to enjoy an extensive buffet of delicious dishes and all-inclusive drinks. Whether there is a special occasion to celebrate or simply want to enjoy a relaxing Sunday afternoon, brunch is the perfect choice.\n\nIndulge and enjoy a selection of culinary delights. All this is surrounded by an exclusive ambiance and atmospheric live music, completing the overall experience. The brunch is also kid-friendly, with animated entertainment to keep the little ones occupied, making it a fun experience for the whole family.\nThe Dominican wants brunch to be a special occasion, a time to relax, enjoy and create great memories.\n\nThe price for The Dominican Exclusive Brunch is 75 euros per person, which includes an extensive sweet and savory buffet and includes all drinks. Upon arrival you can enjoy a glass of bubbly and during the brunch there will also be 3 cocktails, fresh juices, wines, beers, water, soft drinks, coffee and tea. There is a 50% discount for children under the age of 12 so that they too can enjoy this special experience.\n\nDon't wait any longer and experience an unforgettable brunch together at The Dominican. Book now and enjoy delicious food, excellent service and a warm atmosphere that will linger long after.","performers":null,"boxoffice_url":null,"website":"https:\/\/thedominican.be\/exclusive-sunday-brunch","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":"+32 2 203 08 08","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001408"},"it":{"name":"The Dominican Exclusive Sunday Brunch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/thedominican.be\/fr","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":"+32 2 203 08 08","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001408"},"cn":{"name":"The Dominican Exclusive Sunday Brunch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/thedominican.be\/fr","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":"+32 2 203 08 08","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001408"},"fr":{"name":"The Dominican Brunch exclusif du dimanche","shortdescr":"D\u00e9couvrez chaque mois le Brunch exclusif du dimanche au The Dominican ! Venez profiter de brunch luxueux avec vos amis et votre famille. ","longdescr":"Au The Dominican, nous vous offrons une exp\u00e9rience de brunch unique, vous permettant de savourer un buffet de d\u00e9licieux plats \u00e9labor\u00e9s par notre chef talentueux. Que vous c\u00e9l\u00e9briez une occasion sp\u00e9ciale ou que vous souhaitiez simplement profiter d'un dimanche apr\u00e8s-midi d\u00e9tendu, notre brunch est le choix id\u00e9al.\n\nLaissez vos papilles gustatives \u00eatre choy\u00e9es avec une s\u00e9lection de d\u00e9lices culinaires. Pendant que vous d\u00e9gustez votre repas, plongez dans une ambiance exclusive accom-pagn\u00e9e de musique live, contribuant \u00e0 l'exp\u00e9rience globale. Notre brunch est \u00e9gale-ment adapt\u00e9 aux enfants, avec des animations pour divertir les plus petits, offrant ainsi une exp\u00e9rience agr\u00e9able pour toute la famille.\n\nAu The Dominican, nous croyons que le brunch doit \u00eatre une occasion sp\u00e9ciale, un moment pour se d\u00e9tendre, profiter et cr\u00e9er des souvenirs pr\u00e9cieux.\nLe prix du Brunch exclusif du The Dominican est de 75 euros par personne, comprenant un vaste choix de mets sucr\u00e9s et sal\u00e9s, ainsi que toutes les boissons \u00e0 volont\u00e9. \u00c0 votre arriv\u00e9e, vous pourrez d\u00e9guster une coupe de bulles, et tout au long du brunch, nous servons \u00e9galement 3 cocktails, des jus frais, des vins, des bi\u00e8res, de l'eau, des boissons non alcoolis\u00e9es, du caf\u00e9 et du th\u00e9. Les enfants jusqu'\u00e0 12 ans b\u00e9n\u00e9ficient d'u-ne r\u00e9duction de 50 %, afin qu'ils puissent eux aussi profiter de cette exp\u00e9rience excep-tionnelle.\n\nN'attendez plus et rejoignez-nous pour un brunch inoubliable au The Dominican. R\u00e9servez votre table et laissez-nous vous r\u00e9galer avec une cuisine d\u00e9licieuse, un service excellent et une atmosph\u00e8re chaleureuse qui restera grav\u00e9e dans vos souvenirs pen-dant de nombreuses ann\u00e9es.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/thedominican.be\/fr","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":"+32 2 203 08 08","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001408"},"sp":{"name":"The Dominican Exclusive Sunday Brunch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/thedominican.be\/fr","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":"+32 2 203 08 08","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001408"},"nl":{"name":"The Dominican Exclusieve zondagbrunch","shortdescr":"Ontdek iedere maand The Dominican Exclusive Sunday Brunch! Geniet van een luxueuze brunch met vrienden en familie.","longdescr":"Er staan je onvergetelijke momenten te wachten, reserveer nu en maak deel uit van dit bijzondere evenement.\nBij The Dominican is er een unieke brunchervaring om te genieten van een uitgebreid buffet met heerlijke gerechten en dranken all-inclusive. Of er nu een speciale gelegenheid te vieren is of simpelweg wilt genieten van een ontspannen zondagmiddag, dan is brunchen de perfecte keuze.\n\nVerwen en geniet van een selectie van culinaire hoogstandjes. Dit alles wordt omringd door een exclusieve ambiance en sfeervolle livemuziek, wat de algehele ervaring compleet maakt. De brunch is ook kindvriendelijk, met geanimeerd entertainment om de kleintjes bezig te houden, waardoor het een leuke ervaring wordt voor het hele gezin.\n\nThe Dominican wil dat brunchen een speciale gelegenheid is, een moment om te ontspannen, te genieten en mooie herinneringen te cre\u00ebren.\nDe prijs voor The Dominican Exclusive Brunch is 75 euro per persoon, inclusief een uitgebreid zoet en hartig buffet en inclusief alle drankjes. Bij aankomst kun je genieten van een glas bubbels en tijdens de brunch worden er ook 3 cocktails, verse sappen, wijnen, bieren, water, frisdranken, koffie en thee geserveerd. Voor kinderen onder de 12 jaar is er een korting van 50%, zodat ook zij kunnen genieten van deze speciale ervaring.\n\nWacht niet langer en beleef samen een onvergetelijke brunch bij The Dominican. Reserveer nu en geniet van heerlijk eten, uitstekende service en een warme sfeer die nog lang zal nazinderen.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/thedominican.be\/nl","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":"+32 2 203 08 08","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001408"}},"place":{"id":50000281,"translations":{"de":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":"The Dominican, first member of Design Hotels\u2122 in Belgium, is a destination for elegance in the centre of Brussels. Situated behind the theatre La Monnaie, off Grand Place, its 150 stylish rooms, 3 multifunctional meeting rooms, private courtyard and animated Lounge Bar combine to ensure indulgent hospitality.\nThe award winning architects of FG Stijl and LENS\u00ba ASS, have created an eclectic mix of design in both the interior and exterior, resulting in an array of new styles and experiences. The rich history of the location was a source of inspiration in the exclusive design of The Dominican, mainly the Dominican Abbey which occupied the site during the 15th century. Home to famous French painter Jacques-Louis David in the 19th century, his spirit is preserved in the original facade of his abode, which is today seamlessly integrated into the new building that houses the hotel.\nRooms\nThe 150 guestrooms and suites \u2013 everyone with an individual look \u2013 are located around a quiet courtyard and have a rich blend of contemporary design and luxurious  textiles, offering quiet comfort in a cloister-like setting.\nFood and Drinks at The Dominican\nThe Grand Lounge is located in the heart of the building adjacent to the inner courtyard. Guests in the Grand Lounge are offered lunch and dinner in an intimate setting. The Grand Lounge exudes design and the harmony of high ceilings, capacious windows, natural lighting, metal work, and an innovative menu transforms it into both a lounge and a bar. In warmer weather dining is available in the inner courtyard.\nThe Lounge Bar is a combination of a traditional caf\u00e9 with a lounge atmosphere. Offering cutting-edge interior design, inventive drinks and an a la carte menu, this bar is designed to attract a style-conscious clientele of hotel guests as well the local in-crowd. The grandiose windows and soaring ceilings offer a surprisingly intimate setting.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":"L\u2019h\u00f4tel The Dominican est une destination d\u2019\u00e9l\u00e9gance au centre de Bruxelles. Situ\u00e9 derri\u00e8re le th\u00e9\u00e2tre de La Monnaie, en bas de la Grand-Place, notre h\u00f4tel design bruxellois offre d\u2019\u00e9l\u00e9gantes chambres non-fumeurs, une cour int\u00e9rieure priv\u00e9e et un Grand Lounge tonique.\nTous ces \u00e9l\u00e9ments se compl\u00e8tent pour offrir une hospitalit\u00e9 informelle. Les architectes prim\u00e9s de FG Stijl ont cr\u00e9\u00e9 un m\u00e9lange \u00e9clectique, tant \u00e0 l\u2019int\u00e9rieur qu\u2019\u00e0 l\u2019ext\u00e9rieur, ce qui se traduit par une palette de nouveaux styles et exp\u00e9riences.\nL\u2019identit\u00e9 historique de cet emplacement fut aussi la source d\u2019inspiration de l\u2019architecture de l\u2019h\u00f4tel, principalement l\u2019Abbaye Dominicaine qui occupait ce lieu au 15\u00e8me si\u00e8cle. Maison du peintre Fran\u00e7ais Jacques-Louis David au 19\u00e8me si\u00e8cle, son esprit et sa cr\u00e9ativit\u00e9 sont pr\u00e9serv\u00e9s dans la fa\u00e7ade originelle, aujourd\u2019hui enti\u00e8rement int\u00e9gr\u00e9e au b\u00e2timent principal o\u00f9 se trouve l\u2019h\u00f4tel.\nChambres\nLes 150 chambres et suites \u2013 chacune ayant un design singulier \u2013 se composent d\u2019une riche combinaison de design contemporain et textiles luxueux, offrant un confort in\u00e9gal\u00e9.\nLe concept derri\u00e8re le design de chacune de nos chambres est d\u2019offrir l\u2019opportunit\u00e9 de s\u2019\u00e9chapper de la ville pour se retrouver dans une oasis paisible.\nNos chambres luxurieuses ont une vue de La Monnaie d\u2019un c\u00f4t\u00e9 et de notre apaisant Courtyard de l\u2019autre. La cl\u00e9 pour se relaxer au Dominican est de se sentir chez soi. Toutes nos chambres sont ainsi admirablement d\u00e9cor\u00e9es et \u00e9quip\u00e9es de tous les agr\u00e9ments modernes afin de cr\u00e9er une sensation de chez-soi loin de son domicile. Offrant un d\u00e9cor paisible compos\u00e9 de somptueux mat\u00e9riaux, de couleurs chaudes formant un ensemble \u00e9quilibr\u00e9, nos chambres repr\u00e9sentent un sanctuaire luxueux en plein centre de la ville.\nFood and Drinks at The Dominican\nLes volumineux plafonds, les hautes fen\u00eatres, l\u2019\u00e9clairage naturel et l\u2019ouvrage m\u00e9tallique admirablement cisel\u00e9 font du Grand Lounge un cadre \u00e9l\u00e9gant, id\u00e9al pour un repas romantique ou une r\u00e9union professionnelle. Notre menu cr\u00e9atif et notre vaste carte de boissons r\u00e9pondront \u00e0 tous les go\u00fbts. Par temps chaud, nos invit\u00e9s peuvent profiter d\u2019un d\u00eener \u00ab al fresco \u00bb dans la cour centrale.\nLe Lounge Bar de l\u2019h\u00f4tel The Dominican allie parfaitement l\u2019atmosph\u00e8re traditionnelle d\u2019un caf\u00e9 et le confort douillet d\u2019un salon \u00e9l\u00e9gant. Au Lounge Bar, vous trouverez un design int\u00e9rieur sophistiqu\u00e9, des boissons inventives et un menu \u00e0 la carte.","description_print":null,"booking_url":null,"sort_order":"The Dominican","virtual_visit":null,"visit_url":null},"sp":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":"The Dominican, dat in alles een Brusselse sfeer uitademt, ligt aan de Leopoldstraat, vlak achter de Muntschouwburg. Dit top hotel in Brussel laat haar prachtige maar vooral unieke ligging en de geschiedenis van het gebouw goed tot zijn recht komen en combineert tegelijkertijd uitzonderlijk design met buitengewoon comfort.\nDe openbare ruimten en de kamers zijn zorgvuldig vormgegeven en werden ontworpen door het gerenommeerde Nederlands ontwerpersduo FG Stijl. Colin Finnegan en Gerard Glintmeijer van FG Stijl hebben in 2005 de prestigieuze \u201cPrix Villegiature Paris\u201d gewonnen in de categorie Best Interior Design. De overweldigende galerij van het hotel is een duidelijke verwijzing naar het dominicaanse klooster dat hier in de vijftiende eeuw stond. De bekende Franse schilder Jacques-Louis David heeft op deze plek ook nog een tijdje gewoond en gewerkt. De originele gevel van zijn huis is door het Belgische architectenbureau Lens Ass Architects opgenomen als onderdeel van het nieuwe gebouw.\nDe 150 kamers en suites \u2013 ieder met hun eigen uitstraling \u2013 liggen rondom een rustige binnenplaats. Ze kregen een rijke combinatie van hedendaags design en luxe stoffering die rust en comfort biedt in een kloosterachtige omgeving.\nEten en drinken bij The Dominican\nDe Grand Lounge ligt in het midden van het gebouw naast de binnenplaats. Hier kunnen de gasten lunchen en dineren in een intieme omgeving. De Grand Lounge straalt voor de volle 100% design uit. De harmonie tussen de hoge plafonds, de grote raampartijen, het natuurlijk licht, het metaalwerk en de vernieuwende menukaart maken van de Grand Lounge zowel een lounge als een bar. Bij mooi weer is het ook mogelijk om buiten te dineren.\nDe Lounge bar is een combinatie van een traditioneel caf\u00e9 met een loungesfeer. Met zijn hotspot interieur, creatieve drankjes en \u00e0 la carte menu trekt deze bar een client\u00e8le van stijlbewuste hotelgasten maar ook de plaatselijke jetset. De enorme raampartijen en de hoge plafonds cre\u00ebren een verrassend intieme omgeving.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":41024,"location":{"lat":50.8492677,"lon":4.3547615},"region":"brussels","last_updated_at":"2024-01-29T11:53:26+01:00","published_at":"2023-07-31T09:16:27+02:00","import_origin":"crm","external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":50000281,"translations":{"de":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"The Dominican","address_street_name":"Rue L\u00e9opold ","address_street_number":"9-15","address_street_box":null,"email":"info@thedominican.carlton.be","website":"https:\/\/www.thedominican.be\/","phone_contact":"+32 2 203 08 08","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue L\u00e9opold , 9-15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":nu