'Art De Coene et le parterre de roses est magnifique. Les nouveaux propri\u00e9taires viennent d'y installer leur galerie de mobilier contemporain Maniera. ","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/hotel-danckaert-villa-dewin","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008032"},"sp":{"name":"H\u00f4tel Danckaert - Villa Dewin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/hotel-danckaert-villa-dewin","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008032"},"nl":{"name":"H\u00f4tel Danckaert - Villa Dewin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/hotel-danckaert-villa-dewin","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008032"}},"place":{"last_updated_at":"2024-03-05T09:46:28+01:00","published_at":"2024-03-05T09:46:27+01:00","id":50001268,"translations":{"de":{"name":"H\u00f4tel Danckaert - Villa Dewin","address_street_name":null,"address_street_number":"33","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"H\u00f4tel Danckaert - Villa Dewin","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel Danckaert - Villa Dewin","address_street_name":null,"address_street_number":"33","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1