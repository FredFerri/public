l,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/nocturnes.brussels\/","email":"info@brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006671"},"en":{"name":"Nocturnes","shortdescr":"Each Thursday, from 13 March to 24 April, a different set of Brussels museums open exceptionally between 6PM \u2013 10PM, for only \u20ac4 or \u20ac7 per visit.\n","longdescr":"With a total of 48 unique museums to visit! \n\nBesides the wonderful collections and exhibitions, you can also look forward to lots of extra activities: original guided tours, behind-the-scenes visits, workshops, concerts, slow visits and much more!   \n\nCurious? \nKeep an eye on our website: www.nocturnes.brussels. ","performers":"A total of 48 unique museums to visit, divided over 7 Thursday evenings!","boxoffice_url":null,"website":"https:\/\/nocturnes.brussels\/","email":"info@brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006671"},"it":{"name":"Nocturnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/nocturnes.brussels\/","email":"info@brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006671"},"cn":{"name":"Nocturnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/nocturnes.brussels\/","email":"info@brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006671"},"fr":{"name":"Nocturnes","shortdescr":"Chaque jeudi, du 13 mars jusqu'au 24 avril, une s\u00e9lection de mus\u00e9es bruxellois vous ouvre exceptionnellement leurs portes de 18h \u00e0 22h, pour seulement 4\u20ac ou 7\u20ac par visite.\n","longdescr":"Au total, 48 mus\u00e9es participants r\u00e9partis sur 7 jeudis soirs vous ouvrent leurs portes. \n\nOutre les collections et expositions, de nombreuses activit\u00e9s vous attendent : visites guid\u00e9es originales, visites dans les coulisses, ateliers, concerts, slow visits et bien d\u2019autres choses ! \n\nCurieux\u00b7ses ?\nJetez un \u0153il \u00e0 notre site web\u202f: nocturnes.brussels. ","performers":"Au total, 48 mus\u00e9es participants r\u00e9partis sur 7 jeudis soirs vous ouvrent leurs portes. ","boxoffice_url":null,"website":"https:\/\/nocturnes.brussels\/","email":"info@brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006671"},"sp":{"name":"Nocturnes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/nocturnes.brussels\/","email":"info@brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006671"},"nl":{"name":"Nocturnes","shortdescr":"Elke donderdag, van 13 maart tot 24 april, openen verschillende musea in Brussel uitzonderlijk hun deuren tussen 18u en 22u, voor slechts \u20ac4 of \u20ac7 per bezoek.\n","longdescr":"In het totaal goed voor 48 unieke musea.  \n\nNaast de prachtige collecties en tentoonstellingen kun je je ook verheugen op tal van extra activiteiten: originele rondleidingen, bezoeken achter de schermen, workshops, concerten, slow visits en nog veel meer!  \n\nNieuwsgierig? \nHou onze website in de gaten: nocturnes.brussels.","performers":"In het totaal openen 48 unieke musea hun deuren, verdeeld over 7 donderdagavonden.","boxoffice_url":null,"website":"https:\/\/nocturnes.brussels\/","email":"info@brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006671"}},"place":{"id":233167,"translations":{"de":{"name":"Brussels Museums","address_street_name":"Galerie du Roi","address_street_number":"15","address_street_box":null,"email":"info@brusselsmuseums.be","website":"http:\/\/www.brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Brussels Museums","address_street_name":"Galerie du Roi","address_street_number":"15","address_street_box":null,"email":"info@brusselsmuseums.be","website":"http:\/\/www.brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Brussels Museums","address_street_name":"Galerie du Roi","address_street_number":"15","address_street_box":null,"email":"info@brusselsmuseums.be","website":"http:\/\/www.brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Galerie du Roi, 15","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Brussels Museums","address_street_name":"Galerie du Roi","address_street_number":"15","address_street_box":null,"email":"info@brusselsmuseums.be","website":"http:\/\/www.brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Brussels Museums","address_street_name":"Galerie du Roi","address_street_number":"15","address_street_box":null,"email":"info@brusselsmuseums.be","website":"http:\/\/www.brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Brussels Museums","address_street_name":"Galerie du Roi","address_street_number":"15","address_street_box":null,"email":"info@brusselsmuseums.be","website":"http:\/\/www.brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 15","address_line2":"1000 Bruxelles","description_web":"Avec plus de nonante mus\u00e9es, Bruxelles a de quoi mettre l\u2019eau \u00e0 la bouche de tous les passionn\u00e9s de culture. Que ceux-ci se r\u00e9jouissent puisque, tout au long de l\u2019automne, au moins six mus\u00e9es ouvrent leurs portes le jeudi en soir\u00e9e dans le cadre des Nocturnes des Mus\u00e9es bruxellois. L\u2019entr\u00e9e dans les mus\u00e9es est alors de max. 2,50 \u20ac. Ceux qui souhaiteraient s\u2019offrir une petite visite \u00e0 Bruxelles peuvent aussi profiter des avantages de la Brussels Card. Ce pass donne libre acc\u00e8s \u00e0 25 mus\u00e9es bruxellois et au r\u00e9seau des transports publics pendant 24, 48 ou 72h et permet de profiter de nombreuses r\u00e9ductions. Prix: 20, 28 et 33 \u20ac. Enfin, notez d\u00e9j\u00e0 dans votre agenda que le samedi 7 mars 2009, Museum Night Fever, la Nuit des Mus\u00e9es bruxellois se d\u00e9roulera dans une quinzaine de mus\u00e9es, tous exceptionnellement ouverts de 19 \u00e0 1h. Ce soir-l\u00e0, place aux jeunes talents pour une programmation unique et bien loin des sentiers battus.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Brussels Museums","address_street_name":"Galerie du Roi","address_street_number":"15","address_street_box":null,"email":"info@brusselsmuseums.be","website":"http:\/\/www.brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 15","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brussels Museums","address_street_name":"Koningsgalerij","address_street_number":"15","address_street_box":null,"email":"info@brusselsmuseums.be","website":"http:\/\/www.brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Koningsgalerij, 15","address_line2":"1000 Brussel","description_web":"Met meer dan negentig musea weet Brussel de cultuurminnaars te bekoren. Zij mogen zich verheugen want heel de herfst lang, elke donderdagavond, openen minstens zes musea hun deuren in het kader van de Nocturnes van de Brusselse Musea. De toegangsprijs bedraagt max. 2,50 \u20ac. Voor wie zin heeft in een uitgebreide verkenning van onze hoofdstad, is de Brussels Card een absolute aanrader. Met deze kaart krijg je voor 24, 48 of 72 uur gratis toegang tot maar liefst 25 Brusselse musea, gratis openbaar vervoer en nog een heleboel extra kortingen. Prijs: 20, 28 of 33 \u20ac. Noteer ook al in je agenda: Museum Night Fever, de Nacht van de Brusselse Musea, op zaterdag 7 maart 2009. Een vijftiental musea zijn dan uitzonderlijk geopend van 19 tot 1 uur. De programmatie komt in handen van jong aanstormend talent en zoekt bewust nieuwe wegen op","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13],"translations":{