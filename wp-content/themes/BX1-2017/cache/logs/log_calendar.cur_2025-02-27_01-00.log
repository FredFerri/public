ss_city":"Bruxelles","address_line1":"Rue Ernest Allard, 27","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Champaka","address_street_name":"Rue Ernest Allard","address_street_number":"27","address_street_box":null,"email":"sablon@galeriechampaka.com","website":"http:\/\/www.galeriechampaka.com","phone_contact":"+32 2 514 91 52","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ernest Allard, 27","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Champaka","address_street_name":"Rue Ernest Allard","address_street_number":"27","address_street_box":null,"email":"sablon@galeriechampaka.com","website":"http:\/\/www.galeriechampaka.com","phone_contact":"+32 2 514 91 52","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ernest Allard, 27","address_line2":"1000 Bruxelles","description_web":"\r\nLa Galerie Champaka fait entrer la Bande Dessin\u00e9e au Grand Sablon, un quartier traditionnellement d\u00e9di\u00e9 aux arts \" anciens \", \" modernes \", \" contemporains \" et \" premiers \". Dans une maison de ma\u00eetre, sur deux niveaux, la galerie t\u00e9moigne que les cr\u00e9ateurs actuels de la Bande Dessin\u00e9e sont les h\u00e9ritiers des grands ma\u00eetres du pass\u00e9, tout en perfectionnant sans cesse une technique de narration qui fait de la Bande Dessin\u00e9e un art contemporain majeur. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Champaka","address_street_name":"Rue Ernest Allard","address_street_number":"27","address_street_box":null,"email":"sablon@galeriechampaka.com","website":"http:\/\/www.galeriechampaka.com","phone_contact":"+32 2 514 91 52","phone_booking":null