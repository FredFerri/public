alse,"last_updated_at":"2024-03-07T12:00:07+01:00","published_at":"2024-03-07T11:48:24+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296092,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"Pierres Release party + Foxtrot","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebrass.be\/event\/pierres-releaseparty\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008185"},"pt":{"name":"Pierres Release party + Foxtrot","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebrass.be\/event\/pierres-releaseparty\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008185"},"en":{"name":"Pierres Release party + Foxtrott","shortdescr":"Release party de Pierres avec la sortie de son album le 18\/03. \nEn premi\u00e8re partie Foxtrott ","longdescr":"Pierres est le projet solo de Pierre Leroy. Depuis 2019, le multi-instrumentiste bruxellois s\u2019interroge, se cherche et se livre dans une french pop fresh qui nous rappelle celle des Mathieu Boogaerts, Olivier Marguerit ou Jacques. Apr\u00e8s la sortie remarqu\u00e9e de son premier album, Disque de platine (titre temporaire), \u00e0 l\u2019\u00e9t\u00e9 2021, suivie de concerts en Belgique, France et Suisse, Pierres poursuit ses recherches kal\u00e9idoscopiques \u00e0 travers \u00c7AVA, nouveau disque \u00e0 para\u00eetre le 21 mars prochain. Si l\u2019on reconna\u00eet d\u2019embl\u00e9e cette libert\u00e9 de composition et d\u2019arrangements qui \u00e9tait \u00e0 l\u2019origine du pr\u00e9c\u00e9dent opus, la pr\u00e9sence de refrains, de beats dansants ou de m\u00e9lodies plus catchy t\u00e9moigne d\u2019une ambition plus pop. Ainsi, \u00e0 l\u2019envie de rester fid\u00e8le \u00e0 soi-m\u00eame s\u2019ajoute celle de rassembler, \u00e0 l\u2019envie de chanter, de faire chanter.\n\nFOXTROTT est le projet de MH Delorme, productrice, chanteuse et multi-instrumentiste bas\u00e9e \u00e0 Montr\u00e9al. Sa pop exp\u00e9rimentale au son unique d\u00e9fiant les genres est remarqu\u00e9e par la critique depuis 2013. FOXTROTT navigue avec aisance \u00e0 travers diff\u00e9rents univers musicaux sans jamais y perdre sa signature, \u00e0 la fois accessible et profond\u00e9ment personnelle.\nApr\u00e8s deux albums publi\u00e9s par la prestigieuse \u00e9tiquette britannique One Little Independent Records, FOXTROTT a fa\u00e7onn\u00e9 un univers musical qui lui est propre, mariant une production \u00e0 la fois audacieuse, \u00e9l\u00e9gante et visc\u00e9rale, \u00e0 un sens aigu de la m\u00e9lodie port\u00e9e par une voix puissante et remplie de \u00ab soul \u00bb. Depuis 2022, elle entame une s\u00e9rie de diptyques musicaux, qu\u2019elle publie de fa\u00e7on ind\u00e9pendante.","performers":"Pierres - Foxtrott","boxoffice_url":null,"website":"https:\/\/www.lebrass.be\/event\/pierres-releaseparty\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008185"},"it":{"name":"Pierres Release party + Foxtrot","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebrass.be\/event\/pierres-releaseparty\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008185"},"cn":{"name":"Pierres Release party + Foxtrot","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebrass.be\/event\/pierres-releaseparty\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008185"},"fr":{"name":"Pierres Release party + Foxtrott","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebrass.be\/event\/pierres-releaseparty\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008185"},"sp":{"name":"Pierres Release party + Foxtrot","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebrass.be\/event\/pierres-releaseparty\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008185"},"nl":{"name":"Pierres Release party + Foxtrott","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebrass.be\/event\/pierres-releaseparty\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008185"}},"place":{"id":245910,"translations":{"de":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":"Das Brass ist das Kulturzentrum der Br\u00fcsseler Gemeinde Forest, das sich insbesondere f\u00fcr urbane Kunstformen und alternative Musikgenres interessiert. Dabei setzt das BRASS vor allem auf lokale, interkulturelle und k\u00fcnstlerische Initiativen. In diesem Sinne bringt sich das Brass regelm\u00e4\u00dfig bei verschiedenen Veranstaltungen ein: vom K\u00fcnstlerparcours \"Parcours d'Artistes\" \u00fcber das Kinderkunstfestival \"SuperVlieg \/ SuperMouche\" bis hin zu dem Musikfestival Forest Sounds Festival im Parc de Forest. Das ganze Jahr \u00fcber werden hier zudem Konzerte, Ausstellungen, Workshops, offene B\u00fchnen, Begegnungen und Performance-Abende organisiert. Hinzu kommen Ausstellungen und K\u00fcnstlerresidenzen in der Abbaye de Forest, dem zuk\u00fcnftigen Kulturpol der Gemeinde.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":"Brass is Vorst's cultural centre, showing a clear predilection for urban arts and the more alternative music scene. \r\nThe BRASS focuses on all inhabitants by capitalizing local energies and intercultural, artistic and civic initiatives in the districts of Forest and the south of Brussels. The center is involved in the organization of the Artists' Circuit, the SuperVlieg \/ SuperMouche Festival and the future music festival in Forest Park. Throughout the year, it offers concerts, shows, exhibitions, workshops, open scenes, citizen meetings, performances, as well as exhibitions and artists residencies in the Abbey of Forest, the district's future cultural center.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":"LE BRASS EST LE CENTRE CULTUREL et LA MAISON DES CULTURES DE FOREST.\nLa plus grande partie de ses actions est men\u00e9e au coeur m\u00eame de l\u2019ancienne brasserie Wielemans-Ceuppens, dont les machines ont \u00e9t\u00e9 pr\u00e9serv\u00e9es et qui reste un v\u00e9ritable t\u00e9moin du patrimoine industriel du d\u00e9but du XXe si\u00e8cle.\nTout au long de l\u2019ann\u00e9e, du matin au soir, le BRASS propose des concerts, des spectacles, des expositions, des ateliers, des rencontres conviviales et citoyennes, des festivals th\u00e9matiques, une \u00e9cole des devoirs\u2026\nAu coeur de la diversit\u00e9 bruxelloise, il soutient la vitalit\u00e9 artistique et culturelle \u00e9mergente.\nAncr\u00e9 dans son quartier, le BRASS s\u2019adresse \u00e0 tou\u00b7te\u00b7s les habitant\u00b7e\u00b7s en capitalisant les \u00e9nergies locales et les initiatives interculturelles, artistiques et citoyennes des quartiers de Forest et du sud de Bruxelles.\nIl accorde une grande importance \u00e0 la participation des habitant\u00b7e\u00b7s dans son projet d\u2019action culturelle. \u00c0 ce titre, il s\u2019implique dans l\u2019organisation du festival Park Po\u00e9tik, du festival Forest Sounds et du Parcours 1190.\nLe Centre Culturel prend \u00e9galement part \u00e0 la programmation de la Fabr\u00ffk AB\u0178, qui se veut une pr\u00e9figuration de ce que sera le futur P\u00f4le Culturel de la Commune \u00e0 l\u2019Abbaye de Forest.\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Van Volxemlaan","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 364","address_line2":"1190 Vorst","description_web":"Brass, cultureel centrum van Vorst, staat open voor de buurt en heeft een duidelijke voorliefde voor stedelijke kunst en alternatieve muziekgenres. BRASS kapitaliseert de lokale energie\u00ebn en interculturele, artistieke en maatschappelijke initiatieven in Vorst en het zuiden van Brussel. In die hoedanigheid is BRASS betrokken bij de organisatie van Kunstenaarsparcours, Festival SuperVlieg \/ SuperMouche en het toekomstige muziekfestival in het Park van Vorst.  Het hele jaar door biedt het centrum concerten, voorstellingen, tentoonstellingen, workshops, open podia, bijeenkomsten van inwoners en performances, alsook tentoonstellingen en residenties in de Abdij van Vorst, toekomstige cultureel centrum.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":8159,"location":{"lat":50.82595768,"lon":4.32628597},"region":"brussels","last_updated_at":"2024-01-03T09:07:07+01:00","published_at":"2013-10-19T01:23:34+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":245910,"translations":{"de":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":"Das Brass ist das Kulturzentrum der Br\u00fcsseler Gemeinde Forest, das sich insbesondere f\u00fcr urbane Kunstformen und alternative Musikgenres interessiert. Dabei setzt das BRASS vor allem auf lokale, interkulturelle und k\u00fcnstlerische Initiativen. In diesem Sinne bringt sich das Brass regelm\u00e4\u00dfig bei verschiedenen Veranstaltungen ein: vom K\u00fcnstlerparcours \"Parcours d'Artistes\" \u00fcber das Kinderkunstfestival \"SuperVlieg \/ SuperMouche\" bis hin zu dem Musikfestival Forest Sounds Festival im Parc de Forest. Das ganze Jahr \u00fcber werden hier zudem Konzerte, Ausstellungen, Workshops, offene B\u00fchnen, Begegnungen und Performance-Abende organisiert. Hinzu kommen Ausstellungen und K\u00fcnstlerresidenzen in der Abbaye de Forest, dem zuk\u00fcnftigen Kulturpol der Gemeinde.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"BRASS - Centre Culturel de Forest","address_street_name":"Avenue Van Volxem","address_street_number":"364","address_street_box":null,"email":"info@lebrass.be","website":"http:\/\/www.lebrass.be","phone_contact":"+32 2 332 40 24","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 364","address_line2":"1190 Forest","description_web":"Brass is Vorst's cultural centre, showing a clear predilection for urban arts and the more alternative music scene. \r\nThe BRASS focuses on all inhabitants by capitalizing local energies and intercultural, artistic and civic initiatives in the districts of Forest and th