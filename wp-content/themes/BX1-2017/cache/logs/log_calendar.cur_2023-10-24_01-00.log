il.492580"},"it":{"name":"Brussels Hoppy Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hoppy-tours.com","email":"info@hoppy-tours.com","phone_contact":null,"phone_booking":"+32 475 20 01 31","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.492580"},"cn":{"name":"Brussels Hoppy Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hoppy-tours.com","email":"info@hoppy-tours.com","phone_contact":null,"phone_booking":"+32 475 20 01 31","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.492580"},"fr":{"name":"Brussels Hoppy Tour","shortdescr":"Vivez une exp\u00e9rience unique dans les rues de Bruxelles. Amusez-vous \u00e0 r\u00e9soudre nos \u00e9nigmes. D\u00e9gustez de bonnes bi\u00e8res belges.D\u00e9couvrez Bruxelles de mani\u00e8re insolite et originale.","longdescr":"Le Brussels Hoppy-Tour est un jeu de piste urbain \u00e0 r\u00e9aliser entre amis, en famille, entre coll\u00e8gues,....\r\nR\u00e9servez votre date.\r\nRendez-vous au point de d\u00e9part, situ\u00e9 \u00e0 deux pas de la Grand-Place de Bruxelles entre 13h30 et 16h. Lancez-vous arm\u00e9s de votre carnet dans les rues de Bruxelles \u00e0 la recherche de vos r\u00e9compenses houblonn\u00e9es. Faites le circuit \u00e0 votre rythme, le temps n'a pas d'importance. Vous devrez toutefois veiller \u00e0 \u00eatre au bout de votre aventure avant 21h\r\nPour plus de d\u00e9tails visitez notre site web: www.hoppy-tours.com","performers":null,"boxoffice_url":null,"website":"http:\/\/www.hoppy-tours.com","email":"info@hoppy-tours.com","phone_contact":null,"phone_booking":"+32 475 20 01 31","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.492580"},"sp":{"name":"Brussels Hoppy Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hoppy-tours.com","email":"info@hoppy-tours.com","phone_contact":null,"phone_booking":"+32 475 20 01 31","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.492580"},"nl":{"name":"Brussels Hoppy Tour","shortdescr":"Dankzij onze ontdekkingstocht met degustatie zal u de monumenten, de geschiedenis en de anekdotes van Brussel op een ludieke manier ontdekken.","longdescr":"De Brusselse Hoppy-Tour is een stedelijke speurtocht om samen met vrienden, familie, collega's uit te zoeken. \r\nReserveer je datum.\r\nGa naar het startpunt tussen 13u30 en 16uur, gelegen op een boogscheut van de Grote Markt van Brussel.\r\nMet je notitieboekje op zak ga je doorheen de straten van Brussel op zoek om zo de degustaties te ontdekken. Deze ontdekkingstocht leg je af in je eigen tempo. Je moet er echter voor zorgen dat je voor 21 uur weer bij het startpunt aankomt. \r\nBezoek onze website voor meer informatie: www.hoppy-tours.com","performers":null,"boxoffice_url":null,"website":"http:\/\/www.hoppy-tours.com","email":"info@hoppy-tours.com","phone_contact":null,"phone_booking":"+32 475 20 01 31","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.492580"}},"place":{"id":276883,"translations":{"de":{"name":"BAR L'ECUYER","address_street_name":"Rue de l'Ecuyer","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"BAR L'ECUYER","address_street_name":"Rue de l'Ecuyer","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_vi