translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":65}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[323],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"]}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T23:06:25+02:00","published_at":"2022-09-02T09:46:48+02:00","backoffice_id":238574,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.14083339793634},{"id":540176,"date_start":"2022-09-01","date_end":"2022-11-13","date_next":"2022-11-13","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,40],"translations":{"fr":["Mus\u00e9es et art centers","Arts graphiques"],"nl":["Musea en kunstcentra","Grafische kunst, vormgeving"],"en":["Museums and art centers","Graphic art"],"de":["Museen & Kunstzentren","Grafische K\u00fcnste"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Souriez j'adore ! Ariane Bergrichter","shortdescr":"Fin des ann\u00e9es 80, d\u00e9but des ann\u00e9es 90, d\u2019innombrables dessins assembl\u00e9s naissent des mains d\u2019Ariane Bergrichter (1937-1996) dans une Bruxelles grouillante de caf\u00e9s, de gens attabl\u00e9s, d\u2019arr\u00eats de tram, de passants et d'artistes, de dames \u00e0 gros manteaux, de serveurs et d\u2019ouvriers.","longdescr":"Il est un monde grouillant, de bic et de feutre, de caf\u00e9s, de gens attabl\u00e9s, de fen\u00eatres sur rue, d\u2019arr\u00eats de tram, de passants et d'artistes, de dames \u00e0 petits chiens et gros manteaux, de serveurs et d\u2019ouvriers. \u00ab C\u2019est dingue le nombre de tuiles qui faut \u00bb laisse \u00e9chapper un couvreur dans le tumulte des assemblages de dessins pris sur le vif au c\u0153ur de Bruxelles fin des ann\u00e9es 80, d\u00e9but des ann\u00e9es 90.\r\n\r\n\u00ab C\u2019est dingue \u00bb le nombre de croquis, de sous-bocks, de bouts de papier collant, d\u2019heures \u00e0 observer dans les bars et assembler dans la chambre, pour qu\u2019Ariane Bergrichter fasse art d\u2019une vie psychique complexe. \u00c0 son d\u00e9c\u00e8s en 1996, les nombreux \u00e9crits et dessins t\u00e9moignent de la difficult\u00e9 \u00e0 vivre. Ils sont enfouis par sa fille dans une valise, en seront ressortis vingt ans plus tard, pour se r\u00e9v\u00e9ler \u0153uvre.\r\n\r\nLes dessins assembl\u00e9s d\u2019Ariane Bergrichter ont \u00e9t\u00e9 montr\u00e9s une premi\u00e8re fois \u00e0 l\u2019American Folk Art Museum de New-York en 2018. Avec SOURIEZ J\u2019ADORE ! le ART ET MARGES MUS\u00c9E en propose la premi\u00e8re exposition monographique.","performers":"Ariane Bergrichter (artiste plasticienne), Tatiana Veress (commissaire d'exposition), Matty Grace (sc\u00e9nographie)","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540176"},"nl":{"name":"Smile. I love it! Ariane Bergrichter","shortdescr":"Eind jaren tachtig, begin jaren negentig maakte Ariane Bergrichter (1937-1996) talloze tekeningen in een Brussel dat wemelt van de caf\u00e9s, mensen aan tafel, de tramhaltes, passanten en kunstenaars, dames in zware bontjassen, obers en arbeiders.","longdescr":"Er bestaat een krioelende wereld van balpen en vilt, van caf\u00e9s, van mensen aan tafels, van ramen aan de straatkant, van tramhaltes, van voorbijgangers en kunstenaars, van dames met kleine hondjes en dikke jassen, van obers en arbeiders. \u201cHet is ongelooflijk hoeveel dakpannen er nodig zijn\u201d, aldus een dakdekker in het tumult van tekeningen die eind jaren '80, begin jaren '90 ter plaatse in hartje Brussel werden gemaakt.\r\n\r\n\u201cHet is ongelooflijk\u201d hoeveel schetsen, bierkaartjes, stukjes plakband, uren van observeren en van samenvoegen Ariane Bergrichter verzamelde om een complex psychisch leven tot kunst te verheffen. Bij haar overlijden in 1996 getuigden de talrijke geschriften en tekeningen van haar moeilijkheid met het leven. Haar dochter begroef ze in een koffer, maar haalde ze twintig jaar later weer tevoorschijn en onthulde aldus het oeuvre dat ze vormen.\r\n\r\nDe geassembleerde tekeningen van Ariane Bergrichter waren in 2018 voor het eerst te zien in het American Folk Art Museum in New York. Met SMILE. I LOVE IT! biedt het ART ET MARGES MUSEUM haar eerste monografische tentoonstelling aan.","performers":"Ariane Bergrichter (kunstenares), Tatiana Veress (curator), Matty Grace (scenografie)","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540176"},"en":{"name":"Smile. I love it! Ariane Bergrichter","shortdescr":"In the late 1980s and early 1990s, Ariane Bergrichter (1937-1996) created countless drawings in a Brussels teeming with caf\u00e9s, people at tables, bus stops, passers-by and artists, ladies in heavy coats, waiters and workers.","longdescr":"Here is a world teeming with ballpoint pens and felt tip pens, caf\u00e9s, people seated at tables, windows with a view on the street, tram stops, passersby and artists, old ladies with small dogs straining at the leash, waiters and workers. \u201cIt\u2019s simply crazy the number of tiles I need\u2026\u201d says a roofer amongst the tumult of images of drawings sketched from life in the heart of Brussels at the end of the 1980s, beginning of the 1990s.\r\n\r\n\u201cIt\u2019s simply amazing \u2026\u201d, the number of sketches, beer coasters, bits of sticky paper, the hours spent observing the world go by in bars and assembling it all together, so that Ariane Bergrichter could turn the complex psyche of her life into a work of art. When she passed away in 1996, there were so many written notes and sketches that bore witness to how difficult her life had been. Her daughter stuffed them all into a suitcase and, some 20 years later, they emerged to reveal this remarkable work.\r\n\r\nIn 2018, the assembled drawings of Ariane Bergrichter were exhibited for the first time at the American Folk Art Museum in New York. Now, with SMILE. I LOVE IT!, the ART ET MARGES MUSEUM is exhibiting the first monographic exhibition of this artist\u2019s work.","performers":"Ariane Bergrichter (artist), Tatiana Veress (curator), Matty Grace (Scenography)","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540176"},"de":{"name":"Souriez j'adore ! Ariane Bergrichter","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540176"},"it":{"name":"Souriez j'adore ! Ariane Bergrichter","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540176"},"sp":{"name":"Souriez j'adore ! Ariane Bergrichter","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540176"},"pt":{"name":"Souriez j'adore ! Ariane Bergrichter","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540176"},"cn":{"name":"Souriez j'adore ! Ariane Bergrichter","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540176"}},"place":{"id":738,"translations":{"fr":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 au c\u0153ur de Bruxelles, le Art et marges mus\u00e9e, mus\u00e9e d\u2019art brut - contemporain - outsider art, questionne l\u2019art et ses fronti\u00e8res. Sa collection s\u2019est constitu\u00e9e d\u00e8s le milieu des ann\u00e9es 80 aupr\u00e8s d\u2019artistes autodidactes, d\u2019ateliers artistiques pour personnes porteuses d\u2019un handicap mental ou d\u2019ateliers en milieu psychiatrique. Elle se compose aujourd\u2019hui de plus de 4000 \u0153uvres internationales produites en dehors des sentiers fr\u00e9quent\u00e9s de l\u2019art. Ses expositions temporaires, au rythme de deux \u00e0 trois par an, m\u00ealent artistes de part et d\u2019autre de la marge et questionnent l\u2019art et sa d\u00e9finition-m\u00eame. ","description_print":"Mus\u00e9e d'art outsider","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Art & marges museum","address_street_name":"Hoogstraat","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Hoogstraat, 314","address_line2":"1000 Brussel","description_web":"Outsiderkunst museum. Sinds zijn oprichting in 1984 en de eerste tentoonstelling in 1986, verdedigt de vzw Art en Marge - het huidige art )&( marges museum - kunstenaars die uit de boot van het offici\u00eble culturele circuit vallen. Die autodidactische kunstenaars worden \u201coutsiders\u201d genoemd en werken alleen of in creatieve workshops voor zieke of gehandicapte personen. Naast de permanente verzameling, zorgen tijdelijke tentoonstellingen voor een dynamische dialoog met de werken van professionele kunstenaars die actief zijn in het offici\u00eble culturele milieu, om de grenzen van de in- en outsiderkunst af te tasten. art )&( marges museum is geen ghettomuseum maar een plaats van uitwisseling, een ruimte waarin de individualiteit hoogtij viert en waarin alles in het werk gesteld wordt om ervoor te zorgen dat alle doelgroepen zich thuis voelen.\r\n\r\nOpen op vrijdag, zaterdag en zondag tussen 11.00 en 17.30 uur, alleen op afspraak.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Art & marges museum","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Haute, 314","address_line2":"1000 Brussels","description_web":"Museum of outsider art. Since its founding in 1984 and the first exhibition of 1986, Art & Marge \u2013 now the \u2018art )&( marges [margins] museum\u2019 \u2013 promotes artists outside the mainstream. These self-taught artists, often called \u201coutsider artists\u201d, work either individually or in creative workshops in institutions for people who are mentally unwell or who are mentally challenged. In addition to the permanent collection,  temporary exhibitions will establish a dynamic dialogue with paintings by professional artists from the mainstream who are active in their cultural surroundings \u2013 the boundary between \u2018insider\u2019 and \u2018outsider\u2019 art?   The \u2018Art & Marges\u2019 museum is not a ghetto museum but a venue for exchange, where individuality is of prime importance and where all efforts are made to make all target groups feel at home.\r\n\r\nOpen Fridays, Saturdays and Sundays between 11.00 am and 5.30 pm by appointment only.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Art brut - Outsider Art - Zeitgen\u00f6ssische Kunst\r\n\r\nDas Museum Art et Marges zeigt eine Sammlung, die seit den 1980er-Jahren kontinuierlich w\u00e4chst. Dabei handelt es sich um Kunst abseits des Mainstreams, die einen Blick auf die autodidaktischen K\u00fcnslter wirft, Kunstateliers f\u00fcr Menschen mit geistiger Behinderung oder in Psychiatrien. \r\nIn den Ausstellungen mischen sich K\u00fcnstler diesseits und jenseits der Grenze des \"Au\u00dfenseitertums\" (engl. Begriff \"Art Outsider\"), die die Kunst und deren Beschr\u00e4nkungen hinterfragt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"100