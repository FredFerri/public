,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":"Chaque 1e et 3e mercredi du mois, WIELS vous invite \u00e0 prendre part \u00e0 un atelier qui explore des id\u00e9es et techniques cr\u00e9atives employ\u00e9es par les artistes expos\u00e9s. Participez et prolongez le plaisir de la visite en ramenant votre cr\u00e9ation \u00e0 la maison.","longdescr":"EXPOSITIONS \r\nChaque 1er et 3e mercredi du mois, WIELS est ouvert jusqu'\u00e0 21:00.\r\n\r\nATELIERS DES NOCTURNES \r\nLors des nocturnes, WIELS vous invite \u00e0 prendre part \u00e0 un atelier qui explore des id\u00e9es et techniques cr\u00e9atives employ\u00e9es par les artistes expos\u00e9s. Participez et prolongez le plaisir de la visite en ramenant votre cr\u00e9ation \u00e0 la maison.\r\n\r\nTous les 1iers mercredis du mois : Un atelier autour de l'exposition de Kasper Bosmans\r\n\r\nVenez cr\u00e9er votre propre frise \u00e0 l\u2019aide d\u2019un rouleau estampill\u00e9 selon votre go\u00fbt. Cette activit\u00e9 invite \u00e0 la cr\u00e9ation d\u2019un rouleau \u00e0 estampiller, avec lequel vous pourrez reproduire votre frise, reprenant des images-objets trouvant leur source dans diff\u00e9rentes \u0153uvres de Kasper Bosmans. \u00c0 la fin de l'atelier, il vous sera possible de reprendre votre cr\u00e9ation avec vous.\r\n\r\nTous les 3e mercredis du mois : Atelier autour de l'exposition de Huguette Caland\r\n\r\nS\u2019habiller diff\u00e9remment, en adaptant ses v\u00eatements \u00e0 son corps et non l\u2019inverse, cr\u00e9er ses parures soi-m\u00eame, exp\u00e9rimenter les lignes et les porter... une exp\u00e9rience v\u00e9cue par Huguette Caland au cours de sa vie comme artiste.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org\/fr\/events\/les-ateliers-des-nocturnes","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":"+32 2 340 00 53","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529843.html"},"nl":{"name":"Nocturnes + Workshops in WIELS","shortdescr":"Elke 1e en 3e woensdag van de maand nodigt WIELS je uit om deel te nemen aan een workshop die creatieve idee\u00ebn en technieken uit de lopende tentoonstellingen verkent. Neem na afloop je eigen creatie mee naar huis en beleef de tentoonstelling verder!","longdescr":"TENTOONSTELLINGEN \r\nElke 1e en 3e woensdag van de maand zijn de tentoonstellingen van WIELS open tot 21:00! \r\n\r\nNOCTURNE WORKSHOPS \r\nWIELS nodigt je uit om deel te nemen aan een workshop die creatieve idee\u00ebn en technieken uit de lopende tentoonstellingen verkent. Neem na afloop je eigen creatie mee naar huis en beleef de tentoonstelling verder!\r\n\r\nElke 1e woensdag van de maand: Workshop rond de tentoonstelling van Kasper Bosmans\r\n\r\nMaak je eigen fries, gedrukt naar je eigen smaak! Deze activiteit nodigt je uit om een drukrol te maken, waarmee je een motief kan reproduceren om tot je eigen fries te komen, waarin je wezens kan verwerken die je tegenkwam in de verschillende werken van Kasper Bosmans. Aan het einde van de workshop is het mogelijk om je eigen creatie mee naar huis te nemen.\r\n\r\nElke 3e woensdag van de maand: workshop rond de tentoonstelling van Huguette Caland\r\n\r\nNeem deel aan deze workshop en borduur samen met ons in een serene maar revolutionaire sfeer. Zich anders kleden, je kleren aanpassen aan je lichaam en niet andersom, je eigen versieringen cre\u00ebren, experimenteren met lijnen om te dragen: allemaal belangrijke ervaringen die Huguette Caland opdeed tijdens haar leven als kunstenares.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org\/nl\/events\/nocturne-workshops","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529843.html"},"en":{"name":"Late Night Openings + Workshops at WIELS","shortdescr":"Every 1st and 3rd Wednesday of the month, WIELS invites you to take part in a workshop that explores creative ideas and techniques used in the current exhibitions. Continue your exhibition experience by taking your own creation home!","longdescr":"EXHIBITIONS \r\nEvery 1st and 3rd Wednesday of the month, the exhibitions of WIELS are open until 21:00. \r\n\r\nLATE NIGHT OPENING WORKSHOPS \r\nDuring the late night openings, WIELS invites you to take part in a workshop that explores creative ideas and techniques used in the current exhibitions. Continue your exhibition experience by taking your own creation home!\r\n\r\nEvery first Wednesday of the month: Workshop in the framework of Kasper Bosmans' exhibition\r\n\r\nCreate your own frieze printed to your taste! This activity invites you to create a printing roll, with which you can reproduce a motif to create your own frieze, incorporating if you so wish creatures observed in the various works by Kasper Bosmans. At the end of the workshop, it\u2019s possible to take your own creation home with you.\r\n\r\nEvery 3rd Wednesday of the month: Workshop in the framework of Huguette Caland's exhibition\r\n\r\nTake part in this workshop and embroider together with us in a serene but revolutionary atmosphere. Dressing differently, adapting your clothes to your body and not the other way round, creating your own adornments, experimenting with lines and wearing them: these were important experiences Huguette Caland had during her life as an artist.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org\/en\/events\/late-night-workshops","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529843.html"},"de":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529843.html"},"it":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529843.html"},"sp":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529843.html"},"pt":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529843.html"},"cn":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529843.html"}},"place":{"id":1490,"translations":{"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"La r\u00e9servation est obligatoire pour le Wiels. Veuillez vous rendre sur leur site internet pour une r\u00e9servation.\r\n\r\nLe WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Vorst","description_web":"De boeking is verplicht voor Wiels. Raadpleeg de webpagina van de musea om te reserveren.\r\n\r\nWiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Booking is compulsory for Wiels. Please consult the museum\u2019s website to book your time slot.\r\n\r\nIt was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world.  ","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\n\r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":"art_center","facebook_id":null,"backoffice_id":195,"location":{"lat":50.82467444,"lon":4.32636558},"region":"brussels","last_updated_at":"2022-05-05T01:07:54+02:00","published_at":"2013-10-19T01:13:21+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1490,"translations":{"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"La r\u00e9servation est obligatoire pour le Wiels. Veuillez vous rendre sur leur site internet pour une r\u00e9servation.\r\n\r\nLe WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Vorst","description_web":"De boeking is verplicht voor Wiels. Raadpleeg de webpagina van de musea om te reserveren.\r\n\r\nWiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Booking is compulsory for Wiels. Please consult the museum\u2019s website to book your time slot.\r\n\r\nIt was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world.  ","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\n\r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":"art_center","facebook_id":null,"backoffice_id":195,"location":{"lat":50.82467444,"lon":4.32636558},"region":"brussels","last_updated_at":"2022-05-05T01:07:54+02:00","published_at":"2013-10-19T01:13:21+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/bff3495f7084128758536ddff04d21676c0d9018.jpg","width":2048,"height":1152,"ratio":1.78,"translations":{"fr":{"title":"Nocturnes + Ateliers au WIELS","copyright":null},"nl":{"title":"Nocturnes + Ateliers au WIELS","copyright":null},"en":{"title":"Nocturnes + Ateliers au WIELS","copyright":null}}}],"dates":[{"day":"2022-03-02","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-03-16","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-04-06","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-04-20","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-05-04","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-05-18","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-06-01","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-06-15","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-07-06","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-07-20","doors":null,"start":"18:00:00","end":"21:00:00"},{"day":"2022-08-03","doors":null,"start":"18:00:00","end":"21:00:00"}],"recurring":[{"day":"wednesday","occurences":{"is_first":true,"is_second":false,"is_third":true,"is_fourth":false,"is_last":false},"time_start":"18:00:00","time_end":"21:00:00","translations":{"fr":"Ouvert les premier et troisi\u00e8me mercredis du mois de 18:00 \u00e0 21:00","nl":"Open op de eerste en derde woensdags van de maand van 18:00 tot 21:00","en":"Open the first and third wednesdays of the month from 18:00 to 21:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":0},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":7},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Jobseekers"}},"value":4},{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"}},"value":0},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[528941],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,261,263,265],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-05T01:07:54+02:00","published_at":"2022-03-17T10:50:28+01:00","backoffice_id":249843,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.2297111188609},{"id":526798,"date_start":"2022-04-23","date_end":"2022-06-26","date_next":"2022-05-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Thomas Boivin - 'Belleville'","shortdescr":"Black and white analogue documentary photography","longdescr":"Les photographies de Thomas Boivin \u00e0 Belleville, Paris, montrent la ville \u00e0 l\u2019\u00e9tat organique, d\u00e9sordonn\u00e9e. Ces images sont d\u00e9lib\u00e9r\u00e9ment d\u00e9pourvues des marqueurs habituels de la ville planifi\u00e9e par Hausmann mais elles n'en sont pas moins belles, parfois romantiques. Belleville est issue de l'exp\u00e9rience v\u00e9cue de Thomas Boivin, photographiant des lieux et des personnes proches de chez lui, fixant les limites du projet au quartier qu\u2019il pouvait parcourir lentement en une journ\u00e9e.\r\n\r\nBelleville refl\u00e8te le passage du temps, des saisons, le mouvement de l'\u0153il du sol \u00e0 l'arbre, d\u2019une cl\u00f4ture \u00e0 un visage. Boivin reste dans les espaces ouverts, en documentant les limites - cl\u00f4tures, trottoirs, vitrines \u00e0 rideaux \u00e0 travers lesquelles nous ne pouvons pas voir. Il capture des moments priv\u00e9s dans des espaces publics, ses sujets savent qu'il est l\u00e0 et sont complices et confortables m\u00eame s\u2019il reste toujours une distance. Les images collect\u00e9es dansent sur une ligne fine, suffisamment proche pour \u00e9mouvoir, tout en \u00e9vitant l'intrusion.\r\n\r\nPlace de la R\u00e9publique est un travail en cours, montr\u00e9 publiquement pour la premi\u00e8re fois \u00e0 la Fondation A. Contrairement \u00e0 Belleville, ces portraits de la jeunesse parisienne sont pris \u00e0 partir d'une position fixe, Boivin revenant encore et encore sur la m\u00eame place, \u00e0 une courte distance de son domicile, avec un appareil photo mont\u00e9 sur tr\u00e9pied. Comme \u00e0 Belleville, ses sujets sont clairement au courant de la pr\u00e9sence du photographe. Prises ensemble comme s\u00e9rie, ces oeuvres soulignent l'\u00e9change entre le sujet et l'artiste et la profondeur de ce geste simple : t\u00e9moigner de l\u2019existence d\u2019une personne en demandant de faire son portrait.\r\n\r\n\r\nLes deux projets tiennent l\u00e9g\u00e8rement \u00e0 distance la nostalgie et la m\u00e9lancolie profonde de Paris. Au contraire, en enracinant sa pratique dans son propre quartier, les images de Thomas Boivin expriment plut\u00f4t une curiosit\u00e9 pour son environnement imm\u00e9diat, un d\u00e9sir d'une forme d'intimit\u00e9 dans l'espace public et, surtout, un souci des autres.\r\n\r\nTristan Lund, commissaire de l\u2019exposition.","performers":"Les photographies de Thomas Boivin \u00e0 Belleville, Paris, montrent la ville \u00e0 l\u2019\u00e9tat organique, d\u00e9sordonn\u00e9e. Belleville est issue de l'exp\u00e9rience v\u00e9cue de Thomas Boivin, photographiant des lieux et des personnes proches de chez lui, fixant les limites du projet au quartier qu\u2019il pouvait parcourir lentement en une journ\u00e9e.","boxoffice_url":null,"website":"http:\/\/www.fondationastichting.com","email":"info@fondationastichting.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/526798.html"},"nl":{"name":"Thomas Boivin - 'Belleville'","shortdescr":"Zwart-wit analoge documentaire fotografie","longdescr":"Thomas Boivins foto\u2019s van Belleville, in Parijs, tonen de stad in gebruik \u2013 organisch, rommelig, ongeordend. Ze missen opzettelijk de stereotiepe kenmerken van Hausmanns geplande visie op de stad, maar zijn nog steeds mooi, romantisch zelfs. Belleville realiseerde Boivin op basis van zijn eigen ervaringen, hij fotografeerde enkel plaatsen en mensen in de buurt van zijn huis: de grenzen van het project waren bepaald door de afstand die hij op een dag tijd met gemak kon afleggen.\r\n\r\nBelleville weerspiegelt het verstrijken van de tijd, de seizoenen, de beweging van het oog van grond naar boom naar hek naar persoon. Boivin blijft overal in de openbare ruimte, houdt zich aan de paden en documenteert de grenzen \u2013 hekken, trottoirs, etalages met gordijnen waar we niet doorheen kunnen kijken. Hij legt priv\u00e9momenten vast in de openbare ruimte, zijn onderwerpen weten dat hij er is, ze zijn medeplichtig en comfortabel, maar er zijn nog steeds barri\u00e8res. De verzamelde beelden balanceren op een dunne lijn, tussen dichtbij genoeg om te ontroeren en ver genoeg om intrusie vermijden.\r\n\r\nPlace de la R\u00e9publique is een work in progress, dat voor het eerst in het openbaar getoond wordt bij Fondation A Stichting.\r\nIn tegenstelling tot Belleville zijn deze portretten van Parijse jongeren vanuit een vaste positie genomen. Boivin keert telkens terug naar hetzelfde plein, niet ver van zijn woning, met een camera op een statief. Net als in Belleville zijn zijn onderwerpen duidelijk gewillige \u2018sitters\u2019. Het geheel van foto\u2019s benadrukt de relatie tussen onderwerp en kunstenaar en de betekenis van de erkenning van het bestaan van de ander door te vragen om zijn of haar portret te mogen maken.\r\n\r\nBeide projecten zijn lichtjes getekend door de diep doordrongen nostalgie en melancholie van Parijs. Door zijn praktijk te verankeren in zijn eigen buurt drukt Thomas Boivin met zijn beelden vooral een nieuwsgierigheid naar zijn directe omgeving uit, een verlangen naar een vorm van intimiteit in de openbare ruimte en vooral een bekommernis om de anderen.\r\n\r\nTristan Lund, curator van de tentoonstelling.","performers":"Thomas Boivins foto\u2019s van Belleville, in Parijs, tonen de stad in gebruik \u2013 organisch, rommelig, ongeordend. Belleville realiseerde Boivin op basis van zijn eigen ervaringen, hij fotografeerde enkel plaatsen en mensen in de buurt van zijn huis: de grenzen van het project waren bepaald door de afstand die hij op een dag tijd met gemak kon afleggen.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/526798.html"},"en":{"name":"Thomas Boivin - 'Belleville'","shortdescr":"Photographie noir et blanc analogue documentaire","longdescr":"Thomas Boivin\u2019s photographs of Belleville, Paris show the city in use - organic, messy, disordered. They intentionally lack the stereotypical markers of Hausmann\u2019s planned vision for the city but are still beautiful, romantic even. Belleville was created from Boivin\u2019s lived experience, he only photographed places and people near to his home, the boundaries of the project set by a neighbourhood he would slowly walk in a day.\r\n\r\nBelleville reflects the passing of time, the seasons, the movement of the eye from ground to tree to fence to person. Boivin remains in public spaces throughout, keeping to the paths and documenting the boundaries - fences, pavements, curtained shop windows we cannot see into. He captures private moments in public spaces, his subjects know he is there, they are complicit and comfortable but there are still barriers. The collected images dance a fine line, close enough to feel soulful whilst avoiding intrusion.\r\n\r\nPlace de la R\u00e9publique is still a work in progress, shown publicly for the first time at A Foundation.\r\nIn contrast to Belleville these portraits of Parisian youth are taken from a fixed position, Boivin returning again and again to the same square, a short distance from his home, with a tripod-mounted camera. As in Belleville his subjects are clearly willing \u2018sitters\u2019. And as a group these works emphasise the exchange between subject and artist and the profundity of acknowledging a stranger\u2019s existence by asking to take their portrait.\r\n\r\nBoth projects hold lightly Paris\u2019 deep soaked nostalgia and melancholy. Rather, by rooting his practice within his own neighbourhood, Thomas Boivin\u2019s images express a curiosity for his immediate surroundings, a desire for a form of intimacy in public spaces and, above all, a concern for others.\r\n\r\nTristan Lund, curator of the exhibition.","performers":"Thomas Boivin\u2019s photographs of Belleville, Paris show the city in use - organic, messy, disordered. Belleville was created from Boivin\u2019s lived experience, he only photographed places and people near to his home, the boundaries of the project set by a neighbourhood he would slowly walk in a day.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/526798.html"},"de":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/526798.html"},"it":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/526798.html"},"sp":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/526798.html"},"pt":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/526798.html"},"cn":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/526798.html"}},"place":{"id":251684,"translations":{"fr":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"Cr\u00e9\u00e9e \u00e0 l\u2019initiative d\u2019Astrid Ullens de Schooten, la Fondation A, reconnue d\u2019utilit\u00e9 publique, a ouvert ses portes au sud de Bruxelles, en octobre 2012. Elle a pour vocation de soutenir la cr\u00e9ation, la connaissance et la conservation de l\u2019image photographique. L\u2019objectif consiste \u00e0 explorer les enjeux et les contradictions de l\u2019image-document afin de questionner ce monde du tout visuel que nous habitons. Trois expositions temporaires sont organis\u00e9es chaque ann\u00e9e. Au c\u0153ur de la Fondation A, il y a une collection. Elle est compos\u00e9e de grands ensembles d\u2019\u0153uvres de photographes \u00e0 la sensibilit\u00e9 documentaire, reconnus mondialement pour bon nombre d\u2019entre eux. Depuis 2015, la Fondation A consacre \u00e9galement une exposition par saison \u00e0 un jeune cr\u00e9ateur. V\u00e9ritable plateforme consacr\u00e9e \u00e0 l\u2019image photographique, elle est aussi le partenaire de projets d\u2019expositions et d\u2019\u00e9ditions, organis\u00e9s en collaboration avec d\u2019autres institutions culturelles. ","description_print":"","booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null},"nl":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 304","address_line2":"1190 Vorst","description_web":"Op initiatief van Astrid Ullens de Schooten opende A Stichting, een vereniging van openbaar nut, in het zuiden van Brussel in oktober 2012 haar deuren. Ze wil ondersteuning bieden aan de creatie, de kennis en de conservatie van het fotografische beeld. Het doel is de uitdagingen en de tegenstellingen die van het beelddocument uitgaan te onderzoeken, met de bedoeling de visuele wereld waarin we leven in vraag te stellen. Elk jaar worden drie tijdelijke tentoonstellingen georganiseerd. Het hart van A Stichting is een fotocollectie. Die bestaat uit grote gehelen van werk van fotografen met een documentaire insteek en van wie een groot aantal wereldwijd erkend is. Sinds 2015 besteedt A Stichting ook \u00e9\u00e9n tentoonstelling per seizoen aan een jonge fotograaf. Het is een echt platform gewijd aan de fotografie en is ook partner van tentoonstellings- en boekprojecten georganiseerd in samenwerking met andere culturele instellingen.","description_print":"","booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null},"en":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"Instigated by Astrid Ullens de Schooten, the state-approved A Foundation opened south of Brussels in October 2012. It aims to support the creation, awareness and conservation of photographic images. The purpose consists of exploring the challenges and contradictions surrounding document images in order to examine this very visual world that we inhabit. Three temporary exhibitions are organised each year. The collection is central to the A Foundation. It comprises great sets of works by photographers with a documentary tendency; many of them are highly regarded throughout the world. Since 2015, the A Foundation has also devoted one exhibition per season to a young creator. It is a real platform for photographic images, is also a partner for exhibition and publishing projects organised in conjunction with other cultural institutions. ","description_print":"","booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null},"de":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Fundaci\u00f3n A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"En octubre de 2012, la Fundaci\u00f3n A stichting abri\u00f3 sus puertas en el sur de Bruselas en el lugar de la antigua f\u00e1brica Bata. Creada bajo la iniciativa de Astrid Ullens de Schooten, y reconocida por promover el inter\u00e9s p\u00fablico, tiene una vocaci\u00f3n para apoyar la creaci\u00f3n, el conocimiento y la preservaci\u00f3n de la imagen fotogr\u00e1fica. Ya no existe nada que no parezca haber sido atestiguado por la imagen. Sin embargo, la idea de dejar constancia sobre el uso real de la fotograf\u00eda no es necesaria. Lo que ocurre con nuestra capacidad de ver y percibir cuando en su abundancia y su inmediaci\u00f3n virtual, las im\u00e1genes que nos rodean se est\u00e1n convirtiendo r\u00e1pida y poderosamente m\u00e1s complicadas. El proyecto de la fundaci\u00f3n consiste en explorar las riesgos y contradicciones  de la imagen-documento, cuestionando un mundo en el que todo es visible. Organiza tres exhibiciones temporales cada a\u00f1o.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":"art_center","facebook_id":null,"backoffice_id":13764,"location":{"lat":50.82266385,"lon":4.32563819},"region":"brussels","last_updated_at":"2022-05-16T01:08:36+02:00","published_at":"2013-10-19T01:38:02+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":251684,"translations":{"fr":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"Cr\u00e9\u00e9e \u00e0 l\u2019initiative d\u2019Astrid Ullens de Schooten, la Fondation A, reconnue d\u2019utilit\u00e9 publique, a ouvert ses por