name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-04-21","timestamp":"2023-04-21T00:00:00+02:00","is_only_by_appointment":true},"tags":[],"accessibilities":{"list":[255,259,263,266],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","Brussels Health Safety Label"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Brussels Health Safety Label"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Brussels Health Safety Label"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Brussels Health Safety Label"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti","Brussels Health Safety Label"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos","Brussels Health Safety Label"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-24T03:07:08+02:00","published_at":"2023-04-10T11:05:53+02:00","backoffice_id":275079,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.38891111873282},{"id":552968,"date_start":"2023-03-23","date_end":"2023-04-29","date_next":"2023-04-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Egregore\u2019s echoes : A Celebratory transmission of Collective Joy","shortdescr":"Les artistes, les intervenant.es et les publics seront amen\u00e9.es \u00e0 vivre et s\u2019interroger sur la n\u00e9cessit\u00e9 de promouvoir les cultures alternatives relatives au monde de la f\u00eate.\r\nLevons le voile des illusions pour c\u00e9l\u00e9brer la joie de la transformation collective.","longdescr":"Egregore\u2019s echoes : A Celebratory transmission of Collective Joy\r\nArtistes : Antoine Grenez & Edouard Jattiot\r\nCuration : St\u00e9phane Roy\r\nVernissage : 22.03.23 | 17:00 > 22:00\r\nFinissage : 29.04.23 | 17:00 > 22:00\r\nExpo : 23.03.23 > 29.04.23\r\nLu\/Ma - Sa\/Za : 09:00 - 22:00\r\nGratuit - Entr\u00e9e Libre\r\n\r\n\r\nNotre exposition \u00e0 venir r\u00e9unit les propositions artistiques d\u2019Antoine Grenez et de Edouard Jattiot.\r\nLeurs productions plastiques et sonores mettent en lumi\u00e8re les rapports de la jeunesse \u00e9clectique \u00e0 la f\u00eate, au sein des cultures alternatives.\r\nLes artistes, les intervenant.es et les publics seront amen\u00e9.es \u00e0 vivre et s\u2019interroger sur la n\u00e9cessit\u00e9 de reconna\u00eetre et de promouvoir les cultures alternatives relatives au monde de la f\u00eate et ses symboliques soci\u00e9tales.\r\n\r\nL\u2019imaginaire est un stade primaire du r\u00e9el et une fois mis en forme avec une intention commune, il prend forme et se condense sous forme d\u2019\u00e9gr\u00e9gore (eth: \u00e9gr\u00e9gora, par- fait d\u2019\u03ad\u03b3\u03b5\u03af\u03c1\u03c9, faire lever, \u00e9veiller, r\u00e9veiller). L\u2019\u00e9gr\u00e9gore est un concept qui d\u00e9crit l\u2019\u00e9nergie subtile cr\u00e9\u00e9e par un groupe d\u2019individu.es uni.es par une m\u00eame intention. Quiconque adh\u00e8re \u00e0 la conscience de cette \u00e9nergie a plein acc\u00e8s au champ d\u2019information et \u00e0 la puissance de ce syst\u00e8me. Ce que vous \u00eates capables d\u2019\u00e9laborer par la pens\u00e9e et de percevoir d\u00e9finit les limites de ce que vous \u00eates en mesure de r\u00e9aliser. Cette force psychique peut \u00eatre consid\u00e9r\u00e9e comme un esprit collectif s\u2019inscrivant dans la noosph\u00e8re, la couche mentale plan\u00e9taire.\r\n\r\nLes sens ne laissent entrevoir que la surface des choses, l\u2019image aussi. La question est : \u00ab comment aller au de-l\u00e0 ? \u00bb. Approfondir la superficialit\u00e9 de l\u2019image comme celle de l\u2019humain.e, \u00e0 la d\u00e9couverte sans fond des paysages int\u00e9rieurs. Rendre compte des \u00e9changes \u00e9nerg\u00e9tiques inconscients ; faire vibrer la mati\u00e8re jusqu\u2019\u00e0 son \u00e9vaporation. Levons le voile des illusions pour c\u00e9l\u00e9brer la joie de la transformation collective.\r\nLa nuit est un r\u00e9ceptacle \u00e0 r\u00eave o\u00f9 l'on distingue avec peine les \u00e9toiles des satellites ; ces constellations invisibles, tisseuses de liens, transmettent sans d\u00e9tour les particules lumineuses qui composent chaque \u00eatre.\r\n\r\n\r\n\r\nTEMPS FORTS DE L\u2019EXPOSITION\r\n\r\nL\u2019exposition Egr\u00e9gore souhaite d\u00e9passer les modes de monstration classiques. Elle tient plut\u00f4t \u00e0 proposer un espace de rencontre, de dialogue et de cr\u00e9ation, pour les artistes et les intervenants invit\u00e9s, mais aussi pour les publics prenant directement part \u00e0 ce moment festif.\r\nLa recherche commune men\u00e9e de mani\u00e8re organique, permettra de g\u00e9n\u00e9rer de nouveaux contenus.\r\nL\u2019objectif final sera de collecter l\u2019ensemble des contenus discut\u00e9s, cr\u00e9\u00e9s et \u00e9chang\u00e9s, dans le but de mener un projet d\u2019\u00e9dition, puis de transmettre aux personnes concern\u00e9es les conclusions relev\u00e9es quant \u00e0 la situation actuelle au niveau de la jeunesse bruxelloise li\u00e9e au domaine de la f\u00eate.\r\nL\u2019ensemble de cette programmation est gratuit, ouverte \u00e0 toutes et tous.\r\n\r\nEGREGORE - NUIT ITIN\u00c9RANTE\r\nLes 23\/03\/23 et 06\/04\/23 de 17:00 \u00e0 22:00 (sur invitation)\r\nCes moments de recherches et de discussions portent sur la nuit itin\u00e9rante bruxelloise et de l\u2019environnement dans lequel les collectifs\/structures \u00e9voluent afin d\u2019\u00e9mettre des pistes d\u2019am\u00e9lioration pour le futur de nos communaut\u00e9s en R\u00e9gion Bruxelles Capitale.\r\nLe but de ce projet est d\u2019\u0153uvrer pour la reconnaissance et la n\u00e9cessit\u00e9 de la culture dans la soci\u00e9t\u00e9 contemporaine et d\u2019ouvrir le d\u00e9bat sur la diffusion et la promotion de la culture alternative.\r\n\r\nEXTATIQUE DANCE\r\nRendez-vous hebdomadaire pour une session de danse, d\u00e9construisant la n\u00e9cessit\u00e9 de l\u2019intoxication pour la mise en mouvement du corps. Proposer \u00e0 un public ouvert \u00e0 toutes les cat\u00e9gories d\u2019\u00e2ges.\r\nProposition de voyage musicale par les artistes curat\u00e9s \u00e0 cette occasion.\r\nSession accompagn\u00e9e de CharloveAngel, performeuse qui encadrera les sessions.\r\n\u2022Mercredi 29 Mars - 18h-21h : DJ ANTOINE 80\r\n\u2022Mercredi 5 avril - 18h-21h : DJ OHN\r\n\u2022Mercredi 12 avril - 18-21h : DJ LOU\r\n\u2022Lundi 17 avril - 19h-22h : DJ CATHERINE DANGER B2B DAYAHUASCA\r\n\u2022Jeudi 20 avril - 18h-21h : DJ YOKIN\r\n\r\n\r\nWORKSHOPS\r\n\r\nYanis Sabir \r\nMercredi 19\/04 + 27\/04 de 13h \u00e0 22h:\r\nApprentissage du processus du jeu vid\u00e9o sur Unity et d\u2019une mise en situation des possibilit\u00e9s de la r\u00e9alit\u00e9 augment\u00e9e dans une pratique culturelle et soci\u00e9tale.\r\n\r\nLucas Segovia - Lux18 \r\n(date en attente de confirmation)\r\nWorkshop initiation Ableton pour compr\u00e9hension d\u2019une production musicale. Le workshop sera ax\u00e9 sur la cr\u00e9ation de contenu et d\u00e9monstration de l\u2019utilisation des outils qui y seront li\u00e9s.\r\nOuvert \u00e0 tous.\r\n\r\nPsychedelic Society of Belgium\r\nJeudi 13\/04 - 19h\r\nSession d\u2019int\u00e9gration et r\u00e9union des membres de la soci\u00e9t\u00e9 psych\u00e9d\u00e9lique de Belgique. Discussion autour de la r\u00e9duction des risques li\u00e9 aux psych\u00e9d\u00e9liques ainsi que leurs propri\u00e9t\u00e9s th\u00e9rapeutiques\r\n\r\nFanzine participatif \r\ndu 21\/04 au 23\/04\r\nR\u00e9alisation d\u2019un fanzine avec comme base les images du monde de la nuit apport\u00e9es par les collectifs.\r\nCollaboration avec l\u2019Enfant Sauvage pour la cr\u00e9ation et l\u2019encadrement du workshop.\r\nOuvert \u00e0 tout \u00e2ge. Le travail r\u00e9alis\u00e9 durant le workshop sera synth\u00e9tis\u00e9 par les artistes de l\u2019exposition afin de cr\u00e9er un objet final.\r\n\r\n\r\nTALKS & INTERVENTIONS\r\nle 27\/04\/23 de 17:00 \u00e0 22:00\r\n\r\nInvit\u00e9s, sous r\u00e9serve de confirmation :\r\n\r\nPsychedelic society Belgium\r\nDiscussion sur les vertus th\u00e9rapeutiques et transformatives des drogues psych\u00e9d\u00e9liques. Mise en lumi\u00e8re des utilisations en des temps imm\u00e9moriaux pour se connecter plus profond\u00e9ment avec soi-m\u00eame. Cr\u00e9ation et mise \u00e0 disposition d\u2019un syst\u00e8me de r\u00e9duction des risques ad\u00e9quat.\r\n\r\nEgr\u00e9gore\r\nExplication de l\u2019intention de l\u2019exposition - Discussion entre les artistes et le curateur\r\n\r\nOsmose\r\nPr\u00e9sentation d\u2019une jeune initiative dans la nuit bruxelloise, c\u2019est une soci\u00e9t\u00e9 d\u2019angels (responsable de nuit; care team) en premi\u00e8re ligne pour aider les personnes victime d\u2019agression sexuelle, ou toute personne en situation de d\u00e9tresse. L\u2019id\u00e9e ici est de proposer un mod\u00e8le \u00e0 suivre pour toutes les structures de nuit en cas de violences sexistes et\/ou sexuelles.\r\n\r\nLa Zinz - L\u2019accroche - Allee du kaai\r\nPrise de parole sur la condition de l\u2019occupation temporaire face \u00e0 la gentrification de la ville par les pouvoir d\u00e9cisionnels, quel refuge pour l\u2019initiative alternative culturelle et sociale.\r\n\r\nChanoirs\r\nConstellation d'artistes questionnant le futur de l\u2019art et de la vie nocturne berc\u00e9 par les technologies. Ils s\u2019approprient les espaces physiques et virtuels pour flouter les limites entre les deux. Sensibilisation aux questions de demain concernant l\u2019int\u00e9gration des technologies web3 dans le monde de la nuit. D\u00e9couverte des potentiels de la r\u00e9alit\u00e9 augment\u00e9e pour la nuit alternative, gamification de la culture.\r\n\r\nCulture itin\u00e9rante\r\nDiscussion sur le rassemblement des diff\u00e9rents collectifs bruxellois et l\u2019importance d\u2019unir leur voix pour se faire entendre. Rouvrir les d\u00e9bats et d\u00e9montrer l\u2019importance de la reconnaissance de cette culture. Il s\u2019agira d\u2019exprimer un r\u00e9sum\u00e9 des rencontres collective sur le sujet, et donner la parole aux collectifs qui le d\u00e9sirent.\r\n\r\n\r\nRejoignez la f\u00eate, on n\u2019attend plus que vous !","performers":"Artistes : Antoine Grenez & Edouard Jattiot + guests\r\nCuration : St\u00e9phane Roy","boxoffice_url":null,"website":"https:\/\/touraplomb.be\/","email":"touraplomb@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552968"},"nl":{"name":"Egregore\u2019s echoes : A Celebratory transmission of Collective Joy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/touraplomb.be\/","email":"touraplomb@brucity.be","phone_contact":null,"phone_booking":null