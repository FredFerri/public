t":null},"cn":{"title":"Microaventure \u00e0 v\u00e9lo","copyright":null}}}],"dates":[{"day":"2023-07-27","doors":null,"start":"16:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & durable"],"nl":["Groen & duurzaam"],"en":["Green & sustainable"],"de":["Gr\u00fcn & nachhaltig"],"it":["Green e sostenibile"],"sp":["Ecol\u00f3gico y sostenible"],"pt":[null],"cn":[null]}},"tags":["exterior","velo_tourisme"],"is_part_of":"V\u00e9lo tourisme","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-26T20:35:04+02:00","published_at":"2023-06-20T14:19:16+02:00","backoffice_id":280051,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":556068,"date_start":"2023-07-28","date_end":"2023-07-28","date_next":"2023-07-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Jessie Jess","shortdescr":"Jessie Jess, c\u2019est le temps suspendu d\u2019une intimit\u00e9 d\u00e9voil\u00e9e.\r\n\r\nJean-Fran\u00e7ois Massy a quarante cinq ans. Il est fils d\u2019ouvrier. Il est transformiste.","longdescr":"Il n\u2019exerce pas son art dans un cabaret de la capitale, mais dans les petits villages de la Wallonie Picarde de son enfance. Ducasses, foires aux boudins, f\u00eates diverses ... Partout, quelles que soient des conditions de travail parfois franchement improbables, Jessie Jess, assure le show.\r\n\r\nDans une loge improvis\u00e9e, son cr\u00e9ateur, d\u00e9voilant sa technique de transformiste, devient sous nos yeux, son double travesti. Au fur et \u00e0 mesure que le corps se f\u00e9minise, que les gestes deviennent plus amples, l\u2019humour plus spectaculaire, dans cette langue truculente qui n\u2019appartient qu\u2019\u00e0 elle, Jessie r\u00e9v\u00e8le son quotidien\r\nd\u2019artiste, sa vie de troupe. Sous le masque lib\u00e9rateur de Jessie, Jean-Fran\u00e7ois raconte une autre histoire. Plus intime. Par touches impressionnistes, affleure la confession d\u2019un petit wallon, discrimin\u00e9 \u00e0 l\u2019\u00e9cole pour sa diff\u00e9rence, qui s\u2019est invent\u00e9 un avatar pour survivre et, finalement, se trouver. C\u2019est l\u2019histoire d\u2019une \u00e9mancipation. Sans \u00abretour\u00bb dans cette r\u00e9gion puisqu\u2019il ne l\u2019a jamais quitt\u00e9e. Le courage, parfois, c\u2019est de rester.","performers":"De: Jean-Fran\u00e7ois Massy et Fr\u00e9d\u00e9ric Dussenne\r\nMise en sc\u00e8ne: Fr\u00e9d\u00e9ric Dussenne \r\nAvec: Jean-Fran\u00e7ois Massy","boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.556068"},"nl":{"name":"Jessie Jess","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussel