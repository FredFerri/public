"2025-03-19T10:37:05+01:00","published_at":"2025-02-10T13:41:01+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317979,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.7937005259840998,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Saint-Cyr House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006452"},"pt":{"name":"BANAD Festival - Guided tour of the Saint-Cyr House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006452"},"en":{"name":"BANAD Festival - Saint-Cyr House","shortdescr":null,"longdescr":"The home of the painter Georges Saint-Cyr at 11, Square Ambiorix may be the best known, or at least the most extravagant, Art Nouveau house in Brussels. The fa\u00e7ade and interiors were recently restored thanks to a new owner who was determined to give new life to this masterpiece. While respecting the spirit and history of the house, architects and restorers made an effort to reintroduce coherence based on a thorough study of the building.\n\nArch. Gustave STRAUVEN,1900","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006452"},"it":{"name":"BANAD Festival - Guided tour of the Saint-Cyr House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006452"},"cn":{"name":"BANAD Festival - Guided tour of the Saint-Cyr House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006452"},"fr":{"name":"BANAD Festival - Maison Saint-Cyr","shortdescr":null,"longdescr":"Au n\u00b0 11 du Square Ambiorix, la maison personnelle du peintre Leonard de Saint-Cyr est peut \u00eatre la plus connue ou du moins la plus extravagante de l'Art nouveau dans notre ville de Bruxelles. La fa\u00e7ade a bien \u00e9t\u00e9 r\u00e9staur\u00e9e il y a peu mais le temps et les diff\u00e9rentes occupations du lieu ont consid\u00e9rablement affect\u00e9s l'int\u00e9rieur \u00e9galement. Son nouveau propri\u00e9taire \u00e9tait bien d\u00e9cid\u00e9 \u00e0 donner \u00e0 ce chef-d'oeuvre une nouvelle vie. Tout en gardant l'esprit de la maison et son histoire, les restaurateurs se sont appliqu\u00e9s \u00e0 redonner une coh\u00e9rence bas\u00e9e sur une \u00e9tude des plus compl\u00e8tes du b\u00e2timent.\n\nArch. Gustave STRAUVEN,1900","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006452"},"sp":{"name":"BANAD Festival - Guided tour of the Saint-Cyr House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006452"},"nl":{"name":"BANAD Festival - Saint-Cyr Huis","shortdescr":null,"longdescr":"Op nummer 11 van de Ambiorixsquare staat het priv\u00e9huis van de schilder Leonard de Saint-Cyr. Het is misschien wel het bekendste of tenminste het meest extravagante voorbeeld van de art nouveau in onze stad Brussel. De fa\u00e7ade is nog niet zo lang geleden gerestaureerd en de verschillende bezettingen van het huis hebben op het interieur een effect gehad. Zijn nieuwe eigenaar heeft beslist om aan dit meesterwerk een nieuw leven te geven. Met het behoud van de ziel van het huis en zijn geschiedenis in het achterhoofd, hebben de restaurateurs zich ingespannen om een samenhang te recre\u00ebren gebaseerd op de meest complete studie van het gebouw. Voor het eerst sinds het einde van de werken, heeft het BANAD Festival het genoegen u uit te nodigen voor een exclusieve herontdekking van deze iconische locatie van architect Gustave Strauven.\n\nArch. Gustave STRAUVEN,1900","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006452"}},"place":{"id":273589,"translations":{"de":{"name":"Maison Saint-Cyr","address_street_name":"1