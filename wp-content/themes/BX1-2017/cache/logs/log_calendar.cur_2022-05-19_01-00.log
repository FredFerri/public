alse,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Garden Tales \u2013 FleurAkker","shortdescr":"Garden Tales est un \u00e9v\u00e9nement annuel gratuit qui vous propose de visiter des jardins priv\u00e9s et publics \u00e0 Bruxelles.","longdescr":"FleurAkker est un projet de cueillette de fleurs. Tout comme les fruits et les l\u00e9gumes ont meilleur go\u00fbt lorsqu'ils sont r\u00e9colt\u00e9s localement, les fleurs cueillies ici et au bon moment retissent un v\u00e9ritable lien avec le temps et le lieu. Sur place, tout le monde peut suivre la croissance et admirer chaque fleur. Par un abonnement \u00e0 la cueillette \u00e0 un prix \u00e9quitable, FleurAkker maintient un espace vert pour des fleurs de haute qualit\u00e9, vraiment fra\u00eeches et durables.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.civa.brussels\/fr\/expos-events\/fleurakker-un-bouquet-de-senteurs","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533912.html"},"nl":{"name":"Garden Tales \u2013 FleurAkker","shortdescr":"Garden Tales is een jaarlijks evenement waarbij je gratis heel wat priv\u00e9- en publieke tuinen in Brussel kan bezoeken.","longdescr":"FleurAkker is een bloemenplukproject. Net zoals fruit en groenten beter smaken wanneer ze ter plaatse worden geoogst, cre\u00ebren bloemen die hier op het juiste moment worden geplukt een echte band met de tijd en de omgeving. Ter plaatse kan iedereen de groei van de bloemen volgen en bewonderen. Door middel van een plukabonnement aan een eerlijke prijs houdt FleurAkker een groene ruimte in stand voor kwalitatief hoogwaardige, verse en duurzame bloemen.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533912.html"},"en":{"name":"Garden Tales \u2013 FleurAkker","shortdescr":"Garden Tales is a free yearly festival that turns the spotlight on private and public gardens in Brussels.","longdescr":"FleurAkker is a flower-picking project. Just as fruit and vegetables taste better when harvested locally, flowers picked here at the right time strengthen a real connection with time and place. On site, everyone can admire each flower and watch them grow. Through a pick-your-own subscription at a fair price, FleurAkker maintains a green space for high-quality, fresh and sustainable flowers.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533912.html"},"de":{"name":"Garden Tales \u2013 FleurAkker","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533912.html"},"it":{"name":"Garden Tales \u2013 FleurAkker","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533912.html"},"sp":{"name":"Garden Tales \u2013 FleurAkker","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533912.html"},"pt":{"name":"Garden Tales \u2013 FleurAkker","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533912.html"},"cn":{"name":"Gar