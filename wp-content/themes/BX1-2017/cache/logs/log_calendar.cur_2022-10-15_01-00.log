],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T06:06:24+02:00","published_at":"2022-09-26T12:27:58+02:00","backoffice_id":262608,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":526808,"date_start":"2022-10-15","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival","de":"Festival"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Slow Ways Weekend 2022","shortdescr":"Slow Ways Weekend met les voies lentes \u00e0 l\u2019honneur le temps d\u2019un week-end festif. Bruxellois, qu\u2019ils soient randonneurs ou curieux, partent sur les chemins connus, passages m\u00e9connus ou encore les sentiers menac\u00e9s. Au c\u0153ur de la ville et en pleine nature. Le long de sentiers historiques ou au travers de nouvelles passerelles ou travers\u00e9es accessibles \u00e0 pied.","longdescr":"Saviez-vous qu'il existe plus de 800 km de sentiers sans trafic motoris\u00e9 ? Les voies lentes sont partout \u00e0 Bruxelles. Les 15 et 16 octobre, c'est le moment de d\u00e9couvrir ces sentiers phares, chemins agr\u00e9ables et itin\u00e9raires possibles \u00e0 pied.\r\n\r\nSlow Ways Weekend est la journ\u00e9e portes ouvertes de toutes les voies lentes de la R\u00e9gion de Bruxelles-Capitale. Gr\u00e2ce \u00e0 diverses organisations locales des activit\u00e9s sont \u00e0 d\u00e9couvrir aux quatre coins de Bruxelles.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.slowwaysweekend.be","email":"info@walk.brussels","phone_contact":"+32 483 04 69 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.526808"},"nl":{"name":"Slow Ways Weekend 2022","shortdescr":"Slow Ways Weekend zet trage wegen in de kijker tijdens een actieweekend. Brusselaars, wandelaars en andere levensgenieters, gaan op pad langs bekende, onbekende en zelfs bedreigde paadjes. In de stad en in het groen. Langs historische wegen of nieuwe doorsteken.","longdescr":"Wist je dat er meer dan 800 km paden zonder gemotoriseerd verkeer zijn? Trage wegen vind je overal in Brussel. Op 15 en 16 oktober is het moment om favoriete wegjes, gewaardeerde paden en populaire trajecten te ontdekken.\r\n\r\nSlow Ways Weekend is de opendeurdag voor alle trage wegen in het Brussels Hoofdstedelijk Gewest. Dankzij lokale besturen, werkgroepen en organisaties die overal een activiteit op poten zetten.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.526808"},"en":{"name":"Slow Ways Weekend 2022","shortdescr":"Slow Ways Weekend puts slow ways in the spotlight for a festive weekend. Brussels residents, whether they are hikers or curious, set off on known paths, little-known passages or even threatened paths. In the heart of the city and in the middle of nature. Along historic paths or through new footbridges or crossings accessible on foot.","longdescr":"Did you know that there are more than 800 km of trails without motorized traffic? Slow lanes are everywhere in Brussels. On October 15 and 16, it's time to discover these flagship trails, pleasant paths and possible routes on foot.\r\n\r\nSlow Ways Weekend is the open day for all slow ways in the Brussels-Capital Region. Thanks to various local organizations, activities can be discovered all over Brussels.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.526808"},"de":{"name":"Slow Ways Weekend 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.526808"},"it":{"name":"Slow Ways Weekend 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.526808"},"sp":{"name":"Slow Ways Weekend 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.526808"},"pt":{"name":"Slow Ways Weekend 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.526808"},"cn":{"name":"Slow Ways Weekend 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.526808"}},"place":{"id":276340,"translations":{"fr":{"name":"Walk Brussels","address_street_name":"Rue des Deux \u00c9glises","address_street_number":"47","address_street_box":null,"email":"info@walk.brussels","website":"http:\/\/www.walk.brussels","phone_contact":"+32 483 04 69 50","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Deux \u00c9glises, 47","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Walk Brussels","address_street_name":"Tweekerkenstraat","address_street_number":"47","address_street_box