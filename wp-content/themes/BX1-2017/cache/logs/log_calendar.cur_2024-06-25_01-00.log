t_major_event":false,"backoffice_id":283559,"facebook_link":null,"import_origin":"bronks","is_part_of":null,"sub_type":"other","ranking":0.14369997735954526,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.562466"},"pt":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.562466"},"en":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":"Belgian premi\u00e8re \n\u00a0","longdescr":"Six performers take to the stage. \nThey come from different families, cities and countries.\u00a0Their youth is their uniting factor. \nThey introduce themselves.\u00a0 They express themselves. \nThey listen to the voices of hundreds of others. \nThey carry the sound of young people across the world. \n\n They are the ambassadors of their generation. Through movement and interaction, they explore the vulnerability and power of being young. \nHopeful and combative. \nPropelled, supported and carried by the soundscape of dozens of young voices from across the world, woven into one universal blanket of sound.\u00a0\u00a0 \n\n  Beating Choir\/Ch\u0153ur Battant  is a production by the Canadian Th\u00e9\u00e2tre Le Carrousel and the Belgian BRONKS young theatre. Three adolescents from Quebec engage in artistic exchange with three youngsters from Brussels. The performance is a follow-up to the online platform \u2018Creative in Solitude\u2019, founded by choreographer and director Zo\u00eb Demoustier during the pandemic, where young artists were able to share their feelings via artistic expression.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.562466"},"it":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.562466"},"cn":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.562466"},"fr":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":"premi\u00e8re Belge \n \n\u00a0","longdescr":"Six artistes se trouvent sur la sc\u00e8ne. \nIls viennent de familles, de villes et de pays diff\u00e9rents. Leur jeunesse est ce qui les unit. \nIls se pr\u00e9sentent. Ils s\u2019expriment. \nIls \u00e9coutent les voix de centaines d\u2019autres. \nIls portent la voix de jeunes du monde entier. \n\n Ils sont les ambassadeurs de leur g\u00e9n\u00e9ration. Par le mouvement et l'interaction, ils partent \u00e0 la recherche de la vuln\u00e9rabilit\u00e9 et de la force de la jeunesse. \nIls sont remplis d\u2019espoir, ils sont combatifs. \nIls sont propuls\u00e9s, soutenus et port\u00e9s par le paysage sonore de dizaines de voix d\u2019autres jeunes issus des quatre coins du monde. Le tout se tisse pour former un tapis sonore universel. \n\n  Beating Choir \/ Ch\u0153ur Battant \u00a0est une production du th\u00e9\u00e2tre canadien Le Carrousel et du th\u00e9\u00e2tre belge BRONKS pour jeune public. Trois jeunes Qu\u00e9b\u00e9cois ont particip\u00e9 \u00e0 un \u00e9change artistique avec trois jeunes Bruxellois. Ce spectacle fait suite \u00e0 la plateforme en ligne \u2018Creative in Solitude\u2019 cr\u00e9\u00e9e en temps de pand\u00e9mie par la chor\u00e9graphe et metteuse en sc\u00e8ne Zo\u00eb Demoustier. Cette plateforme permettait aux jeunes de partager leurs \u00e9motions en passant par l\u2019expression artistique.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.562466"},"sp":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.562466"},"nl":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":"\u00a0","longdescr":"Zes performers staan op sc\u00e8ne. Afkomstig uit verschillende gezinnen, steden, landen, continenten. Hun jeugd is wat hen bindt. \n \nZe zoomen in. Ze zoomen uit. \nZe richten de blik naar binnen. Ze richten de blik naar buiten. \nZe spreken elkaar tegen. Ze versterken elkaar. \n \nZij zijn de ambassadeurs van hun generatie. Via beweging en interactie zoeken ze naar de kwetsbaarheid en de kracht in hun eigen jong zijn. Hoopvol en strijdvaardig. Voortgestuwd, gesteund en gedragen door de soundscape van tientallen stemmen van andere jongeren overal ter wereld, verweven tot een universeel geluidstapijt. \u00a0\u00a0 \n \n Beating Choir \/ Ch\u0153ur Battant  is een productie tussen het Canadese  Th\u00e9\u00e2tre Le Carrousel  en BRONKS. Drie jongeren uit Quebec gingen een artistieke uitwisseling aan met drie Brusselse jongeren. De voorstelling is een vervolg op het online platform  Creative in Solitude  dat choreografe en regisseur Zo\u00eb Demoustier tijdens de pandemie oprichtte en waar jongeren via een artistieke expressie hun gevoelens konden delen.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.562466"}},"place":{"id":243112,"translations":{"de":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Brussels","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Brussels","description_web":"BRONKS is Brussels\u2019 Dutch-language theatre for young audiences with own productions and a varied and well-considered choice of guest productions in which both beginners and established artists are asked to deal with relevant and provocative topics in a way that appeals to a young audience. BRONKS productions are appealing and relaxing, but also contrary and demanding. It is theatre that reflects on the world and provides means by which to understand it better. BRONKS has also an extensive educational operation and organises festivals and events to suit a variety of audience groups. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":"BRONKS, c\u2019est le th\u00e9\u00e2tre bruxellois n\u00e9erlandophone pour jeune public. BRONKS se veut une plateforme offrant aux artistes la possibilit\u00e9 d\u2019aborder devant un public jeune des th\u00e8mes pertinents et audacieux. Les artistes sont invit\u00e9s \u00e0 cr\u00e9er des pi\u00e8ces qui respirent l\u2019esprit BRONKS : du th\u00e9\u00e2tre qui peut \u00eatre beau et d\u00e9contractant, mais aussi non-conformiste et empreint d\u2019un esprit de contradiction. Du th\u00e9\u00e2tre qui r\u00e9fl\u00e9chit sur le monde qui l\u2019entoure.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"BRONKS ","address_street_name":"Varkensmarkt","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Brussel","address_line1":"Varkensmarkt, 15-17","address_line2":"1000 Brussel","description_web":"BRONKS is het Nederlandstalige theater voor een jong publiek in Brussel. Sedert  21 maart 2009 gevestigd in het opvallende gebouw ontworpen door MDMA (Martine De Maeseneer Architects) aan de Varkensmarkt, maakt en toont BRONKS bijzonder, relevant en kwaliteitsvol theater voor en met kinderen en jongeren. Het programma wordt samengesteld vanuit de wil om te verrassen, risico\u2019s te nemen, te confronteren en blijk te geven van intelligentie en humor, zowel in de eigen voorstellingen als in de diverse en doordachte gastprogrammatie. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":5501,"location":{"lat":50.85310831,"lon":4.34614873},"region":"brussels","last_updated_at":"2023-09-21T15:20:49+02:00","published_at":"2013-10-19T01:18:50+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":243112,"translations":{"de":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_st