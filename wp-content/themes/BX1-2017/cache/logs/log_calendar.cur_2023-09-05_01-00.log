:null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":281828,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"tour","ranking":0.17981414446461677,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[112],"translations":{"de":["Ausgefallenes"],"pt":[null],"en":["Unusual"],"it":["Insolito"],"cn":[null],"fr":["Insolite"],"sp":["Ins\u00f3lito"],"nl":["Ongewoon"]}}},"translations":{"de":{"name":"Si t'y danses \u2014 balade 3 : Danser les volutes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sitydanses.be","email":"sitydanses@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000065"},"pt":{"name":"Si t'y danses \u2014 balade 3 : Danser les volutes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sitydanses.be","email":"sitydanses@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000065"},"en":{"name":"Si t'y danses \u2014 balade 3 : Danser les volutes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sitydanses.be","email":"sitydanses@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000065"},"it":{"name":"Si t'y danses \u2014 balade 3 : Danser les volutes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sitydanses.be","email":"sitydanses@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000065"},"cn":{"name":"Si t'y danses \u2014 balade 3 : Danser les volutes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sitydanses.be","email":"sitydanses@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000065"},"fr":{"name":"Si t'y danses \u2014 balade 3 : Danser les volutes","shortdescr":"T\u00e9l\u00e9chargeable gratuitement, l\u2019application mobile \u00ab Si t\u2019y danses \u2013 balades urbaines \u00bb permet de faire trois balades \u00e0 Bruxelles et \u00e0 Saint-Gilles en toute autonomie. Les balades invitent \u00e0 poser un regard nouveau sur la ville et son patrimoine architectural, tout en mettant en lumi\u00e8re l\u2019art chor\u00e9graphique.","longdescr":"\u00c0 chaque \u00e9tape du parcours, une citation sur la danse appara\u00eet sur smartphone, r\u00e9v\u00e9lant une dimension po\u00e9tique, politique ou sociale de cet art du mouvement. Apr\u00e8s avoir positionn\u00e9 la citation en r\u00e9alit\u00e9 augment\u00e9e dans l\u2019espace qui les entoure, les participant.es ont acc\u00e8s \u00e0 un bonus li\u00e9 : vid\u00e9os d\u2019archives, invitations \u00e0 danser, explorations guid\u00e9es, cr\u00e9ations et anecdotes historiques\u2026 Cette troisi\u00e8me balade met en lumi\u00e8re le matrimoine et le patrimoine Art nouveau de la commune, ainsi que ses espaces verts. Au gr\u00e9 du parcours, les liens se tissent entre danse et architecture, individus et collectif dans les rues de la commune aux 140 nationalit\u00e9s.\n\n> 2,2 km - 1h30 - petit d\u00e9nivel\u00e9 et escaliers au d\u00e9part du jardin H\u00e9l\u00e8ne de Rudder, 11 rue de Rome, 1060 Saint-Gilles.\n\n1)T\u00e9l\u00e9chargez gratuitement l\u2019application :\n\n> App Store : https:\/\/apps.apple.com\/fr\/app\/si-ty-danses\/id1616615527\n\n> Play Store https:\/\/play.google.com\/store\/apps\/details?id=com.ArteamInteractive.BaladesUrbaines\n\n2) Baladez-vous\n\n> S\u00e9lectionnez la balade que vous souhaitez faire. Gr\u00e2ce \u00e0 l\u2019outil de g\u00e9olocalisation, rejoignez l\u2019une des \u00e9tapes du parcours. Il est possible de commencer les balades de n\u2019importe quelle \u00e9tape mais nous vous conseillons vivement de commencer par la premi\u00e8re pour une meilleure exp\u00e9rience.\n\n> D\u00e9couvrez une anecdote sur le patrimoine \u00e0 chaque \u00e9tape et suivez l\u2019itin\u00e9raire trac\u00e9 sur la carte.\n\n3) Interagissez avec l\u2019espace urbain\n\n> Une fois arriv\u00e9.e \u00e0 l\u2019endroit indiqu\u00e9, une citation sur la danse ainsi qu\u2019une anecdote historique lui faisant \u00e9cho apparaissent dans l\u2019application.\n\n> Gr\u00e2ce \u00e0 votre appareil photo, positionnez la citation en r\u00e9alit\u00e9 augment\u00e9e dans l\u2019espace qui vous entoure.\n\n> Enregistrez votre photo, modifiez-la si vous le souhaitez, pour d\u00e9bloquer le bonus.\n\n4) Profitez des bonus\n\n> Explorations guid\u00e9es, vid\u00e9os d\u2019archives, cr\u00e9ations et invitations \u00e0 danser, les bonus prennent des formes vari\u00e9es.\n\n> Retrouvez tous les bonus d\u00e9bloqu\u00e9s dans la partie \u00ab galerie \u00bb de l\u2019application.","performers":"Anne Golaz et Florence Corin","boxoffice_url":null,"website":"https:\/\/www.sitydanses.be","email":"sitydanses@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000065"},"sp":{"name":"Si t'y danses \u2014 balade 3 : Danser les volutes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sitydanses.be","email":"sitydanses@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000065"},"nl":{"name":"Si t'y danses \u2014 balade 3 : Danser les volutes","shortdescr":null,"long