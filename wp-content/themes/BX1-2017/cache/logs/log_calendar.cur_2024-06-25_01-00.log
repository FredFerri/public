accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-24T02:00:51+02:00","published_at":"2024-05-13T08:16:56+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":300048,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2106389788843754,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Melodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mimikunz.com\/","email":"2mimikunz@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010545"},"pt":{"name":"Melodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mimikunz.com\/","email":"2mimikunz@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010545"},"en":{"name":"Melodies","shortdescr":"In the exhibition \u2018Melodies\u2019 Mimi Kunz explores movement as a universal expression of liveliness. The presented ink paintings are about body language, showing how much we say while we say nothing at all. The artworks feature hand made Japanese paper, rice paper and Awagami bamboo paper, exploring layers and textures, rhythm and time.","longdescr":"In the exhibition \u2018Melodies\u2019 Mimi Kunz explores movement as a universal expression of liveliness. The presented ink paintings are about body language, showing how much we say while we say nothing at all. The artworks feature hand made Japanese paper, rice paper and Awagami bamboo paper, exploring layers and textures, rhythm and time.\n\n\nSitting on the floor with calligraphy brushes, the artist captures the essence of fleeting moments in a meditative way, opening the borders between abstraction and figuration, lines and bodies in minimalist gestures. \"Put the mind in the body\", a buddhist monk once told her \u2014 advice which shaped her life and art.","performers":"Mimi Kunz (painter, poet)\nCl\u00e9lia Dell'Aiera (jewellery designer, curator)","boxoffice_url":null,"website":"https:\/\/mimikunz.com\/","email":"2mimikunz@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010545"},"it":{"name":"Melodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mimikunz.com\/","email":"2mimikunz@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010545"},"cn":{"name":"Melodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mimikunz.com\/","email":"2mimikunz@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010545"},"fr":{"name":"Melodies","shortdescr":"\nDans l'exposition \"M\u00e9lodies\", Mimi Kunz explore le mouvement en tant qu'expression universelle de la vivacit\u00e9. Les peintures \u00e0 l'encre pr\u00e9sent\u00e9es parlent du langage corporel et montrent tout ce que nous disons alors que nous ne disons rien du tout. ","longdescr":"Dans l'exposition \"M\u00e9lodies\", Mimi Kunz explore le mouvement en tant qu'expression universelle de la vivacit\u00e9. Les peintures \u00e0 l'encre pr\u00e9sent\u00e9es parlent du langage corporel et montrent tout ce que nous disons alors que nous ne disons rien du tout. Les \u0153uvres sont r\u00e9alis\u00e9es avec du papier japonais fabriqu\u00e9s \u00e0 la main, du papier de riz et du papier de bambou Awagami, explorant les couches et les textures, le rythme et le temps.\n\nAssise sur le sol avec des pinceaux de calligraphie, l'artiste capture l'essence de moments \u00e9ph\u00e9m\u00e8res d'une mani\u00e8re m\u00e9ditative, ouvrant les fronti\u00e8res entre l'abstraction et la figuration, les lignes et les corps dans des gestes minimalistes. Un moine bouddhiste lui a dit un jour : \"Mettez l'esprit dans le corps\", un conseil qui a fa\u00e7onn\u00e9 sa vie et son art.","performers":null,"boxoffice_url":null,"website":"https:\/\/mimikunz.com\/","email":"2mimikunz@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010545"},"sp":{"name":"Melodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mimikunz.com\/","email":"2mimikunz@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010545"},"nl":{"name":"Melodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mimikunz.com\/","email":"2mimikunz@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010545"}},"place":{"id":50001696,"translations":{"de":{"name":"Alto Galleria","address_street_name":"Rue du Bailli","address_street_number":"52","address_street_box":null,"email":null,"website":"https:\/\/altogalleria.com\/en\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Bailli, 52","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Alto Galle