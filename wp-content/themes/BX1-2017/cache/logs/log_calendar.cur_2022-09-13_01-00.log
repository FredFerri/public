\r\nARAU can arrange these tours on request for private groups throughout the year, tailored to your specific requirements regarding date, time, duration and language (French, English, Dutch, German, Spanish or Italian). So if you would like to follow a guided tour of Brussels with qualified guides in a convivial atmosphere, contact us!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Adolphe Max","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Adolphe Max","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Adolphe Max","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address