1","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-01","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-02","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-03","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-04","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-05","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-07","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-08","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-09","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-10","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-11","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-12","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-14","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-15","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-16","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-17","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-18","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-19","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-21","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-22","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-23","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-24","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-25","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-26","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-28","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-29","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-06-30","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-07-01","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-07-02","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-07-03","doors":null,"start":"10:00:00","end":"17:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 17:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 17:00"],"en":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 17:00"]},"date_start":"2022-05-20","date_end":"2022-07-03","is_also_by_appointment":false}],"date_exceptions":[{"day":"2022-05-26","start":"17:00:00","end":"22:00:00"}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":11},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,256,257,259,261,263,265,266],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-17T17:35:04+02:00","published_at":"2022-05-17T17:08:16+02:00","backoffice_id":253908,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.35421952306087},{"id":529075,"date_start":"2022-05-20","date_end":"2022-05-22","date_next":"2022-05-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Art Truc Troc & Design 2022","shortdescr":"Apr\u00e8s deux ans d'absence, Art Truc Troc & Design fait son grand retour pour cette 17e \u00e9dition. Retrouvez-nous \u00e0 la Gare Maritime de Tour & Taxis ce 20, 21 et 22 mai 2022.","longdescr":"Apr\u00e8s deux ans d\u2019absence, Art Truc Troc & Design fait son grand retour pour cette 17e \u00e9dition dans un tout nouvel endroit qui n\u2019est autre que la Gare Maritime de Tour & Taxis.\r\nArt Truc Troc & Design, c\u2019est quoi?\r\nC\u2019est un concept unique r\u00e9unissant plus de 300 artistes \u00e0 travers une exposition o\u00f9 le troc est la seule monnaie accept\u00e9e. \r\nFl\u00e2nez \u00e0 travers ce parcours empli d\u2019art et d\u00e9couvrez pr\u00e8s de 200 \u0153uvres r\u00e9alis\u00e9es par des artistes en tous genres.\r\nCette ann\u00e9e, back to basics.\r\nPas de th\u00e8me. Pas de limite. De l\u2019art sous toutes ses formes, tout simplement.\r\nUne exposition qui ravira tout amateur d\u2019art, et o\u00f9 chacun pourra exprimer sa cr\u00e9ativit\u00e9 dans l\u2019amusement et la bonne humeur \u00e0 travers diff\u00e9rentes activit\u00e9s et workshops.\r\nAfin de mettre en lumi\u00e8re les talents qui d\u00e9ambulent dans les couloirs de nos \u00e9coles d\u2019art belges, un espace sera enti\u00e8rement d\u00e9di\u00e9 \u00e0 la d\u00e9couverte du travail de ces \u00e9tudiants, pour un voyage dans le temps vers le monde artistique belge du futur. \r\nSans oublier la cerise sur le g\u00e2teau, une soir\u00e9e d\u2019ouverture o\u00f9 visiteurs et artistes se rassembleront autour d\u2019un verre ou sur la piste de danse. \r\nRendez-vous ces 20,21 et 22 mai 2022 \u00e0 la Gare Maritime de Tour et Taxi pour prendre part \u00e0 cette aventure artistique.\r\n\r\nProgramme:\r\nVendredi 20 mai : \r\n18h-03h - Opening, Exhibition & Opening Party\r\n\r\nSamedi 21 mai : \r\n14h-21h - Exhibition & Workshops\r\n\r\nDimanche 22 mai : \r\n10h-18h - Breakfast, Exhibition\r\n\r\nLieu\r\nRue Picard 7\r\n1000 Bruxelles\r\n\r\nWebsite: https:\/\/tructroc.be\/\r\nFacebook: https:\/\/www.facebook.com\/arttructroc\/?ref=bookmarks\r\nInstagram: https:\/\/www.instagram.com\/arttructroc\/?hl=fr\r\nEvent Facebook: https:\/\/www.facebook.com\/events\/491006929300092","performers":"Fran\u00e7ois Coorens (pr\u00e9sident du jury de s\u00e9lection des artistes)","boxoffice_url":null,"website":"http:\/\/beegroupe.com\/","email":"info@beegroupe.be","phone_contact":"+32 2 741 63 20","phone_booking":"+32 2 741 63 20","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529075.html"},"nl":{"name":"Art Truc Troc & Design 2022","shortdescr":"Na twee jaar afwezigheid is Art Truc Troc & Design terug voor zijn 17de editie. Ontmoet ons bij het Gare Maritime van Tour & Taxis op 20, 21 en 22 mei 2022.","longdescr":"Na een afwezigheid van twee jaar is Art Truc Troc & Design eindelijk terug voor zijn 17de editie op een gloednieuwe locatie, la Gare Maritime van Tour & Taxis.\r\nWat is Art Truc Troc & Design?\r\nHet is een uniek concept dat meer dan 300 kunstenaars samenbrengt in een tentoonstelling waar ruilhandel de enige aanvaarde valuta is.\r\nFlaneer door deze tentoonstelling vol kunst en ontdek zo\u2019n 200 werken van kunstenaars van allerlei genres.\r\nDit jaar, keren we terug naar de basis.\r\nGeen thema. Geen grenzen. Gewoon kunst in al zijn vormen.\r\nEen tentoonstelling die alle kunstliefhebbers zal bekoren, en waar iedereen zijn creativiteit op een leuke en gezellige manier kan zal kunnen uiten via verschillende activiteiten en workshops.\r\nOm het talent van onze Belgische kunststudenten in de kijker te zetten, zal er een volledige ruimte gewijd worden aan hun werken om op die manier een reis door de tijd te maken naar de Belgische kunstwereld van de toekomst.\r\nEn laten we de kers op de taart niet vergeten! Er zal namelijk een openingsfeest plaatsvinden waar bezoekers en artiesten elkaar kunnen ontmoeten onder het genot van een drankje of op de dansvloer. \r\nWe zien elkaar op 20, 21 en 22 mei 2022 in la Gare Maritime in Tour & Taxi om deel te nemen aan dit artistiek avontuur! \r\n\r\nProgramma:\r\nVrijdag 20 mei: \r\n18h-03h - Opening, tentoonstelling & openingsfeest\r\n\r\nZaterdag 21 mei : \r\n14.00 - 21.00 uur - Tentoonstelling & Workshops\r\n\r\nZondag 22 mei : \r\n10.00 - 18.00 uur - Ontbijt, Tentoonstelling\r\n\r\nLocatie\r\nRue Picard 7\r\n1000 Brussel\r\n\r\nWebsite: https:\/\/tructroc.be\/\r\nFacebook: https:\/\/www.facebook.com\/arttructroc\/?ref=bookmarks\r\nInstagram: https:\/\/www.instagram.com\/arttructroc\/?hl=fr\r\nEvent Facebook: https:\/\/www.facebook.com\/events\/491006929300092","performers":"Fran\u00e7ois Coorens (voorzitter van de jury voor de selectie van kunstenaars)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529075.html"},"en":{"name":"Art Truc Troc & Design 2022","shortdescr":"After two years of absence, Art Truc Troc & Design is back for its 17th edition. Meet us at the Gare Maritime of Tour & Taxis on 20, 21 and 22 May 2022.","longdescr":"After two years of absence, Art Truc Troc & Design is back for its 17th edition in a brand new location which is none other than the Gare Maritime of Tour & Taxis.\r\nWhat is Art Truc Troc & Design?\r\nIt's a unique concept bringing together more than 300 artists through an exhibition where barter is the only accepted currency. \r\nStroll through this art-filled journey and discover nearly 200 works by artists of all kinds.\r\nThis year, back to basics.\r\nNo theme. No limits. Simply art in all its forms.\r\nAn exhibition that will delight all art lovers, and where everyone will be able to express their creativity in fun and good humor through various activities and workshops.\r\nIn order to highlight the talents that wander through the corridors of our Belgian art schools, a space will be entirely dedicated to the discovery of the work of these students, for a journey through time towards the Belgian art world of the future. \r\nNot forgetting the icing on the cake, an opening party where visitors and artists will gather around a drink or on the dance floor. \r\nSee you these May 20,21 and 22, 2022 at the Tour et Taxi Maritime Station to take part in this artistic adventure.\r\n\r\nProgram:\r\nFriday, May 20 : \r\n18h-03h - Opening, Exhibition & Opening Party\r\n\r\nSaturday May 21 : \r\n2-9pm - Exhibition & Workshops\r\n\r\nSunday May 22 : \r\n10am-6pm - Breakfast, Exhibition\r\n\r\nLocation\r\nRue Picard 7\r\n1000 Brussels\r\n\r\nWebsite: https:\/\/tructroc.be\/\r\nFacebook: https:\/\/www.facebook.com\/arttructroc\/?ref=bookmarks\r\nInstagram: https:\/\/www.instagram.com\/arttructroc\/?hl=fr\r\nEvent Facebook: https:\/\/www.facebook.com\/events\/491006929300092","performers":"Fran\u00e7ois Coorens (president of the jury for the selection of artists)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529075.html"},"de":{"name":"Art Truc Troc & Design","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529075.html"},"it":{"name":"Art Truc Troc & Design","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529075.html"},"sp":{"name":"Art Truc Troc & Design","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529075.html"},"pt":{"name":"Art Truc Troc & Design","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529075.html"},"cn":{"name":"Art Truc Troc & Design","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529075.html"}},"place":{"id":258279,"translations":{"fr":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"La Gare Maritime : l'ancienne gare de fret devenue jungle urbaine, neutre en \u00e9nergie !\r\n\r\nElle offre le cadre id\u00e9al pour les \u00e9v\u00e9nements culturels innovants, les tournages de films ou s\u00e9ances photo, les march\u00e9s et foires, les lancements et promotions de produits. Les halles de la Gare Maritime ont \u00e9t\u00e9 transform\u00e9es en ville int\u00e9rieure. Elle comportera son propre food hall (\u00e0 partir de septembre 2021), des magasins exclusifs et des bureaux. Dans ce complexe, des espaces uniques et inspirants sont entrecoup\u00e9s de structures en bois chaleureuses. Le b\u00e2timent se pr\u00eate \u00e0 l'organisation de rencontres en petit comit\u00e9 ou de grands happenings. La nef monumentale, attrait architectural, est baign\u00e9e de lumi\u00e8re naturelle indirecte et offre suffisamment d'espace pour les activit\u00e9s int\u00e9rieures bien fr\u00e9quent\u00e9es.\r\nTout \u00e9v\u00e8nement dans la Gare Maritime sera un \u00e9v\u00e8nement \u00e9co-responsable. La durabilit\u00e9 \u00e9tait \u00e0 l'avant-plan pendant les r\u00e9novations du b\u00e2timent. L'\u00e9nergie renouvelable est produite sur place, utilisant la g\u00e9othermie et des panneaux photovolta\u00efques. Sur les promenades vertes bordant la nef centrale, des jardins \u00e0 th\u00e8me et des arbres \u00e0 haut tronc ont \u00e9t\u00e9 amen\u00e9s - comme si le parc voisin se faufile dans le b\u00e2timent. \r\nLa Gare Maritime, un lieu unique : attractif, novateur, ambitieux.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat","address_line2":"1000 Brussel","description_web":"Gare Maritime: van industrieel goederenstation tot energieneutrale urban jungle!\r\n\r\nDe Gare Maritime is de perfecte setting voor innovatieve, culturele evenementen, film- en fotoshoots, markten, beurzen, lanceringen en promoties. De historische stationshallen van de Gare Maritime zijn omgevormd tot overdekte stad, met foodhall (vanaf september 2021), exclusieve winkels en kantoren. Het gebouwencomplex biedt een waaier aan unieke, inspirerende ruimtes afgewisseld met warme houten volumes: perfect voor de organisatie van kleine en grootschalige happenings. D\u00e9 architecturale eyecatcher is de monumentale middenbeuk die baadt in indirect daglicht en over meer dan voldoende ruimte beschikt voor overdekte activiteiten met veel bezoekers.\r\nEen event in de Gare Maritime is een groen event. Tijdens de renovatie van het gebouw was duurzaamheid een speerpunt. Energie wordt ter plaatse hernieuwbaar opgewekt met geothermie en zonnepanelen. De groene wandelboulevards aan weerszijden van de middenbeuk zijn voorzien van thematuinen en hoogstammige bomen, alsof het aangrenzende park het gebouw binnenstroomt. Gare Maritime is een unieke plek: aantrekkelijk, vernieuwend en ambitieus.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard","address_line2":"1000 Brussels","description_web":"The Gare Maritime - From industrial freight station to energy neutral urban jungle!\r\n\r\nIt is the perfect setting for innovative cultural events, film or photo shoots, trade shows, fairs, product launches or promotions. \r\nThe historic station concourse that was part of the Gare Maritime has been transformed into an indoor city with its own food hall (coming September 2021), exclusive shops and offices. Countless unique and inspiring areas and warm, wooden structures alternate in this building complex. It is perfectly suited to accommodate both small and major events. The monumental nave is a true architectural eye-catcher, bathed in indirect sunlight and providing ample space for well-attended indoor activities.\r\nAny event in the Gare Maritime is a green event. Sustainability has been key during the renovation works. The building generates its own energy from renewable sources, using geothermics and solar panels. The green boulevards on either side of the nave are lined with themed gardens and tall trees, as if the adjacent park found its way inside. \r\nThe Gare Maritime is a unique place - attractive, innovative and ambitious.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"em